#: kpercentage.cpp:155
msgid "Several exercise types in random"
msgstr "Varios exercicios de distinto tipo de forma aleatoria"

#: kpercentage.cpp:156
msgid "Choose the number of exercises from 1 to 10."
msgstr "Elixe o número de exercicios (dende 1 ata 10)."

#: kpercentage.cpp:157
msgid "Choose the level of difficulty."
msgstr "Elixe o nivel de dificultade."

#: kpercentage.cpp:158 kpercentage.cpp:169
msgid "Close KPercentage."
msgstr "Pechar KPercentage."

#: kpercentage.cpp:159 kpercentage.cpp:170
msgid "Get some help."
msgstr "Pedir algunha axuda."

#: kpercentage.cpp:163
msgid "Click here to start a sequence of exercises where the base value is omitted."
msgstr "Preme aquí para iniciar unha secuencia de exercicios onde se omite a base."

#: kpercentage.cpp:164
msgid ""
"Click here to start a sequence of exercises where the percent value is "
"omitted."
msgstr ""
"Preme aquí para iniciar unha secuencia de exercicios onde se omite un valor "
"da porcentaxe."

#: kpercentage.cpp:165
msgid "Click here to start a sequence of exercises where the percentage is omitted."
msgstr ""
"Preme aquí para iniciar unha secuencia de exercicios onde se omite a "
"porcentaxe."

#: kpercentage.cpp:166
msgid ""
"Click here to start a sequence of exercises where one value is omitted at "
"random."
msgstr ""
"Preme aquí para iniciar unha secuencia de exercicios onde se omite un valor "
"aleatorio."

#: kpercentage.cpp:167
msgid "Here you can adjust the number of exercises from 1 to 10."
msgstr "Aquí podes axustar o número de exercicios dende 1 ata 10."

#: kpercentage.cpp:168
msgid "Choose one of the levels <i>easy</i>, <i>medium</i>, and <i>crazy</i>."
msgstr "Elixe un dos niveis <i>fácil</i>, <i>medio</i> e <i>tolo</i>."

