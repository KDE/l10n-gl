msgstr "Nivel &%i"

#: OldView.cpp:254
#, fuzzy, c-format
msgid "Runlevel %1"
msgstr "Nivel %i"

#: OldView.cpp:258
msgid ""
"<p>These are the services <strong>started</strong> in runlevel %1.</p><p>The "
"number shown left of the <img src=\"user|ksysv_start\"/> icon determines the "
"order in which the services are started. You can arrange them via drag and "
"drop, as long as a suitable <em>sorting number</em> can be "
"generated.</p><p>If that's not possible, you've got to change the number "
"manually via the <strong>Properties dialog</strong>.</p>"
msgstr ""

#: OldView.cpp:266
msgid "Start"
msgstr "Iniciar"

#: OldView.cpp:276
msgid ""
"<p>These are the services <strong>stopped</strong> in runlevel %1.</p><p>The "
"number shown left of the <img src=\"user|ksysv_stop\"/> icon determines the "
"order in which the services are stopped. You can arrange them via drag and "
"drop, as long as a suitable <em>sorting number</em> can be "
"generated.</p><p>If that's not possible, you've got to change the number "
"manually via the <strong>Properties dialog</strong>.</p>"
msgstr ""

