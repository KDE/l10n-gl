msgstr "Nivel %i"

#: OldView.cpp:149
msgid "Start"
msgstr "Iniciar"

#: OldView.cpp:249
#, c-format
msgid ""
"Drag here to start services\n"
"when entering Runlevel %i"
msgstr ""
"Arrástreo aquí para inicia-los servicios\n"
"cuando entre no Nivel de execución %i"

#: OldView.cpp:250
#, c-format
msgid ""
"Drag here to stop services\n"
"when entering Runlevel %i"
msgstr ""
"Arrastreo aquí para dete-los servicios\n"
"cuando entre no Nivel de execución %i"

