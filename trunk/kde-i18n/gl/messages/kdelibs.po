msgid "DCOP communications error (%1)"
msgstr "Erro de comunicacións de DCOP (%1)"

#: kdecore/kapp.cpp:630
msgid "Use the X-server display 'displayname'"
msgstr "Usar o display 'displayname' do servidor X"

#: kdecore/kapp.cpp:631
msgid "Set default font to 'fontname'"
msgstr "Establecer a fonte por defecto a 'fontname'"

#: kdecore/kapp.cpp:632
msgid "Restore the application for the given 'sessionId'"
msgstr "Restaura-la aplicación do 'sessionId' indicado"

#: kdecore/kapp.cpp:633
msgid ""
"Causes the application to install a private color map on an 8-bit display"
msgstr ""
"Fai que a aplicación instale un mapa de cores privado nunha pantalla de 8 "
"bits"

#: kdecore/kapp.cpp:634
msgid ""
"Limits the number of colors allocated in the color cube on a 8-bit display,\n"
"if the application is using the QApplication::ManyColor color specification"
msgstr ""
"Limita o número de cores asignadas no mapa de cores nunha pantalla de\n"
"8 bits, se a aplicación usa a especificación de cor QApplication::ManyColor"

#: kdecore/kapp.cpp:635
msgid "tells Qt to never grab the mouse or the keyboard."
msgstr "indica a Qt que nunca capture o rato ou o teclado."

#: kdecore/kapp.cpp:636
msgid ""
"running under a debugger can cause an implicit -nograb, use -dograb to "
"override."
msgstr ""
"ó executar cun depurador, pódese causar un -nograb implícito, use -dograb "
"para ignoralo."

#: kdecore/kapp.cpp:637
msgid "switches to synchronous mode for debugging."
msgstr "troca ó modo síncrono para depuración."

#: kdecore/kapp.cpp:638
msgid ""
"sets the application GUI style. Possible values are motif, windows, and "
"platinum."
msgstr ""
"establece o estilo da interface da aplicación. Os valores posibles son "
"motif, windows, e platinum."

#: kdecore/kapp.cpp:639
msgid "sets the client geometry of the main widget."
msgstr "establece a xeometría do cliente do widget principal."

#: kdecore/kapp.cpp:641
msgid "defines the application font."
msgstr "define a fonte da aplicación."

#: kdecore/kapp.cpp:643
msgid ""
"sets the default background color and an application palette (light and dark "
"shades are calculated)."
msgstr ""
"establece a cor de fondo por defecto e a paleta da aplicación (calcúlanse as "
"sombras escuras e claras)."

#: kdecore/kapp.cpp:645
msgid "sets the default foreground color."
msgstr "establece a cor de primeiro plano por omisión."

#: kdecore/kapp.cpp:647
msgid "sets the default button color."
msgstr "establece a cor por defecto dos botóns."

#: kdecore/kapp.cpp:648
msgid "sets the application name."
msgstr "establece o nome da aplicación."

#: kdecore/kapp.cpp:649
msgid "sets the application title (caption)."
msgstr "establece o título da aplicación."

#: kdecore/kapp.cpp:650
msgid "forces the application to use a TrueColor visual on an 8-bit display."
msgstr "forza á aplicación para que use TrueColor nunha pantalla de 8 bits."

#: kdecore/kapp.cpp:656
msgid "Use 'caption' as name in the titlebar"
msgstr "Usar 'caption' como o nome na barra do título"

#: kdecore/kapp.cpp:657
msgid "Use 'icon' as the application icon"
msgstr "Usar 'icon' como a icona da aplicación"

#: kdecore/kapp.cpp:658
msgid "Use 'icon' as the icon in the titlebar"
msgstr "Usar 'icon' como a icona na barra do título"

#: kdecore/kapp.cpp:659
msgid "Use the DCOP Server specified by 'server'"
msgstr "Usar o Servidor DCOP especificado por 'server'"

#: kdecore/kapp.cpp:660
msgid "Disable crash handler, to get core dumps"
msgstr "Desactiva-lo manexador de erros graves, para obter core dumps"

#: kdecore/kapp.cpp:661
msgid "Waits for a WM_NET compatible windowmanager"
msgstr "Agarda por un xestor de fiestras compatible con WM_NET"

