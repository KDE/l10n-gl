#: main.cpp:35
msgid "KDE Icon Editor"
msgstr "Editor de iconas de KDE"

#: main.cpp:39
msgid "Icon file(s) to open"
msgstr "Icona(s) a abrir"

#: main.cpp:45
msgid "KIconEdit"
msgstr "KIconEdit"

#: main.cpp:55
msgid "Bug fixes and GUI tidy up"
msgstr "Corrección de erros e ordeado da interface"

#: kiconedit.cpp:167 kiconeditslots.cpp:78 kiconeditslots.cpp:133
#: kiconeditslots.cpp:277
msgid ""
"The current file has been modified.\n"
"Do you want to save it?"
msgstr ""
"O ficheiro actual foi modificado.\n"
"¿Desexas garda-lo?"

#: kiconedit.cpp:241
msgid "New &Window"
msgstr "Nova &fiestra"

#: kiconedit.cpp:243
msgid ""
"New window\n"
"\n"
"Opens a new icon editor window."
msgstr ""
"Nova fiestra\n"
"\n"
"Abrirase unha nova fiestra de edición."

#: kiconedit.cpp:246
msgid ""
"New\n"
"\n"
"Create a new icon, either from a template or by specifying the size"
msgstr ""
"Nova\n"
"\n"
"Crear unha nova icona, dende un modelo ou especificando o tamaño"

#: kiconedit.cpp:250
msgid ""
"Open\n"
"\n"
"Open an existing icon"
msgstr ""
"Abrir\n"
"\n"
"Abrir unha icona que xa existe"

#: kiconedit.cpp:258
msgid ""
"Save\n"
"\n"
"Save the current icon"
msgstr ""
"Gardar\n"
"\n"
"Gardar a icona actual"

#: kiconedit.cpp:263
msgid ""
"Print\n"
"\n"
"Opens a print dialog to let you print the current icon."
msgstr ""
"Imprimir\n"
"\n"
"Abrir un diálogo de impresión para imprimir a icona actual."

#: kiconedit.cpp:271
msgid ""
"Cut\n"
"\n"
"Cut the current selection out of the icon\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"Cortar\n"
"\n"
"Cortar o seleccionado\n"
"\n"
"(Consello: podes facer seleccións rectangulares e circulares)"

#: kiconedit.cpp:275
msgid ""
"Copy\n"
"\n"
"Copy the current selection out of the icon\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"Copiar\n"
"\n"
"Copia o seleccionado\n"
"\n"
"(Consello: podes facer selección rectangulares e circulares)"

#: kiconedit.cpp:279
msgid ""
"Paste\n"
"\n"
"Paste the contents of the clipboard into the current icon.\n"
"\n"
"If the contents are larger than the current icon you can paste them in a new "
"window.\n"
"\n"
"(Tip: Select \"Paste transparent pixels\" in the configuration dialog if you "
"also want to paste transparency.)"
msgstr ""
"Pegar\n"
"\n"
"Pego o contido do portaretallos na icona actual.\n"
"\n"
"Se o contido é maior ca icona actual, o podes pegar nunha nova fiestra\n"
"\n"
"(Consello: selecciona \"Pegar pixeles transparentes\" no dialogo de "
"configuración se queres pegar a transparencia.)"

#: kiconedit.cpp:286
msgid "Paste as &New"
msgstr "Pegar como &novo"

#: kiconedit.cpp:292
msgid "Resi&ze..."
msgstr "Red&imensionar..."

#: kiconedit.cpp:294
msgid ""
"Resize\n"
"\n"
"Smoothly resizes the icon while trying to preserve the contents"
msgstr ""
"Redimensionar\n"
"\n"
"Redimensión suave da icona procurando manter os contidos."

#: kiconedit.cpp:297
msgid "&GrayScale"
msgstr "Escala de &grises"

#: kiconedit.cpp:299
msgid ""
"Gray scale\n"
"\n"
"Gray scale the current icon.\n"
"(Warning: The result is likely to contain colors not in the icon palette"
msgstr ""
"Escala de grises\n"
"\n"
"Convertir a escala de grises a icona actual.\n"
"(Advertencia: e pobable que o resultado conteña cores que non estén na "
"paleta)"

#: kiconedit.cpp:306
msgid ""
"Zoom in\n"
"\n"
"Zoom in by one."
msgstr ""
"Acercar\n"
"\n"
"Ampliar o zoom."

#: kiconedit.cpp:310
msgid ""
"Zoom out\n"
"\n"
"Zoom out by one."
msgstr ""
"Alonxar\n"
"\n"
"Diminuir o zoom."

#: kiconedit.cpp:316
#, no-c-format
msgid "100%"
msgstr "100%"

#: kiconedit.cpp:320
#, no-c-format
msgid "200%"
msgstr "200%"

#: kiconedit.cpp:324
#, no-c-format
msgid "500%"
msgstr "500%"

#: kiconedit.cpp:328
#, no-c-format
msgid "1000%"
msgstr "1000%"

#: kiconedit.cpp:342
msgid "Show &Grid"
msgstr "Mostrar &enreixado"

#: kiconedit.cpp:345
msgid ""
"Show grid\n"
"\n"
"Toggles the grid in the icon edit grid on/off"
msgstr ""
"Mostrar enreixado\n"
"\n"
"Activa/desactiva o enreixado"

#: kiconedit.cpp:350
msgid "Color Picker"
msgstr "Selección da cor"

#: kiconedit.cpp:354
msgid ""
"Color Picker\n"
"\n"
"The color of the pixel clicked on will be the current draw color"
msgstr ""
"Selección da cor\n"
"\n"
"A cor do punto pulsado será a cor de debuxo"

#: kiconedit.cpp:357
msgid "Freehand"
msgstr "Man alzada"

#: kiconedit.cpp:361
msgid ""
"Free hand\n"
"\n"
"Draw non-linear lines"
msgstr ""
"Man alzada\n"
"\n"
"Debuxar a man alzada"

#: kiconedit.cpp:366
msgid "Rectangle"
msgstr "Rectángulo"

#: kiconedit.cpp:370
msgid ""
"Rectangle\n"
"\n"
"Draw a rectangle"
msgstr ""
"Rectángulo\n"
"\n"
"Debuxar un rectángulo"

#: kiconedit.cpp:372
msgid "Filled Rectangle"
msgstr "Rectángulo recheo"

#: kiconedit.cpp:376
msgid ""
"Filled rectangle\n"
"\n"
"Draw a filled rectangle"
msgstr ""
"Rectángulo recheo\n"
"\n"
"Debuxar un rectángulo recheo"

#: kiconedit.cpp:378
msgid "Circle"
msgstr "Círculo"

#: kiconedit.cpp:382
msgid ""
"Circle\n"
"\n"
"Draw a circle"
msgstr ""
"Círculo\n"
"\n"
"Debuxar un círculo"

#: kiconedit.cpp:384
msgid "Filled Circle"
msgstr "Círculo recheo"

#: kiconedit.cpp:388
msgid ""
"Filled circle\n"
"\n"
"Draw a filled circle"
msgstr ""
"Círculo recheo\n"
"\n"
"Debuxar un círculo recheo"

#: kiconedit.cpp:390
msgid "Ellipse"
msgstr "Elipse"

#: kiconedit.cpp:394
msgid ""
"Ellipse\n"
"\n"
"Draw an ellipse"
msgstr ""
"Elipse\n"
"\n"
"Debuxar unha elipse"

#: kiconedit.cpp:396
msgid "Filled Ellipse"
msgstr "Elipse rechea"

#: kiconedit.cpp:400
msgid ""
"Filled ellipse\n"
"\n"
"Draw a filled ellipse"
msgstr ""
"Elipse rechea\n"
"\n"
"Debuxar unha elipse rechea"

#: kiconedit.cpp:402
msgid "Spray"
msgstr "Aerógrafo"

#: kiconedit.cpp:406
msgid ""
"Spray\n"
"\n"
"Draw scattered pixels in the current color"
msgstr ""
"Aerógrafo\n"
"\n"
"Debuxa puntos dispersos coa cor actual"

#: kiconedit.cpp:409
msgid "Flood Fill"
msgstr "Encher de cor"

#: kiconedit.cpp:413
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"Encher de cor\n"
"\n"
"Encher os puntos contiguos de igual cor coa cor actual"

#: kiconedit.cpp:416
msgid "Line"
msgstr "Liña"

#: kiconedit.cpp:420
msgid ""
"Line\n"
"\n"
"Draw a straight line vertically, horizontally or at 45 deg. angles"
msgstr ""
"Liña\n"
"\n"
"Debuxar unha liña recta vertical, horizontal ou con un ángulo de 45 grados"

#: kiconedit.cpp:423
msgid "Eraser (Transparent)"
msgstr "Goma (trasparente)"

#: kiconedit.cpp:427
msgid ""
"Erase\n"
"\n"
"Erase pixels. Set the pixels to be transparent\n"
"\n"
"(Tip: If you want to draw transparency with a different tool, first click on "
"\"Erase\" then on the tool you want to use)"
msgstr ""
"Goma\n"
"\n"
"Borra puntos. Sinalar os puntos que serán transparentes\n"
"\n"
"(Consello: se buscas debuxar transparencias con outra ferramenta, preme "
"primeiro en \"Borrar\" e logo elixe a ferramente que queres emprgar)"

#: kiconedit.cpp:432
msgid "Rectangular Selection"
msgstr "Selección rectangular"

#: kiconedit.cpp:436
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""
"Selección\n"
"\n"
"Elexir unha selección rectangular na icona empregando o rato."

#: kiconedit.cpp:439
msgid "Circular Selection"
msgstr "Selección circular"

#: kiconedit.cpp:443
msgid ""
"Select\n"
"\n"
"Select a circular section of the icon using the mouse."
msgstr ""
"Selección\n"
"\n"
"Elexir unha selección circular na icona empregando o rato."

#: kiconedit.cpp:458
msgid "Palette Toolbar"
msgstr "Paleta"

#: kiconedit.cpp:469
msgid ""
"Statusbar\n"
"\n"
"The statusbar gives information on the status of the current icon. The "
"fields are:\n"
"\n"
"\t- Application messages\n"
"\t- Cursor position\n"
"\t- Size\n"
"\t- Zoom factor\n"
"\t- Number of colors"
msgstr ""
"Barra de estado\n"
"\n"
"A barra de estado mostra información sobre o estado da icona actual. Os "
"campos son:\n"
"\n"
"\t- Mensaxes da aplicación\n"
"\t- Posición do cursor\n"
"\t- Tamaño\n"
"\t- Zoom factor\n"
"\t- Numero de cores"

#: kiconedit.cpp:478 kiconeditslots.cpp:440 kiconeditslots.cpp:446
#, c-format
msgid "Colors: %1"
msgstr "Cores: %1"

#: kicongrid.cpp:87
msgid ""
"Icon draw grid\n"
"\n"
"The icon grid is the area where you draw the icons.\n"
"You can zoom in and out using the magnifying glasses on the toolbar.\n"
"(Tip: Hold the magnify button down for a few seconds to zoom to a predefined "
"scale)"
msgstr ""

#: kicongrid.cpp:113
msgid "width"
msgstr "largura"

#: kicongrid.cpp:118
msgid "height"
msgstr "alto"

#: kicongrid.cpp:122
msgid ""
"Rulers\n"
"\n"
"This is a visual representation of the current cursor position"
msgstr ""
"Regras\n"
"\n"
"É unha representación visual da posición actual da icona"

#: kicongrid.cpp:537
msgid "Free Hand"
msgstr "Man alzada"

#: kicongrid.cpp:738
msgid ""
"There was an error loading a blank image.\n"
msgstr ""
"Erro a cargar unha imaxe en branco.\n"

#: kicongrid.cpp:870
msgid "All selected"
msgstr "Seleccionar todo"

#: kicongrid.cpp:881
msgid "Cleared"
msgstr "Limpado"

#: kicongrid.cpp:923
msgid "Selected area cut"
msgstr "Seleccionar área a cortar"

#: kicongrid.cpp:927
msgid "Selected area copied"
msgstr "Seleccionar área a copiar"

#: kicongrid.cpp:952
msgid ""
"The clipboard image is larger than the current image!\n"
"Paste as new image?"
msgstr ""
"¡A imaxe do portaretallos é maior que a imaxe actual!\n"
"¿Pegar como nova imaxe?"

#: kicongrid.cpp:1072 kicongrid.cpp:1106
msgid "Done pasting"
msgstr "Pegado"

#: kicongrid.cpp:1077 kicongrid.cpp:1112
msgid ""
"Invalid pixmap data in clipboard!\n"
msgstr ""
"¡Mapa de puntos incorrecto no portarretellos!\n"

#: kicongrid.cpp:1619
msgid "Drawn Array"
msgstr "Debuxar matriz"

#: palettetoolbar.cpp:44
msgid ""
"Preview\n"
"\n"
"This is a 1:1 preview of the current icon"
msgstr ""
"Miniatura\n"
"\n"
"Esta e miniatura con ratio 1:1 da actual icona"

#: palettetoolbar.cpp:49
msgid "System colors:"
msgstr "Cores do sistema:"

#: palettetoolbar.cpp:52
msgid ""
"System colors\n"
"\n"
"Here you can select colors from the KDE icon palette"
msgstr ""
"Cores do sistema\n"
"\n"
"Aqui podes seleccionar as cores dende a paleta de iconas de KDE"

#: palettetoolbar.cpp:61
msgid "Custom colors:"
msgstr "Cores personalizadas:"

#: palettetoolbar.cpp:64
msgid ""
"Custom colors\n"
"\n"
"Here you can build a palette of custom colors.\n"
"Double-click on a box to edit the color"
msgstr ""
"Cores personalizadas\n"
"\n"
"Aquí podes crear unha paleta de cores personalizadas.\n"
"Fai dobre clic na caixa para editar a cor"

#: kicon.cpp:73
msgid ""
"The URL: %1 \n"
"seems to be malformed.\n"
msgstr ""
"A dirección: %1 \n"
"parece que non é valida.\n"

#: kicon.cpp:89 kicon.cpp:104
msgid ""
"There was an error loading:\n"
"%1\n"
msgstr ""
"Houbo un erro cargando:\n"
"%1\n"

