#: rc.cpp:95
msgid "u-law (logarithmic)"
msgstr "u-law (logarítmico)"

#: rc.cpp:96
msgid "A-law (logarithmic)"
msgstr "A-law (logarítmico)"

#: rc.cpp:97
msgid "ADPCM"
