#: rip/k3bcddbpatternwidget.cpp:119
msgid ""
"<p><b>Pattern special strings:</b><ul>\n"
"<li>%a - artist of the track\n"
"<li>%t - title of the track\n"
"<li>%n - track number\n"
"<li>%y - year of the CD\n"
"<li>%e - extended information about the track\n"
"<li>%g - genre of the CD\n"
"<li>%r - album artist (differs from %a only on soundtracks or compilations)\n"
"<li>%m - album title\n"
"<li>%x - extended information about the CD\n"
"<li>%d - current date\n"
"</ul>"
msgstr ""
"<p><b>Cadeas de formato especial:</b><ul>\n"
"<li>%a - artista da  pista\n"
"<li>%t - título da pista\n"
"<li>%n - número de pista\n"
"<li>%y - ano do CD\n"
"<li>%e - información extendida acerca da pista\n"
"<li>%g - xénero do CD\n"
"<li>%r - artista do álbume (difire dende %a só en bandas sonoras ou "
"compilacións)\n"
"<li>%m - título do álbume\n"
"<li>%x - información extendida acerca do CD\n"
"<li>%d - data actual\n"
"</ul>"

