#: rc.cpp:2
#, no-c-format
msgid "Config Dialog"
msgstr "Configuración"

#: rc.cpp:4
#, no-c-format
msgid "Title &Alignment"
msgstr "&Alineacíon do título"

#: rc.cpp:12
#, no-c-format
msgid "Use shadowed &text"
msgstr "Empregar &texto sombreado"

#: rc.cpp:14
#, no-c-format
msgid ""
"Check this option if you want the titlebar text to have a 3D look with a "
"shadow behind it."
msgstr ""
"Elixa esta opción se quere que a barra de título teña apariencia 3D cunha "
"sombra tras dela."

#: rc.cpp:16
#, no-c-format
msgid "Animate buttons"
msgstr "Botóns animados"

#: rc.cpp:18
#, no-c-format
msgid ""
"Check this option if you want the buttons to fade in when the mouse pointer "
"hovers over them and fade out again when it moves away."
msgstr "Elixa esta opción se quere cos botóns resalten cando o rato pasa por riba."

#: rc.cpp:20
#, no-c-format
msgid "Close windows by double clicking the menu button"
msgstr "Peche as fiestras facendo doble clic no botón de menú"

#: rc.cpp:22
#, no-c-format
msgid ""
"Check this option if you want windows to be closed when you double click the "
"menu button, similar to Microsoft Windows."
msgstr ""
"Eliza esta opción se quere ca fiestra se peche cun doble clic no botón "
"menú, coma en Microsoft Windows."
