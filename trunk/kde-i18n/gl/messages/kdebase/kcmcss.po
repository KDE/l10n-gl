#: kcmcss.cpp:228
msgid ""
"This module allows you to apply your own color and font settings to konqueror "
"by using stylesheets (CSS). You can either specify options or apply your own "
"self-written stylesheet by pointing to its location.<br> Note that these "
"settings will always have precedence before all other settings made by the "
"site author. This can be useful to visually impaired people or for web pages "
"that are unreadable due to bad design."
msgstr ""
"Este módulo permite aplicar as súas configuracións de cor e fontes a "
"konqueror empregando follas de estilo (Css). Pode especificar opcións ou "
"aplicar as súas propias follas de estilo.<br> Note que estas preferencias "
"terán sempre preferencia ante as opcións proporcionadas polo autor do sitio. "
"Isto pode ser bo para páxinas mal feitas ou poco claras."

#: rc.cpp:1 rc.cpp:5
msgid "Stylesheets"
msgstr "Follas de Estilo"

#: rc.cpp:2 rc.cpp:3
msgid ""
"<b>Stylesheets</b><p>See http://www.w3.org/Style/CSS for further information "
"on cascading style sheets.</p>"
msgstr ""
"<b>Follas de Estilo</b><p>Mire http://www.w3.org/Style/CSS para máis "
"información sobre as follas de estilo.</p>"

#: rc.cpp:4
msgid "&General"
msgstr "&Xeral"

#: rc.cpp:6
msgid ""
"<b>Stylesheets</b><p>Use this groupbox to determine how Konqueror will render "
"style sheets.</p>"
msgstr ""
"<b>Follas de Estilo</b><p>Empregue esta casilla para determinar cómo debe "
"Konqueror interpreta-las follas de estilo.</p>"

#: rc.cpp:7
msgid "Use &user-defined stylesheet"
msgstr "Empregar Follas de Estilo definidas por &usuario"

#: rc.cpp:8
msgid ""
"<b>Use user-defined stylesheet</b><p>If this box is checked, konqueror will "
"try to load a user-defined style sheet as specified in the location below. "
"The style sheet allows you to completely override the way web pages are "
"rendered in your browser. The file specified should contain a valid style "
"sheet (see http://www.w3.org/Style/CSS for further information on cascading "
"style sheets).</p>"
msgstr ""
"<b>Empregar follas de estilo definidas polo usuario</b><p>Se esta casilla "
"está activada, konqueror intentará cargar unha folla de estilo definida na "
"localización de embaixo. A folla de estilo permite sobrescribir completamente "
"cómo as páxinas deben ser interpretadas no explorador. O ficheiro "
"especificado debe conter unha folla de estilo válida (mire "
"http://www.w3.org/style/css para máis información).</p>"

#: rc.cpp:9
msgid "Use &accessiblity stylesheet defined in \"Customize\"-tab"
msgstr "Empregar folla de estilo de &accesibilidade definida en \"Personalizar\""

#: rc.cpp:10
msgid ""
"<b>Use accessiblity stylesheet defined in "
"&quot;Customize&quot;-tab</b><p>Selecting this option will allow you to "
"define a default font, font size, and font color with a few simple clicks of "
"the mouse. Simply wander over to the Customize tab and pick out your desired "
"options.</p>"
msgstr ""
"<b>Empregar unha folla de estilo de accesibilidade definida na casilla de "
"&quot;Personalizar&quot;</b><p>Ó escoller esta opción a fonte, o tamaño de "
"fonte e o color da fonte poderán ser definidos nuns cantos clics. Simplemente "
"diríxase á casilla Personalizar e escolla as opcións desexadas.</p>"

#: rc.cpp:11
msgid "Use &default stylesheet"
msgstr "Empregar folla de estilo por &defecto"

#: rc.cpp:12
msgid ""
"<b>Use default stylesheet</b><p>Select this option to use the default "
"stylesheet.</p>"
msgstr ""
"<b>Empregar folla de estilo por defecto</b><p>Escolla esta opción para "
"empregar a folla de estilo por defecto.</p>"

#: rc.cpp:13
msgid "&Customize"
msgstr "&Personalizar"

#: rc.cpp:14
msgid "Colors"
msgstr "Cores"

#: rc.cpp:15
msgid "&Black on white"
msgstr "&Negro no blanco"

#: rc.cpp:16
msgid "<b>Black on White</b><p>This is what you normally see.</p>"
msgstr "<b>Negro no Blanco</b><p>Isto é o que normalmente vostede ve.</p>"

#: rc.cpp:17
msgid "&White on black"
msgstr "&Blanco en negro"

#: rc.cpp:18
msgid "<b>White on Black</b><p>This is your classic inverse color scheme.</p>"
msgstr "<b>Blanco en Negro</b><p>Isto é configuración de cor clásica invertida.</p>"

#: rc.cpp:19
msgid "Cus&tom"
msgstr "Pers&onalizado"

#: rc.cpp:20
msgid ""
"<b>Custom</b><p>Select this option to define a custom color for the default "
"font.</p>"
msgstr ""
"<b>Personalizado</b><p>Escolla esta opción para definir unha cor "
"personalizada para a fonte por defecto.</p>"

#: rc.cpp:21 rc.cpp:23
msgid ""
"<b>Foreground color</b><p>The foreground color is the color that the text is "
"drawn in.</p>"
msgstr "<b>Cor do primeiro plano</b><p>A cor do primeiro plano é cor do texto.</p>"

#: rc.cpp:22
msgid "&Foreground:"
msgstr "&Primeiro Plano:"

#: rc.cpp:24
msgid ""
"<b>Background</b><p>Behind this door lays the ability to choose a custom "
"default background.</p>"
msgstr "<b>Fondo</b><p>A opción de escoller un fondo por defecto personalizado.</p>"

#: rc.cpp:25
msgid "B&ackground:"
msgstr "Fo&ndo:"

#: rc.cpp:26
msgid ""
"<b>Background</b><p>This background color is the one displayed behind the "
"text by default. A background image will override this.</p>"
msgstr ""
"<b>Fondo</b><p>Cor amosada detrás do texto por defecto. Unha imaxe de fondo "
"sobrescribiría este valor.</p>"

#: rc.cpp:27
msgid "Use same color for all text"
msgstr "Usa-la mesma cor para todo o texto"

#: rc.cpp:28 rc.cpp:29
msgid ""
"<b>Use same color for all text</b><p>Select this option to apply your chosen "
"color to the default font as well as any custom fonts as specified in a "
"stylesheet.</p>"
msgstr ""
"<b>Usa-la mesma cor para todo o texto</b><p>Escolla esta opción para aplicar "
"unha cor escollida a tódalas fontes independentemente da folla de estilo.</p>"

#: rc.cpp:30
msgid "Images"
msgstr "Imaxes"

#: rc.cpp:31
msgid "<b>Images</b><p></b>"
msgstr "<b>Imaxes</b><p></b>"

#: rc.cpp:32
msgid "&Suppress images"
msgstr "&Ocultar Imaxes"

#: rc.cpp:33
msgid ""
"<b>Suppress images</b><p>Selecting this will prevent Konqueror from loading "
"images.</p>"
msgstr "<b>Ocultar imaxes</b><p>Prevén a Konqueror de cargar imaxes.</p>"

#: rc.cpp:34
msgid "Suppress background images"
msgstr "Ocultar imaxes de fondo"

#: rc.cpp:35
msgid ""
"<b>Suppress background images</b><p>Selecting this option will prevent "
"Konqueror from loading background images.</p>"
msgstr ""
"<b>Ocultar imaxes de fondo</b><p>Prevén a Konqueror de cargar imaxes de "
"fondo.</p>"

#: rc.cpp:36
msgid "&Preview"
msgstr "&Previsualización"

#: rc.cpp:37
msgid ""
"<b>Preview</b><p>Click on this button to see what your selections look like "
"in action.</p>"
msgstr ""
"<b>Previsualización</b><p>Prema este botón para ve-las seleccións feitas en "
"acción.</p>"

#: rc.cpp:38
msgid "Font Family"
msgstr "Familia de Fontes"

#: rc.cpp:39 rc.cpp:40
msgid ""
"<b>Font family</b><p>A font family is a group of fonts that resemble one "
"another, with family members that are e.g. bold, italic, or any number of the "
"above.</p>"
msgstr ""
"<b>Familia de Fontes</b><p>Unha familia de fontes é un grupo de fontes que se "
"asemellan, con membros coma negriña, itálica, ou calqueira número dos de "
"enriba.</p>"

#: rc.cpp:41
msgid "Base fa&mily:"
msgstr "Fa&milia base:"

#: rc.cpp:43
msgid "<p>This is the currently selected font family</p>"
msgstr "<p>Familia de fontes seleccionada actualmente</p>"

#: rc.cpp:44
msgid "Use same family for all text"
msgstr "Emprega-la misma familia para tódolos textos"

#: rc.cpp:45
msgid ""
"<b>Use same family for all text</b><p>Select this option to override custom "
"fonts everywhere in favor of the base font.</p>"
msgstr ""
"<b>Emprega-la misma familia para tódolos textos</b>Escolla esta opción para "
"sobrescribir as fontes personalizadas en favor das fontes base.</p>"

#: rc.cpp:47
msgid "<b>Font size</b>"
msgstr "<b>Tamaño de fonte</b>"

