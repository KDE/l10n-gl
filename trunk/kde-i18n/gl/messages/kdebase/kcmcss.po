msgid "8"
msgstr "8"

#: rc.cpp:50
msgid "9"
msgstr "9"

#: rc.cpp:51
msgid "10"
msgstr "10"

#: rc.cpp:52
msgid "11"
msgstr "11"

#: rc.cpp:53
msgid "12"
msgstr "12"

#: rc.cpp:54
msgid "14"
msgstr "14"

#: rc.cpp:55
msgid "16"
msgstr "16"

#: rc.cpp:56
msgid "20"
msgstr "20"

#: rc.cpp:57
msgid "24"
msgstr "24"

#: rc.cpp:58
msgid "32"
msgstr "32"

#: rc.cpp:59
msgid "48"
msgstr "48"

#: rc.cpp:60
msgid "64"
msgstr "64"

#: rc.cpp:61
msgid "Base font si&ze:"
msgstr "Tama&ño da fonte base:"

#: rc.cpp:62
msgid "&Use same size for all elements"
msgstr "&Emprega-lo mesmo tamaño para tódolos elementos"

#: rc.cpp:63
msgid ""
"<b>Use same size for all elements</b><p>Select this option to override custom "
"font sizes in favor of the base font size. All fonts will be displayed in the "
"same size.</p>"
msgstr ""
"<b>Emprega-lo mesmo tamaño para tódolos elementos</b><p>Escolla esta opción "
"para sobrescribi-los tamaños das fontes en favor do tamaño da fonte base. "
"Tódalas fontes serán amosadas no mesmo tamaño.</p>"

#: rc.cpp:64
msgid "Preview"
msgstr "Previsualización"

#: rc.cpp:65
msgid ""
"<qt>\n"
"\n"
"<h1>Heading 1</h1><br/>\n"
"<h2>Heading 2</h2><br/>\n"
"<h3>Heading 3</h3><br/>\n"
"\n"
"<p>User defined stylesheets allow increased\n"
"accessibility for visually handicapped\n"
"people.</p>\n"
"\n"
"</qt>"
msgstr ""
"<qt>\n"
"\n"
"<h1>Cabeceira 1</h1><br/>\n"
"<h2>Cabeceira 2</h2><br/>\n"
"<h3>Cabeceira 3</h3><br/>\n"
"\n"
"<p>As follas de estilo definidas polo usuario\n"
"ofrecen maior accesibilidade para xente\n"
"con algunha minusvalía.</p>\n"
"\n"
"</qt>"

