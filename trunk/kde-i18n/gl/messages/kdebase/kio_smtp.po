#: smtp.cc:260 smtp.cc:320
msgid "The sender address is missing."
msgstr "Falta a dirección de remite."

#: smtp.cc:271
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "Falló SMTPProtocol::smtp_open (%1)"

#: smtp.cc:278
#, c-format
msgid ""
"The server didn't accept the sender address:\n"
"%1"
msgstr ""
"O servidor non aceptou a dirección de remite:\n"
"%1"

#: smtp.cc:296
#, c-format
msgid ""
"The attempt to start sending the message content failed.\n"
"The server said:\n"
"%1"
msgstr ""
"O intento de inicia-lo envíodo contido da mensaxe fallou.\n"
"Resposta do servidor:\n"
"%1"

#: smtp.cc:368
#, c-format
msgid ""
"The server didn't accept the message content:\n"
"%1"
msgstr ""
"O servidor non aceptou o contido do envío:\n"
"%1"

#: smtp.cc:384
#, c-format
msgid ""
"The server didn't accept one of the recipients.\n"
"It said: %1"
msgstr ""
"O servidor non aceptou unha das direccións de envío.\n"
"Resposta: %1"

#: smtp.cc:439 smtp.cc:462
msgid "Invalid SMTP response received."
msgstr "Recibida resposta SMTP non válida."

#: smtp.cc:495
#, c-format
msgid "Invalid SMTP response received: %1"
msgstr "Recibida resposta SMTP non válida: %1"

#: smtp.cc:542
#, c-format
msgid "The server didn't accept the connection: %1"
msgstr "O servidor non aceptou a conexión: %1"

#: smtp.cc:577 smtp.cc:615
#, c-format
msgid "The server said: %1"
msgstr "Resposta do servidor: %1"

#: smtp.cc:600
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"O seu servidor SMTP di soportar TLS pero a negociación non tivo éxito.\n"
"Pode desactivar TLS en KDE usando o módulo de configuración criptográfico."

#: smtp.cc:605
msgid "Connection Failed"
msgstr "Conexión fallida"

#: smtp.cc:623
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr "O seu servidor SMTP non soporta TLS. Desactive TLS, se desexa conectarse sen cifrado."

#: smtp.cc:635
msgid "Username and password for your SMTP account:"
msgstr "Nome de usuario e contrasinal da súa conta SMTP:"

#: smtp.cc:637
msgid "When prompted, you ran away."
msgstr "Cando se lle solicitou vostede xa non estaba."

#: smtp.cc:688
msgid "No compatible authentication methods found."
msgstr "Non se encontraron métodos de autentificación compatibles."

#: smtp.cc:700
msgid ""
"Your SMTP server doesn't support %1.\n"
"Choose a different authentication method."
msgstr ""
"O seu servidor SMTP non soporta %1.\n"
"Seleccione un método diferente de autentificación"

#: smtp.cc:722
#, c-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server said: %1"
msgstr ""
"Autentificación fallida.\n"
"O máis probable é que o contrasinal fora incorrecto.\n"
"Resposta do servidor: %1"

