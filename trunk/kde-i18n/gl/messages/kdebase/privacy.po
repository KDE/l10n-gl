#: rc.cpp:23
#, no-c-format
msgid "Financial Information"
msgstr "Información Financieira"

#: rc.cpp:25
#, no-c-format
msgid "Warn me when I visit a site that uses my financial or purchase information:"
msgstr "Avisar cando visite un sitio que empegue a miña información financieira:"

#: rc.cpp:27 rc.cpp:35
#, no-c-format
msgid "For marketing or advertising purposes"
msgstr "Para propósitos de publicidade e comercio"

#: rc.cpp:29 rc.cpp:37 rc.cpp:45
#, no-c-format
msgid "To share with other companies"
msgstr "Para compartir con outras compañías"

#: rc.cpp:31
#, no-c-format
msgid "Health Information"
msgstr "Información de Saúde"

#: rc.cpp:33
#, no-c-format
msgid "Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Adverter cando visite un sitio que empregue a miña información "
"médica/saúde: "

#: rc.cpp:39
#, no-c-format
msgid "Demographics"
msgstr "Demográfica"

#: rc.cpp:41
#, no-c-format
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr "Adverter cando visite un sitio que empregue a miña información non persoal:"

#: rc.cpp:43
#, no-c-format
msgid "To determine my interests, habits or general behavior"
msgstr "Para determina-los meus intereses, hábitos ou comportamento xeral"

#: rc.cpp:47
#, no-c-format
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Adverter cando visite un sitio que comparta a miña información persoal con "
"outras compañías"

#: rc.cpp:49
#, fuzzy, no-c-format
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr ""
"Adverter cando visite un sitio que non me permita coñecer qué información "
"posúen eles sobre min"

#: rc.cpp:51
#, no-c-format
msgid "Personal Information"
msgstr "Información Persoal"

#: rc.cpp:53
#, no-c-format
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Adverter cando visite un sitio que podería contactarme para información "
"sobre outros productos ou servicios:"

#: rc.cpp:55
#, no-c-format
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr ""
"Adverter cando visite un sitio que podería usa-la miña información "
"persoal para:"

#: rc.cpp:57
#, no-c-format
msgid "Determine my habits, interests or general behavior"
msgstr "Determina-los meus hábitos, intereses ou comportamento xeral"

#: rc.cpp:59
#, no-c-format
msgid "Via telephone"
msgstr "Por teléfono"

#: rc.cpp:61
#, no-c-format
msgid "Via mail"
msgstr "Por correo"

#: rc.cpp:63
#, no-c-format
msgid "Via email"
msgstr "Por correo-e"

#: rc.cpp:65
#, no-c-format
msgid "And do not allow me to remove my contact information"
msgstr "E que non me permita borra-la miña información de contacto"
