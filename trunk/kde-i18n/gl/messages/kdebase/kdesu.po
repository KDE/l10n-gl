#: kdesu.cpp:46 kdesu.cpp:47
msgid "Specifies the command to run."
msgstr "Especifica o comando para executar."

#: kdesu.cpp:48
msgid "Run command under target uid if <file> is not writeable."
msgstr ""
"Executa-lo comando co UID destino se o <ficheiro> non se pode escribir."

#: kdesu.cpp:49
msgid "Specifies the target uid"
msgstr "Especifica o UID destino"

#: kdesu.cpp:50
msgid "Do not keep password."
msgstr "Non garda-lo contrasinal."

#: kdesu.cpp:51
msgid "Stop the daemon (forgets all passwords)."
msgstr "Para-lo daemon (esquece tódolos contrasinais)."

#: kdesu.cpp:52
msgid "Enable terminal output (no password keeping)."
msgstr "Activa-la saída do terminal (non garda os contrasinais)."

#: kdesu.cpp:53
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest."
msgstr "Establece-lo valor de prioridade: 0 <= prioridade <= 100, 0 é a menor."

#: kdesu.cpp:54
msgid "Use realtime scheduling."
msgstr "Usar planificador de tempo real."

#: kdesu.cpp:61
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:62
msgid "Runs a program with elevated privileges."
msgstr "Executa un programa con máis privilexios."

#: kdesu.cpp:65
msgid "Maintainer"
msgstr "Encargado"

#: kdesu.cpp:67
msgid "Original author"
msgstr "Autor orixinal"

#: kdesu.cpp:135
#, c-format
msgid "Illegal priority: %1"
msgstr "Prioridade ilegal: %1"

#: kdesu.cpp:160
msgid "No command specified!"
msgstr "¡Non se indicou un comando!"

#: kdesu.cpp:224
msgid "Command:"
msgstr "Comando:"

#: kdesu.cpp:229
msgid "realtime: "
msgstr "tempo real: "

#: kdesu.cpp:231
msgid "Priority:"
msgstr "Prioridade:"

#: sudlg.cpp:21
#, c-format
msgid "Run as %1"
msgstr "Executar como %1"

#: sudlg.cpp:25
msgid ""
"The action you requested needs root priviliges. Please enter root's password "
"below or click Ignore to continue with your current priviliges."
msgstr ""
"A acción que solicitou necesita privilexios de root. Introduza o contrasinal "
"de root embaixo, ou prema Ignorar para continuar cos privilexios actuais."

#: sudlg.cpp:29
msgid ""
"The action you requested needs additional priviliges. Please enter the "
"password for \"%1\" below or click Ignore to continue with your current "
"privileges."
msgstr ""
"A acción que solicitou necesita privilexios adicionais. Introduza o "
"contrasinal de \"%1\" embaixo, ou prema Ignorar para continuar cos "
"privilexios actuais."

#: sudlg.cpp:34
msgid "&Ignore"
msgstr "&Ignorar"

#: sudlg.cpp:53
msgid ""
"The program `su' is not found!\n"
"\n"
"Make sure your PATH is set correctly."
msgstr ""
"¡Non se atopou o programa `su'!\n"
"\n"
"Asegúrese de que o PATH é correcto."

#: sudlg.cpp:59
msgid ""
"You are not allowed to use `su'!\n"
"\n"
"On some systems, you need to be in a special\n"
"group (often: wheel) to use this program."
msgstr ""
"¡Non ten permiso para executar `su'!\n"
"\n"
"Nalgúns sistemas, ten que pertencer a un grupo\n"
"especial (a miúdo `wheel') para usar este programa."

#: sudlg.cpp:65
msgid "Incorrect password! Please try again."
msgstr "¡Contrasinal incorrecto! Tente de novo."

#: sudlg.cpp:68
msgid "Internal error: Illegal return from SuProcess::checkInstall()"
msgstr "Erro interno: Valor de retorno de SuProcess::checkInstall() ilegal"
