#: kdesu.cpp:57 kdesu.cpp:58
msgid "Specifies the command to run."
msgstr "Especifica o comando a executar."

#: kdesu.cpp:59
msgid "Run command under target uid if <file> is not writable."
msgstr "Executa-lo comando co uid de destino se o <ficheiro> non se pode escribir."

#: kdesu.cpp:60
msgid "Specifies the target uid."
msgstr "Especifica o UID de destino."

#: kdesu.cpp:61
msgid "Do not keep password."
msgstr "Non garda-lo contrasinal."

#: kdesu.cpp:62
msgid "Stop the daemon (forgets all passwords)."
msgstr "Para-lo daemon (esquece tódolos contrasinais)."

#: kdesu.cpp:63
msgid "Enable terminal output (no password keeping)."
msgstr "Activa-la saída do terminal (non garda os contrasinais)."

#: kdesu.cpp:64
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest."
msgstr "Establece-lo valor de prioridade: 0 <= prioridade <= 100, 0 é a menor."

#: kdesu.cpp:65
msgid "Use realtime scheduling."
msgstr "Usar planificador de tempo real."

#: kdesu.cpp:66
msgid "Let command use existing dcopserver."
msgstr "Permitir que o comando empregue o dcopserver existente."

#: kdesu.cpp:97
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:98
msgid "Runs a program with elevated privileges."
msgstr "Executa un programa con máis privilexios."

#: kdesu.cpp:101
msgid "Maintainer"
msgstr "Encargado"

#: kdesu.cpp:103
msgid "Original author"
msgstr "Autor orixinal"

#: kdesu.cpp:122
msgid "Command '%1' not found."
msgstr "Non se atopou o comando '%1'."

#: kdesu.cpp:190
#, c-format
msgid "Illegal priority: %1"
msgstr "Prioridade ilegal: %1"

#: kdesu.cpp:218
msgid "No command specified!"
msgstr "¡Non se indicou un comando!"

#: kdesu.cpp:323
msgid ""
"Su returned with an error!\n"
msgstr ""
"¡Su devolveu un erro!\n"

#: kdesu.cpp:343
msgid "Command:"
msgstr "Comando:"

#: kdesu.cpp:348
msgid "realtime: "
msgstr "tempo real: "

#: kdesu.cpp:350
msgid "Priority:"
msgstr "Prioridade:"

#: sudlg.cpp:21
#, c-format
msgid "Run as %1"
msgstr "Executar como %1"

#: sudlg.cpp:25
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""
"A acción que solicitou precisa privilexios de root. Por favor, introduza o "
"contrasinal de root embaixo, ou prema Ignorar para continuar cos privilexios "
"actuais."

#: sudlg.cpp:29
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for \"%1\" below or click Ignore to continue with your current "
"privileges."
msgstr ""
"A acción que solicitou necesita privilexios adicionais. Por favor, "
"introduza o contrasinal de \"%1\" embaixo, ou prema Ignorar para continuar "
"cos privilexios actuais."

#: sudlg.cpp:34
msgid "&Ignore"
msgstr "&Ignorar"

#: sudlg.cpp:50
msgid "Conversation with su failed."
msgstr "A conversa co su fallou."

#: sudlg.cpp:59
msgid ""
"The program 'su' is not found!\n"
"Make sure your PATH is set correctly."
msgstr ""
"¡Non se atopou o programa `su'!\n"
"Asegúrese de que o PATH é correcto."

#: sudlg.cpp:66
msgid ""
"You are not allowed to use 'su'!\n"
"On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"¡Non ten permiso para executar `su'!\n"
"Nalgúns sistemas, ten que pertencer a un grupo\n"
"especial (a miúdo wheel) para usar este programa."

#: sudlg.cpp:73
msgid "Incorrect password! Please try again."
msgstr "¡Contrasinal incorrecto! Tente de novo."

#: sudlg.cpp:77
msgid "Internal error: Illegal return from SuProcess::checkInstall()"
msgstr "Erro interno: Valor de retorno de SuProcess::checkInstall() ilegal"

