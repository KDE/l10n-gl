#: konq_mainwindow.cc:2273
msgid ""
"Click this button to display the previous document<br><br>\n"
"\n"
"You can also select the <b>Back Command</b> from the Go menu."
msgstr ""
"Prema este botón para voltar ó documento anterior<br><br>\n"
"\n"
