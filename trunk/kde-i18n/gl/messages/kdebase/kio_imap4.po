#: imap4.cc:813
msgid "What do you want to store in this folder?"
msgstr "¿Que desexa gardar nesta carpeta?"

#: imap4.cc:813
msgid "Create Folder"
msgstr "Crear carpeta"

#: imap4.cc:814
msgid "&Messages"
msgstr "&Mensaxes"

#: imap4.cc:814
msgid "&Subfolders"
msgstr "&Subcarpetas"

#: imap4.cc:1092
msgid "Unsubscribe of folder %1 failed."
msgstr "A desubscripción á carpeta %1 fallou"

#: imap4.cc:1109
msgid "Subscribe of folder %1 failed."
msgstr "A subscripción á carpeta %1 fallou"

#: imap4.cc:1131 imap4.cc:1142
msgid "Changing the flags of message %1 failed."
msgstr "Erro na modificación dos flags da mensaxe %1."

#: imap4.cc:1231
msgid "Unable to close mailbox."
msgstr "Imposible cerrar-la conta de correo."

#: imap4.cc:1254
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "Imposible obter información da carpeta %1. O servidor respondeu: %2"

#: imap4.cc:1417
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"O servidor %1 non soporta nen IMAP4 nen IMAP4rev1.\n"
"Identificouse como: %2"

#: imap4.cc:1428
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"O servidor non soporta TLS.\n"
"Desactive esta propiedade de seguridade para conectarse sen cifrar."

#: imap4.cc:1453
msgid "Starting TLS failed."
msgstr "O inicio de TLS fallou"

#: imap4.cc:1463
msgid "The authentication method %1 is not supported by the server."
msgstr "O método de autentificación %1 non está soportado por este servidor."

#: imap4.cc:1474
msgid "Username and password for your IMAP account:"
msgstr "Nome de usuario e contrasinal para a súa conta IMAP:"

#: imap4.cc:1488
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or try to get a "
"different username."
msgstr ""
"No acceso a IMAP con texto en claro só son posibles caracteres US-ASCII . "
"Empregue un método de autentificación diferente que sexa soportado polo "
"seu servidor ou intente conseguir un nome de usuario diferente."

#: imap4.cc:1493
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or change your "
"password."
msgstr ""
"No acceso a IMAP con texto en claro só son posibles caracteres US-ASCII. "
"Empregue un método de autentificación diferente que sexa soportado polo "
"seu servidor ou cambie o seu contrasinal."

#: imap4.cc:1498
#, c-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"Imposible acceder. Probablemente o contrasinal sexa incorrecto.\n"
"O servidor respondeu:\n"
"%1:"

#: imap4.cc:1504
msgid ""
"Unable to authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"Imposible autentificarse a través de %1.\n"
"O servidor respondeu:\n"
"%2"

#: imap4.cc:1904
msgid "Unable to open folder %1. The server replied: %2"
msgstr "Imposible abri-la carpeta %1. O servidor respondeu: %2"
