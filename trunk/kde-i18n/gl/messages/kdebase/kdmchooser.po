#: chooser.cpp:31
msgid "Login chooser for Xdmcp"
msgstr "Seleccionador de acceso para Xdmcp"

#: chooser.cpp:62
msgid "Specify the chooser socket (in hex)"
msgstr "Especifique socket selector (en hex)"

#: chooser.cpp:63
msgid "Specify the client ip (in hex)"
msgstr "Especifique a ip do cliente (en hex)"

#: chooser.cpp:64
msgid "Specify the connection type (in dec)"
msgstr "Especifique o tipo de conexión (in dec)"

#: chooser.cpp:65
msgid "Specify the hosts to list or use BROADCAST"
msgstr "Especifique as máquinas a mostrar ou empregue BROADCAST"

#: DXdmcp.cpp:36
msgid "Hostname"
msgstr "Nome da máquina"

#: DXdmcp.cpp:37
msgid "Status"
msgstr "Estado"

#: DXdmcp.cpp:170
msgid "XDMCP Host Menu"
msgstr "Menú XDMCP para máquinas"

#: DXdmcp.cpp:180
msgid "A&dd host:"
msgstr "Enga&dir máquina:"

#: DXdmcp.cpp:185
msgid "&Accept"
msgstr "&Aceptar"

#: DXdmcp.cpp:186
msgid "&Ping"
msgstr "&Ping"

