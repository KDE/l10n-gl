#: kio_smb.cpp:1298 kio_smb.cpp:1348 kio_smb.cpp:1471 kio_smb.cpp:1503
#, c-format
msgid ""
"\n"
"Could not create required pipe %1."
msgstr ""
"\n"
"Imposible crear a tubería %1 solicitada."

#: kio_smb.cpp:1335
msgid ""
"To be able to write to a remote Samba share you must patch and recompile "
"smbclient.\n"
"Visit http://lisa-home.sourceforge.net/smbclientpatch.html and follow the "
"instructions there."
msgstr ""
"Para poder escribir nun recurso remoto Samba ten que parchear e recompilar "
"smbclient.\\ Visite http://lisa-home.sourceforge.net/smbclientpatch.html e "
"siga as instruccións."

#: kio_smb.cpp:1358 kio_smb.cpp:1366 kio_smb.cpp:1514 kio_smb.cpp:1522
#, c-format
msgid ""
"\n"
"Could not fcntl() pipe %1."
msgstr ""
"\n"
"Imposible executar fcntcl() na tubería %1 ."

