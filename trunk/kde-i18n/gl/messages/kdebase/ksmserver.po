#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"O xestor de sesións de KDE que conversa co protocolo estándar de\n"
"X11R6 para xestión de sesións (XSMP)."

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr "Restaura a sesión gardada de usuario se está dispoñible"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Executa 'wm' no caso de que non haxa ningún outro\n"
"xestor de fiestras presente na sesión. Por defecto é 'kwin'"

#: main.cpp:38
msgid "Also allow remote connections."
msgstr "Permitir tamén conexións remotas."

#: main.cpp:182
msgid "The KDE Session Manager"
msgstr "O Xestor de Sesións de KDE"

#: shutdown.cpp:82
msgid "End Session for \"%1\""
msgstr "Rematar a Sesión para \"%1\""

#: shutdown.cpp:106
msgid "What do you want to do?"
msgstr "Que quere facer?"

#: shutdown.cpp:107
msgid "&End session only"
msgstr "Só r&ematar a sesión"

#: shutdown.cpp:108
msgid "&Turn off computer"
msgstr "&Apaga-la computadora"

#: shutdown.cpp:109
msgid "&Restart computer"
msgstr "&Reiniciar a computadora"

#: shutdown.cpp:130
msgid "Shutdown Mode"
msgstr "Modo de Apagado"

#: shutdown.cpp:131
msgid "Sch&edule"
msgstr "&Programar"

#: shutdown.cpp:133
msgid "&Force now"
msgstr "&Forzar agora"

#: shutdown.cpp:134
msgid "&Try now"
msgstr "&Tentar agora"

#: shutdown.cpp:145
msgid "&Logout"
msgstr "&Saír"

