#: legacyimport.cpp:24
msgid ""
"<QT><b>Legacy Theme Importer</b><P>KDE now supports utilizing older themes fr"
"om other platforms in your new KDE desktop. The most common type of legacy th"
"eme is for the GTK toolkit, which is imported to KDE's Control Center with th"
"is utility.<P>In order to do this you must specify at least one item: the fol"
"der where the pixmaps for the theme is located. You may also have to specify "
"the  theme's gtkrc file if it's not in the same folder as the pixmaps. Both a"
"re usually in the folder \"gtk\" inside the theme's directory.</QT>"
msgstr ""
"<QT><b>Importador de Temas</b><P>Agora, KDE soporta a utilización de temas d"
"outras plataformas no seu escritorio. Os máis habituais deses temas son os d"
"o toolkit GTK, que se importan ó Centro de Control de KDE con esta utilidade"
".<P>Para poder facer isto, ten que indicar polo menos un elemento: a carpeta "
"onde se atopan os pixmaps do tema. Pode que tamén teña que especifica-lo fi"
"cheiro gtkrc do tema se non está na mesma carpeta que os pixmaps. Ambos est"
"án usualmente na carpeta \"gtk\" dentro do directorio do tema.</QT>"

#: legacyimport.cpp:34
msgid "Step 1: Specify theme's pixmap folder:"
msgstr "Paso 1: Indica-la carpeta de pixmaps do tema:"

#: legacyimport.cpp:37 legacyimport.cpp:63
msgid "Browse"
msgstr "Explorar"

#: legacyimport.cpp:52
msgid "Specify pixmap directory"
msgstr "Indique o directorio de pixmaps"

#: legacyimport.cpp:56
msgid ""
"<QT><b>Legacy Theme Importer</b><P>A gtkrc file was not found in the specifie"
"d directory. If it exists somewhere other than where the pixmaps are located "
"enter it here.</QT>"
msgstr ""
"<QT><b>Importador de Temas</b><P>Non se atopou o ficheiro gtkrc no directorio"
" indicado. Se está nalgún sitio distinto ó dos pixmaps, indíqueo aquí.</"
"QT>"

#: legacyimport.cpp:60
msgid "Step 2: Specify theme's gtkrc:"
msgstr "Paso 2: Indica-lo gtkrc do tema:"

#: legacyimport.cpp:77
msgid "Specify gtkrc directory"
msgstr "Indique o directorio do gtkrc"

#: legacyimport.cpp:86
msgid "Legacy Import"
msgstr "Importación de Temas"

#: legacyimport.cpp:94
msgid "GTK theme's folder"
msgstr "Carpeta do tema de GTK"

#: legacyimport.cpp:118 legacyimport.cpp:139
msgid "You did not enter a valid file!"
msgstr "¡Non indicou un ficheiro válido!"

#: legacyimport.cpp:126
msgid "Gtkrc theme file"
msgstr "Ficheiro gtkrc do tema"

#: legacyimport.cpp:146
msgid "Theme title"
msgstr "Título do tema"

#: legacyimport.cpp:147
msgid "Please enter a short title for this theme"
msgstr "Introduza un pequeno título para este tema"

#: legacyimport.cpp:155
msgid "Legacy widget theme"
msgstr "Tema de widget non-KDE"

#: legacyimport.cpp:161
msgid "The theme is now installed and will be shown in KDE's control center."
msgstr "O tema está agora instalado e será mostrado no centro de control de KDE."

#: legacyimport.cpp:168
msgid "KLegacyImport"
msgstr "KLegacyImport"

#: legacyimport.cpp:169
msgid "Importer for legacy themes"
msgstr "Importador de temas non-KDE"
