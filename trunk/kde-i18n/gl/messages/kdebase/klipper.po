#: configdialog.cpp:115
msgid ""
"<qt>There are two different clipboard buffers available:"
"<br>"
"<br>The <b>Clipboard</b>, that you fill by selecting something"
"<br>and pressing Ctrl-C or by pressing \"Copy\" in a tool- "
"or"
"<br>menubar."
"<br>"
"<br>And the <b>Selection</b>, that is available immediately "
"after"
"<br>selecting some text. The only way to access the selection"
"<br>is to press the middle mouse button."
"<br>"
"<br>Selecting this option synchronizes those two buffers, so they"
"<br>work the same way as in KDE 1.x and 2.x</qt>"
msgstr ""

