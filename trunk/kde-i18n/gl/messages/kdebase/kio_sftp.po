#: kio_sftp.cpp:294
msgid "Opening connection to host <b>%1:%2</b>"
msgstr "Establecendo conexión con <b>%1:%2</b>"

#: kio_sftp.cpp:355
msgid "Sftp Login"
msgstr "Acceso sftp"

#: kio_sftp.cpp:357
msgid "site:"
msgstr "servidor:"

#: kio_sftp.cpp:369
msgid "Login failed. Retrying..."
msgstr "Acceso fallido. Reintentando..."

#: kio_sftp.cpp:391
msgid "Please enter your username and password."
msgstr "Por favor introduza o seu nome de usuario e o seu contrasinal."

#: kio_sftp.cpp:394
msgid ""
"Login failed.\n"
"Please confirm your username and password, and enter them again."
msgstr ""
"Acceso fallido.\n"
"Por favor confirme que o seu nome de usuario e contrasinal son correctas e "
"introdúzcalos de novo."

#: kio_sftp.cpp:399
msgid "Please enter a username and password"
msgstr "Por favor intoduza nome de usuario e contrasinal"

#: kio_sftp.cpp:419
msgid "Connection failed."
msgstr "Conexión fallida."

#: kio_sftp.cpp:425
msgid "Warning: Host key not found!"
msgstr "Aviso: ¡Clave da máquina non atopada!"

#: kio_sftp.cpp:429
msgid "Warning: Host key has changed!"
msgstr "Aviso: ¡A clave da máquina cambiou!"

#: kio_sftp.cpp:440
msgid "Shall we continue connecting to %1?"
msgstr "¿Continua-la conexión con %1?"

#: kio_sftp.cpp:457
msgid "Connected to "
msgstr "Conectado a "

#: kio_sftp.cpp:488
msgid "Timed out waiting for a response from the server."
msgstr "Tempo de resposta esgotado mentras se esperaba unha resposta do servidor."

#: kio_sftp.cpp:501
msgid "Login failed."
msgstr "Acceso fallido"

#: kio_sftp.cpp:503
msgid ""
"Could not login to %1.\n"
"Maximum number of retries exceeded."
msgstr ""
"Imposible acceder a %1.\n"
"Excedeuse o número máximo de intentos."

#: kio_sftp.cpp:531
msgid "Login OK"
msgstr "Acceso realizado con éxito"

