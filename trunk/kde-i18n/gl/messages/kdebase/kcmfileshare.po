#: fileshare.cpp:39
msgid "File Sharing"
msgstr "Compartido de Ficheiros"

#: fileshare.cpp:43
msgid "Do &not allow users to share files"
msgstr "&Non aturar que os usuarios compartan ficheiros"

#: fileshare.cpp:44
msgid "&Allow users to share files from their HOME folder"
msgstr "&Aturar que os usuarios compartan ficheiros dende o seu cartafol persoal"

#: fileshare.cpp:55
msgid ""
"SMB and NFS servers are not installed on this machine, to enable this module "
"the servers must be installed."
msgstr ""
"Os servidors NFS e SMB non están instalados nesta máquina, e para activar "
"este módulo os servidores deben estar instalados."

#: fileshare.cpp:140
msgid ""
"<h1>File Sharing</h1>"
"<p>"
"This module can be used to enable file sharing over the network using the "
"\"Network File System\" (NFS) or SMB in Konqueror. The latter enables you to "
"share your files with Windows(TM) computers on your network.</p>"
msgstr ""
"<h1>Compartido de Ficheiros</h1>"
"<p>Este módulo pode ser empregado para habilita-lo compartido de ficheiros "
"na rede usando o \"Sistema de Ficheiros de Rede\" (NFS) ou SMB en Konqueror. "
"O último permite comparti-los seus ficheiros con máquinas Windows(TM) na "
"rede.</p>"

#~ msgid "SMB and NFS servers not installed!"
#~ msgstr "¿Os servidores SMB e NFS non están instalados!"

