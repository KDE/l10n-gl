msgstr "Configuración dos Servidores de Chaves"

#: rc.cpp:37
msgid ""
"<qt><b>Key Servers Configuration:</b><br />\n"
"\t\t"
"<p>This dialog is used for configuring which Internet based key servers are "
"to be polled, and in what order they are to be polled when searching for "
"public keys.</p>\n"
"\t\t</qt>"
msgstr ""
"<qt><b>Configuración dos Servidores de Chaves:</b><br />\n"
"\t\t"
"<p>Este diálogo emprégase para configurar qué servidores de chaves de "
"Internet se consultarán, e en qué orde, cando se procure por chaves "
"públicas.</p>\n"
"\t\t</qt>"

#: rc.cpp:38
msgid "Third server:"
msgstr "Terceiro servidor:"

#: rc.cpp:39
msgid ""
"<qt><b>Third Server:</b><br />\n"
"\t\t\t"
"<p>This option specifies the Third key server that will be polled when "
"attempting to download GPG/PGP keys from an Internet based key server. "
"<i>Please note:</i>"
" The first server will be stored in GnuPG's configuration file, all other "
"key servers are stored for use by KGpg only.</p>\n"
"\t\t\t</qt>"
msgstr ""
"<qt><b>Terceiro Servidor:</b><br />\n"
"\t\t\t"
"<p>Esta opción especifica o terceiro servidor de chaves que se empregará "
"cando se tente descargar unha chave GPG/PGP dende un servidor de chaves de "
"Internet. <i>Por favor, note:</i> O Primeiro Servidor almacearase no "
"ficheiro de configuración de GnuPG, tódolos demais servidores almacéanse "
"para o emprego por parte de KGpg.</p>\n"
"\t\t\t</qt>"

