#: kdepasswd.cpp:25
msgid "Change password of this user."
msgstr "Muda-lo contrasinal deste usuario."

#: kdepasswd.cpp:32
msgid "KDE passwd"
msgstr "KDE passwd"

#: kdepasswd.cpp:33
msgid "Changes a UNIX password."
msgstr "Muda un contrasinal de Unix."

#: kdepasswd.cpp:35
msgid "Maintainer"
msgstr "Encargado"

#: kdepasswd.cpp:51
msgid "You need to be root to change the password of other users."
msgstr "Precisa ser administrador para cambia-lo contrasinal dos outros usuarios."

#: passwddlg.cpp:19 passwddlg.cpp:87
msgid "Change Password"
msgstr "Mudar Contrasinal"

#: passwddlg.cpp:20
msgid "Please enter your current password."
msgstr "Introduza o seu contrasinal actual."

#: passwddlg.cpp:41 passwddlg.cpp:159
msgid "Conversation with `passwd' failed."
msgstr "A conversa co `passwd' fallou."

#: passwddlg.cpp:51
msgid "Could not find the program `passwd'."
msgstr "Non se atopou o programa `passwd'."

#: passwddlg.cpp:56
msgid "Incorrect password! Please try again."
msgstr "¡Contrasinal incorrecto! Tente de novo."

#: passwddlg.cpp:60
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr "Erro interno: valor de terno ilegal en PasswdProcess::checkCurrent."

#: passwddlg.cpp:89
msgid "Please enter your new password."
msgstr "Introduza o seu novo contrasinal."

#: passwddlg.cpp:91
msgid "Please enter the new password for user <b>%1</b>."
msgstr "Introduza o novo contrasinal para o usuario <b>%1</b>."

#: passwddlg.cpp:108
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"O seu contrasinal é máis longo de 8 caracteres. Nalgúns sistemas, isto pode "
"causar problemas. Pode cambia-lo seu contrasinal, ou deixa-lo tal e como está."

#: passwddlg.cpp:111
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"O contrasinal é máis longo de 8 caracteres. Nalgúns sistemas, isto pode "
"causar problemas. Pode cambia-lo seu contrasinal, ou deixa-lo tal e como está."

#: passwddlg.cpp:115
msgid "Password too long"
msgstr "Contrasinal demasiado longo"

#: passwddlg.cpp:116
msgid "Truncate"
msgstr "Mudar"

#: passwddlg.cpp:117
msgid "Use as is"
msgstr "Empregar coma está"

#: passwddlg.cpp:138
msgid "Your password has been changed."
msgstr "O seu contrasinal foi cambiado."

#: passwddlg.cpp:148
msgid "Your password has not been changed."
msgstr "O seu contrasinal non foi cambiado."

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr ""
"Jesús Bravo\n"
"Xabi García"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "xabigf@gmx.net"

