msgid "Supporting KDE"
msgstr "Apoiar KDE"

#. type: Plain Text
#: content/announcements/applications/14.12-beta1.md:23
#: content/announcements/applications/14.12-beta2.md:23
#: content/announcements/applications/14.12-beta3.md:23
