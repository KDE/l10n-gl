#~ "<ul>\n"
#~ "<li>Fix compilation with Qt 5.2.0</li>\n"
#~ "</ul>\n"
#~ "\n"
#~ "<h3>KNewStuff</h3>\n"
#~ "\n"
#~ "<ul>\n"
#~ "<li>Also allow absolute filepaths for configfile parameter.</li>\n"
#~ "<li>Fix compilation on Windows</li>\n"
#~ "</ul>\n"
#~ "\n"
#~ "<h3>KNotifications</h3>\n"
