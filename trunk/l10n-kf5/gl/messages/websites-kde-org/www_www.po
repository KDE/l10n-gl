#| msgid "Plasma 5.7"
msgid "Plasma 5.17"
msgstr "Plasma 5.7"

#. type: shortcode parameter
#: content/announcements/plasma/5/5.17.0.md:7
#: content/announcements/plasma/5/5.17.1.md:7
#: content/announcements/plasma/5/5.17.2.md:7
#: content/announcements/plasma/5/5.17.3.md:7
#: content/announcements/plasma/5/5.17.4.md:7
