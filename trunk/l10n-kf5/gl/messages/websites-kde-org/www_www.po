#~ "<li>Add guard when trying to access root object before component is "
#~ "complete</li>\n"
#~ "</ul>\n"
#~ "\n"
#~ "<h3>KEmoticons</h3>\n"
#~ "\n"
#~ "<ul>\n"
#~ "<li>Add KEmoticonsIntegrationPlugin for KTextToHTML from KCoreAddons</"
