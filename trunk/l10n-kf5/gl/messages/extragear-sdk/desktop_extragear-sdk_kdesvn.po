#: src/kdesvnd/kdesvnd.desktop:3
msgctxt "Name"
msgid "kdesvnd subversion module"
msgstr "Módulo de Subversion kdesvnd"

#: src/kdesvnd/kdesvnd.desktop:26
msgctxt "Comment"
msgid "Gives various Subversion actions to file managers and other software"
msgstr ""
"Fornece varias accións de Subversion aos xestores de ficheiros e outros "
"programas."

#: src/kdesvnd/kdesvn_subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion (kdesvn)"
msgstr "Subversion (kdesvn)"

#: src/kdesvnd/kdesvn_subversion.desktop:30
msgctxt "Name"
msgid "Subversion log (last 100)"
msgstr "Últimos 100 cambios de Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:54
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:32
msgctxt "Comment"
msgid "Displays the Subversion log"
msgstr "Mostra o historial de Subversion."

#: src/kdesvnd/kdesvn_subversion.desktop:78
msgctxt "Name"
msgid "Detailed Subversion info"
msgstr "Información detallada de Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:104
msgctxt "Name"
msgid "Add to Repository"
msgstr "Engadir ao repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:132
msgctxt "Name"
msgid "Check for unversioned items"
msgstr "Buscar elementos alleos"

#: src/kdesvnd/kdesvn_subversion.desktop:157
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Eliminar do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:183
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Anular as modificacións locais"

#: src/kdesvnd/kdesvn_subversion.desktop:207
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Borra as alteracións feitas a nivel local. Atención, isto non pode ser "
"anulado."

#: src/kdesvnd/kdesvn_subversion.desktop:231
msgctxt "Name"
msgid "Rename..."
msgstr "Mudar o nome..."

#: src/kdesvnd/kdesvn_subversion.desktop:257
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Cambia o nome dun ficheiro tanto localmente como no repositorio. Use isto en "
"vez de engadir e eliminar o ficheiro para cambiar o nome."

#: src/kdesvnd/kdesvn_subversion.desktop:281
msgctxt "Name"
msgid "Import Repository"
msgstr "Importar un repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:305
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr ""
"Pon o cartafol nun repositorio existente para pólo baixo control de versións."

#: src/kdesvnd/kdesvn_subversion.desktop:329
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:56
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Obter do repositorio..."

#: src/kdesvnd/kdesvn_subversion.desktop:353
#: src/kdesvnd/kdesvn_subversion.desktop:716
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:80
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:224
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Obtén todos os ficheiros dun repositorio existente para este cartafol."

#: src/kdesvnd/kdesvn_subversion.desktop:377
msgctxt "Name"
msgid "Switch..."
msgstr "Mudar..."

#: src/kdesvnd/kdesvn_subversion.desktop:400
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Cambiar a copia de traballo indicada a unha outra rama."

#: src/kdesvnd/kdesvn_subversion.desktop:425
msgctxt "Name"
msgid "Merge..."
msgstr "Fusionar..."

#: src/kdesvnd/kdesvn_subversion.desktop:449
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Fusiona as modificacións entre esta galla e outra"

#: src/kdesvnd/kdesvn_subversion.desktop:474
msgctxt "Name"
msgid "Blame..."
msgstr "Autorías..."

#: src/kdesvnd/kdesvn_subversion.desktop:497
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Consulta quen escribiu unha liña dada no ficheiro e en que versión"

#: src/kdesvnd/kdesvn_subversion.desktop:522
msgctxt "Name"
msgid "Create Patch..."
msgstr "Crear un parche..."

#: src/kdesvnd/kdesvn_subversion.desktop:548
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:104
msgctxt "Name"
msgid "Export..."
msgstr "Exportar..."

#: src/kdesvnd/kdesvn_subversion.desktop:573
#: src/kdesvnd/kdesvn_subversion.desktop:763
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:129
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:271
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "Obtén unha copia sen control de versións dunha árbore do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:597
msgctxt "Name"
msgid "Diff (local)"
msgstr "Diferenzas (local)"

#: src/kdesvnd/kdesvn_subversion.desktop:621
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Mostra as modificacións locais desde a última actualización"

#: src/kdesvnd/kdesvn_subversion.desktop:645
msgctxt "Name"
msgid "KDESvn Update"
msgstr "Actualizar con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:670
msgctxt "Name"
msgid "KDESvn Commit"
msgstr "Remitir con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:694
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:202
msgctxt "Name"
msgid "Checkout from a repository..."
msgstr "Obter dun repositorio…"

#: src/kdesvnd/kdesvn_subversion.desktop:740
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:248
msgctxt "Name"
msgid "Export from a Subversion repository..."
msgstr "Exportar dun repositorio de Subversion…"

#: src/kdesvnd/kdesvn_subversion.desktop:787
msgctxt "Name"
msgid "Display revision tree"
msgstr "Mostrar a árbore de revisións"

#: src/kdesvnd/kdesvn_subversion.desktop:810
msgctxt "Comment"
msgid "Show complete revision tree"
msgstr "Mostrar a árbore de revisións completa."

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:9
msgctxt "Name"
msgid "kdesvn log (last 100)"
msgstr "Últimos 100 cambios de kdesvn"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:153
msgctxt "Name"
msgid "Update (Kdesvn)"
msgstr "Actualizar con Kdesvn"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:178
msgctxt "Name"
msgid "Commit (Kdesvn)"
msgstr "Remitir con Kdesvn"

