#: src/kdesvnd/kdesvnd.desktop:3
msgctxt "Name"
msgid "kdesvnd subversion module"
msgstr "Módulo de Subversion kdesvnd"

#: src/kdesvnd/kdesvnd.desktop:27
msgctxt "Comment"
msgid "Gives various Subversion actions to file managers and other software"
msgstr ""
"Fornece varias accións de Subversion aos xestores de ficheiros e outros "
"programas."

#: src/kdesvnd/kdesvn_subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion (kdesvn)"
msgstr "Subversion (kdesvn)"

#: src/kdesvnd/kdesvn_subversion.desktop:31
msgctxt "Name"
msgid "Subversion log (last 100)"
msgstr "Últimos 100 cambios de Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:56
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:33
msgctxt "Comment"
msgid "Displays the Subversion log"
msgstr "Mostra o historial de Subversion."

#: src/kdesvnd/kdesvn_subversion.desktop:81
msgctxt "Name"
msgid "Detailed Subversion info"
msgstr "Información detallada de Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:108
msgctxt "Name"
msgid "Add to Repository"
msgstr "Engadir ao repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:137
msgctxt "Name"
msgid "Check for unversioned items"
msgstr "Buscar elementos alleos"

#: src/kdesvnd/kdesvn_subversion.desktop:163
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Eliminar do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:190
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Anular as modificacións locais"

#: src/kdesvnd/kdesvn_subversion.desktop:215
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Borra as alteracións feitas a nivel local. Atención, isto non pode ser "
"anulado."

#: src/kdesvnd/kdesvn_subversion.desktop:240
msgctxt "Name"
msgid "Rename..."
msgstr "Cambiar o nome…"

#: src/kdesvnd/kdesvn_subversion.desktop:266
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Cambia o nome dun ficheiro tanto localmente como no repositorio. Use isto en "
"vez de engadir e eliminar o ficheiro para cambiar o nome."

#: src/kdesvnd/kdesvn_subversion.desktop:291
msgctxt "Name"
msgid "Import Repository"
msgstr "Importar un repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:316
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr ""
"Pon o cartafol nun repositorio existente para pólo baixo control de versións."

#: src/kdesvnd/kdesvn_subversion.desktop:341
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:58
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Obter do repositorio…"

#: src/kdesvnd/kdesvn_subversion.desktop:366
#: src/kdesvnd/kdesvn_subversion.desktop:745
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:83
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:234
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Obtén todos os ficheiros dun repositorio existente para este cartafol."

#: src/kdesvnd/kdesvn_subversion.desktop:391
msgctxt "Name"
msgid "Switch..."
msgstr "Cambiar…"

#: src/kdesvnd/kdesvn_subversion.desktop:415
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Cambiar a copia de traballo indicada a unha outra rama."

#: src/kdesvnd/kdesvn_subversion.desktop:441
msgctxt "Name"
msgid "Merge..."
msgstr "Fusionar…"

#: src/kdesvnd/kdesvn_subversion.desktop:466
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Fusiona as modificacións entre esta galla e outra"

#: src/kdesvnd/kdesvn_subversion.desktop:492
msgctxt "Name"
msgid "Blame..."
msgstr "Autorías…"

#: src/kdesvnd/kdesvn_subversion.desktop:516
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Consulta quen escribiu unha liña dada no ficheiro e en que versión"

#: src/kdesvnd/kdesvn_subversion.desktop:542
msgctxt "Name"
msgid "Create Patch..."
msgstr "Crear un parche…"

#: src/kdesvnd/kdesvn_subversion.desktop:569
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:108
msgctxt "Name"
msgid "Export..."
msgstr "Exportar…"

#: src/kdesvnd/kdesvn_subversion.desktop:596
#: src/kdesvnd/kdesvn_subversion.desktop:794
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:135
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:283
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "Obtén unha copia sen control de versións dunha árbore do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:621
msgctxt "Name"
msgid "Diff (local)"
msgstr "Diferenzas (local)"

#: src/kdesvnd/kdesvn_subversion.desktop:646
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Mostra as modificacións locais desde a última actualización"

#: src/kdesvnd/kdesvn_subversion.desktop:671
msgctxt "Name"
msgid "KDESvn Update"
msgstr "Actualizar con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:697
msgctxt "Name"
msgid "KDESvn Commit"
msgstr "Remitir con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:722
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:211
msgctxt "Name"
msgid "Checkout from a repository..."
msgstr "Obter dun repositorio…"

#: src/kdesvnd/kdesvn_subversion.desktop:770
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:259
msgctxt "Name"
msgid "Export from a Subversion repository..."
msgstr "Exportar dun repositorio de Subversion…"

#: src/kdesvnd/kdesvn_subversion.desktop:819
msgctxt "Name"
msgid "Display revision tree"
msgstr "Mostrar a árbore de revisións"

#: src/kdesvnd/kdesvn_subversion.desktop:843
msgctxt "Comment"
msgid "Show complete revision tree"
msgstr "Mostrar a árbore de revisións completa."

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:9
msgctxt "Name"
msgid "kdesvn log (last 100)"
msgstr "Últimos 100 cambios de kdesvn"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:160
msgctxt "Name"
msgid "Update (Kdesvn)"
msgstr "Actualizar con Kdesvn"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:186
msgctxt "Name"
msgid "Commit (Kdesvn)"
msgstr "Remitir con Kdesvn"

#: src/kdesvn.notifyrc:3
msgctxt "Comment"
msgid "Kdesvn notification"
msgstr "Notificación de Kdesvn"

#: src/kdesvn.notifyrc:27
msgctxt "Name"
msgid "Kdesvn KIO Notification"
msgstr "Notificación de KIO de Kdesvn"

#: src/kdesvn.notifyrc:52
msgctxt "Name"
msgid "Kdesvn task notification"
msgstr "Notificación de tarefa de Kdesvn"

#: src/kdesvnpart.desktop:2
msgctxt "Name"
msgid "kdesvnpart"
msgstr "kdesvnpart"

#: src/kdesvnpart.desktop:25 src/org.kde.kdesvn.desktop:27
msgctxt "GenericName"
msgid "SVN Client"
msgstr "Cliente de Subversion"

#: src/kdesvnpart.desktop:52 src/org.kde.kdesvn.desktop:55
msgctxt "Comment"
msgid "A Subversion client by KDE"
msgstr "Un cliente de Subversion fornecido por KDE."

