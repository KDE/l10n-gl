#, kde-format
msgctxt "1: function, 2: file, 3: line, 4: module"
msgid ""
"%1\n"
"  at %2:%3\n"
"  in %4"
msgstr ""
"%1\n"
"  en %2:%3\n"
"  en %4"

#: gui/callercalleemodel.cpp:240 gui/treemodel.cpp:213 gui/treemodel.cpp:248
#, kde-format
msgctxt "1: function, 2: module"
msgid ""
"%1\n"
"  in %2"
msgstr ""
"%1\n"
"  en %2"

#: gui/callercalleemodel.cpp:244
#, kde-format
msgid ""
"inclusive: allocated %1 over %2 calls (%3 temporary, i.e. %4%), peak at %5, "
"leaked %6"
msgstr ""
"total: asignou %1 mediante %2 chamadas (%3 temporais, o %4), cun pico de %5, "
"perdeu %6."

#: gui/callercalleemodel.cpp:254
#, kde-format
msgid ""
"self: allocated %1 over %2 calls (%3 temporary, i.e. %4%), peak at %5, "
"leaked %6"
msgstr ""
"directo: asignou %1 mediante %2 chamadas (%3 temporais, o %4), cun pico de "
"%5, perdeu %6."

