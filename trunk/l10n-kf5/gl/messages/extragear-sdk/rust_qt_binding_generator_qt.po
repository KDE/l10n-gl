#: parseJson.cpp:160
#, qt-format
msgctxt "main|"
msgid "'%1' is not a supported type. Use one of\n"
msgstr "«%1» non é un tipo compatíbel. Use un do seguintes:\n"

#: parseJson.cpp:194
#, qt-format
msgctxt "main|"
msgid ""
"'%1' is not a supported type in argument \"%2\". Only use the basic QT types "
"for now\n"
msgstr ""
"«%1» non é un tipo permitido para o argumento «%2». De momento use "
"unicamente os tipos básicos de Qt.\n"

#: parseJson.cpp:219
#, qt-format
msgctxt "main|"
msgid ""
"'%1' is not a supported return type in function \"%2\". Only use the basic "
"QT types for now\n"
msgstr ""
"«%1» non é un tipo de reposta permitido na función «%2». De momento use "
"unicamente os tipos básicos de Qt.\n"

