#: addcollectiontask.cpp:50
#, kde-format
msgid "Cannot add IMAP folder '%1' for a non-existing parent folder '%2'."
msgstr ""
"Non é posíbel engadir o cartafol IMAP «%1» a un cartafol pai «%2» que non "
"existe."

#: addcollectiontask.cpp:86
#, kde-format
msgid "Failed to create the folder '%1' on the IMAP server. "
msgstr "Non foi posíbel crear o cartafol «%1» no servidor IMAP. "

#: addcollectiontask.cpp:106 movecollectiontask.cpp:142
#, kde-format
msgid ""
"Failed to subscribe to the folder '%1' on the IMAP server. It will disappear "
"on next sync. Use the subscription dialog to overcome that"
msgstr ""
"Non foi posíbel subscribirse ao cartafol «%1» no servidor de IMAP. Ha "
"desaparecer na vindeira sincronización. Empregue o diálogo de subscrición "
"para solucionar iso"

