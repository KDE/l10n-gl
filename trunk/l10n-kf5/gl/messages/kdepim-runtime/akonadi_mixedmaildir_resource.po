"O elemento %1 pertence á colección %2, que é incorrecta. É posíbel que se "
"eliminase a colección?"

#: mixedmaildirresource.cpp:203
#, kde-format
msgctxt "@info:status"
msgid "Synchronizing email folders"
msgstr "Sincronizando os cartafoles de correo."

#: mixedmaildirresource.cpp:218
#, kde-format
msgctxt "@info:status"
msgid "Synchronizing email folder %1"
msgstr "Sincronizando o cartafol de correo %1"

#: mixedmaildirresource.cpp:319
#, kde-format
msgctxt "@info:status"
msgid "Cannot move root maildir folder '%1'."
msgstr "Non se pode mover o cartafol de correo principal, «%1»,"

#: mixedmaildirresource.cpp:347
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "Non se pode eliminar o cartafol de correo principal, «%1»."

#: mixedmaildirresource.cpp:361
#, kde-format
msgctxt "@info:status"
msgid "Unable to create maildir '%1'."
msgstr "Non se pode crear o directorio de correo «%1»."

