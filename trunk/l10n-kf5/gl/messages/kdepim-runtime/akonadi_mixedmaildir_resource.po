#: mixedmaildirstore.cpp:1956
#, kde-format
msgctxt "@info:status"
msgid "Cannot move emails from folder %1"
msgstr "Non se poden mover os correos do cartafol %1."

#: mixedmaildirstore.cpp:1915 mixedmaildirstore.cpp:1943
#: mixedmaildirstore.cpp:1988 mixedmaildirstore.cpp:2012
#: mixedmaildirstore.cpp:2019 mixedmaildirstore.cpp:2098
#: mixedmaildirstore.cpp:2122
#, kde-format
msgctxt "@info:status"
msgid "Cannot move emails to folder %1"
msgstr "Non se poden mover correos ao cartafol %1."

#: mixedmaildirstore.cpp:1964 mixedmaildirstore.cpp:2064
#: mixedmaildirstore.cpp:2086
#, kde-format
msgctxt "@info:status"
msgid "Cannot move email from folder %1"
msgstr "Non se pode mover correo do cartafol %1."

