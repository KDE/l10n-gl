msgid "Cannot modify emails in folder %1"
msgstr "Non se poden modificar os correos do cartafol %1."

#: mixedmaildirstore.cpp:1876
#, kde-format
msgctxt "@info:status"
msgid "Cannot modify emails in folder %1. %2"
msgstr "Non se poden modificar os correos do cartafol %1. %2"

