#, kde-format
msgctxt "@info:status"
msgid "Cannot move email from folder %1 to folder %2"
msgstr "Non se pode mover correo do cartafol %1 ao cartafol %2."

#: mixedmaildirstore.cpp:2303
#, kde-format
msgctxt "@info:status"
msgid "Cannot move folder %1 into one of its own subfolder tree"
msgstr ""
"Non se pode mover o cartafol %1 a un dos seus propios subcartafoles na "
"xerarquía."

#: mixedmaildirstore.cpp:2315
#, kde-format
msgctxt "@info:status"
msgid "Cannot add email to folder %1 because there is no email content"
msgstr ""
"Non se poden engadir mensaxes ao cartafol %1 porque carecen de contido."

#: mixedmaildirstore.cpp:2323
#, kde-format
msgctxt "@info:status"
msgid "Cannot modify email in folder %1 because there is no email content"
msgstr ""
"Non se poden modificar as mensaxes do cartafol %1 porque carecen de contido."

