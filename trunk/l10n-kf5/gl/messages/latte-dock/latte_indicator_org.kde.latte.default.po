#: default/package/config/config.qml:37
#, kde-format
msgctxt "active indicator style"
msgid "Style For Active"
msgstr "Estilo para o activo"

#: default/package/config/config.qml:56
#, kde-format
msgctxt "line indicator"
msgid "Line"
msgstr "Liña"

#: default/package/config/config.qml:60
#, kde-format
msgid "Show a line indicator for active items"
msgstr "Mostrar un indicador de liña para elementos activos"

#: default/package/config/config.qml:74
#, kde-format
msgctxt "dot indicator"
msgid "Dot"
msgstr "Punto"

#: default/package/config/config.qml:78
#, kde-format
msgid "Show a dot indicator for active items"
msgstr "Mostrar un indicador de punto para elementos activos"

#: default/package/config/config.qml:98
#, kde-format
msgid "Glow"
msgstr "Brillo"

#: default/package/config/config.qml:99
#, kde-format
msgid "Enable/disable indicator glow"
msgstr "Activar ou desactivar o brillo do indicador"

#: default/package/config/config.qml:123
#, kde-format
msgctxt "glow only to active task/applet indicators"
msgid "On Active"
msgstr "Nos activos"

#: default/package/config/config.qml:127
#, kde-format
msgid "Add glow only to active task/applet indicator"
msgstr "Engadir un brillo aos indicadores de tarefas e trebellos activos"

#: default/package/config/config.qml:141
#, kde-format
msgctxt "glow to all task/applet indicators"
msgid "All"
msgstr "Todos"

#: default/package/config/config.qml:145
#, kde-format
msgid "Add glow to all task/applet indicators"
msgstr "Engadir un brillo a todos os indicadores de tarefa e trebello"

#: default/package/config/config.qml:167
#, kde-format
msgid "Opacity"
msgstr "Opacidade"

#: default/package/config/config.qml:200 default/package/config/config.qml:240
#, kde-format
msgctxt "number in percentage, e.g. 85 %"
msgid "%0 %"
msgstr "%0 %"

#: default/package/config/config.qml:208
#, kde-format
msgid "Padding"
msgstr "Recheo"

#: default/package/config/config.qml:216
#, kde-format
msgid "Length"
msgstr "Lonxitude"

#: default/package/config/config.qml:255
#, kde-format
msgid "Tasks"
msgstr "Tarefas"

#: default/package/config/config.qml:261
#, kde-format
msgid "Different color for minimized windows"
msgstr "Cor distinta para as xanelas minimizadas"

#: default/package/config/config.qml:271
#, kde-format
msgid "Show an extra dot for grouped windows when active"
msgstr ""
"Mostrar un punto adicional para as xanelas agrupadas cando estea activo"

#: default/package/config/config.qml:273
#, kde-format
msgid ""
"Grouped windows show both a line and a dot when one of them is active and "
"the Line Active Indicator is enabled"
msgstr ""
"As xanelas agrupadas mostran tanto unha liña como un punto cando unha delas "
"está activa e o indicador de activo de liña está cativado"

#: default/package/config/config.qml:285
#, kde-format
msgid "Options"
msgstr "Opcións"

#: default/package/config/config.qml:290
#, kde-format
msgid "Show indicators for applets"
msgstr "Mostrar indicadores para os trebellos"

#: default/package/config/config.qml:292
#, kde-format
msgid "Indicators are shown for applets"
msgstr "Os indicadores móstranse para trebellos"

#: default/package/config/config.qml:301
#, kde-format
msgid "Reverse indicator style"
msgstr "Inverter o estilo do indicador"
