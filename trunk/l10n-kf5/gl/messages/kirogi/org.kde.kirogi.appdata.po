#. (itstool) path: component/name
#: org.kde.kirogi.appdata.xml:7
msgid "Kirogi"
msgstr "Kirogi"

#. (itstool) path: component/summary
#: org.kde.kirogi.appdata.xml:8
msgid "UAV (drone) ground control"
msgstr "Control de terra de drons."

#. (itstool) path: description/p
#: org.kde.kirogi.appdata.xml:14
msgid ""
"Kirogi is a ground control application for drones. Take to the skies, open "
"source-style."
msgstr ""
"Kirogi é unha aplicación de control de drons desde terra. Conquiste o ceo "
"con programas libres."

#. (itstool) path: description/p
#: org.kde.kirogi.appdata.xml:15
msgid "Features:"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#: org.kde.kirogi.appdata.xml:17
msgid "Direct flight controls"
msgstr "Controles de voo directo."

#. (itstool) path: ul/li
#: org.kde.kirogi.appdata.xml:18
msgid "Fly by touch on a Navigation Map"
msgstr "Voe mediante toque no mapa de navegación."

#. (itstool) path: ul/li
#: org.kde.kirogi.appdata.xml:19
msgid "Trigger vehicle actions (e.g. flips, trim)"
msgstr "Disparar accións do vehículo (p. ex. voltas, axuste de voo)."

#. (itstool) path: ul/li
#: org.kde.kirogi.appdata.xml:20
msgid "Gamepad/joypad support"
msgstr "Compatibilidade con mandos."

#. (itstool) path: ul/li
#: org.kde.kirogi.appdata.xml:21
msgid "Live video"
msgstr "Vídeo en directo."

#. (itstool) path: ul/li
#: org.kde.kirogi.appdata.xml:22
msgid "Take photo and record video"
msgstr "Sacar fotos e gravar vídeos."

#. (itstool) path: ul/li
#: org.kde.kirogi.appdata.xml:23
msgid "Configure flight parameters (speed, altitude limits)"
msgstr "Configurar os parámetros de voo (velocidade, límites de altitude)."

#. (itstool) path: ul/li
#: org.kde.kirogi.appdata.xml:24
msgid ""
"Support for Parrot (Anafi, Bebop 2) and Ryze Tello drones (more planned)"
msgstr ""
"Compatibilidade con drones de Parrot (Anafi, Bebop 2) e Ryze Tello. Hai "
"plans para máis."

#. (itstool) path: screenshot/caption
#: org.kde.kirogi.appdata.xml:37
msgid "The Kirogi in-flight UI"
msgstr "A interface de Kirogi durante o voo."

