#~ msgstr "FLOOR(12,5) é igual a 12"

#~ msgid "FLOOR(-12.5) equals -13"
#~ msgstr "FLOOR(-12,5) é igual a -13"

#~ msgid "FLOOR(5; 2) equals 4"
#~ msgstr "FLOOR(5; 2) dá 4"

