msgstr "A función SMALL() devolve o k-ésimo menor valor do conxunto de datos."

#: functions/statistical.xml:1153 xml_doc.cpp:4221
#, kde-format
msgid "SMALL(range; k)"
msgstr "SMALL(rango; k)"

#: functions/statistical.xml:1154 xml_doc.cpp:4223
#, kde-format
