msgstr "Matriz"

#: functions/math.xml:1254 xml_doc.cpp:3278
#, kde-format
msgid "Calculates the inverse of the matrix."
msgstr "Calcula a inversa da matriz."

#: functions/math.xml:1255 xml_doc.cpp:3280
#, kde-format
