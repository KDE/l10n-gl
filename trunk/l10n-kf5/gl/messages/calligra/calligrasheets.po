msgstr "A1: 3, A2: 1, A3: 5 => SMALL(A1:A3; 1) devolve 1"

#: functions/statistical.xml:1162 xml_doc.cpp:4225
#, kde-format
msgid "Number to be normalized"
msgstr "Número a normalizar"

#: functions/statistical.xml:1166 xml_doc.cpp:4227
