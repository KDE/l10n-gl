msgstr "Perfil da cámara:"

#: plugins/formats/raw/3rdparty/libkdcraw/src/dcrawsettingswidget.cpp:680
msgctxt "@item:inlistbox Camera Profile"
msgid "None"
msgstr "Ningún"

#: plugins/formats/raw/3rdparty/libkdcraw/src/dcrawsettingswidget.cpp:681
