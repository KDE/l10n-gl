#. (itstool) path: component/name
#: org.kde.CrowTranslate.metainfo.xml:4
msgid "Crow Translate"
msgstr "Crow Translate"

#. (itstool) path: component/summary
#: org.kde.CrowTranslate.metainfo.xml:8
msgid "Application that allows you to translate and speak text using Mozhi"
msgstr ""
"Unha aplicación que lle permite traducir e pronunciar texto usando Mozhi."

#. (itstool) path: description/p
#: org.kde.CrowTranslate.metainfo.xml:12
msgid "Application written in C++ / Qt that allows you to translate and speak text using Mozhi."
msgstr ""
"Unha aplicación escrita con C++ e Qt que lle permite traducir e pronunciar "
"texto usando Mozhi."

#. (itstool) path: description/p
#: org.kde.CrowTranslate.metainfo.xml:13
msgid "Features:"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#: org.kde.CrowTranslate.metainfo.xml:15
msgid "Multiple translation engines provided by Mozhi (some instances can disable specific engines)*"
msgstr ""
"Varios motores de tradución fornecidos por Mozhi (algunhas instancias poden "
"desactivar motores concretos)*."

#. (itstool) path: ul/li
#: org.kde.CrowTranslate.metainfo.xml:16
msgid "Translate and speak text from screen or selection"
msgstr "Traducir e pronunciar texto da pantalla ou da selección."

#. (itstool) path: ul/li
#: org.kde.CrowTranslate.metainfo.xml:17
msgid "Highly customizable shortcuts"
msgstr "Atallos moi personalizábeis."

#. (itstool) path: ul/li
#: org.kde.CrowTranslate.metainfo.xml:18
msgid "Command-line interface with rich options"
msgstr "Interface de liña de ordes con moitas opcións."

#. (itstool) path: ul/li
#: org.kde.CrowTranslate.metainfo.xml:19
msgid "D-Bus API"
msgstr "API de D-Bus."

#. (itstool) path: ul/li
#: org.kde.CrowTranslate.metainfo.xml:20
msgid "Available for Linux and Windows"
msgstr "Dispoñíbel para Linux e Windows."

#. (itstool) path: description/p
#: org.kde.CrowTranslate.metainfo.xml:22
msgid "*While Mozhi acts as a proxy to protect your privacy, the third-party services it uses may store and analyze the text you send."
msgstr ""
"*Aínda que Mozhi actúa como mandatario para protexer a súa privacidade, os "
"servizos de terceiras partes que usa poden almacenar e analizar o texto que "
"envía."

