#: data/org.kde.CrowTranslate.desktop.in:3
msgctxt "Name"
msgid "Crow Translate"
msgstr "Crow Translate"

#: data/org.kde.CrowTranslate.desktop.in:21
msgctxt "GenericName"
msgid "Translator"
msgstr "Tradutor"

#: data/org.kde.CrowTranslate.desktop.in:41
msgctxt "Comment"
msgid ""
"A simple and lightweight translator that allows to translate and speak the "
"selected text using Mozhi"
msgstr ""
"Un sistema de tradución simple e lixeiro que permite traducir e pronunciar "
"texto seleccionado usando Mozhi."

#: data/org.kde.CrowTranslate.desktop.in:59
msgctxt "Keywords"
msgid "google;yandex;deepl;duckduckgo;libre';mymemory;reverso;text-to-speech;"
msgstr ""
"google;yandex;deepl;duckduckgo;libre';mymemory;reverso;text-to-speech;texto "
"a fala;texto para fala;fala;"

#: data/org.kde.CrowTranslate.desktop.in:89
msgctxt "Name"
msgid "Translate selected text"
msgstr "Traducir o texto seleccionado"

#: data/org.kde.CrowTranslate.desktop.in:111
msgctxt "Name"
msgid "Speak selected text"
msgstr "Pronunciar o texto seleccionado"

#: data/org.kde.CrowTranslate.desktop.in:133
msgctxt "Name"
msgid "Speak translation of selected text"
msgstr "Pronunciar a tradución do texto seleccionado"

#: data/org.kde.CrowTranslate.desktop.in:155
msgctxt "Name"
msgid "Stop text speaking"
msgstr "Deter a pronuncia do texto"

#: data/org.kde.CrowTranslate.desktop.in:177
msgctxt "Name"
msgid "Show main window"
msgstr "Amosar a xanela principal"

#: data/org.kde.CrowTranslate.desktop.in:201
msgctxt "Name"
msgid "Translate selected text and copy to clipboard"
msgstr "Traducir o texto seleccionado e copialo no portapapeis"

#: data/org.kde.CrowTranslate.desktop.in:222
msgctxt "Name"
msgid "Recognize text in screen area"
msgstr "Recoñecer o texto dunha zona da pantalla"

#: data/org.kde.CrowTranslate.desktop.in:244
msgctxt "Name"
msgid "Translate text in screen area"
msgstr "Traducir o texto dunha zona da pantalla"

#: data/org.kde.CrowTranslate.desktop.in:266
msgctxt "Name"
msgid "Toggle the option to negate (invert) the captured image before OCR"
