#: messages.inc:189
msgid "Corrections for precession, nutation and atmospheric refraction"
msgstr "Correccións de precesión, nutación e refracción atmosférica."

#: messages.inc:190
msgid "Tools for retrieval of data from Online Databases"
msgstr "Ferramentas para obter datos de bases de datos en internet."

#: messages.inc:191
