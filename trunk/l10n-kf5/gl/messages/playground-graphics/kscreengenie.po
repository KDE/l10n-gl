#: src/KipiInterface/KSGKipiInfoShared.cpp:39
msgid "Taken with KScreenGenie"
msgstr "Xerada con KScreenGenie"

#: src/KScreenGenie.cpp:189
msgid "Copied image to clipboard"
msgstr "A imaxe copiouse no portapapeis."

#: src/KScreenGenie.cpp:207
msgid "Screenshot capture canceled or failed"
msgstr "A captura de pantalla cancelouse ou fallou."

#: src/KScreenGenie.cpp:217
msgid "Cannot save an empty screenshot image."
msgstr "Non é posíbel gardar unha captura de pantalla baleira."

#: src/KScreenGenie.cpp:254
msgid "Printing failed. The printer failed to initialize."
msgstr "Fallou a impresión. Non foi posíbel preparar a impresora."

#: src/KScreenGenie.cpp:317 src/KScreenGenie.cpp:332
msgid "Cannot send screenshot to the application"
msgstr "Non é posíbel enviar a captura de pantalla ao programa."

#: src/KScreenGenie.cpp:385
msgid "QImageWriter cannot write image: "
msgstr "QImageWriter non pode gardar a imaxe: "

#: src/KScreenGenie.cpp:398
msgid "Cannot save screenshot. Error while writing file."
msgstr ""
"Non é posíbel gardar a captura de pantalla. Produciuse un erro ao gardar o "
"ficheiro."

#: src/KScreenGenie.cpp:410 src/KScreenGenie.cpp:434
msgid "Cannot save screenshot. Error while writing temporary local file."
msgstr ""
"Non é posíbel gardar a captura de pantalla. Produciuse un erro ao gardar o "
"ficheiro temporal local."

#: src/KScreenGenie.cpp:446
msgid "Cannot save screenshot. The save filename is invalid."
msgstr ""
"Non é posíbel gardar a captura de pantalla. O nome do ficheiro no que gardala "
"non é válido."

#: src/KScreenGenie.cpp:451
msgid "Cannot save screenshot. The file already exists."
msgstr "Non é posíbel gardar a captura de pantalla. O ficheiro xa existe."

#: src/KScreenGenieGUI.cpp:53
msgctxt "Untitled Screenshot"
msgid "Untitled"
msgstr "Sen título"

#: src/KScreenGenieGUI.cpp:84
msgid "Send To..."
msgstr "Enviar a…"

#: src/KScreenGenieGUI.cpp:98
msgid "Save && Exit"
msgstr "Gardar e saír"

#: src/KScreenGenieGUI.cpp:99
msgid "Quicksave screenshot in your Pictures directory and exit"
msgstr "Gardar a captura de pantalla no cartafol de imaxes e saír."

#: src/KSGSendToMenu.cpp:70
msgid "Copy To Clipboard"
msgstr "Copiar no portapapeis"

#: src/KSGSendToMenu.cpp:71
msgid "Other Application"
msgstr "Outro programa"

#: src/KSGSendToMenu.cpp:107
