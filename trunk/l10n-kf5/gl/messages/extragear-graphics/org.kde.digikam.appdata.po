#. (itstool) path: component/name
#: org.kde.digikam.appdata.xml:6
msgid "digiKam"
msgstr "digiKam"

#. (itstool) path: description/p
#: org.kde.digikam.appdata.xml:8
msgid ""
"digiKam is an advanced digital photo management application, which makes "
"importing and organizing digital photos a \"snap\". The photos are organized "
"in albums which can be sorted chronologically, by folder layout or by custom "
"collections."
msgstr ""
"digiKam é un aplicativo de administración avanzada de fotografía dixital que "
"facilita a importación e organización de fotografías dixitais. As fotos "
"organízanse en álbums, que poden ordenarse de maneira cronolóxica, por "
"distribución do cartafol ou por coleccións personalizadas."

#. (itstool) path: description/p
#: org.kde.digikam.appdata.xml:13
msgid "Features:"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:15
msgid ""
"Organization of photos in albums and sub-albums (with tags and comments "
"support)"
msgstr ""
"Organización de fotos en álbums e subálbums (pódense usar etiquetas e "
"comentarios)."

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:16
msgid "Support for Exif, Iptc, Xmp, Makernotes"
msgstr "Compatíbel con Exif, Iptc, Xmp e Makernotes."

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:17
msgid "SQLite powered storage for the albums and its metadata"
msgstr "Almacenamento mediante SQLite dos álbums e os seus datos."

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:18
msgid "Support for filtering and sorting albums"
msgstr "Permite filtrar e ordear os álbums."

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:19
msgid "Import from more than 1100 digital camera devices"
msgstr "Permite importar desde máis de 1100 dispositivos de cámara dixital."

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:20
msgid "Support for 300 RAW format pictures"
msgstr "Compatíbel con imaxes en formato 300 RAW."

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:21
msgid "Light Table feature"
msgstr "Funcionalidade de mesa de luces."

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:22
msgid "Plugins architectures: using Kipi-plugins"
msgstr "Arquitectura de complementos, mediante complementos Kipi."

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:23
msgid "Share your photos using HTML or publishing them to social web sites"
msgstr "Permite compartir imaxes usando HTML ou publicándoas en redes sociais."

#. (itstool) path: ul/li
#: org.kde.digikam.appdata.xml:24
msgid "Image editor included with advanced features"
msgstr "Inclúe un editor de imaxes con funcionalidades avanzadas."

#. (itstool) path: component/developer_name
#: org.kde.digikam.appdata.xml:35
msgid "digiKam Project"
msgstr "Proxecto digiKam"
