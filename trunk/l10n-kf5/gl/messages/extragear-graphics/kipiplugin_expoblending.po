#: blendingdlg/enfusesettings.cpp:143
#, fuzzy
#| msgid ""
#| "Force hard blend masks and no averaging on finest scale. This is "
#| "especially useful for focus stacks with thin and high contrast features, "
#| "improves sharpness at the expense of increased noise."
msgctxt "@info:whatsthis"
msgid ""
"Force hard blend masks without averaging on finest scale. This is only "
"useful for focus stacks with thin and high contrast features. It improves "
"sharpness at the expense of increased noise."
msgstr ""
"Forzar máscaras de fusión duras e nivelar na escala máis fina. Isto é "
"especialmente útil para medas de foco con características de contraste alto, "
"mellora a nitidez a costa dun aumento do ruído."

