msgstr "Johannes Wienke"

#: KioExportWindow.cpp:90 KioImportWindow.cpp:88
msgid "Developer and maintainer"
msgstr "Desenvolvedor e mantedor"

#: KioExportWindow.cpp:197
msgid "Upload not completed"
msgstr "Non rematou o envío"

#: KioExportWindow.cpp:198
msgid ""
"Some of the images have not been transferred and are still in the list. You "
"can retry to export these images now."
msgstr ""
"Algunhas das imaxes non se transferiron e están aínda na lista. Pode tentar "
"exportar de novo estas imaxes agora."

#: KioImportWidget.cpp:53
msgid "This is the list of images to import into the current album."
msgstr "Esta é a lista de imaxes que importar para o álbum actual."

#: KioImportWindow.cpp:60
#| msgid "Import from Remote Computer"
msgid "Import from Remote Storage"
msgstr "Importar dun almacenamento remoto"

#: KioImportWindow.cpp:64
msgid "Start import"
msgstr "Iniciar a importación"

#: KioImportWindow.cpp:65
msgid "Start importing the specified images into the currently selected album."
msgstr "Iniciar a importación das imaxes indicadas para o álbum seleccionado."

#: KioImportWindow.cpp:81
#| msgid "Import from remote computer"
msgid "Import from remote storage"
msgstr "Importar dun almacenamento remoto"

#: KioImportWindow.cpp:84
msgid "A Kipi plugin to import images over network using KIO-Slave"
msgstr ""
"Un engadido para Kipi para importar imaxes a través dunha rede empregando "
"KIO-Slave"

#: KioImportWindow.cpp:139
msgid "Import not completed"
msgstr "Non rematou a importación"

#: KioImportWindow.cpp:140
msgid ""
"Some of the images have not been transferred and are still in the list. You "
"can retry to import these images now."
msgstr ""
"Algunhas das imaxes non se transferiron e están aínda na listaxe. Pode "
"tentar importar de novo estas imaxes agora."

