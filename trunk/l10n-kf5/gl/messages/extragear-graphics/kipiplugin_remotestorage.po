#: KioExportWidget.cpp:61
msgid "Target location: "
msgstr "Localización do destino: "

#: KioExportWidget.cpp:63
msgid ""
"Sets the target address to upload the images to. This can be any address as "
"used in Dolphin or Konqueror, e.g. ftp://my.server.org/sub/folder."
msgstr ""
"Configura o enderezo de destino ao que enviar as imaxes. Isto pode ser "
"calquera enderezo, tal e como se utilizan en Dolphin ou Konqueror, p.ex. "
"ftp://meu.servidor.org/sub/cartafol."

#: KioExportWidget.cpp:67
msgid "Select target location..."
msgstr "Seleccionar a localización do destino..."

#: KioExportWidget.cpp:73
msgid "This is the list of images to upload to the specified target."
msgstr "Esta é a listaxe das imaxes que quere enviar ao destino indicado."

#: KioExportWidget.cpp:136
msgid "Select target..."
msgstr "Seleccionar o destino..."

#: KioExportWidget.cpp:137
msgid "All Files (*)"
msgstr "Todos os ficheiros (*)"

#: KioExportWidget.cpp:157
#| msgid "not selected"
msgid "<not selected>"
msgstr "<sen seleccionar>"

#: KioExportWindow.cpp:63
#| msgid "Export to Remote Computer"
msgid "Export to Remote Storage"
msgstr "Exportar a un almacenamento remoto"

#: KioExportWindow.cpp:66
msgid "Start export"
msgstr "Iniciar a exportación"

#: KioExportWindow.cpp:67
msgid "Start export to the specified target"
msgstr "iniciar a exportación ao destino indicado"

#: KioExportWindow.cpp:83
#| msgid "Export to remote computer"
msgid "Export to remote storage"
msgstr "Exportar a un almacenamento remoto"

#: KioExportWindow.cpp:86
msgid "A Kipi plugin to export images over network using KIO-Slave"
msgstr ""
"Un engadido para Kipi para exportar imaxes a través dunha rede empregando "
"KIO-Slave"

#: KioExportWindow.cpp:87 KioImportWindow.cpp:85
