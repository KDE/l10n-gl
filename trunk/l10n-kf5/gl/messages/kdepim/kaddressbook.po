msgstr "Campos para exportar"

#: xxport/vcard/vcardexportselectionwidget.cpp:40
msgctxt "@option:check"
msgid "Private fields"
msgstr "Campos privados"

#: xxport/vcard/vcardexportselectionwidget.cpp:42
msgctxt "@info:tooltip"
msgid "Export private fields"
msgstr "Exportar campos privados"

#: xxport/vcard/vcardexportselectionwidget.cpp:45
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's private fields to the "
"vCard output file."
msgstr ""
"Escolla esta opción se desexa exportar os campos privados do contacto no "
"ficheiro de saída a vCard."

#: xxport/vcard/vcardexportselectionwidget.cpp:49
msgctxt "@option:check"
msgid "Business fields"
msgstr "Campos de negocios"

#: xxport/vcard/vcardexportselectionwidget.cpp:51
msgctxt "@info:tooltip"
msgid "Export business fields"
msgstr "Exportar os campos de negocios"

#: xxport/vcard/vcardexportselectionwidget.cpp:54
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's business fields to the "
"vCard output file."
msgstr ""
"Escolla esta opción se desexa exportar os campos de negocios do contacto no "
"ficheiro de saída a vCard."

#: xxport/vcard/vcardexportselectionwidget.cpp:58
msgctxt "@option:check"
msgid "Other fields"
msgstr "Outros campos"

#: xxport/vcard/vcardexportselectionwidget.cpp:60
msgctxt "@info:tooltip"
msgid "Export other fields"
msgstr "Exportar os outros campos"

#: xxport/vcard/vcardexportselectionwidget.cpp:63
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's other fields to the vCard "
"output file."
msgstr ""
"Escolla esta opción se desexa exportar os outros campos do contacto no "
"ficheiro de saída a vCard."

#: xxport/vcard/vcardexportselectionwidget.cpp:67
msgctxt "@option:check"
msgid "Encryption keys"
msgstr "Chaves de cifrado"

#: xxport/vcard/vcardexportselectionwidget.cpp:69
msgctxt "@info:tooltip"
msgid "Export encryption keys"
msgstr "Exportar as chaves de cifrado"

#: xxport/vcard/vcardexportselectionwidget.cpp:72
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's encryption keys to the "
"vCard output file."
msgstr ""
"Escolla esta opción se desexa exportar as claves de cifrado do contacto no "
"ficheiro de saída a vCard."

#: xxport/vcard/vcardexportselectionwidget.cpp:76
msgctxt "@option:check"
msgid "Pictures"
msgstr "Imaxes"

#: xxport/vcard/vcardexportselectionwidget.cpp:78
msgctxt "@info:tooltip"
msgid "Export pictures"
msgstr "Exportar as imaxes"

#: xxport/vcard/vcardexportselectionwidget.cpp:81
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's picture to the vCard "
"output file."
msgstr ""
"Escolla esta opción se desexa exportar a imaxe do contacto no ficheiro de "
"saída a vCard."

#: xxport/vcard/vcardexportselectionwidget.cpp:86
msgctxt "@title:group"
msgid "Export options"
msgstr "Opcións da exportación"

#: xxport/vcard/vcardexportselectionwidget.cpp:92
msgctxt "@option:check"
msgid "Display name as full name"
msgstr "Alcume como nome completo"

#: xxport/vcard/vcardexportselectionwidget.cpp:94
msgctxt "@info:tooltip"
msgid "Export display name as full name"
msgstr "Exportar o alcume como nome completo"

#: xxport/vcard/vcardexportselectionwidget.cpp:97
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's display name in the "
"vCard's full name field.  This may be required to get the name shown "
"correctly in GMail or Android."
msgstr ""
"Escolla esta opción se desexa exportar o alcume do contacto no campo de nome "
"completo da vCard. Pode que isto sexa necesario para que o nome apareza "
"correctamente en GMail ou Android."

#: xxport/vcard/vcardviewerdialog.cpp:33
msgctxt "@title:window"
msgid "Import vCard"
msgstr "Importar vCard"

#: xxport/vcard/vcardviewerdialog.cpp:57
msgctxt "@info"
msgid "Do you want to import this contact into your address book?"
msgstr "Quere importar este contacto ao caderno de enderezos?"

#: xxport/vcard/vcardviewerdialog.cpp:67
msgctxt "@action:button"
msgid "Import All..."
msgstr "Importalo todo..."

#: xxport/xxportmanager.cpp:124
msgid "Select Address Book"
msgstr "Escolla o caderno de enderezos"

#: xxport/xxportmanager.cpp:126
msgid "Select the address book the imported contact(s) shall be saved in:"
msgstr ""
"Seleccione o caderno de enderezos no que quere gardar o(s) contacto(s) "
"importado(s):"

#: xxport/xxportmanager.cpp:139
msgid "Import Contacts"
msgstr "Importar contactos"

