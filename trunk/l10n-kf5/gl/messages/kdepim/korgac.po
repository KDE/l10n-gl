msgid "Suspend All Reminders"
msgstr "Suspender todas as lembranzas"

#: alarmdockwindow.cpp:79
msgctxt "@action:inmenu"
msgid "Dismiss All Reminders"
msgstr "Descartar todas as lembranzas"

#: alarmdockwindow.cpp:86
