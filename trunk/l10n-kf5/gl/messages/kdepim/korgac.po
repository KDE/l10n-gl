msgid "Close KOrganizer Reminder Daemon"
msgstr "Fechar o daemon de lembranzas do KOrganizer"

#: alarmdockwindow.cpp:192
msgctxt "@action:button start the reminder daemon"
msgid "Start"
msgstr "Iniciar"

#: alarmdockwindow.cpp:193
