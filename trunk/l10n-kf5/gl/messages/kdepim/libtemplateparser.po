#. i18n: ectx: property (text), widget (QLabel, textLabel1)
#: ui/templatesconfiguration_base.ui:258
msgctxt "@label:textbox Prefix for quoted message lines"
msgid "&Quote indicator:"
msgstr "&Indicador de cita:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, lineEdit_quote)
#: ui/templatesconfiguration_base.ui:271
msgctxt "@info:tooltip"
msgid "Set the Prefix for quoted message lines"
msgstr "Indicar o prefixo das liñas de mensaxe citadas"

#. i18n: ectx: property (whatsThis), widget (QLineEdit, lineEdit_quote)
#: ui/templatesconfiguration_base.ui:281
#, no-c-format
msgctxt "@info:whatsthis"
msgid ""
"\n"
"             <qt>The following placeholders are supported in the quote "
"indicator:\n"
"             <ul>\n"
"             <li>%f: sender's initials</li>\n"
"             <li>%%: percent sign</li>\n"
"             <li>%_: space</li>\n"
"             </ul></qt>\n"
"           "
msgstr ""
"\n"
"             <qt>Permítense os substitutos seguintes no indicador de citas:\n"
"             <ul>\n"
"             <li>%f: iniciais do remitente</li>\n"
"             <li>%%: símbolo de porcentaxe</li>\n"
"             <li>%_: espazo</li>\n"
"             </ul></qt>\n"
"           "

