msgid "Mounts Samba shares"
msgstr "Monta comparticións de Samba"

#: src/onstart/sambamounter.desktop:49
msgctxt "Comment"
msgid "Mounts Samba shares at startup time"
msgstr "Monta comparticións de Samba ao iniciar o sistema."

