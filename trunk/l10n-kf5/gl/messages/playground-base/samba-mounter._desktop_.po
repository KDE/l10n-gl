#: src/helper/samba-mounter.actions:2
msgctxt "Name"
msgid "Mount a cifs file system"
msgstr "Montar un sistema de ficheiros CIFS"

#: src/helper/samba-mounter.actions:26
msgctxt "Description"
msgid "Executes mount with the needed arguments to mount samba shares"
msgstr ""
"Executa «mount» cos argumentos necesarios para montar comparticións de Samba."

#: src/helper/samba-mounter.actions:52
msgctxt "Name"
msgid "Umount a cifs file system"
msgstr "Desmontar un sistema de ficheiros CIFS"

#: src/helper/samba-mounter.actions:74
msgctxt "Description"
msgid "Executes umount with the needed arguments to umount a samba share"
msgstr ""
"Executa «umount» cos argumentos necesarios para desmontar unha compartición "
"de Samba."

#: src/onstart/sambamounter.desktop:2
msgctxt "Name"
msgid "Samba Mounter"
msgstr "Montador de Samba"

#: src/onstart/sambamounter.desktop:25
msgctxt "GenericName"
msgid "Mounts Samba shares"
msgstr "Monta comparticións de Samba"

#: src/onstart/sambamounter.desktop:57
msgctxt "Comment"
msgid "Mounts Samba shares at startup time"
msgstr "Monta comparticións de Samba ao iniciar o sistema."

#: src/sambamount.desktop:13
msgctxt "Name"
msgid "Network Drivers"
msgstr "Controladores de rede"

#: src/sambamount.desktop:38
msgctxt "Comment"
msgid "Configure mounts managed by Plasma instead of fstab"
msgstr "Configurar montaxes xestionadas por Plasma en vez de fstab."

#: src/sambamount.desktop:61
msgctxt "X-KDE-Keywords"
msgid "Samba,Mount,Fstab"
msgstr "Samba,Mount,Montar,Fstab"

