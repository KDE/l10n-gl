#: korganizer/plugins/datenums/datenums.desktop:3
msgctxt "Name"
msgid "Date Numbers Plugin for Calendars"
msgstr "Engadido para os números dos días para os calendarios"

#: korganizer/plugins/datenums/datenums.desktop:63
msgctxt "Comment"
msgid ""
"For each day this plugin shows its daynumber of the year at the top of the "
"agenda view. For example, February 1 is day 32 of the year."
msgstr ""
"Este engadido mostra o día do ano na vista superior da axenda. Por exemplo, o "
"1 de febreiro é o día 32 do ano."

#: korganizer/plugins/hebrew/hebrew.desktop:3
msgctxt "Name"
msgid "Jewish Calendar Plugin"
msgstr "Engadido para o calendario xudeu"

#: korganizer/plugins/hebrew/hebrew.desktop:65
msgctxt "Comment"
msgid "Shows all dates in KOrganizer also in the Jewish calendar system."
msgstr ""
"Mostra todas as datas en KOrganizer tamén no sistema de calendario xudeu."

#: korganizer/plugins/picoftheday/picoftheday.desktop:3
