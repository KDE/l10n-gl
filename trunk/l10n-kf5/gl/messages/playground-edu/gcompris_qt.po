msgid ""
"Create a line of 4 tokens either horizontally (lying down), vertically "
"(standing up) or diagonally."
msgstr ""
"Crea unha liña de 4 pezas, de forma horizontal (deitada), vertical (de pé) "
"ou en diagonal."

#: activities/align4-2players/ActivityInfo.qml:13
#, fuzzy
#| msgctxt "ActivityInfo|"
