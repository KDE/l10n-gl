#. (itstool) path: description/p
#: Kjots.appdata.xml:7
msgid "KJots organises all of your notes into separate books"
msgstr "KJots organiza todas as súas notas en cadernos separados."

#. (itstool) path: description/p
#: Kjots.appdata.xml:10
msgid "Features:"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#: Kjots.appdata.xml:12
msgid "Multiple books handled"
msgstr "Xestiona varios cadernos."

#. (itstool) path: ul/li
#: Kjots.appdata.xml:13
msgid "Each book has many named pages"
msgstr "Cada caderno ten varias páxinas con nome de seu."

#. (itstool) path: ul/li
#: Kjots.appdata.xml:14
msgid "Books and pages can be rearranged by drag-and-drop"
msgstr "Pode arrastrar e soltar para organizar os cadernos e páxinas."

#. (itstool) path: ul/li
#: Kjots.appdata.xml:15
msgid "Keyboard shortcuts are available for many functions"
msgstr "Moitas funcionalidades contan con atallos de teclado."

#. (itstool) path: ul/li
#: Kjots.appdata.xml:16
msgid "Automatic saving means your notes are safe from loss"
msgstr "Os datos gárdanse automaticamente para evitar a perda de datos."

