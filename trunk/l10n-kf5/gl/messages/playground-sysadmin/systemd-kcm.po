#: src/kcmsystemd.cpp:94
msgid "Unable to find directory with systemd configuration files."
msgstr ""
"Non é posíbel atopar o cartafol cos ficheiros de configuración de systemd."

#: src/kcmsystemd.cpp:238
msgid "All"
msgstr "Todo"

#: src/kcmsystemd.cpp:238
msgid "Targets"
msgstr "Obxectivos"

#: src/kcmsystemd.cpp:238
msgid "Services"
msgstr "Servizos"

#: src/kcmsystemd.cpp:239
