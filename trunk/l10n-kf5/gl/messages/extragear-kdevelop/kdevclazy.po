#: checksdb.cpp:42
#, kde-format
msgid "Level 0"
msgstr "Nivel 0"

#: checksdb.cpp:43
#, kde-format
msgid "Level 1"
msgstr "Nivel 1"

#: checksdb.cpp:44
#, kde-format
msgid "Level 2"
msgstr "Nivel 2"

#: checksdb.cpp:45
