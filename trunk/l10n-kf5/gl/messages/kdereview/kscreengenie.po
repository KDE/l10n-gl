#: src/KipiInterface/KSGKipiInfoShared.cpp:39
msgid "Taken with KScreenGenie"
msgstr "Xerada con KScreenGenie"

#: src/KSCore.cpp:202
msgid "Copied image to clipboard"
msgstr "A imaxe copiouse no portapapeis."

#: src/KSCore.cpp:215
msgid "Screenshot capture canceled or failed"
msgstr "A captura de pantalla cancelouse ou fallou."

#: src/KSCore.cpp:225
msgid "Cannot save an empty screenshot image."
msgstr "Non é posíbel gardar unha captura de pantalla baleira."

#: src/KSCore.cpp:246
#, kde-format
msgid "A new screenshot was captured and saved to %1"
msgstr "Fíxose unha nova captura de pantalla e gardouse en %1."

#: src/KSCore.cpp:282
msgid "Printing failed. The printer failed to initialize."
msgstr "Fallou a impresión. Non foi posíbel preparar a impresora."

#: src/KSCore.cpp:345 src/KSCore.cpp:360
msgid "Cannot send screenshot to the application"
msgstr "Non é posíbel enviar a captura de pantalla ao programa."

#: src/KSCore.cpp:413
msgid "QImageWriter cannot write image: "
msgstr "QImageWriter non pode gardar a imaxe: "

#: src/KSCore.cpp:426
msgid "Cannot save screenshot. Error while writing file."
msgstr ""
"Non é posíbel gardar a captura de pantalla. Produciuse un erro ao gardar o "
"ficheiro."

#: src/KSCore.cpp:438 src/KSCore.cpp:476
msgid "Cannot save screenshot. Error while writing temporary local file."
msgstr ""
"Non é posíbel gardar a captura de pantalla. Produciuse un erro ao gardar o "
"ficheiro temporal local."

#: src/KSCore.cpp:488
msgid "Cannot save screenshot. The save filename is invalid."
msgstr ""
"Non é posíbel gardar a captura de pantalla. O nome do ficheiro no que "
"gardala non é válido."

#: src/KSCore.cpp:493
msgid "Cannot save screenshot. The file already exists."
msgstr "Non é posíbel gardar a captura de pantalla. O ficheiro xa existe."

#: src/Main.cpp:31
msgid "KScreenGenie"
msgstr "KScreenGenie"

#: src/Main.cpp:33
msgid "KDE Screenshot Utility"
msgstr "Utilidade de KDE para facer capturas de pantalla"

#: src/Main.cpp:35
msgid "(C) 2015 Boudhayan Gupta"
msgstr "© 2015 Boudhayan Gupta"

#: src/Main.cpp:47
msgid "Capture the entire desktop (default)"
msgstr "Capturar o escritorio completo (predeterminado)."

#: src/Main.cpp:48
msgid "Capture the current monitor"
msgstr "Capturar o monitor actual."

#: src/Main.cpp:49
msgid "Capture the active window"
msgstr "Capturar a xanela activa."

#: src/Main.cpp:50
msgid "Capture a rectangular region of the screen"
msgstr "Capturar unha rexión rectangular da pantalla."

#: src/Main.cpp:51
msgid "Take a screenshot and exit without showing the GUI"
msgstr "Facer unha captura de pantalla e saír sen mostrar a interface gráfica."

#: src/Main.cpp:52
msgid "In background mode, pop up a notification when the screenshot is taken"
msgstr ""
"No modo en segundo plano, mostrar unha notificación tras facer unha captura "
"de pantalla."

#: src/Main.cpp:53
msgid "In background mode, send image to clipboard without saving to file"
msgstr ""
"No modo en segundo plano, enviar a imaxe ao portapapeis sen gardar o "
"ficheiro."

#: src/Main.cpp:54
msgid "In background mode, save image to specified file"
msgstr "No modo en segundo plano, gardar a imaxe na ruta indicada."

#: src/Main.cpp:55
msgid "In background mode, delay before taking the shot (in milliseconds)"
msgstr ""
"No modo en segundo plano, demora antes de facer a captura de pantalla (en "
"milisegundos)."

#: src/Main.cpp:56
msgid "Wait for a click before taking screenshot. Invalidates delay"
msgstr ""
"Agardar por un clic antes de facer a captura de pantalla. Se definiu un "
"atraso, usar esta opción provocará que se ignore o atraso."

#: src/ScreenClipper.cpp:106
msgid ""
"Click anywhere on the screen (including on this text) to start drawing a "
"selection rectangle, or press Esc to quit"
msgstr ""
"Prema en calquera lugar da pantalla (por exemplo, neste texto) para comezar "
"a debuxar un rectángulo. Tamén pode premer Esc para saír."

#: src/ScreenClipper.cpp:148
msgid ""
"To take the screenshot, double-click or press Enter. Right-click to reset "
"the selection, or press Esc to quit."
msgstr ""
"Para facer a captura de pantalla, preme dúas veces seguidas ou preme Intro. "
"Preme co botón secundario para restabelecer a selección, ou preme Esc para "
"saír."

