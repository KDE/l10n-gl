#: XbaseExport.cpp:260
msgctxt "xBaseExport|"
msgid "Data not set for migration"
msgstr "Os datos non están definidos para a migración"

#: XbaseExport.cpp:267
msgctxt "xBaseExport|"
msgid "Could not export back to destination database"
msgstr "Non foi posíbel exportar de volta á base de datos de destino"

#: XbaseExport.cpp:275
#, qt-format
msgctxt "xBaseExport|"
msgid "Could not connect to data source \"%1\"."
msgstr "Non foi posíbel conectarse á fonte de datos «%1»."

#: XbaseExport.cpp:303
#, qt-format
msgctxt "xBaseExport|"
msgid "No tables to export found in data source \"%1\"."
msgstr "Non se atoparon táboas que exportar na fonte de datos «%1»."

#: XbaseExport.cpp:320
#, qt-format
msgctxt "xBaseExport|"
msgid ""
"Could not create table in destination \"%1\". Error reading table \"%2\"."
msgstr ""
"Non se puido crear a táboa no destino «%1». Produciuse un erro ao ler a "
"táboa «%2»."

#: XbaseExport.cpp:329
#, qt-format
msgctxt "xBaseExport|"
msgid "Could not copy table \"%1\" to destination database."
msgstr "Non foi posíbel copiar a táboa «%1» na base de datos de destino."

#: XbaseExport.cpp:345
#, qt-format
msgctxt "xBaseExport|"
msgid "Could not export data to \"%1\"."
msgstr "Non foi posíbel exportar os datos a «%1»."

