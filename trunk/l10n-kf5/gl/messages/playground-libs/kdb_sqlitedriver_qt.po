#: SqliteAdmin.cpp:43
#, qt-format
msgctxt "SqliteVacuum|"
msgid "Could not compact database \"%1\"."
msgstr "Non foi posíbel compactar a base de datos «%1»."

#: SqliteConnection.cpp:114
msgctxt "SqliteConnection|"
msgid "Extra SQLite extension paths"
msgstr "Rutas adicionais de extensións de SQLite."

#: SqliteConnection.cpp:338
#, qt-format
msgctxt "SqliteConnection|"
msgid ""
"Could not remove file \"%1\". Check the file's permissions and whether it is "
"already opened and locked by another application."
msgstr ""
"Non foi posíbel eliminar o ficheiro «%1». Comprobe os permisos do ficheiro e "
"asegúrese de que non está aberto e "
"bloqueado por outro programa."

#: SqliteConnection.cpp:415 SqliteConnection.cpp:440
#, qt-format
msgctxt "SqliteConnection|"
msgid "Could not load SQLite extension \"%1\"."
msgstr "Non foi posíbel cargar a extensión de SQLite «%1»."

#: SqliteConnection.cpp:426
#, qt-format
msgctxt "SqliteConnection|"
msgid "Could not find SQLite extension file \"%1\"."
msgstr "Non foi posíbel atopar o ficheiro de extensión de SQLite «%1»."

#: SqliteVacuum.cpp:135
msgctxt "SqliteVacuum|"
msgid "Compacting database"
msgstr "Compactando a base de datos…"

#: SqliteVacuum.cpp:137
#, qt-format
msgctxt "SqliteVacuum|"
msgid "Compacting database \"%1\"..."
msgstr "Compactar a base de datos «%1»…"

#: SqliteVacuum.cpp:218
#, qt-format
msgctxt "SqliteVacuum|"
msgid ""
"The database has been compacted. Current size decreased by %1% to %2 MB."
msgstr ""
"Compactouse a base de datos. O tamaño actual diminuíu de %1% MB a %2 MB."

