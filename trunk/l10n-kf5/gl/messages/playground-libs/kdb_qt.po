#: expression/KDbFunctionExpression.cpp:154
msgctxt "KDbExpression|"
msgid "Incorrect number of arguments"
msgstr "O número de argumentos é incorrecto"

#: expression/KDbFunctionExpression.cpp:155
#, qt-format
msgctxt "KDbExpression|"
msgid "%1() function requires 2 or 3 arguments."
msgstr "A función %1() require 2 ou 3 argumentos."

#: expression/KDbFunctionExpression.cpp:160
#: expression/KDbFunctionExpression.cpp:170
#: expression/KDbFunctionExpression.cpp:181
msgctxt "KDbExpression|"
msgid "Incorrect type of argument"
msgstr "O tipo do argumento é incorrecto"

#: expression/KDbFunctionExpression.cpp:161
#, qt-format
msgctxt "KDbExpression|"
msgid ""
"%1() function's first argument should be of type \"%2\". Specified argument "
"is of type \"%3\"."
msgstr ""
"O primeiro argumento da función %1() debería ser de tipo «%2». O argumento "
"fornecido é de tipo «%3»."

#: expression/KDbFunctionExpression.cpp:171
#, qt-format
msgctxt "KDbExpression|"
msgid ""
"%1() function's second argument should be of type \"%2\". Specified argument "
"is of type \"%3\"."
msgstr ""
"O segundo argumento da función %1() debería ser de tipo «%2». O argumento "
"fornecido é de tipo «%3»."

#: expression/KDbFunctionExpression.cpp:182
#, qt-format
msgctxt "KDbExpression|"
msgid ""
"%1() function's third argument should be of type \"%2\". Specified argument "
"is of type \"%3\"."
msgstr ""
"O primeiro terceiro da función %1() debería ser de tipo «%2». O argumento "
"fornecido é de tipo «%3»."

#: expression/KDbNArgExpression.cpp:69
msgctxt "KDbExpression|"
msgid "Three arguments required"
msgstr "Requírense tres argumentos"

#: expression/KDbNArgExpression.cpp:71
#, qt-format
msgctxt "KDbExpression|BETWEEN..AND error"
msgid "%1 operator requires exactly three arguments."
msgstr "O operador %1 require tres argumentos."

#: expression/KDbNArgExpression.cpp:94
msgctxt "KDbExpression|"
msgid "Incompatible types of arguments"
msgstr "Os tipos dos argumentos son incompatíbeis"

#: expression/KDbNArgExpression.cpp:96
#, qt-format
msgctxt "KDbExpression|BETWEEN..AND type error"
msgid "%1 operator requires compatible types of arguments."
msgstr "O operador %1 require tipos de argumento compatíbeis."

#: expression/KDbVariableExpression.cpp:133
msgctxt "KDbExpression|"
msgid "Ambiguous field name"
msgstr "Nome do campo ambiguo"

#: expression/KDbVariableExpression.cpp:135
#, qt-format
msgctxt "KDbExpression|"
msgid ""
"Both table \"%1\" and \"%2\" have defined \"%3\" field. Use \"<tableName>."
"%4\" notation to specify table name."
msgstr ""
"Ambas as táboas «%1» e «%2» teñen o campo «%3». Utilice a notación "
"«<tableName>.%4»para indicar o nome da táboa."

#: expression/KDbVariableExpression.cpp:144
#: expression/KDbVariableExpression.cpp:221
msgctxt "KDbExpression|"
msgid "Field not found"
msgstr "Non se atopa o campo"

#: expression/KDbVariableExpression.cpp:146
#, qt-format
msgctxt "KDbExpression|"
msgid "Table containing \"%1\" field not found."
msgstr "A táboa que contén o campo «%1» non se encontrou."

#: expression/KDbVariableExpression.cpp:171
msgctxt "KDbExpression|"
msgid "Could not access the table directly using its name"
msgstr "Non foi posíbel acceder directamente á táboa utilizando o seu nome"

#: expression/KDbVariableExpression.cpp:173
#, qt-format
msgctxt "KDbExpression|"
msgid ""
"Table name \"%1\" is covered by aliases. Instead of \"%2\", you can write "
"\"%3\"."
msgstr ""
"O nome de táboa «%1» está cuberto por alcumes. En vez de «%2» podes escribir "
"«%3»."

#: expression/KDbVariableExpression.cpp:195
msgctxt "KDbExpression|"
msgid "Table not found"
msgstr "Táboa non atopada"

#: expression/KDbVariableExpression.cpp:196
#, qt-format
msgctxt "KDbExpression|"
msgid "Unknown table \"%1\"."
msgstr "Táboa descoñecida «%1»."

#: expression/KDbVariableExpression.cpp:210
#, qt-format
msgctxt "KDbExpression|"
msgid "Ambiguous \"%1.*\" expression"
msgstr "A expresión «%1.*» é ambigua"

#: expression/KDbVariableExpression.cpp:211
#, qt-format
msgctxt "KDbExpression|"
msgid "More than one \"%1\" table or alias defined."
msgstr "Definíronse máis dunha táboa «%1» ou alcume."

#: expression/KDbVariableExpression.cpp:223
#, qt-format
msgctxt "KDbExpression|"
msgid "Table \"%1\" has no \"%2\" field."
msgstr "A táboa «%1» non ten un campo «%2»."

#: expression/KDbVariableExpression.cpp:230
#, qt-format
msgctxt "KDbExpression|"
msgid "Ambiguous \"%1.%2\" expression"
msgstr "A expresión «%1.%2» é ambigua"

#: expression/KDbVariableExpression.cpp:232
#, qt-format
msgctxt "KDbExpression|"
msgid "More than one \"%1\" table or alias defined containing \"%2\" field."
msgstr "Máis dunha táboa «%1» ou alcume definidos conteñen o campo «%2»."

#: KDb.cpp:157 KDb.cpp:213 KDb.cpp:222
msgctxt "ConnectionTestDialog|"
msgid "Test Connection"
msgstr "Probar a conexión"

#: KDb.cpp:158
#, qt-format
msgctxt "ConnectionTestDialog|"
msgid "Testing connection to \"%1\" database server..."
msgstr "Comprobando a conexión ao servidor de bases de datos «%1»…"

#: KDb.cpp:210
#, qt-format
msgctxt "ConnectionTestDialog|"
msgid ""
"Test connection to \"%1\" database server failed. The server is not "
"responding."
msgstr ""
"A conexión de proba ao servidor de bases de datos «%1» fallou. O servidor "
"non está a responder."

#: KDb.cpp:219
#, qt-format
msgctxt "ConnectionTestDialog|"
msgid "Test connection to \"%1\" database server established successfully."
msgstr ""
"A conexión de proba ao servidor de bases de datos %1 estabeleceuse "
"correctamente."

#: KDb.cpp:405
msgctxt "KDb|"
msgid "Message from server:"
msgstr "Mensaxe do servidor:"

#: KDb.cpp:408
msgctxt "KDb|"
msgid "SQL statement:"
msgstr "Instrución de SQL:"

#: KDb.cpp:423
msgctxt "KDb|"
msgid "Server result code:"
msgstr "Código de resultado do servidor:"

#: KDb.cpp:431
msgctxt "KDb|"
msgid "Server result:"
msgstr "Resultado no servidor:"

#: KDb.cpp:1545
msgctxt "KDbField|"
msgid "Number"
msgstr "Número"

#: KDb.cpp:1548
msgctxt "KDbField|"
msgid "Image"
msgstr "Imaxe"

#: KDb.cpp:1765
#, qt-format
msgctxt "KDb|"
msgid "Value of \"%1\" column must be an identifier."
msgstr "O valor da columna «%1» debe ser un identificador."

#: KDb.cpp:1768
#, qt-format
msgctxt "KDb|"
msgid "\"%1\" is not a valid identifier."
msgstr "«%1» non é un identificador válido."

#: KDbConnection.cpp:64
msgctxt "KDbConnection|Read only connection"
msgid "Read only"
msgstr "Só lectura"

#: KDbConnection.cpp:139
#, qt-format
msgctxt "KDbConnection|"
msgid "Invalid database contents. %1"
msgstr "Contidos da base de datos non válidos. %1"

#: KDbConnection.cpp:143
msgctxt "KDbConnection|"
msgid "It is a system object."
msgstr "É un obxecto do sistema."

#: KDbConnection.cpp:363
msgctxt "KDbConnection|"
msgid "Connection already established."
msgstr "A conexión xa foi estabelecida."

#: KDbConnection.cpp:368
msgctxt "KDbConnection|"
msgid "Database name required to create connection."
msgstr "Necesítase o nome dunha base de datos para crear a conexión."

#: KDbConnection.cpp:378
#, qt-format
msgctxt "KDbConnection|"
msgid "Could not open \"%1\" project file."
msgstr "Non foi posíbel abrir o proxecto «%1»."

#: KDbConnection.cpp:380
#, qt-format
msgctxt "KDbConnection|"
msgid "Could not connect to \"%1\" database server."
msgstr "Non foi posíbel conectar co servidor de base de datos «%1»."

#: KDbConnection.cpp:427
msgctxt "KDbConnection|"
msgid "Not connected to the database server."
msgstr "Non está conectado ao servidor de bases de datos."

#: KDbConnection.cpp:438
msgctxt "KDbConnection|"
msgid "Currently no database is used."
msgstr "Non está a ser utilizada ningunha base de datos."

#: KDbConnection.cpp:495
#, qt-format
msgctxt "KDbConnection|"
msgid "The database \"%1\" does not exist."
msgstr "A base de datos «%1» non existe."

#: KDbConnection.cpp:515
#, qt-format
msgctxt "KDbConnection|"
msgid "The database file \"%1\" does not exist."
msgstr "O ficheiro de base de datos «%1» non existe."

#: KDbConnection.cpp:522
#, qt-format
msgctxt "KDbConnection|"
msgid "Database file \"%1\" is not readable."
msgstr "Non é posíbel ler o ficheiro da base de datos «%1»."

#: KDbConnection.cpp:529
#, qt-format
msgctxt "KDbConnection|"
msgid "Database file \"%1\" is not writable."
msgstr "O ficheiro da base de datos «%1» non permite a escritura."

#: KDbConnection.cpp:558
#, qt-format
msgctxt "KDbConnection|"
msgid "Database \"%1\" created but could not be closed after creation."
msgstr ""
"A base de datos «%1» foi creada pero non se puido pechar tras a súa creación."

#: KDbConnection.cpp:573
#, qt-format
msgctxt "KDbConnection|"
msgid "Database \"%1\" already exists."
msgstr "A base de datos «%1» xa existe."

#: KDbConnection.cpp:578
#, qt-format
msgctxt "KDbConnection|"
msgid ""
"Could not create database \"%1\". This name is reserved for system database."
msgstr ""
"Non foi posíbel crear a base de datos «%1». Este nome está reservado para "
"unha base de datos do sistema."

#: KDbConnection.cpp:600
#, qt-format
msgctxt "KDbConnection|"
msgid "Error creating database \"%1\" on the server."
msgstr "Erro ao crear a base de datos «%1» no servidor."

#: KDbConnection.cpp:614
#, qt-format
msgctxt "KDbConnection|"
msgid "Database \"%1\" created but could not be opened."
msgstr "A base de datos «%1» foi creada pero non foi posíbel acceder a ela."

#: KDbConnection.cpp:691
#, qt-format
msgctxt "KDbConnection|"
msgid "Opening database \"%1\" failed."
msgstr "Fallou o abrir da base de datos «%1»."

#: KDbConnection.cpp:780
msgctxt "KDbConnection|"
msgid "Could not find any database for temporary connection."
msgstr ""
"Non foi posíbel encontrar ningunha base de datos para conexións temporais."

#: KDbConnection.cpp:789
#, qt-format
msgctxt "KDbConnection|"
msgid "Error during starting temporary connection using \"%1\" database name."
msgstr ""
"Erro ao iniciar a conexión temporal utilizando o nome de base de datos «%1»."

#: KDbConnection.cpp:807 KDbConnection.cpp:825
msgctxt "KDbConnection|"
msgid "Could not delete database - name not specified."
msgstr "Non é posíbel borrar a base de datos - nome non indicado."

#: KDbConnection.cpp:831
#, qt-format
msgctxt "KDbConnection|"
msgid "Could not delete system database \"%1\"."
msgstr "Non foi posíbel eliminar a base de datos do sistema «%1»."

#: KDbConnection.cpp:878
msgctxt "KDbConnection|"
msgid "Could not retrieve list of object names."
msgstr "Non foi posíbel obter a lista de nomes de obxectos."

#: KDbConnection.cpp:891
msgctxt "KDbConnection|"
msgid "Could not retrieve list of table names."
msgstr "Non foi posíbel obter a lista de nomes de táboas."

#: KDbConnection.cpp:954
msgctxt "KDbConnection|"
msgid "Could not retrieve list of object identifiers."
msgstr "Non foi posíbel obter a lista de identificadores de obxectos."

#: KDbConnection.cpp:1127
msgctxt "KDbConnection|"
msgid "SQL statement for execution is invalid (empty)."
msgstr "A instrución de SQL para executar é incorrecta (está baleira)."

#: KDbConnection.cpp:1135
msgctxt "KDbConnection|"
msgid "Error while executing SQL statement."
msgstr "Erro ao executar a instrución de SQL."

#: KDbConnection.cpp:1258
msgctxt "KDbConnection|"
msgid "Creating table failed."
msgstr "Fallou a creación da táboa"

#: KDbConnection.cpp:1271
msgctxt "KDbConnection|"
msgid "Could not create table without fields."
msgstr "Non foi posíbel crear unha táboa sen campos."

#: KDbConnection.cpp:1282
#, qt-format
msgctxt "KDbConnection|"
msgid "System name \"%1\" cannot be used as table name."
msgstr "O nome de sistema «%1» non pode ser utilizado como nome de táboa."

#: KDbConnection.cpp:1291
#, qt-format
msgctxt "KDbConnection|"
msgid "System name \"%1\" cannot be used as one of fields in \"%2\" table."
msgstr ""
"Non se pode empregar o nome de sistema «%1» como un dos campos na táboa «%2»."

#: KDbConnection.cpp:1307
#, qt-format
msgctxt "KDbConnection|"
msgid "Could not create the same table \"%1\" twice."
msgstr "Non é posíbel crear a táboa \"%1\" dúas veces."

#: KDbConnection.cpp:1321
#, qt-format
msgctxt "KDbConnection|"
msgid "Table \"%1\" already exists."
msgstr "A táboa «%1» xa existe."

#: KDbConnection.cpp:1384 KDbConnection.cpp:1411 KDbConnection.cpp:1520
#, qt-format
msgctxt "KDbConnection|"
msgid "Table \"%1\" does not exist."
msgstr "A táboa «%1» non existe."

#: KDbConnection.cpp:1437
msgctxt "KDbConnection|"
msgid "Could not remove object's data."
msgstr "Non foi posíbel eliminar os datos do obxecto."

#: KDbConnection.cpp:1460
#, qt-format
msgctxt "KDbConnection|"
msgid "Table \"%1\" cannot be removed.\n"
msgstr "Non se pode eliminar a táboa «%1».\n"

#: KDbConnection.cpp:1466
msgctxt "KDbConnection|"
msgid "Unexpected name or identifier."
msgstr "Nome ou identificador inesperado."

#: KDbConnection.cpp:1535
#, qt-format
msgctxt "KDbConnection|"
msgid "Could not alter table \"%1\" using the same table as destination."
msgstr ""
"Non foi posíbel alterar a táboa «%1» utilizando a mesma táboa como destino."

#: KDbConnection.cpp:1558
#, qt-format
msgctxt "KDbConnection|"
msgid "Unknown table \"%1\"."
msgstr "Táboa descoñecida «%1»."

#: KDbConnection.cpp:1563
#, qt-format
msgctxt "KDbConnection|"
msgid "Invalid table name \"%1\"."
msgstr "Nome de táboa «%1» non válido."

#: KDbConnection.cpp:1570
#, qt-format
msgctxt "KDbConnection|"
msgid "Could not rename table \"%1\" using the same name."
msgstr "Non foi posíbel renomear a táboa «%1» por ser o mesmo nome."

#: KDbConnection.cpp:1581
#, qt-format
msgctxt "KDbConnection|"
msgid "Could not rename table \"%1\" to \"%2\". Table \"%3\" already exists."
msgstr ""
"Non foi posíbel renomear a táboa «%1» para «%2». Xa existe a táboa «%3»."

#: KDbConnection.cpp:1694
#, qt-format
msgctxt "KDbConnection|"
msgid "Query \"%1\" does not exist."
msgstr "A consulta «%1» non existe."

#: KDbConnection.cpp:1772
#, qt-format
msgctxt "KDbConnection|"
msgid "Transactions are not supported for \"%1\" driver."
msgstr "Non se soportan as transaccións para o controlador «%1»."

#: KDbConnection.cpp:1777
msgctxt "KDbConnection|"
msgid "Begin transaction failed."
msgstr "Fallou o inicio da transacción."

#: KDbConnection.cpp:1794
msgctxt "KDbConnection|"
msgid "Transaction already started."
msgstr "Xa comezou a transacción."

#: KDbConnection.cpp:1834 KDbConnection.cpp:1869
msgctxt "KDbConnection|"
msgid "Transaction not started."
msgstr "A transacción aínda non foi iniciada."

#: KDbConnection.cpp:1849
msgctxt "KDbConnection|"
msgid "Error on commit transaction."
msgstr "Erro no manexo da transacción."

#: KDbConnection.cpp:1884
msgctxt "KDbConnection|"
msgid "Error on rollback transaction."
msgstr "Erro ao desfacer a transacción."

#: KDbConnection.cpp:2035 KDbConnection.cpp:2700
#, qt-format
msgctxt "KDbConnection|"
msgid "Invalid object name \"%1\"."
msgstr "Nome de obxecto «%1» non válido."

#: KDbConnection.cpp:2221
#, qt-format
msgctxt "KDbConnection|"
msgid "Column \"%1\" does not exist in the query."
msgstr "A columna «%1» non existe na consulta."

#: KDbConnection.cpp:2568 KDbConnection.cpp:2573 KDbConnection.cpp:2578
msgctxt "KDbConnection|Extended schema for a table: loading error"
msgid "Error while loading extended table schema."
msgstr "Erro ao cargar o esquema de táboa estendida."

#: KDbConnection.cpp:2577
#, qt-format
msgctxt "KDbConnection|"
msgid "Invalid XML data: %1"
msgstr "Datos XML non válidos:  %1"

#: KDbConnection.cpp:2598
#, qt-format
msgctxt "KDbConnection|"
msgid ""
"Error in XML data: \"%1\" in line %2, column %3.\n"
"XML data: %4"
msgstr ""
"Erro nos datos XML: «%1» na liña %2, columna %3.\n"
"Datos XML: %4"

#: KDbConnection.cpp:2739
msgctxt "KDbConnection|"
msgid "Table has no fields defined."
msgstr "A táboa non ten campos definidos."

#: KDbConnection.cpp:2899
#, qt-format
msgctxt "KDbConnection|"
msgid ""
"Could not find definition for query \"%1\". Removing this query is "
"recommended."
msgstr ""
"Non foi posíbel encontrar a definición da consulta «%1». Recoméndase "
"eliminar esta consulta."

#: KDbConnection.cpp:2909
#, qt-format
msgctxt "KDbConnection|"
msgid ""
"<p>Could not load definition for query \"%1\". SQL statement for this query "
"is invalid:<br><tt>%2</tt></p>\n"
"<p>You can open this query in Text View and correct it.</p>"
msgstr ""
" <p>Non foi posíbel cargar a consulta \"%1\". A instrución de SQL desta "
"consulta non é válida:<br><tt>%2</tt></p>\n"
"<p>Pode abrir esta consulta na vista de texto e corrixila.</p>"

#: KDbConnection.cpp:3084
msgctxt "KDbConnection|"
msgid "Could not update record because there is no master table defined."
msgstr ""
"Non se actualizou o rexistro porque non hai unha táboa mestre definida."

#: KDbConnection.cpp:3091
msgctxt "KDbConnection|"
msgid ""
"Could not update record because master table has no primary key defined."
msgstr ""
"Non se actualizou o rexistro porque a táboa mestre non ten unha chave "
"primaria definida."

#: KDbConnection.cpp:3122
msgctxt "KDbConnection|"
msgid ""
"Could not update record because it does not contain entire primary key of "
"master table."
msgstr ""
"Non se actualizou o rexistro porque non contén todas as chaves primarias da "
"táboa mestre."

#: KDbConnection.cpp:3133 KDbConnection.cpp:3378
#, qt-format
msgctxt "KDbConnection|"
msgid "Primary key's field \"%1\" cannot be empty."
msgstr "O campo de chave primaria «%1» non pode estar baleiro."

#: KDbConnection.cpp:3161
msgctxt "KDbConnection|"
msgid "Record updating on the server failed."
msgstr "Fallou a actualización do rexistro no servidor."

#: KDbConnection.cpp:3183
msgctxt "KDbConnection|"
msgid "Could not insert record because there is no master table specified."
msgstr "Non se inseriu o rexistro porque non hai unha táboa mestre indicada."

#: KDbConnection.cpp:3223
msgctxt "KDbConnection|"
msgid ""
"Could not insert record because master table has no primary key specified."
msgstr ""
"Non se inseriu o rexistro porque a táboa mestre non ten ningunha chave "
"primaria indicada."

#: KDbConnection.cpp:3232
msgctxt "KDbConnection|"
msgid ""
"Could not insert record because it does not contain entire master table's "
"primary key."
msgstr ""
"Non se inseriu o rexistro porque non contén a chave primaria completa da "
"táboa mestre."

#: KDbConnection.cpp:3280
msgctxt "KDbConnection|"
msgid "Record inserting on the server failed."
msgstr "Fallou a inserción de rexistro no servidor."

#: KDbConnection.cpp:3342
msgctxt "KDbConnection|"
msgid "Could not delete record because there is no master table specified."
msgstr "Non se eliminou o rexistro porque non hai unha táboa mestre indicada."

#: KDbConnection.cpp:3351
msgctxt "KDbConnection|"
msgid ""
"Could not delete record because there is no primary key for master table "
"specified."
msgstr ""
"Non se puido eliminar o rexistro xa que non hai unha clave principal para a "
"táboa mestre indicada."

#: KDbConnection.cpp:3368
msgctxt "KDbConnection|"
msgid ""
"Could not delete record because it does not contain entire master table's "
"primary key."
msgstr ""
"Non se eliminou o rexistro xa que non contén a claves primaria completa da "
"táboa mestre."

#: KDbConnection.cpp:3395 KDbConnection.cpp:3418
msgctxt "KDbConnection|"
msgid "Record deletion on the server failed."
msgstr "Fallou o rexistro de eliminación no servidor."

#: KDbConnectionData.cpp:37
msgctxt "KDbConnection|"
msgid "<file>"
msgstr "<ficheiro>"

#: KDbConnectionData.cpp:39
#, qt-format
msgctxt "KDbConnection|"
msgid "file: %1"
msgstr "ficheiro: %1"

#: KDbCursor.cpp:181
msgctxt "KDbCursor|"
msgid "No query statement or schema defined."
msgstr "Non se definiu ningunha instrución ou esquema de consulta."

#: KDbCursor.cpp:194
msgctxt "KDbCursor|"
msgid "Could not generate query statement."
msgstr "Non foi posíbel xerar a instrución de consulta."

#: KDbCursor.cpp:209
msgctxt "KDbCursor|"
msgid "Error opening database cursor."
msgstr "Erro ao acceder ao cursor da base de datos."

#: KDbCursor.cpp:415 KDbCursor.cpp:439
msgctxt "KDbCursor|"
msgid "Could not fetch next record."
msgstr "Non foi posíbel obter o seguinte rexistro."

#: KDbDriver.cpp:76
#, qt-format
msgctxt "KDbDriver|"
msgid "Invalid database driver's \"%1\" implementation."
msgstr "Implementación non válida do controlador de base de datos «%1»."

#: KDbDriver.cpp:77
#, qt-format
msgctxt "KDbDriver|"
msgid "Value of \"%1\" is not initialized for the driver."
msgstr "O valor de «%1» non está inicializado para o controlador."

#: KDbDriver_p.cpp:60
msgctxt "KDbDriver|"
msgid "Client library version"
msgstr "Versión da biblioteca cliente"

#: KDbDriver_p.cpp:62
msgctxt "KDbDriver|"
msgid "Default character encoding on server"
msgstr "Codificación de caracteres por omisión do servidor"

#: KDbDriver_p.cpp:68
msgctxt "KDbDriver|"
msgid "File-based database driver"
msgstr "Controlador para base de datos en ficheiro"

#: KDbDriver_p.cpp:71
msgctxt "KDbDriver|"
msgid "File-based database's MIME types"
msgstr "Tipos MIME da base de datos en ficheiro"

#: KDbDriver_p.cpp:90
msgctxt "KDbDriver|"
msgid "Single transactions support"
msgstr "Compatibilidade con transaccións únicas"

#: KDbDriver_p.cpp:92
msgctxt "KDbDriver|"
msgid "Multiple transactions support"
msgstr "Compatibilidade con transaccións múltiples"

#: KDbDriver_p.cpp:94
msgctxt "KDbDriver|"
msgid "Nested transactions support"
msgstr "Compatibilidade con transaccións aniñadas"

#: KDbDriver_p.cpp:96
msgctxt "KDbDriver|"
msgid "Ignored transactions support"
msgstr "Compatibilidade con transaccións ignoradas"

#: KDbDriver_p.cpp:101
