msgctxt "Name"
msgid "Dome Parked"
msgstr "Estacionouse a bóveda"

#: kstars/kstars.notifyrc:1105
msgctxt "Comment"
msgid "Parking dome is complete"
msgstr "Completouse o estacionamento da bóveda."

#: kstars/kstars.notifyrc:1124
msgctxt "Name"
msgid "Dome Unparking"
