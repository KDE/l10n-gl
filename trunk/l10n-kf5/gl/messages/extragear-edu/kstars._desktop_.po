#: kstars/kstars.notifyrc:4
msgctxt "Comment"
msgid "KStars"
msgstr "KStars"

#: kstars/kstars.notifyrc:33
msgctxt "Name"
msgid "Focus started"
msgstr "Iniciouse o foco"

