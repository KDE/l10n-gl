#: kstars/kstars.notifyrc:1094
msgctxt "Name"
msgid "Dome unparked"
msgstr "Desestacionouse a bóveda"

#: kstars/kstars.notifyrc:1110
msgctxt "Comment"
msgid "Unparking dome is complete"
