msgctxt "Description"
msgid ""
"KStars is attempting to save an Astrometry Index File to a directory owned "
"by root"
msgstr ""
"KStars está a intentar gardar o ficheiro e índice de astrometría nun "
"directorio propiedade de root."

#: org.kde.kf5auth.kstars.actions:38
