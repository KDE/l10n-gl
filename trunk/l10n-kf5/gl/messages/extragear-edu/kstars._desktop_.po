#: kstars/kstars.notifyrc:3
msgctxt "Comment"
msgid "KStars"
msgstr "KStars"

#: kstars/kstars.notifyrc:31
msgctxt "Name"
msgid "Focus started"
msgstr "Iniciouse o foco"

#: kstars/kstars.notifyrc:51
msgctxt "Comment"
msgid "Autofocus operation started"
