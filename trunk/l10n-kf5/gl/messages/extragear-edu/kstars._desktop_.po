msgctxt "Comment"
msgid "Parking dome is in progress"
msgstr "Estase estacionando a bóveda."

#: kstars/kstars.notifyrc:1026
msgctxt "Name"
msgid "Dome Parked"
msgstr "Estacionouse a bóveda"

#: kstars/kstars.notifyrc:1042
msgctxt "Comment"
msgid "Parking dome is complete"
msgstr "Completouse o estacionamento da bóveda."

#: kstars/kstars.notifyrc:1060
msgctxt "Name"
msgid "Dome Unparking"
msgstr "Desestacionando a bóveda"

#: kstars/kstars.notifyrc:1076
msgctxt "Comment"
msgid "Unparking dome is in progress"
