#: kstars/kstars.notifyrc:896
msgctxt "Comment"
msgid "Mount parked"
msgstr "Completouse o estacionamento da montaxe."

#: kstars/kstars.notifyrc:915
msgctxt "Name"
msgid "Mount parking failed"
msgstr "O estacionamento da montaxe fallou."

#: kstars/kstars.notifyrc:932
msgctxt "Comment"
msgid "Mount parking failed"
msgstr "O estacionamento da montaxe fallou."

#: kstars/kstars.notifyrc:951
msgctxt "Name"
msgid "Mount unparked"
msgstr "Desestacionouse a montaxe"

#: kstars/kstars.notifyrc:967
msgctxt "Comment"
msgid "Mount unparked"
msgstr "Desestacionouse a montaxe."

#: kstars/kstars.notifyrc:985
msgctxt "Name"
msgid "Dome Parking"
msgstr "Estacionando a bóveda"

