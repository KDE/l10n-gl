msgctxt "Name"
msgid "Video Recording Started"
msgstr "Iniciouse a gravación de vídeo"

#: kstars/kstars.notifyrc:1157
msgctxt "Name"
msgid "Video Recording Stopped"
msgstr "Detívose a gravación de vídeo"

#: kstars/kstars.notifyrc:1175
msgctxt "Name"
msgid "Meridian Flip Started"
msgstr "Iniciouse a volta do meridiano"

#: kstars/kstars.notifyrc:1193
msgctxt "Name"
msgid "Meridian Flip Completed"
msgstr "Completouse a volta do meridiano"

#: kstars/kstars.notifyrc:1211
msgctxt "Name"
msgid "Meridian Flip Failed"
msgstr "A volta do meridiano fallou"

#: kstars/kstars.notifyrc:1229
msgctxt "Name"
msgid "Motion Started"
msgstr "Iniciouse o movemento"

