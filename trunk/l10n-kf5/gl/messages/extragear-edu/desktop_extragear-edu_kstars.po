msgctxt "Comment"
msgid "Parking dome is in progress"
msgstr "Estase estacionando a bóveda."

#: kstars/kstars.notifyrc:1019
msgctxt "Name"
msgid "Dome Parked"
msgstr "Estacionouse a bóveda"

#: kstars/kstars.notifyrc:1035
msgctxt "Comment"
msgid "Parking dome is complete"
msgstr "Completouse o estacionamento da bóveda."

#: kstars/kstars.notifyrc:1053
msgctxt "Name"
msgid "Dome Unparking"
msgstr "Desestacionando a bóveda"

#: kstars/kstars.notifyrc:1069
msgctxt "Comment"
msgid "Unparking dome is in progress"
msgstr "Estase desestacionando a bóveda."

#: kstars/kstars.notifyrc:1087
msgctxt "Name"
msgid "Dome unparked"
msgstr "Desestacionouse a bóveda"

#: kstars/kstars.notifyrc:1103
msgctxt "Comment"
msgid "Unparking dome is complete"
msgstr "Completouse o desestacionamento da bóveda."

#: kstars/kstars.notifyrc:1121
msgctxt "Name"
msgid "Filter Wheel Changed"
