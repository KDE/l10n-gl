#: kstars/kstars.notifyrc:897
msgctxt "Comment"
msgid "Mount parked"
msgstr "Completouse o estacionamento da montaxe."

#: kstars/kstars.notifyrc:916
msgctxt "Name"
msgid "Mount parking failed"
msgstr "O estacionamento da montaxe fallou."

#: kstars/kstars.notifyrc:933
msgctxt "Comment"
msgid "Mount parking failed"
msgstr "O estacionamento da montaxe fallou."

#: kstars/kstars.notifyrc:952
msgctxt "Name"
msgid "Mount unparked"
msgstr "Desestacionouse a montaxe"

#: kstars/kstars.notifyrc:968
msgctxt "Comment"
msgid "Mount unparked"
msgstr "Desestacionouse a montaxe."

#: kstars/kstars.notifyrc:986
msgctxt "Name"
msgid "Dome Parking"
msgstr "Estacionando a bóveda"

#: kstars/kstars.notifyrc:1002
msgctxt "Comment"
msgid "Parking dome is in progress"
msgstr "Estase estacionando a bóveda."

#: kstars/kstars.notifyrc:1020
msgctxt "Name"
msgid "Dome Parked"
msgstr "Estacionouse a bóveda"

#: kstars/kstars.notifyrc:1036
msgctxt "Comment"
msgid "Parking dome is complete"
msgstr "Completouse o estacionamento da bóveda."

#: kstars/kstars.notifyrc:1054
msgctxt "Name"
msgid "Dome Unparking"
msgstr "Desestacionando a bóveda"

#: kstars/kstars.notifyrc:1070
msgctxt "Comment"
msgid "Unparking dome is in progress"
msgstr "Estase desestacionando a bóveda."

#: kstars/kstars.notifyrc:1088
msgctxt "Name"
msgid "Dome unparked"
msgstr "Desestacionouse a bóveda"

#: kstars/kstars.notifyrc:1104
msgctxt "Comment"
msgid "Unparking dome is complete"
msgstr "Completouse o desestacionamento da bóveda."

#: kstars/kstars.notifyrc:1122
msgctxt "Name"
msgid "Filter Wheel Changed"
msgstr "Cambiouse a roda de filtros"

