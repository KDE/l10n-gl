#: kstars/kstars.notifyrc:3
msgctxt "Comment"
msgid "KStars"
msgstr "KStars"

#: kstars/kstars.notifyrc:29
msgctxt "Name"
msgid "Focus started"
msgstr "Iniciouse o foco"

#: kstars/kstars.notifyrc:47
msgctxt "Comment"
msgid "Autofocus operation started"
msgstr "Iniciouse a operación de enfoque automático"

#: kstars/kstars.notifyrc:67
msgctxt "Name"
msgid "Autofocus Success"
msgstr "Enfocouse automaticamente"

