msgctxt "Name"
msgid "Weather Alert"
msgstr "Alerta meteorolóxica"

#: kstars/kstars.notifyrc:601
msgctxt "Comment"
msgid "Weather conditions are critical. Observatory shutdown is imminent"
msgstr ""
"As condicións meteorolóxicas son críticas. O observatorio apagarase en "
"calquera momento."

#: kstars/kstars.notifyrc:625
msgctxt "Name"
msgid "Observatory Startup"
msgstr "Acendemento do observatorio"

