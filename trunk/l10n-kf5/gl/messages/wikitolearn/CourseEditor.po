msgstr "Enténdoo"

#: .courseeditor-alert-dialog-badtitle
msgid ""
"Invalid title! It contains one of the following forbidden characters:  #<>[]|"
"{}/"
msgstr ""
"Título incorrecto! Contén algún dos seguintes caracteres non permitidos: #<"
">[]|"
"{}/"

