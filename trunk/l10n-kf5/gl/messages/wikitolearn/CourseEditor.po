#: .courseeditor
msgid "Course editor"
msgstr "Editor de campos"

#: .courseeditor-createcourse-pagetitle
msgid "Create course"
msgstr "Crear un curso"

#: .courseeditor-editcourse-pagetitle
msgid "Edit course"
msgstr "Editar o curso"

#: .courseeditor-editlevelTwo-pagetitle
