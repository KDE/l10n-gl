#: kio_sftp.cpp:210
#, kde-format
msgid "Incorrect or invalid passphrase"
msgstr "A frase de paso ou é incorrecta ou incorrecta"

#: kio_sftp.cpp:260
#, kde-format
msgid "Could not allocate callbacks"
msgstr "Non se puido asignar memoria ás chamadas"

#: kio_sftp.cpp:273
#, kde-format
msgid "Could not set log verbosity."
msgstr "Non se puido estabelecer o nivel de detalle do rexistro."

#: kio_sftp.cpp:278
#, kde-format
msgid "Could not set log userdata."
msgstr "Non se puido estabelecer o rexistro dos datos do usuario."

#: kio_sftp.cpp:283
#, kde-format
msgid "Could not set log callback."
msgstr "Non se puido estabelecer a resposta do rexistro."

#: kio_sftp.cpp:352 kio_sftp.cpp:354 kio_sftp.cpp:884 kio_sftp.cpp:1178
#, kde-format
msgid "SFTP Login"
msgstr "Acceso por SFTP"

#: kio_sftp.cpp:369
#, kde-format
msgid "Use the username input field to answer this question."
msgstr ""
"Empregue o campo de entrada do nome de usuario para responder esta pregunta."

#: kio_sftp.cpp:382
#, kde-format
msgid "Please enter your password."
msgstr "Insira o seu contrasinal."

#: kio_sftp.cpp:387 kio_sftp.cpp:887 kio_sftp.cpp:1181
#, kde-format
msgid "Site:"
msgstr "Sitio:"

#: kio_sftp.cpp:574
#, kde-format
msgid "Could not create a new SSH session."
msgstr "Non se puido crear unha sesión de SSH nova."

#: kio_sftp.cpp:584 kio_sftp.cpp:588
#, kde-format
msgid "Could not set a timeout."
msgstr "Non se puido definir o tempo de espera."

#: kio_sftp.cpp:596
#, kde-format
msgid "Could not disable Nagle's Algorithm."
msgstr "Non se puido desactivar o algoritmo de Nagle."

#: kio_sftp.cpp:603 kio_sftp.cpp:608
#, kde-format
msgid "Could not set compression."
msgstr "Non se puido definir a compresión."

#: kio_sftp.cpp:614
#, kde-format
msgid "Could not set host."
msgstr "Non se puido estabelecer o servidor."

#: kio_sftp.cpp:620
#, kde-format
msgid "Could not set port."
msgstr "Non se puido estabelecer o porto."

#: kio_sftp.cpp:628
#, kde-format
msgid "Could not set username."
msgstr "Non se puido estabelecer o nome de usuario."

#: kio_sftp.cpp:635
#, kde-format
msgid "Could not parse the config file."
msgstr "Non se puido procesar o ficheiro de configuración."

#: kio_sftp.cpp:652
#, kde-kuit-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "Estase a abrir unha conexión SFTP co servidor %1:%2."

#: kio_sftp.cpp:727
#, kde-format
msgid "Could not get server public key type name"
msgstr "Non se puido obter o nome do tipo de chave pública do servidor"

#: kio_sftp.cpp:738 kio_sftp.cpp:1046
#, kde-format
msgid "Could not create hash from server public key"
msgstr "Non se puido crear o hash da chave pública do servidor"

#: kio_sftp.cpp:748
#, kde-format
msgid "Could not create fingerprint for server public key"
msgstr "Non se puido crear a pegada dixital para a chave pública do servidor"

#: kio_sftp.cpp:758
#, kde-format
msgid ""
"An %1 host key for this server was not found, but another type of key "
"exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist.\n"
"Please contact your system administrator.\n"
"%2"
msgstr ""
"Non se atopou unha chave %1 para este servidor pero existe outro tipo de "
"chave.\n"
"Un atacante podería cambiar a chave predeterminada do servidor para "
"confundir o seu cliente e facerlle pensa que a chave non existe.\n"
"Contacte co administrador do sistema.\n"
"%2"

#: kio_sftp.cpp:770
#, kde-format
msgid ""
"The host key for the server %1 has changed.\n"
"This could either mean that DNS SPOOFING is happening or the IP address for "
"the host and its host key have changed at the same time.\n"
"The fingerprint for the %2 key sent by the remote host is:\n"
"  SHA256:%3\n"
"Please contact your system administrator.\n"
"%4"
msgstr ""
"Cambiouse a chave do servidor %1.\n"
"Isto pode significar ou que se está producindo DNS SPOOFING ou que se "
"cambiaron o enderezo IP do servidor e a súa chave á vez.\n"
"A pegada dixital da chave %2 enviada polo servidor remoto é:\n"
"  SHA256:%3\n"
"Contacte co administrador do sistema.\n"
"%4"

#: kio_sftp.cpp:786 kio_sftp.cpp:1087
#, kde-format
msgid "Warning: Cannot verify host's identity."
msgstr "Aviso: Non se pode verificar a identidade do servidor."

#: kio_sftp.cpp:787
#, kde-format
msgid ""
"The authenticity of host %1 cannot be established.\n"
"The %2 key fingerprint is: %3\n"
"Are you sure you want to continue connecting?"
msgstr ""
"Non se pode estabelecer a autenticidade do servidor %1.\n"
"A pegada dixital da chave %2 é: %3\n"
"Seguro que quere continuar a conectar?"

#: kio_sftp.cpp:824 kio_sftp.cpp:845 kio_sftp.cpp:861 kio_sftp.cpp:876
#: kio_sftp.cpp:932 kio_sftp.cpp:942 kio_sftp.cpp:1118 kio_sftp.cpp:1139
#: kio_sftp.cpp:1155 kio_sftp.cpp:1170 kio_sftp.cpp:1226 kio_sftp.cpp:1236
#, kde-format
msgid "Authentication failed."
msgstr "Fallou a autenticación."

#: kio_sftp.cpp:831 kio_sftp.cpp:1125
#, kde-format
msgid ""
"Authentication failed. The server didn't send any authentication methods"
msgstr ""
"Fallou a autenticación. O servidor non enviou ningún método de autenticación."

#: kio_sftp.cpp:885 kio_sftp.cpp:1179
#, kde-format
msgid "Please enter your username and password."
msgstr "Insira o seu nome de usuario e o contrasinal."

#: kio_sftp.cpp:896 kio_sftp.cpp:1190
#, kde-format
msgid "Incorrect username or password"
msgstr "O nome de usuario ou o contrasinal é incorrecto"

#: kio_sftp.cpp:950 kio_sftp.cpp:1244
#, kde-format
msgid ""
"Unable to request the SFTP subsystem. Make sure SFTP is enabled on the "
"server."
msgstr ""
"Non se pode pedir o subsistema SFTP. Asegúrese de que SFTP está activado no "
"servidor."

#: kio_sftp.cpp:957 kio_sftp.cpp:1251
#, kde-format
msgid "Could not initialize the SFTP session."
msgstr "Non se puido inicializar a sesión SFTP."

#: kio_sftp.cpp:961 kio_sftp.cpp:1255
#, kde-format
msgid "Successfully connected to %1"
msgstr "Conectou con %1"

#: kio_sftp.cpp:1058
#, kde-format
msgid ""
"The host key for this server was not found, but another type of key exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist.\n"
"Please contact your system administrator.\n"
"%1"
msgstr ""
"Non se atopou a chave para este servidor pero existe outro tipo de chave.\n"
"Un atacante podería cambiar a chave predeterminada do servidor para "
"confundir o seu cliente e facerlle pensa que a chave non existe.\n"
"Contacte co administrador do sistema.\n"
"%1"

#: kio_sftp.cpp:1071
#, kde-format
msgid ""
"The host key for the server %1 has changed.\n"
"This could either mean that DNS SPOOFING is happening or the IP address for "
"the host and its host key have changed at the same time.\n"
"The fingerprint for the key sent by the remote host is:\n"
" %2\n"
"Please contact your system administrator.\n"
"%3"
msgstr ""
"Cambiouse a chave do servidor %1.\n"
"Isto pode significar ou que se está producindo DNS SPOOFING ou que se "
"cambiaron o enderezo IP do servidor e a súa chave á vez.\n"
"A pegada dixital da chave enviada polo servidor remoto é:\n"
" %2\n"
"Contacte co administrador do sistema.\n"
"%3"

#: kio_sftp.cpp:1088
#, kde-format
msgid ""
"The authenticity of host %1 cannot be established.\n"
"The key fingerprint is: %2\n"
"Are you sure you want to continue connecting?"
msgstr ""
"Non se pode estabelecer a autenticidade do servidor %1.\n"
"A pegada dixital da chave é: %2\n"
"Seguro que quere continuar a conectar?"

#: kio_sftp.cpp:1300
#, kde-format
msgid "Invalid sftp context"
msgstr "Contexto de SFTP incorrecto"

#: kio_sftp.cpp:1871
#, kde-format
msgid ""
"Could not change permissions for\n"
"%1"
msgstr ""
"Non se puideron cambiar os permisos de\n"
"%1"

#: kio_sftp.cpp:2238
#, kde-format
msgid "Could not read link: %1"
msgstr "Non se puido ler a ligazón: %1"

#~ msgid "No hostname specified."
#~ msgstr "Non se especificou ningún servidor."
