#: ../../effects_and_compositions/video_effects/motion/nervous.rst:1
msgid "Do your first steps with Kdenlive video editor, using nervous effect"
msgstr ""
"Dá os primeiros pasos co editor de vídeo Kdenlive co efecto de nervios."

#: ../../effects_and_compositions/video_effects/motion/nervous.rst:1
msgid ""
"KDE, Kdenlive, video editor, help, learn, easy, effects, filter, video "
"effects, motion, nervous"
msgstr ""
"KDE, Kdenlive, editor de vídeo, axuda, aprender, fácil, efectos, filtro, "
"efectos de vídeo, movemento, nervios"

#: ../../effects_and_compositions/video_effects/motion/nervous.rst:18
msgid "Nervous"
msgstr "Nervios"

#: ../../effects_and_compositions/video_effects/motion/nervous.rst:20
msgid ""
"This effect/filter flushes frames from internal cache into a random, "
"\"nervous\" order. No frame is discarded."
msgstr ""
"Este efecto ou filtro envorca fotogramas da caché interna nunha orde "
"aleatoria, “nerviosa”. Non se salta ningún fotograma."

#: ../../effects_and_compositions/video_effects/motion/nervous.rst:22
msgid ""
"The effect works like a switch, does not have keyframes and no parameters to "
"set."
msgstr ""
"O efecto funciona como interruptor, non ten fotogramas clave, e non ten "
"parámetros para definir."

#: ../../effects_and_compositions/video_effects/motion/nervous.rst:30
msgid "Nervous effect"
msgstr "Efecto de nervios"

