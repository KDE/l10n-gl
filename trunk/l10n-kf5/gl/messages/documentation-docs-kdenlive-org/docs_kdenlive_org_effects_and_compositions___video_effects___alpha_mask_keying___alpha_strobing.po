#: ../../effects_and_compositions/video_effects/alpha_mask_keying/alpha_strobing.rst:15
msgid "Alpha Strobing"
msgstr "Entrecorte de alfa"

#: ../../effects_and_compositions/video_effects/alpha_mask_keying/alpha_strobing.rst:17
msgid ""
"Strobes the alpha channel to 0. Many other filters overwrite the alpha "
"channel, in that case this needs to be last. (strobe)"
msgstr ""
"Entrecorta a canle alfa como 0. Hai moitos outros filtros que poden alterar "
"a canle alfa; se usa algún deles, este filtro, «entrecorte de alfa», ten que "
"ser o último."
