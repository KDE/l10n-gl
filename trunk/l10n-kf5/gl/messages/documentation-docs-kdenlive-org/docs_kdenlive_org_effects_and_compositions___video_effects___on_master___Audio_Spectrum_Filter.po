#: ../../effects_and_compositions/video_effects/on_master/Audio_Spectrum_Filter.rst:19
msgid "Audio Spectrum Filter"
msgstr "Filtro de espectro de son"

#: ../../effects_and_compositions/video_effects/on_master/Audio_Spectrum_Filter.rst:22
msgid ""
"This is the `audiospectrum <https://www.mltframework.org/plugins/"
"FilterAudiospectrum/>`_ MLT filter."
msgstr ""
"Este é o filtro de `espectro de son <https://www.mltframework.org/plugins/"
"FilterAudiospectrum/>`_ de MLT."

#: ../../effects_and_compositions/video_effects/on_master/Audio_Spectrum_Filter.rst:24
msgid ""
"It is a audio visualization filter that draws an audio spectrum on the image."
msgstr ""
"É un filtro de visualización de son que debuxa un espectro de son na imaxe."

#: ../../effects_and_compositions/video_effects/on_master/Audio_Spectrum_Filter.rst:26
msgid "This filter is keyframe-able."
msgstr "O filtro permite definir fotogramas clave."
