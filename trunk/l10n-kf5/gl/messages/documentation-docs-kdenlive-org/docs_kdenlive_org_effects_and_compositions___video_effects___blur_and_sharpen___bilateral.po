#: ../../effects_and_compositions/video_effects/blur_and_sharpen/bilateral.rst:16
msgid "Bilateral"
msgstr "Bilateral"

#: ../../effects_and_compositions/video_effects/blur_and_sharpen/bilateral.rst:18
msgid "This effect applies a kind of blur filter with spatial smoothing while preserving edges. A more in-depth explanation including the mathematical definition is available |here| on Wikipedia."
msgstr ""
"Este efecto aplica un filtro de desenfoque con suavizado espacial pero "
"conservando os bordos. Atopará unha descrición máis detallada, incluída unha "
"definición matemática, |aquí| na Wikipedia."

#: ../../effects_and_compositions/video_effects/blur_and_sharpen/bilateral.rst:20
msgid "This effect has keyframes."
msgstr "Este efecto ten fotogramas clave."

#: ../../effects_and_compositions/video_effects/blur_and_sharpen/bilateral.rst:28
msgid "Bilateral blur effect"
msgstr "Efecto de desenfoque bilateral"
