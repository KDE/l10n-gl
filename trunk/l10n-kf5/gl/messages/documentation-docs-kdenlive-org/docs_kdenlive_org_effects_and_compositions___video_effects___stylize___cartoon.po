#: ../../effects_and_compositions/video_effects/stylize/cartoon.rst:16
msgid "Cartoon"
msgstr "Debuxo"

#: ../../effects_and_compositions/video_effects/stylize/cartoon.rst:18
msgid ""
"This effect/filter does a form of edge detect giving the video a cartoonish "
"appearance."
msgstr ""

#: ../../effects_and_compositions/video_effects/stylize/cartoon.rst:20
msgid "The effect has keyframes."
msgstr ""

#: ../../effects_and_compositions/video_effects/stylize/cartoon.rst:28
