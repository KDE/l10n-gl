#: ../../effects_and_filters/video_effects/deprecated/rgbnoise.rst:11
msgid "rgbnoise"
msgstr "Ruído RGB"

#: ../../effects_and_filters/video_effects/deprecated/rgbnoise.rst:14
msgid "This is an effect in the Misc category."
msgstr "Este é un efecto da categoría «Varios»."

#: ../../effects_and_filters/video_effects/deprecated/rgbnoise.rst:16
msgid ""
"This is the `Frei0r rgbnoise <https://www.mltframework.org/plugins/"
"FilterFrei0r-rgbnoise/>`_ MLT filter by Janne Liljeblad."
msgstr ""
"É o efecto de `ruído RGB de Frei0r <https://www.mltframework.org/plugins/"
"FilterFrei0r-rgbnoise/>`_ de MLT de Janne Liljeblad."

#: ../../effects_and_filters/video_effects/deprecated/rgbnoise.rst:18
msgid ""
"It adds RGB noise to image and takes one parameter *noise* in the range 0 to "
"1 which controls the amount of noise added."
msgstr ""
"Engade ruído RGB a unha imaxe e acepta un parámetro *ruído* cun valor entre "
"0 e 1 que controla a cantidade de ruído para engadir."

#: ../../effects_and_filters/video_effects/deprecated/rgbnoise.rst:20
msgid "https://youtu.be/zkJUitSzWYc"
msgstr "https://youtu.be/zkJUitSzWYc"
