#: ../../effects_and_compositions/video_effects/stylize/color_distance.rst:13
msgid "Color Distance"
msgstr "Distancia das cores"

#: ../../effects_and_compositions/video_effects/stylize/color_distance.rst:17
msgid ""
"This is the `Frei0r colordistance <https://www.mltframework.org/plugins/"
"FilterFrei0r-colordistance/>`_ MLT filter."
msgstr ""
"Este é o filtro de `distancia das cores de Frei0r <https://www.mltframework."
"org/plugins/FilterFrei0r-colordistance/>`_ de MLT."

#: ../../effects_and_compositions/video_effects/stylize/color_distance.rst:19
msgid ""
"Calculates the distance between the selected color and the current pixel and "
"uses that value as new pixel value."
msgstr ""
"Calcula a distancia entre a cor escollida e o píxel actual e usa ese valor "
"como valor do novo píxel."

