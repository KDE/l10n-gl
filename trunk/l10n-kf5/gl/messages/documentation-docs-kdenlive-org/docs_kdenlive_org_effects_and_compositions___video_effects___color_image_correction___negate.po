#: ../../effects_and_compositions/video_effects/color_image_correction/negate.rst:14
msgid "Negate"
msgstr "Negar"

#: ../../effects_and_compositions/video_effects/color_image_correction/negate.rst:16
msgid "This effect/filter negates (inverts) the input video or its alpha channel."
msgstr ""
"Este efecto ou filtro nega (inverte) o vídeo de entrada ou a súa canle alfa."

#: ../../effects_and_compositions/video_effects/color_image_correction/negate.rst:18
msgid "The effect does not have keyframes."
msgstr "O efecto non ten fotogramas clave."

#: ../../effects_and_compositions/video_effects/color_image_correction/negate.rst:26
msgid "Negate effect"
msgstr "Efecto de negar"

#: ../../effects_and_compositions/video_effects/color_image_correction/negate.rst:28
msgid "**Negate alpha** - If checked, it negates/inverts the alpha component (if present). Default is off."
msgstr ""
"**Negar a alfa**: se se marca, nega ou inverte a compoñente alfa (se "
"existe). Está desactivado de maneira predeterminada."
