#: ../../effects_and_compositions/video_effects/on_master/dance.rst:10
msgid "Dance"
msgstr "Bailar"

#: ../../effects_and_compositions/video_effects/on_master/dance.rst:14
msgid "This effect causes the video frame to dance around the screen."
msgstr "Este efecto fai que o fotograma do vídeo baile arredor da pantalla."

#: ../../effects_and_compositions/video_effects/on_master/dance.rst:16
msgid ""
"Add this effect to a video and include another video track below it and a "
"composite transition between the two tracks."
msgstr ""
"Engade este efecto a un vídeo e inclúe outra pista de vídeo baixo dela e "
"unha transición entre as dúas pistas."

