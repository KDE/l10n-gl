#: ../../effects_and_compositions/video_effects/stylize/3-level_threshold.rst:16
msgid "3-level Threshold"
msgstr "Limiar de 3 niveis"

#: ../../effects_and_compositions/video_effects/stylize/3-level_threshold.rst:18
msgid ""
"This effect/filter performs a dynamic 3-level thresholding action turning "
"the source into black, grey and white areas."
msgstr ""
"Este efecto ou filtro realiza unha acción dinámica de limiar de 3 niveis, "
"convertendo a orixinal en zonas negras, grises e brancas."

#: ../../effects_and_compositions/video_effects/stylize/3-level_threshold.rst:20
msgid "The effect does not have keyframes or any parameters to set"
msgstr "O efecto non ten fotogramas clave nin parámetros para definir."

#: ../../effects_and_compositions/video_effects/stylize/3-level_threshold.rst:28
msgid "3-level Threshold effect"
msgstr "Efecto de limiar de 3 niveis"
