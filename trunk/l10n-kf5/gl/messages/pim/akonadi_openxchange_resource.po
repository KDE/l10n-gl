#: openxchangeresource.cpp:636
#, kde-format
msgid "Unable to connect to server"
msgstr "Foi imposíbel conectar co servidor"

#: openxchangeresource.cpp:823
#, kde-format
msgid ""
"The object was edited by another participant in the meantime. Please check."
msgstr ""
"Mentres tanto, o obxecto foi modificado por outro participante. Comprobe os "
"cambios."

#: openxchangeresource.cpp:824
#, kde-format
msgid ""
"Object not found. Maybe it was deleted by another participant in the "
"meantime."
msgstr "Non se atopou o obxecto. Pode que o eliminase outro participante."

#: openxchangeresource.cpp:825
#, kde-format
msgid "You don't have the permission to perform this action on this object."
msgstr ""
"Non ten os permisos necesarios para realizar esta acción neste obxecto."

#: openxchangeresource.cpp:826
#, kde-format
msgid ""
"A conflict detected. Please check if there are other objects in conflict "
"with this one."
msgstr ""
"Detectouse un conflito. Comprobe se hai outros obxectos en conflito con este."

#: openxchangeresource.cpp:827
#, kde-format
msgid ""
"A mandatory data field is missing. Please check. Otherwise contact your "
"administrator."
msgstr ""
"Falta un campo de datos obrigatorio. Compróbeo. De non ser así, contacte co "
"seu administrador."

#: openxchangeresource.cpp:828
#, kde-format
msgid ""
"An appointment conflict detected.\n"
"Please check if there are other appointments in conflict with this one."
msgstr ""
"Detectouse un conflito de citas.\n"
"Comprobe se hai outras citas en conflito con esta."

#: openxchangeresource.cpp:829
#, kde-format
msgid "Internal server error. Please contact your administrator."
msgstr ""
"Produciuse un erro interno do servidor. Póñase en contacto co seu "
"administrador."

