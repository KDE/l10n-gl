#: src/printing/itemlist/listprint.desktop:3
msgctxt "Name"
msgid "List Print Style"
msgstr "Estilo de impresión das listas"

#: src/printing/itemlist/listprint.desktop:35
msgctxt "Comment"
msgid "This plugin allows you to print out events and to-dos in list form."
msgstr ""
"Este complemento permite imprimir as actividades e as tarefas en forma de "
"lista."

#: src/printing/whatsnext/whatsnextprint.desktop:3
msgctxt "Name"
msgid "What's Next Print Style"
msgstr "Estilo de impresión do que ven agora"

#: src/printing/whatsnext/whatsnextprint.desktop:35
msgctxt "Comment"
msgid ""
"This plugin allows you to print out a list of all upcoming events and to-dos."
msgstr ""
"Este complemento permite imprimir unha lista de todas as actividades e "
"tarefas vindeiras."
