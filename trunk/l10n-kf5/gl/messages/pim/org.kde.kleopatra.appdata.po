#. (itstool) path: component/name
#: org.kde.kleopatra.appdata.xml:6
msgid "Kleopatra"
msgstr "Kleopatra"

#. (itstool) path: component/summary
#: org.kde.kleopatra.appdata.xml:7
msgid "Certificate Manager and Unified Crypto GUI"
msgstr "Xestor de certificados e interface gráfica unificada de criptografía"

#. (itstool) path: description/p
#: org.kde.kleopatra.appdata.xml:9
msgid ""
"Kleopatra is a certificate manager and a universal crypto GUI. It supports "
"managing X.509 and OpenPGP certificates in the GpgSM keybox and retrieving "
"certificates from LDAP servers."
msgstr ""
"Kleopatra é un xestor de certificados e unha interface gráfica universal de "
"criptografía. Permite xestionar certificados X.509 e OpenPGP na caixa de"
" chaves "
"GpgSM e obter certificados de servidores LDAP."

