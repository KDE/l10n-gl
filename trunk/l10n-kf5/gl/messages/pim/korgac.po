msgstr "día(s)"

#: alarmdialog.cpp:255
#, kde-format
msgctxt "@item:inlistbox suspend in terms of weeks"
msgid "week(s)"
msgstr "semana(s)"

#: alarmdialog.cpp:258
#, kde-format
msgctxt "@info:tooltip"
msgid "Suspend the reminders using this time unit"
msgstr "Suspender as lembranzas empregando esta unidade de tempo"

#: alarmdialog.cpp:261
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Each reminder for the selected incidences will be suspended using this time "
"unit. You can set the number of time units in the adjacent number entry "
"input."
msgstr ""
"Cada unha das lembranzas das incidencias seleccionadas hase suspender "
"empregando esta unidade de tempo. Pode axustar o número de unidades de tempo "
"no campo que hai a carón."

