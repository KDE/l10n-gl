#: pop3.cpp:217
#, kde-format
msgid "The server said: \"%1\""
msgstr "O servidor respondeu: «%1»"

#: pop3.cpp:239
#, kde-format
msgid "The server terminated the connection."
msgstr "O servidor terminou a conexión."

#: pop3.cpp:241
#, kde-format
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""
"O servidor enviou unha resposta que é incorrecta:\n"
"«%1»"

#: pop3.cpp:279
#, kde-format
msgid "Could not send to server.\n"
msgstr "Non se puido enviar ao servidor.\n"

#: pop3.cpp:331 pop3.cpp:387 pop3.cpp:567
#, kde-format
msgid "No authentication details supplied."
msgstr "Non se forneceron os detalles da autenticación."

#: pop3.cpp:367
#, kde-format
msgid ""
"Login via APOP failed. The server %1 may not support APOP, although it "
"claims to support it, or the password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Fallou o acceso mediante APOP. Pode que o servidor %1 non admita APOP, aínda "
"que diga que si o admite, ou pode que o contrasinal estea equivocado.\n"
"\n"
"%2"

#: pop3.cpp:423
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "Produciuse un erro durante a autenticación: %1"

#: pop3.cpp:544
#, kde-format
msgid ""
"Login via SASL (%1) failed. The server may not support %2, or the password "
"may be wrong.\n"
"\n"
"%3"
msgstr ""
"Fallou o acceso mediante SASL (%1). O máis probábel é que o seu servidor non "
"admita %2 ou que o contrasinal sexa incorrecto.\n"
"\n"
"%3"

#: pop3.cpp:553
#, kde-format
msgid ""
"Your POP3 server (%1) does not support SASL.\n"
"Choose a different authentication method."
msgstr ""
"O seu servidor de POP3 (%1) non admite SASL.\n"
"Escolla un método distinto de autenticación."

#: pop3.cpp:585 pop3.cpp:649
#, kde-format
msgid ""
"Could not login to %1.\n"
"\n"
msgstr ""
"Non se puido acceder a %1.\n"
"\n"

#: pop3.cpp:599
#, kde-format
msgid ""
"Could not login to %1. The password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Non se puido acceder a %1. O máis probábel é que o contrasinal sexa "
"incorrecto.\n"
"\n"
"%2"

#: pop3.cpp:652
#, kde-format
msgid "The server terminated the connection immediately."
msgstr "O servidor terminou a conexión inmediatamente."

#: pop3.cpp:653
#, kde-format
msgid ""
"Server does not respond properly:\n"
"%1\n"
msgstr ""
"O servidor non respondeu axeitadamente:\n"
"%1\n"

#: pop3.cpp:682
#, kde-format
msgid ""
"Your POP3 server (%1) does not support APOP.\n"
"Choose a different authentication method."
msgstr ""
"O seu servidor de POP3 (%1) non admite APOP.\n"
"Escolla un método distinto de autenticación."

#: pop3.cpp:700
#, kde-format
msgid ""
"Your POP3 server claims to support TLS but negotiation was unsuccessful.\n"
"You can disable TLS in the POP account settings dialog."
msgstr ""
"O seu servidor de POP3 di admitir TLS pero a negociación non tivo éxito.\n"
"Pode desactivar o TLS en KDE utilizando o módulo de configuración de cifrado."

#: pop3.cpp:709
#, kde-format
msgid ""
"Your POP3 server (%1) does not support TLS. Disable TLS, if you want to "
"connect without encryption."
msgstr ""
"O seu servidor de POP3 (%1) non admite TLS. Desactive TLS se quere "
"conectarse sen cifrado."

#: pop3.cpp:718
#, kde-format
msgid "Username and password for your POP3 account:"
msgstr "Nome de usuario e contrasinal para a súa conta de POP3:"

#: pop3.cpp:897 pop3.cpp:906 pop3.cpp:1047
#, kde-format
msgid "Unexpected response from POP3 server."
msgstr "Resposta inesperada do servidor de POP3."

#: pop3.cpp:911
#, kde-format
msgid ""
"Error during communication with the POP3 server while trying to list mail: %1"
msgstr ""
"Produciuse un erro durante a comunicación co servidor de POP3 ao intentar "
"enumerar o correo: %1"

#: pop3.cpp:1012
#, kde-format
msgid ""
"Error during communication with the POP3 server while trying to download "
"mail: %1"
msgstr ""
"Produciuse un erro durante a comunicación co servidor de POP3 ao intentar "
"descargar o correo: %1"

#: pop3.cpp:1076
#, kde-format
msgid "The POP3 command 'STAT' failed"
msgstr "Fallou a orde «STAT» de POP3"

#: pop3.cpp:1082
#, kde-format
msgid "Invalid POP3 response, should have at least one space."
msgstr ""
"Recibiuse unha resposta POP3 incorrecta; debera ter polo menos un espazo."

#: pop3.cpp:1090
#, kde-format
msgid "Invalid POP3 STAT response."
msgstr "Recibiuse unha resposta incorrecta do STAT de POP3."
