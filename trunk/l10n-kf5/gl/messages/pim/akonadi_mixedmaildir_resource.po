#: mixedmaildirstore.cpp:1627 mixedmaildirstore.cpp:1660
#, kde-format
msgctxt "@info:status"
msgid "Cannot remove emails from folder %1"
msgstr "Non se poden retirar correos do cartafol %1."

#: mixedmaildirstore.cpp:1730 mixedmaildirstore.cpp:1771
#, kde-format
msgctxt "@info:status"
msgid "Error while reading mails from folder %1"
msgstr "Produciuse un erro ao ler os correos do cartafol %1."

#: mixedmaildirstore.cpp:1751
#, kde-format
msgctxt "@info:status"
msgid "Failed to load Maildirs folder %1"
msgstr "Non se puido cargar o cartafol dos cartafoles de correo, %1."

#: mixedmaildirstore.cpp:1812 mixedmaildirstore.cpp:1825
#: mixedmaildirstore.cpp:1840 mixedmaildirstore.cpp:1878
#: mixedmaildirstore.cpp:1903
#, kde-format
