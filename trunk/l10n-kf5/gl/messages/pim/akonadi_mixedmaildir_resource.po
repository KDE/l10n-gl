#, kde-format
msgctxt "@info:status"
msgid ""
"Item %1 belongs to invalid collection %2. Maybe it was deleted meanwhile?"
msgstr ""
"O elemento %1 pertence á colección %2, que é incorrecta. É posíbel que se "
"eliminase a colección?"

