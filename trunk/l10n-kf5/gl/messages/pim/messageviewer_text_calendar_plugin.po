#: text_calendar.cpp:741 text_calendar.cpp:747
#, kde-format
msgid "\"%1\" occurred already."
msgstr "«%1» xa tivo lugar."

#: text_calendar.cpp:743 text_calendar.cpp:761
#, kde-format
