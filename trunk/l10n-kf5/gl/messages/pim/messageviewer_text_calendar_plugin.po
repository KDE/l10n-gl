msgstr "«%1», que ten lugar hoxe todo o tía, está agora mesmo en progreso."

#: text_calendar.cpp:779
#, kde-format
msgid "\"%1\", happening all day, has already started."
msgstr "«%1», que ten lugar hoxe todo o día, xa comezou."

