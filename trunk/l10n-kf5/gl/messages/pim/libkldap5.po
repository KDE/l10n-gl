#: ldapconnection.cpp:160
#, kde-format
msgid ""
"SASL support is not available. Please recompile libkldap with the Cyrus-SASL "
"(or compatible) client libraries, or complain to your distribution packagers."
msgstr ""
"A compatibilidade con SASL non está dispoñíbel. Por favor, compile de novo "
"libkldap coas bibliotecas cliente de Cyrus-SASL (ou compatíbeis), ou "
"protéstelles aos empaquetadores da súa distribución."

#: ldapconnection.cpp:270
#, kde-format
msgid "An error occurred during the connection initialization phase."
