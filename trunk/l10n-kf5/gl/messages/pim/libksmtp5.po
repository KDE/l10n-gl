#: job.cpp:68
#, kde-format
msgid "Server time out"
msgstr "O servidor superou o tempo límite"

#: job.cpp:70
#, kde-format
msgid "Server error"
msgstr "Erro do servidor"

#: job.cpp:79
#, kde-format
msgid "Connection to server lost."
msgstr "Perdeuse a conexión co servidor."

#: loginjob.cpp:95
#, kde-format
msgid "Login"
msgstr "Identificación"

#: loginjob.cpp:215
#, kde-format
msgid ""
"Could not authenticate to the SMTP server because no matching authentication "
"method has been found"
msgstr ""
"Non se puido autenticar co servidor de SMTP porque non se atopou ningún "
"método de autenticación correspondente."

#: loginjob.cpp:302
#, kde-format
msgid "Login failed, cannot initialize the SASL library"
msgstr "O acceso fallou, non se pode inicializar a biblioteca SASL."

#: sendjob.cpp:74
#, kde-format
msgid "SendJob"
msgstr "Tarefa de envío"

#: sendjob.cpp:123
#, kde-format
msgid ""
"Could not send the message because either the sender or recipient field is "
"missing or invalid"
msgstr ""
"Non se puido enviar a mensaxe porque faltan ou son incorrectos os campos do "
"remitente ou do destinatario."

#: sendjob.cpp:131
#, kde-format
msgid ""
"Could not send the message because it exceeds the maximum allowed size of %1 "
"bytes. (Message size: %2 bytes.)"
msgstr ""
"Non se puido enviar a mensaxe porque supera o tamaño límite de %1 bytes. O "
"tamaño da mensaxe é de %2 bytes."

#~ msgid "Job"
#~ msgstr "Tarefa"
