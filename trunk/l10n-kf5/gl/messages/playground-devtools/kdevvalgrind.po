#. i18n: ectx: property (toolTip), widget (QCheckBox, showInvalidFree)
#: config/ui/valgrindmemcheckconfig.ui:62
#, kde-format
msgid ""
"Whether or not to trace invalid frees (call to free on a non-allocated "
"address)"
msgstr ""
"Determina se trazar ou non as liberacións incorrectas (chamadas a «free» en "
"enderezos para os que non hai memoria reservada)."

#. i18n: ectx: property (text), widget (QCheckBox, showInvalidFree)
#: config/ui/valgrindmemcheckconfig.ui:65
#, kde-format
msgid "Show invalid frees"
msgstr "Mostrar as liberacións incorrectas."

#. i18n: ectx: property (toolTip), widget (QCheckBox, showMismatchedFree)
#: config/ui/valgrindmemcheckconfig.ui:72
#, kde-format
msgid ""
"Whether or not to trace mismatched frees (for example, trying to call free "
"on an area allocated with new)"
msgstr ""
"Determina se trazar ou non as liberacións non asociadas (por exemplo, "
"chamadas a «free» en zonas reservadas mediante «new»)."

#. i18n: ectx: property (text), widget (QCheckBox, showMismatchedFree)
#: config/ui/valgrindmemcheckconfig.ui:75
#, kde-format
msgid "Show mismatched frees"
msgstr "Mostrar as liberacións non asociadas."

#. i18n: ectx: property (toolTip), widget (QCheckBox, showInvalidRead)
#: config/ui/valgrindmemcheckconfig.ui:82
#, kde-format
msgid ""
"Whether or not to trace invalid reads (dereferencing of a non-allocated "
"address)"
msgstr ""
"Determina se trazar ou non as lecturas incorrectas (ler datos dun enderezo "
"de memoria non reservado)."

#. i18n: ectx: property (text), widget (QCheckBox, showInvalidRead)
#: config/ui/valgrindmemcheckconfig.ui:85
#, kde-format
msgid "Show invalid reads"
msgstr "Mostrar as lecturas incorrectas."

#. i18n: ectx: property (toolTip), widget (QCheckBox, showInvalidWrite)
#: config/ui/valgrindmemcheckconfig.ui:92
#, kde-format
msgid ""
"Whether or not to trace invalid writes (writing to a non-allocated address)"
