#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Espazo de traballo de Plasma"

#: plasma_workspace.notifyrc:51
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Lixo: Baleiro"

#: plasma_workspace.notifyrc:97
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Baleirouse o lixo"

#: plasma_workspace.notifyrc:147
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Completación de texto: rotación"

#: plasma_workspace.notifyrc:191
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Acadouse a fin da lista de coincidencias"

#: plasma_workspace.notifyrc:240
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Completación de texto: sen coincidencias"

#: plasma_workspace.notifyrc:284
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Non se atopou ningún acabamento"

#: plasma_workspace.notifyrc:333
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Completación de texto: coincidencia parcial"

#: plasma_workspace.notifyrc:377
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Hai máis dun posíbel acabamento"

#: plasma_workspace.notifyrc:426
msgctxt "Name"
msgid "Fatal Error"
msgstr "Erro fatal"

#: plasma_workspace.notifyrc:471
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Produciuse un erro grave que fixo que o programa saíse"

#: plasma_workspace.notifyrc:521
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: plasma_workspace.notifyrc:567
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Aconteceu algo especial no programa"

#: plasma_workspace.notifyrc:616
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#: plasma_workspace.notifyrc:662
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Produciuse un erro no programa que pode causar problemas"

#: plasma_workspace.notifyrc:711
msgctxt "Name"
msgid "Catastrophe"
msgstr "Catástrofe"

#: plasma_workspace.notifyrc:756
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr ""
"Produciuse un erro moi grave, que como mínimo fixo que o programa saíse"

#: plasma_workspace.notifyrc:805
msgctxt "Name"
msgid "Application Crash"
msgstr "Quebra dun aplicativo"

#: plasma_workspace.notifyrc:845
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Un aplicativo pechouse inesperadamente"

#: plasma_workspace.notifyrc:888
msgctxt "Name"
msgid "Login"
msgstr "Acceso"

#: plasma_workspace.notifyrc:934
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Estase a iniciar unha sesión nova"

#: plasma_workspace.notifyrc:983
msgctxt "Name"
msgid "Logout"
msgstr "Saír"

#: plasma_workspace.notifyrc:1029
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Estase a saír da sesión"

#: plasma_workspace.notifyrc:1079
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Cancelouse a saída"

#: plasma_workspace.notifyrc:1125
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Cancelouse a saída de Plasma"

#: plasma_workspace.notifyrc:1174
msgctxt "Name"
msgid "Print Error"
msgstr "Erro de impresión"

#: plasma_workspace.notifyrc:1220
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Produciuse un erro na impresión"

#: plasma_workspace.notifyrc:1269
msgctxt "Name"
msgid "Information Message"
msgstr "Mensaxe de información"

#: plasma_workspace.notifyrc:1315
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Está a mostrarse unha mensaxe de información"

#: plasma_workspace.notifyrc:1364
msgctxt "Name"
msgid "Warning Message"
msgstr "Mensaxe de aviso"

#: plasma_workspace.notifyrc:1410
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Está a mostrarse unha mensaxe de aviso"

#: plasma_workspace.notifyrc:1459
msgctxt "Name"
msgid "Critical Message"
msgstr "Mensaxe crítica"

#: plasma_workspace.notifyrc:1505
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Está a mostrarse unha mensaxe crítica"

#: plasma_workspace.notifyrc:1554
msgctxt "Name"
msgid "Question"
msgstr "Pregunta"

#: plasma_workspace.notifyrc:1600
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Está a facerse unha pregunta"

#: plasma_workspace.notifyrc:1650
msgctxt "Name"
msgid "Beep"
msgstr "Badalada"

#: plasma_workspace.notifyrc:1696
msgctxt "Comment"
msgid "Sound bell"
msgstr "Badalada sonora"

#: plasma_workspace.notifyrc:1745
msgctxt "Name"
msgid "Widget failed to install"
msgstr "O trebello non puido instalarse"

#: plasma_workspace.notifyrc:1785
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "Non se puido instalar un trebello."

#: plasma_workspace.notifyrc:1828
msgctxt "Name"
msgid "Widget deleted"
msgstr "Eliminouse o trebello"

#: plasma_workspace.notifyrc:1870
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Eliminouse un trebello."
