msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Cancelouse a saída de Plasma"

#: plasma_workspace.notifyrc:881
msgctxt "Name"
msgid "Print Error"
msgstr "Erro de impresión"

#: plasma_workspace.notifyrc:918
