#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Espazo de traballo de Plasma"

#: plasma_workspace.notifyrc:46
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Lixo: Baleiro"

#: plasma_workspace.notifyrc:87
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Baleirouse o lixo"

#: plasma_workspace.notifyrc:132
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Completación de texto: rotación"

#: plasma_workspace.notifyrc:171
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Acadouse a fin da lista de coincidencias"

#: plasma_workspace.notifyrc:215
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Completación de texto: sen coincidencias"

#: plasma_workspace.notifyrc:254
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Non se atopou ningún acabamento"

#: plasma_workspace.notifyrc:297
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Completación de texto: coincidencia parcial"

#: plasma_workspace.notifyrc:336
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Hai máis dun posíbel acabamento"

#: plasma_workspace.notifyrc:379
msgctxt "Name"
msgid "Fatal Error"
msgstr "Erro fatal"

#: plasma_workspace.notifyrc:419
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Produciuse un erro grave que fixo que o programa se pechase"

#: plasma_workspace.notifyrc:464
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: plasma_workspace.notifyrc:505
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Aconteceu algo especial no programa"

#: plasma_workspace.notifyrc:549
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#: plasma_workspace.notifyrc:590
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Produciuse un erro no programa que pode causar problemas"

#: plasma_workspace.notifyrc:634
msgctxt "Name"
msgid "Catastrophe"
msgstr "Catástrofe"

#: plasma_workspace.notifyrc:674
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr ""
"Produciuse un erro moi grave, que como mínimo fixo que o programa se pechase"

#: plasma_workspace.notifyrc:718
msgctxt "Name"
msgid "Application Crash"
msgstr "Quebra dun programa"

#: plasma_workspace.notifyrc:743
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Un programa pechouse inesperadamente"

#: plasma_workspace.notifyrc:771
msgctxt "Name"
msgid "Login"
msgstr "Acceso"

#: plasma_workspace.notifyrc:811
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Estase a iniciar unha sesión nova"

#: plasma_workspace.notifyrc:855
msgctxt "Name"
msgid "Logout"
msgstr "Saír"

#: plasma_workspace.notifyrc:895
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Estase a saír da sesión"

#: plasma_workspace.notifyrc:940
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Cancelouse a saída"

#: plasma_workspace.notifyrc:981
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Cancelouse a saída de Plasma"

#: plasma_workspace.notifyrc:1025
msgctxt "Name"
msgid "Print Error"
msgstr "Erro de impresión"

#: plasma_workspace.notifyrc:1065
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Produciuse un erro na impresión"

#: plasma_workspace.notifyrc:1108
msgctxt "Name"
msgid "Information Message"
msgstr "Mensaxe de información"

#: plasma_workspace.notifyrc:1149
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Está a mostrarse unha mensaxe de información"

#: plasma_workspace.notifyrc:1193
msgctxt "Name"
msgid "Warning Message"
msgstr "Mensaxe de aviso"

#: plasma_workspace.notifyrc:1234
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Está a mostrarse unha mensaxe de aviso"

#: plasma_workspace.notifyrc:1278
msgctxt "Name"
msgid "Critical Message"
msgstr "Mensaxe crítica"

#: plasma_workspace.notifyrc:1319
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Está a mostrarse unha mensaxe crítica"

#: plasma_workspace.notifyrc:1363
msgctxt "Name"
msgid "Question"
msgstr "Pregunta"

#: plasma_workspace.notifyrc:1404
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Está a facerse unha pregunta"

#: plasma_workspace.notifyrc:1449
msgctxt "Name"
msgid "Beep"
msgstr "Badalada"

#: plasma_workspace.notifyrc:1490
msgctxt "Comment"
msgid "Sound bell"
msgstr "Badalada audíbel"

#: plasma_workspace.notifyrc:1533
msgctxt "Name"
msgid "Widget failed to install"
msgstr "Fallo de instalación dun trebello"

#: plasma_workspace.notifyrc:1557
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "Non foi posíbel instalar un trebello."

#: plasma_workspace.notifyrc:1585
msgctxt "Name"
msgid "Widget deleted"
msgstr "Eliminouse o trebello"

#: plasma_workspace.notifyrc:1621
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Eliminouse un trebello."
