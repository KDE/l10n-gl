#: plugin_katetextfilter.cpp:97
#, kde-format
msgctxt "@info"
msgid ""
"<title>Result of:</title><nl /><pre><code>$ %1\n"
"<nl />%2</code></pre>"
msgstr ""
"<title>Resultado de:</title><nl /><pre><code>$ %1\n"
"<nl />%2</code></pre>"

#: plugin_katetextfilter.cpp:154
msgid ""
"You are not allowed to execute arbitrary external applications. If you want "
"to be able to do this, contact your system administrator."
msgstr ""
"Non ten permisos para executar programas externos á súa vontade. Se desexa "
"este permiso contacte co administrador do sistema."

#: plugin_katetextfilter.cpp:156
msgid "Access Restrictions"
msgstr "Restricións de acceso"

#: plugin_katetextfilter.cpp:171 plugin_katetextfilter.cpp:260
#| msgid "Filter"
msgid "Text Filter"
msgstr "Filtro de texto"

#: plugin_katetextfilter.cpp:236
msgid "Usage: textfilter COMMAND"
msgstr "Utilización: textfilter ORDE"

#: plugin_katetextfilter.cpp:246
msgid ""
"<qt><p>Usage: <code>textfilter COMMAND</code></p><p>Replace the selection "
"with the output of the specified shell command.</p></qt>"
msgstr ""
"<qt><p>Utilización: <code>textfilter ORDE</code></p><p>Substitúe a escolla "
"co resultado da orde da shell indicada.</p></qt>"

#: plugin_katetextfilter.cpp:265
msgid "Filter Te&xt..."
msgstr "Fi&ltrar o texto..."

#. i18n: ectx: property (windowTitle), widget (QDialog, TextFilterWidget)
#: textfilterwidget.ui:14
msgid "Dialog"
msgstr "Diálogo"

#. i18n: ectx: property (text), widget (QLabel, lblFilter)
#: textfilterwidget.ui:26
#| msgid "Enter command to pipe selected text through:"
msgid "Enter command to &pipe selected text through:"
msgstr "Indique a orde por onde &canalizar o texto escollido:"

#. i18n: ectx: property (toolTip), widget (QCheckBox, copyResult)
#: textfilterwidget.ui:46
msgid "Copy the result to clipboard leaving a document unchanged."
msgstr "Copia o resultado para o portarretallos sen modificar o documento."

#. i18n: ectx: property (text), widget (QCheckBox, copyResult)
#: textfilterwidget.ui:49
msgid "Copy the result instead of pasting it"
msgstr "Copiar o resultado no canto de apegalo"

#. i18n: ectx: property (toolTip), widget (QCheckBox, mergeOutput)
#: textfilterwidget.ui:57
msgid ""
"If checked, an output from STDOUT and STDERR will be merged and no errors "
"will be reported.\n"
"Otherwise, STDERR will be displayed as a passive message."
msgstr ""
"Se escolle esta opción hanse xuntar as saídas STDOUT e STDERR e non se han "
"informar os erros.\n"
"Se non a escolle, STDERR mostrarase como unha mensaxe pasiva."

#. i18n: ectx: property (text), widget (QCheckBox, mergeOutput)
#: textfilterwidget.ui:60
msgid "Merge STDOUT and STDERR"
msgstr "Xuntar STDOUT e STDERR"

#. i18n: ectx: Menu (tools)
#: ui.rc:6
msgid "&Tools"
msgstr "&Utilidades"

