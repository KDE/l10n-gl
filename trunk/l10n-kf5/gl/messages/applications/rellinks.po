#: plugin_rellinks.cpp:64
#, kde-format
msgid "Rellinks"
msgstr "Rellinks"

#: plugin_rellinks.cpp:72
#, kde-format
msgid "&Top"
msgstr "&Cume"

#: plugin_rellinks.cpp:75
#, kde-format
msgid "<p>This link references a home page or the top of some hierarchy.</p>"
msgstr ""
"<p>Esta ligazón fai referencia a unha páxina inicial ou ao inicio dalgunha "
"xerarquía.</p>"

#: plugin_rellinks.cpp:79
#, kde-format
msgid "&Up"
msgstr "S&ubir"

#: plugin_rellinks.cpp:82
#, kde-format
msgid ""
"<p>This link references the immediate parent of the current document.</p>"
msgstr ""
"<p>Esta ligazón fai referencia ao pai inmediato do documento actual.</p>"

#: plugin_rellinks.cpp:88
#, kde-format
msgid "&First"
msgstr "&Primeira"

#: plugin_rellinks.cpp:91
#, kde-format
msgid ""
"<p>This link type tells search engines which document is considered by the "
"author to be the starting point of the collection.</p>"
msgstr ""
"<p>Esta ligazón dille aos motores de buscas cal documento é considerado polo "
"autor o punto inicial deste conxunto.</p>"

#: plugin_rellinks.cpp:95
#, kde-format
msgid "&Previous"
msgstr "&Anterior"

#: plugin_rellinks.cpp:98
#, kde-format
msgid ""
"<p>This link references the previous document in an ordered series of "
"documents.</p>"
msgstr ""
"<p>Esta ligazón referencia o documento anterior nunha serie ordenada de "
"documentos.</p>"

#: plugin_rellinks.cpp:102
#, kde-format
msgid "&Next"
msgstr "&Seguinte"

#: plugin_rellinks.cpp:105
#, kde-format
msgid ""
"<p>This link references the next document in an ordered series of documents."
"</p>"
msgstr ""
"<p>Esta ligazón referencia o seguinte documento nunha serie ordenada de "
"documentos.</p>"

#: plugin_rellinks.cpp:109
#, kde-format
msgid "&Last"
msgstr "Ú&ltimo"

#: plugin_rellinks.cpp:112
#, kde-format
msgid "<p>This link references the end of a sequence of documents.</p>"
msgstr "<p>Esta ligazón referencia o último dunha secuencia de documentos.</p>"

#: plugin_rellinks.cpp:117
#, kde-format
msgid "&Search"
msgstr "&Buscar"

#: plugin_rellinks.cpp:120
#, kde-format
msgid "<p>This link references the search.</p>"
msgstr "<p>Esta ligazón referencia a busca.</p>"

#: plugin_rellinks.cpp:124
#, kde-format
msgid "Document"
msgstr "Documento"

#: plugin_rellinks.cpp:126
#, kde-format
msgid "<p>This menu contains the links referring the document information.</p>"
msgstr ""
"<p>Este menú contén as ligazóns que fan referencia a datos do documento.</p>"

#: plugin_rellinks.cpp:130
#, kde-format
msgid "Table of &Contents"
msgstr "Táboa de &contidos"

#: plugin_rellinks.cpp:132
#, kde-format
msgid "<p>This link references the table of contents.</p>"
msgstr "<p>Esta ligazón referencia a táboa de contidos.</p>"

#: plugin_rellinks.cpp:136
#, kde-format
msgid "Chapters"
msgstr "Capítulos"

#: plugin_rellinks.cpp:141
#, kde-format
msgid "<p>This menu references the chapters of the document.</p>"
msgstr "<p>Este menú referencia os capítulos do documento.</p>"

#: plugin_rellinks.cpp:144
#, kde-format
msgid "Sections"
msgstr "Seccións"

#: plugin_rellinks.cpp:150
#, kde-format
msgid "<p>This menu references the sections of the document.</p>"
msgstr "<p>Este menú referencia as seccións do documento.</p>"

#: plugin_rellinks.cpp:153
#, kde-format
msgid "Subsections"
msgstr "Subseccións"

#: plugin_rellinks.cpp:158
#, kde-format
msgid "<p>This menu references the subsections of the document.</p>"
msgstr "<p>Este menú referencia as subseccións do documento.</p>"

#: plugin_rellinks.cpp:161
#, kde-format
msgid "Appendix"
msgstr "Apéndice"

#: plugin_rellinks.cpp:166
#, kde-format
msgid "<p>This link references the appendix.</p>"
msgstr "<p>Esta ligazón referencia o apéndice.</p>"

#: plugin_rellinks.cpp:170
#, kde-format
msgid "&Glossary"
msgstr "&Glosario"

#: plugin_rellinks.cpp:172
#, kde-format
msgid "<p>This link references the glossary.</p>"
msgstr "<p>Esta ligazón referencia o glosario.</p>"

#: plugin_rellinks.cpp:177
#, kde-format
msgid "&Index"
msgstr "Índ&ice"

#: plugin_rellinks.cpp:179
#, kde-format
msgid "<p>This link references the index.</p>"
msgstr "<p>Esta ligazón referencia o índice.</p>"

#: plugin_rellinks.cpp:184
#, kde-format
msgid "More"
msgstr "Máis"

#: plugin_rellinks.cpp:186
#, kde-format
msgid "<p>This menu contains other important links.</p>"
msgstr "<p>Este menú contén outras ligazóns importantes.</p>"

#: plugin_rellinks.cpp:190
#, kde-format
msgid "&Help"
msgstr "A&xuda"

#: plugin_rellinks.cpp:193
#, kde-format
msgid "<p>This link references the help.</p>"
msgstr "<p>Esta ligazón referencia a axuda.</p>"

#: plugin_rellinks.cpp:198
#, kde-format
msgid "&Authors"
msgstr "&Autores"

#: plugin_rellinks.cpp:201
#, kde-format
msgid "<p>This link references the author.</p>"
msgstr "<p>Esta ligazón referencia o autor.</p>"

#: plugin_rellinks.cpp:206
#, kde-format
msgid "Copy&right"
msgstr "Copy&right"

#: plugin_rellinks.cpp:209
#, kde-format
msgid "<p>This link references the copyright.</p>"
msgstr "<p>Esta ligazón referencia o copyright.</p>"

#: plugin_rellinks.cpp:213
#, kde-format
msgid "Bookmarks"
msgstr "Marcadores"

#: plugin_rellinks.cpp:216
#, kde-format
msgid "<p>This menu references the bookmarks.</p>"
msgstr "<p>Este menú referencia os marcadores.</p>"

#: plugin_rellinks.cpp:220
#, kde-format
msgid "Other Versions"
msgstr "Outras versións"

#: plugin_rellinks.cpp:223
#, kde-format
msgid "<p>This link references the alternate versions of this document.</p>"
msgstr "<p>Esta ligazón referencia versións alternativas deste documento.</p>"

#: plugin_rellinks.cpp:228
#, kde-format
msgid "Miscellaneous"
msgstr "Diversos"

#: plugin_rellinks.cpp:231
#, kde-format
msgid "<p>Miscellaneous links.</p>"
msgstr "<p>Ligazóns diversas.</p>"

