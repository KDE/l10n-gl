#: view.cpp:311
#, kde-format
msgid ""
"<p>Read the topic documentation in this window.<br /><br />Press <b>Space</"
"b>/<b>Shift+Space</b> to scroll, <b>%1</b> to find something, <b>Tab</b>/"
"<b>Shift+Tab</b> to jump, and <b>Enter</b> to follow.</p>"
msgstr ""
"<p>Consulte a documentación nesta xanela.<br /><br />Prema <b>Espazo</b> ou "
"<b>Maiús+Espazo</b> para desprazarse, <b>%1</b> para atopar algo, <b>Tab</b> "
"ou <b>Maiús+Tab</b> para saltar, e <b>Intro</b> para seguir.</p>"

