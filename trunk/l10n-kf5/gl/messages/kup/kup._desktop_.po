#: daemon/kup-daemon.desktop:2
msgctxt "Name"
msgid "Kup"
msgstr "Kup"

#: daemon/kup-daemon.desktop:35
msgctxt "GenericName"
msgid "Backup Monitor"
msgstr "Vixiante de copias de seguridade"

#: daemon/kupdaemon.notifyrc:3
msgctxt "Name"
msgid "Kup Backup System"
msgstr "Sistema de copias de seguridade Kup"

#: daemon/kupdaemon.notifyrc:31
msgctxt "Comment"
msgid "Kup Backup System"
msgstr "Sistema de copias de seguridade Kup."

#: daemon/kupdaemon.notifyrc:64
msgctxt "Name"
msgid "Start Saving Backup"
msgstr "Iniciar a xeración dunha copia de seguridade"

#: daemon/kupdaemon.notifyrc:92
msgctxt "Comment"
msgid "A question if user wants to start saving a backup"
msgstr ""
"Pregunta á persoa usuaria se quere iniciar a xeración dunha copia de "
"seguridade."

#: daemon/kupdaemon.notifyrc:122
msgctxt "Name"
msgid "Backup Succeeded"
msgstr "Completouse a copia de seguridade"

#: daemon/kupdaemon.notifyrc:150
msgctxt "Comment"
msgid "Saving of backup successfully completed"
msgstr "A copia de seguridade completouse correctamente."

#: daemon/kupdaemon.notifyrc:184
msgctxt "Name"
msgid "Backup Failed"
msgstr "A copia de seguridade fallou"

#: daemon/kupdaemon.notifyrc:212
msgctxt "Comment"
msgid "Saving of backup failed, offer user to see log file"
msgstr ""
"A xeración da copia de seguridade fallou, ofrécese á persoa usuaria "
"consultar o ficheiro do rexistro."

#: daemon/kupdaemon.notifyrc:244
msgctxt "Name"
msgid "Integrity Check Completed"
msgstr "Comprobouse a integridade"

#: daemon/kupdaemon.notifyrc:272
msgctxt "Comment"
msgid "Finished checking integrity of backup archive"
msgstr ""
"Completouse a comprobación da integridade do arquivo de copia de seguridade."

#: daemon/kupdaemon.notifyrc:306
msgctxt "Name"
msgid "Repair Completed"
msgstr "Completouse a reparación"

#: daemon/kupdaemon.notifyrc:334
msgctxt "Comment"
msgid "Finished repairing backup archive"
msgstr "Completouse a reparación do arquivo de copia de seguridade."
