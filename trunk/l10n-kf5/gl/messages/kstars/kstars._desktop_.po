#: kstars/kstars.notifyrc:4
msgctxt "Comment"
msgid "KStars"
msgstr "KStars."

#: kstars/kstars.notifyrc:38
msgctxt "Name"
msgid "Focus started"
msgstr "Iniciouse o foco"

#: kstars/kstars.notifyrc:65
msgctxt "Comment"
msgid "Autofocus operation started"
msgstr "Iniciouse a operación de enfoque automático."

#: kstars/kstars.notifyrc:93
msgctxt "Name"
msgid "Autofocus Success"
msgstr "Enfocouse automaticamente"

#: kstars/kstars.notifyrc:120
msgctxt "Comment"
msgid "Autofocus operation completed successfully"
msgstr "Completouse o enfoque automático."

#: kstars/kstars.notifyrc:150
msgctxt "Name"
msgid "Autofocus Failure"
msgstr "Fallo de enfoque automático"

#: kstars/kstars.notifyrc:177
msgctxt "Comment"
msgid "Autofocus operation failed with errors"
msgstr "A operación de enfoque automático fallou con erros."

#: kstars/kstars.notifyrc:207
msgctxt "Name"
msgid "Alignment Success"
msgstr "Aliñamento correcto"

#: kstars/kstars.notifyrc:234
msgctxt "Comment"
msgid "Astrometry alignment completed successfully"
msgstr "Completouse o aliñamento de astrometría."

#: kstars/kstars.notifyrc:265
msgctxt "Name"
msgid "Alignment Failure"
msgstr "Fallo de aliñamento"

#: kstars/kstars.notifyrc:293
msgctxt "Comment"
msgid "Astrometry alignment failed with errors"
msgstr "O aliñamento de astrometría fallou con erros."

#: kstars/kstars.notifyrc:324
msgctxt "Name"
msgid "Calibration Success"
msgstr "Calibrouse"

