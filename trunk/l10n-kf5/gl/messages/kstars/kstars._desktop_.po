msgid "Mount parking is in progress"
msgstr "Estase aparcando a montaxe."

#: kstars/kstars.notifyrc:1083
msgctxt "Name"
msgid "Parking Mount Completed"
msgstr "Aparcouse a montaxe"

#: kstars/kstars.notifyrc:1105
msgctxt "Comment"
msgid "Mount parked"
msgstr "Completouse o aparcamento da montaxe."

#: kstars/kstars.notifyrc:1129
msgctxt "Name"
msgid "Mount parking failed"
msgstr "O aparcamento da montaxe fallou."

#: kstars/kstars.notifyrc:1151
msgctxt "Comment"
msgid "Mount parking failed"
msgstr "O aparcamento da montaxe fallou."

#: kstars/kstars.notifyrc:1175
msgctxt "Name"
msgid "Mount unparked"
msgstr "Desaparcouse a montaxe"

#: kstars/kstars.notifyrc:1196
msgctxt "Comment"
msgid "Mount unparked"
msgstr "Desaparcouse a montaxe."

#: kstars/kstars.notifyrc:1219
msgctxt "Name"
msgid "Dome Parking"
msgstr "Aparcando a bóveda"

#: kstars/kstars.notifyrc:1240
msgctxt "Comment"
msgid "Parking dome is in progress"
msgstr "Estase aparcando a bóveda."

#: kstars/kstars.notifyrc:1263
msgctxt "Name"
msgid "Dome Parked"
msgstr "Aparcouse a bóveda"

#: kstars/kstars.notifyrc:1284
msgctxt "Comment"
msgid "Parking dome is complete"
msgstr "Completouse o aparcamento da bóveda."

#: kstars/kstars.notifyrc:1307
msgctxt "Name"
msgid "Dome Unparking"
msgstr "Desaparcando a bóveda"

#: kstars/kstars.notifyrc:1328
msgctxt "Comment"
msgid "Unparking dome is in progress"
msgstr "Estase desaparcando a bóveda."

#: kstars/kstars.notifyrc:1351
msgctxt "Name"
msgid "Dome unparked"
msgstr "Desaparcouse a bóveda"

#: kstars/kstars.notifyrc:1372
msgctxt "Comment"
msgid "Unparking dome is complete"
msgstr "Completouse o desaparcamento da bóveda."

#: kstars/kstars.notifyrc:1395
msgctxt "Name"
msgid "Filter Wheel Changed"
msgstr "Cambiouse a roda de filtros"

