msgctxt "Name"
msgid "Video Recording Started"
msgstr "Iniciouse a gravación de vídeo"

#: kstars/kstars.notifyrc:1523
msgctxt "Name"
msgid "Video Recording Stopped"
msgstr "Detívose a gravación de vídeo"

#: kstars/kstars.notifyrc:1551
msgctxt "Name"
msgid "Meridian Flip Started"
msgstr "Iniciouse a volta do meridiano"

#: kstars/kstars.notifyrc:1576
msgctxt "Name"
msgid "Meridian Flip Completed"
msgstr "Completouse a volta do meridiano"

#: kstars/kstars.notifyrc:1601
msgctxt "Name"
msgid "Meridian Flip Failed"
msgstr "A volta do meridiano fallou"

#: kstars/kstars.notifyrc:1626
msgctxt "Name"
msgid "Motion Started"
msgstr "Iniciouse o movemento"

#: kstars/kstars.notifyrc:1650
msgctxt "Comment"
msgid "Mount manual motion started"
msgstr "Iniciouse o movemento manual da montaxe."

#: kstars/kstars.notifyrc:1675
msgctxt "Name"
msgid "Motion Completed"
msgstr "Completouse o movemento"

#: kstars/kstars.notifyrc:1699
msgctxt "Comment"
msgid "Mount manual motion completed"
msgstr "Completouse o movemento manual da montaxe."

#: kstars/kstars.notifyrc:1723
msgctxt "Name"
msgid "INDI Server Message"
msgstr "Mensaxe do servidor de INDI"

#: kstars/kstars.notifyrc:1750
msgctxt "Comment"
msgid "INDI Server Message (it must be enabled in INDI section of Settings)"
msgstr ""
"Mensaxe do servidor de INDI (debe estar activado na sección «INDI» da "
"configuración)."

#: kstars/kstars.notifyrc:1776
msgctxt "Name"
msgid "Scheduled Ekos job started"
msgstr "Un traballo programado de Ekos comezou"

#: kstars/kstars.notifyrc:1800
msgctxt "Comment"
msgid "A scheduled Ekos job is started"
msgstr "Un traballo programado de Ekos comezou."

#: kstars/kstars.notifyrc:1826
msgctxt "Name"
msgid "Scheduled Ekos job failed"
msgstr "Un traballo programado de Ekos fallou"

#: kstars/kstars.notifyrc:1851
msgctxt "Comment"
msgid "A scheduled Ekos job is failed"
msgstr "Un traballo programado de Ekos fallou."

#: kstars/kstars.notifyrc:1878
msgctxt "Name"
msgid "Imaging in scheduled Ekos job started"
msgstr "Comezou o escaneamento nun traballo programado de Ekos"

#: kstars/kstars.notifyrc:1899
msgctxt "Comment"
msgid "An image sequence capture is started in a scheduled Ekos job"
msgstr ""
"Comezou a captura en secuencia dunha imaxe nun traballo programado de Ekos."

#: kstars/kstars.notifyrc:1922
msgctxt "Name"
msgid "Imaging in scheduled Ekos job finished"
msgstr "Rematou o escaneamento nun traballo programado de Ekos"

#: kstars/kstars.notifyrc:1943
msgctxt "Comment"
msgid "An image sequence capture is finished in a scheduled Ekos job"
msgstr ""
"Rematou a captura en secuencia dunha imaxe nun traballo programado de Ekos."

#: kstars/kstars.notifyrc:1966
msgctxt "Name"
msgid "Telescope is synced in a scheduled Ekos job"
msgstr "O telescopio está sincronizado nun traballo de Ekos"

#: kstars/kstars.notifyrc:1988
msgctxt "Comment"
msgid ""
"The telescope is synced before tracking a new target in a scheduled Ekos job"
msgstr ""
"O telescopio está sincronizado antes de facer seguimento dun novo obxectivo "
"nun traballo programado de Ekos."

#: kstars/kstars.notifyrc:2011
msgctxt "Name"
msgid "Captured image received"
msgstr "Recibiuse unha imaxe capturada"

#: kstars/kstars.notifyrc:2040
msgctxt "Name"
msgid "Known Issue"
msgstr "Problema coñecido"

