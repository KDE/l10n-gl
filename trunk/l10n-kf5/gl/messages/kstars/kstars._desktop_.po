#: kstars/kstars.notifyrc:4
msgctxt "Comment"
msgid "KStars"
msgstr "KStars"

#: kstars/kstars.notifyrc:35
msgctxt "Name"
msgid "Focus started"
msgstr "Iniciouse o foco"

