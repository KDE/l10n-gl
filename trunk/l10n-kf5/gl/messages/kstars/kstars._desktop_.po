msgctxt "Comment"
msgid "Mount is slewing to target location"
msgstr "A montaxe está movéndose ao lugar de destino."

#: kstars/kstars.notifyrc:940
msgctxt "Name"
msgid "Slew Completed"
msgstr "Completouse o movemento"

