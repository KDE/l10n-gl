msgctxt "Comment"
msgid "Guiding calibration completed successfully"
msgstr "Completouse a calibración de guía."

#: kstars/kstars.notifyrc:384
msgctxt "Name"
msgid "Calibration Failure"
msgstr "Fallo de calibración"

#: kstars/kstars.notifyrc:413
msgctxt "Comment"
msgid "Guiding calibration failed with errors"
msgstr "A calibración de guía fallou con erros."

#: kstars/kstars.notifyrc:442
msgctxt "Name"
msgid "Guiding Failure"
msgstr "Fallo de guía"

#: kstars/kstars.notifyrc:469
msgctxt "Comment"
msgid "Autoguiding failed with errors"
msgstr "O proceso de guía automática fallou con erros."

#: kstars/kstars.notifyrc:499
msgctxt "Name"
msgid "Capture Success"
msgstr "Capturouse"

#: kstars/kstars.notifyrc:526
msgctxt "Comment"
msgid "CCD Capture completed successfully"
msgstr "Completouse a captura de CCD."

#: kstars/kstars.notifyrc:556
msgctxt "Name"
msgid "Capture Failure"
msgstr "Fallo de captura"

#: kstars/kstars.notifyrc:583
msgctxt "Comment"
msgid "CCD capture failed with errors"
msgstr "A captura de CCD fallou con erros."

#: kstars/kstars.notifyrc:613
msgctxt "Name"
msgid "FITS Received"
msgstr "Recibiuse o FITS"

#: kstars/kstars.notifyrc:640
msgctxt "Comment"
msgid "FITS file is received"
msgstr "Recibiuse o ficheiro de FITS."

#: kstars/kstars.notifyrc:670
msgctxt "Name"
msgid "Weather Warning"
msgstr "Aviso meteorolóxico"

#: kstars/kstars.notifyrc:698
msgctxt "Comment"
msgid "Weather conditions in warning zone"
msgstr "Condicións meteorolóxicas nunha zona baixo aviso."

#: kstars/kstars.notifyrc:727
msgctxt "Name"
msgid "Weather Alert"
msgstr "Alerta meteorolóxica"

#: kstars/kstars.notifyrc:755
msgctxt "Comment"
msgid "Weather conditions are critical. Observatory shutdown is imminent"
msgstr ""
"As condicións meteorolóxicas son críticas. O observatorio apagarase en "
"calquera momento."

#: kstars/kstars.notifyrc:784
msgctxt "Name"
msgid "Observatory Startup"
msgstr "Acendemento do observatorio"

#: kstars/kstars.notifyrc:811
msgctxt "Comment"
msgid "Observatory is in the startup process"
msgstr "O observatorio está en proceso de acendemento."

#: kstars/kstars.notifyrc:839
msgctxt "Name"
msgid "Observatory Shutdown"
msgstr "Apagamento"

#: kstars/kstars.notifyrc:866
msgctxt "Comment"
msgid "Observatory is in the shutdown process"
msgstr "O observatorio está en proceso de apagamento."

#: kstars/kstars.notifyrc:895
msgctxt "Name"
msgid "Scheduler Aborted"
msgstr "Interrompeuse o planificador"

#: kstars/kstars.notifyrc:922
msgctxt "Name"
msgid "Slew Started"
msgstr "Iniciouse o movemento"

