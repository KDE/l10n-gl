#: kstars/kstars.notifyrc:4
msgctxt "Comment"
msgid "KStars"
msgstr "KStars."

#: kstars/kstars.notifyrc:38
msgctxt "Name"
msgid "Focus started"
msgstr "Iniciouse o foco"

#: kstars/kstars.notifyrc:66
msgctxt "Comment"
msgid "Autofocus operation started"
msgstr "Iniciouse a operación de enfoque automático."

#: kstars/kstars.notifyrc:95
msgctxt "Name"
msgid "Autofocus Success"
msgstr "Enfocouse automaticamente"

#: kstars/kstars.notifyrc:123
msgctxt "Comment"
msgid "Autofocus operation completed successfully"
msgstr "Completouse o enfoque automático."

#: kstars/kstars.notifyrc:154
msgctxt "Name"
msgid "Autofocus Failure"
msgstr "Fallo de enfoque automático"

#: kstars/kstars.notifyrc:182
msgctxt "Comment"
msgid "Autofocus operation failed with errors"
msgstr "A operación de enfoque automático fallou con erros."

#: kstars/kstars.notifyrc:213
msgctxt "Name"
msgid "Alignment Success"
msgstr "Aliñamento correcto"

#: kstars/kstars.notifyrc:241
msgctxt "Comment"
msgid "Astrometry alignment completed successfully"
msgstr "Completouse o aliñamento de astrometría."

#: kstars/kstars.notifyrc:273
msgctxt "Name"
msgid "Alignment Failure"
msgstr "Fallo de aliñamento"

#: kstars/kstars.notifyrc:302
msgctxt "Comment"
msgid "Astrometry alignment failed with errors"
msgstr "O aliñamento de astrometría fallou con erros."

#: kstars/kstars.notifyrc:334
msgctxt "Name"
msgid "Calibration Success"
msgstr "Calibrouse"

#: kstars/kstars.notifyrc:364
msgctxt "Comment"
msgid "Guiding calibration completed successfully"
msgstr "Completouse a calibración de guía."

#: kstars/kstars.notifyrc:395
msgctxt "Name"
msgid "Calibration Failure"
msgstr "Fallo de calibración"

#: kstars/kstars.notifyrc:424
msgctxt "Comment"
msgid "Guiding calibration failed with errors"
msgstr "A calibración de guía fallou con erros."

#: kstars/kstars.notifyrc:454
msgctxt "Name"
msgid "Guiding Failure"
msgstr "Fallo de guía"

#: kstars/kstars.notifyrc:482
msgctxt "Comment"
msgid "Autoguiding failed with errors"
msgstr "O proceso de guía automática fallou con erros."

#: kstars/kstars.notifyrc:513
msgctxt "Name"
msgid "Capture Success"
msgstr "Capturouse"

#: kstars/kstars.notifyrc:541
msgctxt "Comment"
msgid "CCD Capture completed successfully"
msgstr "Completouse a captura de CCD."

#: kstars/kstars.notifyrc:572
msgctxt "Name"
msgid "Capture Failure"
msgstr "Fallo de captura"

#: kstars/kstars.notifyrc:600
msgctxt "Comment"
msgid "CCD capture failed with errors"
msgstr "A captura de CCD fallou con erros."

#: kstars/kstars.notifyrc:631
msgctxt "Name"
msgid "FITS Received"
msgstr "Recibiuse o FITS"

#: kstars/kstars.notifyrc:659
msgctxt "Comment"
msgid "FITS file is received"
msgstr "Recibiuse o ficheiro de FITS."

#: kstars/kstars.notifyrc:690
msgctxt "Name"
msgid "Weather Warning"
msgstr "Aviso meteorolóxico"

#: kstars/kstars.notifyrc:719
msgctxt "Comment"
msgid "Weather conditions in warning zone"
msgstr "Condicións meteorolóxicas nunha zona baixo aviso."

#: kstars/kstars.notifyrc:749
msgctxt "Name"
msgid "Weather Alert"
msgstr "Alerta meteorolóxica"

#: kstars/kstars.notifyrc:778
msgctxt "Comment"
msgid "Weather conditions are critical. Observatory shutdown is imminent"
msgstr ""
"As condicións meteorolóxicas son críticas. O observatorio apagarase en "
"calquera momento."

#: kstars/kstars.notifyrc:808
msgctxt "Name"
msgid "Observatory Startup"
msgstr "Acendemento do observatorio"

#: kstars/kstars.notifyrc:836
msgctxt "Comment"
msgid "Observatory is in the startup process"
msgstr "O observatorio está en proceso de acendemento."

#: kstars/kstars.notifyrc:865
msgctxt "Name"
msgid "Observatory Shutdown"
msgstr "Apagamento"

#: kstars/kstars.notifyrc:893
msgctxt "Comment"
msgid "Observatory is in the shutdown process"
msgstr "O observatorio está en proceso de apagamento."

#: kstars/kstars.notifyrc:923
msgctxt "Name"
msgid "Scheduler Aborted"
msgstr "Interrompeuse o planificador"

#: kstars/kstars.notifyrc:951
msgctxt "Name"
msgid "Scheduler Sleeping"
msgstr "O planificador está inactivo"

#: kstars/kstars.notifyrc:970
msgctxt "Name"
msgid "Slew Started"
msgstr "Iniciouse o movemento"

#: kstars/kstars.notifyrc:996
msgctxt "Comment"
msgid "Mount is slewing to target location"
msgstr "A montaxe está movéndose ao lugar de destino."

#: kstars/kstars.notifyrc:1024
msgctxt "Name"
msgid "Slew Completed"
msgstr "Completouse o movemento"

#: kstars/kstars.notifyrc:1050
msgctxt "Comment"
msgid "Mount arrived at target location"
msgstr "A montaxe chegou ao lugar de destino."

#: kstars/kstars.notifyrc:1078
msgctxt "Name"
msgid "Mount Aborted"
msgstr "Interrompeuse a montaxe"

#: kstars/kstars.notifyrc:1103
msgctxt "Comment"
msgid "Mount motion was aborted"
msgstr "Interrompeuse o movemento da montaxe."

#: kstars/kstars.notifyrc:1129
msgctxt "Name"
msgid "Mount Parking"
msgstr "Aparcando a montaxe"

#: kstars/kstars.notifyrc:1153
msgctxt "Comment"
msgid "Mount parking is in progress"
msgstr "Estase aparcando a montaxe."

#: kstars/kstars.notifyrc:1179
msgctxt "Name"
msgid "Parking Mount Completed"
msgstr "Aparcouse a montaxe"

#: kstars/kstars.notifyrc:1203
msgctxt "Comment"
msgid "Mount parked"
msgstr "Completouse o aparcamento da montaxe."

#: kstars/kstars.notifyrc:1229
msgctxt "Name"
msgid "Mount parking failed"
msgstr "O aparcamento da montaxe fallou."

#: kstars/kstars.notifyrc:1253
msgctxt "Comment"
msgid "Mount parking failed"
msgstr "O aparcamento da montaxe fallou."

#: kstars/kstars.notifyrc:1279
msgctxt "Name"
msgid "Mount unparked"
msgstr "Desaparcouse a montaxe"

#: kstars/kstars.notifyrc:1302
msgctxt "Comment"
msgid "Mount unparked"
msgstr "Desaparcouse a montaxe."

#: kstars/kstars.notifyrc:1327
msgctxt "Name"
msgid "Dome Parking"
msgstr "Aparcando a bóveda"

#: kstars/kstars.notifyrc:1350
msgctxt "Comment"
msgid "Parking dome is in progress"
msgstr "Estase aparcando a bóveda."

#: kstars/kstars.notifyrc:1375
msgctxt "Name"
msgid "Dome Parked"
msgstr "Aparcouse a bóveda"

#: kstars/kstars.notifyrc:1398
msgctxt "Comment"
msgid "Parking dome is complete"
msgstr "Completouse o aparcamento da bóveda."

#: kstars/kstars.notifyrc:1423
msgctxt "Name"
msgid "Dome Unparking"
msgstr "Desaparcando a bóveda"

#: kstars/kstars.notifyrc:1446
msgctxt "Comment"
msgid "Unparking dome is in progress"
msgstr "Estase desaparcando a bóveda."

#: kstars/kstars.notifyrc:1471
msgctxt "Name"
msgid "Dome unparked"
msgstr "Desaparcouse a bóveda"

#: kstars/kstars.notifyrc:1494
msgctxt "Comment"
msgid "Unparking dome is complete"
msgstr "Completouse o desaparcamento da bóveda."

#: kstars/kstars.notifyrc:1519
msgctxt "Name"
msgid "Filter Wheel Changed"
msgstr "Cambiouse a roda de filtros"

#: kstars/kstars.notifyrc:1546
msgctxt "Name"
msgid "Video Recording Started"
msgstr "Iniciouse a gravación de vídeo"

#: kstars/kstars.notifyrc:1574
msgctxt "Name"
msgid "Video Recording Stopped"
msgstr "Detívose a gravación de vídeo"

#: kstars/kstars.notifyrc:1602
msgctxt "Name"
msgid "Meridian Flip Started"
msgstr "Iniciouse a volta do meridiano"

#: kstars/kstars.notifyrc:1628
msgctxt "Name"
msgid "Meridian Flip Completed"
msgstr "Completouse a volta do meridiano"

#: kstars/kstars.notifyrc:1654
msgctxt "Name"
msgid "Meridian Flip Failed"
msgstr "A volta do meridiano fallou"

#: kstars/kstars.notifyrc:1680
msgctxt "Name"
msgid "Motion Started"
msgstr "Iniciouse o movemento"

#: kstars/kstars.notifyrc:1705
msgctxt "Comment"
msgid "Mount manual motion started"
msgstr "Iniciouse o movemento manual da montaxe."

#: kstars/kstars.notifyrc:1731
msgctxt "Name"
msgid "Motion Completed"
msgstr "Completouse o movemento"

#: kstars/kstars.notifyrc:1756
msgctxt "Comment"
msgid "Mount manual motion completed"
msgstr "Completouse o movemento manual da montaxe."

#: kstars/kstars.notifyrc:1781
msgctxt "Name"
msgid "INDI Server Message"
msgstr "Mensaxe do servidor de INDI"

#: kstars/kstars.notifyrc:1808
msgctxt "Comment"
msgid "INDI Server Message (it must be enabled in INDI section of Settings)"
msgstr ""
"Mensaxe do servidor de INDI (debe estar activado na sección «INDI» da "
"configuración)."

#: kstars/kstars.notifyrc:1835
msgctxt "Name"
msgid "Scheduled Ekos job started"
msgstr "Un traballo programado de Ekos comezou"

#: kstars/kstars.notifyrc:1860
msgctxt "Comment"
msgid "A scheduled Ekos job is started"
msgstr "Un traballo programado de Ekos comezou."

#: kstars/kstars.notifyrc:1887
msgctxt "Name"
msgid "Scheduled Ekos job failed"
msgstr "Un traballo programado de Ekos fallou"

#: kstars/kstars.notifyrc:1913
msgctxt "Comment"
msgid "A scheduled Ekos job is failed"
msgstr "Un traballo programado de Ekos fallou."

#: kstars/kstars.notifyrc:1941
msgctxt "Name"
msgid "Imaging in scheduled Ekos job started"
msgstr "Comezou o escaneamento nun traballo programado de Ekos"

#: kstars/kstars.notifyrc:1963
msgctxt "Comment"
msgid "An image sequence capture is started in a scheduled Ekos job"
msgstr ""
"Comezou a captura en secuencia dunha imaxe nun traballo programado de Ekos."

#: kstars/kstars.notifyrc:1987
msgctxt "Name"
msgid "Imaging in scheduled Ekos job finished"
msgstr "Rematou o escaneamento nun traballo programado de Ekos"

#: kstars/kstars.notifyrc:2009
msgctxt "Comment"
msgid "An image sequence capture is finished in a scheduled Ekos job"
msgstr ""
"Rematou a captura en secuencia dunha imaxe nun traballo programado de Ekos."

#: kstars/kstars.notifyrc:2033
msgctxt "Name"
msgid "Telescope is synced in a scheduled Ekos job"
msgstr "O telescopio está sincronizado nun traballo de Ekos"

#: kstars/kstars.notifyrc:2056
msgctxt "Comment"
msgid ""
"The telescope is synced before tracking a new target in a scheduled Ekos job"
msgstr ""
"O telescopio está sincronizado antes de facer seguimento dun novo obxectivo "
"nun traballo programado de Ekos."

#: kstars/kstars.notifyrc:2081
msgctxt "Name"
msgid "Captured image received"
msgstr "Recibiuse unha imaxe capturada"

#: kstars/kstars.notifyrc:2110
msgctxt "Name"
msgid "Known Issue"
msgstr "Problema coñecido"

#: kstars/org.kde.kstars.desktop:8
msgctxt "Comment"
msgid "Desktop Planetarium"
msgstr "Planetario de escritorio."

#: kstars/org.kde.kstars.desktop:79
msgctxt "Name"
msgid "KStars"
msgstr "KStars"

#: kstars/org.kde.kstars.desktop:148
msgctxt "GenericName"
msgid "Desktop Planetarium"
msgstr "Planetario"

#: org.kde.kf5auth.kstars.actions:2
msgctxt "Name"
msgid "Save Astrometry Index File to a write protected directory"
msgstr ""
"Gardar o ficheiro de índice de astrometría nun cartafol protexido contra "
"escritura"

#: org.kde.kf5auth.kstars.actions:27
msgctxt "Description"
msgid ""
"KStars is attempting to save an Astrometry Index File to a directory owned "
"by root"
msgstr ""
"KStars está a intentar gardar o ficheiro e índice de astrometría nun "
"cartafol propiedade de root."

#: org.kde.kf5auth.kstars.actions:56
msgctxt "Name"
msgid "Remove an Astrometry Index File Set"
msgstr "Retirar un grupo de ficheiros de índice de astrometría"

#: org.kde.kf5auth.kstars.actions:81
msgctxt "Description"
msgid "KStars is attempting to remove Astrometry Index Files owned by root"
msgstr ""
"KStars está a intentar retirar ficheiros de índice de astrometría propiedade "
"de root."

