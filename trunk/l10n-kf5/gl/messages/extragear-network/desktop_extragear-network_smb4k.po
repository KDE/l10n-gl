msgctxt "Comment"
msgid "Multiple shares have been unmounted"
msgstr "Desmontáronse varias comparticións."

#: core/smb4k.notifyrc:484
msgctxt "Name"
msgid "Opening wallet failed"
msgstr "Non foi posíbel abrir a carteira"

#: core/smb4k.notifyrc:510
msgctxt "Comment"
msgid "The network wallet could not be opened"
msgstr "Non foi posíbel abrir a carteira da rede."

#: core/smb4k.notifyrc:541
msgctxt "Name"
msgid "Credentials not accessible"
msgstr "Non é posíbel acceder aos credenciais"

#: core/smb4k.notifyrc:567
msgctxt "Comment"
msgid "The credentials could not be read from the wallet"
msgstr "Non foi posíbel ler os credenciais da carteira."

#: core/smb4k.notifyrc:598
msgctxt "Name"
msgid "Mimetype not supported"
msgstr "O tipo MIME é incompatíbel"

#: core/smb4k.notifyrc:624
msgctxt "Comment"
msgid "The mimetype of the file that is to be printed is not supported"
msgstr "O tipo MIME do ficheiro para imprimir non é compatíbel."

#: core/smb4k.notifyrc:653
msgctxt "Name"
msgid "Bookmark exists"
msgstr "O marcador existe"

#: core/smb4k.notifyrc:679
msgctxt "Comment"
msgid "The bookmark exists"
msgstr "O marcador xa existe."

#: core/smb4k.notifyrc:710
msgctxt "Name"
msgid "Bookmark label in use"
msgstr "A etiqueta xa existe"

#: core/smb4k.notifyrc:735
msgctxt "Comment"
msgid "The label for the bookmark already exists"
msgstr "A etiqueta para o marcador xa existe."

#: core/smb4k.notifyrc:766
msgctxt "Name"
msgid "No master browser provided"
msgstr "Non se forneceu o navegador mestre"

#: core/smb4k.notifyrc:791
msgctxt "Comment"
