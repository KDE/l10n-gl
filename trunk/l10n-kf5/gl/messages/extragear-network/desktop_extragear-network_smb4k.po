msgstr "Non se forneceu o navegador mestre personalizado."

#: core/smb4k.notifyrc:821
msgctxt "Name"
msgid "Configuration file for Samba missing"
msgstr "Falta o ficheiro de configuración de Samba"

#: core/smb4k.notifyrc:845
msgctxt "Comment"
msgid "The configuration file for the Samba suite is missing"
msgstr "Falta o ficheiro de configuración da colección de software Samba."

#: core/smb4k.notifyrc:873
msgctxt "Name"
msgid "Retrieving domains failed"
msgstr "Non foi posíbel obter os dominios"

