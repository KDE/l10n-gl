#: core/smb4k.notifyrc:66
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: core/smb4k.notifyrc:98
msgctxt "Comment"
msgid "The user is notified about an action"
msgstr "O usuario recibe unha notificación dunha acción."

#: core/smb4k.notifyrc:128
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#: core/smb4k.notifyrc:160
msgctxt "Comment"
msgid "A warning is shown to the user"
msgstr "O usuario recibe un aviso."

#: core/smb4k.notifyrc:192
msgctxt "Name"
msgid "Error"
msgstr "Erro"

#: core/smb4k.notifyrc:224
msgctxt "Comment"
msgid "An error message is shown to the user"
