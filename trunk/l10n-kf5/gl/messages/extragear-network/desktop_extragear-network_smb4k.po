msgctxt "Comment"
msgid "Multiple shares have been unmounted"
msgstr "Desmontáronse varias comparticións."

#: core/smb4k.notifyrc:470
msgctxt "Name"
msgid "Opening wallet failed"
msgstr "Non foi posíbel abrir a carteira"

#: core/smb4k.notifyrc:495
msgctxt "Comment"
msgid "The network wallet could not be opened"
msgstr "Non foi posíbel abrir a carteira da rede."

#: core/smb4k.notifyrc:525
msgctxt "Name"
msgid "Credentials not accessible"
msgstr "Non é posíbel acceder aos credenciais"

#: core/smb4k.notifyrc:550
msgctxt "Comment"
msgid "The credentials could not be read from the wallet"
msgstr "Non foi posíbel ler os credenciais da carteira."

#: core/smb4k.notifyrc:580
msgctxt "Name"
msgid "Mimetype not supported"
msgstr "O tipo MIME é incompatíbel"

#: core/smb4k.notifyrc:605
msgctxt "Comment"
msgid "The mimetype of the file that is to be printed is not supported"
msgstr "O tipo MIME do ficheiro para imprimir non é compatíbel."

#: core/smb4k.notifyrc:634
msgctxt "Name"
msgid "Bookmark exists"
msgstr "O marcador existe"

#: core/smb4k.notifyrc:659
msgctxt "Comment"
msgid "The bookmark exists"
msgstr "O marcador xa existe."

#: core/smb4k.notifyrc:689
msgctxt "Name"
msgid "Bookmark label in use"
msgstr "A etiqueta xa existe"

#: core/smb4k.notifyrc:714
msgctxt "Comment"
msgid "The label for the bookmark already exists"
msgstr "A etiqueta para o marcador xa existe."

#: core/smb4k.notifyrc:744
msgctxt "Name"
msgid "No master browser provided"
msgstr "Non se forneceu o navegador mestre"

#: core/smb4k.notifyrc:768
msgctxt "Comment"
msgid "The custom master browser has not been provided"
msgstr "Non se forneceu o navegador mestre personalizado."

#: core/smb4k.notifyrc:797
msgctxt "Name"
msgid "Configuration file for Samba missing"
msgstr "Falta o ficheiro de configuración de Samba"

#: core/smb4k.notifyrc:820
msgctxt "Comment"
msgid "The configuration file for the Samba suite is missing"
msgstr "Falta o ficheiro de configuración da colección de software Samba."

#: core/smb4k.notifyrc:848
msgctxt "Name"
msgid "Retrieving domains failed"
msgstr "Non foi posíbel obter os dominios"

#: core/smb4k.notifyrc:873
msgctxt "Comment"
msgid "Retrieving the available domains failed"
msgstr "Non foi posíbel obter os dominios dispoñíbeis."

