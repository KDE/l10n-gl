msgid "Start the screenshot tool and show the GUI"
msgstr "Iniciar a ferramenta de captura de pantalla e mostrar a súa interface."

#: desktop/spectacle.khotkeys:96
msgctxt "Name"
msgid "Start Screenshot Tool"
msgstr "Iniciar a ferramenta de captura de pantalla"

