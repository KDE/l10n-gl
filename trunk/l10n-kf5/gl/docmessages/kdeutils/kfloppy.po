#. Tag: para
#: index.docbook:87 index.docbook:103
#, no-c-format
msgid ""
"&kfloppy; Formatter is a utility that provides a straightforward graphical "
"means to format 3.5\" and 5.25\" floppy disks."
msgstr ""
"O formatador &kfloppy; é unha utilidade que fornece un medio gráfico para "
"formatar disquetes de 3.5\" e 5.25\"."

#. Tag: keyword
#: index.docbook:92
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

#. Tag: keyword
#: index.docbook:93
#, no-c-format
