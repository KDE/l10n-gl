msgstr "Configurar &kappname; - Tema visual"

#. Tag: phrase
#: index.docbook:538
#, no-c-format
msgid "<phrase>Theme Configuration</phrase>"
msgstr "<phrase>Configuración d otema</phrase>"

#. Tag: para
#: index.docbook:543
#, no-c-format
msgid "This page will allow you to change the theme &kappname; uses."
msgstr "Esta páxina permite cambiar o tema que &kappname; usa."

