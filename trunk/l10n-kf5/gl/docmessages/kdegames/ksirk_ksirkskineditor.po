msgstr "fotogramas"

#. Tag: entry
#: index.docbook:192
#, no-c-format
msgid "The number of frames of the sprite"
msgstr "O número de fotogramas do gráfico"

#. Tag: entry
#: index.docbook:193
#, no-c-format
msgid "versions"
msgstr "versións"

#. Tag: entry
#: index.docbook:193
#, no-c-format
