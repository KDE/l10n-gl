#. Tag: para
#: conf-options-table.docbook:47
#, no-c-format
msgid ""
"This option enables the asynchronous mode of operation, where the source "
"code update and the build process will be performed in parallel, instead of "
"waiting for all of the source code updates before starting the build process."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:50
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-async\"/>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:55
#, no-c-format
msgid "colorful-output"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:59
#, no-c-format
msgid ""
"Set this option to <userinput>false</userinput> to disable the colorful "
"output of &kdesrc-build;. Note that &kdesrc-build; will not output the color "
"codes to anything but a terminal (such as xterm, &konsole;, or the normal "
"&Linux; console)."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:63
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-color\"/>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:68
#, no-c-format
msgid "disable-agent-check"
msgstr ""

