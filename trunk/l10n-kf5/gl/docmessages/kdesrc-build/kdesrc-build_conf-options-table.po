#. Tag: para
#: conf-options-table.docbook:74
#, no-c-format
msgid ""
"If you are using &ssh; to download the &git; sources (such as if you are "
"using the git+ssh protocol), this option controls if &kdesrc-build; will try "
"and make sure that if you are using ssh-agent, it is actually managing some "
"&ssh; identities. This is to try and prevent &ssh; from asking for your pass "
"phrase for every module."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:79
#, no-c-format
msgid ""
"Related command-line option: --disable-agent-check, --no-disable-agent-check"
msgstr ""

