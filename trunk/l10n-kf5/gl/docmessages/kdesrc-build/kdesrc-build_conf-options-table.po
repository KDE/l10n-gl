msgid ""
"Note that if a valid toolchain is also specified through <link linkend="
"\"conf-cmake-options\">cmake-options</link> it will override the value for "
"<literal>cmake-toolchain</literal>."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:537
#, no-c-format
msgid ""
"Related command-line option: --cmake-toolchain <replaceable>value</"
"replaceable>"
msgstr ""

