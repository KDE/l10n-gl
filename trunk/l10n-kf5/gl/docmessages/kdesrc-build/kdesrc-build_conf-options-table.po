#. Tag: link
#: conf-options-table.docbook:742
#, no-c-format
msgid "http-proxy"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:748
#, no-c-format
msgid ""
"This option, if set, uses the specified URL as a proxy server to use for any "
"HTTP network communications (for example, when downloading the <link linkend="
"\"kde-projects-module-sets\">KDE project database</link>)."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:752
#, no-c-format
msgid ""
"In addition, &kdesrc-build; will try to ensure that the tools it depends on "
"also use that proxy server, if possible, by setting the <envar>http_proxy</"
"envar> environment variable to the indicated server, <emphasis>if that "
"environment variable is not already set</emphasis>."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:756
#, no-c-format
msgid ""
"Related command-line option: --http-proxy <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:761
#, no-c-format
msgid "directory-layout"
msgstr ""

#. Tag: member
#: conf-options-table.docbook:765 conf-options-table.docbook:1021
#: conf-options-table.docbook:1120
#, no-c-format
msgid "Valid values"
msgstr ""

#. Tag: member
#: conf-options-table.docbook:765
#, no-c-format
msgid ""
"<userinput>flat</userinput>, <userinput>invent</userinput>, "
"<userinput>metadata</userinput>"
msgstr ""

#. Tag: member
#: conf-options-table.docbook:767
#, no-c-format
msgid "flat"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:769
#, no-c-format
msgid ""
"This option is used to configure the layout which &kdesrc-build; should use "
"when creating source and build directories."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:771
#, no-c-format
msgid ""
"The <userinput>flat</userinput> layout will group all modules directly "
"underneath the top level source and build directories. For example, "
"<literal>source/extragear/network/telepathy/ktp-text-ui</literal> in the "
"<userinput>metadata</userinput> layout would be <literal>source/ktp-text-ui</"
"literal> using the <userinput>flat</userinput> layout instead."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:777
#, no-c-format
msgid ""
"The <userinput>invent</userinput> layout creates a directory hierarchy "
"mirroring the relative paths of repositories on <ulink url=\"https://invent."
"kde.org/\">invent.kde.org</ulink>. For example <literal>source/kde/"
"applications/kate</literal> in the <userinput>metadata</userinput> layout "
"would be <literal>source/utilities/kate</literal> using the "
"<userinput>invent</userinput> layout instead. This layout only affects KDE "
"projects. It is a good choice for people starting out with &kdesrc-build;."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:784
#, no-c-format
msgid ""
"Finally, the <userinput>metadata</userinput> layout is the same as the old "
"default behaviour. This layout organises KDE projects according to the "
"project paths specified in the project metadata for these modules. This is a "
"good choice if you want a directory layout which tracks with certain KDE "
"processes, but note that this path is therefore not always stable. As a "
"result, &kdesrc-build; may abandon an old copy of the repository and clone a "
"new one for a project due to changes in the project metadata."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:790
#, no-c-format
msgid ""
"Related command-line option: --directory-layout <replaceable>value</"
"replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:795
#, no-c-format
msgid "generate-vscode-project-config"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:803
#, no-c-format
msgid "Module setting overrides global"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:805
#, no-c-format
msgid ""
"Set this option to <userinput>true</userinput> to make &kdesrc-build; create "
"VS Code project files (.vscode directory) in the module source directory."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:809
#, no-c-format
msgid ""
"The .vscode folder will be created in the project source directory, only if "
"it does not already exist. The configurations will enable the use of LSP, "
"building, debugging, and running the project from within VS Code."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:813
#, no-c-format
msgid ""
"The configuration also recommends extensions to install that are useful for "
"working on most KDE projects."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:816
#, no-c-format
msgid ""
"Related command-line option: <xref linkend=\"cmdline-generate-vscode-project-"
"config\"/>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:821
#, no-c-format
msgid "include-dependencies"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:827
#, no-c-format
msgid ""
"Controls if &kdesrc-build; will include known dependencies of this module in "
"its build, without requiring you to mention those dependencies (even "
"indirectly)."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:830
#, no-c-format
msgid ""
"This option only works for <link linkend=\"kde-projects-module-sets"
"\"><literal>kde-project</literal>-based modules</link>, and requires that "
"the metadata maintained by the &kde; developers is accurate for your "
"selected <link linkend=\"conf-branch-group\">branch-group</link>."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:836
#, no-c-format
msgid ""
"This is to support building applications that need versions of &Qt; or "
"&plasma; more recent than supported on common operating systems."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:839
#, no-c-format
msgid ""
"Related command-line option: <xref linkend=\"cmdline-include-dependencies\"/>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:844
#, fuzzy, no-c-format
#| msgid "Install &kdesrc-build;"
msgid "install-after-build"
msgstr "Instalación de &kdesrc-build;"

#. Tag: para
#: conf-options-table.docbook:850
#, no-c-format
msgid ""
"This option is used to install the package after it successfully builds. You "
"can also use the <link linkend=\"cmdline-no-install\"><option>--no-install</"
"option></link> command line flag."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:854
#, no-c-format
msgid ""
"Related command-line option: --install-after-build, --no-install-after-build"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:859
#, no-c-format
msgid "install-dir"
msgstr ""

#. Tag: filename
#: conf-options-table.docbook:863
#, fuzzy, no-c-format
#| msgid "kdesvn-build"
msgid "~/kde/usr"
msgstr "kdesvn-build"

#. Tag: para
#: conf-options-table.docbook:865
#, no-c-format
msgid ""
"This option controls where to install the module after it is built. If you "
"change this to a directory needing root access, you may want to read about "
"the <link linkend=\"conf-make-install-prefix\">make-install-prefix</link> "
"option as well."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:870
#, no-c-format
msgid ""
"Changing this option for specific module allows you to install it to a "
"different directory than where the &kde; Platform libraries are installed, "
"such as if you were using &kdesrc-build; only to build applications."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:874
#, no-c-format
msgid ""
"You can use <varname>${MODULE}</varname> or <varname>$MODULE</varname> in "
"the path to have them expanded to the module's name."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:876
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-install-dir\"/>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:881
#, no-c-format
msgid "libname"
msgstr ""

#. Tag: member
#: conf-options-table.docbook:885 conf-options-table.docbook:1020
#, no-c-format
msgid "Auto detected"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:887
#, no-c-format
msgid ""
"Set this option to change the default name of the installed library "
"directory inside ${install-dir} and ${qt-install-dir}. On many systems this "
"is either \"lib\" or \"lib64\". Auto-detection is attempted to set the "
"correct name by default, but if the guess is wrong then it can be changed "
"with this setting."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:891
#, no-c-format
msgid "Related command-line option: --libname <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:896
#, no-c-format
msgid "libpath"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:901
#, no-c-format
msgid ""
"Set this option to set the environment variable <envar>LD_LIBRARY_PATH</"
"envar> while building. You cannot override this setting in a module option. "
"The default value is blank, but the paths <filename class=\"directory\">"
"${install-dir}/$<envar>LIBNAME</envar></filename> and <filename class="
"\"directory\">${qt-install-dir}/$<envar>LIBNAME</envar></filename> are "
"automatically added. You may use the tilde (~) for any paths you add using "
"this option."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:907
#, no-c-format
msgid "Related command-line option: --libpath <replaceable>path</replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:912
#, no-c-format
msgid "log-dir"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:917
#, no-c-format
msgid ""
"Use this option to change the directory used to hold the log files generated "
"by the script."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:919
#, no-c-format
msgid "Related command-line option: --log-dir <replaceable>path</replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:924
#, no-c-format
msgid "make-install-prefix"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:929
#, no-c-format
msgid ""
"Set this variable to a space-separated list, which is interpreted as a "
"command and its options to precede the <userinput><command>make</command> "
"<option>install</option></userinput> command used to install modules. This "
"is useful for installing packages with &sudo; for example, but please be "
"careful while dealing with root privileges."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:933
#, no-c-format
msgid ""
"Related command-line option: --make-install-prefix <replaceable>value</"
"replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:938
#, no-c-format
msgid "make-options"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:943
#, no-c-format
msgid ""
"Set this variable in order to pass command line options to the "
"<command>make</command> command. This is useful for programs such as <ulink "
"url=\"https://github.com/distcc/distcc\"><application>distcc</application></"
"ulink> or systems with more than one processor core."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:947
#, no-c-format
msgid ""
"Note that not all supported build systems use <command>make</command>. For "
"build systems that use <command>ninja</command> for build (such as the <link "
"linkend=\"conf-override-build-system\"><application>Meson</application> "
"build system</link>), see the <link linkend=\"conf-ninja-options\">ninja-"
"options</link> setting."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:952
#, no-c-format
msgid ""
"Related command-line option: --make-options <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:957
#, no-c-format
msgid "manual-build"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:963
#, no-c-format
msgid ""
"Set the option value to <userinput>true</userinput> to keep the build "
"process from attempting to build this module. It will still be kept up-to-"
"date when updating from &git;. This option is exactly equivalent to the "
"<link linkend=\"cmdline-no-build\"> <option>--no-build</option> </link> "
"command line option."
msgstr ""

#. Tag: link
#: conf-options-table.docbook:976
#, no-c-format
msgid "manual-update"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:982
#, no-c-format
msgid ""
"Set the option value to <userinput>true</userinput> to keep the build "
"process from attempting to update (and by extension, build or install) this "
"module. If you set this option for a module, then you have essentially "
"commented it out."
msgstr ""

#. Tag: link
#: conf-options-table.docbook:990
#, no-c-format
msgid "ninja-options"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:995
#, no-c-format
msgid ""
"Set this variable in order to pass command line options to the "
"<command>ninja</command> build command. This can be useful to enable "
"<quote>verbose</quote> output or to manually reduce the number of parallel "
"build jobs that <command>ninja</command> would use."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1001
#, no-c-format
msgid ""
"Note that this setting only controls ninja when used by &kdesrc-build;. The "
"&Qt; <quote>webengine</quote> module uses <command>ninja</command> "
"indirectly, but only officially supports being built by <command>make</"
"command>. In this situation, you can set <literal>NINJAFLAGS</literal> as a "
"way to have <command>make</command> pass the appropriate flags when it later "
"calls <command>ninja</command>, by using <link linkend=\"conf-make-options"
"\">make-options</link>."
msgstr ""

#. Tag: programlisting
#: conf-options-table.docbook:1009
#, no-c-format
msgid ""
"options <replaceable>qtwebengine</replaceable>\n"
"    # Restrict make and ninja to using no more than 6 separate compile jobs "
"even\n"
"    # when more CPU is available, to avoid running out of memory\n"
"    <option><link linkend=\"conf-make-options\">make-options</link></option> "
"-j<replaceable>6</replaceable> NINJAFLAGS=-j<replaceable>6</replaceable>\n"
"end options"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1011
#, no-c-format
msgid ""
"Related command-line option: --ninja-options <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1016
#, no-c-format
msgid "override-build-system"
msgstr ""

#. Tag: member
#: conf-options-table.docbook:1021
#, no-c-format
msgid "KDE, Qt, qmake, generic, autotools, meson"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1024
#, no-c-format
msgid ""
"Normally &kdesrc-build; will detect the appropriate build system to use for "
"a module after it is downloaded. This is done by checking for the existence "
"of specific files in the module's source directory."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1028
#, no-c-format
msgid ""
"Some modules may include more than one required set of files, which could "
"confuse the auto-detection. In this case you can manually specify the "
"correct build type."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1031
#, no-c-format
msgid "Currently supported build types that can be set are:"
msgstr ""

#. Tag: term
#: conf-options-table.docbook:1035
#, fuzzy, no-c-format
#| msgid "<keyword>KDE</keyword>"
msgid "<term>KDE</term>"
msgstr "<keyword>KDE</keyword>"

#. Tag: para
#: conf-options-table.docbook:1036
#, no-c-format
msgid ""
"Used to build &kde; modules. In reality it can be used to build almost any "
"module that uses &cmake; but it is best not to rely on this."
msgstr ""

#. Tag: term
#: conf-options-table.docbook:1040
#, no-c-format
msgid "<term>Qt</term>"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1041
#, no-c-format
msgid "Used to build the &Qt; library itself."
msgstr ""

#. Tag: term
#: conf-options-table.docbook:1044
#, no-c-format
msgid "qmake"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1045
#, no-c-format
msgid ""
"Used to build &Qt; modules that use <application>qmake</application>-style "
"<literal>.pro</literal> files."
msgstr ""

#. Tag: term
#: conf-options-table.docbook:1050
#, no-c-format
msgid "generic"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1051
#, no-c-format
msgid ""
"Used to build modules that use plain Makefiles and that do not require any "
"special configuration."
msgstr ""

#. Tag: term
#: conf-options-table.docbook:1055
#, no-c-format
msgid "autotools"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1056
#, no-c-format
msgid ""
"This is the standard configuration tool used for most Free and open-source "
"software not in any of the other categories."
msgstr ""

#. Tag: term
#: conf-options-table.docbook:1060
#, no-c-format
msgid "meson"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1061
#, no-c-format
msgid ""
"This is a <ulink url=\"https://mesonbuild.com\">relatively new tool</ulink> "
"gaining popularity as a replacement for the autotools and may be required "
"for some non-&kde; modules."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1067
#, no-c-format
msgid ""
"Related command-line option: --override-build-system <replaceable>value</"
"replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1072
#, no-c-format
msgid "purge-old-logs"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1078
#, no-c-format
msgid ""
"This option controls whether old log directories are automatically deleted "
"or not."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1080
#, no-c-format
msgid "Related command-line option: --purge-old-logs, --no-purge-old-logs"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1085
#, no-c-format
msgid "qmake-options"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1091
#, no-c-format
msgid ""
"Any options specified here are passed to the <command>qmake</command> "
"command, for modules that use the <symbol>qmake</symbol> build system. For "
"instance, you can use the <userinput>PREFIX=/path/to/qt</userinput> option "
"to qmake to override where it installs the module."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1097
#, no-c-format
msgid ""
"Related command-line option: --qmake-options <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1102
#, no-c-format
msgid "qt-install-dir"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1107
#, no-c-format
msgid ""
"This option controls where to install qt modules after build. If you do not "
"specify this option, &kdesrc-build; will assume that &Qt; is provided by the "
"operating system."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1111
#, no-c-format
msgid ""
"Related command-line option: --qt-install-dir <replaceable>path</replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1116
#, no-c-format
msgid "remove-after-install"
msgstr ""

#. Tag: member
#: conf-options-table.docbook:1120
#, no-c-format
msgid "none, builddir, all"
msgstr ""

#. Tag: member
#: conf-options-table.docbook:1121
#, no-c-format
msgid "none"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1123
#, no-c-format
msgid ""
"If you are low on hard disk space, you may want to use this option in order "
"to automatically delete the build directory (or both the source and build "
"directories for one-time installs) after the module is successfully "
"installed."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1128
#, no-c-format
msgid "Possible values for this option are:"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1130
#, no-c-format
msgid "none - Do not delete anything."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1131
#, no-c-format
msgid "builddir - Delete the build directory, but not the source."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1132
#, no-c-format
msgid "all - Delete both the source code and build directory."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1136
#, no-c-format
msgid ""
"Note that using this option can have a significant detrimental impact on "
"both your bandwidth usage (if you use <replaceable>all</replaceable>) and "
"the time taken to compile &kde; software, since &kdesrc-build; will be "
"unable to perform incremental builds."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1139
#, no-c-format
msgid ""
"Related command-line option: --remove-after-install <replaceable>value</"
"replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1144
#, no-c-format
msgid "repository"
msgstr ""

#. Tag: member
#: conf-options-table.docbook:1148
#, no-c-format
msgid "1.10"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1150
#, no-c-format
msgid ""
"This option is used to specify the &git; repository to download the source "
"code for the module. &Qt; (and therefore qt) would need this option, as well "
"as various &kde; modules that are in the process of conversion to use &git;."
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1157
#, no-c-format
msgid "revision"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1163
#, no-c-format
msgid ""
"If this option is set to a value other than 0 (zero), &kdesrc-build; will "
"force the source update to bring the module to the exact revision given, "
"even if options like <link linkend=\"conf-branch\">branch</link> are in "
"effect. If the module is already at the given revision then it will not be "
"updated further unless this option is changed or removed from the "
"configuration."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1169
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-revision\"/>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1174
#, no-c-format
msgid "run-tests"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1180
#, no-c-format
msgid ""
"If set to <userinput>true</userinput>, then the module will be built with "
"support for running its test suite, and the test suite will be executed as "
"part of the build process. &kdesrc-build; will show a simple report of the "
"test results. This is useful for developers or those who want to ensure "
"their system is setup correctly."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1185
#, no-c-format
msgid "Related command-line option: --run-tests, --no-run-tests"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1190
#, no-c-format
msgid "set-env"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1195
#, no-c-format
msgid ""
"This option accepts a space-separated set of values, where the first value "
"is the environment variable to set, and the rest of the values is what you "
"want the variable set to. For example, to set the variable <envar>RONALD</"
"envar> to McDonald, you would put in the appropriate section this command:"
msgstr ""

#. Tag: programlisting
#: conf-options-table.docbook:1199
#, no-c-format
msgid ""
"<command>set-env</command> <envar>RONALD</envar> <userinput>McDonald</"
"userinput>"
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1200
#, no-c-format
msgid ""
"This option is special in that it can be repeated without overriding earlier "
"set-env settings in the same section of the <link linkend=\"configure-data"
"\">configuration file</link>. This way you can set more than one environment "
"variable per module (or globally)."
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1208
#, no-c-format
msgid "source-dir"
msgstr ""

#. Tag: filename
#: conf-options-table.docbook:1212
#, fuzzy, no-c-format
#| msgid "kdesvn-build"
msgid "~/kde/src"
msgstr "kdesvn-build"

#. Tag: para
#: conf-options-table.docbook:1214
#, no-c-format
msgid ""
"This option is used to set the directory on your computer to store the &kde; "
"&git; sources at. You may use the tilde (~) to represent the home directory "
"if using this option."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:1217
#, no-c-format
msgid ""
"Related command-line option: --source-dir <replaceable>path</replaceable>"
msgstr ""

#. Tag: link
#: conf-options-table.docbook:1222
#, no-c-format
msgid "stop-on-failure"
