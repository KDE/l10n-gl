#. Tag: para
#: conf-options-table.docbook:264
#, no-c-format
msgid ""
"This option is defined by &kdesrc-build; (when using <command>kdesrc-build --"
"generate-config</command>), set to be the number of CPUs that is deemed safe "
"for heavyweight or other highly-intensive modules, such as "
"<literal>qtwebengine</literal>, to avoid running out of memory during the "
"build."
msgstr ""

#. Tag: para
#: conf-options-table.docbook:269
