#. Tag: para
#: using-mainwindow.docbook:349
#, no-c-format
msgid "The Album Properties dialog allows you to set:"
msgstr "O diálogo Propiedades do álbum permite configurar:"

#. Tag: title
#: using-mainwindow.docbook:352
#, no-c-format
msgid "The Album Properties Dialog"
msgstr "O diálogo Propiedades do álbum"

#. Tag: para
#: using-mainwindow.docbook:358
#, no-c-format
msgid ""
"The Album <guilabel>Title</guilabel> : Name of the Album, identical with the "
"name of the folder on your hard disk. If you edit it here, the folder will "
