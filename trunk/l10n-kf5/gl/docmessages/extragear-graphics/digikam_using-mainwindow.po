#. Tag: title
#: using-mainwindow.docbook:378
#, no-c-format
msgid "Setting the Album Icon"
msgstr "Configuración da icona do álbum"

#. Tag: para
#: using-mainwindow.docbook:380
#, no-c-format
msgid ""
"&digikam; displays the usual folder icon in the <quote>Albums</quote> list. "
