"\n"
"&hellip;\n"
"\n"
"module-set <replaceable>big-module-set</replaceable>\n"
"    repository kde-projects\n"
"    use-modules <replaceable>calligra</replaceable>\n"
"    make-options -j2 # Reduced number of build jobs for just these modules\n"
"end module-set"
msgstr ""

#. Tag: para
#: index.docbook:503
