msgstr "Hai varios xeitos de modificar o visor ao seu gusto."

#. Tag: primary
#: config.docbook:1362 config.docbook:1363
#, no-c-format
msgid "Info Boxes"
msgstr "Paneis informativos"

#. Tag: secondary
