#. Tag: title
#: man-kcookiejar5.8.docbook:57
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-kcookiejar5.8.docbook:59
#, fuzzy, no-c-format
#| msgid ""
#| "<command>kcookiejar4</command> handles the HTTP cookies providing a D-BUS "
#| "service to store/retrieve/clean cookies."
msgid ""
"<command>kcookiejar5</command> is a command line interface to the HTTP "
"cookie store used by KDE, a D-BUS service to store/retrieve/clean cookies."
msgstr ""
"<command>kcookiejar4</command> xestiona as cookies HTTP e fornece un servizo "
"D-BUS para almacenar, recuperar e limpar cookies."

