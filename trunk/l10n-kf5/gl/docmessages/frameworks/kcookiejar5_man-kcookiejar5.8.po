#. Tag: title
#: man-kcookiejar5.8.docbook:122
#, no-c-format
msgid "Usage"
msgstr "Utilización"

#. Tag: para
#: man-kcookiejar5.8.docbook:123
#, no-c-format
msgid ""
"<command>kcookiejar5</command> is a command line tool to access the kded "
"module which manages cookies in <command>Konqueror</command> and other KDE "
"applications."
msgstr ""

#. Tag: para
#: man-kcookiejar5.8.docbook:124
#, no-c-format
msgid ""
"When started without parameters it loads the kded module to provide the dbus "
"interface to store cookies."
msgstr ""

#. Tag: para
#: man-kcookiejar5.8.docbook:127
#, fuzzy, no-c-format
#| msgid ""
#| "When <command>kcookiejar4</command> is started with some parameters, it "
#| "does additional tasks to the cookies jar it provides, like removing the "
#| "cookies from one <parameter>domain</parameter>."
msgid ""
"When <command>kcookiejar5</command> is started with some parameters, it does "
"additional tasks to the cookies jar it provides, like removing the cookies "
"from one <parameter>domain</parameter>."
msgstr ""
"Cando <command>kcookiejar4</command> se arranca con algún parámetro, fai "
"traballos adicionais nos almacéns que fornece, como eliminar as cookies dun "
"<parameter>dominio</parameter>."

