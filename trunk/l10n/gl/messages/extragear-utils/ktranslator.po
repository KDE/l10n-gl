msgid ""
"Enter the word to be searched here and click in \"Translate\" to translate the "
"word"
msgstr ""
"Indique aqui a palabra a procurar e prema en \"Traducir\" para traduci-la"

#: ktranslator.cpp:104
msgid "Translate"
