msgstr "Non pechar este diálogo após \"Conectar\""

#: main.cpp:47
msgid "KDE Secure Shell "
msgstr "Liña de Comandos Segura de KDE"

#: kssh.cpp:163
msgid "Hide options"
msgstr "Esconder opzóns"

#: kssh.cpp:168 ksshdialog.cpp:505
msgid "Show options"
msgstr "Mostrar opzóns"

#: kssh.cpp:179
msgid "Less..."
msgstr "Menos..."

#: kssh.cpp:184
msgid "More.."
msgstr "Mais.."

#: kssh.cpp:1337
msgid "Hosts:"
msgstr "Máquinas:"

#: kssh.cpp:1351
msgid "User list for %1:"
msgstr "Lista de usuários de %1:"

#: ksshdialog.cpp:44
msgid "kssh"
msgstr "kssh"

#: ksshdialog.cpp:49
msgid "SSH options:"
msgstr "Opzóns de SSH:"

#: ksshdialog.cpp:57
msgid "non privileged port (-P)"
msgstr "porto non privilexiado (-P)"

#: ksshdialog.cpp:58
msgid ""
"<qt><b> -P</b>"
"<br>      Use a non-privileged port for outgoing connections.  This can be used "
"if a firewall does not permit connections from privileged\n"
" ports.  Note that this option turns off <i>RhostsAuthentication</i> and\n"
"<i>RhostsRSAAuthentication</i> for older servers.</qt>"
msgstr ""
"<qt><b> -P</b>"
"<br>      Utiliza un porto non-privilexiado para as conexóns saintes. Isto pode "
"ser usado se un cortalumes non permite as conexóns polos portos privilexiados. "
"Lembre que esta opzón desabilita <i>RhostsAuthentication</i> e <i>"
"RhostsRSAAuthentication</i> nos servidores mais antigos.</qt>"

#: ksshdialog.cpp:67
msgid "Specifiy port (-p nn):"
msgstr "Escoller o porto (-p nn):"

#: ksshdialog.cpp:68 ksshdialog.cpp:77
msgid ""
"<qt><b> -p port</b>"
"<br>\n"
" Port to connect to on the remote host.  This can be specified on  a per-host "
"basis in the configuration file.</qt>"
msgstr ""
"<qt><b> -p porto</b>"
"<br>\n"
"O porto ao cal se conecta na máquina remota. Isto pode ser especificado para "
"cada máquina no ficheiro de configurazón.</qt>"

#: ksshdialog.cpp:86
msgid "Forward local (-L p:h:p):"
msgstr "Reencamiñamento local (-L p:h:p):"

#: ksshdialog.cpp:87 ksshdialog.cpp:100
msgid ""
"<qt><b>-L port:host:hostport</b>"
"<br>\n"
"Specifies that the given port on the local (client) host is to be\n"
"forwarded to the given host and port on the remote side.  This\n"
"works by allocating a socket to listen to port on the local side,\n"
"and whenever a connection is made to this port, the connection is\n"
"forwarded over the secure channel, and a connection is made to\n"
"host port hostport from the remote machine.  Port forwardings can\n"
"also be specified in the configuration file.  Only root can for­\n"
"ward privileged ports.  IPv6 addresses can be specified with an\n"
"alternative syntax: port/host/hostport</qt>"
msgstr ""
"<qt><b>-L porto:maquina:portomaquina</b>"
"<br>\n"
"Indica que o porto indicado na máquina local (o cliente) deberá ser\n"
"reencamiñado para a máquina e porto indicados no lado remoto.\n"
"Isto fai-se reservando un socket para escoitar o porto no lado local,\n"
"e sempre que é feita unha conexón a este porto,\n"
"reencamiña-se polo canal seguro, e fai-se unha conexón ao\n"
"porto portomaquina da máquina. Os reencamiñamentos de portos\n"
"tamén poden ser indicados no ficheiro de configurazón. Só root\n"
"poderá reencamiñar os portos privilexiados. Os enderezos IPv6 poden\n"
"ser especificados con outra sintaxe: porto/máquina/máquinaporto</qt>"

#: ksshdialog.cpp:117
msgid "Forward Remote (-R p:h:p):"
msgstr "Reencamiñamento Remoto (-R p:h:p):"

#: ksshdialog.cpp:118 ksshdialog.cpp:126
msgid ""
"<qt><b>-R port:host:hostport</b>"
"<br>\n"
"Specifies that the given port on the remote (server) host is to\n"
"be forwarded to the given host and port on the local side.  This\n"
"works by allocating a socket to listen to port on the remote\n"
"side, and whenever a connection is made to this port, the connection is "
"forwarded over the secure channel, and a connection is made to host port "
"hostport from the local machine.  Port forward­ings can also be specified in "
"the configuration file.  Privileged ports can be forwarded only when logging in "
"as root on the remote      machine.  IPv6 addresses can be specified with an "
"alternative            syntax: port/host/hostport</qt>"
msgstr ""
"<qt><b>-R porto:maquina:portomaquina</b>"
"<br>\n"
"Indica que o porto dado na máquina remota (o servidor) deberá ser\n"
"reencamiñado para a máquina e porto indicados do cliente.\n"
"Isto fai-se reservando un socket para escoitar o porto no lado remoto\n"
"e, sempre que se fai unha conexón a este porto, será reencamiñada\n"
"polo canal seguro,  e fai-se unha conexón a porto portomáquina desde\n"
"a máquina cliente. Os reencamiñamentos de portos tamén poden ser\n"
"indicados no ficheiro de configurazón. Os portos privilexiados só poderan\n"
"ser reencamiñados no servidor por root. Os enderezos de IPv6 poden ser "
"especificados\n"
"cunha sintaxe alternativa: porto/máquina/máquinaporto</qt>"

#: ksshdialog.cpp:138
msgid "Try to use ssh1 (-1) "
msgstr "Tentar utilizar ssh1 (-1) "

#: ksshdialog.cpp:139
msgid "<qt><b>-1</b><br>      Forces ssh to try protocol version 1 only.</qt>"
msgstr ""
"<qt><b>-1</b>"
"<br>      Obriga a ssh a tentar só coa versión 1 do protocolo.</qt>"

#: ksshdialog.cpp:143
msgid "Try to use ssh2 (-2) "
msgstr "Tentar utilizar ssh2 (-2) "

#: ksshdialog.cpp:144
msgid "<qt><b>-2</b><br>      Forces ssh to try protocol version 2 only.</qt>"
msgstr ""
"<qt><b>-2</b>"
"<br>   Obriga a ssh a tentar só a versión 2 do protocolo.</qt>"

#: ksshdialog.cpp:152
msgid "Enable X11 (-X)"
msgstr "Activar X11 (-X) "

#: ksshdialog.cpp:153
msgid ""
"<qt><b>-X</b>"
"<br> Enables X11 forwarding.  This can also be specified on a per-host basis in "
"a configuration file.</qt>"
msgstr ""
"<qt><b>-X</b>"
"<br> Activa o reencamiñamento das X11. Isto tamén pode ser configurado para "
"cada máquina nun ficheiro de configurazón.</qt>"

#: ksshdialog.cpp:158
msgid "Disable X11 (-x)"
msgstr "Desactivar X11 (-x)"

#: ksshdialog.cpp:159
msgid "<qt><b>  -x</b><br>      Disables X11 forwarding.</qt>"
msgstr "<qt><b>  -x</b><br>      Desactiva o reencamiñamento das X11.</qt>"

#: ksshdialog.cpp:167
msgid "Cipher to use (-c cipher):"
msgstr "Cifraxe a utilizar (-c cifraxe):"

#: ksshdialog.cpp:168
msgid ""
"<qt><b>-c blowfish|3des|des</b>"
"<br>        Selects the cipher to use for encrypting the session.  3des is used "
"by default.  It is believed to be secure.  3des (triple-des) is an "
"encrypt-decrypt-encrypt triple with three different keys. blowfish is a fast "
"block cipher, it appears very secure and is much faster than 3des.  des is only "
"supported in the ssh client for interoperability with legacy protocol 1 "
"implementations that\n"
"do not support the 3des cipher.  Its use is strongly discouraged\n"
"due to cryptographic weaknesses.</qt>"
msgstr ""
"<qt><b>-c blowfish|3des|des</b>"
"<br>        Escolle a forma de cifrar a sesión. O 3des é usado por defeito. É "
"considerado seguro. O 3des (triple-des) é un triple cifrado-decifrado-cifrado "
"con tres chaves diferentes. Blowfish é un cifrador de blocos rápido, parece ser "
"seguro e é moito mais rápido que 3des. Des só é soportado para interoperar coas "
"implementazóns antigas do protocolo 1 que non soporten a codificazón 3des. "
"Recomenda-se que non se use debido ás suas fraquezas criptográficas.</qt>"

#: ksshdialog.cpp:174
msgid "3des"
msgstr "3des"

#: ksshdialog.cpp:175
msgid "blowfish"
msgstr "blowfish"

#: ksshdialog.cpp:176
msgid "des"
msgstr "des"

#: ksshdialog.cpp:183
msgid "Compression of all data (-C)"
msgstr "Compresión de todos os dados (-C)"

#: ksshdialog.cpp:184
msgid ""
"<qt><b> -C</b>"
"<br>      Requests compression of all data (including stdin, stdout,\n"
"stderr, and data for forwarded X11 and TCP/IP connections).  The\n"
"compression algorithm is the same used by gzip, and the\n"
"``level'' can be controlled by the CompressionLevel option (see\n"
"man:/ssh).  Compression is desirable on modem lines and other slow\n"
"connections, but will only slow down things on fast networks. The default value "
"can be set on a host-by-host basis in the configuration files; see the "
"Compression option in man:/ssh."
msgstr ""
"<qt><b> -C</b>"
"<br>      Pede a compresión de todos os dados (incluindo \n"
"stdin, stdout, stderr, e os dados para conexóns reencamiñadas das\n"
"X11 e de TCP/IP). O algoritmo de compresión é o mesmo usado por gzip e o\n"
"\"nível\" pode ser controlado coa opzón CompressionLevel (consulte\n"
"man:/ssh).  Recomenda-se comprimir se usa liñas de modem ou outras\n"
"conexóns lentas, pero é un atraso para redes rápidas. O valor\n"
"por omisión pode ser predefinido para cada máquina nos ficheiros de\n"
"configurazón; vexa a opzón Compresión en man:/ssh."

#: ksshdialog.cpp:196
msgid "Save as default configuration"
msgstr "Guardar como configurazón por defeito"

#: ksshdialog.cpp:200
msgid "More..."
msgstr "Mais..."

#: ksshdialog.cpp:206
msgid "Save this connection"
msgstr "Guardar esta conexón"

#: ksshdialog.cpp:212
msgid "About kssh..."
msgstr "Acerca de kssh..."

#: ksshdialog.cpp:229
msgid "Execute command:"
msgstr "Executar comando:"

#: ksshdialog.cpp:236
msgid "Force IPv4 (-4)"
msgstr "Forzar IPv4 (-4)"

#: ksshdialog.cpp:237
msgid "<qt><b> -4</b><br>  Forces ssh to use IPv4 addresses only.</qt>"
msgstr "<qt><b> -4</b><br>  Obriga a ssh a usar só enderezos de IPv4.</qt>"

#: ksshdialog.cpp:241
msgid "Force IPv6 (-6)"
msgstr "Forzar IPv6 (-6)"

#: ksshdialog.cpp:242
msgid "<qt><b> -6</b><br>  Forces ssh to use IPv6 addresses only.</qt>"
msgstr "<qt><b> -6</b><br>  Obriga a ssh a usar só enderezos de IPv6.</qt>"

#: ksshdialog.cpp:248
msgid "Disable auth agent forwarding (-a)"
msgstr "Desactivar o encamiñamento do axente de autenticazón (-a)"

#: ksshdialog.cpp:249
msgid ""
"<qt><b>-a</b>"
"<br>      Disables forwarding of the authentication agent connection.</qt>"
msgstr ""
"<qt><b>-a</b>"
"<br>      Desactiva o reencamiñamento da conexón do axente de autenticazón.</qt>"

#: ksshdialog.cpp:256
msgid "Config file (-F):"
msgstr "Ficheiro de configurazón (-F):"

#: ksshdialog.cpp:257
msgid ""
"<qt><b> -F configfile</b>"
"<br>     Specifies an alternative per-user configuration file.  If a "
"configuration file is given on the command line, the system-wide\n"
"configuration file (/etc/ssh/ssh_config) will be ignored.  The\n"
"default for the per-user configuration file is $HOME/.ssh/config.</qt>"
msgstr ""
"<qt><b> -F ficheiro_config</b>"
"<br>     Indica un ficheiro de configurazón alternativo para o usuário. Cando "
"se indica un ficheiro de configurazón na liña de comandos, o ficheiro de "
"configurazón do sistema (/etc/ssh/ssh_config) é ignorado. Por omisión, o "
"ficheiro de configurazón do usuário é $HOME/.ssh/config.</qt>"

#: ksshdialog.cpp:276
msgid "Bind address (-b address):"
msgstr "Enderezo a usar(-b enderezo):"

#: ksshdialog.cpp:277 ksshdialog.cpp:281
msgid ""
"<qt><b>-b bind_address</b> "
"<br>Specify the interface to transmit from on machines with multiple interfaces "
"or aliased addresses.</qt>"
msgstr ""
"<qt><b>-b enderezo</b> "
"<br>Indica a interface pola cal transmitir, no caso de máquinas con várias "
"interfaces ou con enderezos alternativos.</qt>"

#: ksshdialog.cpp:289
msgid "Cipher to use (-c list):"
msgstr "Cifraxe a usar (-c lista):"

#: ksshdialog.cpp:290 ksshdialog.cpp:294
msgid ""
"<qt><b>-c cipher_spec</b>"
"<br>   Additionally, for protocol version 2 a comma-separated list of ciphers "
"can be specified in order of preference. See man:/ssh, Ciphers dor more "
"info.</qt>"
msgstr ""
"<qt><b>-c cipher_spec</b>"
"<br>   Adicionalmente, para o protocolo versión 2, pode ser indicada unha lista "
"separada por vírgulas de cifraxes por orde de preferéncia. Vexa man:/ssh, "
"\"Ciphers\", para mais informazóns.</qt>"

#: ksshdialog.cpp:302
msgid "Escape character (-e):"
msgstr "Carácter de escape (-e):"

#: ksshdialog.cpp:303 ksshdialog.cpp:307 ksshdialog.cpp:411
msgid ""
"<qt><b> -e ch|^ch|none  </b> "
"<br>   Sets the escape character for sessions with a pty (default: `~').The "
"escape character is only recognized at the beginning of a line.  The escape "
"character followed by a dot (`.') closes the connection, followed by control-Z "
"suspends the connection, and followed by itself sends the escape character "
"once.  Setting the character to ``none'' disables any escapes and makes the "
"session fully transparent.</qt>"
msgstr ""
"<qt><b> -e ch|^ch|none  </b> "
"<br>   Define o carácter de escape para as sesións cun pty (por omisión: `~'). "
"O carácter de escape só é recoñecido no início dunha liña. O carácter de "
"escape, seguido dun ponto, fecha a conexón; se vai seguido dun control-Z "
"suspende a conexón; se vai seguido del mesmo envia o carácter de escape unha "
"vez. Se configura o carácter como \"none\" desactiva o escape e converte á "
"sesión en completamente transparente.</qt>"

#: ksshdialog.cpp:315
msgid "Mac spec (-m):"
msgstr "Espec. de MAC (-m):"

#: ksshdialog.cpp:316 ksshdialog.cpp:320
msgid ""
"<qt><b>-m mac_spec</b>"
"<br>Additionally, for protocol version 2 a comma-separated list of MAC (message "
"authentication code) algorithms can be specified in  order of preference.  See "
"<a href=\"man:/ssh\">man:/ssh</a>, MACs keyword for more information.</qt>"
msgstr ""
"<qt><b>-m mac_spec</b>"
"<br>Adicionalmente, para o protocolo versión 2, pode indicar unha lista "
"separada por vírgulas de algoritmos de MAC (message authentication code) por "
"orde de preferéncia. Consulte <a href=\"man:/ssh\">man:/ssh</a> "
"coa palabra-chave MAC para mais informazón.</qt>"

#: ksshdialog.cpp:329
msgid "Verbose (-v,-vv,-vvv):"
msgstr "Descritivo (-v,-vv,-vvv):"

#: ksshdialog.cpp:330
msgid ""
" <qt><b>-v</b>"
"<br>      Verbose mode.  Causes ssh to print debugging messages about its "
"progress.  This is helpful in debugging connection, authentica­tion, and "
"configuration problems. Verbosity level \n"
"could be configured from 1 to 3 (3 is the maximum).</qt>"
msgstr ""
" <qt><b>-v</b>"
"<br>      Modo descritivo. Fai que ssh imprima mensaxes de depurazón acerca do "
"seu progreso. Isto é útil para depurar a conexón, a autenticazón e problemas de "
"configurazón. O nível de descrizón pode ser axustado entre 1 e 3 (o 3 é o "
"máximo).</qt>"

#: ksshdialog.cpp:338
msgid ""
"<qt>Verbosity level. 1=minimum, 2=medium,3=maximum (It means -v,-vv,-vvv on ssh "
"command line)</qt>"
msgstr ""
"<qt>Nível descritivo. 1=mínimo, 2=médio,3=máximo (isto corresponde a "
"-v,-vv,-vvv na liña de comandos de ssh)</qt>"

#: ksshdialog.cpp:346
msgid "Disbale TTY (-T)"
msgstr "Desactivar TTY (-T)"

#: ksshdialog.cpp:347
msgid "<qt><b>-T</b><br>      Disable pseudo-tty allocation.</qt>"
msgstr "<qt><b>-T</b><br>      Desactiva a reserva dun pseudo-TTY.</qt>"

#: ksshdialog.cpp:351
msgid "Force TTY (-t)"
msgstr "Forza TTY (-t)"

#: ksshdialog.cpp:352
msgid ""
"<qt><b>-t</b>"
"<br>Force pseudo-tty allocation.  This can be used to execute arbitrary "
"screen-based programs on a remote machine, which can be\n"
"very useful, e.g., when implementing menu services.  Multiple -t options force "
"tty allocation, even if ssh has no local tty.</qt>"
msgstr ""
"<qt><b>-t</b>"
"<br>Forza a reserva dun pseudo-TTY. Isto pode ser usado para executar "
"arbitrariamente programas baseados na pantalla nunha máquina remota, o que pode "
"ser útil, por exemplo, para implementar servizos de menu. Várias opzóns -t "
"forzan a reserva dun TTY, mesmo se ssh non ten un TTY local.</qt>"

#: ksshdialog.cpp:359
msgid "Subsystem (-s)"
msgstr "Subsistema (-s)"

#: ksshdialog.cpp:360
msgid ""
"<qt><b> -s</b>"
"<br>      May be used to request invocation of a subsystem on the remote "
"system. Subsystems are a feature of the SSH2 protocol which\n"
"facilitate the use of SSH as a secure transport for other applications (<i>"
"eg. sftp</i>). The subsystem is specified as the remote command.</qt>"
msgstr ""
"<qt><b> -s</b>"
"<br>      Pode ser usado para pedir a invocazón dun sub-sistema no sistema "
"remoto. Os sub-sistemas son unha funcionalidade do protocolo SSH2 que facilitan "
"o uso de SSH como un transporte seguro para outras aplicazóns (<i>"
"p.ex., o sftp</i>). O sub-sistema é especificado como o comando remoto.</qt>"

#: ksshdialog.cpp:368
msgid "More option (-o):"
msgstr "Mais opzóns (-o):"

#: ksshdialog.cpp:369 ksshdialog.cpp:373
msgid ""
"<qt><b>-o option</b>"
"<br>Can be used to give options in the format used in the configuration file.  "
"This is useful for specifying options for which there is no separate "
"command-line flag.</qt>"
msgstr ""
"<qt><b>-o opzón</b>"
"<br>Pode ser usado para dar opzóns no formato usado no ficheiro de "
"configurazón. Isto é útil para especificar opzóns para as cais non existe unha "
"opzón na liña de comandos.</qt>"

#: ksshdialog.cpp:379
msgid "Redirect stdin from /dev/null (-n)"
msgstr "Redireccionar stdin desde /dev/null (-n)"

#: ksshdialog.cpp:380
msgid ""
"<qt><b>-n</b> "
"<br>Redirects stdin from <tt>/dev/null</tt> (actually, prevents reading from "
"stdin).  This must be used when ssh is run in the background.  A common trick "
"is to use this to run X11 programs on a remote machine.  For example, ssh -n "
"shadows.cs.hut.fi emacs & will start an emacs on shadows.cs.hut.fi, and the X11 "
"connection will be automatically forwarded over an encrypted channel.  The ssh  "
"program will be put in the background.  (This does not work if ssh needs to ask "
"for a password or passphrase; see also the -f option.)</qt>"
msgstr ""
"<qt><b>-n</b> "
"<br>Redirecciona stdin desde <tt>/dev/null</tt> (de feito, impede a leitura de "
"stdin).  Isto debe ser usado cando ssh é executado en segundo plano. Un truco "
"comun é usar isto para executar programas das X11 nunha máquina remota. Por "
"exemplo, ssh -n shadows.cs.hut.fi emacs & iniciará emacs en shadows.cs.hut.fi; "
"e a conexón coas X11 será automaticamente encamiñada por un canal cifrado. O "
"programa ssh será colocado en segundo plano. (Isto non funciona se ssh necesita "
"perguntar un contrasinal; vexa tamén a opzón -f.)</qt>"

#: ksshdialog.cpp:387
msgid "SmartCard device (-I):"
msgstr "Dispositivo SmartCard (-I):"

#: ksshdialog.cpp:388 ksshdialog.cpp:392
msgid ""
"<qt><b>-I smartcard_device</b>"
"<br> Specifies which smartcard device to use. The argument is the device ssh "
"should use to communicate with a smartcard used for storing the user's private "
"RSA key.</qt>"
msgstr ""
"<qt><b>-I dispositivo_smartcard</b>"
"<br> Indica que dispositivo smartcard usar. O argumento é o dispositivo que ssh "
"debe usar para comunicar cunha smartcard usada para guardar a chave privada de "
"RSA do usuário.</qt>"

#: ksshdialog.cpp:398
msgid "Disable Kerberos forwarding (-k)"
msgstr "Desactivar o reencamiñamento de Kerberos (-k)"

#: ksshdialog.cpp:399
msgid ""
"<qt><b> -k</b>"
"<br>Disables forwarding of Kerberos tickets and AFS tokens.  This may also be "
"specified on a per-host basis in the configuration file.</qt>"
msgstr ""
"<qt><b> -k</b>"
"<br>Desactiva o reencamiñamento dos tickets de Kerberos e dos testemuños de "
"AFS. Isto tamén pode ser especificado para cada máquina no ficheiro de "
"configurazón.</qt>"

#: ksshdialog.cpp:406
msgid "Identity file (-i):"
msgstr "Ficheiro de identidade (-i):"

#: ksshdialog.cpp:407
msgid ""
"<qt><b>-i identity_file</b>"
"<br>Selects a file from which the identity (private key) for  <i>RSA</i> or <i>"
"DSA</i> authentication is read.  The default is $HOME/.ssh/identity for "
"protocol version 1, and $HOME/.ssh/id_rsa and $HOME/.ssh/id_dsa for protocol "
"version 2.  Identity files may also be specified on a per-host basis in the "
"configuration file. It is possible to have multiple -i options (and multiple "
"identities specified in configuration files).</qt>"
msgstr ""
"<qt><b>-i ficheiro_identidade</b>"
"<br>Escolle un ficheiro do cal se le a identidade (chave privada) para a "
"autenticazón <i>RSA</i> ou <i>DSA</i>. Por omisión é de $HOME/.ssh/identity "
"para a versión 1 do protocolo e de $HOME/.ssh/id_rsa e $HOME/.ssh/id_dsa para a "
"versión 2 do mesmo protocolo. Os ficheiros de identidade tamén poden ser "
"definidos para cada máquina no ficheiro de configurazón. É posíbel ter várias "
"opzóns -i (e várias identidades especificadas nos ficheiros de "
"configurazón).</qt>"

#: ksshdialog.cpp:417
msgid "Allow remote connection (-g)"
msgstr "Permitir conexóns remotas (-g)"

#: ksshdialog.cpp:418
msgid ""
"<qt><b> -g</b>"
"<br>      Allows remote hosts to connect to local forwarded ports.</qt>"
msgstr ""
"<qt><b> -g</b>"
"<br>      Permite ás máquinas remotas conectaren-se a portos reencamiñados "
"localmente.</qt>"

#: ksshdialog.cpp:423
msgid "Quiet mode (-q)"
msgstr "Modo silencioso (-q)"

#: ksshdialog.cpp:424
msgid ""
"<qt><b> -q</b>"
"<br> Quiet mode.  Causes all warning and diagnostic messages to be "
"suppressed.</qt>"
msgstr ""
"<qt><b> -q</b>"
"<br> Modo silencioso. Suprime todas as mensaxes de aviso e de diagnóstico .</qt>"

#: ksshdialog.cpp:429
msgid "Do not execute command (-N)"
msgstr "Non executar o comando (-N)"

#: ksshdialog.cpp:430
msgid ""
"<qt><b> -N</b>"
"<br>      Do not execute a remote command.  This is useful for just forwarding "
"ports (protocol version 2 only).</qt>"
msgstr ""
"<qt><b> -N</b>"
"<br>      Non executar nengun comando remoto. Isto é útil para limitar-se a "
"reencamiñar os portos (só na versión 2 do protocolo).</qt>"

#: ksshdialog.cpp:435
msgid "Go in background (-f)"
msgstr "Executar en segundo plano (-f)"

#: ksshdialog.cpp:436
msgid ""
"<qt><b> -f  </b>"
"<br>    Requests ssh to go to background just before command execution. This is "
"useful if ssh is going to ask for passwords or\n"
"passphrases, but the user wants it in the background.  This\n"
"implies -n.  The recommended way to start X11 programs at a\n"
"remote site is with something like"
"<br> <tt>ssh -f host xterm</tt>.</qt>"
msgstr ""
"<qt><b> -f  </b>"
"<br>    Pede-lle a ssh que pase a segundo plano xusto antes da execuzón do "
"comando. Isto é útil se ssh vai pedir contrasinais pero o usuário o quere en "
"segundo plano. Isto implica -n. A forma recomendada de iniciar os programas das "
"X11 nunha máquina remota é con algo do xénero\n"
"<br> <tt>ssh -f maquina xtern</tt>.</qt>"

#: ksshdialog.cpp:446
msgid "Enable auth agent forwarding (-A)"
msgstr "Activar reencamiñamento do axente de autenticazón (-A)"

#: ksshdialog.cpp:447
msgid ""
"<qt><b>-A</b>"
"<br>      Enables forwarding of the authentication agent connection. This can "
"also be specified on a per-host basis in a configuration file.</qt>"
msgstr ""
"<qt><b>-A</b>"
"<br>      Activa o reencamiñamento da conexón do axente de autenticazón. Isto "
"tamén pode ser especificado para cada máquina nun ficheiro de configurazón.</qt>"

