msgid ""
"Your X-Server can slow down, if KWebGet produces to much Output-Messages\n"
"and your system has a high load, or is not the fastest."
msgstr ""
"O seu servidor X pode tornar-se lento se KWebGet produce demasiadas "
"mensaxes de saída e o seu sistema tivese unha carga grande ou non é moi "
"potente."

#: wizard/wizpage5.cpp:69
msgid "Disable Output Messages"
msgstr "Desactivar as Mensaxes de Saída"

#: wizard/wizpage4.cpp:39
