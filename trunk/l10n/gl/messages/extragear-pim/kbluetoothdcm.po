#: kcm_kbluetoothd.cpp:57
msgid ""
"<p>Cannot access the KDE Bluetooth Daemon (kbluetoothd).<br/>\n"
" You have to start it before using this configuration page.</p>"
msgstr ""
"<p>Non foi posíbel aceder ao Servidor Bluetooth de KDE (kbluetoothd)."
"<br/>\n"
"Debe iniciá-lo antes de utilizar esta páxina de configurazón.</p>"

#: kcm_kbluetoothd.cpp:109
msgid ""
"<h1>KBluetoothD</h1>This module configures kbluetoothd, the meta server of "
"the KDE Bluetooth Framework. It manages Bluetooth services offered by your "
"system and can launch programs when Bluetooth devices were detected."
msgstr ""
"<h1>KBluetoothD</h1>Este módulo configura kbluetoothd, o meta servidor da "
"Infra-estrutura Bluetooth de KDE. Xestiona os servizos Bluetooth oferecidos polo "
"seu sistema e pode lanzar programas cando son detectados dispositivos "
"Bluetooth."

#: pageddeviceswidget.cpp:63
