#. i18n: file kcm_btpaired/exportdialog.ui line 16
#: rc.cpp:3
#, no-c-format
msgid "Export Link Keys"
msgstr "Exportar Chaves de Conexón"

#. i18n: file kcm_btpaired/exportdialog.ui line 35
#: rc.cpp:6
#, no-c-format
msgid ""
"Pairing a device in a dual boot setup breaks an alreay established pairing "
"in the other operating system, because the link keys stored by each OS are "
"not identical. Here you can export BlueZ's keys for use with Windows, so "
"that you don't have to pair devices again each time you switch the OS."
msgstr ""
"Emparellar un dispositivo nunha configurazón de arranque dual romperá un "
"emparellamente xa estabelecido co outro sistema operativo, dado que as chaves "
"da conexón guardadas por cada sistema non serán idénticas. Aqui pode exportar "
"as suas chaver BlueZ para seren usadas con Windows, e que non teña que "
"emparellar os dispositivos cada vez que cámbie de sistema operativo."

#. i18n: file kcm_btpaired/exportdialog.ui line 46
#: rc.cpp:9
#, no-c-format
msgid "Read more about dual boot setups..."
msgstr "Ler mais acerca de configurazón con arranques duais..."

