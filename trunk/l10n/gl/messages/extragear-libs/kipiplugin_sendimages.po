"<p><b>KMail</b>: >= 1.3"
"<p><b>Mozilla</b>: >= 1.4"
"<p><b>Netscape</b>: >= 7.x"
"<p><b>Sylpheed</b>: >= 0.9"
"<p><b>Sylpheed-Claws</b>: >= 0.9"
"<p><b>Thunderbird</b>: >= 0.4"
"<p>"
