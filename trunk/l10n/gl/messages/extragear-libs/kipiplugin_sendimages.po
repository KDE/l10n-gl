#: sendimagesdialog.cpp:400
msgid "&Thunderbird binary path:"
msgstr "Localizazón do programa &Thunderbird:"

#: sendimagesdialog.cpp:410
msgid "<p>The path name to the Thunderbird binary program."
msgstr "<p>A rota ao programa Thunderbird."

#: sendimagesdialog.cpp:414
msgid "Attach a file with comments and tags"
msgstr "Adxuntar un ficheiro con comentários e marcas"

#: sendimagesdialog.cpp:415
msgid ""
"<p>If you enable this option, all images comments and tags will be added as an "
"attached file."
msgstr ""
"<p>Se activa esta opzón, todos os comentários e marcas das imaxes serán "
"engadidos como un ficheiro anexo."

#: sendimagesdialog.cpp:421
msgid "Images Properties"
msgstr "Propriedades das Imaxes"

#: sendimagesdialog.cpp:425
msgid "<p>The properties of images to send."
msgstr "<p>As propriedades das imaxes a enviar."

#: sendimagesdialog.cpp:430
