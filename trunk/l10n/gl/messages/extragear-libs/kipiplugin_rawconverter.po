"Failed to start raw converter client.\n"
"Please check your installation."
msgstr ""
"Non foi posíbel iniciar o cliente de conversión en bruto.\n"
"Por favor verifique a sua instalazón."

#: plugin_rawconverter.cpp:126
msgid ""
"dcraw is required for raw image conversion.\n"
"Please install it."
msgstr ""
"dcraw é necesário para a conversión de imaxes RAW.\n"
"Por favor instale-o."

#: previewwidget.cpp:74
