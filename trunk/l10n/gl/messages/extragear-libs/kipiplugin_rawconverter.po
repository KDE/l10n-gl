#: plugin_rawconverter.cpp:144
msgid ""
"<qt>"
"<p>Unable to find the dcraw executable:"
"<br> This program is required to process Raw file formats conversion. Please "
"install dcraw as a package from your distributor or <a href=\"%2\">"
"download the source</a>.</p></qt>"
msgstr ""
"<qt> "
"<p>Non foi posíbel atopar o executábel dcraw: "
"<br>Este programa é requerido para converter imaxes Raw. "
"Instale dcraw mediante un pacote para a sua distribuizón ou "
"<a href=\"%2\">através das fontes</a>.</p></qt>"

