#: medianotifier.cpp:160
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"Atopouse un arquivo de autoexecución no seu '%1'. ¿Desexa executalo?\n"
"Teña en conta que executar un arquivo nun medio pode comprometer a seguridade do seu sistema"

#: medianotifier.cpp:164
#, c-format
msgid "Autorun - %1"
msgstr "Autoexecutar - %1"

#: medianotifier.cpp:234
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"Atopouse un arquivo de autoapertura no seu '%1'. ¿Desexa abrir '%2'?\n"
"Teña en conta que abrir un arquivo nun medio pode comprometer a seguridade do seu sistema"

#: medianotifier.cpp:238
#, c-format
msgid "Autoopen - %1"
msgstr "Autoabrir - %1"

