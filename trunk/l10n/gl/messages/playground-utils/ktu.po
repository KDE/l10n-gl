#: ktuwidget.cpp:171
msgid ""
"The application 'msgfmt' is not found. Please install it, it is part of the "
"GNU Gettext package."
msgstr ""
"Non foi posíbel atopar a aplicazón \"msgfmt\". Instale-a, é parte do pacote "
"GNU Gettext."

#: ktuwidget.cpp:178
msgid ""
"The application 'svn' is not found. Please install it, it is part of the "
"Subversion package."
msgstr ""
"Non foi posíbel atopar a aplicazón \"svn\". Instale-a, é parte do pacote "
"Subversion."

#: ktuwidget.cpp:186
msgid ""
"The application KBabel is not found. If you want to edit files, you should "
