#: dbusdispatcher.cpp:73
msgid "Failed to call method: connection to D-BUS broken!"
msgstr "Fallo na chamada ao métido: Conexón con D-BUS rota!"

#: dbusdispatcher.cpp:123
msgid "Sorry, sending messages with argument type '%1' is not yet supported!"
msgstr "Sinto-o, ainda non está soportado o envio de mensaxes con argumentos tipo '%1'!"

#: dbusdispatcher.cpp:133
msgid "Argument '%1' is not of required type '%2'!"
msgstr "O argumento '%1' non é do tipo requerido '%2'!"

#: dbusdispatcher.cpp:142
msgid "Calling method %1.%2 ..."
msgstr "A chamar ao método %1.%2 ..."

#: dbusdispatcher.cpp:189
msgid "(kdbus doesn't know how to display this data type!)"
msgstr "(kdebus non sabe como mostrar este tipo de dados!)"

#: dbusdispatcher.cpp:195
#, c-format
msgid "Got more output than expected: %1"
msgstr "Obtivo-se mais saída da esperada: %1"

#: dbusdispatcher.cpp:219
#, c-format
msgid "Error while executing: %1"
msgstr "Erro ao executar: %1"

#: dbusdispatcher.cpp:227
msgid "Successfully called method %1.%2"
msgstr "Chamou-se con éxito ao método %1.%2"

#: dbusinterface.cpp:84 dbusmethod.cpp:97 dbusproperty.cpp:135
#: dbussignal.cpp:49
#, c-format
msgid "Interface: %1"
msgstr "Interface: %1"

#: dbusinterface.cpp:89 dbusmethod.cpp:102 dbusobject.cpp:180
#: dbusproperty.cpp:140 dbussignal.cpp:54
#, c-format
msgid "Object: %1"
msgstr "Obxecto: %1"

#: dbusinterface.cpp:94 dbusmethod.cpp:107 dbusobject.cpp:185
#: dbusproperty.cpp:145 dbusservice.cpp:126 dbussignal.cpp:59
#, c-format
msgid "Service: %1"
msgstr "Servizo: %1"

#: dbusitem.cpp:117
msgid "<b>Error:</b>"
msgstr "<b>Erro:</b>"

#: dbusitem.cpp:120
#, c-format
msgid "The following error occurred while inspecting this item: %1"
msgstr "Aconteceu este erro ao inspeccionar este ítem: %1"

#: dbusitem.cpp:126
msgid ""
"As a result, some or all of the information regarding this item may be "
"unavailable."
msgstr ""
"Como resultado, pode non estar disponíbel algunha ou toda a informazón deste "
"ítem."

#: dbusitem.cpp:155
msgid ""
"_: 'tag' means XML tag, 'attribute' means XML attribute\n"
"Found tag '%1' without required attribute '%2'"
msgstr "Atopou-se a marca '%1' sen o atributo requerido '%2'"

#: dbusmethod.cpp:92
#, c-format
msgid "Method: %1"
msgstr "Método: %1"

#: dbusmethod.cpp:118
msgid "<b>Input:</b>"
msgstr "<b>Entrada:</b>"

#: dbusmethod.cpp:155
msgid "<b>Output:</b>"
msgstr "<b>Saída:</b>"

#: dbusmethod.cpp:217
msgid "Execute Method"
msgstr "Executar Método"

#: dbusobject.cpp:136 dbusservice.cpp:99
msgid ""
"_: Do not translate 'Introspect'.\n"
"XML parse error in reply to Introspect"
msgstr "Erro de procesamento de XML na resposta a Introspect"

#: dbusproperty.cpp:60
msgid ""
"_: access modifier\n"
"read only"
msgstr "só leitura"

#: dbusproperty.cpp:62
msgid ""
"_: access modifier\n"
"write only"
msgstr "só escrita"

#: dbusproperty.cpp:64
msgid ""
"_: access modifier\n"
"read/write"
msgstr "ler/escreber"

#: dbusproperty.cpp:68
msgid "Property %1 has access modifier %2 instead of one of '%3', '%4', or '%5'"
msgstr "A propriedade %1 ten o modificador de aceso %2 no canto de '%3', '%4' ou '%5'"

#: dbusproperty.cpp:130
#, c-format
msgid "Property: %1"
msgstr "Propriedade: %1"

#: dbusproperty.cpp:150
msgid "You may read this property."
msgstr "Pode ler esta propriedade."

#: dbusproperty.cpp:152
msgid "You may not read this property."
msgstr "Non pode ler esta propriedade."

#: dbusproperty.cpp:155
msgid "You may write to this property."
msgstr "Pode escreber nesta propriedade."

#: dbusproperty.cpp:157
msgid "You may not write to this property."
msgstr "Non pode escreber nesta propriedade."

#: dbusservice.cpp:135 dbusservice.cpp:148 dbusservice.cpp:160
#: dbusservice.cpp:168
#, c-format
msgid "Process owning this service: %1"
msgstr "Proceso a quen pertence este servizo: %1"

#: dbusservice.cpp:138
msgid "unknown (D-BUS reports %1, but process with that PID does not seem to exist!)"
msgstr "descoñecido (D-BUS indica %1, pero non parece existir nengun proceso con tal PID!)"

#: dbusservice.cpp:169
msgid "unknown"
msgstr "descoñecido"

#: dbusservice.cpp:177
#, c-format
msgid "This service is also known as service %1."
msgstr "Este servizo tamén é coñecido como %1."

#: dbusservice.cpp:225
msgid "Failed to find out PID of %1: %2"
msgstr "Non foi posíbel atopar o PID de %1: %2"

#: dbusservice.cpp:295
msgid "Failed to find alias of %1: %2"
msgstr "Non foi posíbel atopar o alcume de %1: %2"

#: dbusserviceenumerator.cpp:81
#, c-format
msgid "Error: %1"
msgstr "Erro: %1"

#: dbusserviceenumerator.cpp:92
#, c-format
msgid "Inspecting service %1"
msgstr "A inspeccionar o servizo %1"

#: dbusserviceenumerator.cpp:122
msgid "While probing service %1: %2"
msgstr "Erro ao comprobar o servizo %1: %2"

#: dbusserviceenumerator.cpp:130
msgid "Finished discovering D-BUS services."
msgstr "Acabaron-se de descobrir os servizos D-BUS."

#: dbussignal.cpp:44
#, c-format
msgid "Signal: %1"
msgstr "Sinal: %1"

#: dbustreewidget.cpp:114
msgid "Please select an item above."
msgstr "Escolla un ítem acima."

#: dbustreewidget.cpp:119
msgid "Please wait, connecting to D-BUS..."
msgstr "Aguarde, a conectar con D-BUS..."

#: dbustreewidget.cpp:219
#, c-format
msgid "A new service became available: %1"
msgstr "Hai un servizo novo disponíbel: %1"

#: dbustreewidget.cpp:225
#, c-format
msgid "A service became unavailable: %1"
msgstr "Un servizo xa non está disponíbel: %1"

#: dbustreewidget.cpp:231
#, c-format
msgid "A service changed owner: %1"
msgstr "Un servizo mudou de proprietário: %1"

#: dbusutil.cpp:92
msgid "struct closed while not in struct in argument type"
msgstr "estrutura pechada mentres non se estaba na estrutura no tipo de argumento"

#: dbusutil.cpp:108
msgid "dict closed while not in dict in argument type"
msgstr "dicionário pechado desde fora del no tipo de argumento"

#: dbusutil.cpp:126
msgid "Unterminated struct found in argument type"
msgstr "Atopou-se unha estrutura non rematada no tipo de argumento"

#: dbusutil.cpp:142
msgid "struct found within dict in argument type"
msgstr "atopou-se unha estrutura nun dicionário no tipo de argumento"

#: dbusutil.cpp:155
msgid "dict found within dict in argument type"
msgstr "atopou-se un dicionário dentro doutro no tipo de argumento"

#: dbusutil.cpp:161
msgid "Unterminated dict found in argument type"
msgstr "Dicionário non rematado atopado no tipo de argumento"

#: dbusutil.cpp:165
msgid "dict with zero elements found"
msgstr "atopou-se un dicionário sen elementos"

#: dbusutil.cpp:169
msgid "dict with one element found"
msgstr "atopou-se un dicionário cun elemento"

#: dbusutil.cpp:174
msgid ""
"Unterminated dict or dict with more than two elements or dict with "
"non-primitive elements found"
msgstr ""
"Atopou-se un dicionário non rematado ou con mais de dous elementos ou con "
"elementos non primitivos."

#: dbusutil.cpp:204
msgid "Unrecognised argument type '%1' encountered"
msgstr "Atopou-se un tipo de argumento, '%1',  non recoñecido"

#: kdbus.cpp:71
msgid "&Refresh"
msgstr "&Refrescar"

#: kdbus.cpp:81
msgid "Automatically update available services"
msgstr "Actualizar automaticamente os servizos disponíbeis"

#: kdbus.cpp:95
msgid "System Bus"
msgstr "Bus do Sistema"

#: kdbus.cpp:100
msgid "Session Bus"
msgstr "Bus da Sesión"

#: main.cpp:32
msgid "A DBUS service browser."
msgstr "Un explorador do servizo D-BUS."

