#: src/inputformatimpls.cpp:45
msgid "Interprets input as a unique KABC contact identifier"
msgstr "Interpreta os dados de entrada como un identificador único de contacto de KABC"

#: src/inputformatimpls.cpp:103
msgid "Interprets input as VCard data"
msgstr "Interpreta os dados de entrada como dados de VCard"

#: src/inputformatimpls.cpp:131
msgid ""
"Warning: using codec '%1' with input format vcard, but vCards are usually "
"expected to be in UTF-8."
msgstr ""
"Atenzón: está a usar un codec '%1' co formato de entrada vCard, pero os vCards "
"acostuman estar en UTF8."

#: src/inputformatimpls.cpp:174
msgid "Interprets input as email and optional name"
msgstr "Interpreta a entrada como un email e un nome opcional"

#: src/inputformatimpls.cpp:238
msgid ""
"Tries to get email and name from input,\n"
"\t\totherwise sets input text for both"
msgstr ""
"Tenta obter o email e o nome a partir da entrada,\n"
"\t\tcaso contrário define o texto de entrada para ambos"

#: src/inputformatimpls.cpp:311
msgid ""
"Interprets the input as a name.\n"
"\t\tRecommended format is 'lastname, firstname middlename'"
msgstr ""
"Interpreta os dados de entrada como un nome.\n"
"\t\tO formato recomendado é 'apelido, primeironome nomemedio'"

#: src/inputformatimpls.cpp:375
msgid "Interprets the input as a delimiter separated list of fields."
msgstr "Interpreta a entrada como unha lista de campos separados por un delimitador."

#: src/inputformatimpls.cpp:395 src/outputformatimpls.cpp:618
msgid "Specify one of the following CSV templates:"
msgstr "Indique un dos seguintes modelos de CSV:"

#: src/inputformatimpls.cpp:563
msgid "Select contacts in a dialog instead of reading input text"
msgstr "Seleccionar os contactos nun diálogo en vez de ler o texto da entrada"

#: src/kabcclient.cpp:47
msgid "Saving modifications to addressbook failed"
msgstr "Fallo ao guardar as modificazóns na lista de enderezos"

#: src/kabcclient.cpp:48
msgid ""
"Input number %1 matches more than one contact. Skipping it to avoid undesired "
"results"
msgstr ""
"O número %1 corresponde a mais dun contacto. Será ignorado para evitar "
"resultados indesexábeis"

#: src/kabcclient.cpp:90
msgid "Input format '%1' not usable with operation '%2'"
msgstr "O formato de entrada '%1' non pode ser usado na operazón '%2'"

#: src/main.cpp:43
msgid "Add input data as new addressbook entries"
msgstr "Engadir os dados de entrada como ítens novos no libro de enderezos"

#: src/main.cpp:45
msgid "Remove entries matching the input data"
msgstr "Borrar os ítens que correspondan cos dados de entrada"

#: src/main.cpp:47
msgid "Merge input data into the addressbook"
msgstr "Xuntar os dados de entrada no libro de enderezos"

#: src/main.cpp:49
msgid "Search for entries matching the input data"
msgstr "Procurar por ítens que correspondan cos dados de entrada"

#: src/main.cpp:51
msgid "List all entries in address book"
msgstr "Listar todos os ítens do libro de enderezos"

#: src/main.cpp:53
msgid "Do not save changes to the addressbook on add/remove operations"
msgstr "Non guardar cámbios no libro de enderezos ao engadir/borrar"

#: src/main.cpp:55
msgid "How to interpret the input data."
msgstr "Como interpretar os dados de entrada."

#: src/main.cpp:57
msgid "Input options for the selected format"
msgstr "Opzóns de entrada para o formato seleccionado"

#: src/main.cpp:59
msgid "How to present the output data."
msgstr "Como apresentar os dados á saída."

#: src/main.cpp:61
msgid "Output options for the selected format"
msgstr "Opzóns de saída para o formato seleccionado"

#: src/main.cpp:63
msgid "How to convert the input text."
msgstr "Como converter o texto de entrada."

#: src/main.cpp:65
msgid "How to convert the output text."
msgstr "Como converter o texto á saída."

#: src/main.cpp:67
msgid "Match key fields case sensitive. UID is always matched case sensitive"
msgstr "Corresponder os campos con distinzón de maiúsculas. O UID sempre a fai"

#: src/main.cpp:68
msgid "Input to use instead of reading stdin"
msgstr "A entrada a usar en vez de ler stdin"

#: src/main.cpp:86
msgid "KABC client"
msgstr "Cliente de KABC"

#: src/main.cpp:87
msgid "KDE addressbook commandline client"
msgstr "Cliente da liña de comandos do libro de enderezos de KDE"

#: src/main.cpp:90 src/main.cpp:409
msgid "Primary Author"
msgstr "Autor Primário"

#: src/main.cpp:138
msgid "No operation specified, assuming --search"
msgstr "Non indicou nengunha operazón, asume-se '--search'"

#: src/main.cpp:145 src/main.cpp:272
msgid "Invalid input format \"%1\". See --input-format help"
msgstr "O formato de entrada \"%1\" non é válido. Vexa a axuda de --input-format"

#: src/main.cpp:154
msgid "Invalid options for input format \"%1\". See --input-format-options help"
msgstr ""
"As opzóns do formato de entrada \"%1\" non son válidas. Vexa a axuda de "
"--input-format-options"

#: src/main.cpp:162 src/main.cpp:324
msgid "Invalid output format \"%1\". See --output-format help"
msgstr "O formato de saída \"%1\" non é válido. Vexa a axuda de --output-format"

#: src/main.cpp:171
msgid "Invalid options for output format \"%1\". See --output-format-options help"
msgstr ""
"As opzóns do formato de saída \"%1\" non son válidas. Vexa a axuda de "
"--output-format-options"

#: src/main.cpp:183
msgid "Invalid input codec \"%1\""
msgstr "O codificador de entrada \"%1\" non é válido"

#: src/main.cpp:194
msgid "Invalid output codec \"%1\""
msgstr "O codificador de saída \"%1\" non é válido"

#: src/main.cpp:226 src/main.cpp:459
msgid "Unable to perform requested operation"
msgstr "Non foi posíbel efectuar a operazón pedida"

#: src/main.cpp:244
msgid "The following input formats are available:"
msgstr "Están disponíbeis os seguintes formatos de entrada:"

#: src/main.cpp:257 src/main.cpp:309
msgid "No description available"
msgstr "Descrizón non disponíbel"

#: src/main.cpp:281
#, c-format
msgid "No options available for input format %1"
msgstr "Non hai opzóns disponíbeis para o formato de entrada %1"

#: src/main.cpp:282
msgid "The following options are available for input format %1:"
msgstr "As seguintes opzóns están disponíbeis para o formato de entrada %1:"

#: src/main.cpp:296
msgid "The following output formats are available:"
msgstr "Están disponíveis os seguintes formatos de saída:"

#: src/main.cpp:333
#, c-format
msgid "No options available for output format %1"
msgstr "Non hai opzóns disponíveis para o formato de saída %1"

#: src/main.cpp:334
msgid "The following options are available for output format %1:"
msgstr "Están disponíveis as seguintes opzóns para o formato de saída %1:"

#: src/main.cpp:356
msgid ""
"The input codec transforms the input text data into an universal internal "
"format"
msgstr "O codec de entrada transforma o texto da entrada nun formato interno universal"

#: src/main.cpp:358
msgid ""
"Default input encoding is 'local' unless input format is 'vcard', in which case "
"the default encoding will be 'utf8'."
msgstr ""
"A codificazón á entrada por omisión é 'local', excepto se o formato de entrada "
"é 'vcard', nese caso a codificazón por omisión será 'utf8'."

#: src/main.cpp:366
msgid ""
"The output codec transforms the output text data from the internal format to an "
"8-bit text format"
msgstr ""
"O codec da saída transforma o texto do formato interno universal nun formato de "
"texto con 8 bits"

#: src/main.cpp:368
msgid ""
"Default output encoding is 'local' unless output format is 'vcard', in which "
"case the default encoding will be 'utf8'."
msgstr ""
"A codificazón á saída por omisión é 'local', excepto se o formato de saída é "
"'vcard', nese caso a codificazón por omisión será 'utf8'."

#: src/main.cpp:374
msgid ""
"Built-in codecs are UTF8 and LOCAL, respectively using the 8-bit unicode format "
"or your local encoding"
msgstr ""
"Os codecs incorporados son UTF8 e LOCAL, que usan o formato Unicode de 8 bits "
"ou a sua codificazón local, respectivamente"

#: src/main.cpp:378
msgid ""
"Other codecs can be specified by their ISO code, for example 'ISO 8859-15' for "
"western european languages, including the Euro sign"
msgstr ""
"Tamén se poden indicar outras codificazóns, usando o seu código ISO, como por "
"exemplo 'ISO 8859-15' para as línguas europeas ocidentais que incluen o símbolo "
"do Euro"

#: src/main.cpp:392
msgid "Only show contacts where name or address matches <substring>"
msgstr "Mostrar só os contactos onde o nome ou o enderezo condicen con <substring>"

#: src/main.cpp:394
msgid ""
"Default format is 'alias'. 'query' returns email<tab>name<tab>"
", as needed by mutt's query_command"
msgstr ""
"O formato por omisión é 'alias'. 'query' devolve email<tab>nome<tab>"
", tal como é necesário polo query_command de mutt"

#: src/main.cpp:397
msgid "Default key format is 'JohDoe', this option turns it into 'jdoe'"
msgstr ""
"O formato por omisión da chave é 'XoséPobre', polo que esta opzón transforma-o "
"en 'xpobre'"

#: src/main.cpp:398
msgid "Make queries case insensitive"
msgstr "Facer que as procuras non distingan maiúsculas"

#: src/main.cpp:399
msgid "Return all mail addresses, not just the preferred one"
msgstr "Devolve todos os enderezos de email, non só o preferido"

#: src/main.cpp:405
msgid "kabc2mutt"
msgstr "kabc2mutt"

#: src/main.cpp:406
msgid "kabc - mutt converter"
msgstr "conversor kabc - mutt"

#: src/main.cpp:411
msgid "Contributor"
msgstr "Contribuinte"

#: src/main.cpp:464
msgid "Searching KDE addressbook"
msgstr "A procurar no libro de enderezos de KDE"

#: src/main.cpp:470
msgid "No matches in KDE addressbook"
msgstr "Non existen ocorréncias no libro de enderezos de KDE"

#: src/outputformatimpls.cpp:45
msgid "Writes the unique KABC contact identifier"
msgstr "Escrebe o identificador individual de contacto de KABC"

#: src/outputformatimpls.cpp:116
msgid "Exports to VCard format"
msgstr "Exporta ao formato VCard"

#: src/outputformatimpls.cpp:136
msgid "Optionally use a different vCard version (default is %1)"
msgstr "Usar opcionalmente unha versión diferente de vCard (por omisión é a %1)"

#: src/outputformatimpls.cpp:141
msgid "Uses the vCard version 2.1"
msgstr "Usa a versión 2.1 de vCard"

#: src/outputformatimpls.cpp:156
msgid ""
"Warning: using codec '%1' with output format vcard, but vCards are usually "
"expected to be in UTF-8."
msgstr ""
"Atenzón: está a usar un codec '%1' co formato de saída vCard, pero os vCards "
"acostuman estar en UTF8."

#: src/outputformatimpls.cpp:237
msgid "Writes email address or formatted name <email address>"
msgstr "Escrebe o enderezo de email ou o nome formatado <enderezo de email>"

#: src/outputformatimpls.cpp:265
msgid "Comma separated list of: allemails, withname"
msgstr "Unha lista, separada por vírgulas, de: todos os e-mails, con nome"

#: src/outputformatimpls.cpp:270 src/outputformatimpls.cpp:414
msgid "List all email addresses of each contact"
msgstr "Lista todos os enderezos de email de cada contacto"

#: src/outputformatimpls.cpp:275
msgid ""
"Prepend formatted name, e.g\n"
"\t\tJohn Doe <jdoe@foo.com>"
msgstr ""
"Anteceder o nome formatado, p.ex.\n"
"\t\tXosé Pobre <xpob@xpto.com>"

#: src/outputformatimpls.cpp:376
msgid "Formats output as needed by the mail client mutt"
msgstr "Formata a saída para o cliente de email mutt"

#: src/outputformatimpls.cpp:409
msgid "Comma separated list of: allemails, query, alias, altkeys. Default is alias"
msgstr ""
"Unha lista separada por vírgulas de: todos os e-mails, procura, alcume, chaves "
"alternativas. Por omisión é alcume"

#: src/outputformatimpls.cpp:419
msgid ""
"Use mutt's query format, e.g.\n"
"\t\tjdoe@foo.com <tab> John Doe\n"
"\t\tConflicts with alias"
msgstr ""
"Usar o formato de procura de 'mutt', p.ex.\n"
"\t\txpob@xpto.com <tab> Xosé Pobre\n"
"\t\tConflitos co alcume"

#: src/outputformatimpls.cpp:426
msgid ""
"Use mutt's alias format, e.g.\n"
"\t\talias JohDoe<tab>John Doe <jdoe@foo.com>\n"
"\t\tConflicts with query"
msgstr ""
"Usar o formato de alcumes de mutt, p.ex.\n"
"\t\talias XosePobre<tab>Xosé Pobre <xpob@xpto.com>\n"
"\t\tConflitos coa procura"

#: src/outputformatimpls.cpp:433
msgid ""
"Use alternative keys with alias format, e.g.\n"
"\t\talias jdoe<tab>John Doe <jdoe@foo.com>"
msgstr ""
"Usar as chaves alternativas co formato de alcumes, p.ex.\n"
"\t\talias xpob<tab>Xosé Pobre <xpob@xpto.com>"

#: src/outputformatimpls.cpp:493
msgid "preferred"
msgstr "preferido"

#: src/outputformatimpls.cpp:598
msgid "Writes the data as a delimiter separated list of values"
msgstr "Escrebe os dados como unha lista de valores separados por un delimitador"

