#: imaplogin.cpp:99
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"O servidor %1 non soporta nen  IMAP4 nen IMAP4rev1.\n"
"Identificou-se a si mesmo como: %2"

#: imaplogin.cpp:115
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"O servidor non soporta TLS.\n"
"Desactive esta proteczón para conectar-se sen cifraxe."

#: imaplogin.cpp:142
msgid "Starting TLS failed."
msgstr "Fallou o início de TLS."

#: imaplogin.cpp:151
msgid "The authentication method %1 is not supported by the server."
msgstr "O método de autenticazón %1 non está soportado polo servidor."

#: imaplogin.cpp:160
msgid "Username and password for your IMAP account:"
msgstr "Nome de usuário e contrasinal da sua conta IMAP:"

#: imaplogin.cpp:172
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or try to get a "
"different username."
msgstr ""
"Só se permiten carácteres US-ASCII nos acesos IMAP de texto limpo. Use "
"un método de autenticazón diferente dos permitidos polo seu servidor ou "
"tente obter un nome de usuário direrente."

#: imaplogin.cpp:178
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or change your "
"password."
msgstr ""
"Só se permiten carácteres US-ASCII nos acesos IMAP de texto limpo. Use "
"un método de autenticazón diferente dos permitidos polo seu servidor ou "
"tente mudar o seu contrasinal."

#: imaplogin.cpp:191
msgid ""
"Unable to authenticate via %1.\n"
"The server does not support this authentication method (as specified in its "
"CAPABILITY response)."
msgstr ""
"Non foi posíbel autenticar-se mediante %1.\n"
"O servidor non soporta este método de autenticazón (como se indica "
"na sua resposta CAPABILITY)."

#: imaplogin.cpp:206
#, c-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"Non foi posíbel aceder. Posibelmente o contrasinal estivese errado.\n"
"O servidor respondeu:\n"
"%1"

#: imaplogin.cpp:236
msgid ""
"Unable to authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"Non foi posíbel autenticar-se mediante %1.\n"
"O servidor respondeu:\n"
"%1"

#: imapselect.cpp:167
msgid "Unable to open folder %1. The server replied: %2"
msgstr "Non foi posíbel abrir o cartafol %1. O servidor respondeu: %2"

#: imapstat.cpp:132
msgid "Unable to close mailbox."
msgstr "Non foi posíbel pechar a caixa de correo."

#: imapstat.cpp:180
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "Non foi posíbel obter informazón acerca do cartafol %1. O servidor respondeu: %2"

#: imapstatus.cpp:59 imapstatus.cpp:72
msgid "Changing the flags of message %1 failed."
msgstr "Fallou a modificazón das bandeiras da mensaxe %1."

#: imapsubscribe.cpp:56
msgid "Unsubscribe of folder %1 failed."
msgstr "Fallou a desubscrizón do cartafol %1."

#: imapsubscribe.cpp:60
msgid "Subscribe of folder %1 failed."
msgstr "Fallou a subscrizón ao cartafol %1."

