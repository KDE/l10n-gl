msgid " /add username : add user 'username' to friend list"
msgstr "/add usuário : Engade o usuário á lista de amigos"

#: chatwindow.cpp:176 talkwindow.cpp:116
msgid " /del username : remove user 'username' from friend list"
msgstr "/del usuário : borra o usuário da lista de amigos"

#: chatwindow.cpp:178
msgid "/talk user     : open up a private talk window for user"
msgstr "/talk usuário : abre unha fiestra de conversa privada co usuário"

#: chatwindow.cpp:180 talkwindow.cpp:118
msgid " /save        : prompt to save contents of the window"
msgstr " /save        : pergunta se guardar os contidos da fiestra"

#: chatwindow.cpp:183
msgid "/kill username : kill username"
msgstr "/kill usuário : matar ao usuário"

#: chatwindow.cpp:184
msgid "/kick username : kick username off this channel"
msgstr "/kick usuário : expulsar o usuário deste canal"

#: chatwindow.cpp:188
msgid "Anything else not starting with / is sent directly to the channel"
msgstr "Todo o que non comece por / é enviado directamente para o canal"

