#: ksystrayproxy.cpp:63
msgid "No window matching pattern '%1' and no command specified.\n"
msgstr "Nengunha fiestra corresponde co padrón \"%1\" e non se especificou nengun comando.\n"

#: ksystrayproxy.cpp:70
msgid "KSysTrayCmd: KShellProcess can't find a shell."
msgstr "KSysTrayCmd: KShellProcess non atopou nengunha shell."

#: ksystrayproxy.cpp:190 main.cpp:41
msgid "KSysTrayCmd"
msgstr "KSysTrayCmd"

#: ksystrayproxy.cpp:191
msgid "&Hide"
msgstr "Acoc&har"

#: ksystrayproxy.cpp:191
msgid "&Restore"
msgstr "&Restaurar"

#: main.cpp:23
msgid "Command to execute."
msgstr "O comando para executar."

#: main.cpp:25
msgid ""
"A regular expression matching the window title.\n"
"If you do not specify one, then the very first window\n"
"to appear will be taken. Not recommended!"
msgstr ""
"Unha expresión regular que corresponde co título da fiestra.\n"
"Se non indica unha, escollera-se a primeira fiestra que\n"
"apareza. Non se recomenda!"

#: main.cpp:28
msgid "Hide the window to the tray on startup"
msgstr "Acoplar a fiestra na bandexa do sistema ao iniciar"

#: main.cpp:29
msgid ""
"Wait until we're told to show the window before\n"
"executing the command"
msgstr ""
"Espere até que se ordene mostrar a fiestra\n"
"antes de executar o comando"

#: main.cpp:31
msgid "Sets the initial tooltip for the tray icon"
msgstr "Configura a axuda inicial do ícone da bandexa"

#: main.cpp:32
msgid ""
"Keep the tray icon even if the client exits. This option\n"
"has no effect unless startonshow is specified."
msgstr ""
"Manter o ícone da bandexa mesmo se o cliente existe.\n"
"Esta opzón non ten efeito a non ser que se indique startonshow."

#: main.cpp:43
msgid "Allows any application to be kept in the system tray."
msgstr "Permitir que calquer aplicazón sexa acoplada na bandexa do sistema."

#: main.cpp:62
msgid "No command or window title specified"
msgstr "Non se indicou nengun comando nen título de fiestra"

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "mvillarino"

