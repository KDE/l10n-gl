#: options.cpp:223
msgid ""
"usage: %1 [-options] [message ...]\n"
"\n"
msgstr ""
"utilizazón: %1 [-opzóns] [mensaxe ...]\n"
"\n"

#: options.cpp:225
msgid "where options include:\n"
msgstr "onde opzóns inclui:\n"

#: options.cpp:226
msgid "  -title name             the title used on the message window\n"
msgstr "  -title nome             o título usado na fiestra da mensaxe\n"

#: options.cpp:227
msgid "  -file filename          file to read message from, \"-\" for stdin\n"
msgstr "  -file nomeFicherio          o ficheiro do que ler a mensaxe, \"-\" para stdin\n"

#: options.cpp:228
msgid "  -buttons string         comma-separated list of label[:exitcode]\n"
msgstr "  -buttons cadea         lista separada por vírgulas de marca[:códigoSaida]\n"

#: options.cpp:229
msgid "  -default button         button to activate if Return is pressed\n"
msgstr "  -default botón         botón a activa se é premido Intro\n"

#: options.cpp:230
msgid "  -cancel button          button to activate if Escape is pressed\n"
msgstr "  -cancel botón          botón a activar se é premido Escape\n"

#: options.cpp:231
msgid "  -print                  print the button label when selected\n"
msgstr "  -print                  imprimir a etiqueta do botón cando se escolla\n"

#: options.cpp:232
msgid "  -escape                 expand \\n,\\r, and \\t characters in message\n"
msgstr "  -escape                 expande os carácteres \\n,\\r, e \\t na mensaxe\n"

#: options.cpp:233
msgid ""
"  -timeout secs           exit with status 0 after \"secs\" seconds\n"
"\n"
msgstr ""
"  -timeout segs           sair co estado 0 após \"segs\" segundos\n"
"\n"

#: options.cpp:235
msgid ""
"the following options are allowed for compatibility, but are "
"non-functional:\n"
msgstr ""
"as seguintes opzóns son permitidas por compatibilidade, pero "
"non son funcionais:\n"

#: options.cpp:236
msgid "  -center\n"
msgstr "  -center\n"

#: options.cpp:237
msgid ""
"  -nearmouse\n"
"\n"
msgstr ""
"  -nearmouse\n"
"\n"

#: options.cpp:239
msgid "%1 version %2\n"
msgstr "%1 versión %2\n"

#: options.cpp:240
msgid "by %1\n"
msgstr "por %1\n"

