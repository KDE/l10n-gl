#: authenticate.cpp:50
msgid "ACAP (Application Configuration Access Protocol) Authentication Details"
msgstr "Detalles da Autenticazón do ACAP (Application Configuration Access Protocol)"

#: authenticate.cpp:51
msgid "Please enter your authentication details for your ACAP account:"
msgstr "Indique os detalles da sua autenticazón para a sua conta ACAP:"

#: authenticate.cpp:53
msgid "No authentication details supplied."
msgstr "Non se inseriron detalles da autenticazón."

#: authenticate.cpp:71
msgid "No compatible authentication methods found."
msgstr "Non se atoparon métodos de autenticazón compatíbeis."

#: authenticate.cpp:103
#, c-format
msgid ""
"A protocol error occurred during authentication.\n"
"Choose a different authentication method to %1."
msgstr ""
"Aconteceu un erro de protocolo durante a autenticazón.\n"
"Escolla un método de autenticazón distinto de %1."

#: authenticate.cpp:123
#, c-format
msgid ""
"\n"
"The server responded:\n"
"%1"
msgstr ""
"\n"
"O servidor respondeu:\n"
"%1"

#: authenticate.cpp:124
#, c-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong. %1"
msgstr ""
"Fallo de autenticazón.\n"
"O mais probábel é que o contrasinal sexa incorrecto. %1"

#: slave.cpp:118
msgid "Done."
msgstr "Feito."

