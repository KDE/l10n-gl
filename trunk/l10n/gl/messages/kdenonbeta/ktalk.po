#: filetransfer.cpp:77
msgid ""
"<qt>The connection to your talk partner was closed, so we cannot start file "
"transfer any more!</qt>"
msgstr ""
"<qt>A conexón ao teu compañeiro de talk foi pechada, por iso non se pode "
"iniciar a transferéncia do ficheiro!</qt> "

