#. i18n: file quizselectionbase.ui line 119
#: rc.cpp:21
#, no-c-format
msgid ""
"Select the set of questions. If you, for example, selected shakespeare as "
"the subject, then you could select lines from shakespeare's works as the "
"question set and the next line or work as the answer set."
msgstr ""
"Escolle o conxunto de perguntas. Se por exemplo escolle shakespeare como "
"o asunto, entón pode escoller liñas das obrar deste autor como o conxunto de "
"perguntas e a seguinte liña ou traballo como o conxunto de respostas."

#. i18n: file quizselectionbase.ui line 158
#: rc.cpp:27
#, no-c-format
msgid ""
"Select the set of answers. Any question set may or may not have multiple "
"different answer sets."
msgstr ""
"Escolla o conxunto de respostas. Calquer conxunto de perguntas pode ter ou non "
"múltiplos conxuntos de respostas diferentes."

