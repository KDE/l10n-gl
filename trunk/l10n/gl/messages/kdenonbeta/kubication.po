#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "mvillarino@users.sourceforge.net"

#: kubication.cpp:76 kubication.cpp:116
msgid "New ubication"
msgstr "Nova localizazón"

#: kubication.cpp:168
msgid "Duplicate entry"
msgstr "Entrada duplicada"

#: kubication.cpp:169
msgid ""
"There is already an ubication called \"%1\".\n"
"Please select another name."
msgstr ""
"Xa hai unha localizazón chamada \"%1\".\n"
"Escolla outro nome."

#: kubication.cpp:384
msgid ""
"<qt>Closing the main window will keep Kubication running in the system tray. "
"Use Quit from the File menu to quit the application.</qt>"
msgstr ""
"<qt>Se pecha a fiestra principal Kubication manterá-se na bandexa do sistema. "
"Use Sair no menu Ficheiro para sair da aplicazón.</qt>"

#: kubication.cpp:386
msgid "Docking in System Tray"
msgstr "Acoplaxe na Bandexa do Sistema"

#: kubicationchange.cpp:303
msgid ""
"<qt>I cannot find any suitable dhcp client.\n"
"Please install dhcpcd, dhclient, or pump.</qt>"
msgstr ""
"<qt>Non se atopou nengun cliente dhcp apropriado.\n"
"Intale dhcpcd, dhclient ou pump.</qt>"

#: kubicationchange.cpp:408
msgid ""
"<qt>If KMail is running when you change the default smtp, you will need to "
"restart it in order for the changes take effect. See README.KMail for more "
"information.</qt>"
msgstr ""
"<qt>Se KMail está a executar-se cando cámbia o smtp por omisión, precisará "
"reiniciá-lo para que os cámbios se fagan efectivos. Consulte README.kmail para "
"mais informazón.</qt>"

#: kubicationchange.cpp:411
msgid "KMail issue"
msgstr "Problema de KMail"

#: kubicationconfig.cpp:77 kubicationconfig.cpp:97 kubicationconfig.cpp:114
#: kubicationconfig.cpp:175
msgid "Unnamed"
msgstr "Sen nome"

#: kubicationconfig.cpp:252
msgid "Update Failed"
msgstr "Fallou a Actualizazón"

#: kubicationconfig.cpp:253
msgid ""
"You have to restart the running applications for these changes to take effect."
msgstr ""
"Ten que reiniciar as aplicazóns en execuzón para que estes cámbios teñan "
"efeito."

#: kubicationsudlg.cpp:27
msgid "Change ubication"
msgstr "Cambiar localizazón"

#: kubicationsudlg.cpp:29
msgid ""
"Changing network settings requires root privileges. Please enter root's "
"password below."
msgstr ""
"Cambiar a configurazón da rede precisa priviléxios de root. Introduza o "
"contrasinal de root en baixo."

#: kubicationsudlg.cpp:50
msgid "Conversation with su failed."
msgstr "A conversa con su fallou."

#: kubicationsudlg.cpp:59
msgid ""
"The program 'su' is not found;\n"
"make sure your PATH is set correctly."
msgstr ""
"Non se atopou o programa \"su\"; asegure-se de que o seu PATH é correcto."

#: kubicationsudlg.cpp:66
msgid ""
"You are not allowed to use 'su';\n"
"on some systems, you need to be in a special group (often: wheel) to use this "
"program."
msgstr ""
"Non ten permiso para executar \"su\";\n"
"nalguns sistemas, ten que pertencer a un grupo especial (a miúdo wheel) para "
"usar este programa."

#: kubicationsudlg.cpp:73
msgid "Incorrect password; please try again."
msgstr "Contrasinal incorrecto, por favor tente-o de novo."

#: kubicationsudlg.cpp:77
msgid "Internal error: Illegal return from SuProcess::checkInstall()"
msgstr "Erro interno: Retorno ilegal de SuProcess::checkInstall()"

#: kubicationtray.cpp:52
msgid "About Kubication"
msgstr "Acerca de Kubication"

