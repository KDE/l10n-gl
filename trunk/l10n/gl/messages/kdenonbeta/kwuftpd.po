msgstr "&Fixo"

#: Permissions.cpp:16
msgid "&Read"
msgstr "&Ler"

#: Permissions.cpp:17
msgid "&Write"
msgstr "Escre&ber"

#: Permissions.cpp:18
msgid "&Execute"
msgstr "&Executar"

#: Permissions.cpp:19
msgid "Re&ad"
msgstr "Le&r"

#: Permissions.cpp:20
