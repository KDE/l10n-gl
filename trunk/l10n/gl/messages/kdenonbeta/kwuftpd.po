#. i18n: file AddMessageBase.ui line 110
#: AddDlFree.cpp:11 rc.cpp:15
#, no-c-format
msgid "Folder:"
msgstr "Cartafol:"

#: AddDlFree.cpp:11 AddNoRet.cpp:11
msgid "Filename:"
msgstr "Nome do ficheiro:"

#: AddDlFree.cpp:16
msgid "Add Freely Downloadable Folder"
msgstr "Engadir un Cartafol de Transferéncia Libre"

#: AddDlFree.cpp:18
msgid "Add Freely Downloadable File"
msgstr "Engadir un Ficheiro de Transferéncia Libre"

#: AddMessage.cpp:25
msgid "Add Readme"
msgstr "Engadir un ficheiro \"Readme\""

#: AddMessage.cpp:27
msgid "Add Message"
msgstr "Engadir unha Mensaxe"

#: AddMessage.cpp:29
msgid ""
"Message will be displayed after a user logs in.\n"
"The file has to be relative to the chrooted folder for anonymous/guest users."
msgstr ""
"A mensaxe será mostrada sempre que un usuário se autentique.\n"
"O ficheiro ten que estar relacionado co cartafol \"chrooted\" para os "
"usuários anónimos/convidados."

#: AddMessage.cpp:30
msgid ""
"Message will be displayed when a user enters the specified folder.\n"
"Path has to be relative to chroot for anonymous/guest users."
msgstr ""
"A mensaxe será mostrada cando un usuário entra no cartafol indicado.\n"
"A rota ten que ser relativa ao \"chroot\" para os usuários anónimos/convidados."

#: AddMessage.cpp:31
msgid "Filename of the message file - remember to make this relative to chroot!"
msgstr "Ficheiro da mensaxe - lembre-se de facé-lo relativo a \"chroot\"!"

#: AddMessage.cpp:32
msgid ""
"Folder in which the message will be displayed.\n"
"May be globbed: For example * means show in every folder.\n"
"This is especially useful if you're using ratios."
msgstr ""
"O cartafol na cal será mostrada a mensaxe.\n"
"Permite-se o uso de meta-carácteres (*? []).\n"
"Isto é particularmente útil se está a usar proporzóns."

#: AddMessage.cpp:33
msgid "The message will be displayed only to members of the classes below."
msgstr "Esta mensaxe só será mostrada aos membros das seguintes clases."

#: AddMessage.cpp:44
msgid "The message will be displayed to members of the classes selected here."
msgstr "Esta mensaxe será mostrada aos membros das clases aqui escollidas."

#: AddNoRet.cpp:13
msgid "Add Non-Retrievable File/Folder"
msgstr "Engadir un Ficheiro/cartafol Inacesíbel"

#: AddNoRet.cpp:14
msgid ""
"End the filename with a / to indicate it is\n"
"an entire folder; no file in this folder\n"
"will be retrievable."
msgstr ""
"Poña unha barra (/) no final do nome para indicar\n"
"que é un cartafol inteiro; nengún ficheiro dese\n"
"cartafol será acesíbel."

#: AddRCPT.cpp:11
msgid "Address:"
msgstr "Enderezo:"

#: AddRCPT.cpp:13
msgid "Add Recipient for Upload-Notification"
msgstr "Engadir un Destinatário de Notificazóns de Subidas"

#: AddVHost.cpp:12
msgid "IP address:"
msgstr "Enderezo IP:"

#: AddVHost.cpp:14
msgid "Add Virtual Host"
msgstr "Engadir un Servidor Virtual"

#: AddVHost.cpp:15
msgid "Enter the IP address of the new virtual host here."
msgstr "Indique aqui o enderezo IP do novo servidor virtual."

#: Directories.cpp:19
msgid ""
"Anonymous users (username <i>ftp</i> or <i>anonymous</i>) will see the "
"folder entered here as their / folder."
msgstr "O cartafol aqui indicado é o raiz dos usuários anónimos (login = <i>ftp</i>  ou <i>anonymous</i>)."

#: Directories.cpp:20
msgid ""
"Guest users (real users with restricted access) will see the folder entered "
"here as their / folder."
msgstr ""
"O cartafol aqui indicado é a raiz dos usuários convidados (usuários "
"reais con aceso restrinxido)."

#: Directories.cpp:21
msgid ""
"Use the alternate passwd file specified here for authenticating users.<br>If "
"this is left blank, the system passwd file will be used.<br>This setting can "
"be overridden for virtual hosts."
msgstr ""
"Utilice o ficheiro passwd alternativo definido aqui para autenticar os "
"usuários.<br>Se se deixa en branco, será usado o ficheiro \"passwd\" do  "
"sistema.<br>Isto pode ser sobrescrito polos servidores virtuais."

#: Directories.cpp:22
msgid ""
"Use the alternate shadow password file specified here for authenticating "
"users.<br>If this is left blank, the system shadow file will be "
"used.<br>This setting can be overridden for virtual hosts."
msgstr ""
"Utilice o ficheiro \"shadow password\" alternativo definido aqui para "
"autenticar os usuários.<br>Se o deixa en branco, será usado o "
"ficheiro \"shadow\" do sistema.<br>Ista pode ser sobrescrito polos "
"servidores virtuais."

#: EditLimit.cpp:31
msgid "Edit Limit for Class"
msgstr "Editar o Limite da Clase"

#: EditLimit.cpp:33
msgid "Edit Limit"
msgstr "Editar o Limite"

#: EditLimit.cpp:36
msgid "Add Limit for Class"
msgstr "Engadir o Limite da Clase"

#: EditLimit.cpp:38
msgid "Add Limit"
msgstr "Engadir un Limite"

#: EditLimit.cpp:42 EditLimit.cpp:43
msgid ""
"Use this to specify at which hours this limit is in effect.\n"
"Example:\n"
"0630-1310 -> 06:30 AM - 01:10 PM\n"
"Defaults to 0000-2400."
msgstr ""
"Use isto para especificar a que horas está activado o limite.\n"
"Exemplo:\n"
"0630-1310 -> das 06:30 ás 13:10\n"
"Por omisión: 0000-2400."

#: EditUpload.cpp:19
msgid "Edit Upload"
msgstr "Editar a Subida"

#: Logging.cpp:20
msgid ""
"Use these check boxes to control for which types of users all commands will "
"be logged."
msgstr ""
"Utilice estas opzóns para controlar a que tipos de usuários rexistar "
"todos os comandos."

#: Logging.cpp:21
msgid "Log inbound transfers (uploads to this server)"
msgstr "Rexistar os envios para este servidor"

#: Logging.cpp:22
msgid "Log outbound transfers (downloads from this server)"
msgstr "Rexistar os envios desde este servidor"

#: Logging.cpp:23
msgid "Log security-related messages (failed logins etc.)"
msgstr "Rexistar as mensaxes de seguridade (autenticazóns falladas, ...)"

#: Logging.cpp:24
msgid ""
"Log commands given by anonymous (username <i>ftp</i> or <i>anonymous</i>) "
"users."
msgstr "Rexistar os comandos dos usuários anónimos (nome = <i>ftp</i> ou <i>anonymous</i>)."

#: Logging.cpp:25
msgid ""
"Log commands given by guest users (users with a real account, but restricted "
"access)."
msgstr ""
"Rexistar os comandos dos usuários convidados (usuários con conta "
"própria, pero aceso restrito)."

#: Logging.cpp:26
msgid ""
"Log commands given by real users (users with an unrestricted account on the "
"server"
msgstr "Rexistar os comandos dos usuários reais (usuários con conta normal no servidor)"

#: Logging.cpp:27
msgid ""
"Log inbound transfers (uploads to the server) by anonymous users (username "
"<i>ftp</i> or <i>anonymous</i>)"
msgstr "Rexistar os envios dos usuários anónimos (nome = <i>ftp</i> ou <i>anonymous</i>)"

#: Logging.cpp:28
msgid ""
"Log inbound transfers (uploads to the server) by guest users (users with a "
"real account, but restricted access)"
msgstr "Rexistar os envios desde os usuários convidados (usuários con conta própria, pero aceso restrito)"

#: Logging.cpp:29
msgid ""
"Log inbound transfers (uploads to the server) by real users (users with a "
"real account and without restrictions)"
msgstr ""
"Rexistar os envios dos usuários reais (usuários con conta normal no "
"servidor sen restrizóns)"

#: Logging.cpp:30
msgid ""
"Log outbound transfers (downloads from the server) by anonymous users "
"(username <i>ftp</i> or <i>anonymous</i>)"
msgstr "Rexistar as baixadas dos usuários anónimos (nome = <i>ftp</i> ou <i>anonymous</i>)"

#: Logging.cpp:31
msgid ""
"Log outbound transfers (downloads from the server) by guest users (users "
"with a real account, but restricted access)"
msgstr "Rexistar as baixadas dos usuários convidados (usuários con conta própria, pero aceso restrito)"

#: Logging.cpp:32
msgid ""
"Log outbound transfers (downloads from the server) by real users (users with "
"a real account and without restrictions)"
msgstr "Rexistar as baixadas dos usuários reais (usuários con conta normal no servidor sen restrizóns)"

#: Logging.cpp:33
msgid ""
"Keep a security log (failed login attempts etc.) for anonymous users "
"(username <i>anonymous</i> or <i>ftp</i>)"
msgstr ""
"Guardar un rexisto de seguridade (autenticazóns falladas, ...) para os "
"usuários anónimos (nome = <i>ftp</i> ou <i>anonymous</i>)"

#: Logging.cpp:34
msgid ""
"Keep a security log (failed login attempts etc.) for guest users (real users "
"with restricted access)"
msgstr ""
"Guardar un rexisto de seguridade (autenticazóns falladas, ...) para "
"os usuários convidados (usuários con conta própria, pero con aceso restrito)"

#: Logging.cpp:35
msgid ""
"Keep a security log (failed login attempts etc.) for guest users (real users "
"with unrestricted access)"
msgstr ""
"Guardar un rexisto de seguridade (autenticazóns falladas, ...) para "
"os usuários reais (usuários con conta normal sen restrizóns)"

#: Logging.cpp:36
msgid "Log to syslog instead of logfiles"
msgstr "Rexistar no syslog en vez de ser en ficheiros"

#: Logging.cpp:37
msgid "Automatically notify the administrator of uploads from anonymous users"
msgstr "Notificar automaticamente ao administrador os envios anónimos"

#: Logging.cpp:38
msgid ""
"The address entered here will appear in the <i>From:</i> header of upload "
"notification email messages sent by wu-ftpd."
msgstr ""
"O enderezo aqui indicado é o que vai aparecer no campo <i>De:</i> das "
"mensaxes de notificazón enviadas por wu-ftpd."

#: Logging.cpp:39
msgid ""
"The mail server entered here will be used to transmit upload notification "
"email messages sent by wu-ftpd. If left blank, localhost will be used."
msgstr ""
"O servidor de email aqui indicado é o que vai ser usado para transmitir as "
"mensaxes de notificazón de subida de wu-ftpd. Por omisión, é \"locallost\"."

#: Logging.cpp:41 Logging.cpp:42
msgid ""
"This list box shows the recipient(s) of upload notification emails. Use the "
"<b>Add</b> and <b>Remove</b> buttons below to modify the recipients."
msgstr ""
"Esta lista contén o(s) destinatário(s) das notificazóns de subidas. Utilice "
"os botóns <b>Engadir</b> e <b>Borrar</b> en baixo para modificá-los."

#: Logging.cpp:44
msgid "Add a new recipient for upload notification emails"
msgstr "Engade un destinatário para os e-mails de notificazón de subidas"

#: Logging.cpp:45
msgid "Remove the currently selected recipient for upload notification emails"
msgstr "Borra o destinatário escollido dos e-mails de notificazón de subidas"

#: Messages.cpp:16
msgid ""
"The file selected here will be displayed to\n"
"FTP users before login.\n"
"May break compatibility with truly ancient clients."
msgstr ""
"O ficheiro escollido será mostrado aos\n"
"usuários antes da autenticazón.\n"
"Pode ser incompatíbel con programas moi antigos."

#: Messages.cpp:17
msgid ""
"The hostname given here will be shown at login and for\n"
"the %L cookie in message files.\n"
"If this is blank, the canonical hostname of your system will be used."
msgstr ""
"O nome aqui fornecido será mostrado na autenticazón e nos ficheiros\n"
"de mensaxe da \"cookie\" %L.\n"
"Se o deixa en branco, será usado o nome canónico do seu sistema."

#: Messages.cpp:18
#, c-format
msgid "Email address returned with the %E cookie in message files."
msgstr "O enderezo de email devolvido coa \"cookie\" %E nos ficheiros de mensaxe."

#: Messages.cpp:19
msgid "If this is not checked, message files at CWD will be displayed only once."
msgstr "Se a opzón non estivese sinalada, as mensaxes no directório actual só se mostrarán unha vez."

#: Messages.cpp:20
msgid "If this is not checked, hints on README files will be displayed only once."
msgstr "Se a opzón non estivese sinalada, as suxestións sobre os READMEs só aparecerán unha vez."

#: Messages.cpp:22 Messages.cpp:23 Messages.cpp:24
msgid ""
"Messages are files that are automatically displayed to the user after "
"logging in or after entering a folder. Use the <b>Add Message</b> and "
"<b>Remove Message</b> buttons to modify the messages."
msgstr ""
"As mensaxes son ficheiros que son automaticamente mostrados ao "
"usuário após a autenticazón ou após entrar nun cartafol. Utilice os "
"botóns <b>Engadir Mensaxe</b> e <b>Borrar a Mensaxe</b> para "
"modificar as  mensaxes."

#: Messages.cpp:26 Messages.cpp:27 Messages.cpp:28
msgid ""
"When you have defined README files, users changing to a folder containing "
"files matching the glob listed here will be pointed to these files with a "
"<i>Please read the file README, last modified x days ago</i> message.<br>Use "
"the <b>Add Readme</b> and <b>Remove Readme</b> buttons to modify the list of "
"README files."
msgstr ""
"Cando defina os ficheiros README, os usuários que entren nun cartafol que conteña "
"algun dos ficheiros listados serán rencamiñados para estes ficheiros cunha mensaxe "
"dicendo <i>Por favor,  lea o ficheiro README, modificado hai x dias</i>.<br>Utilice os "
"botóns <b>Engadir un Readme</b> e <b>Borrar Readme</b> para modificar a lista "
"de ficheiros README."

#: NewClass.cpp:11
msgid "Add New User Class"
msgstr "Engadir unha Nova Clase de Usuário"

#: NewClass.cpp:17 NewClass.cpp:18
msgid ""
"The name of your new user class -\n"
"may be anything, but may not contain whitespaces."
msgstr ""
"O nome da nova clase -\n"
"pode ser calquer cousa, pero non pode ter espazos."

#: NewClass.cpp:19
msgid ""
"Anonymous users\n"
"(login=ftp or anonymous)"
msgstr ""
" Usuários anónimos\n"
"(login=ftp ou anonymous)"

#: NewClass.cpp:20
msgid ""
"Guest users\n"
"(chrooted real users)"
msgstr ""
"Usuários convidados\n"
"(usuários reais con \"chroot\")"

#: NewClass.cpp:21
msgid "Real users"
msgstr "Usuários reais"

#: NewClass.cpp:22 NewClass.cpp:23 UserClasses.cpp:28 UserClasses.cpp:29
msgid ""
"Specify the addresses for this user class here;\n"
"may be globbed:\n"
"* = any address\n"
"*.localdomain.com = any address in localdomain.com\n"
"127.0.0.* = IPs 127.0.0.1-127.0.0.255\n"
"..."
msgstr ""
"Especifique aqui os enderezos para esta clase;\n"
"poden ter meta-carácteres:\n"
"* = calquer enderezo\n"
"*.dominio.gl = calquer enderezo en dominio.gl\n"
"127.0.0.* = os IPs 127.0.0.1 a 127.0.0.255\n"
"..."

#: NewClass.cpp:37
msgid "Class name may not be empty."
msgstr "O nome da clase non pode estar valeiro."

#: NewClass.cpp:42
msgid "Class name may not contain whitespaces."
msgstr "O nome da clase non pode ter espazos."

#: NewClass.cpp:49
msgid "You must check at least one of Anonymous, Guest or Real."
msgstr "Ten que sinalar polo menos un de Anónimo, Convidado, ou Real."

#: NewClass.cpp:55
msgid "Addresses can not be empty. Assume '*'?"
msgstr "Os enderezos non poden estar valeiros. Asumir \"*\"?"

#: Permissions.cpp:9
msgid "Special:"
msgstr "Especial:"

#: Permissions.cpp:10
msgid "Owner:"
msgstr "Dono:"

#: Permissions.cpp:11
msgid "Group:"
msgstr "Grupo:"

#: Permissions.cpp:12
msgid "Other:"
msgstr "Outro:"

