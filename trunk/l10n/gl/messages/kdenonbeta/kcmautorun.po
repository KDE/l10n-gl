#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "mvillarino"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "mvillarino@users.sourceforge.net"

#: kcmautorun.cpp:224
msgid "Helpful information about the kcmautorun module."
msgstr "Información útil acerca do módulo kcmautorun."

#. i18n: file kcmautorunbase.ui line 17
#: rc.cpp:3
#, no-c-format
msgid "KDE Autorun"
msgstr "Aczóns Automáticas para KDE"

#. i18n: file kcmautorunbase.ui line 31
#: rc.cpp:6
#, no-c-format
msgid "&Enable KDE Autorun."
msgstr "&Habilitar as Aczóns Automáticas de KDE."

#. i18n: file kcmautorunbase.ui line 37
#: rc.cpp:9
#, no-c-format
msgid ""
"This option sets whether you want KDE to automatically detect media insertions. "
"If you turn it off KDE will never do anything automatically when you insert a "
"disk."
msgstr ""
"Esta opzón indica se KDE debe detectar automaticamente as inserzóns de médios. "
"Se a desmarca KDE non fará nada cando insira un disco."

#. i18n: file kcmautorunbase.ui line 45
#: rc.cpp:12
#, no-c-format
msgid "Multimedia Disks"
msgstr "Discos Multimédia"

#. i18n: file kcmautorunbase.ui line 64
#: rc.cpp:15
#, no-c-format
msgid "&Disk type:"
msgstr "Tipo de &Disco:"

#. i18n: file kcmautorunbase.ui line 89
#: rc.cpp:18
#, no-c-format
msgid ""
"This is the type of media that you would like to configure an action for below."
msgstr "Este é o tipo de medio para o que quer configurar en baixo unha aczón."

#. i18n: file kcmautorunbase.ui line 114
#: rc.cpp:21
#, no-c-format
msgid "Action To Take Upon Detection"
msgstr "Aczón a Facer Após a Deteczón"

#. i18n: file kcmautorunbase.ui line 133
#: rc.cpp:24
#, no-c-format
msgid "These are the actions the KDE knows about. Please select one."
msgstr "Estas son as aczóns que KDE coñece. Escolla unha."

#. i18n: file kcmautorunbase.ui line 143
#: rc.cpp:27
#, no-c-format
msgid "Data Disks"
msgstr "Discos de Dados"

#. i18n: file kcmautorunbase.ui line 154
#: rc.cpp:30
#, no-c-format
msgid "Automatically &mount device (recommended)."
msgstr "&Montar automaticamente o dispositivo (recomendado)."

#. i18n: file kcmautorunbase.ui line 157
#: rc.cpp:33
#, no-c-format
msgid ""
"Enabling this option will mean that a data disk's files will automatically be "
"made available when you insert the disk. This must be enabled for several other "
"useful features, below."
msgstr ""
"Se sinala esta opzón os ficheiros dos discos de dados serán postos "
"automaticamente á sua disposizón. Isto debe estar sinalado para outras "
"funcionalidades, mais embaixo."

#. i18n: file kcmautorunbase.ui line 193
#: rc.cpp:36
#, no-c-format
msgid "Open a &browsing window insde the device."
msgstr "Abrir un &navegador no dispositivo."

#. i18n: file kcmautorunbase.ui line 196
#: rc.cpp:39
#, no-c-format
msgid ""
"Enabling this feature means KDE will automatically open an appropriate browser "
"window when you insert media that contain files."
msgstr ""
"Se sinala esta opzón KDE abrirá automaticamente unha fiestra do navegador cando "
"insira un dispositivo que conteña ficheiros."

#. i18n: file kcmautorunbase.ui line 234
#: rc.cpp:42
#, no-c-format
msgid "Open a &terminal session inside the device."
msgstr "Abrir unha &terminal no dispositivo."

#. i18n: file kcmautorunbase.ui line 237
#: rc.cpp:45
#, no-c-format
msgid ""
"Enabling this option means KDE will open a Konsole when you insert media that "
"contain files."
msgstr ""
"Se sinala esta opzón KDE abrirá unha Konsole cando insira un dispositivo que "
"conteña ficheiros."

#. i18n: file kcmautorunbase.ui line 275
#: rc.cpp:48
#, no-c-format
msgid "Allow automatic starting of a &program disk (recommended)."
msgstr "Permitir a execuzón automática dun &programa no disco (recomendado)."

#. i18n: file kcmautorunbase.ui line 278
#: rc.cpp:51
#, no-c-format
msgid ""
"Enabling this option means the KDE will automatically start programs on some "
"disks. Such disks include some game and application disks."
msgstr ""
"Se sinala esta opzón KDE iniciará automaticamente programas nalguns discos. "
"Tais discos incluen algun xogos e discos de aplicazóns."

#. i18n: file kcmautorunbase.ui line 316
#: rc.cpp:54
#, no-c-format
msgid "Allow automatic starting of single audio/&video content (recommended)."
msgstr "Permitir o início automático de audio/&vídeo (recomendado)."

#. i18n: file kcmautorunbase.ui line 319
#: rc.cpp:57
#, no-c-format
msgid ""
"Enabling this option means the KDE will automatically start audio/video on "
"disks that have one such media file on them."
msgstr ""
"Se sinala esta opzón KDE iniciará automaticamente o audio/vídeo do disco que "
"teña un ficheiro de medios nel."

#. i18n: file kcmautorunbase.ui line 332
#: rc.cpp:60
#, no-c-format
msgid "Maintain an &icon on the desktop while the disk is inserted."
msgstr "Pór un &ícone no escritório mentres o disco estexa inserido."

#. i18n: file kcmautorunbase.ui line 335
#: rc.cpp:63
#, no-c-format
msgid ""
"Enabling this option will make KDE put an appropriate icon on your desktop when "
"you insert media that contain files. It is removed when you remove the medium "
"in question."
msgstr ""
"Se sinala esta opzón KDE porá un ícone no escritório cando insira dispositivos "
"que conteñan ficheiros. Será eliminado cando retire o dispositivo en cuestión."
