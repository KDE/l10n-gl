#. i18n: file fieldeditordialog.ui line 253
#: rc.cpp:97
#, no-c-format
msgid ""
"<h3>DataKiosk Simple Equation Grammar</h3>\n"
"\n"
"<h3>Possible Variables:</h3>\n"
"&nbsp;&nbsp;&nbsp;[current_date]\n"
"[current_time]\n"
"[current_datetime]\n"
"[f:table.field]\n"
"\n"
"<h3>Possible Constants:</h3>\n"
"&nbsp;&nbsp;&nbsp;[#:integer]\n"
"[\"some string\"]\n"
"\n"
"<h3>Possible Operators:</h3>\n"
"&nbsp;&nbsp;&nbsp;<b>'+'</b>&nbsp;&nbsp;&nbsp;<i>addition,</i> valid for "
"numbers and strings<br>\n"
"&nbsp;&nbsp;&nbsp;<b>'-'</b>&nbsp;&nbsp;&nbsp;<i>subtraction,</i> valid for "
"numbers, times, dates, and datetimes<br>\n"
"&nbsp;&nbsp;&nbsp;<b>'*'</b>&nbsp;&nbsp;&nbsp;<i>multiplication,</i> valid "
"for numbers<br>\n"
"&nbsp;&nbsp;&nbsp;<b>'/'</b>&nbsp;&nbsp;&nbsp;<i>division,</i> valid for "
"numbers<br>\n"
"\n"
"<h3>Example: </h3>\n"
"&nbsp;&nbsp;&nbsp;[current_date] - [f:table.some_other_date] + [\" days\"]"
msgstr ""
"<h3>Gramática de Ecuazóns Simples de DataKiosk</h3>\n"
"\n"
"<h3>Variábeis Posíbeis:</h3>\n"
"&nbsp;&nbsp;&nbsp;[current_date]\n"
"[current_time]\n"
"[current_datetime]\n"
"[f:táboa.campo]\n"
"\n"
"<h3>Constantes Posíbeis:</h3>\n"
"&nbsp;&nbsp;&nbsp;[#:inteiro]\n"
"[\"algun texto\"]\n"
"\n"
"<h3>Operadores Posíbeis:</h3>\n"
"&nbsp;&nbsp;&nbsp;<b>'+'</b>&nbsp;&nbsp;&nbsp;<i>suma,</i> "
"válida para números e texto<br>\n"
"&nbsp;&nbsp;&nbsp;<b>'-'</b>&nbsp;&nbsp;&nbsp;<i>resta,</i> "
"válida para números, datas, horas e instantes temporais<br>\n"
"&nbsp;&nbsp;&nbsp;<b>'*'</b>&nbsp;&nbsp;&nbsp;<i>multiplicazón,</i> "
"válida para números<br>\n"
"&nbsp;&nbsp;&nbsp;<b>'/'</b>&nbsp;&nbsp;&nbsp;<i>división,</i> "
"válida para números<br>\n"
"\n"
"<h3>Exemplo: </h3>\n"
"&nbsp;&nbsp;&nbsp;[current_date] - [f:táboa.outra data] + [\" dias\"]"

