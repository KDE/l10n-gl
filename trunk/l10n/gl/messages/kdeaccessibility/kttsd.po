msgid "Current Sentence"
msgstr "Frase Actual"

#: kttsjobmgr/kttsjobmgr.cpp:288
msgid "<p>The text of the sentence currently speaking.</p>"
msgstr "<p>O texto da frase a ser sintetizada agora.</p>"

