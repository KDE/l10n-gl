#: kcmmediacontrol.cpp:197
msgid ""
"<h1>MediaControl</h1> This module allows you to configure the MediaControl "
"applet for KDE's panel."
msgstr ""
"<h1>Control multimedios</h1> Este módulo te permite configurar applet do "
"Control multimedios para o panel de KDE."

#: rc.cpp:1
msgid "KCMMediaControlWidget"
msgstr "KCMMediaControlWidget"

#: rc.cpp:4
msgid "General"
msgstr "Xeral"

#: rc.cpp:5
msgid "Media-Player"
msgstr "Reprodutor multimedios"

#: rc.cpp:6
msgid "Select the multimedia-player you are using in this box"
msgstr "Selecciona o reproductor multimedios que empregarás nesta caixa"

#: rc.cpp:8
msgid "Mousewheel scrolling amount:"
msgstr "Cantidade de desplazamento da roda do rato:"

#: rc.cpp:9
msgid "Sets the amount a mousewheel will scroll in the current file"
msgstr ""
"Estabelece a cantidade que desprazará un movemento da roda do rato no ficheiro "
"actual"

#: rc.cpp:10
msgid "Themes"
msgstr "Temas"

#: rc.cpp:11
msgid "Use themes"
msgstr "Empregar temas"

#: rc.cpp:12
msgid "default"
msgstr "por defecto"

#: rc.cpp:13
msgid "Preview"
msgstr "Previsualización"

#: rc.cpp:14
msgid "Shows you how the selected theme will look"
msgstr "Amosar como quedará a decoración seleccionada"

