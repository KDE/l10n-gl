#: kamion.cpp:68
msgid "<h1>Welcome to Kamion!</h1>The user state migration tool for KDE."
msgstr ""
"<h1>Benvido a Kamion!</h1>A ferramenta de migrazón do estado do usuário "
"para KDE."

#: kamion.cpp:71
msgid "What would you like to do?"
msgstr "Que desexa facer?"

#: kamion.cpp:72
msgid "Package my data for transport"
msgstr "Empacotar os meus dados para transportá-los"

#: kamion.cpp:74
msgid "Unpack transported data"
msgstr "Desempacotar dados transportados"

#: kamion.cpp:87
msgid "Welcome"
msgstr "Benvido"

#: kamion.cpp:100
msgid "Please wait while Kamion..."
msgstr "Espere por favor mentres Kamion..."

#: kamion.cpp:117
msgid "Please wait..."
msgstr "Aguarde por favor..."

#: kamion.cpp:129 kamion.cpp:183
msgid "Select all the resources you wish to move"
msgstr "Escolla todos os recursos que desexa mover"

#: kamion.cpp:142 kamion.cpp:161
msgid "Resources"
msgstr "Recursos"

#: kamion.cpp:155
msgid "<h2>Thank you for using Kamion!<h2>"
msgstr "<h2>Grazas por usar Kamion!<h2>"

#: kamion.cpp:181
msgid "Please wait while Kamion locates your resouces..."
msgstr "Espere por favor mentres Kamion localiza os seus recursos..."

#: kamion.cpp:182
msgid "Please wait while Kamion packs your resouces..."
msgstr "Espere por favor mentres Kamion empacota os seus recursos..."

#: kamion.cpp:189
msgid "Please wait while Kamion unpacks your resouces..."
msgstr "Espere por favor mentres Kamion desempacota os seus recursos..."

#: kamion.cpp:190
msgid "Please wait while Kamion installs your resouces..."
msgstr "Espere por favor mentres Kamion instala os seus recursos..."

#: kamion.cpp:191
msgid "Select the resources you wish to unpack"
msgstr "Escolla os recursos que desexa desempacotar"

#: kamion.cpp:192 kamion.cpp:215
msgid "*.kamion|Kamion files (*.kamion)"
msgstr "*.kamion|Arquivos de Kamion (*.kamion)"

#: kamion.cpp:192
msgid "Open file dialog"
msgstr "Diálogo para abrir un arquivo"

#: kamion.cpp:215
msgid "Save file dialog"
msgstr "Diálogo de gravazón do arquivo"

#: main.cpp:30
msgid "User State Migration Tool"
msgstr "Ferramenta de Migrazón do Estado do Usuário"

#: main.cpp:43
msgid "Kamion"
msgstr "Kamion"

