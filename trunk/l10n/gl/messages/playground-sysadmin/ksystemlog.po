#: ksystemlog.cpp:184 ksystemlog.cpp:368
msgid "Create a new tab"
msgstr "Criar unha nova pestana"

#: ksystemlog.cpp:185 ksystemlog.cpp:369
msgid "Creates a new tab which can display another log."
msgstr "Cria unha nova pestana que poderá mostrar outro rexisto."

#: ksystemlog.cpp:190 ksystemlog.cpp:372
msgid "Close the current tab"
msgstr "Pechar a pestana actual"

#: ksystemlog.cpp:191 ksystemlog.cpp:373
msgid "Closes the current tab."
msgstr "Pecha a pestana actual."

#: ksystemlog.cpp:306
msgid "Open a file in KSystemLog"
msgstr "Abrir un ficheiro en KSystemLog"

#: ksystemlog.cpp:307
msgid "Opens a file in KSystemLog and displays its content in the current tab."
msgstr ""
"Abre un ficheiro en KSystemLog e mostra o seu contido na pestana actual."

#: ksystemlog.cpp:310
msgid "&Print selection..."
msgstr "Im&primir a seleczón..."

#: ksystemlog.cpp:311
msgid "Print the selection"
msgstr "Imprime os dados escollidos"

#: ksystemlog.cpp:312
msgid ""
"Prints the selection. Simply select the important lines and click on this "
"menu entry to print the selection."
msgstr ""
"Imprime os dados escollidos. Basta escoller as liñas importantes e premer "
"neste ítem do menu para enviar a seleczón á impresora."

#: ksystemlog.cpp:318
msgid "Save the selection to a file"
msgstr "Gravar a seleczón nun ficheiro"

#: ksystemlog.cpp:319
msgid ""
"Saves the selection to a file. This action is useful if you want to create "
"an attachment or a backup of a particular log."
msgstr ""
"Grava a seleczón nun ficheiro. Esta aczón é útil se quer criar un anexo ou "
"unha cópia de seguridade dun rexisto en particular."

#: ksystemlog.cpp:323
msgid "Quit KSystemLog"
msgstr "Sair de KSystemLog"

#: ksystemlog.cpp:324
msgid "Quits KSystemLog."
msgstr "Sai de KSystemLog."

#: ksystemlog.cpp:327
msgid "Copy the selection to the clipboard"
msgstr "Copiar a seleczón para o porta-retallos"

#: ksystemlog.cpp:328
msgid ""
"Copies the selection to the clipboard. This action is useful if you want to "
"paste the selection in a chat or an email."
msgstr ""
"Copia a seleczón para o porta-retallos. Esta aczón é útil se quer apegar a "
"seleczón nunha conversa ou nunha mensaxe de email."

#: ksystemlog.cpp:331
msgid "Ex&pand All"
msgstr "Ex&pandir todo"

#: ksystemlog.cpp:332
msgid "Expand all categories"
msgstr "Expandir todas as categorias"

#: ksystemlog.cpp:333
msgid ""
"<qt>This action opens all main categories. This is enabled only if an option "
"has been selected in the <b>Group By</b> menu.</qt>"
msgstr ""
"<qt>Esta aczón abre todas as categorias principais. Isto só se activa se "
"tenescollida unha opzón no menu <b>Agrupar Por</b>.</qt>"

#: ksystemlog.cpp:336
msgid "Col&lapse All"
msgstr "Reco&ller todo"

#: ksystemlog.cpp:337
msgid "Collapse all categories"
msgstr "Pecha (recolle) todas as categorias"

#: ksystemlog.cpp:338
msgid ""
"<qt>This action closes all main categories. This is enabled only if an "
"option has been selected in the <b>Group By</b> menu.</qt>"
msgstr ""
"<qt>Esta aczón pecha todas as categorias principais. Isto só se activa se "
"ten escollida unha opzón no menu <b>Agrupar Por</b>.</qt>"

#: ksystemlog.cpp:341
msgid "&Email Selection..."
msgstr "Enviar a Seleczón por &EMail..."

#: ksystemlog.cpp:342
msgid "Send the selection by mail"
msgstr "Enviar a seleczón via correo electrónico"

#: ksystemlog.cpp:343
msgid ""
"Sends the selection by mail. Simply select the important lines and click on "
"this menu entry to send the selection to a friend or a mailing list."
msgstr ""
"Enviar a seleczón via correo electrónico. Basta escoller as liñas "
"importantes e premer nesta entrada do menu para enviar a seleczón a un amigo "
"ou unha lista de correo."

#: ksystemlog.cpp:346
msgid "&Add Log Entry..."
msgstr "&Engadir unha entrada no Rexisto..."

#: ksystemlog.cpp:347
msgid "Add a log entry to the log system"
msgstr "Engade unha entrada ao sistema de rexisto"

#: ksystemlog.cpp:348
msgid ""
"This action will open a dialog which lets you send a message to the log "
"system."
msgstr ""
"Esta aczón abrirá unha fiestra que lle permite enviar unha mensaxe ao "
"sistema de rexisto."

#: ksystemlog.cpp:351
msgid "Select all lines of the current log"
msgstr "Escoller todas as liñas do rexisto actual"

#: ksystemlog.cpp:352
msgid ""
"Selects all lines of the current log. This action is useful if you want, for "
"example, to save all the content of the current log in a file."
msgstr ""
"Escolle todas as liñas do rexisto actual. Esta aczón é útil se quer, por "
"exemplo, guardar todo o contido do rexisto actual nun ficheiro."

#: ksystemlog.cpp:358
msgid "Show &Filter Bar"
msgstr "Mostrar a Barra do &Filtro"

#: ksystemlog.cpp:367
msgid "&New Tab"
msgstr "&Nova Pestana"

#: ksystemlog.cpp:371
msgid "&Close Tab"
msgstr "Pe&char a Pestana"

#: ksystemlog.cpp:375
msgid "&Duplicate Tab"
msgstr "&Duplicar a Pestana"

#: ksystemlog.cpp:376
msgid "Duplicate the current tab"
msgstr "Duplicar a pestana actual"

#: ksystemlog.cpp:377
msgid "Duplicates the current tab."
msgstr "Duplica a pestana actual."

#: ksystemlog.cpp:379
msgid "Move Tab &Left"
msgstr "Mover a Pestana para a Es&querda"

#: ksystemlog.cpp:380
msgid "Move the current tab to the left"
msgstr "Desprazar a pestana actual para a esquerda"

#: ksystemlog.cpp:381
msgid "Moves the current tab to the left."
msgstr "Despraza a pestana actual para a esquerda."

#: ksystemlog.cpp:383
msgid "Move Tab &Right"
msgstr "Mover a Pestana para a Di&reita"

#: ksystemlog.cpp:384
msgid "Move the current tab to the right"
msgstr "Mover a pestana para a direita"

#: ksystemlog.cpp:385
msgid "Moves the current tab to the right."
msgstr "Move a pestana para a direita."

#: ksystemlog.cpp:389
msgid "Reload the current log"
msgstr "Recarregar o rexisto actual"

#: ksystemlog.cpp:390
msgid ""
"Reloads the current log, if you want to be sure that the view is correctly "
"updated."
msgstr ""
"Carrega de novo o rexisto actual, para ter a certeza de que a vista está "
"actualizada."

#: ksystemlog.cpp:392
msgid "Resu&me Parsing"
msgstr "Co&ntinuar o Procesamento"

#: ksystemlog.cpp:393
msgid "Resume the watching of the current log"
msgstr "Continuar a leitura do rexisto actual"

#: ksystemlog.cpp:394
msgid ""
"Resumes the watching of the current log. This action is only available when "
"the user has already paused the reading."
msgstr ""
"Continua a leitura do rexisto actual. Esta aczón só estará disponíbel cando "
"o usuário teña a leitura en pausa."

#: ksystemlog.cpp:397
msgid "S&top Parsing"
msgstr "&Parar o Procesamento"

#: ksystemlog.cpp:398
msgid "Pause the watching of the current log"
msgstr "Interromper a leitura do rexisto actual"

#: ksystemlog.cpp:399
msgid ""
"Pauses the watching of the current log. This action is particularly useful "
"when the system is writing too many lines to log files, causing KSystemLog "
"to reload too frequently."
msgstr ""
"Interrompe a leitura do rexisto actual. Esta aczón é particularmente útil "
"cando o sistema escrebe demasiadas liñas nos ficheiros de rexisto, facendo "
"que KSystemLog carregue con demasiada frecuéncia."

#: ksystemlog.cpp:401
msgid "&Details"
msgstr "&Detalles"

#: ksystemlog.cpp:402
msgid "Display details on the currently selected line"
msgstr "Mostrar alguns detalles sobre a liña escollida"

#: ksystemlog.cpp:403
msgid ""
"Displays a dialog box which contains details on the currently selected line. "
"You are able to navigate through the logs from this dialog box with the "
"<b>Previous</b> / <b>Next</b> buttons."
msgstr ""
"Mostra un diálogo que contén detalles acerca da liña escollida. Poderá "
"navegar polos rexistos cos botóns <b>Anterior</b> / <b>Seguinte</b>."

#: ksystemlog.cpp:406
msgid "&Enable Detailed Tooltips"
msgstr "Activar as Axudas D&etalladas"

#: ksystemlog.cpp:407
msgid "Disable/Enable the tooltips on the current view"
msgstr "Desactivar/activar as axudas na vista actual"

#: ksystemlog.cpp:408
msgid ""
"Disables/Enables the tooltips displayed when the cursor hovers a log line."
msgstr ""
"Desactiva/activa as axudas mostradas cando o cursor pasa por riba dunha liña "
"do rexisto."

#: ksystemlog.cpp:413
msgid "&Display New Lines"
msgstr "Mostrar as Liñas &Novas"

#: ksystemlog.cpp:414
msgid "Display or not new lines if the log changes"
msgstr "Mostrar ou non as liñas novas se o ficheiro é modificado"

#: ksystemlog.cpp:415
msgid ""
"Displays or not the new lines if the log changes. This option is useful when "
"you want to see an old log lines and that KSystemLog often refreshes the "
"current view."
msgstr ""
"Mostra ou non as liñas novas se o ficheiro é modificado. Esta opzón é útil "
"cando quer ver as liñas antigas dun ficheiro pero KSystemLog actualiza con "
"frecuéncia a vista actual."

#: ksystemlog.cpp:442
msgid "S&ystem Log"
msgstr "Rex&isto do Sistema"

#: ksystemlog.cpp:443
msgid "Display the system log."
msgstr "Mostrar o rexisto do sistema."

#: ksystemlog.cpp:444
msgid ""
"Displays the system log in the current tab. This log is generally used by "
"non-specialized processes (like \"sudo\" or \"fsck\" commands)"
msgstr ""
"Mostra o rexisto do sistema na pestana actual. Este rexisto é xeralmente "
"usado  polos procesos non especializados (como os comandos \"sudo\" ou \"fsck"
"\")"

#: ksystemlog.cpp:450
msgid "&Kernel Log"
msgstr "Rexisto do &Kernel"

#: ksystemlog.cpp:451
msgid "Display the kernel log."
msgstr "Mostrar o rexisto do núcleo."

#: ksystemlog.cpp:452
msgid ""
"<qt>Displays the kernel log in the current tab. This log is only useful for "
"users who want to know why the Kernel does not detect their hardware or what "
"is the cause of the last <i>kernel panic/oops</i>.</qt>"
msgstr ""
"<qt>Mostra o rexisto do núcleo na pestana actual. Este rexisto só é útil "
"para os usuários que quixesen saber por que o núcleo non detecta o seu "
"hardware ou cal é a causa do último <i>kernel panic/oops</i> (erro grave do "
"núcleo).</qt>"

#: ksystemlog.cpp:458
msgid "&Boot Log"
msgstr "Rexisto do Arran&que"

#: ksystemlog.cpp:459
msgid "Display the boot log."
msgstr "Mostrar o rexisto de arranque."

#: ksystemlog.cpp:460
msgid ""
"<qt>Displays the boot log in the current tab. This log is useful if you want "
"to verify if all startup services have been correctly started.</qt>"
msgstr ""
"<qt>Mostra as mensaxes do arranque na pestana actual. Este rexisto é útil "
"para verificar que todos os servizos do arranque fosen iniciados "
"correctamente.</qt>"

#: ksystemlog.cpp:466
msgid "A&uthentication Log"
msgstr "Rexisto de A&utenticazón"

#: ksystemlog.cpp:467
msgid "Display the authentication log."
msgstr "Mostrar o rexisto de autenticazón."

#: ksystemlog.cpp:468
msgid ""
"<qt>Displays the authentication log in the current tab. This log displays "
"all log in made by each user of the system, and can help you to know if "
"someone tried to crack your system.</qt>"
msgstr ""
"<qt>Mostra o rexisto de autenticazón na pestana actual. Este rexisto mostra "
"todas as autenticazóns feitas por cada usuário do sistema, e poderá axudá-lo "
"a saber se alguén tentou atacar o seu sistema.</qt>"

#: ksystemlog.cpp:474
msgid "&Daemons Log"
msgstr "Rexisto dos &Daemons"

#: ksystemlog.cpp:475
msgid "Display the daemons log."
msgstr "Mostrar o rexisto dos daemons."

#: ksystemlog.cpp:476
msgid ""
"<qt>Displays the daemons log in the current tab. The daemons are all "
"processes launched in the background of the system. See this log if you want "
"to know what it occurs in the background of your system.</qt>"
msgstr ""
"<qt>Mostra o rexisto dos daemons na pestana actual. Os daemons son todos "
"eses procesos que son lanzados en segundo-plano no sistema. Consulte este "
"rexisto se desexa saber o que se pasa en segundo-plano no seu sistema.</qt>"

#: ksystemlog.cpp:482
msgid "&Planned Tasks Log"
msgstr "Rexisto de Tarefas &Planexadas"

#: ksystemlog.cpp:483
msgid "Display the planned tasks log (or Cron log)."
msgstr "Mostrar o rexisto de tarefas planexadas (ou rexisto de Cron)."

#: ksystemlog.cpp:484
msgid ""
"<qt>Displays the planned tasks log in the current tab. Cron process is a "
"program in charged of launching planned tasks on your system, like security "
"checks, or auto-restarting of some services. Use this menu to see the last-"
"launched processes.</qt>"
msgstr ""
"<qt>Mostra o rexisto das tarefas planexadas na pestana actual. O proceso "
"Cron é un programa encarregado de lanzar as tarefas planexadas no seu "
"sistema, como as verificazóns de seguridade ou o reinício  automático "
"dalguns servizos. Use este menu para ver os últimos procesos que foron "
"lanzados.</qt>"

#: ksystemlog.cpp:490
msgid "&X.org Log"
msgstr "Rexisto de &X.org"

#: ksystemlog.cpp:491
msgid "Display the X.org log."
msgstr "Mostrar o rexisto de X.org."

#: ksystemlog.cpp:492
msgid ""
"<qt>Displays the X.org log in the current tab. X.org is the service which "
"displays on screen your desktop and manage your graphical hardware. See this "
"log if you want to know why you do not have 3D accelerations or why your "
"input device is not recognized.</qt>"
msgstr ""
"<qt>Mostra o rexisto de X.org na pestana actual. X.org é o servizo de "
"sistema de fiestras e xestiona o seu hardware gráfico. Consulte este rexisto "
"se quer saber por que non ten acelerazón 3D ou os seus dispositivos de "
"entrada non son recoñecidos.</qt>"

#: ksystemlog.cpp:497
msgid "X &Session Log"
msgstr "Rexisto da &Sesión das X"

#: ksystemlog.cpp:498
msgid "Display the X Session log."
msgstr "Mostra o rexisto da sesión das X."

#: ksystemlog.cpp:499
msgid ""
"<qt>Displays the X Session log in the current tab. X Session log is the "
"place where graphical programs write their output. See this log if you want "
"to know why a program has crashed, or why your display manager (KDE, "
"Gnome,...) has not started.</qt>"
msgstr ""
"<qt>Mostra o rexisto da sesión das X. Esta sesión é o lugar onde as "
"aplicazóns gráficas escreben a sua saída. Consulte este rexisto para saber "
"por que un programa se colgou, ou por que o seu escritório (KDE, Gnome, ...) "
"non se iniciou.</qt>"

#: ksystemlog.cpp:506
msgid "&ACPI Log"
msgstr "Rexisto de &ACPI"

#: ksystemlog.cpp:507
msgid "Display the ACPI log."
msgstr "Mostrar o rexisto de ACPI."

#: ksystemlog.cpp:508
msgid ""
"<qt>Displays the ACPI log in the current tab. ACPI is used to manage the "
"hardware components of your computer, like notebook batteries, reset "
"buttons...</qt>"
msgstr ""
"<qt>Mostra o rexisto de ACPI na pestana actual. ACPI é usado para xestionar "
"os componentes de hardware do seu ordenador, como a bateria do portátil, os "
"botóns de arranque, ...</qt>"

#: ksystemlog.cpp:514
msgid "&CUPS Log"
msgstr "Rexisto de &CUPS"

#: ksystemlog.cpp:515
msgid "Display the CUPS log."
msgstr "Mostrar o rexisto de CUPS."

#: ksystemlog.cpp:516
msgid ""
"<qt>Displays the CUPS log in the current tab. CUPS is the program which "
"manage printing on your computer.</qt>"
msgstr ""
"<qt>Mostra o rexisto de CUPS na pestana actual. CUPS é o programa que "
"xestiona as impresoras no seu ordenador.</qt>"

#: ksystemlog.cpp:522
msgid "&CUPS Web Log"
msgstr "Rexisto Web de &CUPS"

#: ksystemlog.cpp:523
msgid "Display the CUPS Web Server Access log."
msgstr "Mostrar o rexisto de acesos ao servidor Web de CUPS."

#: ksystemlog.cpp:524
msgid ""
