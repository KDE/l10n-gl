#: imageeffect_raindrop.cpp:64
msgid "Raindrops"
msgstr "Pingas de Chúvia"

#: imageeffect_raindrop.cpp:66
msgid "A digiKam image plugin to add raindrops to an image."
msgstr "Un plugin de digiKam para engadir pingas de chúvia a unha imaxe."

#: imageeffect_raindrop.cpp:73
msgid "Author and maintainer"
msgstr "Autoria e mantimento"

#: imageeffect_raindrop.cpp:76
msgid "Raindrops algorithm"
msgstr "Algoritmo das pingas de chúvia"

#: imageeffect_raindrop.cpp:79
msgid "Developer"
msgstr "Desenvolvente"

#: imageeffect_raindrop.cpp:84
msgid ""
"<p>This is the preview of the Raindrop effect.<p>Note: if you have "
"previously selected an area in the editor, this will be unaffected by the "
"filter. You can use this method to disable the Raindrops effect on a human "
"face, for example."
msgstr ""
"<p>Esta é a antevisión do efeito de pingas de chuvia.<p>Nota: Se tiña "
"escollida unha área no editor, esta non será afectada polo filtro. Pode usar "
"este método para desabilitar o efeito nunha cara humana, por exemplo."

#: imageeffect_raindrop.cpp:94
msgid "Drop size:"
msgstr "Tamaño da pinga:"

#: imageeffect_raindrop.cpp:99
msgid "<p>Set here the raindrops' size."
msgstr "<p>Defina aqui o tamaño da gota de chúvia."

#: imageeffect_raindrop.cpp:106
msgid "Number:"
msgstr "Número:"

#: imageeffect_raindrop.cpp:111
msgid "<p>This value controls the maximum number of raindrops."
msgstr "<p>Este valor controla o número máximo de pingas de chúvia."

#: imageeffect_raindrop.cpp:118
msgid "Fish eyes:"
msgstr "Ollo de peixe:"

#: imageeffect_raindrop.cpp:123
msgid "<p>This value is the fish-eye-effect optical distortion coefficient."
msgstr "<p>Este valor é o coeficiente de distorzón óptica do efeito de ollo de peixe."

#: imageeffect_raindrop.cpp:224
msgid "RainDrop"
msgstr "Pinga de Chúvia"

#: imageplugin_raindrop.cpp:43
msgid "Raindrops..."
msgstr "Pingas de chúvia..."

#: imageplugin_raindrop.cpp:63
msgid "Add Raindrops to Photograph"
msgstr "Adicionar Pingas de Chúvia á Fotografia"

