#: fontchooserwidget.cpp:239
msgid "Font size<br><i>fixed</i> or <i>relative</i><br>to environment"
msgstr "Tamaño da letra<br><i>fixo</i> ou <i>relativo</i><br>ao ambiente"

#: fontchooserwidget.cpp:241
msgid ""
"Here you can switch between fixed font size and font size to be calculated "
"dynamically and adjusted to changing environment (e.g. widget dimensions, paper "
"size)."
msgstr ""
"Aqui pode alternar entre un tamaño de letra fixo e un tamaño de letra que será "
"calculado dinamicamente e axustado ao ambiente (p.ex. dimensóns do elemento "
"gráfico, tamaño do papel)."

#: fontchooserwidget.cpp:266
msgid "Here you can choose the font size to be used."
msgstr "Aqui pode escoller o tamaño da letra a usar."

#: fontchooserwidget.cpp:291
msgid "Actual Font"
msgstr "Tipo de Letra Utilizado"

#: imageeffect_inserttext.cpp:76 imageeffect_inserttext.cpp:343
msgid "Insert Text"
msgstr "Inserir Texto"

#: imageeffect_inserttext.cpp:78
msgid "A digiKam image plugin for inserting text on a photograph."
msgstr "Un plugin de imaxe de digiKam para inserir texto nunha foto."

#: imageeffect_inserttext.cpp:85
msgid "Author and maintainer"
msgstr "Autoria e mantimento"

#: imageeffect_inserttext.cpp:88
msgid "Developer"
msgstr "Desenvolvente"

#: imageeffect_inserttext.cpp:100
msgid ""
"<p>This is the preview of the text inserted to the image. You can use the mouse "
"for moving the text at the right location."
msgstr ""
"<p>Esta é a antevisión do texto inserido na imaxe. Pode usar o rato para mover "
"o texto ao lugar correcto."

#: imageeffect_inserttext.cpp:112
msgid "<p>Enter here your text to insert on your image."
msgstr "<p>Indique aqui o texto a inserir na sua imaxe."

#: imageeffect_inserttext.cpp:118
msgid "<p>Here you can choose the font to be used."
msgstr "<p>Aqui pode escoller o tipo de letra a usar."

#: imageeffect_inserttext.cpp:130
msgid "Align text to the left"
msgstr "Aliñar o texto á esquerda"

#: imageeffect_inserttext.cpp:136
msgid "Align text to the right"
msgstr "Aliñar o texto á direita"

#: imageeffect_inserttext.cpp:142
msgid "Align text to center"
msgstr "Aliñar o texto ao centro"

#: imageeffect_inserttext.cpp:148
msgid "Align text to a block"
msgstr "Aliñar o texto a un bloco"

#: imageeffect_inserttext.cpp:156
msgid "Rotation:"
msgstr "Rotazón:"

#: imageeffect_inserttext.cpp:158
msgid "None"
msgstr "Nengun"

#: imageeffect_inserttext.cpp:159
msgid "90 Degrees"
msgstr "90 Graus"

#: imageeffect_inserttext.cpp:160
msgid "180 Degrees"
msgstr "180 Graus"

#: imageeffect_inserttext.cpp:161
msgid "270 Degrees"
msgstr "270 Graus"

#: imageeffect_inserttext.cpp:162
msgid "<p>Select here the text rotation to use."
msgstr "<p>Escolla aqui a rotazón do texto a usar."

#: imageeffect_inserttext.cpp:168
msgid "Color:"
msgstr "Cor:"

#: imageeffect_inserttext.cpp:170
msgid "<p>Set here the font color to use."
msgstr "<p>Indique aqui a cor da letra a usar."

#: imageeffect_inserttext.cpp:176
msgid "Add border"
msgstr "Engadir un contorno"

#: imageeffect_inserttext.cpp:177
msgid "Add a solid border around text using current text color"
msgstr "Engade un contorno sólido en torno do texto coa cor de texto actual"

#: imageeffect_inserttext.cpp:179
msgid "Semi-transparent"
msgstr "Semi-transparente"

#: imageeffect_inserttext.cpp:180
msgid "Use semi-transparent text background under image"
msgstr "Usar un fondo semi-transparente do texto sob a imaxe"

#: imageeffect_inserttext.cpp:240
msgid "Enter your text here!"
msgstr "Escreba aqui o seu texto!"

#: imageplugin_inserttext.cpp:42
msgid "Insert Text..."
msgstr "Inserir Texto..."

#: imageplugin_inserttext.cpp:63
msgid "Insert Text on Photograph"
msgstr "Inserir Texto na Fotografia"

