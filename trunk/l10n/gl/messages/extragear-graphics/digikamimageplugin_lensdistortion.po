#: imageeffect_lensdistortion.cpp:75 imageplugin_lensdistortion.cpp:63
msgid "Lens Distortion Correction"
msgstr "Correizón de Distorzón de Lentes"

#: imageeffect_lensdistortion.cpp:77
msgid ""
"A digiKam image plugin to reduce spherical aberration caused by a lens to an "
"image."
msgstr ""
"Un plugin de digiKam para reducir a distorzón esférica que introducen as "
"lentes na imaxe."

#: imageeffect_lensdistortion.cpp:85
msgid "Author and maintainer"
msgstr "Autoria e mantimento"

#: imageeffect_lensdistortion.cpp:88
msgid "Lens distortion correction algorithm."
msgstr "Algoritmo de correizón de distorzón de lentes."

#: imageeffect_lensdistortion.cpp:91
msgid "Developer"
msgstr "Desenvolvente"

#: imageeffect_lensdistortion.cpp:103
msgid ""
"<p>You can see here a thumbnail preview of the distortion correction applied "
"to a cross pattern."
msgstr ""
"<p>Aqui pode ver unha antevisión en miniatura da correizón da distorzón, "
"aplicada a un patrón cruzado."

#: imageeffect_lensdistortion.cpp:109
msgid "Main:"
msgstr "Principal:"

#: imageeffect_lensdistortion.cpp:114
msgid ""
"<p>This value controls the amount of distortion. Negative values correct "
"lens barrel distortion, while positive values correct lens pincushion "
"distortion."
msgstr ""
"<p>Este valor controla a cantidade de distorzón. Os valores negativos "
"corrixen a distorzón por ancheamento da lente, mentres os valores positivos "
"corrixen a distorzón de estreitamento."

#: imageeffect_lensdistortion.cpp:122
msgid "Edge:"
msgstr "Marxe:"

#: imageeffect_lensdistortion.cpp:127
msgid ""
"<p>This value controls in the same manner as the Main control, but has more "
"effect at the edges of the image than at the center."
msgstr ""
"<p>Este valor funciona do mesmo xeito que o control principal, pero ten mais "
"efeito nos extremos da imaxe que no centro."

#: imageeffect_lensdistortion.cpp:135
msgid "Zoom:"
msgstr "Ampliazón:"

#: imageeffect_lensdistortion.cpp:140
msgid "<p>This value rescales the overall image size."
msgstr "<p>Este valor redimensiona o tamaño da imaxe total."

#: imageeffect_lensdistortion.cpp:147
msgid "Brighten:"
msgstr "Iluminar:"

#: imageeffect_lensdistortion.cpp:152
msgid "<p>This value adjust the brightness in image corners."
msgstr "<p>Este valor axusta o brillo nos cantos da imaxe."

#: imageeffect_lensdistortion.cpp:311
msgid "Lens Distortion"
msgstr "Distorzón de Lentes"

#: imageplugin_lensdistortion.cpp:43
msgid "Lens Distortion Correction..."
msgstr "Correizón de Distorzón de Lentes..."

