#: conduits/abbrowserconduit/abbrowser_conduit.desktop:4
msgid ""
"Comment=This conduit syncs the handheld addressbook with KDE's addressbook."
msgstr ""
"Comment=Isto sincroniza o caderno de enderezo do dispositivo co de KDE."

#: conduits/abbrowserconduit/abbrowser_conduit.desktop:26
msgid "Name=Addressbook"
msgstr "Name=Caderno de Enderezos"

#: conduits/docconduit/doc_conduit.desktop:4
msgid "Comment=Adds text files to your handheld, suitable for DOC readers."
msgstr ""
"Comment=Sobe ficheiros de texto ao dispositivo, axeitado para leitores DOC."

#: conduits/docconduit/doc_conduit.desktop:26
msgid "Name=Palm DOC"
msgstr "Name=Palm DOC"

#: conduits/docconduit/kpalmdoc.desktop:4
msgid "Name=KPalmDOC"
msgstr "Name=KPalmDOC"

#: conduits/docconduit/kpalmdoc.desktop:7
msgid "GenericName=PalmDOC Converter"
msgstr "GenericName=Convertedor PalmDOC"

#: conduits/knotes/knotes-conduit.desktop:4
msgid "Comment=This conduit syncs the Memo Pad application with KNotes."
msgstr "Comment=Isto sincroniza a aplicazón Memo Pad con KNotes."

#: conduits/knotes/knotes-conduit.desktop:26
msgid "Name=KNotes / Memos"
msgstr "Name=KNotes / Memos"

#: conduits/malconduit/mal_conduit.desktop:4
msgid "Name=MAL (AvantGo) Conduit"
msgstr "Name=Conduto MAL (AvantGo)"

#: conduits/malconduit/mal_conduit.desktop:24
msgid ""
"Comment=Syncronize AvantGo (or generally a MAL server's content) to the "
"handheld. This allows you to view web-pages offline on the handheld, like your "
"cinema or TV schedule, or any other web page."
msgstr ""
"Comment=Sincroniza AvantGo (en xeral o contido dun servidor MAL) co "
"dispositivo. Isto permite-lle ver páxinas web sen conexón no dispositivo, como "
"a guia de cine ou televisión, ou calquer outra páxina."

#: conduits/memofileconduit/memofile-conduit.desktop:4
msgid "Name=Memo File"
msgstr "Name= Ficheiro Memo"

#: conduits/memofileconduit/memofile-conduit.desktop:27
msgid "Comment=This conduit syncs your handheld memos with a local directory."
msgstr "Comment=Isto sincroniza os memos do dispositivo cun cartafol local."

#: conduits/notepadconduit/notepad-conduit.desktop:4
msgid "Name=NotePad"
msgstr "Name=NotePad"

#: conduits/notepadconduit/notepad-conduit.desktop:14
msgid "Comment=This conduit backs up NotePad drawings to a local folder."
msgstr "Comment=Isto fai unha cópia dos debuxos NotePad a un cartafol local."

#: conduits/null/null-conduit.desktop:4
msgid "Name=NULL"
msgstr "Name=NULL"

#: conduits/null/null-conduit.desktop:7
msgid "Comment=This conduit does nothing."
msgstr "Comment=Este conduto non fai ren."

#: conduits/perlconduit/perl-conduit.desktop:4
msgid "Name=Perl (Sample)"
msgstr "Name=Perl (Mostra)"

#: conduits/perlconduit/perl-conduit.desktop:28
msgid "Comment=This sample conduit runs a Perl interpreter."
msgstr "Comment=Este conduto de mostra executa un intérprete de Perl."

#: conduits/popmail/popmail-conduit.desktop:4
msgid "Comment=Send mail from your handheld through KMail."
msgstr "Comment=Envia o correo desde o seu dispositivo através de KMail."

#: conduits/popmail/popmail-conduit.desktop:26
msgid "Name=Mail"
msgstr "Name=Mail"

#: conduits/pythonconduit/python-conduit.desktop:4
msgid "Name=Python (Sample)"
msgstr "Name=Python (Mostra)"

#: conduits/pythonconduit/python-conduit.desktop:28
msgid "Comment=This sample conduit runs a Python interpreter."
msgstr "Comment=Este conduto de mostra executa un intérprete de Python."

#: conduits/sysinfoconduit/sysinfo_conduit.desktop:4
msgid ""
"Comment=This conduit writes information about your handheld and the sync to a "
"file."
msgstr ""
"Comment=Este conduto escrebe dados do seu dispositivo e da sincronizazón nun "
"ficheiro."

#: conduits/sysinfoconduit/sysinfo_conduit.desktop:26
msgid "Name=System Information"
msgstr "Name=Informazón do Sistema"

#: conduits/timeconduit/time_conduit.desktop:4
msgid "Comment=This conduit sets the time on your handheld from the PC clock."
msgstr "Comment=Isto axusta a data do dispositivo co relóxio do PC."

#: conduits/timeconduit/time_conduit.desktop:26
msgid "Name=Time Synchronization"
msgstr "Name=Sincronizazón da Hora"

#: conduits/vcalconduit/todo-conduit.desktop:4
msgid ""
"Comment=This conduit syncs the ToDo list from your handheld to KOrganizer."
msgstr ""
"Comment=Isto sincroniza a lista de ToDos do dispositico coa de KOrganizer."

#: conduits/vcalconduit/todo-conduit.desktop:26
msgid "Name=ToDos (KOrganizer)"
msgstr "Name=ToDos (KOrganizer)"

#: conduits/vcalconduit/vcal-conduit.desktop:4
msgid "Name=Calendar (KOrganizer)"
msgstr "Name=Calendário (KOrganizer)"

#: conduits/vcalconduit/vcal-conduit.desktop:28
msgid ""
"Comment=This conduit synchronizes your handheld with the KOrganizer datebook."
msgstr "Comment=Isto sincroniza a axenda do dispositivo con de KOrganizer."

#: kpilot/kpilotconduit.desktop:5
msgid "Comment=KPilot Conduit"
msgstr "Comment=Sincronizazóns KPilot"

#: kpilot/kpilot_config.desktop:14
msgid "Name=KPilot Configuration"
msgstr "Name=Configurazón de KPilot"

#: kpilot/kpilot_config.desktop:39
msgid "Comment=KPilot Main Configuration"
msgstr "Comment=Configurazón Principal de KPilot"

#: kpilot/kpilot_config.desktop:63
msgid "Keywords=kpilot,main"
msgstr "Keywords=kpilot,principal"

#: kpilot/kpilotdaemon.desktop:4
msgid "Name=KPilotDaemon"
msgstr "Name=KPilotDaemon"

#: kpilot/kpilot.desktop:4
msgid "Name=KPilot"
msgstr "Name=KPilot"

#: kpilot/kpilot.desktop:7
msgid "GenericName=PalmPilot Tool"
msgstr "GenericName=Sincronizazón con PalmPilot"
