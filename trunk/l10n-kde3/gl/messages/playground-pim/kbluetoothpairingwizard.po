#: kbluetoothpairingwizard.cpp:50
msgid ""
"<qt>Cannot start the <b>%1</b> process."
"<br>Check if the <u><b>%2</b></u> package if installed property. The wizard "
"will now exit.</q>"
msgstr ""
"<qt>Non foi posíbel lanzar o proceso <b>%1</b>. "
"<br>Comprobe que o pacote <u><b>%2</b></u> estexa correctamente instalado. O "
"asistente abortará agora.</q>"

#: kbluetoothpairingwizard.cpp:51
msgid "<qt>Process <b>%1</b> exited with errors. Cannot continue.</qt>"
msgstr ""
"<qt>O proceso <b>%1</b> terminou con erros. Non é posíbel continuar.</qt>"

#: kbluetoothpairingwizard.cpp:87 kbluetoothpairingwizard.cpp:127
msgid "Searching"
msgstr "A procurar"

#: kbluetoothpairingwizard.cpp:87
msgid "Please wait while searching for services"
msgstr "Espere mentres se procuran os servizos"

#: kbluetoothpairingwizard.cpp:127
msgid "Please wait while scanning bluetooth devices"
msgstr "Espere mentres se procurar dispositivos bluetooth"

#: kbluetoothpairingwizard.cpp:265
msgid ""
"<qt>Device name: <b>%1</b>"
"<br>\n"
"                    Bluetooth address: <b>%2</b>"
"<br>\n"
"                    Channel: <b>%3</b> (%4)"
