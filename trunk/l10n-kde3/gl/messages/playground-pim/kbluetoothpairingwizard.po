"<qt>Nome do dispositivo: <b>%1</b>"
"<br>\n"
"                    Enderezo Bluetooth: <b>%2</b>"
"<br>\n"
"                    Canal: <b>%3</b> (%4)"

#: kbluetoothpairingwizard.cpp:327
msgid "<qt>Couldn't open <b>%1</b> for read/write.</b>"
msgstr "<qt>Non foi posíbel abrir <b>%1</b> para ler/escreber.</b>"

#: kbluetoothpairingwizard.cpp:361
msgid ""
"<qt>The device <b>%1</b> with address <b>%2</b> and channel <b>%3 %4</b> "
"is already configured as <b>rfcomm%5</b>.</qt>"
msgstr ""
"<qt>O dispositivo <b>%1</b> con enderezo <b>%2</b> e canal <b>%3%4</b> "
"xa está configurado como <b>rfcomm%5</b>.</qt>"

