#: clients/applet/kdetvapplet.desktop:4
msgid "Name=kdetv Applet"
msgstr "Name=Applet kdetv"

#: clients/applet/kdetvapplet.desktop:37
msgid "Comment=A television for your panel."
msgstr "Comment=Un televisor para o painel."

#: clients/kdetv/kdetv.desktop:6
msgid "Name=kdetv"
msgstr "Name=kdetv"

#: clients/kdetv/kdetv.desktop:10
msgid "GenericName=TV Viewer"
msgstr "GenericName=Televisor"

#: clients/kpart/kdetvpart.desktop:3
msgid "Name=kdetv Part"
msgstr "Name=Componente kdetv"

#: clients/panelextension/kdetvpanelextension.desktop:4
msgid "Name=kdetv Panelextension"
msgstr "Name=Extensión de Painel kdetv"

#: clients/panelextension/kdetvpanelextension.desktop:33
msgid "Comment=A Kicker extension that displays a TV."
msgstr "Comment=Un extensión para Kicker que mostra unha TV."

#: clients/screensaver/kdetvscreensaver.desktop:9
msgid "Name=kdetv Screen Saver"
msgstr "Name=Protector de Pantalla kdetv"

#: clients/screensaver/kdetvscreensaver.desktop:42
msgid "Comment=A screen saver that displays a TV"
msgstr "Comment=Un protector de Pantalla que mostra unha TV"

#: clients/screensaver/kdetvscreensaver.desktop:77
msgid "Name=Setup..."
msgstr "Name=Configurar..."

#: clients/screensaver/kdetvscreensaver.desktop:122
msgid "Name=Display in specified window"
msgstr "Name=Mostrar na fiestra indicada"

#: clients/screensaver/kdetvscreensaver.desktop:162
msgid "Name=Display in root window"
msgstr "Name=Mostrar na fiestra de fondo"

#: plugins/channel/csv/kdetv_csvchannels.desktop:9
msgid "Name=CSV Channel File Plugin"
msgstr "Name=Plugin para Ficheiro de Canais en CSV"

#: plugins/channel/csv/kdetv_csvchannels.desktop:41
msgid ""
"Comment=This stores your channel files in CSV (comma separated variables) "
"format."
msgstr ""
"Comment=Guarda os ficheiros cos canais en formato CSV (valores separados por "
"vírgulas)."

#: plugins/channel/kwintv/kdetv_kwintvchannels.desktop:9
msgid "Name=KWinTV Legacy Channel File Plugin"
msgstr "Name=Plugin para Ficheiro de Canais Legado de KWinTV"

#: plugins/channel/kwintv/kdetv_kwintvchannels.desktop:35
msgid ""
"Comment=This allows you to use your legacy KWinTV format channel files in "
"Kdetv."
msgstr ""
"Comment=Permite-lle utilizar os ficheiros de canais de KWinTV en Kdetv."

#: plugins/channel/xawtv/kdetv_xawtvchannels.desktop:9
msgid "Name=xawtv Channel File Plugin"
msgstr "Name=Plugin para Ficheiro de Canal de xawtv"

#: plugins/channel/xawtv/kdetv_xawtvchannels.desktop:38
msgid "Comment=This loads your xawtv format channel files in kdetv."
msgstr "Comment=Permite-lle utilizar os ficheiros de canais de xawtv en kdetv."

#: plugins/channel/xml/kdetv_xmlchannels.desktop:9
msgid "Name=XML Channel File Plugin"
msgstr "Name=Plugin de Ficheiro de Canal en XML"

#: plugins/channel/xml/kdetv_xmlchannels.desktop:39
msgid ""
"Comment=This stores your channel files in XML format.  This is the standard "
"file format for kdetv."
msgstr ""
"Comment=Guarda os ficheiros cos canais en formato XML.  Este é o formato "
"prederminado de kdetv."

#: plugins/channel/zapping/kdetv_zappingchannels.desktop:9
msgid "Name=Zapping Channel File Plugin"
msgstr "Name=Plugin para Ficheiro de Canal de Zapping"

#: plugins/channel/zapping/kdetv_zappingchannels.desktop:34
msgid ""
"Comment=This loads/stores your channel files in XML format zapping "
"(zapping.sf.net) uses."
msgstr ""
"Comment=Lé/guarda os ficheiros de canais no formato XML que zapping "
"(zapping.sf.net) usa."

#: plugins/filter/bilinear/kdetv_bilinear.desktop:10
msgid "Name=Bilinear Deinterlacing"
msgstr "Name=Desentrelazamento Bi-linear"

#: plugins/filter/bilinear/kdetv_bilinear.desktop:33
#: plugins/filter/linearblend/kdetv_linearblend.desktop:30
msgid "Comment=Low CPU usage, modest quality"
msgstr "Comment=Baixa utilizazón de CPU, calidade modesta"

#: plugins/filter/chromakill/kdetv_chromakill.desktop:10
msgid "Name=Chroma Kill"
msgstr "Name=Eliminazón de Cor"

#: plugins/filter/chromakill/kdetv_chromakill.desktop:28
msgid "Comment=Converts video to black and white"
msgstr "Comment=Converte o vídeo a branco e negro"

#: plugins/filter/colourinversion/kdetv_colourinversion.desktop:10
msgid "Name=Color Inversion"
msgstr "Name=Inversión de Cor"

#: plugins/filter/colourinversion/kdetv_colourinversion.desktop:41
msgid "Comment=Inverts video colors"
msgstr "Comment=Inverte a cor do vídeo"

#: plugins/filter/greedy2frame/kdetv_greedy2frame.desktop:10
msgid "Name=Greedy2Frame Deinterlacing"
msgstr "Name=Desentrelazamento Greedy2Frame"

#: plugins/filter/greedy2frame/kdetv_greedy2frame.desktop:31
#: plugins/filter/greedy/kdetv_greedy.desktop:31
msgid ""
"Comment=Higher CPU usage, good quality (adapted from DScaler www.dscaler.org)"
msgstr ""
"Comment=Alta utilizazón de CPU, calidade boa (adaptado de DScaler "
"www.dscaler.org)"

#: plugins/filter/greedyh/kdetv_greedyh.desktop:10
msgid "Name=Greedy (High Motion) Deinterlacing"
msgstr "Name=Desentrelazamento Greedy (Moito Movimento)"

#: plugins/filter/greedyh/kdetv_greedyh.desktop:32
msgid ""
"Comment=High CPU usage, great quality (adapted from DScaler www.dscaler.org)"
msgstr ""
"Comment=Alta utilizazón de CPU, calidade óptima (adaptado de DScaler "
"www.dscaler.org)"

#: plugins/filter/greedy/kdetv_greedy.desktop:10
msgid "Name=Greedy (Low Motion) Deinterlacing"
msgstr "Name=Desentrelazamento Greedy (Pouco Movimento)"

#: plugins/filter/linearblend/kdetv_linearblend.desktop:10
msgid "Name=Linear Blend Deinterlacing"
msgstr "Name=Desentrelazamento en Mistura Linear"

#: plugins/filter/mirror/kdetv_mirror.desktop:10
msgid "Name=Mirror"
msgstr "Name=Espello"

#: plugins/filter/mirror/kdetv_mirror.desktop:43
msgid "Comment=Mirrors video image"
msgstr "Comment=Espella a imaxe do vídeo"

#: plugins/filter/none/kdetv_none.desktop:10
msgid "Name=No Deinterlacing"
msgstr "Name=Sen Desentrelazamento"

#: plugins/filter/none/kdetv_none.desktop:34
msgid "Comment="
msgstr "Comment="

#: plugins/filter/overscan/kdetv_overscan.desktop:10
msgid "Name=Overscan"
msgstr "Name=Overscan"

#: plugins/filter/overscan/kdetv_overscan.desktop:32
msgid "Comment=Cuts away noise from image borders"
msgstr "Comment=Quita ruído das marxes da imaxe"

#: plugins/filter/sharpness/kdetv_sharpness.desktop:10
msgid "Name=Sharpness"
msgstr "Name=Afiado"

#: plugins/filter/sharpness/kdetv_sharpness.desktop:41
msgid "Comment=Increases sharpness of video image"
msgstr "Comment=Diminue o difuminado da imaxe de vídeo"

#: plugins/filter/tomsmocomp/kdetv_tomsmocomp.desktop:10
msgid "Name=TomsMoComp Deinterlacing"
msgstr "Name=Desentrelazamento TomsMoComp"

#: plugins/filter/tomsmocomp/kdetv_tomsmocomp.desktop:31
msgid ""
"Comment=Very high CPU usage, great quality (adapted from DScaler "
"www.dscaler.org)"
msgstr ""
"Comment=Moi alta utilizazón de CPU, calidade óptima (adaptado de DScaler "
"www.dscaler.org)"

#: plugins/misc/channelsuite/kdetv_channelsuite.desktop:9
msgid "Name=Channelsuite Plugin"
msgstr "Name=Plugin de Conxuntos de Canais"

#: plugins/misc/channelsuite/kdetv_channelsuite.desktop:36
msgid "Comment=Channelsuite management"
msgstr "Comment=Xestión de conxuntos de canais"

#: plugins/misc/simon/kdetv_simon.desktop:9
msgid "Name=Closed Captioning Plugin"
msgstr "Name=Plugin de Títulos Pechados"

#: plugins/misc/simon/kdetv_simon.desktop:34
msgid "Comment=Simon says: \"This provides closed captioning support.\""
msgstr "Comment=Simon di: \"Isto prové suporte para títulos pechados.\""

#: plugins/misc/telex/kdetv_telex.desktop:9
msgid "Name=Teletext Plugin"
msgstr "Name=Plugin de Teletexto"

#: plugins/misc/telex/kdetv_telex.desktop:38
msgid "Comment=Shows Telext pages"
msgstr "Comment=Mostra as páxinas de teletexto"

#: plugins/mixer/alsa/kdetv_alsa.desktop:10
msgid "Name=ALSA Mixer Plugin"
msgstr "Name=Plugin de Mistura ALSA"

#: plugins/mixer/alsa/kdetv_alsa.desktop:40
msgid "Comment=This provides support for ALSA mixer devices."
msgstr "Comment=Dá soporte aos dispositivos de mistura ALSA."

#: plugins/mixer/oss/kdetv_oss.desktop:10
msgid "Name=OSS Mixer Plugin"
msgstr "Name=Plugin de Mistura OSS"

#: plugins/mixer/oss/kdetv_oss.desktop:40
msgid "Comment=This provides support for OSS audio mixer devices."
msgstr "Comment=Dá soporte aos dispositivos de mistura de áudio OSS."

#: plugins/osd/elegant/kdetv_elegant.desktop:9
msgid "Name=Elegant On-Screen Display Plugin"
msgstr "Name=Plugin de Visualizazón Elegante na Pantalla"

#: plugins/osd/elegant/kdetv_elegant.desktop:34
msgid "Comment=This provides an elegant on-screen display."
msgstr "Comment=Isto proporciona unha visualizazón elegante na pantalla."

#: plugins/osd/haze/kdetv_haze.desktop:9
msgid "Name=Haze On-Screen Display Plugin"
msgstr "Name=Plugin de Visualizazón Nebulosa na Pantalla"

#: plugins/osd/haze/kdetv_haze.desktop:33
msgid "Comment=This provides a simple on-screen display."
msgstr "Comment=Unha visualizazón simples na pantalla."

#: plugins/vbi/libzvbidecoder/kdetv_libzvbidecoder.desktop:10
msgid "Name=libZVBI VBI Decoder Plugin"
msgstr "Name=Plugin de Descodificazón VBI de libZVBI"

#: plugins/vbi/libzvbidecoder/kdetv_libzvbidecoder.desktop:36
msgid "Comment=libZVBI VBI decoding backend."
msgstr "Comment=A infra-estrutura de descodificazón de VBI da libZVBI."

#: plugins/video/v4l2/kdetv_v4l2.desktop:9
msgid "Name=Video4Linux2 Plugin"
msgstr "Name=Plugin de Video4Linux2"

#: plugins/video/v4l2/kdetv_v4l2.desktop:43
msgid ""
"Comment=This enables you to view video streams from a Video4Linux2 device."
msgstr "Comment=Permite-lle ver vídeo dun dispositivo Video4Linux2."

#: plugins/video/v4l/kdetv_v4l.desktop:9
msgid "Name=Video4Linux Plugin"
msgstr "Name=Plugin de Video4Linux"

#: plugins/video/v4l/kdetv_v4l.desktop:42
msgid ""
"Comment=This enables you to view video streams from a Video4Linux device."
msgstr "Comment=Permite-lle ver vídeo dun dispositivo Video4Linux."

#: plugins/video/xv/kdetv_xv.desktop:9
msgid "Name=XVideo Plugin"
msgstr "Name=Plugin de XVideo"

#: plugins/video/xv/kdetv_xv.desktop:44
msgid ""
"Comment=This enables you to view video streams from the XVideo subsystem of an "
"X11 server.  It requires Xv support for your tuner."
msgstr ""
"Comment=Permite-lle ver vídeo do subsistema XVideo do servidor X11. Precisa de "
"soporte Xv no seu sintonizador."
