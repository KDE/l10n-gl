#: konq_run.cc:145
msgid ""
"There appears to be a configuration error. You have associated Konqueror with "
"%1, but it cannot handle this file type."
msgstr ""
"Parece haber un erro de configurazón. Asociou konqueror con %1, pero non "
"consegue manexar con este tipo de ficheiro."

#: konq_run.cc:266
msgid "Do you really want to execute '%1'?"
msgstr "Desexa realmente executar '%1'?"

#: konq_run.cc:280
msgid "Open '%1' using '%2'?"
msgstr "Abrir '%1' utilizando '%2'?"

#: konq_run.cc:282
msgid "Open '%1'?"
msgstr "Abrir '%1'?"

#: konq_run.cc:285
msgid "Save to Disk"
msgstr "Guardar no Disco"
