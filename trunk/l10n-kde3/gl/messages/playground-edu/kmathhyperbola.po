#: hyperbola.cpp:237
msgid ""
"The Hyperbola and Parabola touch here\n"
"(%1)|(%2)"
msgstr ""
"A Hipérbole e a Parábola tocan-se aqui\n"
"(%1)|(%2)"

#: hyperbola.cpp:257
msgid ""
"They touch here\n"
"(%1)|(%2)\n"
"and here\n"
"(%3)|(%4)\n"
"and here\n"
"(%5)|(%6)"
msgstr ""
"Tocan-se aqui\n"
"(%1)|(%2)\n"
"aqui\n"
"(%3)|(%4)\n"
"e aqui\n"
"(%5)|(%6)"

#: hyperbola.cpp:278
msgid ""
"The Hyperbola and line touch here\n"
"(%1|%2)"
msgstr ""
"A hipérbole e a liña tocan-se aqui\n"
"(%1|%2)"

#: hyperbola.cpp:284
msgid "The Hyperbola and line do not intersect"
msgstr "A hipérbole e a liña non se intersectan"

#: hyperbola.cpp:301
msgid "The Hyperbola and line intersect here (%1|%2) and here (%3|%4)"
msgstr "A hipérbole e a liña intersectan-se aqui (%1|%2) e aqui (%3|%4)"

