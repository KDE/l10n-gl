#: stations.cpp:519
msgid ""
"<center><b>This is the station database</b></center>"
"<p> <b>Click </b>to select a station that you can play or record."
"<br> <b>Double click </b>to see information about the current station."
"<br>  <b>Right click </b>to edit, delete or save the current station to "
"favorites."
