msgstr "O campo UIN non é un número inteiro válido"

#: registration/regwin.cpp:388
msgid "The field UIN is out of range (1001-2147483646)"
msgstr "O campo UIN está fora de rango (1001-2147483646)"

#: registration/regwin.cpp:393 registration/regwin.cpp:425
msgid "You must supply a password"
msgstr "Ten que indicar un contrasinal"

#: registration/regwin.cpp:412
msgid ""
"You've entered no details.\n"
"Users won't be able to find\n"
"you except by your UIN.\n"
"Enter one or more details?"
msgstr ""
"Non introduxo nengun detalle.\n"
"Os usuários non o poderán\n"
" localizar a non ser polo seu UIN.\n"
"Quer indicar un ou máis detalles?"

#: registration/regwin.cpp:430
msgid "Confirm password does not match"
msgstr "A confirmazón do contrasinal non corresponde"

#: registration/regwin.cpp:434
msgid ""
"It is very important to remember your password.\n"
"We recommend to write it down and put it in a secure\n"
"place to prevent unauthorized access to your account.\n"
"Continue with registration?"
msgstr ""
"É moi importante que te lembre o seu contrasinal.\n"
"Recomendamos que a escreba e a poña nun lugar\n"
"seguro para evitar o aceso non autorizado á sua\n"
"conta. Continuar co rexisto?"

#: registration/regwin.cpp:630
msgid ""
"Incorrect password!\n"
msgstr ""
"Contrasinal errado!\n"

#: registration/regwin.cpp:636
msgid ""
"Invalid UIN!\n"
msgstr ""
"UIN non válido!\n"
