#: kmagzoomview.cpp:116
msgid ""
"This is the main window which shows the contents of the selected region. The "
"contents will be magnified according to the zoom level that is set."
msgstr ""
"Esta é a fiestra principal que amosa o contido do área seleccionada. O "
"contido amosarase ampliado de acordo co nivel de ampliación seleccionado."

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Gonzalo H. Castilla"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "ttxzgl@yahoo.es"

#: main.cpp:37
msgid "File to open"
msgstr "Ficheiro a abrir"

#: kmagselrect.cpp:204 main.cpp:45
msgid "KMagnifier"
msgstr "KMagnifier"

#: main.cpp:46
msgid "Screen magnifier for the K Desktop Environment (KDE)"
msgstr "Ampliador da pantalla para o K Desktop Environment (KDE)"

#: main.cpp:53
msgid "Rewrite and current maintainer"
msgstr "Reescritura e mantedor actual"

#: main.cpp:56
msgid "Original idea and author (KDE1)"
msgstr "Idea orixinal e autor (KDE1)"

#: main.cpp:58
msgid ""
"Rework of the user interface, improved selection window, speed optimisation, "
"rotation, bug fixes"
msgstr ""
"Melloras na interface de usuario, fiestra de selección mellorada, "
"optimizacións na velocidade, rotación, correción de erros"

#: main.cpp:59
msgid "Some tips"
msgstr "Algúns consellos"

#: kmagselrect.cpp:204
msgid "Selection Window"
msgstr "Fiestra de selección"

#: kmag.cpp:90
msgid "&Very Low"
msgstr "&Moi baixa"

#: kmag.cpp:90
msgid "&Low"
msgstr "&Baixa"

#: kmag.cpp:90
msgid "&Medium"
msgstr "&Mediana"

#: kmag.cpp:90
msgid "&High"
msgstr "&Alta"

#: kmag.cpp:90
msgid "V&ery High"
msgstr "M&oi alta"

#: kmag.cpp:98
msgid "&No Rotation (0°)"
msgstr "Sen rotació&n (0°)"

#: kmag.cpp:98
msgid "&Left (90°)"
msgstr "Es&querda (90°)"

#: kmag.cpp:98
msgid "&Upside Down (180°)"
msgstr "&Invertir (180°)"

#: kmag.cpp:98
msgid "&Right (270°)"
msgstr "&Dereita (270°)"

#: kmag.cpp:127
msgid "New &Window"
msgstr "Nova &fiestra"

#: kmag.cpp:129
msgid "Open a new KMagnifier window"
msgstr "Abrir unha nova fiestra de KMagnifier"

#: kmag.cpp:131
msgid "&Stop"
msgstr "&Parar"

#: kmag.cpp:133
msgid "Click to stop window refresh"
msgstr "Preme para deter a actualización da fiestra"

#: kmag.cpp:134
msgid ""
"Clicking on this icon will <b>start</b> / <b>stop</b>  updating of the "
"display. Stopping the update will zero the processing power  required (CPU "
"usage)"
msgstr ""
"O premer nesta icona <b>iniciará</b> / <b>deterase</b> a actualización da "
"pantalla. Se se detén a actualización, o emprego da potencia de proceso da "
"CPU será cero."

#: kmag.cpp:138
msgid "&Save Snapshot As..."
msgstr "&Gardar captura como..."

#: kmag.cpp:140
msgid "Saves the zoomed view to an image file."
msgstr "Garda a vista ampliada nun ficheiro de imaxe."

#: kmag.cpp:141
msgid "Save image to a file"
msgstr "Gardar a imaxe nun ficheiro"

#: kmag.cpp:144
msgid "Click on this button to print the current zoomed view."
msgstr "Prema neste botón para imprimir a vista ampliada actual."

#: kmag.cpp:147 kmag.cpp:148
msgid "Quits the application"
msgstr "Pecha a aplicación"

#: kmag.cpp:151
msgid ""
"Click on this button to copy the current zoomed view to the clipboard which "
"you can paste in other applications."
msgstr ""
"Prema neste botón para copiar a vista ampliada o portarretallos para poder "
"pegala noutras aplicacións."

#: kmag.cpp:152
msgid "Copy zoomed image to clipboard"
msgstr "Copiar a imaxe ampliada no portarretallos"

#: kmag.cpp:154
msgid "Show &Menu"
msgstr "Amosar &menú"

#: kmag.cpp:157
msgid "Hide &Menu"
msgstr "Agochar &menú"

#: kmag.cpp:159
msgid "Show Main &Toolbar"
msgstr "A&mosar menú principal"

#: kmag.cpp:162
msgid "Hide Main &Toolbar"
msgstr "A&gochar menú principal"

#: kmag.cpp:164
msgid "Show &View Toolbar"
msgstr "Amosar menú &ver"

#: kmag.cpp:167
msgid "Hide &View Toolbar"
msgstr "Agochar menú &ver"

#: kmag.cpp:169
msgid "Show &Settings Toolbar"
msgstr "Amosar &menú principal"

#: kmag.cpp:172
msgid "Hide &Settings Toolbar"
msgstr "Agochar &menú de configuración"

#: kmag.cpp:175
msgid "&Follow Mouse Mode"
msgstr "&Seguir ó rato"

#: kmag.cpp:177
msgid "Magnify around the mouse cursor"
msgstr "Ampliar ó redor do cursor do rato"

#: kmag.cpp:178
msgid "If selected, the area around the mouse cursor is magnified"
msgstr "Se a selecciona, a área arredor do cursor do rato será ampliada"

#: kmag.cpp:180
msgid "Se&lection Window Mode"
msgstr "&Fiestra de selección"

#: kmag.cpp:182
msgid "Show a window for selecting the magnified area"
msgstr "Amosar unha fiestra para selecionar a área a ampliar"

#: kmag.cpp:184
msgid "&Whole Screen Mode"
msgstr "&Modo pantalla completa"

#: kmag.cpp:186
msgid "Magnify the whole screen"
msgstr "Ampliar a pantalla completa"

#: kmag.cpp:187
msgid "Click on this button to fit the zoom view to the zoom window."
msgstr "Prema neste botón para axustar a vista ampliada ó tamaño da fiestra."

#: kmag.cpp:189
msgid "Hide Mouse &Cursor"
msgstr "Agochar o &cursor do rato"

#: kmag.cpp:192
msgid "Show Mouse &Cursor"
msgstr "Amosar o &cursor do rato"

#: kmag.cpp:194
msgid "Hide the mouse cursor"
msgstr "Agochar o cursor do rato"

#: kmag.cpp:197
msgid "Click on this button to <b>zoom-in</b> on the selected region."
msgstr "Prema neste botón para <b>ampliar</b> a área seleccionada."

#: kmag.cpp:201
msgid "Select the zoom factor."
msgstr "Seleccione o factor de aumento."

#: kmag.cpp:202
msgid "Zoom factor"
msgstr "Factor de aumento"

#: kmag.cpp:205
msgid "Click on this button to <b>zoom-out</b> on the selected region."
msgstr "Prema neste botón para <b>reducir</b> o área seleccionada."

#: kmag.cpp:207
msgid "&Rotation"
msgstr "&Rotación"

#: kmag.cpp:209
#, fuzzy
msgid "Select the rotation degree."
msgstr "Seleccione o factor de rotación."

#: kmag.cpp:210
#, fuzzy
msgid "Rotation degree"
msgstr "Factor de rotación"

#: kmag.cpp:218
msgid "&Refresh"
msgstr "&Anovar"

#: kmag.cpp:220
msgid ""
"Select the refresh rate. The higher the rate, the more computing power (CPU) "
"will be needed."
msgstr ""
"Elixe o ratio de anovación. Canto maior sea o valor, máis potencia de "
"proceso será precisa."

#: kmag.cpp:221
msgid "Refresh rate"
msgstr "Ratio de anovación"

#: kmag.cpp:523
msgid "Save Snapshot As"
msgstr "Gardar captura como"

#: kmag.cpp:530
msgid ""
"Unable to save temporary file (before uploading to the network file you "
"specified)."
msgstr ""
"Non se pode gardar o ficheiro temporal (antes de subir o ficheiro de rede "
"que vostede especificou)."

#: kmag.cpp:531 kmag.cpp:535 kmag.cpp:547
msgid "Error Writing File"
msgstr "Erro escribindo o ficheiro"

#: kmag.cpp:534
msgid "Unable to upload file over the network."
msgstr "Non se pode subir o ficheiro a rede."

#: kmag.cpp:537 kmag.cpp:549
#, c-format
msgid ""
"Current zoomed image saved to\n"
"%1"
msgstr ""
"A imaxe ampliada actual gardouse en\n"
"%1"

#: kmag.cpp:546
msgid ""
"Unable to save file. Please check if you have permission to write to the "
"directory."
msgstr ""
"Non se pode gardar o ficheiro. Por favor, comproba se tes os permisos de "
"escritura no cartafol."

#: kmag.cpp:566
msgid "Click to stop window update"
msgstr "Prema para parar a actualización da fiestra"

#: kmag.cpp:569
msgid "Start"
msgstr "Iniciar"

#: kmag.cpp:570
msgid "Click to start window update"
msgstr "Prema para iniciar a actualización da fiestra"
