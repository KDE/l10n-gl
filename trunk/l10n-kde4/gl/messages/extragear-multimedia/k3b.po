msgid "Temporary Folder"
msgstr "Cartafol temporal"

#: k3btempdirselectionwidget.cpp:196
msgid "Select Temporary File"
msgstr "Escoller o ficheiro temporal"

#: k3btempdirselectionwidget.cpp:198
