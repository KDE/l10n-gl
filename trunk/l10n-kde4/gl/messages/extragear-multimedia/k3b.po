#: k3bsystemproblemdialog.cpp:224
#, kde-format
msgid "%1 will be run with root privileges on kernel >= 2.6.8"
msgstr "%1 será executado con privilexios de root cun kernel >= 2.6.8"

#: k3bsystemproblemdialog.cpp:225
#, kde-format
msgid ""
"Since Linux kernel 2.6.8 %1 will not work when run suid root for security "
"reasons anymore."
