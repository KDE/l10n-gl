#: src/unicodedialog.cpp:170
msgid ""
"Eighth note (Am.) or quaver (Brit.). Half as long as a quarter note (U"
"+2669). See <a href=\"http://en.wikipedia.org/wiki/Eighth_note\">Wikipedia:"
