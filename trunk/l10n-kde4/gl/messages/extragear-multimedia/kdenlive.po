msgstr "Caixa aberta; representa un espacio"

#: src/unicodedialog.cpp:168
msgid ""
"Quarter note (Am.) or crochet (Brit.). See <a href=\"http://en.wikipedia.org/"
"wiki/Quarter_note\">Wikipedia:Quarter_note</a>"
