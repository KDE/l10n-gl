msgstr "Muda o tamaño do vídeo ao 150% das dimensións orixinais"

#: kplayerengine.cpp:691
#, no-c-format
msgid ""
"The 'Zoom to 150%' command resizes the video area to 150% of the original "
"video size of the current file."
msgstr ""
"A orde «Ampliar ao 150%» aumenta o tamaño da área de vídeo para o 150% do "
"tamaño orixinal do vídeo."

#: kplayerengine.cpp:696
msgid "Zoom to &200%"
msgstr "Ampliar ao &200%"

#: kplayerengine.cpp:698
#, no-c-format
