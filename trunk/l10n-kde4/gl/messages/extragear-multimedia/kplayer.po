msgstr ""
"A orde «Ampliar ao 300%» amplía o tamaño da área do vídeo para o triplo do "
"tamaño orixinal."

#: kplayerengine.cpp:726
msgid "Maintain Original &Aspect"
msgstr "Manter &as proporcións orixinais"

