msgid "The 'Move Up' command moves the subtitles up."
msgstr "A orde «Subir» muda a posición dos subtítulos máis para arriba."

#: kplayerengine.cpp:935
msgid "Decreases subtitle delay"
msgstr "Diminúe o atraso dos subtítulos"

#: kplayerengine.cpp:936
msgid ""
