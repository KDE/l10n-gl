msgid "Cannot save the change."
msgstr "Non é posíbel gardar a modificación."

#: managers/cmake/cmakemanager.cpp:1122
msgid "Cannot remove the file."
msgstr "Non é posíbel eliminar o ficheiro."

#: managers/cmake/cmakemanager.cpp:1149
#, kde-format
msgid "Add a file called '%1' to target '%2'."
msgstr "Engade un ficheiro chamado «%1» ao obxectivo «%2»."

#: managers/cmake/cmakeutils.cpp:52
msgid "Choose CMake Build Directory"
msgstr "Escoller un cartafol de construción para CMake"

#: managers/cmake/cmakebuilddirchooser.cpp:93
msgid "You need to select a cmake binary"
msgstr "Debe escoller un binario de cmake"

#: managers/cmake/cmakebuilddirchooser.cpp:124
msgid "You need to specify a build directory"
msgstr "Debe especificar un cartafol de construción"

#: managers/cmake/cmakebuilddirchooser.cpp:136
msgid "Using an already created build directory"
msgstr "A usar un cartafol de construción xa criado"

#: managers/cmake/cmakebuilddirchooser.cpp:150
msgid "The selected build directory is not empty"
msgstr "O cartafol de construción escollido non está valeiro"

#: managers/cmake/cmakebuilddirchooser.cpp:152
#, kde-format
msgid "This build directory is for %1, but the project directory is %2"
msgstr "O cartafol de construción é para %1, pero o cartafol do proxecto é %2"

#: managers/cmake/settings/cmakepreferences.cpp:179
#, kde-format
msgid "The %1 build directory is not valid. It will be removed from the list"
msgstr "O directorio de construción %1 non é valido. Será eliminado da lista"

#: managers/cmake/settings/cmakepreferences.cpp:255
#, kde-format
msgid ""
"The %1 directory is about to be removed in KDevelop's list.\n"
"Do you want KDevelop to remove it in the file system as well?"
msgstr ""
"Estase a piques de eliminar o directorio %1 da lista de KDevelop.\n"
"Desexa que KDevelop o elimine tamén do sistema de ficheiros?"

#: managers/cmake/settings/cmakepreferences.cpp:261
#, kde-format
msgid "Could not remove: %1.\n"
msgstr "Non foi posíbel eliminar: %1.\n"

