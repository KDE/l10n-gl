#: managers/cmake/cmakemanager.cpp:88
msgid "CMake Manager"
msgstr "Xestor de CMake"

#: managers/cmake/cmakemanager.cpp:88
msgid "Support for managing CMake projects"
msgstr "Soporte para xestionar proxectos con CMake"

#: managers/cmake/cmakemanager.cpp:895
msgid "Jump to target definition"
msgstr "Ir á definición do obxectivo"

#: managers/cmake/cmakemanager.cpp:962
#, kde-format
msgid "Create a folder called '%1'."
msgstr "Criar un cartafol chamado «%1»."

#: managers/cmake/cmakemanager.cpp:974 managers/cmake/cmakemanager.cpp:983
#: managers/cmake/cmakemanager.cpp:1009 managers/cmake/cmakemanager.cpp:1113
