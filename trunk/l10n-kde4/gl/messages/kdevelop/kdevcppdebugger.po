#: cppdebugger/debuggerplugin.cpp:245
msgid ""
"<b>Interrupt application</b><p>Interrupts the debugged process or current "
"GDB command."
msgstr ""
"<b>Interromper o programa</b><p>Interrompe o proceso de depurado ou o "
"comando actual de GDB."

