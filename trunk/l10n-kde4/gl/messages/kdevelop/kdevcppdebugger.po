#: cppdebugger/debuggerplugin.cpp:264
msgid "Step over the next line"
msgstr "Salta á seguinte liña"

#: cppdebugger/debuggerplugin.cpp:265
msgid ""
"<b>Step over</b><p>Executes one line of source in the current source file. "
"If the source line is a call to a function the whole function is executed "
"and the app will stop at the line following the function call."
msgstr ""
"<b>Executar a seguinte</b><p>Executa unha liña do ficheiro de fontes actual. "
"Se a liña de fonte é unha chamada a unha función execútase toda a función e "
"o programa deterase na liña que segue á chamada."

#: cppdebugger/debuggerplugin.cpp:274
msgid "Step over Ins&truction"
msgstr "Executar a seguinte &instrución"

#: cppdebugger/debuggerplugin.cpp:275
msgid "Step over instruction"
msgstr "Executa a seguinte instrución"

#: cppdebugger/debuggerplugin.cpp:276
msgid ""
"<b>Step over instruction</b><p>Steps over the next assembly instruction."
msgstr ""
"<b>Executar a seguinte instrución</b><p>Executa a seguinte instrución do "
"ensamblador."

#: cppdebugger/debuggerplugin.cpp:281
msgid "Step &Into"
msgstr "Executar &unha liña"

#: cppdebugger/debuggerplugin.cpp:283
msgid "Step into the next statement"
msgstr "Executa a seguinte sentenza"

#: cppdebugger/debuggerplugin.cpp:284
msgid ""
"<b>Step into</b><p>Executes exactly one line of source. If the source line "
"is a call to a function then execution will stop after the function has been "
"entered."
msgstr ""
"<b>Executar unha liña</b><p>Executa exactamente unha liña de fontes. Se a "
"liña é unha chamada a unha función entón a execución deterase xusto tras "
"entrar na función."

#: cppdebugger/debuggerplugin.cpp:292
msgid "Step into I&nstruction"
msgstr "Executar unha ins&trución"

#: cppdebugger/debuggerplugin.cpp:293
msgid "Step into instruction"
msgstr "Executa unha instrución"

#: cppdebugger/debuggerplugin.cpp:294
msgid ""
"<b>Step into instruction</b><p>Steps into the next assembly instruction."
msgstr ""
"<b>Executar unha instrución</b><p>Executa a seguinte instrución de "
"ensamblador."

#: cppdebugger/debuggerplugin.cpp:299
msgid "Step O&ut"
msgstr "Executar até &sair"

#: cppdebugger/debuggerplugin.cpp:301
msgid "Steps out of the current function"
msgstr "Executa até sair da función actual"

#: cppdebugger/debuggerplugin.cpp:302
msgid ""
"<b>Step out</b><p>Executes the application until the currently executing "
"function is completed. The debugger will then display the line after the "
"original call to that function. If program execution is in the outermost "
"frame (i.e. in main()) then this operation has no effect."
msgstr ""
"<b>Executar até saír</b><p>Executa o programa até que se complete a función "
"que se está a executar. Entón o depurador mostrará a liña tras da chamada "
"orixinal á función. Se a execución do programa está na pila máis externa (i."
"e. en main()) entón esta operación non ten efeito nengún."

#: cppdebugger/debuggerplugin.cpp:312
msgid "Viewers"
msgstr "Visores"

#: cppdebugger/debuggerplugin.cpp:313
msgid "Debugger viewers"
msgstr "Visores do depurador"

#: cppdebugger/debuggerplugin.cpp:314
msgid ""
"<b>Debugger viewers</b><p>Various information about application being "
"executed. There are 4 views available:<br><b>Memory</b><br><b>Disassemble</"
"b><br><b>Registers</b><br><b>Libraries</b>"
msgstr ""
"<b>Visores do depurador</b><p>Diversas informacións acerca do programa que "
"se está a executar. Hai 4 vistas disponíbeis:<br><b>Memoria</"
"b><br><b>Desemsamblado</b><br><b>Rexistos</b><br><b>Bibliotecas</b>"

#: cppdebugger/debuggerplugin.cpp:323
msgid "Examine Core File..."
msgstr "Examinar un ficheiro Core..."

#: cppdebugger/debuggerplugin.cpp:324
msgid "Examine core file"
msgstr "Examina un ficheiro core"

#: cppdebugger/debuggerplugin.cpp:325
msgid ""
"<b>Examine core file</b><p>This loads a core file, which is typically "
"created after the application has crashed, e.g. with a segmentation fault. "
"The core file contains an image of the program memory at the time it "
"crashed, allowing you to do a post-mortem analysis."
msgstr ""
"<b>Examinar un ficheiro core</b><p>Isto carga un ficheiro core, que "
"tipicamente é criado tras un peche inesperado do programa, p.ex. cun fallo "
"de segmentación. O ficheiro core contén unha imaxe da memoria do programa no "
"momento que se pechou inesperadamente, permitíndolle facer unha análise post-"
"mortem."

#: cppdebugger/debuggerplugin.cpp:336
msgid "Attach to process"
msgstr "Adxuntar ao proceso"

#: cppdebugger/debuggerplugin.cpp:337
msgid "<b>Attach to process</b><p>Attaches the debugger to a running process."
msgstr ""
"<b>Adxuntar ao proceso</b><p>Anexa o depurador a un proceso en execución."

#: cppdebugger/debuggerplugin.cpp:341
msgid "Toggle Breakpoint"
msgstr "Comutar o ponto de parada"

#: cppdebugger/debuggerplugin.cpp:342
msgid "Toggle breakpoint"
msgstr "Comutar o ponto de parada"

#: cppdebugger/debuggerplugin.cpp:343
msgid ""
"<b>Toggle breakpoint</b><p>Toggles the breakpoint at the current line in "
"editor."
msgstr ""
"<b>Comutar o ponto de parada</b><p>Comuta o ponto de parada na liña actual "
"do editor."

#: cppdebugger/debuggerplugin.cpp:377
msgid "Debug in &KDevelop"
msgstr "Depurar en &KDevelop"

#: cppdebugger/debuggerplugin.cpp:451
msgid "Evaluate: %1"
msgstr "Avaliar: %1"

#: cppdebugger/debuggerplugin.cpp:453
msgid ""
"<b>Evaluate expression</b><p>Shows the value of the expression under the "
"cursor."
msgstr ""
"<b>Avaliar unha expresión</b><p>Mostra o valor da expresión baixo o cursor."

#: cppdebugger/debuggerplugin.cpp:456
msgid "Watch: %1"
msgstr "Vixiar: %1"

#: cppdebugger/debuggerplugin.cpp:458
msgid ""
"<b>Watch expression</b><p>Adds an expression under the cursor to the "
"Variables/Watch list."
msgstr ""
"<b>Vixiar unha expresión</b><p>Engade a expresión baixo o cursor á lista de "
"Variábeis/Vixías."

#: cppdebugger/debuggerplugin.cpp:540
msgid ""
"<b>GDB exited abnormally</b><p>This is likely a bug in GDB. Examine the gdb "
"output window and then stop the debugger"
msgstr ""
"<b>GDB saíu anormalmente</b><p>Isto posibelmente sexa un erro en GDB. "
"Examine a fiestra da saída de GDB e logo pare o depurador"

#: cppdebugger/debuggerplugin.cpp:543
msgid "GDB exited abnormally"
msgstr "GDB saíu anormalmente"

#: cppdebugger/debuggerplugin.cpp:557
msgid "Choose a core file to examine..."
msgstr "Escoller un ficheiro core a examinar..."

#: cppdebugger/debuggerplugin.cpp:563
msgid "Examining core file %1"
msgstr "A examinar o ficheiro core %1"

#: cppdebugger/debuggerplugin.cpp:571
msgid "Choose a process to attach to..."
msgstr "Escolla un proceso co que adxuntar..."

#: cppdebugger/debuggerplugin.cpp:583
msgid "Attaching to process %1"
msgstr "A xuntar co proceso %1"

#: cppdebugger/debuggerplugin.cpp:640
msgid "Debugger"
msgstr "Depurador"

#: cppdebugger/debuggerplugin.cpp:663
msgid "Debugger stopped"
msgstr "Depurador detido"

#: cppdebugger/debuggerplugin.cpp:693
msgid "Runs the program in the debugger"
msgstr "Executa o programa no depurador"

#: cppdebugger/debuggerplugin.cpp:694
msgid ""
"Start in debugger\n"
"\n"
"Starts the debugger with the project's main executable. You may set some "
"breakpoints before this, or you can interrupt the program while it is "
"running, in order to get information about variables, frame stack, and so on."
msgstr ""
"Iniciar no depurador\n"
"\n"
"Inicia o depurador co executábel principal do programa. Pode estabelecer "
"algúns pontos de parada antes disto, ou pode interromper o programa mentres "
"está a executarse, para obter información acerca de variábeis, pila de "
"chamada, etc."

#: cppdebugger/debuggerplugin.cpp:708
msgid "&Continue"
msgstr "&Continuar"

#: cppdebugger/debuggerplugin.cpp:709
msgid "Continues the application execution"
msgstr "Continúa coa execución do programa"

#: cppdebugger/debuggerplugin.cpp:710
msgid ""
"Continue application execution\n"
"\n"
"Continues the execution of your application in the debugger. This only takes "
"effect when the application has been halted by the debugger (i.e. a "
"breakpoint has been activated or the interrupt was pressed)."
msgstr ""
"Continuar a execución do programa\n"
"\n"
"Continúa a execución do programa no depurador. Isto só ten efeito cando o "
"programa fose detido polo depurador (i.e. un ponto de parada foi activado ou "
"premeuse en interromper)."

#: cppdebugger/debuggerplugin.cpp:741
msgid "Process exited"
msgstr "O proceso saiu"

