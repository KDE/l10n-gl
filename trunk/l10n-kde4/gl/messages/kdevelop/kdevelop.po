msgstr "Comutar o ponto de parada"

#: languages/cpp/debugger/debuggerplugin.cpp:333
msgid "Toggle breakpoint"
msgstr "Comutar o ponto de parada"

#: languages/cpp/debugger/debuggerplugin.cpp:334
