#: languages/cpp/debugger/debuggerplugin.cpp:208
msgid ""
"<b>Start in debugger</b><p>Starts the debugger with the project's main "
"executable. You may set some breakpoints before this, or you can interrupt "
"the program while it is running, in order to get information about "
"variables, frame stack, and so on."
msgstr ""
"<b>Iniciar no depurador</b><p>Inicia o depurador co executábel principal do "
"proxecto. Pode estabelecer algúns pontos de parada antes de isto, ou pode "
"interromper o programa mentres está a executarse, para obter información "
"acerca das variábeis, pila de chamadas e cousas así."

#: languages/cpp/debugger/debuggerplugin.cpp:217
msgid "&Restart"
msgstr "&Reiniciar"

#: languages/cpp/debugger/debuggerplugin.cpp:218
msgid "Restart program"
msgstr "Reinicia o programa"

#: languages/cpp/debugger/debuggerplugin.cpp:219
msgid "<b>Restarts application</b><p>Restarts applications from the beginning."
msgstr ""
"<b>Reiniciar o programa</b><p>Comeza o programa de novo desde o principio."

#: languages/cpp/debugger/debuggerplugin.cpp:227
msgid "Sto&p"
msgstr "&Deter"

#: languages/cpp/debugger/debuggerplugin.cpp:228
msgid "Stop debugger"
msgstr "Detén o depurador"

#: languages/cpp/debugger/debuggerplugin.cpp:229
msgid "<b>Stop debugger</b><p>Kills the executable and exits the debugger."
msgstr "<b>Deter o depurador</b><p>Mata o executábel e sae do depurador."

#: languages/cpp/debugger/debuggerplugin.cpp:233
msgid "Interrupt"
msgstr "Interromper"

#: languages/cpp/debugger/debuggerplugin.cpp:234
msgid "Interrupt application"
msgstr "Interrompe o programa"

#: languages/cpp/debugger/debuggerplugin.cpp:235
msgid ""
"<b>Interrupt application</b><p>Interrupts the debugged process or current "
"GDB command."
msgstr ""
"<b>Interromper o programa</b><p>Interrompe o proceso de depurado ou o "
"comando actual de GDB."

#: languages/cpp/debugger/debuggerplugin.cpp:239
msgid "Run to &Cursor"
msgstr "Executar até o &cursor"

#: languages/cpp/debugger/debuggerplugin.cpp:240
msgid "Run to cursor"
msgstr "Executar até o cursor"

#: languages/cpp/debugger/debuggerplugin.cpp:241
msgid ""
"<b>Run to cursor</b><p>Continues execution until the cursor position is "
"reached."
msgstr ""
"<b>Executar até o cursor</b><p>Continúa a execución até acadar a posición do "
"cursor."

#: languages/cpp/debugger/debuggerplugin.cpp:246
msgid "Set E&xecution Position to Cursor"
msgstr "Pór o &ponto de execución no cursor"

#: languages/cpp/debugger/debuggerplugin.cpp:247
msgid "Jump to cursor"
msgstr "Salta até o cursor"

#: languages/cpp/debugger/debuggerplugin.cpp:248
msgid ""
"<b>Set Execution Position </b><p>Set the execution pointer to the current "
"cursor position."
msgstr ""
"<b>Pór o ponto de execución</b><p>Leva o ponteiro de execución á posición "
"actual do cursor."

#: languages/cpp/debugger/debuggerplugin.cpp:252
msgid "Step &Over"
msgstr "Executar a &seguinte"

#: languages/cpp/debugger/debuggerplugin.cpp:254
msgid "Step over the next line"
msgstr "Salta á seguinte liña"

#: languages/cpp/debugger/debuggerplugin.cpp:255
msgid ""
"<b>Step over</b><p>Executes one line of source in the current source file. "
"If the source line is a call to a function the whole function is executed "
"and the app will stop at the line following the function call."
msgstr ""
"<b>Executar a seguinte</b><p>Executa unha liña do ficheiro de fontes actual. "
"Se a liña de fonte é unha chamada a unha función execútase toda a función e "
"o programa deterase na liña que segue á chamada."

#: languages/cpp/debugger/debuggerplugin.cpp:264
msgid "Step over Ins&truction"
msgstr "Executar a seguinte &instrución"

#: languages/cpp/debugger/debuggerplugin.cpp:265
msgid "Step over instruction"
msgstr "Executa a seguinte instrución"

#: languages/cpp/debugger/debuggerplugin.cpp:266
msgid ""
"<b>Step over instruction</b><p>Steps over the next assembly instruction."
msgstr ""
"<b>Executar a seguinte instrución</b><p>Executa a seguinte instrución de "
"ensamblador."

#: languages/cpp/debugger/debuggerplugin.cpp:271
msgid "Step &Into"
msgstr "Executar &unha liña"

#: languages/cpp/debugger/debuggerplugin.cpp:273
msgid "Step into the next statement"
msgstr "Executa a seguinte sentenza"

#: languages/cpp/debugger/debuggerplugin.cpp:274
msgid ""
"<b>Step into</b><p>Executes exactly one line of source. If the source line "
"is a call to a function then execution will stop after the function has been "
"entered."
msgstr ""
"<b>Executar unha liña</b><p>Executa exactamente unha liña de fontes. Se a "
"liña é unha chamada a unha función entón a execución deterase xusto tras "
"entrar na función."

#: languages/cpp/debugger/debuggerplugin.cpp:282
msgid "Step into I&nstruction"
msgstr "Executar unha ins&trución"

#: languages/cpp/debugger/debuggerplugin.cpp:283
msgid "Step into instruction"
msgstr "Executa unha instrución"

#: languages/cpp/debugger/debuggerplugin.cpp:284
msgid ""
"<b>Step into instruction</b><p>Steps into the next assembly instruction."
msgstr ""
"<b>Executar unha instrución</b><p>Executa a seguinte instrución de "
"ensamblador."

#: languages/cpp/debugger/debuggerplugin.cpp:289
msgid "Step O&ut"
msgstr "Executar até &sair"

#: languages/cpp/debugger/debuggerplugin.cpp:291
msgid "Steps out of the current function"
msgstr "Executa até sair da función actual"

#: languages/cpp/debugger/debuggerplugin.cpp:292
msgid ""
"<b>Step out</b><p>Executes the application until the currently executing "
"function is completed. The debugger will then display the line after the "
"original call to that function. If program execution is in the outermost "
"frame (i.e. in main()) then this operation has no effect."
msgstr ""
"<b>Executar até saír</b><p>Executa o programa até que se complete a función "
"que se está a executar. Entón o depurador mostrará a liña tras da chamada "
"orixinal á función. Se a execución do programa está na pila máis externa (i."
"e. en main()) entón esta operación non ten efeito nengún."

#: languages/cpp/debugger/debuggerplugin.cpp:302
msgid "Viewers"
msgstr "Visores"

#: languages/cpp/debugger/debuggerplugin.cpp:303
msgid "Debugger viewers"
msgstr "Visores do depurador"

#: languages/cpp/debugger/debuggerplugin.cpp:304
msgid ""
"<b>Debugger viewers</b><p>Various information about application being "
