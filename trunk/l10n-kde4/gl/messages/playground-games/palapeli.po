#. i18n: ectx: label, entry (AutosaveTime), group (Autosave)
#: rc.cpp:18
msgid ""
"Interval between automatic backups in seconds (or 0 if time-based backups "
"are disabled)."
msgstr ""
"O intervalo entre copiados de seguridade automáticos, en segundos (ou 0 para "
"deshabilitalos)."

#. i18n: file: palapeli.kcfg:37
#. i18n: ectx: label, entry (AutosaveMoves), group (Autosave)
#: rc.cpp:21
msgid ""
"Interval between automatic backups in moves (or 0 if action-based backups "
"are disabled)."
msgstr ""
"O intervalo entre copiados de seguridade automáticos, en movimentos (ou 0 "
"para deshabilitalos)."

