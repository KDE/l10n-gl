msgstr "<font color=\"blue\">* <b>%1</b> entrou na partida chamada %2</font>"

#: chatwidget.cpp:127
#, kde-format
msgid "<font color=\"blue\">* Disconnected from server</font>"
msgstr "<font color=\"blue\">* Desconectado do servidor</font>"

#: chatwidget.cpp:135
#, kde-format
msgid ""
"<font color=\"red\">* You have used a word that contains tiles to make up a "
"exclusive tile, which is forbidden.</font>"
msgstr ""
"<font color=\"red\">* Usaches unha palabra que contén fichas para compor "
"unha única ficha e iso non está permitido.</font>"

#: chatwidget.cpp:136
#, kde-format
msgid ""
"<font color=\"red\">* %1 has used a word that contains tiles to make up a "
"exclusive tile, which is forbidden.</font>"
msgstr ""
"<font color=\"red\">* %1 usou unha palabra que contén fichas para compor "
"unha só ficha e iso non está permitido.</font>"

#: chatwidget.cpp:140
#, kde-format
msgid ""
"<font color=\"red\">* Your word was not accepted by the other players</font>"
msgstr ""
"<font color=\"red\">* A túa palabra non foi aceptada polos outros xogadores."
"</font>"

#: chatwidget.cpp:141
#, kde-format
msgid ""
"<font color=\"red\">* %1's word was not accepted by the other players</font>"
msgstr ""
"<font color=\"red\">* A palabra de %1 non foi aceptada polos outros "
"xogadores</font>"

#: chatwidget.cpp:147
#, kde-format
msgid "<font color=\"blue\">* You made 1 point creating the words %2"
msgid_plural "<font color=\"blue\">* You made %1 points creating the words %2"
msgstr[0] "<font color=\"blue\">* Fixeches 1 punto ao crear as palabras %2."
msgstr[1] "<font color=\"blue\">* Fixeches %1 puntos ao crear as palabras %2."

#: chatwidget.cpp:148
#, kde-format
msgid "<font color=\"blue\">* %2 made 1 point creating the words %3"
msgid_plural "<font color=\"blue\">* %2 made %1 points creating the words %3"
msgstr[0] "<font color=\"blue\">* %2 fixo 1 punto ao crear as palabras %3."
msgstr[1] "<font color=\"blue\">* %2 fixo %1 puntos ao crear as palabras %3."

#: chatwidget.cpp:153
#, kde-format
msgid "<font color=\"blue\">* You skipped your turn</font>"
msgstr "<font color=\"blue\">* Pasou a túa vez</font>"

#: chatwidget.cpp:154
#, kde-format
msgid "<font color=\"blue\">* %1 skipped their turn</font>"
msgstr "<font color=\"blue\">* %1 pasou.</font>"

#: chatwidget.cpp:159
#, kde-format
msgid "<font color=\"blue\">* You exchanged %1 tile</font>"
msgid_plural "<font color=\"blue\">* You exchanged %1 tiles</font>"
msgstr[0] "<font color=\"blue\">* Intercambiaches %1 ficha</font>"
msgstr[1] "<font color=\"blue\">* Intercambiaches %1 fichas</font>"

#: chatwidget.cpp:160
#, kde-format
msgid "<font color=\"blue\">* %2 exchanged %1 tile</font>"
msgid_plural "<font color=\"blue\">* %2 exchanged %1 tiles</font>"
msgstr[0] "<font color=\"blue\">* %2 intercambiou %1 ficha.</font>"
msgstr[1] "<font color=\"blue\">* %2 intercambiou %1 fichas.</font>"

