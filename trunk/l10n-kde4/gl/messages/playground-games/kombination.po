#: chatwidget.cpp:110
#, kde-format
msgid ""
"<font color=\"blue\">* %1 has used all his tiles. The game has ended!<br><b>"
"%2</b> has won!</font>"
msgstr ""
"<font color=\"blue\">* %1 usou todas as súas fichas. A partida rematou!"
"<br>Gañou<b>%2</b>!</font>"

