#. i18n: ectx: property (toolTip), widget (KLineEdit, pattern)
#: clue_properties_dock.ui:488
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'FreeSans'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Enter a pattern with "
"letters, <span style=\" font-weight:600;\">? </span>for one arbitrary letter "
"and <span style=\" font-weight:600;\">*</span> for any number of arbitrary "
"letters.</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'FreeSans'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Escriba un padrón con "
"letras, <span style=\" font-weight:600;\">?</span> para unha letra calquera, "
"e <span style=\" font-weight:600;\">*</span> para un número calquera de "
"letras.</p></body></html>"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, pattern)
#: clue_properties_dock.ui:499
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'FreeSans'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">You can enter wildcard "
"patterns to search the dictionary for answers.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">The pattern can contain "
"letters, <span style=\" font-weight:600;\">? </span>for one arbitrary letter "
"and <span style=\" font-weight:600;\">*</span> for any number of arbitrary "
"letters.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">For example \"HO??E\" "
"matches all answers starting with \"HO\", ending with \"E\" and having two "
"arbitrary letters in between. \"HOUSE\" would be matched by that pattern.</"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Answers are searched while "
"typing the pattern.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Note:</span> When you change the settings of the clue, a "
"pattern is automatically constructed, based on the letters that are already "
"in the crossword at the positions of the clue.</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'FreeSans'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Pode escribir padróns con "
"comodíns para buscar respostas no dicionario.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">O padrón pode incluír "
"letras, <span style=\" font-weight:600;\">?</span> para representar unha "
"letra calquera e <span style=\" font-weight:600;\">*</span> para representar "
"un número calquera de letras.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Por exemplo, «C??A» "
"coincide con todas as respostas que comezan por «C», rematan por «A», e "
"teñen dúas letras calquera en medio. Por exemplo, o padrón coincidiría con "
"«CASA».</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">As respostas búscanse a "
"medida que escribe o padrón.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Nota:</span> cando cambia a configuración da pista, constúese "
"un padrón automaticamente baseado nas letras que xa están no encrucillado "
"nas posicións da pista.</p></body></html>"

