msgid "Autocorrect"
msgstr "Corrixir"

#~ msgid "Si&mple Autocorrection"
#~ msgstr "Corrección s&imple"

#~ msgid ""
#~ "Detect when a new sentence is started and always ensure that the first "
#~ "character is an uppercase character"
#~ msgstr ""
#~ "Detectar cando se empece unha nova frase e asegurarse sempre de que o "
#~ "primeiro carácter estea en maiúsculas"

#~ msgid ""
#~ "Convert &first letter of a sentence automatically to uppercase\n"
#~ "(e.g. \"my house. in this town\" to \"my house. In this town\")"
#~ msgstr ""
#~ "Converter automaticamente a &primeira letra dunha frase a maiúsculas\n"
#~ "(por exemplo, «a miña casa. no seu pobo» a «a miña casa. No seu pobo»)"

#~ msgid ""
#~ "All words are checked for the common mistake of holding the shift key "
#~ "down a bit too long. If some words must have two uppercase characters, "
#~ "then those exceptions should be added in the 'Exceptions' tab."
#~ msgstr ""
#~ "Compróbase en tódalas palabras un erro común que é manter premida a tecla "
#~ "shift demasiado tempo. No caso de que algunha palabra deba conter dous "
#~ "caracteres maiúsculos seguidos, engádaa coma unha excepción na pestana de "
#~ "«Excepcións»."

#~ msgid ""
#~ "Convert &two uppercase characters to one uppercase and one lowercase "
#~ "character\n"
#~ " (e.g. PErfect to Perfect)"
#~ msgstr ""
#~ "Converter &dous caracteres en maiúscula a unha maiúscula e unha "
#~ "minúscula\n"
#~ "(por exemplo, PErfecto a Perfecto)"

#~ msgid ""
#~ "Detect when a URL (Uniform Resource Locator) is typed and provide "
#~ "formatting that matches the way an Internet browser would show a URL."
#~ msgstr ""
#~ "Detectar cando se escribe unha URL (Localizador de Recursos Uniforme)  e "
#~ "xestionar o formato para que concorde co xeito que empregan os "
#~ "navegadores web para mostrar as URLs."

#~ msgid "Autoformat &URLs"
#~ msgstr "Autoformatar as &URLs"

#~ msgid ""
#~ "Make sure that more than one space cannot be typed, as this is a common "
#~ "mistake which is quite hard to find in formatted text."
#~ msgstr ""
#~ "Asegurarse de que non se teclean máis de dous espazos xa que isto é un "
#~ "erro recorrente que é difícil de corrixir nun texto xa formatado. "

#~ msgid "&Suppress double spaces"
#~ msgstr "&Suprimir os dobres espazos"

#~ msgid ""
#~ "Keep correct formatting and indenting of sentences by automatically "
#~ "removing spaces typed at the beginning and end of a paragraph."
#~ msgstr ""
#~ "Manter o formato correcto e a sangría de frases eliminando "
#~ "automaticamente os espazos tecleados ao comezo é remate dun parágrafo. "

#~ msgid "R&emove spaces at the beginning and end of paragraphs"
#~ msgstr "&Eliminar espazos ao comezo e ao remate dos parágrafos"

#~ msgid ""
#~ "When you use _underline_ or *bold*, the text between the underscores or "
#~ "asterisks will be converted to underlined or bold text."
#~ msgstr ""
#~ "Cando se emprega _subliñado_ ou *grosa*, o texto entre os guións baixos e "
#~ "os asteriscos serán convertidos a texto subliñado ou en negriña. "

#~ msgid "Automatically do &bold and underline formatting"
#~ msgstr "Fomatado de subliñado e grosa automático"

#~ msgid "Most standard fraction notations will be converted when available"
#~ msgstr "Hanse converter a meirande parte das notacións de fraccións comúns"

#~ msgid "Re&place 1/2... with ½..."
#~ msgstr "&Substituír 1/2... por ½.."

#~ msgid ""
#~ "When typing '1)' or similar in front of a paragraph, automatically "
#~ "convert the paragraph to use that numbering style. This has the advantage "
#~ "that further paragraphs will also be numbered and the spacing is done "
#~ "correctly."
#~ msgstr ""
#~ "Adaptar automaticamente os parágrafos ao estilo de numeración cando se "
#~ "engada diante deles '1)' ou formas similares. Isto ofrece a vantaxe de "
#~ "que os seguintes parágrafos hanse numerar igual mantendo o espaciado "
#~ "correcto.  "

#~ msgid "Use &autonumbering for numbered paragraphs"
#~ msgstr "Empregar o &autonumerado para os parágrafos numerados"

#~ msgid "Rep&lace 1st... with 1^st..."
#~ msgstr "Su&stituír 1st... con  1^st..."

#~ msgid "Capitalize name of days"
#~ msgstr "Poñer en maiúscula os nomes dos días"

#~ msgid ""
#~ "When typing '*' or '-' in front of a paragraph, automatically convert the "
#~ "paragraph to use that list-style. Using a list-style formatting means "
#~ "that a correct bullet is used to draw the list."
#~ msgstr ""
#~ "Adaptar automaticamente os parágrafos ao estilo de listas cando se engada "
#~ "diante deles «*» ou «-» . Empregando o formatado en lista asegúrase de "
#~ "que sempre se emprega o mesmo debuxo para debuxar a lista. "

#~ msgid "Use l&ist-formatting for bulleted paragraphs"
#~ msgstr "Empregar formatado de &lista para os parágrafos con símbolos"

#~ msgid "Default"
#~ msgstr "Predeterminado"

#~ msgid "Custom &Quotes"
#~ msgstr "&Comiñas personalizadas"

#~ msgid "Replace &double quotes with typographical quotes"
#~ msgstr "Substituír o dobre &apóstrofo por comiñas tipográficas"

#~ msgid "Replace &single quotes with typographical quotes"
#~ msgstr "Substituír os apóstrofo&s por comiñas tipográficas "

#~ msgid "Ad&vanced Autocorrection"
#~ msgstr "Autocorrección &avanzada"

#~ msgid "Replacements and exceptions for language:"
#~ msgstr "Substitucións e excepcións de idioma:"

#~ msgid "All Languages"
#~ msgstr "Tódalas linguas"

#~ msgid "&Enable word replacement"
#~ msgstr "&Activar substitución de palabras"

#~ msgid "Replace &text with format"
#~ msgstr "Substituír o &texto con formato"

#~ msgid "&Find"
#~ msgstr "&Buscar"

#~ msgid "..."
#~ msgstr "..."

#~ msgid "Re&place"
#~ msgstr "&Substituír"

#~ msgid "Remove"
#~ msgstr "Eliminar"

#~ msgid "C&hange Format..."
#~ msgstr "&Cambiar o formato..."

#~ msgid "C&lear Format"
#~ msgstr "&Limpar o formato"

#~ msgid "Find"
#~ msgstr "Procurar"

#~ msgid "Replace"
#~ msgstr "Substituír"

#~ msgid "E&xceptions"
#~ msgstr "E&xcepcións"

#~ msgid "Do not treat as the end of a sentence:"
#~ msgstr "Non tratar coma o remate dunha frase: "

#~ msgid "Autoinclude"
#~ msgstr "Incluír automaticamente"

#~ msgid "R&emove"
#~ msgstr "&Eliminar"

#~ msgid "Accept two uppercase letters in:"
#~ msgstr "Aceptar dúas maiúsculas en:"

