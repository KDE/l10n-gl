msgstr "Número de períodos"

#. i18n: file: functions/financial.xml:646
#: xml_doc.cpp:1705
msgid "Present values"
msgstr "Valor actual"

#. i18n: file: functions/financial.xml:650
#. i18n: file: functions/financial.xml:1037
#: xml_doc.cpp:1707 xml_doc.cpp:1923
msgid "Future value (optional)"
msgstr "Valor futuro (opcional)"

#. i18n: file: functions/financial.xml:654
#. i18n: file: functions/financial.xml:854
#. i18n: file: functions/financial.xml:1003
#. i18n: file: functions/financial.xml:1041
#: xml_doc.cpp:1709 xml_doc.cpp:1828 xml_doc.cpp:1907 xml_doc.cpp:1925
msgid "Type (optional)"
msgstr "Tipo (opcional)"

#. i18n: file: functions/financial.xml:658
#: xml_doc.cpp:1711
msgid ""
"IPMT calculates the amount of a payment of an annuity going towards interest."
msgstr ""
"IPMT calcula o valor do pagamento dunha anualidade que vai para o xuros."

#. i18n: file: functions/financial.xml:659
#. i18n: file: functions/financial.xml:713
#. i18n: file: functions/financial.xml:1046
#: xml_doc.cpp:1713 xml_doc.cpp:1749 xml_doc.cpp:1929
msgid "Rate is the periodic interest rate."
msgstr "A taxa corresponde á taxa de xuro periódica."

#. i18n: file: functions/financial.xml:660
#. i18n: file: functions/financial.xml:1047
#: xml_doc.cpp:1715 xml_doc.cpp:1931
msgid ""
"Period is the amortizement period. 1 for the first and NPER for the last "
"period."
msgstr ""
"O período é o período de amortización. É igual a 1 para o primeiro e NPER "
"para o último período."

#. i18n: file: functions/financial.xml:661
#. i18n: file: functions/financial.xml:1048
#: xml_doc.cpp:1717 xml_doc.cpp:1933
msgid "NPER is the total number of periods during which annuity is paid."
msgstr ""
"NPER é o número total de períodos durante os cales a anualidade é paga."

#. i18n: file: functions/financial.xml:662
#. i18n: file: functions/financial.xml:716
#. i18n: file: functions/financial.xml:1049
#: xml_doc.cpp:1719 xml_doc.cpp:1755 xml_doc.cpp:1935
msgid "PV is the present value in the sequence of payments."
msgstr "VP é o valor actual na secuencia de pagamentos."

#. i18n: file: functions/financial.xml:663
#. i18n: file: functions/financial.xml:1050
#: xml_doc.cpp:1721 xml_doc.cpp:1937
msgid "FV (optional) is the desired (future) value.  default: 0."
msgstr "VF (opcional) é o valor desexado (futuro). Por omisión é 0."

#. i18n: file: functions/financial.xml:664
#. i18n: file: functions/financial.xml:1051
#: xml_doc.cpp:1723 xml_doc.cpp:1939
msgid ""
"Type (optional) defines the due date. 1 for payment at the beginning of a "
"period and 0 (default) for payment at the end of a period."
msgstr ""
"O tipo (opcional) define a data de vencemento. É igual a 1 para o inicio do "
"período e 0 (por omisión) para o pagamento no fin dun período."

#. i18n: file: functions/financial.xml:665
#: xml_doc.cpp:1725
msgid ""
"The example shows the interest to pay in the last year of a three year loan. "
"The interest rate is 10 percent."
msgstr ""
"O exemplo demostra o xuro a pagar no último ano dun empréstamo de tres anos. "
"A taxa de xuro é igual a 10 por cento."

#. i18n: file: functions/financial.xml:666
#: xml_doc.cpp:1727
msgid "IPMT(Rate; Period; NPer; PV; FV; Type)"
msgstr "IPMT(Taxa; Período; NPer; VP; VF; Tipo)"

#. i18n: file: functions/financial.xml:667
#: xml_doc.cpp:1729
msgid "IPMT(0.1;3;3;8000) equals -292.45"
msgstr "IPMT(0,1;3;3;8000) é igual a -292,45"

