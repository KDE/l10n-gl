msgstr "ISBLANK(A1) devolve Verdadeiro se A1 estiver baleira"

#. i18n: file: functions/information.xml:90
#: xml_doc.cpp:2253
msgid "ISBLANK(A1) returns False if A1 holds a value"
msgstr "ISBLANK(A1) devolve Verdadeiro se A1 ten un valor"

#. i18n: file: functions/information.xml:102
#: xml_doc.cpp:2257
msgid ""
"The ISNUMBER() function returns True if the parameter is a numerical value. "
"Otherwise it returns False. It's the same as ISNUM."
msgstr ""
"A función ISNUMBER() devolve Verdadeiro se o parámetro é un valor numérico; "
"caso contrario devolve Falso. É a mesma función que a ISNUM."

#. i18n: file: functions/information.xml:103
#: xml_doc.cpp:2259
msgid "ISNUMBER(x)"
msgstr "ISNUMBER(x)"

#. i18n: file: functions/information.xml:104
#: xml_doc.cpp:2261
msgid "ISNUMBER(12) returns True"
msgstr "ISNUMBER(12) devolve Verdadeiro"

#. i18n: file: functions/information.xml:105
#: xml_doc.cpp:2263
msgid "ISNUMBER(hello) returns False"
msgstr "ISNUMBER(hello) devolve Falso"

#. i18n: file: functions/information.xml:118
#: xml_doc.cpp:2267
msgid ""
"The ISNUM() function returns True if the parameter is a numerical value. "
"Otherwise it returns False. It's the same as ISNUMBER."
msgstr ""
"A función ISNUM() devolve Verdadeiro se o parámetro é un valor numérico; "
"caso contrario devolve Falso. É a mesma que a ISNUMBER."

#. i18n: file: functions/information.xml:119
#: xml_doc.cpp:2269
msgid "ISNUM(x)"
msgstr "ISNUM(x)"

#. i18n: file: functions/information.xml:120
#: xml_doc.cpp:2271
msgid "ISNUM(12) returns True"
msgstr "ISNUM(12) devolve Verdadeiro"

#. i18n: file: functions/information.xml:121
#: xml_doc.cpp:2273
msgid "ISNUM(hello) returns False"
msgstr "ISNUM(hello) devolve Falso"

#. i18n: file: functions/information.xml:134
#: xml_doc.cpp:2277
msgid ""
"The ISTIME() function returns True if the parameter is a time value. "
"Otherwise it returns False."
msgstr ""
"A función ISTIME() devolve Verdadeiro se o parámetro é un valor dunha hora. "
"Caso contrario devolve Falso."

#. i18n: file: functions/information.xml:135
#: xml_doc.cpp:2279
msgid "ISTIME(x)"
msgstr "ISTIME(x)"

#. i18n: file: functions/information.xml:136
#: xml_doc.cpp:2281
msgid "ISTIME(\"12:05\") returns True"
msgstr "ISTIME(\"12:05\") devolve Verdadeiro"

#. i18n: file: functions/information.xml:137
#: xml_doc.cpp:2283
msgid "ISTIME(\"hello\") returns False"
msgstr "ISTIME(\"ola\") devolve Falso"

#. i18n: file: functions/information.xml:149
#: xml_doc.cpp:2287
msgid ""
"The ISDATE() function returns True if the parameter is a date value. "
"Otherwise it returns False"
msgstr ""
"A función ISDATE() devolve Verdadeiro se o parámetro é unha data; caso "
"contrario devolve Falso"

#. i18n: file: functions/information.xml:150
#: xml_doc.cpp:2289
msgid "ISDATE(x)"
msgstr "ISDATE(x)"

#. i18n: file: functions/information.xml:151
#: xml_doc.cpp:2291
msgid "ISDATE(\"2000-2-2\") returns True"
msgstr "ISDATE(\"2000-2-2\") devolve Verdadeiro"

#. i18n: file: functions/information.xml:152
#: xml_doc.cpp:2293
msgid "ISDATE(\"hello\") returns False"
msgstr "ISDATE(\"hello\") devolve Falso"

#. i18n: file: functions/information.xml:164
#: xml_doc.cpp:2297
msgid ""
"The ISREF() function returns True if the parameter refers to a reference. "
"Otherwise it returns False"
msgstr ""
"A función ISREF() devolve Verdadeiro se o parámetro é unha referencia; caso "
"contrario devolve Falso"

#. i18n: file: functions/information.xml:165
#: xml_doc.cpp:2299
msgid "ISREF(x)"
msgstr "ISREF(x)"

#. i18n: file: functions/information.xml:166
#: xml_doc.cpp:2301
msgid "ISREF(A12) returns true"
msgstr "ISREF(A12) devolve Verdadeiro"

#. i18n: file: functions/information.xml:167
#: xml_doc.cpp:2303
msgid "ISREF(\"hello\") returns false"
msgstr "ISREF(\"ola\") devolve Falso"

#. i18n: file: functions/information.xml:179
#: xml_doc.cpp:2307
msgid ""
"The ISTEXT() function returns True if the parameter is a string. Otherwise "
"it returns False"
msgstr ""
"A función ISTEXT() devolve Verdadeiro se o parámetro é unha cadea de texto; "
"caso contrario devolve Falso"

#. i18n: file: functions/information.xml:180
#: xml_doc.cpp:2309
msgid "ISTEXT(x)"
msgstr "ISTEXT(x)"

#. i18n: file: functions/information.xml:181
#: xml_doc.cpp:2311
msgid "ISTEXT(12) returns False"
msgstr "ISTEXT(12) devolve Falso"

#. i18n: file: functions/information.xml:182
#: xml_doc.cpp:2313
msgid "ISTEXT(\"hello\") returns True"
msgstr "ISTEXT(\"ola\") devolve Verdadeiro"

#. i18n: file: functions/information.xml:194
#: xml_doc.cpp:2317
msgid ""
"The ISNONTEXT() function returns True if the parameter is not a string. "
"Otherwise it returns False. It's the same as ISNOTTEXT."
msgstr ""
"A función ISNONTEXT() devolve Verdadeiro se o parámetro non é unha cadea de "
"texto. Caso contrario, devolve Falso. É a mesma que ISNOTTEXT."

#. i18n: file: functions/information.xml:195
#: xml_doc.cpp:2319
msgid "ISNONTEXT(x)"
msgstr "ISNONTEXT(x)"

#. i18n: file: functions/information.xml:196
#: xml_doc.cpp:2321
msgid "ISNONTEXT(12) returns True"
msgstr "ISNONTEXT(12) devolve Verdadeiro"

#. i18n: file: functions/information.xml:197
#: xml_doc.cpp:2323
