#: xml_doc.cpp:4054
msgid "NORMSDIST(Number)"
msgstr "NORMSDIST(número)"

#. i18n: file: functions/statistical.xml:890
#: xml_doc.cpp:4056
msgid "NORMSDIST(1) equals 0.84"
msgstr "NORMSDIST(1) é igual a 0.84"

#. i18n: file: functions/statistical.xml:902
#: xml_doc.cpp:4060
