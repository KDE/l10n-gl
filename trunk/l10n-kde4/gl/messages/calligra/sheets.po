#: xml_doc.cpp:444
msgid "YEAR(\"2/22/2002\") returns 2002"
msgstr "YEAR(\"22/02/2002\") devolve 2002"

#. i18n: file: functions/datetime.xml:136
#: xml_doc.cpp:446
msgid "YEAR(2323.1285) returns 1906"
msgstr "YEAR(2323.1285) devolve 1906"

