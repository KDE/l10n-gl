msgstr "NPER(0,1; -100; 1000) é igual a 11"

#. i18n: file: functions/financial.xml:861
#: xml_doc.cpp:1836
msgid "NPER(0.06; 0; -10000; 20000 ;0) returns 11.906"
msgstr "NPER(0.06; 0; -10000; 20000 ;0) devolve 11.906"

