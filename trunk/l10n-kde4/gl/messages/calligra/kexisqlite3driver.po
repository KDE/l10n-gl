#: sqliteadmin.cpp:42
#, kde-format
msgid "Could not compact database \"%1\"."
msgstr "Non foi posíbel compactar a base de datos «%1»."

#: sqliteconnection.cpp:312
#, kde-format
msgid "Could not remove file \"%1\"."
msgstr "Non foi posíbel eliminar o ficheiro «%1»."

#: sqliteconnection.cpp:314
msgid ""
"Check the file's permissions and whether it is already opened and locked by "
"another application."
msgstr ""
"Comprobe os permisos do ficheiro, e asegúrese de que non se abrir xa noutro "
"programa que está a impedir o acceso a el."

#: sqlitevacuum.cpp:130
msgctxt "@title:window"
msgid "Compacting Database"
msgstr "Compactando a base de datos «%1»…"

#: sqlitevacuum.cpp:131
#, kde-format
msgctxt "@info"
msgid "Compacting database <resource>%1</resource>..."
msgstr "Compactando a base de datos <resource>%1</resource>…"

#: sqlitevacuum.cpp:210
#, kde-format
msgctxt "@info"
msgid "The database has been compacted. Current size decreased by %1% to %2."
msgstr ""
"A base de datos foi compactada. O tamaño actual diminuíu de %1% até o %2."
