#: plugins/paintops/mypaint/mypaint_brush_resource.cpp:170
msgid "slow position tracking"
msgstr "seguimento de posición lento"

#: plugins/paintops/mypaint/mypaint_brush_resource.cpp:170
msgid ""
"Slowdown pointer tracking speed. 0 disables it, higher values remove more "
"jitter in cursor movements. Useful for drawing smooth, comic-like outlines."
msgstr ""
"Aminoramento do punteiro na velocidade de seguimento. 0 desatívao e os "
"valores máis elevados eliminan a axitación nos movementos do cursor. Isto é "
"útil para debuxar liñas suaves como as da banda deseñada."

#: plugins/paintops/mypaint/mypaint_brush_resource.cpp:171
msgid "slow tracking per dab"
msgstr "seguimento de posición por pincelada"

#: plugins/paintops/mypaint/mypaint_brush_resource.cpp:171
