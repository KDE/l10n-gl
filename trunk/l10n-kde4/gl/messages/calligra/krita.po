"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Bitstream Vera Sans'; font-"
"size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"family:'Ubuntu'; font-weight:600;\">Warning</span><span style=\" font-"
"family:'Ubuntu';\">: Activa o OpenGL con algún controlador pode dar lugar a "
"quebras e problemas de rendemento. OpenGL activa o modo 16bit/canle para "
"algunhas tarxetas e visualizacións.</span></p></body></html>"

