#: kmailmigrator.cpp:543
msgctxt "@info"
msgid ""
"<para>Cached IMAP accounts have a local copy of the server's data.</"
"para><para>These copies can either be kept in local folders, or be deleted "
"after import.</para><note>Mail that was not imported will always be kept in "
"local folders.</note>"
msgstr ""
"<para>As contas de IMAP na caché teñen unha copia local dos datos do "
"servidor.</para> <para>Estas copias pódense manter en cartafoles locais ou "
"eliminar despois de importalas.</para> <note>O correo que non se importe "
"permanece sempre nos cartafoles locais.</note>"

