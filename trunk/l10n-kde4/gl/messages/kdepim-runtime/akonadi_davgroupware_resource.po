#: setupwizard.cpp:137
msgid "DAV groupware configuration wizard"
msgstr "Asistente para a configuración dun grupo DAV"

#: setupwizard.cpp:203
msgid "Login Credentials"
msgstr "Credenciais de acceso"

#: setupwizard.cpp:204
msgid "Enter your credentials to login to the groupware server"
msgstr ""
"Introduza as súas credenciais para acceder ao servidor de traballo en grupo"

#: setupwizard.cpp:209
msgid "User"
msgstr "Usuario:"

#: setupwizard.cpp:214
msgid "Password"
msgstr "Contrasinal"

#: setupwizard.cpp:243
msgid "Predefined provider found"
msgstr "Atopouse un provedor predefinido."

#: setupwizard.cpp:244
msgid "Select if you want to use the auto-detected provider"
msgstr "Indique se quere empregar o provedor detectado."

#: setupwizard.cpp:259
msgid "No, choose another server"
msgstr "Non, seleccionar outro servidor"

#: setupwizard.cpp:266
#, kde-format
msgid ""
"Based on the email address you used as a login, this wizard\n"
"can configure automatically an account for %1 services.\n"
"Do you wish to do so?"
msgstr ""
"Baseándose no enderezo que empregou para identificarse, o asistente pode "
"configurar automaticamente unha conta para %1 servizos.\n"
"Quere facelo?"

#: setupwizard.cpp:270
#, kde-format
msgid "Yes, use %1 as provider"
msgstr "Si, usar %1 como provedor"

#: setupwizard.cpp:297
msgid "Groupware Server"
msgstr "Servidor de Traballo en Grupo"

#: setupwizard.cpp:298
msgid "Select the groupware server the resource shall be configured for"
msgstr ""
"Seleccione o servidor de traballo en grupo para o que desexa configurar este "
"recurso"

#: setupwizard.cpp:324
msgid "Use one of those servers:"
msgstr "Usar un deses servidores:"

#: setupwizard.cpp:334
msgid "Configure the resource manually"
msgstr "Configurar o recurso manualmente"

#: setupwizard.cpp:370
msgid "Connection"
msgstr "Conexión"

#: setupwizard.cpp:371
msgid "Enter the connection information for the groupware server"
msgstr "Introduza a información da conexión do servidor de traballo en grupo"

#: setupwizard.cpp:379
msgid "Host"
msgstr "Servidor"

#: setupwizard.cpp:382
msgid "Installation path"
msgstr "Ruta de instalación"

#: setupwizard.cpp:385
msgid "Use secure connection"
msgstr "Empregar unha conexión segura"

#: setupwizard.cpp:411
msgid "Final URL (CalDav)"
msgstr "URL final (CalDav)"

#: setupwizard.cpp:416
msgid "Final URL (CardDav)"
msgstr "URL final (CardDav)"

#: setupwizard.cpp:421
msgid "Final URL (GroupDav)"
msgstr "URL final (GroupDav)"

