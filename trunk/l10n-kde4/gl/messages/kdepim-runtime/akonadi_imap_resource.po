#. i18n: ectx: label, entry (SievePort), group (siever)
#: imapresource.kcfg:95
msgid "Define sieve port"
msgstr "Indique o porto de sieve"

#. i18n: ectx: label, entry (SieveAlternateUrl), group (siever)
#: imapresource.kcfg:99
