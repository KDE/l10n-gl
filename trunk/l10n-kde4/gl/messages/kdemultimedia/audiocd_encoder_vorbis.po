#. i18n: tag string
#. i18n: file encodervorbisconfig.ui line 291
#: rc.cpp:208
#, no-c-format
msgid ""
"You can set the quality of the encoded stream here. A higher value implies a "
"higher quality but encodes slower."
msgstr ""
"Aquí pode estabelecer a calidade do fluxo codificado. Un valor máis alto "
"implica unha calidade maior pero codifícase máis lentamente."

#. i18n: tag string
#. i18n: file encodervorbisconfig.ui line 315
#: rc.cpp:212
#, no-c-format
msgid "Higher is better but slower"
msgstr "A alta é mellor que a baixa"

