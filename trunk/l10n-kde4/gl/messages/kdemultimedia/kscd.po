#: rc.cpp:63
msgid "Select &audio backend:"
msgstr "Escolla o &mecanismo de son:"

#. i18n: tag string
#. i18n: file configWidgetUI.ui line 264
#: rc.cpp:66
msgid "Select audio de&vice:"
msgstr "Escolla o dispositi&vo de son:"

#. i18n: tag string
