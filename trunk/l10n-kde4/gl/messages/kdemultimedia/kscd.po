#: rc.cpp:33 rc.cpp:121
msgid ""
"When this option is selected the CD will start playing automatically upon "
"being inserted into the CD-ROM."
msgstr ""
"Cando se selecciona esta opción o CD reproducirase automaticamente despois "
"de inserilo no leitor."

#. i18n: tag string
#. i18n: file configWidgetUI.ui line 151
#: rc.cpp:36
msgid "Auto&play when CD inserted"
msgstr "&Reproducir automaticamente cando se insere un CD"

