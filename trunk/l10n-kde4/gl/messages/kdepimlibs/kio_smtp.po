#: command.cpp:135
msgid ""
"The server rejected both EHLO and HELO commands as unknown or "
"unimplemented.\n"
"Please contact the server's system administrator."
msgstr ""
"O servidor rexeitou as ordens EHLO e HELO tratándoas como descoñecidas ou "
"sen implementar.\n"
"Por favor, póñase en contacto co administrador do sistema."

#: command.cpp:149
#, kde-format
msgid ""
"Unexpected server response to %1 command.\n"
"%2"
msgstr ""
"Responsa inesperada do servidor á orden %1.\n"
"%2"

#: command.cpp:169
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"O seu servidor SMTP non soporta TLS. Desactive TLS, se desexa conectarse sen "
"cifrado."

#: command.cpp:180
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"O seu servidor SMTP di soportar TLS pero a negociación non tivo éxito.\n"
"Pode desactivar TLS en KDE usando o módulo de configuración da cifraxe."

#: command.cpp:185
msgid "Connection Failed"
msgstr "Fallou a conexión"

#: command.cpp:192
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "Aconteceu un erro durante a autenticación: %1"

#: command.cpp:258
msgid "No authentication details supplied."
msgstr "Non se indicaron os detalles da autenticación."

#: command.cpp:350
msgid "Choose a different authentication method."
msgstr "Escolla un método diferente de autenticación."

#: command.cpp:352
#, kde-format
msgid "Your SMTP server does not support %1."
msgstr "O seu servidor SMTP non soporta %1."

#: command.cpp:353
msgid "Your SMTP server does not support (unspecified method)."
msgstr "O seu servidor SMTP dá soporte (método non especificado)."

#: command.cpp:358
#, kde-format
msgid ""
"Your SMTP server does not support authentication.\n"
"%1"
msgstr ""
"O seu servidor SMTP non soporta autenticación.\n"
"%1"

#: command.cpp:362
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"%1"
msgstr ""
"Fallou a autenticación.\n"
"O máis probábel é que o contrasinal fora incorrecto.\n"
"%1"

#: command.cpp:500
msgid "Could not read data from application."
msgstr "Non foi posíbel ler os datos do programa."

#: command.cpp:517
#, kde-format
msgid ""
"The message content was not accepted.\n"
"%1"
msgstr ""
"O contido da mensaxe non foi aceptado.\n"
"%1"

#: response.cpp:103
#, kde-format
msgid ""
"The server responded:\n"
"%1"
msgstr ""
"Resposta do servidor:\n"
"%1"

#: response.cpp:105
#, kde-format
msgid "The server responded: \"%1\""
msgstr "Resposta do servidor: «%1»"

#: response.cpp:107
msgid "This is a temporary failure. You may try again later."
msgstr "Isto é un fallo temporal. Pode tentalo máis tarde."

#: smtp.cpp:133
msgid "The application sent an invalid request."
msgstr "O programa enviou un pedido non válido."

#: smtp.cpp:195
msgid "The sender address is missing."
msgstr "Falta o enderezo do remitente."

#: smtp.cpp:203
#, kde-format
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "Fallou SMTPProtocol::smtp_open (%1)"

#: smtp.cpp:211
msgid ""
"Your server does not support sending of 8-bit messages.\n"
"Please use base64 or quoted-printable encoding."
msgstr ""
"O seu servidor non soporta o envío de mensaxes de 8 bits.\n"
"Por favor, use codificación base64 ou «quoted-printable»."

#: smtp.cpp:257
msgid "Writing to socket failed."
msgstr "Fallou a escritura no socket."

#: smtp.cpp:295
#, kde-format
msgid "Invalid SMTP response (%1) received."
msgstr "Recibiuse unha resposta SMTP non válida (%1)."

#: smtp.cpp:490
#, kde-format
msgid ""
"The server did not accept the connection.\n"
"%1"
msgstr ""
"O servidor non aceptou a conexión.\n"
"%1"

#: smtp.cpp:555
msgid "Username and password for your SMTP account:"
msgstr "Nome de usuario e contrasinal da súa conta SMTP:"

#: transactionstate.cpp:50
#, kde-format
msgid ""
"The server did not accept a blank sender address.\n"
"%1"
msgstr ""
"O servidor non acepta enderezos de remite en branco.\n"
"%1"

#: transactionstate.cpp:53
#, kde-format
msgid ""
"The server did not accept the sender address \"%1\".\n"
"%2"
msgstr ""
"O servidor non aceptou o enderezo de remite «%1».\n"
"%2"

#: transactionstate.cpp:98
#, kde-format
msgid ""
"Message sending failed since the following recipients were rejected by the "
"server:\n"
"%1"
msgstr ""
"O envío de mensaxes fallou porque os seguintes destinatarios foron recusados "
"polo servidor:\n"
"%1"

#: transactionstate.cpp:103
#, kde-format
msgid ""
"The attempt to start sending the message content failed.\n"
"%1"
msgstr ""
"Fallou o intento de iniciar o envío do contido da mensaxe.\n"
"%1"

#: transactionstate.cpp:107
msgid "Unhandled error condition. Please send a bug report."
msgstr "Condición de erro descoñecida. Por favor, envíe un informe de erro."

#~ msgid "Authentication support is not compiled into kio_smtp."
#~ msgstr "O soporte de autenticación non está compilado en kio_smtp."
