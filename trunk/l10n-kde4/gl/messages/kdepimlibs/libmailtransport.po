#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 106
#: rc.cpp:87
msgid ""
"\n"
"        Check this option to use a custom hostname when identifying to the "
"mail server.\n"
"        <p/>This is useful when your system's hostname may not be set "
"correctly or to mask your system's true hostname.\n"
"      "
msgstr ""
"\n"
"        Sinale esta opción para usar un nome de servidor personalizado cando "
"se identifica ante o servidor de correo.\n"
"        <p/>Isto é útil se o nome do seu sistema non pode ser configurado "
"correctamente ou para ocultar o nome auténtico do seu sistema.\n"
"      "

#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 111
#: rc.cpp:96
msgid "Enter the hostname that should be used when identifying to the server."
msgstr ""
"Indique o nome de máquina que será usado cando se identifique co servidor."

