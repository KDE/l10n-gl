#: rc.cpp:78
msgid "TLS encryption"
msgstr "Cifraxe TLS"

#. i18n: tag label
#. i18n: file mailtransport.kcfg line 86
#: rc.cpp:81
msgid "Authentication method"
msgstr "Método de autenticación"

