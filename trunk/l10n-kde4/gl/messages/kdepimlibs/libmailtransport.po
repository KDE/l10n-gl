#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 34
#: rc.cpp:24
msgid "The domain name or numerical address of the SMTP server."
msgstr "O nome de dominio ou o enderezo numérico do servidor SMTP."

#. i18n: tag label
#. i18n: file mailtransport.kcfg line 37
#: rc.cpp:27
msgid "Port number of the server"
msgstr "Número de porto do servidor"

#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 38
#: rc.cpp:30
msgid ""
"The port number that the SMTP server is listening on. The default port is 25."
msgstr ""
"O número de porto que está a escoitar o servidor SMTP. Por omisión é o 25."

#. i18n: tag label
#. i18n: file mailtransport.kcfg line 42
#: rc.cpp:33
msgid "User name needed for login"
msgstr "Nome de usuario preciso para autenticarse"

#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 43
#: rc.cpp:36
msgid "The user name to send to the server for authorization."
msgstr "O nome de usuario que se enviará ao servidor para autenticalo."

#. i18n: tag label
#. i18n: file mailtransport.kcfg line 46
#: rc.cpp:39
msgid "Command to execute before sending a mail"
msgstr "O comando a executar antes de enviar un correo"

#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 51
#: rc.cpp:42
msgid ""
"\n"
"        A command to run locally, prior to sending email.\n"
"        This can be used to set up SSH tunnels, for example.\n"
"        Leave it empty if no command should be run.\n"
"      "
msgstr ""
"\n"
"        Un comando a executar localmente, antes de enviar o correo.\n"
"        Isto pode usarse para configurar tuneis SSH, por exemplo.\n"
"        Déixeo baleiro se non se debe executar nengún comando.\n"
"      "

#. i18n: tag label
#. i18n: file mailtransport.kcfg line 54
#: rc.cpp:49
msgid "Server requires authentication"
msgstr "O servidor requere autenticación"

#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 58
#: rc.cpp:52
msgid ""
"\n"
"        Check this option if your SMTP server requires authentication before "
"accepting mail.\n"
"        This is known as 'Authenticated SMTP' or simply ASMTP.\n"
"      "
msgstr ""
"\n"
"        Sinale esta opción se o seu servidor SMTP requere autenticación "
"antes de aceitar correo.\n"
"        Isto coñécese como \"SMTP autenticado\" ou abreviando ASMTP.\n"
"      "

#. i18n: tag label
#. i18n: file mailtransport.kcfg line 62
#: rc.cpp:58
msgid "Store password"
msgstr "Gardar o contrasinal"

#. i18n: tag whatsthis
#. i18n: file mailtransport.kcfg line 68
#: rc.cpp:61
msgid ""
"\n"
"        Check this option to have your password stored.\n"
"        \\nIf KWallet is available the password will be stored there which "
"is considered safe.\\n\n"
"        However, if KWallet is not available, the password will be stored in "
"the configuration file.\n"
"        The password is stored in an obfuscated format, but should not be "
"considered secure from decryption efforts if access to the configuration "
"file is obtained.\n"
"      "
msgstr ""
"\n"
"        Sinale esta opción para gardar o seu contrasinal.\n"
"        \\nSe KWallet está disponíbel o contrasinal será gardado por el,o "
"que se considera seguro.\\n\n"
"        Porén, se KWallet non está disponíbel, o contrasinal será gardado no "
"ficheiro de configuración.\n"
"        O contrasinal será gardado tras ofuscalo, pero non debe ser "
"considerado como seguro ante a decifraxe de obterse aceso ao ficheiro de "
"configuración.\n"
"      "

#. i18n: tag label
#. i18n: file mailtransport.kcfg line 72
#: rc.cpp:69
msgid "Encryption method used for communication"
msgstr "Método de cifraxe usado na comunicación"

#. i18n: tag label
#. i18n: file mailtransport.kcfg line 75
#: rc.cpp:72
msgid "No encryption"
