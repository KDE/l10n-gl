#: pop3.cpp:237
#, kde-format
msgid "The server said: \"%1\""
msgstr "O servidor respondeu: \"%1\""

#: pop3.cpp:259
msgid "The server terminated the connection."
msgstr "O servidor terminou a conexón."

#: pop3.cpp:261
#, kde-format
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""
"Resposta non válida do servidor:\n"
"\"%1\""

#: pop3.cpp:298
msgid "Could not send to server.\n"
msgstr "Non foi posíbel enviar ao servidor.\n"

#: pop3.cpp:351 pop3.cpp:409 pop3.cpp:598
msgid "No authentication details supplied."
msgstr "Non se forneceron os detalles da autenticación."

#: pop3.cpp:387
#, kde-format
msgid ""
"Login via APOP failed. The server %1 may not support APOP, although it "
"claims to support it, or the password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Fallou o aceso mediante APOP. O servidor %1 pode que non soportar APOP, "
"aínda que diga que si o admite, ou o contrasinal pode estar equivocado.\n"
"\n"
"%2"

#: pop3.cpp:447
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "Aconteceu un erro durante a autenticación: %1"

#: pop3.cpp:567
#, kde-format
msgid ""
"Login via SASL (%1) failed. The server may not support %2, or the password "
"may be wrong.\n"
"\n"
"%3"
msgstr ""
"Fallou o aceso mediante SASL (%1). O máis probábel é que o seu servidor non "
"soporte %2 ou que o contrasinal sexa incorrecto.\n"
"\n"
"%3"

#: pop3.cpp:576
msgid ""
"Your POP3 server does not support SASL.\n"
"Choose a different authentication method."
msgstr ""
"O seu servidor POP3 non soporta SASL.\n"
"Seleccione un método diferente de autenticación."

#: pop3.cpp:584
msgid "SASL authentication is not compiled into kio_pop3."
msgstr "A autenticación SASL non se compilou no kio_pop3."

#: pop3.cpp:616 pop3.cpp:665
#, kde-format
msgid ""
"Could not login to %1.\n"
"\n"
msgstr ""
"Non foi posíbel aceder a %1.\n"
"\n"

#: pop3.cpp:630
#, kde-format
msgid ""
"Could not login to %1. The password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Non foi posíbel aceder a %1. O máis probábel é que o contrasinal sexa "
"incorrecto.\n"
"\n"
"%2"

#: pop3.cpp:668
msgid "The server terminated the connection immediately."
msgstr "O servidor terminou a conexón inmediatamente."

#: pop3.cpp:669
#, kde-format
msgid ""
"Server does not respond properly:\n"
"%1\n"
msgstr ""
"O servidor non respondeu adecuadamente:\n"
"%1\n"

#: pop3.cpp:697
msgid ""
"Your POP3 server does not support APOP.\n"
"Choose a different authentication method."
msgstr ""
"O seu servidor POP3 non soporta APOP.\n"
"Escolla un método diferente de autenticación."

#: pop3.cpp:715
msgid ""
"Your POP3 server claims to support TLS but negotiation was unsuccessful. You "
"can disable TLS in KDE using the crypto settings module."
msgstr ""
"O seu servidor POP3 di soportar TLS pero a negociación non tivo éxito. Pode "
"desactivar TLS en KDE utilizando o módulo de configuración de cifrado."

#: pop3.cpp:725
msgid ""
"Your POP3 server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"O seu servidor POP3 non soporta TLS. Desactive TLS, se desexa conectarse sen "
"cifrado."

#: pop3.cpp:734
msgid "Username and password for your POP3 account:"
msgstr "Nome de usuario e contrasinal para a súa conta POP3:"

#: pop3.cpp:930 pop3.cpp:939 pop3.cpp:1074
msgid "Unexpected response from POP3 server."
msgstr "Resposta inesperada do servidor POP3."
