#: ldapconnection.cpp:161
msgid ""
"SASL support is not available...Please recompile libkldap with the Cyrus-"
"SASL (or compatible) client libraries, or complain to your distribution "
"packagers."
msgstr ""
"O soporte de SASL non está disponíbel... Por favor, compile de novo libkldap "
"coas bibliotecas cliente de Cyrus-SASL (ou compatíbeis), ou protéstelles aos "
"empaquetadores da súa distribución."

#: ldapconnection.cpp:269
msgid "An error occurred during the connection initialization phase."
msgstr "Aconteceu un erro durante a fase de inicialización da conexón."

#: ldapconnection.cpp:276
msgid "Cannot set protocol version to %1."
msgstr "Non é posíbel estabelecer a versión do protocolo como %1."

#: ldapconnection.cpp:287
msgid "Cannot set timeout to %1 seconds."
msgstr "Non é posíbel estabelecer o límite de tempo a %1 segundos."

#: ldapconnection.cpp:306
msgid "TLS support not available in the LDAP client libraries."
msgstr "As bibliotecas LDAP do cliente non teñen soporte para TLS."

#: ldapconnection.cpp:316
msgid "Cannot set size limit."
msgstr "Non é posíbel estabelecer o límite de tamaño."

#: ldapconnection.cpp:326
msgid "Cannot set time limit."
msgstr "Non é posíbel estabelecer o límite de tempo."

#: ldapconnection.cpp:336
msgid "Cannot initialize the SASL client."
msgstr "Non foi posíbel inicializar o cliente de SASL."

#: ldapconnection.cpp:415
msgid ""
"LDAP support not compiled in. Please recompile libkldap with the OpenLDAP "
"(or compatible) client libraries, or complain to your distribution packagers."
msgstr ""
"Non ten soporte de LDAP compilado nas bibliotecas. Por favor, compile de "
"novo libkldap coas bibliotecas cliente de OpenLDAP (ou compatíbeis), ou "
"protételles aos empaquetadores da súa distribución."

