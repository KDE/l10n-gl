#: selftestdialog.cpp:319
msgid "akonadictl not found"
msgstr "non se atopou akonadictl"

#: selftestdialog.cpp:320
msgid ""
"The program 'akonadictl' needs to be accessible in $PATH. Make sure you have "
"the Akonadi server installed."
msgstr ""
"O programa \"akonadictl\" debe estar acesíbel mediante $PATH. Verifique que "
"ten instalado o servidor Akonadi."

#: selftestdialog.cpp:326
msgid "akonadictl found and usable"
msgstr "achouse akonadictl e é empregábel"

#: selftestdialog.cpp:327
#, kde-format
