msgstr ""
"O proceso de control de Akonadi non informou de ningún erro durante a "
"anterior arrancada."

#: selftestdialog.cpp:540
msgid "Previous Akonadi control error log found."
msgstr "Achouse un rexistro previo de erros do control de Akonadi."

#: selftestdialog.cpp:541
