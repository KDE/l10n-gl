#: nntp.cpp:124 nntp.cpp:490
#, kde-format
msgid "Selecting group %1..."
msgstr "A escoller o grupo %1..."

#: nntp.cpp:139
msgid "Downloading article..."
msgstr "A obter o artigo..."

#: nntp.cpp:197
#, kde-format
msgid "Invalid special command %1"
msgstr "A orde especial %1 non é válida"

#: nntp.cpp:205
msgid "Sending article..."
msgstr "A enviar o artigo..."

#: nntp.cpp:355
msgid "Downloading group list..."
msgstr "A obter a lista de grupos..."

#: nntp.cpp:360
msgid "Looking for new groups..."
msgstr "A procurar por novos grupos..."

#: nntp.cpp:426
msgid "Downloading group descriptions..."
msgstr "A obter as descricións dos grupos..."

#: nntp.cpp:512
#, kde-format
msgid ""
"Could not extract message serial numbers from server response:\n"
"%1"
msgstr ""
"Non foi posíbel extraer os números de serie das mensaxes da resposta do "
"servidor:\n"
"%1"

#: nntp.cpp:527
msgid "Downloading new headers..."
msgstr "A obter os cabezallos novos..."

#: nntp.cpp:558
#, kde-format
msgid ""
"Could not extract first message id from server response:\n"
"%1"
msgstr ""
"Non foi posíbel extraer o identificador da primeira mensaxe da resposta do "
"servidor:\n"
"%1"

#: nntp.cpp:584
#, kde-format
msgid ""
"Could not extract message id from server response:\n"
"%1"
msgstr ""
"Non foi posíbel extraer o identificador da mensaxe da resposta do servidor:\n"
"%1"

#: nntp.cpp:733
msgid "Connecting to server..."
msgstr "A conectar co servidor..."

#: nntp.cpp:767
msgid "This server does not support TLS"
msgstr "Este servidor non admite TLS"

#: nntp.cpp:771
msgid "TLS negotiation failed"
msgstr "Fallou a negociación TLS"

#: nntp.cpp:886
#, kde-format
msgid ""
"The server %1 could not handle your request.\n"
"Please try again now or latter if the problem persists."
msgstr ""
"O servidor %1 non puido xestionar a petición.\n"
"Ténteo de novo agora, ou máis tarde se o problema persistir."

#: nntp.cpp:891
msgid "You need to authenticate to access the requested resource."
msgstr "Ten que autenticar o acceso ao recurso solicitado."

#: nntp.cpp:894
msgid "The supplied login and/or password are incorrect."
msgstr "O nome de usuario e /ou o contrasinal son incorrectos."

#: nntp.cpp:900
#, kde-format
msgid ""
"Unexpected server response to %1 command:\n"
"%2"
msgstr ""
"Resposta inesperada do servidor á orde %1:\n"
"%2"
