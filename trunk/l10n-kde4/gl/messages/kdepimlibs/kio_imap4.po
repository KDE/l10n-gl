#: imap4.cpp:622
#, kde-format
msgid "Message from %1 while processing '%2': %3"
msgstr "Mensaxe dende %1 mentres se procesaba '%2': %3"

#: imap4.cpp:624
#, kde-format
msgid "Message from %1: %2"
msgstr "Mensaxe dende %1: %2"

#: imap4.cpp:951
#, kde-format
msgid ""
"The following folder will be created on the server: %1 What do you want to "
"store in this folder?"
msgstr ""
"Crearase o vindeiro cartafol no servidor: %1. Que quere almacenar neste "
"cartafol?"

#: imap4.cpp:953
msgid "Create Folder"
msgstr "Crear carpeta"

#: imap4.cpp:954
msgid "&Messages"
msgstr "&Mensaxes"

#: imap4.cpp:954
msgid "&Subfolders"
msgstr "&Subcarpetas"

#: imap4.cpp:1289
#, kde-format
msgid "Unsubscribe of folder %1 failed. The server returned: %2"
msgstr "Fallou a desubscripción ao cartafol %1. O servidor devolveu: %2"

#: imap4.cpp:1310
#, kde-format
msgid "Subscribe of folder %1 failed. The server returned: %2"
msgstr "Fallou a subscripción ao cartafol %1. O servidor devolveu: %2"

#: imap4.cpp:1379
#, kde-format
msgid "Changing the flags of message %1 failed with %2."
msgstr "Fallou a modificación das bandeiras da mensaxe %1 co erro %2."

#: imap4.cpp:1391
#, kde-format
msgid "Silent Changing the flags of message %1 failed with %2."
msgstr "Fallou a modificación muda das bandeiras da mensaxe %1 co erro %2."

#: imap4.cpp:1423
#, kde-format
msgid "Changing the flags of message %1 failed."
msgstr "Erro na modificación dos flags da mensaxe %1."

#: imap4.cpp:1468
#, kde-format
msgid ""
"Setting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"Fallou o estaebelcemento da Lista de Control de Acceso no cartafol %1 para o "
"usuario %2.O servidor devolveu: %3"

#: imap4.cpp:1487
#, kde-format
msgid ""
"Deleting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"Fallou o borrado da Lista de Control de Acceso no cartafol %1 para o usuario "
"%2. O servidor devolveu: %3"

#: imap4.cpp:1504 imap4.cpp:1531
#, kde-format
msgid ""
"Retrieving the Access Control List on folder %1 failed. The server returned: "
"%2"
msgstr ""
"Fallou a obtencón da Lista de Control de Acceso no cartafol %1. O servidor "
"devolveu: %2"

#: imap4.cpp:1565
#, kde-format
msgid "Searching of folder %1 failed. The server returned: %2"
msgstr "Fallou a procura do cartafol %1. O servidor devolveu: %2"

#: imap4.cpp:1600
#, kde-format
msgid "Custom command %1:%2 failed. The server returned: %3"
msgstr "Comando personalizado %1: fallou %2. O servidor devolveu: %3"

#: imap4.cpp:1680
#, kde-format
msgid "Setting the annotation %1 on folder %2  failed. The server returned: %3"
msgstr ""
"Fallou o estabelecemento da anotación %1 no cartafol %2. O servidor "
"devolveu: %3"

#: imap4.cpp:1704
#, kde-format
msgid ""
"Retrieving the annotation %1 on folder %2 failed. The server returned: %3"
msgstr ""
"Fallou a obtención da anotación %1 no cartafol %2. O servidor devolveu: %3"

#: imap4.cpp:1741
#, kde-format
msgid ""
"Retrieving the quota root information on folder %1 failed. The server "
"returned: %2"
msgstr ""
"Fallou a obtención da información raíz da cuota no cartafol %1. O servidor "
"devolveu: %2"

#: imap4.cpp:1797 imap4.cpp:1865
msgid "Unable to close mailbox."
msgstr "Imposible cerrar-la conta de correo."

#: imap4.cpp:1895
#, kde-format
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "Imposible abri-la carpeta %1. O servidor respondeu: %2"

#: imap4.cpp:2053
#, kde-format
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"O servidor %1 non soporta nen IMAP4 nen IMAP4rev1.\n"
"Identificouse como: %2"

#: imap4.cpp:2064
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"O servidor non soporta TLS.\n"
"Desactive esta propiedade de seguridade para conectarse sen cifrar."

#: imap4.cpp:2088
msgid "Starting TLS failed."
msgstr "O inicio de TLS fallou."

#: imap4.cpp:2100
#, kde-format
msgid "The authentication method %1 is not supported by the server."
msgstr "O método de autentificación %1 non está soportado por este servidor."

#: imap4.cpp:2115
msgid "Username and password for your IMAP account:"
msgstr "Nome de usuario e contrasinal para a súa conta IMAP:"

#: imap4.cpp:2129
#, kde-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server %1 replied:\n"
"%2"
msgstr ""
"Imposible acceder. Probabelmente o contrasinal sexa incorrecto.\n"
"O servidor %1 respondeu:\n"
"%2"

#: imap4.cpp:2136
#, kde-format
msgid ""
"Unable to authenticate via %1.\n"
"The server %2 replied:\n"
"%3"
msgstr ""
"Imposible autentificarse a través de %1.\n"
"O servidor %2 respondeu:\n"
"%3"

#: imap4.cpp:2142
msgid "SASL authentication is not compiled into kio_imap4."
msgstr "Non está compilada a autentificación SASL no kio_imap4."

#: imap4.cpp:2631
#, kde-format
msgid "Unable to open folder %1. The server replied: %2"
msgstr "Imposible abri-la carpeta %1. O servidor respondeu: %2"
