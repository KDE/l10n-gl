#: imap4.cpp:613
#, qt-format
msgid "Message from %1 while processing '%2': %3"
msgstr "Mensaxe dende %1 mentres se procesaba '%2': %3"

#: imap4.cpp:615
#, qt-format
msgid "Message from %1: %2"
msgstr "Mensaxe dende %1: %2"

#: imap4.cpp:938
#, qt-format
msgid ""
"The following folder will be created on the server: %1 What do you want to "
"store in this folder?"
msgstr ""
"Crearase o vindeiro cartafol no servidor: %1. Que quere almacenar neste "
"cartafol?"

#: imap4.cpp:940
msgid "Create Folder"
msgstr "Crear carpeta"

#: imap4.cpp:941
msgid "&Messages"
msgstr "&Mensaxes"

#: imap4.cpp:941
msgid "&Subfolders"
msgstr "&Subcarpetas"

#: imap4.cpp:1274
#, qt-format
msgid "Unsubscribe of folder %1 failed. The server returned: %2"
msgstr "Fallou a desubscripción ao cartafol %1. O servidor devolveu: %2"

#: imap4.cpp:1295
#, qt-format
msgid "Subscribe of folder %1 failed. The server returned: %2"
msgstr "Fallou a subscripción ao cartafol %1. O servidor devolveu: %2"

#: imap4.cpp:1364
#, fuzzy, qt-format
#| msgid "Changing the flags of message %1 failed."
msgid "Changing the flags of message %1 failed with %2."
msgstr "Erro na modificación dos flags da mensaxe %1."

#: imap4.cpp:1376
#, fuzzy, qt-format
#| msgid "Changing the flags of message %1 failed."
msgid "Silent Changing the flags of message %1 failed with %2."
