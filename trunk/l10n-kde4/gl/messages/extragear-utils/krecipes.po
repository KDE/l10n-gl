msgid "Username:"
msgstr "Usuario:"

#: setupassistant.cpp:231 setupassistant.cpp:346 setupassistant.cpp:458
#: dialogs/dbimportdialog.cpp:189 pref.cpp:165 pref.cpp:280
msgid "Password:"
