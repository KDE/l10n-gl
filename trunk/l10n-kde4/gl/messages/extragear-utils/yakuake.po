#: rc.cpp:56
msgctxt "@info:whatsthis"
msgid "Whether to show the tab bar in the application window."
msgstr "Indica se mostrar a barra de sesións na fiestra do programa."

#. i18n: file: app/config/yakuake.kcfg:60
