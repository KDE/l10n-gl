msgstr "Indica se anovar os títulos da sesión xunto coa barra de título."

#. i18n: file: app/config/yakuake.kcfg:67
#. i18n: ectx: label, entry (FocusFollowsMouse), group (Behavior)
#: rc.cpp:65
msgctxt "@label"
msgid "Focus follows mouse"
msgstr "O foco segue ao rato"

