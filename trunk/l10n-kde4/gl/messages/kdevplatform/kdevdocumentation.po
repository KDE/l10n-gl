#: documentation/documentation_part.cpp:99
msgid ""
"<b>Documentation browser</b><p>The documentation browser gives access to "
"various documentation sources (Qt DCF, Doxygen, KDoc, KDevelopTOC and "
"DevHelp documentation) and the KDevelop manuals. It also provides "
"documentation index and full text search capabilities."
msgstr ""
"<b>Navegador da documentación</b><p>O navegador da documentación fornece "
"aceso a varias fontes de documentación (As documentacións de Qt DCF, Doxygen, "
"KDoc, KDevelopTOC e DevHelp) e aos manuais de KDevelop. Tamén fornece un índice "
"da documentación  e procuras de textos."

#: documentation/documentation_part.cpp:106
msgid "Documentation browser"
msgstr "Navegador da documentación"

#: documentation/documentation_part.cpp:193
msgid "Documentation Settings"
msgstr "Configuración da documentación"

#: documentation/documentation_part.cpp:212
msgid "&Search in Documentation..."
msgstr "&Procurar na documentación..."

#: documentation/documentation_part.cpp:215
msgid "Full text search in the documentation"
msgstr "Procuras de texto completo na documentación"

#: documentation/documentation_part.cpp:216
msgid ""
"<b>Search in documentation</b><p>Opens the Search in documentation tab. It "
"allows a search term to be entered which will be searched for in the "
"documentation. For this to work, a full text index must be created first, "
"which can be done in the configuration dialog of the documentation plugin."
msgstr ""
"<b>Procurar na documentación</b><p>Abre a procura na lingüeta da documentacion. "
"Isto permite procurar na documentación o termo que se indique. Para que isto "
"funcione, antes debe criarse un índice de todo o texto, o que pode facerse no "
"diálogo de configuracion da extensión de documentación."

#: documentation/documentation_part.cpp:223
msgid "&Look in Documentation Index..."
msgstr "Procurar no índice da &documentación..."

#: documentation/documentation_part.cpp:226
msgid "Look in the documentation index"
msgstr "Procura no índice da documentación"

#: documentation/documentation_part.cpp:227
#: documentation/documentation_part.cpp:479
msgid ""
"<b>Look in documentation index</b><p>Opens the documentation index tab. It "
"allows a term to be entered which will be looked for in the documentation "
"index."
msgstr ""
"<b>Procurar no índice da documentación</b><p>Abre a lingüeta do índice da "
"documentación. Isto permite procurar o termo que se indique no índice da "
"documentación."

