#. i18n: file: styledialog.ui:16
#. i18n: ectx: property (windowTitle), widget (QWidget, StyleDialog)
#: rc.cpp:3
msgid "Style Dialog"
msgstr "Diálogo do estilo"

#. i18n: file: styledialog.ui:22
#. i18n: ectx: property (title), widget (QGroupBox, stylebox)
#: rc.cpp:6
msgid "Style Settings"
msgstr "Configuración do estilo"

#. i18n: file: styledialog.ui:28
#. i18n: ectx: property (text), widget (QCheckBox, embossed)
#: rc.cpp:9
msgid "&Emboss"
msgstr "&Elevar "

#. i18n: file: styledialog.ui:31
#. i18n: ectx: property (whatsThis), widget (QCheckBox, embossed)
#: rc.cpp:12
msgid "This option will enable an embossed effect for many widgets"
msgstr "Esta opción habilitará un efecto de elevación en moitos widgets"

#. i18n: file: styledialog.ui:38
#. i18n: ectx: property (text), widget (QCheckBox, gradients)
#: rc.cpp:15
msgid "Use &gradients"
msgstr "Usar &gradientes"

#. i18n: file: styledialog.ui:41
#. i18n: ectx: property (whatsThis), widget (QCheckBox, gradients)
#: rc.cpp:18
msgid ""
"This option will draw buttons and several other widgets using a gradient "
"texture"
msgstr ""
"Esta opción fai que os botóns e outros widgets usen unha textura en gradiente"

#. i18n: file: styledialog.ui:48
#. i18n: ectx: property (text), widget (QCheckBox, hlfocus)
#: rc.cpp:21
msgid "Highlight widget with input &focus"
msgstr "Realzar o widget co &foco"

#. i18n: file: styledialog.ui:51
#. i18n: ectx: property (whatsThis), widget (QCheckBox, hlfocus)
#: rc.cpp:24
msgid ""
"This option will highlight line edit and similar widgets when they have "
"input focus"
msgstr ""
"Esta opción realza as liñas de edición e outros widgets similares cando "
"están focalizados"

#. i18n: file: styledialog.ui:60
#. i18n: ectx: property (text), widget (QLabel, hllabel)
#: rc.cpp:27
msgid "&Highlight on mouse hover (width)"
msgstr "&Realzar cando o rato está encima"

#. i18n: file: styledialog.ui:66
#. i18n: ectx: property (whatsThis), widget (QLabel, hllabel)
#. i18n: file: styledialog.ui:79
#. i18n: ectx: property (whatsThis), widget (QSpinBox, highlights)
#: rc.cpp:30 rc.cpp:33
msgid ""
"This option will highlight buttons and several other widgets when the mouse "
"cursor is over them (set to '0' to disable)"
msgstr ""
"Esta opción realza os botóns e outros widgets cando o cursor do rato está "
"encima deles (poña como «0» para deshabilitar)"
