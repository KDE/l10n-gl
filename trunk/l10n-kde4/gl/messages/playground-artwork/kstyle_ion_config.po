#. i18n: tag string
#. i18n: file styledialog.ui line 16
#: rc.cpp:4
#, no-c-format
msgid "Style Dialog"
msgstr "Diálogo do estilo"

#. i18n: tag string
#. i18n: file styledialog.ui line 22
#: rc.cpp:8
#, no-c-format
msgid "Style Settings"
msgstr "Configuración do estilo"

#. i18n: tag string
#. i18n: file styledialog.ui line 28
#: rc.cpp:12
#, no-c-format
msgid "&Emboss"
msgstr "&Elevar "

#. i18n: tag string
#. i18n: file styledialog.ui line 31
#: rc.cpp:16
#, no-c-format
msgid "This option will enable an embossed effect for many widgets"
msgstr "Esta opción habilitará un efeito de elevación en moitos widgets"

#. i18n: tag string
#. i18n: file styledialog.ui line 38
#: rc.cpp:20
#, no-c-format
msgid "Use &gradients"
msgstr "Usar &gradientes"

#. i18n: tag string
#. i18n: file styledialog.ui line 41
#: rc.cpp:24
#, no-c-format
msgid ""
"This option will draw buttons and several other widgets using a gradient "
"texture"
msgstr ""
"Esta opción fai que os botóns e outros widgets usen unha textura en gradiente"

#. i18n: tag string
#. i18n: file styledialog.ui line 48
#: rc.cpp:28
#, no-c-format
msgid "Highlight widget with input &focus"
msgstr "Realzar o widget co &foco"

#. i18n: tag string
#. i18n: file styledialog.ui line 51
#: rc.cpp:32
#, no-c-format
msgid ""
"This option will highlight line edit and similar widgets when they have "
"input focus"
msgstr ""
"Esta opción realza as liñas de edición e outros widgets similares cando "
"están focalizados"

#. i18n: tag string
#. i18n: file styledialog.ui line 60
#: rc.cpp:36
#, no-c-format
msgid "&Highlight on mouse hover (width)"
msgstr "&Realzar cando o rato está acima"

#. i18n: tag string
#. i18n: file styledialog.ui line 66
#. i18n: tag string
#. i18n: file styledialog.ui line 79
#: rc.cpp:40 rc.cpp:44
#, no-c-format
msgid ""
"This option will highlight buttons and several other widgets when the mouse "
"cursor is over them (set to '0' to disable)"
msgstr ""
"Esta opción realza os botóns e outros widgets cando o cursor do rato está "
"acima deles (poña como \"0\" para deshabilitar)"
