#: dbushandler.cpp:96
msgid ""
"The Web share for magnet-links is disabled. You can set it up at settings:/"
"network-and-connectivity/sharing"
msgstr ""
"A compartición web de magnet-links está desactivada. Pódea configurar en "
"settings:/network-and-connectivity/sharing"

#: dbushandler.cpp:120
msgid ""
"Cannot start process for KTorrent.                           This should not "
"happen, even if KTorrent is not installed.                           Check "
"your machines resources and limits."
msgstr ""
"Non é posíbel iniciar o proceso do KTorrent. Isto non debería suceder, mesmo "
"se o KTorrent non estiver instalado. Comprobe os recursos e os límites das "
"máquinas."

#: dbushandler.cpp:158
#, kde-format
msgid ""
"Could not connect to KTorrent via DBus                                     "
"after %1 seconds. Is it broken?"
msgstr ""
"Non é posíbel conectarse ao KTorrent mediante "
"DBus                                     após %1 segundos. Está danado?"

#: dbushandler.cpp:180
msgid ""
"Could not get the group list, do you have a compatible KTorrent version "
"running?"
msgstr ""
"Non foi posíbel obter a lista de grupos; estase a executar unha versión do "
"KTorrent compatíbel?"

#: dbushandler.cpp:333
#, kde-format
msgid "The link for %1 does not contain the required btih hash-parameter."
msgstr "A ligazón para %1 non contén o parámetro hash btih requirido."

#: dbushandler.cpp:345
#, kde-format
msgid "The found value (%1) for the hash is neither 32 nor 40 chars long."
msgstr ""
"O valor atopado para o hash (%1) non é 32 nen ten 40 caracteres de lonxitude."

#: dbushandler.cpp:624
msgid "Torrent has been removed from KTorrent."
msgstr "Retirouse o torrente do KTorrent."

#: kio_magnet.cpp:294 kio_magnet.cpp:395
#, kde-format
msgid ""
"File exists in KTorrent, but cannot open it on disk at path\"%1\". Have you "
"removed the file manually?"
msgstr ""
"Existe o ficheiro no KTorrent, mais non é posíbel abrilo no disco na ruta "
"«%1». Tal vez eliminou o ficheiro manualmente?"

#: kio_magnet.cpp:375
msgid "You cannot write to magnet resources."
msgstr "Non é posíbel escribir en recursos magnet."

#: kio_magnet.cpp:403
#, kde-format
msgid "File \"%1\" is a directory. This should not happen. Please file a bug."
msgstr ""
"O ficheiro «%1» é un directorio. Isto non debería acontecer. Informe deste "
"erro, por favor."

#: kio_magnet.cpp:429
#, kde-format
msgid ""
"File exists in KTorrent, but cannot open it on disk at path \"%1\". Have you "
"removed the file manually?"
msgstr ""
"Existe o ficheiro no KTorrent, mais non é posíbel abrilo no disco na ruta "
"«%1». Tal vez eliminou o ficheiro manualmente?"

#. i18n: file: magnetsettings.kcfg:10
#. i18n: ectx: label, entry (Enabled), group (Magnet)
#: rc.cpp:3
msgid "Enable the global magnet-link support."
msgstr "Activar a dispoñibilidade global de magnet-link."

#. i18n: file: magnetsettings.kcfg:14
#. i18n: ectx: label, entry (ShareSize), group (Magnet)
#: rc.cpp:6
msgid "Total maximum size used by the share in MiB."
msgstr "Tamaño máximo total empregado pola compartición en MiB."

#. i18n: file: magnetsettings.kcfg:18
#. i18n: ectx: label, entry (TrustedHosts), group (Magnet)
#: rc.cpp:9
msgid "List of hosts which are directly accepted on loading"
msgstr "Lista de máquinas que se aceptan directamente ao cargar"

#. i18n: file: magnetsettings.kcfg:21
#. i18n: ectx: label, entry (ManagedTorrents), group (Magnet)
#: rc.cpp:12
msgid "Torrents inside KTorrent which are managed by these modules."
msgstr "Torrentes dentro do KTorrent que están xestionados por estes módulos."

#. i18n: file: magnetsettings.kcfg:24
#. i18n: ectx: label, entry (RunningTorrents), group (Magnet)
#: rc.cpp:15
msgid "Torrents currently used by the I/O-Slaves."
msgstr "Torrentes empregados actualmente polos I/O-Slaves."

#. i18n: file: magnetsettings.kcfg:27
#. i18n: ectx: label, entry (MaxShareRatio), group (Magnet)
#: rc.cpp:18
msgid "The maximum share ratio which should be targeted for each torrent."
msgstr "A proporción de compartición máxima asignada a cada torrente."
