"Incrustar unha miniatura de calquera das URL de imaxes enviadas nas conversas"

#: filters/searchexpansion/ktptextui_message_filter_searchexpansion.desktop:2
msgctxt "Name"
msgid "Web Shortcuts"
msgstr "Atallos web"

#: filters/texttospeech/ktptextui_message_filter_tts.desktop:2
