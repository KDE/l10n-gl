msgctxt "Comment"
msgid "Instant messaging"
msgstr "Mensaxaría instantánea"

#: ktelepathy.notifyrc:51
msgctxt "Name"
msgid "Group"
msgstr "Grupo"

#: ktelepathy.notifyrc:76
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "O grupo no que reside o contacto"

#: ktelepathy.notifyrc:100
msgctxt "Name"
msgid "Contact"
msgstr "Contacto"

#: ktelepathy.notifyrc:125
msgctxt "Comment"
msgid "The specified contact"
