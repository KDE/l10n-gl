#: gdalbum.cpp:44
msgid "Google Drive New Album"
msgstr "Novo álbum en Google Drive"

#: gdalbum.cpp:57
msgid "This is the title of the folder that will be created."
msgstr "Este é o título do cartafol que se vai crear."

#: gdalbum.cpp:60
msgctxt "folder edit"
msgid "Title:"
msgstr "Título:"

#: gdtalker.cpp:125
msgid "Google Drive Authorization"
msgstr "Autorización en Google Drive"

#: gdtalker.cpp:129
msgid ""
"Please follow the instructions in the browser. After logging in and "
"authorizing the application, copy the code from the browser, paste it in the "
"textbox below, and click OK."
msgstr ""
"Siga as instrucións no navegador. Despois de iniciar a sesión e autorizar "
"o programa, copie o código do navegador, apégueo no campo de texto en baixo, "
"e prema en Aceptar."

#: gdtalker.cpp:527
msgid "Failed to list folders"
msgstr "Produciuse un erro ao listar os cartafoles"

#: gdtalker.cpp:588
msgid "Failed to create folder"
msgstr "Produciuse un erro ao crear o cartafol"

#: gdtalker.cpp:620
msgid "Failed to upload photo"
msgstr "Produciuse un erro ao enviar a foto"

#: gdwidget.cpp:70
msgid "This is the list of images to upload to your Google Drive account."
msgstr ""
"Esta é a lista de imaxes que se van enviar á súa conta de Google Drive."

#: gdwidget.cpp:76
msgid "This is a clickable link to open Google Drive in a browser."
msgstr "Esta é unha ligazón premíbel para abrir Google Drive nun navegador."

#: gdwidget.cpp:82
msgid "Account"
msgstr "Conta"

#: gdwidget.cpp:83
msgid "This is the Google Drive account that is currently logged in."
msgstr "Esta é a conta en Google Drive na que ten actualmente sesión iniciada"

#: gdwidget.cpp:86
msgctxt "account settings"
msgid "Name:"
msgstr "Nome:"

#: gdwidget.cpp:89
msgid "Change Account"
msgstr "Cambiar de conta"

#: gdwidget.cpp:90
msgid "Change Google Drive account for transfer"
msgstr "Mudar a conta de Google Drive empregada para transferir"

#: gdwidget.cpp:100
msgid "Destination"
msgstr "Destino"

#: gdwidget.cpp:101
msgid ""
"This is the Google Drive folder to which selected photos will be uploaded."
msgstr ""
"Este é o cartafol de Google Drive ao que se transferirán as fotos escollidas."

#: gdwidget.cpp:104
msgid "Album:"
msgstr "Álbum:"

#: gdwidget.cpp:108
msgid "New Album"
msgstr "Novo álbum"

#: gdwidget.cpp:109
msgid "Create new Google Drive folder"
msgstr "Crear un cartafol novo en Google Drive"

#: gdwidget.cpp:110
msgctxt "album list"
msgid "Reload"
msgstr "Recargar"

#: gdwidget.cpp:111
msgid "Reload album list"
msgstr "Cargar de novo a lista de álbums"

#: gdwidget.cpp:120
msgid "Options"
msgstr "Opcións"

#: gdwidget.cpp:121
msgid "These are the options that would be applied to photos before upload."
msgstr "Estas son as opcións que se aplicarán ás fotos antes de as enviar."

#: gdwidget.cpp:125
msgid "Resize photos before uploading"
msgstr "Mudar o tamaño das fotos antes de envialas"

#: gdwidget.cpp:136
msgid "Maximum Dimension:"
msgstr "Tamaño máximo:"

#: gdwidget.cpp:145
msgid "JPEG Quality:"
msgstr "Calidade de JPEG:"

#: gdwindow.cpp:89
msgid "Export to Google Drive"
msgstr "Exportar a Google Drive"

#: gdwindow.cpp:90
msgid "Start Upload"
msgstr "Iniciar o envío"

#: gdwindow.cpp:90
msgid "Start upload to Google Drive"
msgstr "Iniciar o envío a Google Drive"

#: gdwindow.cpp:108
msgid "Google Drive Export"
msgstr "Exportación a Google Drive"

#: gdwindow.cpp:110
msgid "A Kipi-plugin to export images to Google Drive"
msgstr "Un engadido de Kipi para exportar imaxes a Google Drive"

