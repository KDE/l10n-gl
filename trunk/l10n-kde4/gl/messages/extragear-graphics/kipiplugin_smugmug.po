#: smugmugalbum.cpp:50
msgid "SmugMug New Album"
msgstr "Novo álbum en SmugMug"

#: smugmugalbum.cpp:63 smugmugwidget.cpp:101
msgid "Album"
msgstr "Álbum"

#: smugmugalbum.cpp:65
msgid "These are basic settings for new SmugMug album."
msgstr "Estes son opcións básicas do novo álbum en SmugMug."

#: smugmugalbum.cpp:68
msgid "Title:"
msgstr "Título:"

#: smugmugalbum.cpp:71 smugmugalbum.cpp:73
msgid "Title of the album that will be created (required)."
msgstr "O título do álbum que se vai crear (requerido)."

#: smugmugalbum.cpp:75
msgid "Category:"
msgstr "Categoría:"

#: smugmugalbum.cpp:79 smugmugalbum.cpp:81
msgid "Category of the album that will be created (required)."
msgstr "A categoría do álbum que se vai crear (requerido)."

#: smugmugalbum.cpp:83
msgid "Subcategory:"
msgstr "Subcategoría:"

#: smugmugalbum.cpp:87 smugmugalbum.cpp:89
msgid "Subcategory of the album that will be created (optional)."
msgstr "A subcategoría do álbum que se vai crear (requerido)."

#: smugmugalbum.cpp:91
msgid "Description:"
msgstr "Descrición:"

#: smugmugalbum.cpp:94 smugmugalbum.cpp:96
msgid "Description of the album that will be created (optional)."
msgstr "A descrición do álbum que se vai crear (requerido)."

#: smugmugalbum.cpp:110
msgid "Security && Privacy"
msgstr "Seguridade e intimidade"

#: smugmugalbum.cpp:112
msgid "These are security and privacy settings for new SmugMug album."
msgstr "Estas son opcións de seguridade e intimidade para o novo álbum de SmugMug."

#: smugmugalbum.cpp:115
msgid "Privacy:"
msgstr "Intimidade:"

#: smugmugalbum.cpp:117
msgid "Privacy of the new SmugMug album (required)."
msgstr "A intimidade do novo álbum SmugMug (requerido)."

#: smugmugalbum.cpp:118
msgid "Public"
msgstr "Público"

#: smugmugalbum.cpp:121
msgid "Public album is listed on your public SmugMug page."
msgstr "O álbum público listarase na súa páxina de SmugMug."

#: smugmugalbum.cpp:122
msgid "Unlisted"
msgstr "Non listado"

#: smugmugalbum.cpp:124
msgid "Unlisted album is only accessible via URL."
msgstr "Os albuns non listados só serán acesíbeis mediante URL."

#: smugmugalbum.cpp:126
msgid "Password:"
msgstr "Contrasinal:"

#: smugmugalbum.cpp:129 smugmugalbum.cpp:131
msgid "Require password to access the album (optional)."
msgstr "Require un contrasinal para aceder ao álbum (opcional)."

#: smugmugalbum.cpp:133
msgid "Password Hint:"
msgstr "Axuda para o contrasinal:"

#: smugmugalbum.cpp:136 smugmugalbum.cpp:138
msgid "Password hint to present to users on the password prompt (optional)."
msgstr "Axuda do contrasinal que se presentará os usuarios ao pedir o contrasinal (opcional)."

#: smugmugtalker.cpp:110
msgid "Logging to SmugMug service..."
msgstr "A aceder ao servizo SmugMug..."

#: smugmugtalker.cpp:345
msgid "Login failed"
msgstr "Fallou a autenticación"

#: smugmugtalker.cpp:348
msgid "Invalid API key"
msgstr "Chave non válida da API"

#: smugmugwidget.cpp:65
msgid "This is the list of images to upload on your SmugMug account."
msgstr "Esta é a listaxe de imaxes a enviar á conta no SmugMug."

#: smugmugwidget.cpp:72
msgid "This is clickable link to open SmugMug home page in web browser."
msgstr "Esta é unha ligazón para abrir a páxina web en SmugMug no navegador web."

#: smugmugwidget.cpp:78
msgid "Account"
msgstr "Conta"

#: smugmugwidget.cpp:80
msgid "This is the SmugMug account that will be used for upload."
msgstr "Esta é a conta en SmugMug que se empregará para os envíos."

#: smugmugwidget.cpp:83
msgid "Name: "
msgstr "Nome: "

#: smugmugwidget.cpp:85
msgid "E-mail: "
msgstr "Correo electrónico: "

#: smugmugwidget.cpp:88
msgid "Change Account"
msgstr "Modificar a conta"

#: smugmugwidget.cpp:103
msgid "This is the SmugMug album where selected photos will be uploaded."
msgstr "Este é o álbum en SmugMun a onde se enviarán as fotos escollidas."

#: smugmugwidget.cpp:109
msgid "New Album"
msgstr "Novo álbum"

#: smugmugwidget.cpp:112
msgid "Reload"
msgstr "Cargar de novo"

#: smugmugwidget.cpp:121
msgid "Options"
msgstr "Opcións"

#: smugmugwidget.cpp:123
msgid "These are options that will be applied to photos before upload."
msgstr "Estas son as opcións que se aplicarán ás fotos antes de envialas."

#: smugmugwidget.cpp:127
msgid "Resize photos before uploading"
msgstr "Mudar o tamaño das fotos antes de envialas"

#: smugmugwidget.cpp:137
msgid "Maximum dimension:"
msgstr "Tamaño máximo:"

#: smugmugwidget.cpp:145
msgid "JPEG quality:"
msgstr "Calidade de JPEG:"

#: smugmugwindow.cpp:79
msgid "Export to SmugMug Web Service"
msgstr "Exportar ao servizo web SmugMug"

#: smugmugwindow.cpp:91
msgid "Start Upload"
msgstr "Iniciar o envío"

#: smugmugwindow.cpp:114
msgid "SmugMug Export"
msgstr "Exportar a SmugMug"

#: smugmugwindow.cpp:116
msgid "A Kipi plugin to export image collection to SmugMug web service."
msgstr "Unha extensión de Kipi para exportar coleccións de imaxes ao servizo web SmugMug."

