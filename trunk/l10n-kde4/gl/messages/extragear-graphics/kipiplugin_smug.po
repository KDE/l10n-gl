#: smugwidget.cpp:95
msgid "SmugMug Account"
msgstr "Conta en SmugMug"

#: smugwidget.cpp:97
msgid "Login to SmugMug web service using email and password."
msgstr ""
"Acceder ao servizo web SmugMug mediante unha conta de correo e un "
"contrasinal."

