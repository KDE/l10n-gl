#: resizeimagesdialog.cpp:87
msgid "Image Resizing Options"
msgstr "Opcións de mudanza do tamaño das imaxes"

#: resizeimagesdialog.cpp:89
msgid "Type:"
msgstr "Tipo:"

#: resizeimagesdialog.cpp:91 resizeimagesdialog.cpp:95
msgid "Proportional (1 dim.)"
msgstr "Proporcional (1 dim.)"

#: resizeimagesdialog.cpp:92
msgid "Proportional (2 dim.)"
msgstr "Proporcional (2 dim.)"

#: resizeimagesdialog.cpp:93
msgid "Non-Proportional"
msgstr "Non proporcional"

#: resizeimagesdialog.cpp:94
msgid "Prepare to Print"
msgstr "Preparar para imprimir"

#: resizeimagesdialog.cpp:96
msgid "<p>Select here the image-resize type.</p>"
msgstr "<p>Escolla aquí o tipo de mudanza de tamaño da imaxe.</p>"

#: resizeimagesdialog.cpp:97
msgid ""
"<p><b>Proportional (1 dim.)</b>: standard auto-resizing using one dimension. "
"The width or the height of the images will be automatically selected, "
"depending on the images' orientations. The images' aspect ratios are "
"preserved.</p>"
msgstr ""
"<p><b>Proporcional (1 dim.)</b>: mudanza de tamaño automática normal que "
"emprega unha só dimensión. Selecciónanse automaticamente a anchura ou a "
"altura das imaxes dependendo da súa orientación. Consérvanse as proporcións "
"das imaxes.</p>"

#: resizeimagesdialog.cpp:101
msgid ""
"<p><b>Proportional (2 dim.)</b>: auto-resizing using two dimensions. The "
"images' aspect ratio are preserved. You can use this, for example, to adapt "
"your images' sizes to your screen size.</p>"
msgstr ""
"<p><b>Proporcional (2 dim.)</b> mudanza de tamaño automática normal que "
"emprega dúas dimensións. Consérvanse as proporcións das imaxes. Pódese "
"empregar, por exemplo, para adaptar o tamaño das imaxes ao tamaño da "
"pantalla.</p>"

#: resizeimagesdialog.cpp:104
msgid ""
"<p><b>Non proportional</b>: non-proportional resizing using two dimensions. "
"The images' aspect ratios are not preserved.</p>"
msgstr ""
"<p><b>Non proporcional</b>: mudanza de tamaño non proporcional que emprega "
"dúas dimensións. Non se conservan as proporcións das imaxes.</p>"

#: resizeimagesdialog.cpp:106
msgid ""
"<p><b>Prepare to print</b>: prepare the image for photographic printing. The "
"user can set the print resolution and the photographic paper size. The "
"target images will be adapted to the specified dimensions (included the "
"background size, margin size, and background color).</p>"
msgstr ""
"<p><b>Preparar para imprimir</b>: preparar a imaxe para imprimir "
"fotograficamente. O usuario pode indicar a resolución de impresión e o "
"tamaño do papel fotográfico. As imaxes de destino adáptanse ás dimensións "
"indicadas (incluído o tamaño do fondo, o tamaño da marxe e a cor de fondo).</"
"p>"

