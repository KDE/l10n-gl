#: flickrtalker.cpp:165
msgid "Getting the Frob"
msgstr "A obter o Frob"

#: flickrtalker.cpp:200
msgid "Checking if previous token is still valid"
msgstr "A comprobar se aínda é válido a anterior token"

#: flickrtalker.cpp:226
msgid ""
"Please Follow through the instructions in the browser window and return back "
"to press ok if you are authenticated or press No"
msgstr ""
"Siga por enteiro as instrucións na fiestra do navegador e volte atrás para "
"premer en Aceitar se está autenticado ou prema Non"

#: flickrtalker.cpp:228
msgid "Flickr Service Web Authorization"
msgstr "Autorización do servizo web Flickr"

#: flickrtalker.cpp:233
msgid "Authenticating the User on web"
msgstr "A autenticar o usuario na web"

#: flickrtalker.cpp:274
msgid "Getting the Token from the server"
msgstr "A obter o token do servidor"

#: flickrtalker.cpp:518
msgid "No photo specified"
msgstr "Non indicou nengunha foto"

#: flickrtalker.cpp:521
msgid "General upload failure"
msgstr "Fallo xeral do envío"

#: flickrtalker.cpp:524
msgid "Filesize was zero"
msgstr "O tamaño do ficheiro era cero"

#: flickrtalker.cpp:527
msgid "Filetype was not recognized"
msgstr "Non se recoñeceu o tipo do ficheiro"

#: flickrtalker.cpp:530
msgid "User exceeded upload limit"
msgstr "O usuario superou o límite de envío"

#: flickrtalker.cpp:533
msgid "Invalid signature"
msgstr "Sinatura non válida"

#: flickrtalker.cpp:536
msgid "Missing signature"
msgstr "Falta a sinatura"

#: flickrtalker.cpp:539
msgid "Login Failed / Invalid auth token"
msgstr "Fallou o aceso / Token de autorización non válido"

#: flickrtalker.cpp:542
msgid "Invalid API Key"
msgstr "Chave non válida da API"

#: flickrtalker.cpp:545
msgid "Service currently unavailable"
msgstr "O servizo non está disponíbel nestes momentos"

#: flickrtalker.cpp:548
msgid "Invalid Frob"
msgstr "Frob non válido"

#: flickrtalker.cpp:551
msgid "Format \"xxx\" not found"
msgstr "Non se achou o formato \"xxx\""

#: flickrtalker.cpp:554
msgid "Method \"xxx\" not found"
msgstr "Non se achou o método \"xxx\""

#: flickrtalker.cpp:557
msgid "Invalid SOAP envelope"
msgstr "Envoltura de SOAP non válida"

#: flickrtalker.cpp:560
msgid "Invalid XML-RPC Method Call"
msgstr "Chamada non válida a un método de XML-RPC"

#: flickrtalker.cpp:563
msgid "The POST method is now required for all setters"
msgstr "Agora requérese o método POST para todos os asignadores"

#: flickrtalker.cpp:566
msgid "Unknown error"
msgstr "Erro descoñecido"

#: flickrtalker.cpp:571
msgid ""
"Error Occurred: %1\n"
" We can not proceed further"
msgstr ""
"Aconteceu un erro: %1\n"
" Non podemos continuar"

#: flickrtalker.cpp:718
msgctxt "As in the persmission to"
msgid "write"
msgstr "escreber"

#: flickrtalker.cpp:720
msgctxt "As in the permission to"
msgid "read"
msgstr "ler"

#: flickrtalker.cpp:722
msgctxt "As in the permission to"
msgid "delete"
msgstr "borrar"

#: flickrtalker.cpp:752
msgid "Your token is invalid. Would you like to get a new token to proceed ?\n"
msgstr "O token non é válido. Desexa obter outro para continuar?\n"

#: flickrtalker.cpp:928
msgid "Failed to fetch photoSets List"
msgstr "Non foi posíbel obter a lista de photoSets"

#: flickrtalker.cpp:998
msgid "Failed to upload photo"
msgstr "Fallou o envío da foto"

#: flickrtalker.cpp:1044
msgid "Failed to query photo information"
msgstr "Fallou a pesquisa de información da foto"

#: flickrwidget.cpp:73
msgid ""
"<b><h2><a href='http://www.flickr.com'><font color=\"#0065DE\">flick</"
"font><font color=\"#FF0084\">r</font></a> Export</h2></b>"
msgstr ""
"<b><h2>Exportar a<a href='http://www.flickr.com'><font color=\"#0065DE"
"\">flick</font><font color=\"#FF0084\">r</font></a></h2></b>"

#: flickrwidget.cpp:84
msgid "This is the list of images to upload on your Flickr account."
msgstr "Esta é a lista de imaxes a enviar á conta en Flickr."

#: flickrwidget.cpp:94
msgid "Added Tags: "
msgstr "Etiquetas engadidas:"

#: flickrwidget.cpp:97
msgid "Use Host Application Tags"
msgstr "Usar as etiquetas do programa do servidor"

#: flickrwidget.cpp:99
msgid "Strip Space From Host Application Tags"
msgstr "Quitar os espazos das etiquetas do programa servidor"

#: flickrwidget.cpp:100
msgid "Enter here new tags separated by space."
msgstr "Indique aquí as etiquetas novas separadas por espazos."

#: flickrwidget.cpp:109
msgid "Override Default Options"
msgstr "Ignorar as opcións por omisión"

#: flickrwidget.cpp:113
msgctxt "As in accessible for people"
msgid "Public (anyone can see them)"
msgstr "Pública (pode ollala calqueira)"

#: flickrwidget.cpp:116
msgid "Visible to Family"
msgstr "Visíbel pola familia"

#: flickrwidget.cpp:119
msgid "Visible to Friends"
msgstr "Visíbel polos amigos"

#: flickrwidget.cpp:122
msgid "Resize photos before uploading"
msgstr "Mudar o tamaño das fotos antes de envialas"

#: flickrwidget.cpp:133
msgid "Maximum dimension (pixels):"
msgstr "Tamaño máximo (en píxeles):"

#: flickrwidget.cpp:143
msgid "JPEG Image Quality (higher is better):"
msgstr "Calidade JPEG da imaxe (máis alta é mellor):"

#: flickrwidget.cpp:160
msgid "Account"
msgstr "Conta"

#: flickrwidget.cpp:163
msgid "User Name: "
msgstr "Nome de usuario:"

#: flickrwidget.cpp:166
msgid "Use a different account"
msgstr "Empregar unha conta diferente"

#: flickrwidget.cpp:191
msgid "Files List"
msgstr "Lista de ficheiros"

#: flickrwidget.cpp:192
msgid "Upload Options"
msgstr "Opcións de envío"

#: flickrwindow.cpp:78
msgid "Export to Flickr Web Service"
msgstr "Exportar ao servizo web Flickr"

#: flickrwindow.cpp:104
msgid "Start Uploading"
msgstr "Iniciar o envío"

#: flickrwindow.cpp:118
msgid "Flickr Export"
msgstr "Exportar a Flickr"

#: flickrwindow.cpp:121
msgid "A Kipi plugin to export image collection to Flickr web service."
msgstr ""
"Unha extensión de Kipi para exportar colecións de imaxes ao servizo web "
"Flickr."

