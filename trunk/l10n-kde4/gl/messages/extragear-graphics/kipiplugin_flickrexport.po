#: flickrtalker.cpp:181
msgid "Getting the Frob"
msgstr "A obter o Frob"

#: flickrtalker.cpp:216
msgid "Checking if previous token is still valid"
msgstr "A comprobar se aínda é válido o anterior token"

#: flickrtalker.cpp:242
msgid ""
"Please Follow through the instructions in the browser window and return back "
"to press ok if you are authenticated or press No"
msgstr ""
"Siga por enteiro as instrucións na fiestra do navegador e volte atrás para "
"premer en Aceptar se está autenticado ou prema Non"

#: flickrtalker.cpp:244
#, kde-format
msgid "%1 Service Web Authorization"
msgstr "Autorización do servizo web %1"

#: flickrtalker.cpp:249
msgid "Authenticating the User on web"
msgstr "A autenticar o usuario na web"

#: flickrtalker.cpp:290
msgid "Getting the Token from the server"
msgstr "A obter o token do servidor"

#: flickrtalker.cpp:607
msgid "No photo specified"
msgstr "Non indicou ningunha foto"

#: flickrtalker.cpp:610
msgid "General upload failure"
msgstr "Fallo xeral do envío"

#: flickrtalker.cpp:613
msgid "Filesize was zero"
msgstr "O tamaño do ficheiro era cero"

#: flickrtalker.cpp:616
msgid "Filetype was not recognized"
msgstr "Non se recoñeceu o tipo do ficheiro"

#: flickrtalker.cpp:619
msgid "User exceeded upload limit"
msgstr "O usuario superou o límite de envío"

#: flickrtalker.cpp:622
msgid "Invalid signature"
msgstr "Sinatura non válida"

#: flickrtalker.cpp:625
msgid "Missing signature"
msgstr "Falta a sinatura"

#: flickrtalker.cpp:628
msgid "Login Failed / Invalid auth token"
msgstr "Fallou o acceso / Token de autorización non válido"

#: flickrtalker.cpp:631
msgid "Invalid API Key"
msgstr "Chave non válida da API"

#: flickrtalker.cpp:634
msgid "Service currently unavailable"
msgstr "O servizo non está dispoñíbel nestes momentos"

#: flickrtalker.cpp:637
msgid "Invalid Frob"
msgstr "Frob non válido"

#: flickrtalker.cpp:640
msgid "Format \"xxx\" not found"
msgstr "Non se achou o formato «xxx»"

#: flickrtalker.cpp:643
msgid "Method \"xxx\" not found"
msgstr "Non se achou o método «xxx»"

#: flickrtalker.cpp:646
msgid "Invalid SOAP envelope"
msgstr "Envoltura de SOAP non válida"

#: flickrtalker.cpp:649
msgid "Invalid XML-RPC Method Call"
msgstr "Chamada non válida a un método de XML-RPC"

#: flickrtalker.cpp:652
msgid "The POST method is now required for all setters"
msgstr "Agora requírese o método POST para todos os asignadores"

#: flickrtalker.cpp:655
msgid "Unknown error"
msgstr "Erro descoñecido"

#: flickrtalker.cpp:660
#, kde-format
msgid ""
"Error Occurred: %1\n"
" We can not proceed further"
msgstr ""
"Aconteceu un erro: %1\n"
" Non podemos continuar"

#: flickrtalker.cpp:807
msgctxt "As in the persmission to"
msgid "write"
msgstr "escribir"

#: flickrtalker.cpp:809
msgctxt "As in the permission to"
msgid "read"
msgstr "ler"

#: flickrtalker.cpp:811
msgctxt "As in the permission to"
msgid "delete"
msgstr "borrar"

#: flickrtalker.cpp:841
msgid "Your token is invalid. Would you like to get a new token to proceed ?\n"
msgstr "O token non é válido. Desexa obter outro para continuar?\n"

#: flickrtalker.cpp:956
msgid "PhotoSet created successfully"
msgstr "O conxunto de fotos creouse con éxito"

#: flickrtalker.cpp:967
msgid "PhotoSet creation failed: "
msgstr "Fallou a creación do conxunto de fotos:"

#: flickrtalker.cpp:1057
msgid "Failed to fetch photoSets List"
msgstr "Non foi posíbel obter a lista de conxuntos de fotos"

#: flickrtalker.cpp:1127
msgid "Failed to upload photo"
msgstr "Fallou o envío da foto"

#: flickrtalker.cpp:1182
msgid "Failed to query photo information"
msgstr "Fallou a pescuda de información da foto"

