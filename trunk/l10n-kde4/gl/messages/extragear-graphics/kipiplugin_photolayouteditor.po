#: widgets/tools/ToolsDockWidget.cpp:181
msgid "This tool allows you to rotate items on your canvas."
msgstr "Esta ferramenta permite xirar os elementos no lenzo."

#: widgets/tools/ToolsDockWidget.cpp:191
msgid "Scaling tool"
msgstr "Ferramenta de ampliación"

#: widgets/tools/ToolsDockWidget.cpp:192
msgid "This tool allows you to scale items on your canvas."
msgstr "Esta ferramenta permite modificar a ampliación dos obxectos do lenzo."

#: widgets/tools/ToolsDockWidget.cpp:202
msgid "Crop tool"
msgstr "Ferramenta de recorte"

#: widgets/tools/ToolsDockWidget.cpp:203
msgid "This tool allows you to crop items."
