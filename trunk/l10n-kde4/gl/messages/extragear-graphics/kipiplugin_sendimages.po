#: emailpage.cpp:143
#, kde-format
msgid ""
"<p>Select here the images size to send:</p><p><b>%1</b>: use this if you "
"have a very slow internet connection or if the target mailbox size is very "
"limited.</p><p><b>%2</b>: use this if you have a slow internet connection "
"and if the target mailbox size is limited.</p><p><b>%3</b>: this is the "
"default value for a medium internet connection and a target mailbox size.</"
"p><p><b>%4</b>: use this if you have a high-speed internet connection and if "
"the target mailbox size is not limited.</p><p><b>%5</b>: use this if you "
"have no size or speed restrictions.</p><p><b>%6</b>: use this only for "
"printing purpose.</p>"
msgstr ""
"<p>Indique aquí os tamaños de imaxe a enviar:</p><p><b>%1</b>: use isto se "
"ten unha conexón a internet moi lenta ou se o tamaño da caixa de correo do "
"destinatario é moi limitado.</p><p><b>%2</b>: use isto se ten unha conexión "
"lenta a internet e se o tamaño da caixa de correo do destinatario é limitado."
"</p><p><b>%3</b>: este é o valor predeterminado para unha conexión media a "
"internet e unha caixa de correo normal.</p><p><b>%4</b>: use isto se ten "
"unha conexión de alta velocidade e se o tamaño da caixa de correo do "
"destinatario non supón un límite.</p><p><b>%5</b>: use isto se non ten "
"limitacións de tamaño ou velocidade.</p><p><b>%6</b>: use isto só se ten o "
"propósito de imprimir.</p>"

#: emailpage.cpp:163
msgid "Image size:"
msgstr "Tamaño da imaxe:"

#: emailpage.cpp:172
msgid "<p>Select here the images files format to send.</p>"
msgstr "<p>Indique aquí o formato dos ficheiros coas imaxes a enviar.</p>"

#: emailpage.cpp:173
msgid ""
"<p><b>JPEG</b>: The Joint Photographic Experts Group's file format is a good "
"Web file format but it uses lossy compression.</p><p><b>PNG</b>: the "
"Portable Network Graphics format is an extensible file format for the "
"lossless, portable, well-compressed storage of raster images. PNG provides a "
"patent-free replacement for GIF and can also replace many common uses of "
"TIFF. PNG is designed to work well in online viewing applications, such as "
"the World Wide Web, so it is fully streamable with a progressive display "
"option. Also, PNG can store gamma and chromaticity data for improved color "
"matching on heterogeneous platforms.</p>"
msgstr ""
"<p><b>JPEG</b>: O formato de ficheiro \"Joint Photographic Experts Group\" é "
"un bon formato de ficheiro para a web pero usa compresión con perdas.</"
"p><p><b>PNG</b>: O formato \"Portable Network Graphics\" é un formato de "
"ficheiro extensíbel para gardar imaxes raster comprimidas sen perdas. PNG "
"fornece un substituto do GIF libre de patentes e tamén pode substituír "
"moitos usos habituais de TIFF. PNG foi deseñado para traballar ben en "
"aplicacións de visionado online, como a web, polo que pode ser transmitido e "
"mostrarse progresivamente. Tamén pode gardar datos de gama e cromaticidade "
"para un mellor axuste da cor en plataformas heteroxéneas.</p>"

#: emailpage.cpp:183
msgid "Image file format:"
msgstr "Formato de ficheiro da imaxe:"

#: emailpage.cpp:191
msgid "Image quality:"
msgstr "Calidade da imaxe:"

#: emailpage.cpp:192
msgid "<p>The new compression value of JPEG images to send:</p>"
msgstr "<p>O novo valor de compresión das imaxes JPEG a enviar:</p>"

#: emailpage.cpp:193
msgid ""
"<p><b>1</b>: very high compression<br/><b>25</b>: high compression<br/"
"><b>50</b>: medium compression<br/><b>75</b>: low compression (default value)"
"<br/><b>100</b>: no compression</p>"
msgstr ""
"<p><b>1</b>: compresión moi alta<br/><b>25</b>: compresión alta<br/><b>50</"
"b>: compresión media<br/><b>75</b>: compresión baixa (por omisión)<br/"
"><b>100</b>: sen comprimir</p>"

