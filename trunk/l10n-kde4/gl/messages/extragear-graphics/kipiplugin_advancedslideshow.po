msgstr "Só se pode baixar un ficheiro de cada vez."

#: dialogs/soundtrackdialog.cpp:449
msgid "Load playlist"
msgstr "Cargar unha lista de reprodución"

#: dialogs/soundtrackdialog.cpp:505
msgid "Save playlist"
