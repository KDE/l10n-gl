#: imageplugins/distortionfx/distortionfxtool.cpp:137
msgid "Fish Eyes"
msgstr "Ollo de peixe"

#: imageplugins/distortionfx/distortionfxtool.cpp:138
msgid "Twirl"
msgstr "Remuíño"

#: imageplugins/distortionfx/distortionfxtool.cpp:139
