#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:351
msgid "No Lens Filter"
msgstr "Sen filtro de lente"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:352
msgid ""
"<b>No Lens Filter</b>:<p>Do not apply a lens filter to render the image.</p>"
msgstr ""
"<b>Sen filtro de lente</b>:<p>Non aplica nengún filtro de lente para debuxar "
"a imaxe.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:356
msgid "Green Filter"
msgstr "Filtro verde"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:357
msgid ""
"<b>Black & White with Green Filter</b>:<p>Simulate black and white film "
"exposure using green filter. This provides a universal asset for all scenic "
"shooting, especially suited for portraits photographed against sky.</p>"
msgstr ""
"<b>Branco e negro con filtro verde</b>:<p>Simula a exposición dun filme de "
"branco e negro usando un filtro de verde. Isto dá unha calidade universal a "
"todas as escenas, con resultados especialmente bons para retratos tomados "
"contra o ceo.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:363
msgid "Orange Filter"
msgstr "Filtros laranxa"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:364
msgid ""
"<b>Black & White with Orange Filter</b>:<p>Simulate black and white film "
"exposure using orange filter. This will enhances landscapes, marine scenes "
"and aerial photography.</p>"
msgstr ""
"<b>Branco e negro con filtro laranxa</b>:<p>Simula a exposición dun filme de "
"branco e negro usando un filtro de laranxa. Isto mellora as paisaxes, "
"escenas mariñas e fotografía aérea.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:370
msgid "Red Filter"
msgstr "Filtro vermello"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:371
msgid ""
"<b>Black & White with Red Filter</b>:<p>Simulate black and white film "
"exposure using red filter. Using this one creates dramatic sky effects and "
"simulates moonlight scenes in daytime.</p>"
msgstr ""
"<b>Branco e negro con filtro vermello</b>:<p>Simula a exposición dun filme "
"de branco e negro usando un filtro de vermello. Usar isto dálle un efeito "
"dramático ao ceo e simula escenas con luz de lúa de día.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:377
msgid "Yellow Filter"
msgstr "Filtro amarelo"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:378
msgid ""
"<b>Black & White with Yellow Filter</b>:<p>Simulate black and white film "
"exposure using yellow filter. Most natural tonal correction and improves "
"contrast. Ideal for landscapes.</p>"
msgstr ""
"<b>Branco e negro con filtro amarelo</b>:<p>Simula a exposición dun filme de "
"branco e negro usando un filtro de amarelo. Corrixe a maioría do ton natural "
"e mellora o contraste. Ideal para paisaxes.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:384
msgid "Strength:"
msgstr "Forza:"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:388
msgid "<p>Set here the strength adjustment of lens filter."
msgstr "<p>Axuste aquí a potencial do filtro da lente."

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:400
msgid "No Tone Filter"
msgstr "Sen filtro de tons"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:401
msgid "<b>No Tone Filter</b>:<p>Do not apply a tone filter to the image.</p>"
msgstr "<b>Sen filtro de tons</b>:<p>Non aplica un filtro de tons á imaxe.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:405
msgid "Sepia Tone"
msgstr "Ton sepia"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:406
msgid ""
"<b>Black & White with Sepia Tone</b>:<p>Gives a warm highlight and mid-tone "
"while adding a bit of coolness to the shadows-very similar to the process of "
"bleaching a print and re-developing in a sepia toner.</p>"
msgstr ""
"<b>Branco e negro con ton sepia</b>:<p>Dá un realzado cálido e de medios "
"tons á vez que engade un pouco de frio nas sombras, moi semellante ao "
"proceso de lixiviar un impreso e desenvolvela de novo nun toner sepia.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:412
msgid "Brown Tone"
msgstr "Ton marrón"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:413
msgid ""
"<b>Black & White with Brown Tone</b>:<p>This filter is more neutral than "
"Sepia Tone filter.</p>"
msgstr ""
"<b>Branco e negro con ton marrón</b>:<p>Este filtro é máis neutro que o "
"filtro de ton sepia.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:418
msgid "Cold Tone"
msgstr "Ton frío"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:419
msgid ""
"<b>Black & White with Cold Tone</b>:<p>Start subtle and replicate printing "
"on a cold tone black and white paper such as a bromide enlarging paper.</p>"
msgstr ""
"<b>Branco e negro con ton frío</b>:<p>Fai unha réplica de impresión nun "
"papel de branco e negro con ton frío tal como papel de ampliación ao bromuro."
"</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:425
msgid "Selenium Tone"
msgstr "Tón de selenio"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:426
msgid ""
"<b>Black & White with Selenium Tone</b>:<p>This effect replicate traditional "
"selenium chemical toning done in the darkroom.</p>"
msgstr ""
"<b>Branco e negro con ton de selenio</b>:<p>Este efeito replica o ton "
"tradicional de proceso químico ao selenio.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:431
msgid "Platinum Tone"
msgstr "Ton de platino"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:432
msgid ""
"<b>Black & White with Platinum Tone</b>:<p>This effect replicate traditional "
"platinum chemical toning done in the darkroom.</p>"
msgstr ""
"<b>Branco e negro con ton de platino</b>:<p>Este efeito replica o ton "
"tradicional de proceso químico ao platino.</p>"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:437
msgid "Green Tone"
msgstr "Ton verde"

#: imageplugins/coreplugin/imageeffect_bwsepia.cpp:438
msgid ""
"<b>Black & White with greenish tint</b>:<p>This effect is also known as "
"Verdante.</p>"
msgstr ""
"<b>Branco e negro con ton verde</b>:<p>Este filtro tamén é coñecido como "
"Verdante.</p>"

