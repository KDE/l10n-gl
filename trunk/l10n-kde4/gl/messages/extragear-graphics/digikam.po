#: imageplugins/transform/sheartool.cpp:140
#: imageplugins/transform/perspectivetool.cpp:138
msgid "New height:"
msgstr "Nova altura:"

#: imageplugins/transform/freerotationtool.cpp:142
msgid ""
"Select a point in the preview widget, then click this button to assign the "
"point for auto-correction."
msgstr ""
"Escolla un punto no widget da vista previa e despois prema este botón para "
"lleasignar o punto á corrección automática."

#: imageplugins/transform/freerotationtool.cpp:189
msgctxt "Automatic Adjustment"
msgid "Adjust"
msgstr "Axustar"

#: imageplugins/transform/freerotationtool.cpp:198
msgid ""
"<p>Correct the rotation of your images automatically by assigning two points "
"in the preview widget and clicking <i>Adjust</i>.<br/>You can either adjust "
"horizontal or vertical lines.</p>"
msgstr ""
"<p>Corrixe automaticamente a rotación das imaxes asignando dous puntos no "
"widget de previsualización e premendo <i>Axustar</i>.<br/>Pode axustar tanto "
"liñas horizontais como verticais.</p>"

#: imageplugins/transform/freerotationtool.cpp:218
msgid "Automatic Adjustment"
msgstr "Axuste automático"

#: imageplugins/transform/freerotationtool.cpp:220
#: utilities/cameragui/cameraui.cpp:329
msgid "Settings"
msgstr "Configuración"

#: imageplugins/transform/freerotationtool.cpp:354
msgid "Click to set"
msgstr "Premer para configurar"

#: imageplugins/transform/freerotationtool.cpp:355
msgctxt "point has been set and is valid"
msgid "Okay"
msgstr "Feito"

#: imageplugins/transform/sheartool.cpp:112
#: imageplugins/transform/sheartool.cpp:340
msgid "Shear Tool"
msgstr "Utilidade de inclinación"

#: imageplugins/transform/sheartool.cpp:116
msgid ""
"This is the shear operation preview. If you move the mouse cursor on this "
"preview, a vertical and horizontal dashed line will be drawn to guide you in "
"adjusting the shear correction. Release the left mouse button to freeze the "
"dashed line's position."
msgstr ""
"Esta é a vista previa da operación de inclinación da imaxe. Se move o cursor "
"do rato nesta vista previa debuxarase unha liña descontinua vertical e "
"horizontal para guialo no axuste da operación de inclinación. Prema o botón "
"primario do rato para fixar a posición das liñas descontinuas."

#: imageplugins/transform/sheartool.cpp:144
msgid "Main horizontal angle:"
msgstr "Ángulo horizontal principal:"

#: imageplugins/transform/sheartool.cpp:149
msgid "The main horizontal shearing angle, in degrees."
msgstr "O ángulo de inclinación horizontal principal, en graos."

#: imageplugins/transform/sheartool.cpp:151
msgid "Fine horizontal angle:"
msgstr "Ángulo horizontal fino:"

#: imageplugins/transform/sheartool.cpp:155
msgid ""
"This value in degrees will be added to main horizontal angle value to set "
"fine adjustments."
msgstr ""
"Este valor en graos engádese ao ángulo horizontal principal para permitir "
"axustes finos."

#: imageplugins/transform/sheartool.cpp:157
msgid "Main vertical angle:"
msgstr "Ángulo vertical principal:"

#: imageplugins/transform/sheartool.cpp:162
msgid "The main vertical shearing angle, in degrees."
msgstr "O ángulo de inclinación vertical principal, en graos."

#: imageplugins/transform/sheartool.cpp:164
msgid "Fine vertical angle:"
msgstr "Ángulo vertical fino:"

#: imageplugins/transform/sheartool.cpp:168
msgid ""
"This value in degrees will be added to main vertical angle value to set fine "
"adjustments."
msgstr ""
"Este valor en graos engádese ao ángulo vertical principal para permitir "
"axustes finos."

#: imageplugins/transform/sheartool.cpp:171
#: libs/dimg/filters/transform/freerotationsettings.cpp:106
msgid "Anti-Aliasing"
msgstr "Antialiasing"

#: imageplugins/transform/sheartool.cpp:172
msgid ""
"Enable this option to apply the anti-aliasing filter to the sheared image. "
"To smooth the target image, it will be blurred a little."
msgstr ""
"Escolla esta opción para procesar un filtro de antialiasing (suavizado) na "
"imaxe inclinada. Cando a suavice, a imaxe quedará lixeiramente difuminada."

#: imageplugins/transform/perspectivetool.cpp:109
msgid "Perspective"
msgstr "Perspectiva"

#: imageplugins/transform/perspectivetool.cpp:119
msgid ""
"This is the perspective transformation operation preview. You can use the "
"mouse for dragging the corner to adjust the perspective transformation area."
msgstr ""
"Esta é a vista previa da operación de transformación de perspectiva. Pode "
"usar o rato para arrastrar a esquina para axustar a área de transformación "
"da perspectiva."

#: imageplugins/transform/perspectivetool.cpp:145
msgid "Angles (in degrees):"
msgstr "Ángulos (en graos):"

#: imageplugins/transform/perspectivetool.cpp:146
msgid "  Top left:"
msgstr "  Superior esquerdo:"

#: imageplugins/transform/perspectivetool.cpp:148
msgid "  Top right:"
msgstr "  Superior dereito:"

#: imageplugins/transform/perspectivetool.cpp:150
msgid "  Bottom left:"
msgstr "  Inferior esquerdo:"

#: imageplugins/transform/perspectivetool.cpp:152
msgid "  Bottom right:"
msgstr "  Inferior dereito:"

#: imageplugins/transform/perspectivetool.cpp:158
msgid "Draw preview while moving"
msgstr "Mostrar a vista previa mentres se move"

#: imageplugins/transform/perspectivetool.cpp:159
msgid "Draw grid"
msgstr "Mostrar a grella"

#: imageplugins/transform/perspectivetool.cpp:160
msgid "Inverse transformation"
msgstr "Transformación inversa"

#: imageplugins/transform/imageplugin_transform.cpp:81
msgid "Perspective Adjustment..."
msgstr "Axuste da perspectiva..."

#: imageplugins/transform/imageplugin_transform.cpp:86
