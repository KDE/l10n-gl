"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... que pode usar &lt;AvPáx&gt; e &lt;RePáx&gt; no seu teclado para mudar de "
"foto no editor de imaxes?\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"

#. i18n: file: tips:270
#. i18n: ectx: @info:tipoftheday
#: tips.cpp:255
msgid ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
