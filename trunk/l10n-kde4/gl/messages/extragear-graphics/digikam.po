#: imageplugins/coreplugin/ratiocrop/imageeffect_ratiocrop.cpp:101
msgid "Aspect ratio:"
msgstr "Proporcións de forma:"

#: imageplugins/coreplugin/ratiocrop/imageeffect_ratiocrop.cpp:103
