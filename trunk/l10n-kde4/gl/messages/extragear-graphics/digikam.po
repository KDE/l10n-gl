#: imageplugins/lenscorrection/autocorrection/klensfun.cpp:143
msgid ""
"Set this option to try to guess the right camera/lens settings from the "
"image metadata (as Exif or XMP)."
msgstr ""
"Escolla esta opción para tentar adiviñar a configuración correcta de cámara/"
"lente a partir dos metadatos da imaxe (como Exif ou XMP)."

#: imageplugins/lenscorrection/autocorrection/klensfun.cpp:149
msgid "Focal Length:"
msgstr "Distancia focal:"

#: imageplugins/lenscorrection/autocorrection/klensfun.cpp:150
