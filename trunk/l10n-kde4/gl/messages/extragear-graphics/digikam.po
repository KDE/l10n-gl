msgstr "<p>Indique unha cor personalizada para colorir os ollos."

#: imageplugins/coreplugin/imageeffect_redeye.cpp:177
msgid "Tint Level:"
msgstr "Nível de tinta:"

#: imageplugins/coreplugin/imageeffect_redeye.cpp:182
msgid ""
