msgstr "Kodak Tmax 100"

#: imageplugins/coreplugin/bwsepiatool.cpp:280
msgid ""
"<b>Kodak Tmax 100</b>:<p>Simulate the Kodak Tmax black and white film at 100 "
"ISO</p>"
msgstr ""
