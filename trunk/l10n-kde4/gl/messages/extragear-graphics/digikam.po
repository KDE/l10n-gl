"botón secundario do rato?\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"

#. i18n: file: tips:70
#. i18n: ectx: @info:tipoftheday
#: tips.cpp:67
msgid ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
