#: fbtalker.cpp:188
msgid "Validate previous session..."
msgstr "Validar a anterior sesión..."

#: fbtalker.cpp:215
msgid "Upgrading to OAuth..."
msgstr "A actualizar a OAuth..."

#: fbtalker.cpp:264 fbtalker.cpp:459
msgid "Facebook Application Authorization"
msgstr "Autorización do programa de Facebook"

#: fbtalker.cpp:269
msgid ""
"Please follow the instructions in the browser window. When done, copy the "
"Internet address from your browser into the textbox below and press \"OK\"."
msgstr ""
"Siga as instrucións na fiestra do navegador. Cando remate, copie o enderezo "
"de Internet do navegador na caixa de texto de aquí embaixo e prema «Aceptar»."

#: fbtalker.cpp:327
msgid "Canceled by user."
msgstr "Cancelouno o usuario."

#: fbtalker.cpp:457
msgid ""
"Please follow the instructions in the browser window. Press \"OK\" when done."
msgstr ""
"Siga as instrucións na fiestra do navegador. Prema «Aceptar» cando remate."

#: fbtalker.cpp:746
msgid "The service is not available at this time."
msgstr "O servizo non está dispoñíbel neste momento."

#: fbtalker.cpp:749
msgid "The application has reached the maximum number of requests allowed."
msgstr "O programa acadou a cantidade máxima de solicitudes que se permiten."

#: fbtalker.cpp:752
msgid "Invalid session key or session expired. Try to log in again."
msgstr ""
"Ou a chave da sesión non é válida ou expirou a sesión. Probe a acceder de "
"novo."

#: fbtalker.cpp:755
msgid "Invalid album ID."
msgstr "O identificador do álbum non é válido."

#: fbtalker.cpp:758
msgid "Album is full."
msgstr "O álbum está completo."

#: fbtalker.cpp:761
msgid "Missing or invalid file."
msgstr "Falta un ficheiro ou non é válido."

#: fbtalker.cpp:764
msgid "Too many unapproved photos pending."
msgstr "Hai pendentes demasiadas fotos non aprobadas."

#: fbwidget.cpp:71
msgid "This is the list of images to upload to your Facebook account."
msgstr "Esta é a listaxe das imaxes que enviar á conta do Facebook."

#: fbwidget.cpp:77
msgid ""
"This is a clickable link to open the Facebook home page in a web browser."
msgstr ""
"Esta é unha ligazón para abrir a páxina de inicio de Facebook no navegador."

#: fbwidget.cpp:83
msgid "Account"
msgstr "Conta"

#: fbwidget.cpp:84
msgid "This is the Facebook account that is currently logged in."
msgstr "Esta é a conta no Facebook coa que está identificado."

#: fbwidget.cpp:87
msgctxt "facebook account settings"
msgid "Name:"
msgstr "Nome:"

#: fbwidget.cpp:89
msgid "Permission:"
msgstr "Permiso:"

#: fbwidget.cpp:90
msgid ""
"Permission of KIPI Plugin application to upload photos directly. If not, "
"user will need to manually approve uploaded photos in Facebook."
msgstr ""
"O permiso do engadido de KIPI para enviar fotos directamente. Se non o ten, "
"o usuario deberá aprobar manualmente no Facebook as fotos enviadas."

#: fbwidget.cpp:93
msgid "Change Account"
msgstr "Modificar a conta"

#: fbwidget.cpp:94
msgid "Logout and change Facebook Account used for transfer"
msgstr "Saír e trocar a conta no Facebook empregada para as transferencias"

#: fbwidget.cpp:110
msgid "Download Selection"
msgstr "Transferir a selección"

#: fbwidget.cpp:111
msgid "This is the selection of Facebook albums/photos to download."
msgstr "Esta é a selección de álbums ou fotos do Facebook que obter."

#: fbwidget.cpp:115 fbwidget.cpp:161
msgid "Destination"
msgstr "Destino"

#: fbwidget.cpp:116
msgid "This is the Facebook album to which selected photos will be uploaded."
msgstr "Este é o álbum do Facebook ao que se enviarán as fotos."

#: fbwidget.cpp:120
msgid "My &Album"
msgstr "O &meu álbum"

#: fbwidget.cpp:121
msgid "Download complete album of currently logged in user."
msgstr "Obter todo o álbum do usuario co que accedeu."

#: fbwidget.cpp:122
msgid "Album &of My Friend"
msgstr "O álbum do meu &amigo"

#: fbwidget.cpp:123
msgid "Download complete album of selected friend."
msgstr "Obter todo o álbum do amigo escollido."

#: fbwidget.cpp:124
msgid "Photos of &Me"
msgstr "Fotos mi&ñas"

#: fbwidget.cpp:125
msgid "Download all photos of currently logged in user."
msgstr "Obtén todas as fotos do usuario co que accedeu."

#: fbwidget.cpp:126
msgid "Photos of My &Friend"
msgstr "Fotos do meu am&igo"

#: fbwidget.cpp:127
msgid "Download all photos of selected friend."
msgstr "Obtén todas as fotos do amigo escollido."

#: fbwidget.cpp:135
msgid "Friend:"
msgstr "Amigo:"

#: fbwidget.cpp:139
msgid "Album:"
msgstr "Álbum:"

#: fbwidget.cpp:143
msgid "New Album"
msgstr "Novo álbum"

#: fbwidget.cpp:144
msgid "Create new Facebook album"
msgstr "Crear un álbum novo no Facebook"

#: fbwidget.cpp:145
msgctxt "facebook album list"
msgid "Reload"
msgstr "Cargar de novo"

#: fbwidget.cpp:146
msgid "Reload album list"
msgstr "Cargar de novo a lista de álbums"

#: fbwidget.cpp:162
msgid "This is the location to which Facebook images will be downloaded."
msgstr "Este é o lugar no que se gardarán as fotos do Facebook."

#: fbwidget.cpp:169
msgid "Options"
msgstr "Opcións"

#: fbwidget.cpp:170
msgid "These are options that will be applied to photos before upload."
msgstr "Estas son as opcións que se aplicarán ás fotos antes de envialas."

#: fbwidget.cpp:174
msgid "Resize photos before uploading"
msgstr "Mudar o tamaño das fotos antes de envialas"

#: fbwidget.cpp:184
msgid "Maximum dimension:"
msgstr "Tamaño máximo:"

#: fbwidget.cpp:192
msgid "JPEG quality:"
msgstr "Calidade de JPEG:"

#: fbwidget.cpp:307
msgid "Direct upload"
msgstr "Envío directo"

#: fbwidget.cpp:309
msgid "Uploaded photos will not need manual approval by user."
msgstr "As fotos enviadas non precisarán dunha aprobación manual do usuario."

#: fbwidget.cpp:313
msgid "Manual upload approval"
msgstr "Aprobación manual do envío"

#: fbwidget.cpp:315
msgid ""
"Uploaded photos will wait in pending state until manually approved by user."
msgstr ""
"As fotos enviadas agardarán no estado pendente até que sexan aprobadas "
"manualmente polo usuario."

