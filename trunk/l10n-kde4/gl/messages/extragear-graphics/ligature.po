#: ligaturepart.cpp:808
msgid ""
"<qt><strong>File Error</strong> Could not open the file <nobr><strong>%1</"
"strong></nobr> for uncompression. The file will not be loaded.</qt>"
msgstr ""
"<qt><strong>Erro co ficheiro</strong> Non foi posíbel abrir o ficheiro "
"<nobr><strong>%1</strong></nobr> para descomprimilo. O ficheiro non será "
"cargado.</qt>"

#: ligaturepart.cpp:811
msgid ""
"<qt>This error typically occurs if you do not have enough permissions to "
"read the file. You can check ownership and permissions if you right-click on "
"the file in the Konqueror file manager and then choose the 'Properties' menu."
"</qt>"
msgstr ""
"<qt>Este erro acontece tipicamente se non ten permisos de abondo para ler o "
"ficheiro. Pode comprobar os donos e os permisos do ficheiro se preme co "
"botón secundario do rato no ficheiro no xestor de ficheiros Konqueror e logo "
"escolle o menú \"Propriedades\".</qt>"

#: ligaturepart.cpp:821
msgid "Uncompressing..."
msgstr "Descomprimindo..."

#: ligaturepart.cpp:822
msgid ""
"<qt>Uncompressing the file <nobr><strong>%1</strong></nobr>. Please wait.</"
"qt>"
msgstr ""
"<qt>Descomprimindo o ficheiro <nobr><strong>%1</strong></nobr>. Agarde por "
"favor.</qt>"

#: ligaturepart.cpp:852
msgid ""
"<qt><strong>File Error</strong> Could not uncompress the file <nobr><strong>%"
"1</strong></nobr>. The file will not be loaded.</qt>"
msgstr ""
"<qt><strong>Erro co ficheiro</strong> Non foi posíbel descomprimir o "
"ficheiro <nobr><strong>%1</strong></nobr>. O ficheiro non será cargado.</qt>"

#: ligaturepart.cpp:854
msgid ""
"<qt>This error typically occurs if the file is corrupt. If you want to be "
"sure, try to decompress the file manually using command-line tools.</qt>"
msgstr ""
"<qt>Este erro acontece tipicamente se o ficheiro está corrompido. Se quer "
"garantilo, probe a descomprimir manualmente o ficheiro usando ferramentas da "
"shell.</qt>"

#: ligaturepart.cpp:911
msgid ""
"<qt>The document <b>%1</b> cannot be shown because its file type is not "
"supported.</qt>"
msgstr ""
"<qt>Non foi posíbel mostrar o documento <b>%1</b> porque o seu tipo de "
"ficheiro non está soportado.</qt>"

#: ligaturepart.cpp:913
msgid ""
"<qt>The file has mime type <b>%1</b> which is not supported by any of the "
