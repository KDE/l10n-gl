#: smugalbum.cpp:98
msgid "These are security and privacy settings for new SmugMug album."
msgstr ""
"Estas son opcións de seguridade e intimidade para o novo álbum de SmugMug."

#: smugalbum.cpp:102
msgid "Public"
msgstr "Público"

#: smugalbum.cpp:105
msgid "Public album is listed on your public SmugMug page."
msgstr "O álbum público listarase na súa páxina de SmugMug."

#: smugalbum.cpp:106
msgid "Unlisted"
msgstr "Non listado"

#: smugalbum.cpp:108
msgid "Unlisted album is only accessible via URL."
msgstr "Os albuns non listados só serán acesíbeis mediante URL."

#: smugalbum.cpp:114
msgid "Require password to access the album (optional)."
msgstr "Require un contrasinal para aceder ao álbum (opcional)."

#: smugalbum.cpp:118
msgid "Password hint to present to users on the password prompt (optional)."
msgstr ""
"Axuda do contrasinal que se presentará os usuarios ao pedir o contrasinal "
"(opcional)."

#: smugalbum.cpp:120
msgid "Privacy:"
msgstr "Intimidade:"

#: smugalbum.cpp:121
