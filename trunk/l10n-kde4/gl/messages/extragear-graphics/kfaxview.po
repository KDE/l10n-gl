#: faxmultipage.cpp:102
#, kde-format
msgid "Print %1"
msgstr "Imprimir %1"

#: faxprintsettings.cpp:34
msgid ""
"<qt><p><strong>'Ignore Paper Margins'</strong></p><p>If this checkbox is "
"enabled, the paper margins will be ignored and the fax will be printed on "
"the full paper size.</p><p>If this checkbox is disabled, Ligature will "
"respect the standard paper margins and print the fax inside this printable "
"area.</p></qt>"
msgstr ""
"<qt><p><strong>\"Ignorar as marxes do papel\"</strong></p><p>Se sinala esta "
"opción, as marxes do papel serán ignoradas e o fax será impreso en toda a "
"área do papel.</p><p>Se non sinala esta opción, Ligature respeitará as "
"marxes estándar e imprimirá o fax dentro desta área de impresión.</p></qt>"

#: faxprintsettings.cpp:48
msgid ""
"<qt><p><strong>'Horizontally centered'</strong></p><p>If this checkbox is "
"enabled, the fax will be centered horizontally on the page.</p><p>If this "
"checkbox is disabled, the fax will be printed at the left side of the page.</"
"p></qt>"
msgstr ""
"<qt><p>\"Centrado horizontalmente\"<strong></strong></p><p>Se sinala esta "
"opción, o fax será centrado horizontalmente na páxina.</p><p>Se non a "
"sinala, o fax será impreso no bordo esquerdo da páxina.</p></qt>"

#: faxprintsettings.cpp:62
msgid ""
"<qt><p><strong>'Vertically centered'</strong></p><p>If this checkbox is "
"enabled, the fax will be centered vertically on the page.</p><p>If this "
"checkbox is disabled, the fax will be printed at the top of the page.</p></"
"qt>"
msgstr ""
"<qt><p><strong>\"Centrado verticalmente\"</strong></p><p>Se sinala esta "
"opción, o fax será centrado verticalmente na páxina.</p><p>Se non a sinala, "
"o fax será impreso desde o bordo superior da páxina.</p></qt>"

#: faxprintsettings.cpp:75
msgid "&Layout"
msgstr "&Disposición"

#: faxprintsettings.cpp:77
msgid "Ignore paper margins"
msgstr "Ignorar as marxes do papel"

#: faxprintsettings.cpp:79
msgid "Horizontally centered"
msgstr "Centrado horizontalmente"

#: faxprintsettings.cpp:81
msgid "Vertically centered"
msgstr "Centrado verticalmente"

