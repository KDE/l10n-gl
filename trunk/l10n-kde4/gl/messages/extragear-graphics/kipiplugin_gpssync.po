#: plugin_gpssync.cpp:139
#, kde-format
msgid ""
"<p>Unable to find the gpsbabel executable:<br/> This program is required by "
"this plugin to support GPS data file decoding. Please install gpsbabel as a "
"package from your distributor or <a href=\"%1\">download the source</a>.</"
"p><p>Note: at least, gpsbabel version %2 is required by this plugin.</p>"
msgstr ""
"<p>Non foi posíbel atopar o executábel gpsbabel:<br/> Este programa é "
"preciso para que este engadido poida descodificar ficheiros de datos de GPS. "
"Instale gpsbabel como paquete do seu distribuidor ou <a href=\"%1\">Obteña "
"as fontes</a>.</p><p>Nota: requírese a versión %2 do gpsbabel ou unha "
"posterior.</p>"

#: plugin_gpssync.cpp:156
#, kde-format
msgid ""
"<p>gpsbabel executable is not up to date:<br/> The version %1 of gpsbabel "
"have been found on your computer. This version is too old to run properly "
"with this plugin. Please update gpsbabel as a package from your distributor "
"or <a href=\"%2\">download the source</a>.</p><p>Note: at least, gpsbabel "
"version %3 is required by this plugin</p>"
msgstr ""
"<p>O executábel gpsbabel non está ao día:<br/> Achouse a versión %1 de "
"gpsbabel instalada no ordenador. Esta versión é vella de máis para executar "
"correctamente este engadido. Por favor, actualice gpsbabel cun paquete do "
"seu distribuidor ou <a href=\"%2\">obteña as fontes</a>.</p> <p>Nota: "
"requírese gpsbabel versión %3 ou posterior.</p>"

