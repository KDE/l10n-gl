#: fbalbum.cpp:45
msgid "Facebook New Album"
msgstr "Novo álbum no Facebook"

#: fbalbum.cpp:59
msgid "Title of the album that will be created (required)."
msgstr "O título do álbum que se vai crear (requerido)."

#: fbalbum.cpp:63
msgid "Location of the album that will be created (optional)."
msgstr "A localización do álbum que se vai crear (requerido)."

#: fbalbum.cpp:67
msgid "Description of the album that will be created (optional)."
msgstr "A descrición do álbum que se vai crear (opcional)."

#: fbalbum.cpp:72
msgid "Privacy setting of the album that will be created (required)."
msgstr "A configuración da intimidade do álbum que se vai crear (requerido)."

#: fbalbum.cpp:74
msgid "Only Friends"
msgstr "Só para os amigos"

#: fbalbum.cpp:76
msgid "Friends of Friends"
msgstr "Para os amigos dos amigos"

#: fbalbum.cpp:78
msgid "My Networks and Friends"
msgstr "Para as miñas redes e amigos"

#: fbalbum.cpp:80
msgid "Everyone"
msgstr "Para todo o mundo"

#: fbalbum.cpp:82
msgid "Title:"
msgstr "Título:"

#: fbalbum.cpp:83
msgid "Location:"
msgstr "Localización:"

#: fbalbum.cpp:84
msgid "Description:"
msgstr "Descrición:"

#: fbalbum.cpp:85
msgid "Privacy:"
msgstr "Intimidade:"

#: fbtalker.cpp:156
msgid "Validate previous session..."
msgstr "Validar a anterior sesión..."

#: fbtalker.cpp:180
msgid "Logging to Facebook service..."
msgstr "A aceder ao servizo Facebook..."

#: fbtalker.cpp:365
msgid "Please follow the instructions in the browser window. Press \"OK\" when done."
msgstr "Siga as instrucións na fiestra do navegador. Prema en «Aceitar» cando remate."

#: fbtalker.cpp:367
msgid "Facebook Application Authorization"
msgstr "Autorización do programa de Facebook"

#: fbtalker.cpp:633
msgid "The service is not available at this time."
msgstr "O servizo non está dispoñíbel neste momento."

#: fbtalker.cpp:636
msgid "The application has reached maximum number of requests allowed."
msgstr "O programa acadou a cantidade máxima de pedidos que se permiten."

#: fbtalker.cpp:639
msgid "Invalid session key or session expired. Try to log in again."
msgstr ""
"Ou a chave da sesión non é válida ou expirou a sesión. Probe a aceder de "
"novo."

#: fbtalker.cpp:642
msgid "Invalid album ID."
msgstr "ID de álbum non válida."

#: fbtalker.cpp:645
msgid "Album is full."
msgstr "O álbum está completo."

#: fbtalker.cpp:648
msgid "Missing or invalid file."
msgstr "Falla un ficheiro ou non é válido."

#: fbtalker.cpp:651
msgid "Too many unapproved photos pending."
msgstr "Hai pendentes demasiadas fotos non aprobadas."

#: fbtalker.cpp:806
msgid ""
"Please follow the instructions in the browser window. Press \"Yes\" if you "
"have authenticated and \"No\" if you failed."
msgstr ""
"Siga as instrucións na fiestra do navegador. Prema en «Si» se se autenticou e "
"«Non» se fallou."

#: fbtalker.cpp:808
msgid "Facebook Service Web Authorization"
msgstr "Autorización do servizo web Facebook"

#: fbtalker.cpp:817
msgid "Canceled by user."
msgstr "Cancelouno o usuario."

#: fbwidget.cpp:65
msgid "This is the list of images to upload on your Facebook account."
msgstr "Esta é a listaxe das imaxes a enviar á conta no Facebook."

#: fbwidget.cpp:72
msgid "This is a clickable link to open Facebook home page in web browser."
msgstr "Esta é unha ligazón para abrir a páxina de inicio de Facebook no navegador."

#: fbwidget.cpp:78
msgid "Account"
msgstr "Conta"

#: fbwidget.cpp:80
msgid "This is the Facebook account that will be used for upload."
msgstr "Esta é a conta no Facebook que se ha empregar para os envíos."

#: fbwidget.cpp:83
msgid "Name:"
msgstr "Nome: "

#: fbwidget.cpp:85
msgid "Permission:"
msgstr "Permiso:"

#: fbwidget.cpp:87
msgid ""
"Permission of KIPI Plugin application to upload photos directly. If not, "
"user will need to manually approve uploaded photos in Facebook."
msgstr ""
"O permiso da extensión de KIPI para enviar fotos directamente. Se non o ten, "
"o usuario deberá aprobar manualmente no Facebook as fotos enviadas."

#: fbwidget.cpp:90
msgid "Change Account"
msgstr "Modificar a conta"

#: fbwidget.cpp:91
msgid "Logout and change Facebook Account used for upload"
msgstr "Sair e trocar a conta no Facebook empregada para os envíos"

#: fbwidget.cpp:94
msgid "Change Permission"
msgstr "Modificar o permiso"

#: fbwidget.cpp:95
msgid "Change permission for KIPI application for photo upload"
msgstr "Trocar os permisos do programa KIPI para o envío das fotos"

#: fbwidget.cpp:109
msgid "Album"
msgstr "Álbum"

#: fbwidget.cpp:111
msgid "This is the Facebook album where selected photos will be uploaded."
msgstr "Este é o álbum no Facebook onde se enviarán as fotos."

#: fbwidget.cpp:117
msgid "New Album"
msgstr "Novo álbum"

#: fbwidget.cpp:118
msgid "Create new Facebook album"
msgstr "Crear un novo álbum no Facebook"

#: fbwidget.cpp:120
msgid "Reload"
msgstr "Cargar de novo"

#: fbwidget.cpp:121
msgid "Reload album list"
msgstr "Cargar de novo a lista de albuns"

#: fbwidget.cpp:129
#| msgid "Description:"
msgid "Destination"
msgstr "Destino"

#: fbwidget.cpp:131
#| msgid "This is the Facebook album where selected photos will be uploaded."
msgid "This is the location where Facebook images will be downloaded to."
msgstr "Este é o lugar onde se gardarán as fotos do Facebook."

#: fbwidget.cpp:138
msgid "Options"
msgstr "Opcións"

#: fbwidget.cpp:140
msgid "These are options that will be applied to photos before upload."
msgstr "Estas son as opcións que se aplicarán ás fotos antes de envialas."

#: fbwidget.cpp:144
msgid "Resize photos before uploading"
msgstr "Mudar o tamaño das fotos antes de envialas"

#: fbwidget.cpp:154
msgid "Maximum dimension:"
msgstr "Tamaño máximo:"

#: fbwidget.cpp:162
msgid "JPEG quality:"
msgstr "Calidade de JPEG:"

#: fbwidget.cpp:243
msgid "Direct upload"
msgstr "Envío directo"

#: fbwidget.cpp:245
msgid "Uploaded photos will not need manual approval by user."
msgstr "As fotos enviadas non precisarán dunha aprobación manual do usuario."

#: fbwidget.cpp:249
msgid "Manual upload approval"
msgstr "Aprobación manual do envío"

#: fbwidget.cpp:251
msgid "Uploaded photos will wait in pending state until manually approved by user."
msgstr ""
"As fotos enviadas agardarán no estado pendente até que sexan aprobadas "
"manualmente polo usuario."

#: fbwindow.cpp:91
#| msgid "Export to Facebook Web Service"
msgid "Import from Facebook Web Service"
msgstr "Importar do servizo web Facebook"

#: fbwindow.cpp:93
#| msgid "Start Upload"
msgid "Start Download"
msgstr "Iniciar a obtención"

#: fbwindow.cpp:94
#| msgid "Start upload to Facebook web service"
msgid "Start download from Facebook web service"
msgstr "Comezar a obtención do servizo web Facebook"

#: fbwindow.cpp:99
msgid "Export to Facebook Web Service"
msgstr "Exportar ao servizo web Facebook"

#: fbwindow.cpp:101
msgid "Start Upload"
msgstr "Iniciar o envío"

#: fbwindow.cpp:102
msgid "Start upload to Facebook web service"
msgstr "Comezar o envío ao servizo web Facebook"

#: fbwindow.cpp:129
#| msgid "Fb Export"
msgid "Fb Import/Export"
msgstr "Importar/Exportar ao Facebook"

#: fbwindow.cpp:131
#| msgid "A Kipi plugin to export image collection to Facebook web service."
msgid "A Kipi plugin to import/export image collection to/from Facebook web service."
msgstr "Unha extensión de Kipi para importar ou exportar colecións de imaxes ao Facebook."

