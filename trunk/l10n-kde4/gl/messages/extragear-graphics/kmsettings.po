#. i18n: file: kmsettings.ui:422
#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_ACTION_OPEN_MISMATCH_RGB)
#: rc.cpp:116
msgid ""
"<ul>\n"
"<li><b>Preserve Numbers:</b> Allow the source RGB profile to be kept and "
"unchanged from the destination.</li>\n"
"<li><b>Automatically Convert:</b> Convert the source RGB profile to its "
"destination.</li>\n"
"<li><b>Prompt User:</b> Allow the user to choose which method to use.</li>\n"
"</ul>"
msgstr ""
"<ul>\n"
"<li><b>Conservar os números:</b> Permitir manter o perfil da fonte de RGB e "
"sen modificar do destino.</li>\n"
"<li><b>Automatically Convert:</b> Converter o perfil da fonte de RGB ao seu "
"destino.</li>\n"
"<li><b>Prompt User:</b> Permitir que o usuario escolla o método que desexe "
"empregar.</li>\n"
"</ul>"

