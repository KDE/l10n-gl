msgstr "Importe"

#. i18n: ectx: property (toolTip), widget (KComboBox, comboBoxInv_symbolCol)
#: kmymoney/plugins/csvimport/investmentwizardpage.ui:394
msgid ""
"<p align=\"center\" >If more than one stock is present in the file, and if "
"the stock symbols<br/> are shown in one of the columns, select it here. </p>"
