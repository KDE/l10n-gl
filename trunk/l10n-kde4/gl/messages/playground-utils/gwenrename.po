msgstr "Expresión"

#: timestamp.cpp:152 timestamp.cpp:180
#, kde-format
msgid "Output"
msgstr "Saída"

#: timestamp.cpp:154
#, kde-format
msgid "the day as number without a leading zero (1-31)"
msgstr "o día do mes sen ceros innecesarios (1-31)"

#: timestamp.cpp:156
#, kde-format
msgid "the day as number with a leading zero (01-31)"
msgstr "o día do mes en dúas cifras (01-31)"

#: timestamp.cpp:158
#, kde-format
