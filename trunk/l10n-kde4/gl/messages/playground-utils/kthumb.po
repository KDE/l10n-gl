#: kthumb.cpp:94
#, kde-format
msgid ""
"             # Query for a standard path.\n"
"             # - base: the base directory of the local cache\n"
"             # - normal: the normal directory for thumbnails\n"
"             # - large: the directory for large thumbnails\n"
"             # - fail: the directory for information about failed thumbnail "
"generations\n"
msgstr ""
"             # Busca dunha ruta estándar.\n"
"             # - base: o cartafol base da caché local\n"
"             # - normal: o cartafol normal das miniaturas\n"
"             # - large: o cartafol das miniaturas grandes\n"
"             # - fail: o cartafol da información sobre as xeracións fallidas"
" de miniaturas\n"

#: kthumb.cpp:107
#, kde-format
