msgid "View F&ilter"
msgstr "Ver o f&iltro"

#: dirfilterplugin.cpp:150
msgid "Allow to filter the currently displayed items by filetype."
msgstr "Permite filtrar os ítens que se están a mostrar, segundo o tipo de ficheiro."

#: dirfilterplugin.cpp:168
msgid "Clear Filter Field"
msgstr "Borrar o campo do filtro"

#: dirfilterplugin.cpp:170
msgid "Clear filter field<p>Clears the content of the filter field."
