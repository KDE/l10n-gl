msgid "Cube"
msgstr "Cubo"

#: hacks/config/sballs.xml.h:2
msgid "Dodecahedron"
msgstr "Dodecaedro"

#: hacks/config/sballs.xml.h:3
msgid ""
"Draws an animation of textured balls spinning like crazy in GL. Requires "
"OpenGL, and a machine with fast hardware support for texture maps. Written "
"by Eric Lassauge &lt;lassauge@mail.dotcom.fr&gt;."
msgstr ""
"Debuxa unha animación en GL de bólas con texturas a rodar como tolas. "
"Necesita de OpenGL e dunha máquina con soporte rápido de hardware para os "
"mapas de texturas. Feito por Eric Lasauxe &lt;lassauge@mail.dotcom.fr&gt;."

#: hacks/config/sballs.xml.h:5
msgid "Icosahedron"
msgstr "Icosahedro"

#: hacks/config/sballs.xml.h:7
msgid "Octahedron"
msgstr "Octahedro"

#: hacks/config/sballs.xml.h:8
