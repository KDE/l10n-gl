#. i18n: tag string
#. i18n: file styledialog.ui line 13
#: rc.cpp:4
#, no-c-format
msgid "Style Configuration Dialog"
msgstr "Diálogo de configuración do estilo"

#. i18n: tag string
#. i18n: file styledialog.ui line 19
#: rc.cpp:8
#, no-c-format
msgid ""
"This option will draw buttons and several other widgets using a gradient "
"texture"
msgstr ""
"Esta opción debuxará botóns e outros elementos utilizando unha textura en "
"gradiente"

#. i18n: tag string
#. i18n: file styledialog.ui line 22
#: rc.cpp:12
#, no-c-format
msgid "Use &gradients"
msgstr "Utilizar &gradientes"

#. i18n: tag string
#. i18n: file styledialog.ui line 32
#: rc.cpp:16
#, no-c-format
msgid ""
"This option will highlight buttons and several other widgets when the mouse "
"cursor is over them"
msgstr ""
"Esta opción realza botóns e outros elementos cando o cursor do rato pasa por "
"cima deles"

#. i18n: tag string
#. i18n: file styledialog.ui line 35
#: rc.cpp:20
#, no-c-format
msgid "Highlight on &mouse hover"
msgstr "Realzar ao &pasar o rato"
