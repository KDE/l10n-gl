#: kdessh.cpp:60
msgid "KDE ssh"
msgstr "KDE ssh"

#: kdessh.cpp:61
msgid "Runs a program on a remote host"
msgstr "Executa un programa nun servidor remoto"

#: kdessh.cpp:63
msgid "Copyright (c) 2000 Geert Jansen"
msgstr "Copyright (c) 2000 Geert Jansen"

#: kdessh.cpp:65
msgid "Geert Jansen"
msgstr "Geert Jansen"

#: kdessh.cpp:65
msgid "Maintainer"
msgstr "Mantenedor"

#: kdessh.cpp:71
msgid "Specifies the remote host"
msgstr "Indica o servidor remoto"

#: kdessh.cpp:72
msgid "The command to run"
msgstr "A orde para executar"

#: kdessh.cpp:73
msgid "Specifies the target uid"
msgstr "Indica o uid obxectivo"

#: kdessh.cpp:74
msgid "Specify remote stub location"
msgstr "Indica a localización remota de contacto"

#: kdessh.cpp:75
msgid "Do not keep password"
msgstr "Non manter o contrasinal"

#: kdessh.cpp:76
msgid "Stop the daemon (forgets all passwords)"
msgstr "Parar o daemon (esquece todos os contrasinais)"

#: kdessh.cpp:77
msgid "Enable terminal output (no password keeping)"
msgstr "Habilitar a saída da terminal (non lembra contrasinais)"

#: kdessh.cpp:109
msgid "No command or host specified."
msgstr "Non se especificou a orde nin o servidor."

#: kdessh.cpp:180
msgid ""
"Ssh returned with an error.\n"
"The error message is:\n"
"\n"
msgstr ""
"Ssh rematou cun erro.\n"
"A mensaxe de erro é:\n"
"\n"

#: kdessh.cpp:191
msgid "Command"
msgstr "Orde"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Marce Villarino"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "mvillarino@users.sourceforge.net"

#: sshdlg.cpp:56
msgid "The action you requested needs authentication. Please enter "
msgstr "A acción que pediu precisa autenticación. Introdúzaa"

#: sshdlg.cpp:76
msgid "Conversation with ssh failed.\n"
msgstr "A conversa con ssh fallou.\n"

#: sshdlg.cpp:85
msgid ""
"The programs 'ssh' or 'kdesu_stub' cannot be found.\n"
"Make sure your PATH is set correctly."
msgstr ""
"Non foi posíbel atopar os programas «ssh» nin «kdesu_stub».\n"
"Verifique que a súa variábel PATH estea correctamente configurada."

#: sshdlg.cpp:91
msgid "Incorrect password. Please try again."
msgstr "Contrasinal incorrecto. Ténteo de novo."

#: sshdlg.cpp:95
msgid "Internal error: Illegal return from SshProcess::checkInstall()"
msgstr "Erro interno: Valor de retorno ilegal desde SshProcess::checkInstall()"
