#: rc.cpp:64
msgid "Encrypt files with:"
msgstr "Cifrar os ficheiros con:"

#. i18n: tag string
#. i18n: file conf_encryption.ui line 154
#: rc.cpp:67
msgid ""
"<qt><b>Encrypt files with:</b><br />\n"
"<p>Checking this option and selecting a key will force any file encryption "
"operation to use the selected key. KGpg will not query for a recipient and "
"the default key will be bypassed.</p></qt>"
msgstr ""
"<qt><b>Cifrar os ficheiros con:</b><br /> \n"
"<p>Se sinala esta opción e escolle unha chave, calquer operación de cifraxe "
"dun ficheiro usará esta chave. KGpg non preguntará polo destinatario e a "
"chave por omisión será ignorada.</p></qt>"

#. i18n: tag string
#. i18n: file conf_encryption.ui line 161
#: rc.cpp:71 selectpublickeydialog.cpp:92
msgid "Allow encryption with untrusted keys"
msgstr "Permitir cifrar con chaves non autenticadas"

#. i18n: tag string
#. i18n: file conf_encryption.ui line 165
#: rc.cpp:74
msgid ""
"<qt><b>Allow encryption with untrusted keys:</b><br />\n"
"<p>When importing a public key, the key is usually marked as untrusted and "
"as such cannot be used unless it is signed by the default key (Thus, making "
"it 'trusted'). Checking this box enables any key to be used even if it is "
"untrusted.</p></qt>"
msgstr ""
"<qt><b>Permitir a cifraxe con chaves sen autenticar:</b> <br />\n"
"<p>Cando se importa unha chave pública, a chave normalmente márcase como non "
"autenticada e portanto non pode ser usada a non ser que estexa asinada pola "
"chave predeterminada. Sinale esta opción para usar calquer chave mesmo se "
"non está autenticada.</p></qt>"

#. i18n: tag string
#. i18n: file conf_gpg.ui line 15
#: rc.cpp:78
msgid ""
"<qt><b>Global Settings:</b><br />\n"
"<p></p>\n"
"</qt>"
msgstr ""
"<qt><b>Opcións globais:</b><br />\n"
"<p></p>\n"
"</qt>"

