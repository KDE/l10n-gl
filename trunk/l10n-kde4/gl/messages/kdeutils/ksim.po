msgstr "Formato de tempo en funcionamento:"

#: generalprefs.cpp:211
#, no-c-format
msgid ""
"The text in the edit box will be what is displayed as \n"
"the uptime except the % items will be replaced with \n"
"the legend"
msgstr ""
"O texto que está na caixa de edición será o que se mostre como o \n"
"tempo que leva a funcionan, coa excepción de que os itens % serán\n"
"substituídos coa lenda"

#: generalprefs.cpp:217
msgid "Uptime Legend"
msgstr "Lenda do tempo en funcionamento"

#: generalprefs.cpp:228
#, no-c-format
msgid "%d - Total days uptime"
msgstr "%d - Días totais que leva a funcionar"

#: generalprefs.cpp:233
#, no-c-format
msgid "%h - Total hours uptime"
msgstr "%h - Horas totais que leva en funcionamento"

#: generalprefs.cpp:238
#, no-c-format
msgid "%m - Total minutes uptime"
msgstr "%m - Minutos totais que leva en funcionamento"

#: generalprefs.cpp:243
#, no-c-format
msgid "%s - Total seconds uptime"
msgstr "%s - Segundos totais que leva en funcionamento"

#: generalprefs.cpp:284 generalprefs.cpp:440 generalprefs.cpp:577
msgid "Insert Item"
msgstr "Inserir un ítem"

#: generalprefs.cpp:286 generalprefs.cpp:442 generalprefs.cpp:578
msgid "Remove Item"
msgstr "Eliminar un ítem"

#: generalprefs.cpp:331
msgid "Show memory and free memory"
msgstr "Mostrar a memoria total e a memoria libre"

#: generalprefs.cpp:343
msgid "Mem format:"
msgstr "Formato da memoria:"

#: generalprefs.cpp:352
#, no-c-format
msgid ""
"The text in the edit box will be what is displayed as \n"
"the memory & free memory except the % items will be \n"
"replaced with the legend"
msgstr ""
"O texto que está no campo de edición será o mostrado como \n"
"memoria empregada e libre, excepto que os ítens % serán \n"
"substituídos pola lenda"

#: generalprefs.cpp:358
msgid "Memory Legend"
msgstr "Lenda da memoria"

#: generalprefs.cpp:369
#, no-c-format
msgid "%t - Total memory"
msgstr "%t - Memoria total"

#: generalprefs.cpp:374
#, no-c-format
msgid "%F - Total free memory including cached and buffered"
msgstr "%F - Memoria total incluindo a cache e o buffer"

#: generalprefs.cpp:379
#, no-c-format
msgid "%f - Total free memory"
msgstr "%f - Memoria libre total"

#: generalprefs.cpp:384
#, no-c-format
msgid "%u - Total used memory"
msgstr "%u - Memoria total empregada"

#: generalprefs.cpp:389
#, no-c-format
msgid "%c - Total cached memory"
msgstr "%c - Memoria cache total"

#: generalprefs.cpp:394
#, no-c-format
msgid "%b - Total buffered memory"
msgstr "%b - Memoria buffer total"

#: generalprefs.cpp:399
#, no-c-format
msgid "%s - Total shared memory"
msgstr "%s - Memoria partillada total"

#: generalprefs.cpp:472
msgid "Show swap and free swap"
msgstr "Mostrar o espazo de intercambio libre e o total"

#: generalprefs.cpp:500
msgid "Swap format:"
msgstr "Formato do espazo de intercambio:"

#: generalprefs.cpp:509
#, no-c-format
msgid ""
"The text in the edit box will be what is displayed as \n"
"the swap & free swap except the % items will be \n"
"replaced with the legend"
msgstr ""
"O texto que está no campo de edición será o mostrado como \n"
"o espazo de intercambio ocupado e o libre, excepto porque os \n"
"itens % serán substituidos pola lenda"

#: generalprefs.cpp:515
msgid "Swap Legend"
msgstr "Lenda do espazo de intercambio"

#: generalprefs.cpp:526
#, no-c-format
msgid "%t - Total swap"
msgstr "%t - Intercambio total"

#: generalprefs.cpp:531
#, no-c-format
msgid "%f - Total free swap"
msgstr "%f - Intercambio libre total"

#: generalprefs.cpp:536
#, no-c-format
msgid "%u - Total used swap"
msgstr "%u - Intercambio empregado total"
