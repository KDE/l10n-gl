#: kjotsentry.cpp:102
#, kde-format
msgid ""
"A duplicate ID was found in the book %1. This can happen if you manipulate "
"the data files by hand, and will prevent KJots from working correctly. KJots "
"can attempt to fix this, or you can fix it yourself. In either case, "
"bookmarks and links between pages may be broken."
msgstr ""
"Atopouse unha ID duplicada no libro %1. Isto pode acontecer se manipulou á "
"mao os ficheiros de dados, e fará que KJots non traballe correctamente. "
"KJots pode tentar corrixir isto, ou pode corrixilo vde. por si. En calquer "
"dos casos, os marcadores e as ligazóns entre páxinas poden estar estragados."

#: kjotsentry.cpp:106
msgid "A duplicate ID was found"
msgstr "Atopouse unha ID duplicada"

#: kjotsentry.cpp:106
msgid "Exit and fix by hand"
msgstr "Saír e corrixir manualmente"

#: kjotsentry.cpp:107
msgid "Fix it automatically"
msgstr "Corrixilo automaticamente"

#: kjotsentry.cpp:336
msgid ""
"<qt>KJots is having problems saving your data. This might be a permissions "
"problem, or you may be out of disk space.</qt>"
msgstr ""
"<qt>KJots ten problemas para gardar os seus dados. Isto pode ser un problema "
"de permisos, ou pode ter quedado sen espazo no disco.</qt>"

