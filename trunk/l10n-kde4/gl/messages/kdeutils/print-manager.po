#: add-printer/ChooseUri.ui:62
msgctxt "@info"
msgid ""
"<TABLE>\n"
"<TR>\n"
"<TD>Examples:\n"
"<PRE>\n"
"    http://hostname:631/ipp/\n"
"    http://hostname:631/ipp/port1\n"
"\n"
"    ipp://hostname/ipp/\n"
"    ipp://hostname/ipp/port1\n"
"\n"
"    lpd://hostname/queue\n"
"\n"
"    socket://hostname\n"
"    socket://hostname:9100\n"
"</PRE>\n"
"\n"
"<P>See <A HREF=\"http://localhost:631/help/network.html\" TARGET=\"_blank\">"
"\"Network\n"
"Printers\"</A> for the correct URI to use with your printer.</P>\n"
"</TD>\n"
"</TR>\n"
"</TABLE>"
msgstr ""
"<TABLE>\n"
"<TR>\n"
"<TD>Exemplos:\n"
"<PRE>\n"
"    http://enderezo:631/ipp/\n"
"    http://enderezo:631/ipp/porto1\n"
"\n"
"    ipp://enderezo/ipp/\n"
"    ipp://enderezo/ipp/porto1\n"
"\n"
"    lpd://enderezo/queue\n"
"\n"
"    socket://enderezo\n"
"    socket://enderezo:9100\n"
"</PRE>\n"
"\n"
"<P>Lea a <A HREF=\"http://localhost:631/help/network.html\" TARGET=\"_blank\">"
"documentación sobre as impresoras de rede</A> para informarse de cal é o URI "
"correcto para a súa impresora.</P>\n"
"</TD>\n"
"</TR>\n"
"</TABLE>"

