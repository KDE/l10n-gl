#. i18n: file: prefwidget.ui:14
#. i18n: ectx: property (windowTitle), widget (QDialog, PrefWidget)
#: rc.cpp:3
msgid "Timer Settings"
msgstr "Configurar o temporizador"

#. i18n: file: prefwidget.ui:26
#. i18n: ectx: property (toolTip), widget (QTreeWidget, m_list)
#: rc.cpp:6
msgid "List of countdowns you have set"
msgstr "A lista de contas atrás que definise"

#. i18n: file: prefwidget.ui:29
#. i18n: ectx: property (whatsThis), widget (QTreeWidget, m_list)
#: rc.cpp:9
msgid ""
"New countdowns are put here. You can add and remove them, and stop and start "
"them."
msgstr ""
"Aquí póñense as novas contas atrás. Pode engadilas e eliminalas, e tamén "
"detelas e inicialas."

#. i18n: file: prefwidget.ui:36
#. i18n: ectx: property (text), widget (QTreeWidget, m_list)
#: rc.cpp:12
msgid "Counter"
msgstr "Contador"

#. i18n: file: prefwidget.ui:41
#. i18n: ectx: property (text), widget (QTreeWidget, m_list)
#: rc.cpp:15
msgid "Delay"
msgstr "Atraso"

#. i18n: file: prefwidget.ui:46
#. i18n: ectx: property (text), widget (QTreeWidget, m_list)
#. i18n: file: prefwidget.ui:208
#. i18n: ectx: property (title), widget (QGroupBox, m_state)
#: rc.cpp:18 rc.cpp:84
msgid "State"
msgstr "Estado"

#. i18n: file: prefwidget.ui:51
#. i18n: ectx: property (text), widget (QTreeWidget, m_list)
#: rc.cpp:21
msgid "Command"
msgstr "Orde"

#. i18n: file: prefwidget.ui:59
#. i18n: ectx: property (toolTip), widget (KPushButton, m_add)
#: rc.cpp:24
msgid "Add a new task"
msgstr "Engadir unha tarefa"

#. i18n: file: prefwidget.ui:62
#. i18n: ectx: property (whatsThis), widget (KPushButton, m_add)
#: rc.cpp:27
msgid "Add a new task to the list."
msgstr "Engade unha tarefa nova á lista."

#. i18n: file: prefwidget.ui:65
#. i18n: ectx: property (text), widget (KPushButton, m_add)
#: rc.cpp:30
msgid "&New"
msgstr "&Novo"

#. i18n: file: prefwidget.ui:72
#. i18n: ectx: property (toolTip), widget (KPushButton, m_remove)
#: rc.cpp:33
msgid "Remove a task"
msgstr "Eliminar unha tarefa"

#. i18n: file: prefwidget.ui:75
#. i18n: ectx: property (whatsThis), widget (KPushButton, m_remove)
#: rc.cpp:36
msgid "Remove a task from the list."
msgstr "Elimina unha tarefa da lista."

#. i18n: file: prefwidget.ui:78
#. i18n: ectx: property (text), widget (KPushButton, m_remove)
#: rc.cpp:39
msgid "&Remove"
msgstr "&Eliminar"

#. i18n: file: prefwidget.ui:104
#. i18n: ectx: property (title), widget (QGroupBox, m_settings)
#: rc.cpp:42
msgid "Settings"
msgstr "Configuración"

#. i18n: file: prefwidget.ui:116
#. i18n: ectx: property (toolTip), widget (QCheckBox, m_loop)
#. i18n: file: prefwidget.ui:119
#. i18n: ectx: property (whatsThis), widget (QCheckBox, m_loop)
#: rc.cpp:45 rc.cpp:48
msgid ""
"Check this box if you want your countdown to start over after it finishes"
msgstr ""
"Sinale esta opción se quere que a conta atrás comece de novo canto remate"

#. i18n: file: prefwidget.ui:122
#. i18n: ectx: property (text), widget (QCheckBox, m_loop)
#: rc.cpp:51
msgid "&Loop"
msgstr "&Repetición"

#. i18n: file: prefwidget.ui:129
#. i18n: ectx: property (text), widget (QLabel, TextLabel2)
#: rc.cpp:54
msgid "Delay:"
msgstr "Atraso:"

#. i18n: file: prefwidget.ui:136
#. i18n: ectx: property (toolTip), widget (QSpinBox, m_delay)
#: rc.cpp:57
msgid "You can change the amount of time here."
msgstr "Aquí pode mudar a cantidade de tempo."

#. i18n: file: prefwidget.ui:139
#. i18n: ectx: property (whatsThis), widget (QSpinBox, m_delay)
#: rc.cpp:60
msgid "You can change the amount of time in the countdown here."
msgstr "Aquí pode mudar a cantidade de tempo da conta atrás."

#. i18n: file: prefwidget.ui:149
#. i18n: ectx: property (toolTip), widget (QCheckBox, m_one)
#: rc.cpp:63
msgid "Check this box if you only want to open one copy of your program"
msgstr "Sinale esta opción se só quer abrir unha copia do programa"

#. i18n: file: prefwidget.ui:152
#. i18n: ectx: property (whatsThis), widget (QCheckBox, m_one)
#: rc.cpp:66
msgid "Check this box if you only want one instance to open"
msgstr "Sinale esta opción se só quer que se abra unha instancia"

#. i18n: file: prefwidget.ui:155
#. i18n: ectx: property (text), widget (QCheckBox, m_one)
#: rc.cpp:69
msgid "Start only &one instance"
msgstr "Iniciar só &unha instancia"

#. i18n: file: prefwidget.ui:162
#. i18n: ectx: property (text), widget (QLabel, TextLabel3)
#: rc.cpp:72
msgid "seconds"
msgstr "segundos"

#. i18n: file: prefwidget.ui:185
#. i18n: ectx: property (toolTip), widget (KUrlRequester, m_commandLine)
#: rc.cpp:75
msgid "command you would like to run when time is up"
msgstr "a orde que desexe executar canto de esgote o tempo"

#. i18n: file: prefwidget.ui:188
#. i18n: ectx: property (whatsThis), widget (KUrlRequester, m_commandLine)
#: rc.cpp:78
msgid "Enter here a program you would like to run when the countdown is zero"
msgstr ""
"Indique aquí o programa que desexe executar cando a conta atrás chegue a cero"

#. i18n: file: prefwidget.ui:195
#. i18n: ectx: property (text), widget (QLabel, TextLabel1)
#: rc.cpp:81
msgid "Command line:"
msgstr "Liña de ordes:"

#. i18n: file: prefwidget.ui:220
#. i18n: ectx: property (toolTip), widget (QSlider, m_slider)
#: rc.cpp:87
msgid "Speed up or slow down your countdown"
msgstr "Acelera ou enlentece a conta atrás"

#. i18n: file: prefwidget.ui:223
#. i18n: ectx: property (whatsThis), widget (QSlider, m_slider)
#: rc.cpp:90
msgid "You can use this slider to adjust the time."
msgstr "Pode empregar esta barra deslizante para axustar o tempo."

#. i18n: file: prefwidget.ui:233
#. i18n: ectx: property (toolTip), widget (QLCDNumber, m_counter)
#: rc.cpp:93
msgid "This many seconds are left"
msgstr "Esta é a cantidade de segundos que quedan"

#. i18n: file: prefwidget.ui:236
#. i18n: ectx: property (whatsThis), widget (QLCDNumber, m_counter)
#: rc.cpp:96
msgid "This number is how many seconds are left for the selected countdown."
msgstr ""
"Esta é a cantidade de segundos a faltar para chegar ao final da conta atrás."

#. i18n: file: prefwidget.ui:243
#. i18n: ectx: property (toolTip), widget (QToolButton, m_pause)
#: rc.cpp:99
msgid "Pause a countdown"
msgstr "Pausar unha conta atrás"

#. i18n: file: prefwidget.ui:246
#. i18n: ectx: property (whatsThis), widget (QToolButton, m_pause)
#: rc.cpp:102
msgid "Use this to pause a timer countdown."
msgstr "Empregue isto para deter temporalmente unha conta atrás."

#. i18n: file: prefwidget.ui:249
#. i18n: ectx: property (text), widget (QToolButton, m_pause)
#: rc.cpp:105
msgid "||"
msgstr "||"

#. i18n: file: prefwidget.ui:256
#. i18n: ectx: property (toolTip), widget (QToolButton, m_start)
#: rc.cpp:108
msgid "Start a countdown"
msgstr "Iniciar unha conta atrás"

#. i18n: file: prefwidget.ui:259
#. i18n: ectx: property (whatsThis), widget (QToolButton, m_start)
#: rc.cpp:111
msgid "Use this to start or restart a countdown."
msgstr "Empregue isto para iniciar ou reiniciar unha conta atrás."

#. i18n: file: prefwidget.ui:262
#. i18n: ectx: property (text), widget (QToolButton, m_start)
#: rc.cpp:114
msgid ">"
msgstr ">"

#. i18n: file: prefwidget.ui:269
#. i18n: ectx: property (toolTip), widget (QToolButton, m_stop)
#: rc.cpp:117
msgid "Stop a countdown"
msgstr "Deter unha conta atrás"

#. i18n: file: prefwidget.ui:272
#. i18n: ectx: property (whatsThis), widget (QToolButton, m_stop)
#: rc.cpp:120
msgid "Use this to stop the countdown for a task."
msgstr "Empregue isto para deter a conta atrás dunha tarefa."

#. i18n: file: prefwidget.ui:275
#. i18n: ectx: property (text), widget (QToolButton, m_stop)
#: rc.cpp:123
msgid "="
msgstr "="

#. i18n: file: prefwidget.ui:285
#. i18n: ectx: property (toolTip), widget (KPushButton, m_help)
#: rc.cpp:126
msgid "Detailed help documentation"
msgstr "Axuda detallada"

#. i18n: file: prefwidget.ui:288
#. i18n: ectx: property (whatsThis), widget (KPushButton, m_help)
#: rc.cpp:129
msgid "Click here to open the help documentation viewer."
msgstr "Prema aquí para abrir o visor da documentación de axuda."

