#, kde-format
msgid ""
"Requested resource does not exist.\n"
"\n"
"Google replied '%1'"
msgstr ""
"O recurso solicitado non existe\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:193 libkgapi/accessmanager_p.cpp:194
#, kde-format
msgid ""
"Conflict. Remote resource is newer then local.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Conflito. O recurso remoto é máis recente que o local.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:202 libkgapi/accessmanager_p.cpp:203
#, kde-format
msgid ""
"Requested resource does not exist anymore.\n"
"\n"
"Google replied '%1'"
msgstr ""
"O recurso solicitado non existe máis.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:211 libkgapi/accessmanager_p.cpp:212
#, kde-format
msgid ""
"Internal server error. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Produciuse un erro interno do servidor. Ténteo máis tarde.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:220 libkgapi/accessmanager_p.cpp:221
#, kde-format
msgid ""
"User quota exceeded. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Excedeuse a cota de usuario. Ténteo de novo máis tarde.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:229
#, kde-format
msgid ""
"Unknown error.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Produciuse un erro descoñecido.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:260 libkgapi/accessmanager_p.cpp:261
msgid "Unknown reply content type!"
msgstr "Descoñécese este tipo de contido de resposta!"

