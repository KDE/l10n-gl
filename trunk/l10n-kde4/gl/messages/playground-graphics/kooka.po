#: imgprintdialog.cpp:59
msgid "Image Printing"
msgstr "A imprimir a imaxe"

#: imgprintdialog.cpp:64 imgprintdialog.cpp:117
msgid "Image Print Size"
msgstr "Tamaño de impresión"

#: imgprintdialog.cpp:68
msgid "Scale to same size as on screen"
msgstr "Ampliar ao mesmo tamaño que na pantalla"

#: imgprintdialog.cpp:70
msgid "Screen scaling. That prints according to the screen resolution."
msgstr ""
"Ampliando a imaxe. Isto imprimirá de acordo coa resolución da pantalla."

#: imgprintdialog.cpp:74
msgid "Original size (calculate from scan resolution)"
msgstr "Tamaño orixinal (calculado desde a resolución da dixitalización)"

#: imgprintdialog.cpp:77
msgid ""
"Calculates the print size from the scan resolution. Enter the scan "
"resolution in the dialog field below."
msgstr ""
"Calcula o tamaño de impresión a partir da resolución da dixitalización. "
"Introduza a resolución coa que se dixitalizou no campo de dialogo de embaixo."

#: imgprintdialog.cpp:81
msgid "Scale image to custom dimension"
msgstr "Ampliar a imaxe a unhas dimensións personalizadas"

#: imgprintdialog.cpp:83
msgid ""
"Set the print size yourself in the dialog below. The image is centered on "
"the paper."
msgstr ""
"Escolla o tamaño de impresión no dialogo de embaixo. A imaxe está centrada "
"no papel."

#: imgprintdialog.cpp:87
msgid "Scale image to fit to page"
msgstr "Ampliar imaxe ao tamaño da páxina"

#: imgprintdialog.cpp:88
msgid ""
"Printout uses maximum space on the selected pager. Aspect ratio is "
"maintained."
msgstr ""
"Imprimir empregando o máximo espacio na páxina seleccionada. Mantense as "
"proporcións."

#: imgprintdialog.cpp:98
msgid "Resolutions"
msgstr "Resolucións"

#: imgprintdialog.cpp:102
msgid "Generate low resolution PostScript (fast draft print)"
msgstr "Xerar PostScript de baixa resolución (borrador)"

#: imgprintdialog.cpp:109
msgid "Scan resolution (dpi) "
msgstr "Resolución de dixitalización (ppp) "

#: imgprintdialog.cpp:111
msgid " dpi"
msgstr " ppp"

#: imgprintdialog.cpp:121
msgid "Image width:"
msgstr "Largura da imaxe:"

#: imgprintdialog.cpp:122 imgprintdialog.cpp:126
msgid " mm"
msgstr " mm"

#: imgprintdialog.cpp:125
msgid "Image height:"
msgstr "Alto da imaxe:"

#: imgprintdialog.cpp:129
msgid "Maintain aspect ratio"
msgstr "Manter as proporcións"

#: imgprintdialog.cpp:174
#, kde-format
msgid "Screen resolution: %1 dpi"
msgstr "Resolución da pantalla: %1 ppp"

#: imgprintdialog.cpp:218
msgid "Please specify a scan resolution larger than 0"
msgstr "Por favor, escolla unha resolución de dixitalización maior que cero"

#: imgprintdialog.cpp:223
msgid ""
"For custom printing, a valid size should be specified.\n"
"At least one dimension is zero."
msgstr ""
"Para a impresión personalizada, debe indicar un tamaño válido.\n"
"Polo menos unha dimensión é cero."

#: img_saver.cpp:71
msgid "Kooka Save Assistant"
msgstr "Asistente para gardar de Kooka"

#: img_saver.cpp:91
msgid ""
"<B>Save Assistant</B><P>Select an image format to save the scanned image."
msgstr ""
"<B>Asistente para gardar</B><P>Escolla un formato de imaxe para gardar a "
"imaxe dixitalizada."

#: img_saver.cpp:109
msgid "Available image formats:"
msgstr "Formatos de imaxe dispoñíbeis:"

#: img_saver.cpp:131
msgid "-No format selected-"
msgstr "-Non escolleu ningún formato-"

#: img_saver.cpp:138
msgid "Select the image sub-format"
msgstr "Escoller o subformato da imaxe"

#: img_saver.cpp:143
msgid "Do not ask again for the save format if it is defined."
msgstr "Non preguntar de novo polo formato a gardar se xa foi definido."

#: img_saver.cpp:177
msgid "-no hint available-"
msgstr "-sen consellos-"

#: img_saver.cpp:291
#, kde-format
msgid ""
"The folder\n"
"%1\n"
" does not exist and could not be created;\n"
"please check the permissions."
msgstr ""
"O cartafol\n"
"%1\n"
" non existe e non pode ser creado;\n"
"verifique os permisos."

#: img_saver.cpp:298
#, kde-format
msgid ""
"The directory\n"
"%1\n"
" is not writeable;\n"
"please check the permissions."
msgstr ""
"O cartafol\n"
"%1\n"
" non é editábel;\n"
"verifique os permisos."

#: img_saver.cpp:357
msgid "Filename"
msgstr "Nome do ficheiro"

#: img_saver.cpp:357
msgid "Enter filename:"
msgstr "Indique o nome do ficheiro:"

#: img_saver.cpp:501
msgid "palleted color image (16 or 24 bit depth)"
msgstr "paleta de cores (16 ou 24 bits de profundidade)"

#: img_saver.cpp:504
msgid "palleted gray scale image (16 bit depth)"
msgstr "paleta de escala de grises (16 bits de profundidade)"

#: img_saver.cpp:507
msgid "lineart image (black and white, 1 bit depth)"
msgstr "imaxe monocroma (branco e negro, 1 bit de profundidade)"

#: img_saver.cpp:510
msgid "high (or true-) color image, not palleted"
msgstr "imaxe a cores calidade alta (ou real), sen paleta"

#: img_saver.cpp:513
msgid "Unknown image type"
msgstr "Tipo de imaxe descoñecida"

#: img_saver.cpp:724
msgid " image save OK      "
msgstr " imaxe gardada correctamente"

#: img_saver.cpp:725
msgid " permission error   "
msgstr " erro nos permisos   "

#: img_saver.cpp:726
msgid " bad filename       "
msgstr " nome incorrecto      "

#: img_saver.cpp:727
msgid " no space on device "
msgstr " non hai espazo no dispositivo "

#: img_saver.cpp:728
msgid " could not write image format "
msgstr " non foi posíbel escribir no formato da imaxe "

#: img_saver.cpp:729
msgid " can not write file using that protocol "
msgstr " non foi posíbel escribir o ficheiro empregando este protocolo "

#: img_saver.cpp:730
msgid " user canceled saving "
msgstr " o usuario cancelou a garda "

#: img_saver.cpp:731
msgid " unknown error      "
msgstr " erro descoñecido      "

#: img_saver.cpp:732
msgid " parameter wrong    "
msgstr " parámetro trabucado    "

#: img_saver.cpp:781 img_saver.cpp:877
msgid ""
"The filename you supplied has no file extension.\n"
"Should the correct one be added automatically? "
msgstr ""
"O nome que indicou non ten extensión.\n"
"Desexa que engadirlla automaticamente? "

#: img_saver.cpp:782 img_saver.cpp:878
#, kde-format
msgid "That would result in the new filename: %1"
msgstr "Este podería ser o novo nome do ficheiro: %1"

#: img_saver.cpp:784 img_saver.cpp:880
msgid "Extension Missing"
msgstr "Falta a extensión"

#: img_saver.cpp:785 img_saver.cpp:881
msgid "Add Extension"
msgstr "Engadir a extensión"

#: img_saver.cpp:785 img_saver.cpp:881
msgid "Do Not Add"
msgstr "Non engadir"

#: img_saver.cpp:802 img_saver.cpp:895
msgid "Format changes of images are currently not supported."
msgstr "As mudanzas no formato das imaxes non están soportadas."

#: img_saver.cpp:803 img_saver.cpp:896
msgid "Wrong Extension Found"
msgstr "Atopouse unha extensión incorrecta"

