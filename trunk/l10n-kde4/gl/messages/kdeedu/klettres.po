#: main.cpp:33
#| msgid ""
#| "KLettres helps a very young child or an adult learning \n"
#| "a new language by associating sounds and \n"
#| "letters in this language.\n"
#| "\n"
#| "18 languages are available: Arabian, Brazilian Portuguese, British, "
#| "Czech, Danish, Dutch, English, French, German, Hebrew, Italian, Kannada, "
#| "Low Saxon, Luganda, Romanized Hindi, Spanish, Slovak and Telugu."
msgid ""
"KLettres helps a very young child or an adult learning \n"
"a new language by associating sounds and \n"
"letters in this language.\n"
"\n"
"25 languages are available."
msgstr ""
"O KLettres axuda os cativos e os adultos a aprenderen \n"
"unha lingua nova por asociación de sons e \n"
"letras nesa lingua.\n"
"\n"
"Hai dispoñíbeis 25 idiomas."

