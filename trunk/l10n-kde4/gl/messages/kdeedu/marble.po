"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Specifies the map quality "
"that gets displayed while there is no user input. Usually this allows for "
"high map quality as speed is no concern.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Especifica a calidade do "
"mapa que se usa mentres non indique nada o usuario. Habitualmente, isto "
"permite maior calidade de mapa xa que a velocidade non é importante.</p></"
"body></html>"

#. i18n: file: src/lib/MarbleViewSettingsWidget.ui:153
#. i18n: ectx: property (text), item, widget (QComboBox, kcfg_stillQuality)
