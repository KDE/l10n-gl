"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Select observed sky "
"object. You can select it from object list, by clicking <span style=\" font-"
"weight:600;\">Select object from list </span>button or point it on sky map "
"by pressing <span style=\" font-weight:600;\">Point object on sky map</"
"span>. After object is located, press it with right mouse button and select "
"<span style=\" font-weight:600;\">Select this object</span> option from "
"context menu.</p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">When done, press <span "
"style=\" font-weight:600;\">Next</span> button.</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Seleccionar o obxecto "
"celeste observado. Pódese seleccionar dunha lista de obxectos premendo o "
"botón <span style=\" font-weight:600;\">Selecionar o obxecto dunha lista </"
"span>ou apuntar para el no mapa celeste premendoby pressing <span style=\" "
"font-weight:600;\">Sinalar o obxecto no mapa celeste</span>. Unha vez "
"localizado o obxecto, prémeo co botón dereito do rato e escolle a "
"opción<span style=\" font-weight:600;\">Escoller este obxecto</span> no menú "
"de contexto.</p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Unha vez feito, preme o "
"botón <span style=\" font-weight:600;\">Seguinte</span>.</p></body></html>"

