#: kpercentage.cpp:82
msgid "Number of tasks:"
msgstr "Número de tarefas:"

#: kpercentage.cpp:83
msgid "Level:"
msgstr "Nível:"

#: kpercentage.cpp:84
msgid "Choose an exercise type:"
msgstr "Escolla o tipo de exercicio:"

#: kpercentage.cpp:92
#, no-c-format
msgid "x% &of ?? = y"
msgstr "x% &de ?? = y"

#: kpercentage.cpp:94
#, no-c-format
msgid "x% of &y = ??"
msgstr "x% de &y = ??"

#: kpercentage.cpp:96
#, no-c-format
msgid "??% o&f x = y"
msgstr "??% de &x = y"

#: kpercentage.cpp:97
msgid "??"
