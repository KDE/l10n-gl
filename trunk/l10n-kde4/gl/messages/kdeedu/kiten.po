#~ "Escolla <menuchoice><guimenu>Buscar</guimenu><guimenuitem>Selector de "
#~ "radicais</guimenuitem></menuchoice> para abrir o diálogo de busca de "
#~ "radicais."

#~ msgid ""
#~ "To choose the radicals you want to be in your Kanji, select one them from "
