#: previewer.cpp:248
msgid ""
"Threshold for autodetection.\n"
"All pixels higher (on black background)\n"
"or smaller (on white background)\n"
"than this are considered to be part of the image."
msgstr ""
"Limiar da detección automática.\n"
"Todos os píxeles maiores que (en fondo negro)\n"
"ou menores que (en fondo branco)\n"
"isto son considerados parte da imaxe."

