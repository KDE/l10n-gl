msgstr "Non se permite dividir un valor do tipo %1 por %2 (non número)."

#: xmlpatterns/data/qatomicmathematicians.cpp:216
#, qt-format
msgid "Dividing a value of type %1 by %2 or %3 (plus or minus zero) is not allowed."
msgstr "Non se permite dividir un valor do tipo %1 por %2 ou %3 (máis ou menos cero)."

#: xmlpatterns/data/qatomicmathematicians.cpp:248
#, qt-format
msgid ""
"Multiplication of a value of type %1 by %2 or %3 (plus or minus infinity) is "
"not allowed."
msgstr ""
"Non se permite multiplicar un valor do tipo %1 por %2 ou %3 (máis ou menos "
"infinito)."

#: xmlpatterns/data/qatomicvalue.cpp:82
#, qt-format
