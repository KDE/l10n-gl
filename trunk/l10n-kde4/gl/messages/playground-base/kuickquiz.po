msgstr "O contrasinal fornecido non casa."

#: kuickquiz.cpp:319
#, kde-format
msgid ""
"Either the new passwords do not match, or the old password was incorrect."
msgstr "Ou ben os contrasinais novos non casan ou ben o vello é incorrecto."

#: kuickquiz.cpp:340
#, kde-format
msgid "Quiz for %1"
msgstr "Proba para %1"

#: kuickquiz.cpp:342
#, kde-format
msgid "No quiz name has been specified"
msgstr "Non se indicou o nome da proba"

#: kuickquiz.cpp:346
#, kde-format
msgid "The quiz cannot be done because no questions exist."
msgstr "Non se pode facer a proba porque non contén ningunha pregunta."

