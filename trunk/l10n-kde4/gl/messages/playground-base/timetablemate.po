#: project.cpp:1700 project.cpp:1743
#, kde-format
msgctxt "@info/plain"
msgid "You need to implement a '%1' script function"
msgstr "Ten que definir unha función de script chamada «%1»."

#: project.cpp:1701
#, kde-format
msgctxt "@info"
msgid ""
"<title>You need to implement a '%1' script function</title> <para>Service "
"provider plugins that only support journeys are currently not accepted by "
"the data engine, but that may change.</para>"
msgstr ""
"<title>Ten que definir unha función de script chamada «%1»</title> "
"<para>Actualmente o motor de datos non permite complementos de fornecedores "
"de servizos que só fornecen rutas de viaxe, aínda que pode que iso cambie no "
"futuro.</para>"

#: project.cpp:1716
#, kde-format
msgctxt "@info/plain"
msgid "No results in departure test"
msgstr "A proba de saídas non forneceu resultados."

#: project.cpp:1723
#, kde-format
msgctxt "@info/plain"
msgid "'%1' script function not implemented"
msgstr "A función de script «%1» non está definida."

#: project.cpp:1724
#, kde-format
msgctxt "@info"
msgid ""
"<title>You can implement a '%1' script function</title> <para>This can be "
"used to load additional data for single departures or arrivals.</para>"
msgstr ""
"<title>Pode definir unha función de script chamada «%1»</title> <para>Isto "
"permite cargar datos adicionais para saídas ou chegadas individuais.</para>"

#: project.cpp:1744
#, kde-format
msgctxt "@info"
msgid ""
"<title>You need to implement a '%1' script function</title> <para>Without "
"stop suggestions it can be very hard for users to find a valid stop name. "
"Therefore this function is needed.</para>"
msgstr ""
"<title>Debe definir unha función de script chamada «%1»</title> <para>Sen "
"suxestións de paradas pode resultar moi difícil para os usuarios atopar un "
"nome de parada correcto. É por iso que esta función é necesaria.</para>"

#: project.cpp:1751
#, kde-format
msgctxt "@info/plain"
msgid "For journeys, you need to implement a '%1' script function"
msgstr "Nas rutas de viaxe debe definir a función de script «%1»."

#: project.cpp:1752
#, kde-format
msgctxt "@info"
msgid ""
"<title>For journeys, you need to implement a '%1' script function</title> "
"<para>If you do not implement the function, journeys will not work with the "
"plugin.</para>"
msgstr ""
"<title>Nas rutas de viaxe debe definir a función de script «%1»</title> "
"<para>Se non define esta función, as rutas de viaxe non funcionarán co "
"complemento.</para>"

#: project.cpp:1758
#, kde-format
msgctxt "@info/plain"
msgid "You should implement a '%1' script function"
msgstr "Debería definir unha función de script chamada «%1»."

#: project.cpp:1759
#, kde-format
msgctxt "@info"
msgid ""
"<title>You should implement a '%1' script function</title> <para>This "
"function is used to know what information the plugin parses from documents. "
"Without adding the appropriate TimetableInformation names to the return "
"value of this function, the associated data will be unused or associated "
"features will be disabled.</para><para>If, for example, the script can parse "
"Arrivals, 'Arrivals' should be added to the return value. If the script "
"parses route stops or stop IDs, add 'RouteStops' or 'StopID' to the return "
"value, etc.</para>"
msgstr ""
"<title>Debería definir unha función de script chamada «%1»</title> "
"<para>Esta función emprégase para saber que información obteñen dos "
"documentos os complementos. Se non engade os nomes «TimetableInformation» "
"necesarios no valor que devolve a función, non se usarán os datos asociados, "
"ou desactivaranse as funcionalidades relacionadas.</para> <para>Por exemplo, "
"se o script pode analizar as chegadas, engada «Arrivals» ao valor que "
"devolve a función. Se o script analiza paradas de rutas ou identificadores "
"de paradas, engada «RouteStops» ou «StopID» ao valor que devolve a función. "
"E así co resto.</para>"

