msgstr ""
"<title>Faltan cidades de exemplo</title> <para>Non é posíbel comezar as "
"probas sen datos de exemplo. Abra a configuración do proxecto e engada polo "
"menos unha <interface>Cidade de exemplo</interface>.</para>"

#: project.cpp:1609
msgctxt "@info/plain"
msgid "To test journeys at least two sample stop names are needed"
msgstr ""
"Para probar rutas de viaxe necesítanse polo menos dous nomes de parada de "
"exemplo."

#: project.cpp:1610
msgctxt "@info"
msgid ""
"<title>To test journeys at least two sample stop names are needed</title> "
"<para>Cannot run journey test. Open the project settings and add another "
