#: applet-flights/plasma-applet-flights.desktop:2
msgctxt "Name"
msgid "Flights"
msgstr "Voos"

#: applet-flights/plasma-applet-flights.desktop:25
msgctxt "Comment"
msgid "Shows flight departures/arrivals for a given airport."
msgstr ""
"Mostra as saídas dos voos e as chegadas dos aeroportos que se indiquen."

#: applet-graphicaltimetableline/plasma-applet-graphicaltimetableline.desktop:2
msgctxt "Name"
msgid "GraphicalTimetableLine"
msgstr "Liña gráfica da liña de horarios"

#: applet-graphicaltimetableline/plasma-applet-graphicaltimetableline.desktop:21
msgctxt "Comment"
msgid "Plasma GraphicalTimetableLine"
msgstr "Liña gráfica da liña de horarios para Plasma"

#: applet/plasma-applet-publictransport.desktop:2
#: runner/plasma-runner-publictransport.desktop:2
msgctxt "Name"
msgid "Public Transport"
msgstr "Transporte público"

#: applet/plasma-applet-publictransport.desktop:28
msgctxt "Comment"
msgid ""
"Plasma Public Transport shows a departure / arrival board for public "
"transport. It can also show journeys."
msgstr ""
"Transporte Público de Plasma mostra as saídas e chegadas dos transportes "
"públicos. Mostra tamén as xornadas."

#: engine-openstreetmap/plasma-engine-openstreetmap.desktop:2
msgctxt "Name"
msgid "OpenStreetMap data engine"
msgstr "Motor de datos OpenStreetMap"

#: engine-openstreetmap/plasma-engine-openstreetmap.desktop:24
msgctxt "Comment"
msgid ""
"The OpenStreetMap data engine can be used to query things near the user."
msgstr ""
"O motor de datos OpenStreetMap pódese usar para consultar os servizos de "
"preto do usuario."

#: engine/plasma-engine-publictransport.desktop:2
msgctxt "Name"
msgid "Public transport engine"
msgstr "Motor de transporte público"

#: engine/plasma-engine-publictransport.desktop:24
msgctxt "Comment"
msgid "Plasma data engine for public transport"
msgstr "Motor de datos para os transporte público de Plasma"

#: engine/timetablemate/src/timetablemate.actions:2
#: engine/timetablemate/src/timetablemate.desktop:2
msgctxt "Name"
msgid "TimetableMate"
msgstr "TimetableMate"

#: engine/timetablemate/src/timetablemate.actions:25
msgctxt "Name"
msgid "Install timetable accessor globally"
msgstr "Instalar o servizo de acceso á liña de horarios a nivel global"

#: engine/timetablemate/src/timetablemate.actions:44
msgctxt "Description"
msgid ""
"Authentication is required to install the timetable accessor files globally"
msgstr ""
"Precísase autenticarse parar instalar o servizo de acceso da liña de "
"horarios a nivel global"

#: engine/timetablemate/src/timetablemate.desktop:27
msgctxt "GenericName"
msgid ""
"A little IDE for adding support for new service providers to the "
"PublicTransport data engine"
msgstr ""
"Unha pequena IDE para engadir novas fontes de liñas de servizos ao motor de "
"transporte público"

#: libpublictransporthelper/publictransporthelper.desktop:2
msgctxt "Name"
msgid "Public Transport Helper Library"
msgstr "Biblioteca de axuda de transporte público"

#: libpublictransporthelper/publictransporthelper.desktop:22
msgctxt "Comment"
msgid ""
"A library to be used with the publictransport data engine. It provides "
"widgets/dialogs to setup stop settings."
msgstr ""
"Unha biblioteca que se pode empregar co motor de datos de transporte "
"público. Fornece de trebellos e diálogos para definir as configuración de "
"paradas."

#: runner/config/plasma-runner-publictransport_config.desktop:2
msgctxt "Name"
msgid "Public Transport Runner Config"
msgstr "Configuración da vía de transporte público"

#: runner/config/plasma-runner-publictransport_config.desktop:22
msgctxt "Comment"
msgid "Configuration of the Public Transport Runner"
msgstr "Configurador da vía de transporte público"

#: runner/plasma-runner-publictransport.desktop:28
msgctxt "Comment"
msgid "Gives information about public transport departing from a given stop"
msgstr ""
"Dá información sobre do transporte público que está para arrincar dun "
"determinado punto de saída"
