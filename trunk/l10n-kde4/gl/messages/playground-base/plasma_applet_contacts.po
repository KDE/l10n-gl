#: lineeditcell.cpp:61
#, kde-format
msgid "Type a message and press return to send it"
msgstr "Escriba unha mensaxe e prema intro para enviala"

#: lineeditcell.cpp:62
#, kde-format
msgid "This contact cannot be reached at the moment."
msgstr "Non se pode contactar con este contacto nestes momentos."

