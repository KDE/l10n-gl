#: eventcell.cpp:89
#, kde-format
msgid "Today is %1 birthday"
msgstr "Hoxe é o aniversario de %1"

#: eventcell.cpp:95
#, kde-format
msgid "Only one day left to %2 birthday"
msgid_plural "Only %1 days left to %2 birthday"
msgstr[0] "Só queda %1 día para o aniversario de %2"
