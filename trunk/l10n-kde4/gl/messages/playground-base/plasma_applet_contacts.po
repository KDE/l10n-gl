#: contacts.cpp:179
msgid "Contact Selection"
msgstr "Escolla de contacto"

#: contacts.cpp:180
msgid "Display Properties"
msgstr "Mostrar as propriedades"

#: contacts.cpp:290
msgid "You can add contacts in the settings dialog."
msgstr "Pode engadir contactos no diálogo de configuración."

#: lineeditcell.cpp:61
msgid "Type a message and press return to send it"
msgstr "Escreba unha mensaxe e prema intro para enviala"

#: lineeditcell.cpp:62
msgid "This contact cannot be reached at the moment."
msgstr "Non é posíbel contactar con este contacto nestes momentos."

#. i18n: tag string
