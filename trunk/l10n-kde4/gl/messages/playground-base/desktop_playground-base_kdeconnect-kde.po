#: fileitemactionplugin/kdeconnectsendfile.desktop:3
msgctxt "Name"
msgid "Send file via KDE Connect service"
msgstr "Enviar un ficheiro mediante o servizo de KDE Connect"

#: fileitemactionplugin/kdeconnectsendfile.desktop:25
msgctxt "X-KDE-Submenu"
msgid "Connect"
msgstr "Conectar"

#: kcm/kcm_kdeconnect.desktop:13 kcm/kdeconnect.desktop:6
#: kded/kdeconnect.desktop:11 plasmoid/package/metadata.desktop:2
#: plugins/kdeconnect.notifyrc:3
msgctxt "Name"
msgid "KDE Connect"
msgstr "KDE Connect"

#: kcm/kcm_kdeconnect.desktop:39
msgctxt "Comment"
msgid "Connect and sync your devices with KDE"
msgstr "Conecte e sincronize os seus dispositivos con KDE."

#: kcm/kcm_kdeconnect.desktop:64
msgctxt "X-KDE-Keywords"
msgid "Network,Android,Devices"
msgstr "rede,Android,dispositivos"

#: kcm/kdeconnect.desktop:31
msgctxt "GenericName"
msgid "Connect smartphones to your KDE Plasma Workspace"
msgstr "Conectar teléfonos móbiles ao espazo de traballo KDE Plasma"

#: kded/kdeconnect.desktop:37
msgctxt "Comment"
msgid "Connect KDE with your smartphone"
msgstr "Conectar KDE co seu teléfono móbil."

#: plasmoid/package/metadata.desktop:27
msgctxt "Comment"
msgid "Show notifications from your devices using KDE Connect"
msgstr "Mostrar notificacións de dispositivos usando KDE Connect."

#: plugins/battery/kdeconnect_battery.desktop:14
msgctxt "Name"
msgid "Battery monitor"
msgstr "Vixilante da batería"

#: plugins/battery/kdeconnect_battery.desktop:39
msgctxt "Comment"
msgid "Show your phone battery next to your computer battery"
msgstr ""
"Mostra o nivel de batería do teléfono canda o nivel de batería do computador."

#: plugins/clipboard/kdeconnect_clipboard.desktop:14
msgctxt "Name"
msgid "Clipboard"
msgstr "Portapapeis"

#: plugins/clipboard/kdeconnect_clipboard.desktop:39
msgctxt "Comment"
msgid "Share the clipboard between devices"
msgstr "Comparta o portapapeis entre os dispositivos."

#: plugins/kdeconnect.notifyrc:28
msgctxt "Comment"
msgid "Notifications from your devices"
msgstr "Notificacións de dispositivos."

#: plugins/kdeconnect.notifyrc:55 plugins/kdeconnect.notifyrc:394
msgctxt "Name"
msgid "Pairing Request"
msgstr "Solicitude de emparellamento"

#: plugins/kdeconnect.notifyrc:76 plugins/kdeconnect.notifyrc:415
msgctxt "Comment"
msgid "Pairing request received from a devices"
msgstr "Recibiuse unha solicitude de emparellamento dun dispositivo."

#: plugins/kdeconnect.notifyrc:100
msgctxt "Name"
msgid "Calling"
msgstr "Chamando"

#: plugins/kdeconnect.notifyrc:125
msgctxt "Comment"
msgid "Someone is calling you"
msgstr "Está a recibir unha chamada de alguén."

#: plugins/kdeconnect.notifyrc:153
msgctxt "Name"
msgid "Missed"
msgstr "Perdida"

#: plugins/kdeconnect.notifyrc:170
msgctxt "Comment"
msgid "You have a missed call"
msgstr "Ten unha chamada perdida."

#: plugins/kdeconnect.notifyrc:198
msgctxt "Name"
msgid "SMS"
msgstr "SMS"

#: plugins/kdeconnect.notifyrc:223
msgctxt "Comment"
msgid "Someone sent you an SMS"
msgstr "Recibiu unha mensaxe SMS de alguén."

#: plugins/kdeconnect.notifyrc:251
msgctxt "Name"
msgid "Battery"
msgstr "Batería"

#: plugins/kdeconnect.notifyrc:268
msgctxt "Comment"
msgid "Your battery is in low state"
msgstr "A batería está esgotándose."

#: plugins/kdeconnect.notifyrc:296 plugins/ping/kdeconnect_ping.desktop:14
msgctxt "Name"
msgid "Ping"
msgstr "Ping"

#: plugins/kdeconnect.notifyrc:321
msgctxt "Comment"
msgid "Ping received"
msgstr "Recibiuse un “ping”."

#: plugins/kdeconnect.notifyrc:349
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: plugins/kdeconnect.notifyrc:366
msgctxt "Comment"
msgid "Notification received"
msgstr "Recibiuse unha notificación."

#: plugins/kdeconnect_plugin.desktop:5
msgctxt "Name"
msgid "KDEConnect Plugin"
msgstr "Complemento de KDE Connect"

#: plugins/mousepad/kdeconnect_mousepad.desktop:13
msgctxt "Name"
msgid "Touchpad"
msgstr "Touchpad"

#: plugins/mousepad/kdeconnect_mousepad.desktop:34
msgctxt "Comment"
msgid "Use your phone as a touchpad"
msgstr "Usar o teléfono móbil como touchpad."

#: plugins/mpriscontrol/kdeconnect_mpriscontrol.desktop:14
msgctxt "Name"
msgid "Multimedia control receiver"
msgstr "Receptor de controis multimedia"

#: plugins/mpriscontrol/kdeconnect_mpriscontrol.desktop:38
msgctxt "Comment"
msgid "Remote control your music and videos"
msgstr "Use o teléfono móbil como mando a distancia para música e vídeos."

#: plugins/notifications/kdeconnect_notifications.desktop:14
msgctxt "Name"
msgid "Notification sync"
msgstr "Sincronización de notificacións"

#: plugins/notifications/kdeconnect_notifications.desktop:39
msgctxt "Comment"
msgid "Show phone notifications in KDE and keep them in sync"
msgstr ""
"Mostre notificacións dun teléfono móbil en KDE e deixe que as notificacións "
"se sincronicen co teléfono."

#: plugins/pausemusic/kdeconnect_pausemusic_config.desktop:8
msgctxt "Name"
msgid "Pause Music plugin settings"
msgstr "Configuración do complemento para deter a música"

#: plugins/pausemusic/kdeconnect_pausemusic.desktop:14
msgctxt "Name"
msgid "Pause media during calls"
msgstr "Deter a reprodución durante as chamadas."

#: plugins/pausemusic/kdeconnect_pausemusic.desktop:38
msgctxt "Comment"
msgid "Pause music/videos during a phone call"
msgstr "Deter a reprodución de música ou vídeos durante as chamadas."

#: plugins/ping/kdeconnect_ping.desktop:39
msgctxt "Comment"
msgid "Send and receive pings"
msgstr "Enviar e recibir pings."

#: plugins/screensaver-inhibit/kdeconnect_screensaver_inhibit.desktop:14
msgctxt "Name"
msgid "Inhibit screensaver"
msgstr "Desactivar o salvapantallas"

#: plugins/screensaver-inhibit/kdeconnect_screensaver_inhibit.desktop:34
msgctxt "Comment"
msgid "Inhibit the screensaver when the device is connected"
msgstr "Desactivar o salvapantallas mentres o dispositivo estea conectado."

#: plugins/sftp/kdeconnect_sftp_config.desktop:8
msgctxt "Name"
msgid "SFTP filebrowser plugin settings"
msgstr "Configuración do complemento de navegación de ficheiros mediante SFTP"

#: plugins/sftp/kdeconnect_sftp.desktop:14
msgctxt "Name"
msgid "Remote filesystem browser"
msgstr "Navegador do sistema de ficheiros remoto."

#: plugins/sftp/kdeconnect_sftp.desktop:37
msgctxt "Comment"
msgid "Browse the remote device filesystem using SFTP"
msgstr "Explore o sistema de ficheiros do dispositivo remoto mediante SFTP."

#: plugins/share/kdeconnect_share_config.desktop:8
msgctxt "Name"
msgid "Share plugin settings"
msgstr "Configuración do complemento de compartir"

#: plugins/share/kdeconnect_share.desktop:14
msgctxt "Name"
msgid "Share and receive"
msgstr "Compartir e recibir."

#: plugins/share/kdeconnect_share.desktop:38
msgctxt "Comment"
msgid "Receive and send files, URLs or plain text easily"
msgstr ""
"Comparta e reciba con facilidade ficheiros, enderezos URL ou texto simple."

#: plugins/telephony/kdeconnect_telephony.desktop:14
msgctxt "Name"
msgid "Telephony integration"
msgstr "Integración telefónica"

#: plugins/telephony/kdeconnect_telephony.desktop:39
msgctxt "Comment"
msgid "Show notifications for calls and SMS (answering coming soon)"
msgstr ""
"Mostrar notificacións de chamadas e mensaxes SMS (no futuro tamén poderá "
"contestar chamadas)."

