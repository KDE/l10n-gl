#: serviceproviderdatadialog.cpp:119
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<title>Delete GTFS Database</title><para>The GTFS database contains all data "
"imported from the GTFS feed. If you delete the database now the GTFS feed "
"needs to be imported again to make this service provider usable again.</"
"para><para>By deleting the database %1 disk space get freed.</para>"
msgstr ""
"<title>Eliminar a base de datos GTFS</title><para>A base de datos GTFS "
"contén todos os datos importados da fonte GTFS. Se agora eliminas a base de "
"datos precisarase dunha nova importación da fonte de datos de GTFS para que "
"o servizo volva a estar dispoñíbel.</para><para>Eliminando a base de datos "
"%1 libérase espazo do disco.</para>"

