#: lnkforward.cpp:52
msgid ""
"Map a Windows drive to a local mountpoint, e.g. \"C=/mnt/windows\"\n"
"This option can be given multiple times"
msgstr ""
"Mapea un dispositivo Windows a un ponto de montaxe local, p.ex. \"C=/mnt/"
"windows\"\n"
"Esta opción pode fornecerse múltiplas veces"

#: lnkforward.cpp:55
msgid "Windows .lnk file to open"
msgstr "Ficheiro .lnk de Windows a abrir"
