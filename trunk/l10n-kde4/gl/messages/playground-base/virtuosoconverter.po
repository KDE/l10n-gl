msgid "(c) 2010, Sebastian Trüg"
msgstr "© 2010, Sebastian Trüg"

#: main.cpp:40
#, kde-format
msgid "Sebastian Trüg"
msgstr "Sebastian Trüg"

#: main.cpp:40
#, kde-format
msgid "Maintainer"
msgstr "Mantedor"

#: main.cpp:46
#, kde-format
msgid "Automatic mode without user interaction"
msgstr "Modo automático sen interacción de usuario."

#: main.cpp:47
#, kde-format
msgid "Do not create a backup of the data before converting."
msgstr "Non crear unha copia de seguridade dos datos antes da conversión."

#: main.cpp:48
#, kde-format
msgid "Keep the dump of the old database."
msgstr "Manter o restrollo da bases de datos antigos."
