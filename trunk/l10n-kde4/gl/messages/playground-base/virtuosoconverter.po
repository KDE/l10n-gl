#: converterdialog.cpp:57
#, kde-format
msgid "No Virtuoso Nepomuk database found. Nothing to convert."
msgstr ""
"Non se atopa ningunha base de datos de Virtuoso de Nepomuk. Non hai nada que "
"converter."

#: converterdialog.cpp:68
#, kde-format
msgid "Installed Virtuoso version is 5. No need to convert."
msgstr "Instalouse Virtuoso na súa versión 5. Non se necesita converter."

#: converterdialog.cpp:72
#, kde-format
msgid "Ready to convert Nepomuk database to Virtuoso 6 format."
msgstr ""
"Listo para converter a base de datos de Nepomuk ao formato da Virtuoso 6."

#: converterdialog.cpp:77
#, kde-format
msgid "Could not find a valid Virtuoso installation."
msgstr "Non foi posíbel atopar unha instalación correcta de Virtuoso."

#: converterdialog.cpp:84
#, kde-format
msgid "Nepomuk Database already converted to version 6."
msgstr "A base de datos de Nepomuk xa está convertida na da versión 6."

#: converterdialog.cpp:89
#, kde-format
msgid ""
"Failed to determine the correct Virtuoso version number. Cannot convert."
msgstr ""
"Fallouse determinando o número correcto da versión de Virtuoso. Non se pode "
"converter."

#: converterdialog.cpp:99
#, kde-format
msgid "Start Conversion"
msgstr "Comezar a conversión"

#: converterdialog.cpp:119
#, kde-format
msgid "Converting Virtuoso database to version 6..."
msgstr "Convertendo a base de datos de Virtuoso á versión 6…"

#: converterdialog.cpp:152
#, kde-format
msgid "Nepomuk Virtuoso database conversion failed: %1"
msgstr "Fallou a conversión da base de datos de Virtuoso de Nepomuk: %1"

#: converterdialog.cpp:155
#, kde-format
msgid "Nepomuk Virtuoso database successfully converted to version 6."
msgstr "A base de datos de Nepomuk converteuse á versión 6 correctamente."

#: converterjob.cpp:83
#, kde-format
msgid "Please disable Nepomuk before starting the converter."
msgstr "Desactiva Nepomuk antes de comezar a conversión."

#: converterjob.cpp:93
#, kde-format
msgid "Creating backup in <filename>%1</filename>..."
msgstr "Creando unha copia de seguridade en <filename>%1</filename>…"

#: converterjob.cpp:97
#, kde-format
msgid "Failed to create backup (%1)."
msgstr "Non se puido crear unha copia de seguridade (%1)."

#: converterjob.cpp:103
#, kde-format
msgid "Starting Virtuoso version 5..."
msgstr "Comezando a versión 5 de Virtuoso…"

#: converterjob.cpp:120 converterjob.cpp:182
#, kde-format
msgid "Failed to create stored procedure (%1)"
msgstr "Non se puido crear o procedemento almacenado (%1)"

#: converterjob.cpp:126
#, kde-format
msgid "Dumping V5 database to %1..."
msgstr "Pasando a base de datos V5 a %1…"

#: converterjob.cpp:139
#, kde-format
msgid "Shutting down Virtuoso version 5..."
msgstr "Apagando a versión 5 de Virtuoso…"

#: converterjob.cpp:144
#, kde-format
msgid "Failed to dump all graphs in the database to %1"
msgstr "Non se puideron verter todos os gráficos da base de datos en %1"

#: converterjob.cpp:150
#, kde-format
msgid "Deleting Virtuoso V5 database files..."
msgstr "Eliminando os ficheiros da base da datos de Virtuoso 5…"

#: converterjob.cpp:154
#, kde-format
msgid "Starting Virtuoso version 6..."
msgstr "Comezando a versión 6 de Virtuoso…"

#: converterjob.cpp:188
#, kde-format
msgid "Importing dump from %1 into V6 database."
msgstr "Importando o restrollo de %1 a base de datos V6."

#: converterjob.cpp:201
#, kde-format
msgid "Failed to import database dump."
msgstr "Non se puido importar a vertedura da base de datos."

#: converterjob.cpp:218
#, kde-format
msgid "Removing backup data."
msgstr "Retirando os datos da copia de seguridade."

#: converterjob.cpp:239
#, kde-format
msgid "Keeping V5 dump in <filename>%1</filename>"
msgstr "Mantendo o restrollo de V5 en <filename>%1</filename>"

#: converterjob.cpp:242
#, kde-format
msgid "Removing temp data."
msgstr "Retirando os datos temporais."

#: converterjob.cpp:253
#, kde-format
msgid "Conversion failed. Restoring backup..."
msgstr "Fallou a conversión. Restaurando a copia de seguridade…"

#: converterjob.cpp:257
#, kde-format
msgid "Failed to restore backup (%1)."
msgstr "Non se puido restaurar a copia de seguranza (%1)."

#: main.cpp:33
#, kde-format
msgid "Virtuoso Converter"
msgstr "Convertedor Virtuoso"

#: main.cpp:35
#, kde-format
msgid "Virtuoso V5 to V6 converter"
msgstr "Convertedor de Virtuoso V5 a V6"

