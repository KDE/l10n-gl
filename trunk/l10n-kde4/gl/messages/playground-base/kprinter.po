#: main.cpp:29
msgid "KPrinter"
msgstr "KPrinter"

#: main.cpp:29
msgid "A printer tool for KDE"
msgstr "Unha utilidade de impresión para KDE"

#: main.cpp:32
msgid "Make an internal copy of the files to print"
msgstr "Facer unha copia interna dos ficheiros para imprimir"

#: main.cpp:34
msgid "Printer/destination to print on"
msgstr "Impresora/destino onde imprimir"

#: main.cpp:36
msgid "Title/Name for the print job"
msgstr "Título/Nome do traballo de impresión"

#: main.cpp:38
msgid "Number of copies"
msgstr "Número de copias"

#: main.cpp:39
msgid "Printer option"
msgstr "Opción da impresora"

#: main.cpp:40
msgid "Job output mode (gui, console, none)"
msgstr "Modo de saída do traballo (interface gráfico, consola, ningún)"

#: main.cpp:41
msgid "Print system to use (lpd, cups)"
msgstr "Sistema de impresión a usar (lpd, cups)"

#: main.cpp:42
msgid "Allow printing from STDIN"
msgstr "Permitir imprimir desde STDIN"

#: main.cpp:43
msgid "Do not show the print dialog (print directly)"
msgstr "Non mostrar o diálogo de impresión (imprimir directamente)"

#: main.cpp:44
msgid "Files to load"
msgstr "Ficheiros a cargar"

#: printwrapper.cpp:63
msgid "Print Information"
msgstr "Información de impresión"

#: printwrapper.cpp:64
msgid "Print Warning"
msgstr "Aviso de impresión"

#: printwrapper.cpp:65
msgid "Print Error"
msgstr "Erro de impresión"

#: printwrapper.cpp:71
msgid "Print info"
msgstr "Información de impresión"

#: printwrapper.cpp:71
msgid "Print warning"
msgstr "Aviso de impresión"

#: printwrapper.cpp:71
msgid "Print error"
msgstr "Erro de impresión"

#: printwrapper.cpp:187
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr ""
"Un ficheiro foi especificado na liña de ordes. A impresión dende STDIN será "
"desactivada."

#: printwrapper.cpp:193
msgid ""
"When using '--nodialog', you must at least specify one file to print or use "
"the '--stdin' flag."
msgstr ""
"Cando se usa «--nodialog», débese especificar, polo menos, un ficheiro para "
"imprimir, ou usar a opción «--stdin»."

#: printwrapper.cpp:242
msgid "The specified printer or the default printer could not be found."
msgstr "Non se achou nin a impresora especificada nin a predeterminada."

#: printwrapper.cpp:244
msgid "Operation aborted."
msgstr "A operación cancelouse."

#: printwrapper.cpp:274
msgid "Unable to construct the print dialog."
msgstr "Non foi posíbel construír o diálogo de impresión."

#: printwrapper.cpp:315
#, kde-format
msgid "Multiple files (%1)"
msgstr "Ficheiros múltiplos (%1)"

#: printwrapper.cpp:322
msgid "Nothing to print."
msgstr "Nada para imprimir."

#: printwrapper.cpp:347
msgid "Unable to open temporary file."
msgstr "Non foi posíbel abrir o ficheiro temporal."

#: printwrapper.cpp:362
msgid "Stdin is empty, no job sent."
msgstr "Stdin está baleiro, non se enviou ningún traballo."

#: printwrapper.cpp:374
#, kde-format
msgid "Unable to copy file %1."
msgstr "Non foi posíbel copiar o ficheiro %1."

#: printwrapper.cpp:391
msgid "Error while printing files"
msgstr "Aconteceu un erro ao imprimir os ficheiros"
