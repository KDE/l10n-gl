#: lib/scribo-textmatchplugin.desktop:5
msgctxt "Comment"
msgid "Scribo text match plugin"
msgstr "Engadido de procura de texto Scribo"

#: plugins/datetime/scribo_datetimetextmatchplugin.desktop:2
msgctxt "Name"
msgid "Datetime text match plugin"
msgstr "Complemento de procura de texto de datas e horas"

#: plugins/datetime/scribo_datetimetextmatchplugin.desktop:17
msgctxt "Comment"
msgid ""
"Scribo text match plugin which extracts dates and times from the text and "
"presents them as simple statements"
msgstr ""
"O engadido de procura de texto extrae datas e horas do texto e indícaas de "
"xeito simple"

#: plugins/opencalais/kcm_kopencalais.desktop:5
msgctxt "Name"
msgid "Open Calais"
msgstr "Open Calais"

#: plugins/opencalais/kcm_kopencalais.desktop:22
msgctxt "Comment"
msgid "Configure the Open Calais Scribo plugin"
msgstr "Configurar o engadido de Open Calais de Scribo"

#: plugins/opencalais/scribo_opencalaistextmatchplugin.desktop:2
msgctxt "Name"
msgid "OpenCalais text match plugin"
msgstr "Engadido de procura de texto OpenCalais"

#: plugins/opencalais/scribo_opencalaistextmatchplugin.desktop:16
msgctxt "Comment"
msgid ""
"Scribo text match plugin which uses the OpenCalais web service to analyse "
"text and extract entities and statements"
msgstr ""
"O engadido de procura de texto Scribo usa o servizo web OpenCalais para "
"analizar texto e extraer entidades e definicións"

#: plugins/pimo/scribo_pimotextmatchplugin.desktop:2
msgctxt "Name"
msgid "Pimo text match plugin"
msgstr "Engadido de procura de texto Pimo"

#: plugins/pimo/scribo_pimotextmatchplugin.desktop:16
msgctxt "Comment"
msgid ""
"Scribo text match plugin which simply tries to match words in the text to "
"Pimo things in Nepomuk"
msgstr ""
"Engadido de procura de texto que simplemente intenta cadrar as palabras do "
"texto con elementos de Pimo en Nepomuk"

#: service/nepomukscriboservice.desktop:7
msgctxt "Name"
msgid "Nepomuk Scribo Service"
msgstr "Servizo Scribo de Nepomuk"

#: service/nepomukscriboservice.desktop:22
msgctxt "Comment"
msgid ""
"The Nepomuk Scribo service offers a simple interface to Scribo's NLP "
"facilities."
msgstr ""
"O servizo de Scribo de Nepomuk fornece unha interface sinxela para as "
"capacidade de NLP de Scribo."
