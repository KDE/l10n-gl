#: outputservice.cpp:69
msgid "The 'size' command requires a valid combination of width and height"
msgstr "A orde «size» precisa dunha combinación válida de ancho e alto"

#: outputservice.cpp:73
msgid "The 'size' command requires a 'width' and a 'height' argument"
msgstr ""
"A orde «size» precisa dun argumento «width» (ancho) e outro «height» (alto) "

#: outputservice.cpp:91
msgid "The 'position' command requires a valid combination of x and y"
msgstr "A orde «position» precisa dunha combinación válida de x e y"

#: outputservice.cpp:95
msgid "The 'position' command requires a 'x' and a 'y' argument"
msgstr "A orde «position» precisa dun argumento «x» e outro «y»"

#: outputservice.cpp:116
msgid ""
"The 'rotation' command requires a valid value for 'rotate' (0, 90, 180 or "
"270)"
msgstr "A orde «rotation» precisa dun valor de xiro válido (0, 90, 180 ou 270)"

#: outputservice.cpp:120
msgid "The 'rotation' command requires a 'rotate' argument"
msgstr "A orde «rotation» precisa dun argumento «rotate» (xiro)"

