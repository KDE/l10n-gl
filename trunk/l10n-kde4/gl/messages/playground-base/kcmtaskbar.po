#. i18n: ectx: property (text), widget (QLabel)
#: rc.cpp:73
msgid "&Left button:"
msgstr "Botón &esquerdo:"

#. i18n: file: kcmtaskbarui.ui:226
#. i18n: ectx: property (text), widget (QLabel)
#: rc.cpp:76
msgid "&Middle button:"
msgstr "Botón &central:"

#. i18n: file: kcmtaskbarui.ui:237
#. i18n: ectx: property (text), widget (QLabel)
#: rc.cpp:79
msgid "Right b&utton:"
msgstr "Botón &dereito:"

