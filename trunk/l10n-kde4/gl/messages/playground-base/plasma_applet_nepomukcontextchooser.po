#: nepomukcontextchooser.cpp:101
#, kde-format
msgctxt "@info:tooltip"
msgid "Current work context: <emphasis>%1</emphasis>"
msgstr "Contexto de traballo actual: <emphasis>%1</emphasis>"

#: nepomukcontextchooser.cpp:103
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"You are working in the context of <emphasis>%1</emphasis>. This means that "
"files, emails, and other resources can easily be related to it."
msgstr ""
"Estás a traballar no contexto de <emphasis>%1</emphasis>. Isto implica que "
"facilmente ficheiros, correos electrónicos e outros recursos poden "
"relacionarse con isto."

#: nepomukcontextchooser.cpp:110
#, kde-format
msgctxt "@action:button"
msgid "No work context selected"
msgstr "Non hai contexto de traballo seleccionado"

#: nepomukcontextchooser.cpp:113
#, kde-format
msgctxt "@info:tooltip"
msgid "No work context selected"
msgstr "Non hai contexto de traballo seleccionado"

#: nepomukcontextchooser.cpp:115
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Choose the current work context to be able to easily relate files, emails, "
"and other resources to it."
msgstr ""
"Escolla o grupo de traballo actual para ser quen de facilmente relacionar "
"ficheiros, correos electrónicos e outros recursos a este."

#: nepomukcontextchooser.cpp:134
#, kde-format
msgid "Start Ginkgo"
msgstr "Iniciar Ginkgo"

#: nepomukcontextchooser.cpp:153
#, kde-format
msgid "Context Types"
msgstr "Tipos de contexto"

#: nepomukcontextchooser.cpp:155
#, kde-format
msgid "Select the types that should be selectable as work context"
msgstr ""
"Escolle os tipos que deberían ser seleccionables como contexto de traballo"

