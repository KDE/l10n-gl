#. i18n: file: kmymoney/wizards/newaccountwizard/kloandetailspagedecl.ui:155
#. i18n: ectx: property (text), widget (QLabel, textLabel12)
#: rc.cpp:4331
msgid "Balloon payment"
msgstr "Pagamento final"

#. i18n: file: kmymoney/wizards/newaccountwizard/kloandetailspagedecl.ui:165
#. i18n: ectx: property (whatsThis), widget (kMyMoneyEdit, m_balloonAmount)
#: rc.cpp:4334
msgid ""
"Please enter the amount of a final amortization payment or leave the field "
"empty to calculate it."
msgstr ""
