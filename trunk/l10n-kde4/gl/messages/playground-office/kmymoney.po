#: rc.cpp:1917
msgid "Additional fees:"
msgstr "Cargos adicionais:"

#. i18n: file: kmymoney/dialogs/knewloanwizarddecl.ui:4274
#. i18n: ectx: property (text), widget (QLabel, TextLabel9_2_2_2_2_2_2)
