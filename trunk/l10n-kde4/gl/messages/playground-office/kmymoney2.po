#. i18n: file: kmymoney2/plugins/ofximport/dialogs/konlinebankingsetupdecl.ui:87
#. i18n: ectx: attribute (title), widget (QWidget, tab)
#: rc.cpp:4849
msgid "Manual"
msgstr "Manual"

#. i18n: file: kmymoney2/plugins/ofximport/dialogs/konlinebankingsetupdecl.ui:98
#. i18n: ectx: property (text), widget (QLabel, textLabel4)
#: rc.cpp:4852
