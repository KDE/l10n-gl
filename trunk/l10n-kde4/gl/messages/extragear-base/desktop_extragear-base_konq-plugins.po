msgctxt "Comment"
msgid "Adds selected feed to Akregator"
msgstr "Engade a fonte escollida a Akregator"

#: autorefresh/autorefresh.desktop:13
msgctxt "Name"
msgid "Auto Refresh"
msgstr "Refrescar automaticamente"

#: autorefresh/autorefresh.desktop:47
msgctxt "Comment"
msgid "Auto Refresh plugin"
msgstr "Extensión de actualización automática"

#: babelfish/plugin_babelfish.desktop:13
msgctxt "Name"
msgid "Translate"
msgstr "Traducir"

#: babelfish/plugin_babelfish.desktop:61
msgctxt "Comment"
msgid "Language translation for the current page using Babelfish"
msgstr "Traduce a páxina actual usando Babelfish"

#: crashes/crashesplugin.desktop:13
msgctxt "Name"
msgid "Crashes Monitor"
msgstr "Vixilante de peches inesperados"

#: crashes/crashesplugin.desktop:59
msgctxt "Comment"
msgid "Records instances of crashes for easier recovery"
msgstr ""
"Grava as ocorrencias de peches inesperados para recuperalos sinxelamente"

#: dirfilter/dirfilterplugin.desktop:13
msgctxt "Name"
msgid "Directory Filter"
msgstr "Filtraxe de cartafoles"

#: dirfilter/dirfilterplugin.desktop:59
msgctxt "Comment"
msgid "Filter directory view using an attribute filter"
msgstr "Filtra a vista dos cartafoles usando un filtro de atributos"

