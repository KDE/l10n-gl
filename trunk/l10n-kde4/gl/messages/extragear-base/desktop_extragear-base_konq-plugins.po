msgctxt "Name"
msgid "File Size View"
msgstr "Vista do tamaño dos ficheiros"

#: fsview/fsview_part.desktop:49
msgctxt "Comment"
msgid "Enables a proportional view of directories and files based on file size"
msgstr ""
"Activa unha vista proporcional dos cartafoles e ficheiros baseada no tamaño"

