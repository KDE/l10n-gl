msgctxt "Name"
msgid "DOM Tree Viewer"
msgstr "Visor da árbore DOM"

#: domtreeviewer/plugin_domtreeviewer.desktop:60
msgctxt "Comment"
msgid "View the DOM tree of the current page"
msgstr "Mostra a árbore DOM da páxina actual"

