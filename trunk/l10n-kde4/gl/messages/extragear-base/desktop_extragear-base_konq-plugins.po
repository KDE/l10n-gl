msgctxt "Name"
msgid "File Size Viewer"
msgstr "Visor do tamaño dos ficheiros"

#: fsview/fsview.desktop:56
msgctxt "Comment"
msgid "View your filesystem as a TreeMap"
msgstr "Mostra o sistema de ficheiros como unha árbore-mapa"

