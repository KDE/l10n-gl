#: adblock/plugin_adblock.desktop:2
msgctxt "Name"
msgid "Adblock"
msgstr "Adblock"

#: adblock/plugin_adblock.desktop:37
msgctxt "Comment"
msgid "Show all blockable html elements"
msgstr "Mostra todos os elementos html bloqueábeis"

#: akregator/akregator_konqfeedicon.desktop:2
msgctxt "Name"
msgid "Konqueror Feed Icon"
msgstr "Icona de RSS de Konqueror"

#: akregator/akregator_konqfeedicon.desktop:49
msgctxt "Comment"
msgid "Displays an icon in the status bar if the page contains a feed"
msgstr "Mostra unha icona na barra de estado se a páxina contén unha fonte"

#: akregator/akregator_konqplugin.desktop:4
msgctxt "Name"
msgid "Add Feed to Akregator"
msgstr "Engadir a fonte a Akregator"

