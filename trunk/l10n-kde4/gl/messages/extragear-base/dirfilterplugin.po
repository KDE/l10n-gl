#: dirfilterplugin.cpp:138
msgid "View F&ilter"
msgstr "Ver o f&iltro"

#: dirfilterplugin.cpp:142
msgid "Allow to filter the currently displayed items by filetype."
msgstr ""
"Permite filtrar os ítens que se están a mostrar, segundo o tipo de ficheiro."

#: dirfilterplugin.cpp:161
msgid "Clear Filter Field"
msgstr "Borrar o campo do filtro"

#: dirfilterplugin.cpp:163
msgid "Clear filter field<p>Clears the content of the filter field.</p>"
msgstr "Limpar o campo do filtro<p>Limpa o contido do campo do filtro.</p>"

#: dirfilterplugin.cpp:181
msgid ""
"Enter here a text which an item in the view must contain anywhere to be "
"shown."
msgstr ""
"Introduza aquí o texto que debe conter un elemento na vista para ser "
"mostrado."

#: dirfilterplugin.cpp:187
msgid "Filter Field"
msgstr "Campo do filtro"

#: dirfilterplugin.cpp:227
msgid "Only Show Items of Type"
msgstr "Mostrar só os itens do tipo"

#: dirfilterplugin.cpp:288
msgid "Use Multiple Filters"
msgstr "Usar múltiples filtros"

#: dirfilterplugin.cpp:293
msgid "Show Count"
msgstr "Mostrar a conta"

#: dirfilterplugin.cpp:297
msgid "Reset"
msgstr "Reiniciar"

