#: main.cpp:52
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"O xestor de sesións de KDE que conversa co protocolo estándar de\n"
"X11R6 para xestión de sesións (XSMP)."

#: main.cpp:240
msgid "The KDE Session Manager"
msgstr "O xestor de sesións de KDE"

#: main.cpp:242
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, Os desenvolvente de KDE"

#: main.cpp:243
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#: main.cpp:244
msgid "Luboš Luňák"
msgstr "Luboš Luňák"

#: main.cpp:244
msgid "Maintainer"
msgstr "Mantenedor"

#: main.cpp:252
msgid "Restores the saved user session if available"
msgstr "Restaura a sesión de usuario gardada se está disponíbel"

#: main.cpp:254
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Executa \"wm\" no caso de que non haxa nengún outro\n"
"xestor de fiestras presente na sesión. Por omisión é \"kwin\""

#: main.cpp:255
msgid "Also allow remote connections"
msgstr "Permitir tamén conexóns remotas"

