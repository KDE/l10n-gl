#: kwritemain.cpp:285
msgid ""
"The given file could not be read, check if it exists or if it is readable "
"for the current user."
msgstr ""
"Non foi posíbel ler o ficheiro, verifique que exista e que sexa lexíbel polo "
"usuario actual."

