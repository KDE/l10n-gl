#: kwritemain.cpp:72 kwritemain.cpp:487
msgid ""
"A KDE text-editor component could not be found;\n"
"please check your KDE installation."
msgstr ""
"Non foi posíbel atopar unha compoñente de KDE para a edición de textos;\n"
"verifique a súa instalación de KDE."

#: kwritemain.cpp:153
msgid "Use this to close the current document"
msgstr "Use isto para pechar o documento actual"

#: kwritemain.cpp:157
msgid "Use this command to create a new document"
msgstr "Use este comando para criar un documento novo"

#: kwritemain.cpp:159
msgid "Use this command to open an existing document for editing"
msgstr "Use este comando para abrir e editar un documento xa existente"

#: kwritemain.cpp:163
msgid ""
"This lists files which you have opened recently, and allows you to easily "
"open them again."
msgstr ""
"Isto lista ficheiros que abriu recentemente, e permítelle abrilos doadamente "
"de novo."

#: kwritemain.cpp:167
msgid "&New Window"
msgstr "Nova &fiestra"

#: kwritemain.cpp:169
msgid "Create another view containing the current document"
msgstr "Cría outra vista que contén o documento actual"

#: kwritemain.cpp:172
msgid "Close the current document view"
msgstr "Pecha a vista actual do documento"

#: kwritemain.cpp:179
msgid "Use this command to show or hide the view's statusbar"
msgstr ""
"Empregue este comando para mostrar ou acochar a barra de estado da vista"

#: kwritemain.cpp:181
msgid "Sho&w Path"
msgstr "M&ostrar a rota"

#: kwritemain.cpp:184
msgid "Show the complete document path in the window caption"
msgstr "Mostra a rota completa do documento no título da fiestra"

#: kwritemain.cpp:187
msgid "Configure the application's keyboard shortcut assignments."
msgstr "Configura as asignacións de atallos de teclado do programa."

#: kwritemain.cpp:191
msgid "Configure which items should appear in the toolbar(s)."
msgstr ""
"Configura os ítems que deberían aparecer na(s) barra(s) de ferramentas."

#: kwritemain.cpp:194
msgid "&About Editor Component"
msgstr "&Acerca da compoñente de edición"

