msgid "Invalid bug report: corrupted data"
msgstr "Informe de erro non válido: os datos están corrompidos"

#: bugzillalib.cpp:294
msgctxt "@info"
msgid "Invalid bug list: corrupted data"
msgstr "Lista de erros non válida: os datos están corrompidos"

