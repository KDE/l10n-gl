#: rc.cpp:90 rc.cpp:98 rc.cpp:103
msgid ""
"<qt>\n"
"The shortcuts entered here can be used as a pseudo-URI scheme in KDE. For "
"example, the shortcut <b>av</b> can be used as in <b>av</b>:<b>my search</"
"b>\n"
"</qt>"
msgstr ""
"<qt>Os atallos que introduza aquí poden ser usados como un pseudo-URI en "
"KDE. Por exemplo, o atallo <b>av</b> pode ser usado en <b>av</b>:<b>a miña "
"pescuda</b></qt>"

