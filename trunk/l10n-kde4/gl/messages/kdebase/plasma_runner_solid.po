#: devicewrapper.cpp:125
msgid "Mount the device"
msgstr "Montar o dispositivo"

#: devicewrapper.cpp:127
msgid "Unmount the device"
msgstr "Desmontar o dispositivo"

#: devicewrapper.cpp:130
msgid "Eject medium"
msgstr "Expulsar o medio"

#: devicewrapper.cpp:213
msgid ""
"Could not unmount the device.\n"
"One or more files on this device are open within an application."
msgstr ""
"Non é posíbel desmontar o dispositivo.\n"
"Algún programa ten aberto polo menos un ficheiro deste dispositivo."

#: devicewrapper.cpp:218
msgid ""
"Could not eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""
"Non é posíbel expulsar o disco.\n"
"Algún programa ten aberto polo menos un ficheiro desde disco."

#: devicewrapper.cpp:223
msgid "Could not mount the disc."
msgstr "Non foi posíbel montar o disco."

#: solidrunner.cpp:48
msgid "Finds devices whose name match :q:"
msgstr "Acha dispositivos que teñan un nome que case con :q:"

#: solidrunner.cpp:50 solidrunner.cpp:131
msgctxt "Note this is a KRunner keyword"
msgid "device"
msgstr "dispositivo"

#: solidrunner.cpp:51
msgid "Lists all devices and allows them to be mounted, unmounted or ejected."
msgstr ""
"Lista todos os dispositivos e permite montalos, desmontalos ou expulsalos."

#: solidrunner.cpp:52 solidrunner.cpp:137
msgctxt "Note this is a KRunner keyword"
msgid "mount"
msgstr "montar"

#: solidrunner.cpp:53
msgid "Lists all devices which can be mounted, and allows them to be mounted."
msgstr ""
"Lista todos os dispositivos que se podan montar, e permite desmontalos."

#: solidrunner.cpp:54 solidrunner.cpp:141
msgctxt "Note this is a KRunner keyword"
msgid "unmount"
msgstr "desmontar"

#: solidrunner.cpp:55
msgid ""
"Lists all devices which can be unmounted, and allows them to be unmounted."
msgstr ""
"Lista todos os dispositivos que se podan desmontar e permite desmontalos."

#: solidrunner.cpp:56
msgctxt "Note this is a KRunner keyword"
msgid "eject"
msgstr "expulsar"

#: solidrunner.cpp:57
msgid "Lists all devices which can be ejected, and allows them to be ejected."
msgstr "Lista todos os dispositivos que se podan expulsar e permite facelo."

