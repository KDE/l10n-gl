#: solid-network.cpp:311
msgid "             # List the network devices present.\n"
msgstr "             # Lista os dispositivos de rede presentes.\n"

#: solid-network.cpp:314
msgid ""
"             # List the networks known to the device specified by 'uni'.\n"
msgstr ""
"             # Lista as redes coñecidas polo dispositivo especificado por "
"\"uni\".\n"

#: solid-network.cpp:317
msgid ""
"             # Query whether networking features are active or not.\n"
"             # - If the 'status' option is given, return whether\n"
"             # networking is enabled for the system\n"
"             # - If the 'wireless' option is is given, return whether\n"
"             # wireless is enabled for the system\n"
"             # - If the 'interface' option is given, print the\n"
"             # properties of the network interface that 'uni' refers to.\n"
"             # - If the 'network' option is given, print the\n"
"             # properties of the network on 'device-uni' that 'network-uni' "
"refers to.\n"
msgstr ""
"             # Pesquisa se as funcións de rede están activas ou non.\n"
"             # - Se especifica a opción \"status\", devolve se está\n"
"             # habilitada a rede no sistema\n"
"             # - Se especifica a opción \"wireless\", devolve se está\n"
"             # habilitada a rede wireless no sistema\n"
"             # - Se especifica a opción \"interface\", imprime as\n"
"             # propriedades da interfade de rede á que se refere \"uni\".\n"
"             # - Se especifica a opción \"network\", imprime as\n"
"             # propriedades da rede en \"device-uni\" á que se refere "
"\"network-uni\".\n"

#: solid-network.cpp:328 solid-network.cpp:331
msgid "             # Enable or disable networking on this system.\n"
msgstr "             # Habilita ou deshabilita a rede neste sistema.\n"

#: solid-network.cpp:334
msgid ""
"             # Activate the network 'network-uni' on 'device-uni'.\n"
"             # Optionally, use WEP128, open-system encryption with hex key "
"'key'. (Hardcoded)\n"
"             # Where 'authentication' is one of:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgstr ""
"             # Activa a rede \"network-uni\" en \"device-uni\".\n"
"             # Opcionalmente, usa WEP128, cifraxe de sistema aberto coa "
"chave hexadecimal \"key\". (No código)              # Onde \"autenticación\" "
"é unha de:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"\"chave\" [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes contrasinal\n"
"             # wpaeap NON IMPLEMENTADA EN SOLIDSHELL\n"

