#: main.cpp:42
msgid "Install, list, remove Plasma packages"
msgstr "Instala, enumera e elimina paquetes de Plasma"

#: main.cpp:77
msgid "Plasma Package Manager"
msgstr "Xestor de paquetes de Plasma"

#: main.cpp:79
msgid "(C) 2008, Aaron Seigo"
msgstr "(C) 2008, Aaron Seigo"

#: main.cpp:80
msgid "Aaron Seigo"
msgstr "Aaron Seigo"

#: main.cpp:81
msgid "Original author"
msgstr "Autor orixinal"

#: main.cpp:90
msgid "For install or remove, operates on packages installed for all users."
msgstr ""
"Para instalar ou eliminar, opera en paquetes instalados para todos os "
"usuarios."

#: main.cpp:96
msgctxt ""
"theme, wallpaper, etc. are keywords, but they may be translated, as both "
"versions are recognized by the application (if translated, should be same as "
"messages with 'package type' context below)"
msgid ""
"The type of package, e.g. theme, wallpaper, plasmoid, dataengine, runner, "
"etc."
msgstr ""
"O tipo do paquete, por ex. tema, fondo de escritorio, plasmoide, motor de "
"dados, executor etc."

#: main.cpp:100
msgctxt "Do not translate <path>"
msgid "Install the package at <path>"
msgstr "Instalar o paquete en <path>"

#: main.cpp:102
msgctxt "Do not translate <path>"
msgid "Upgrade the package at <path>"
msgstr "Actualizar o paquete en <path>"

#: main.cpp:104
msgid "List installed packages"
msgstr "Listar os paquetes instalados"

#: main.cpp:106
msgctxt "Do not translate <name>"
msgid "Remove the package named <name>"
msgstr "Eliminar o paquete chamado <name>"

#: main.cpp:108
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this KDE session will be searched instead."
msgstr ""
"A rota absoluta á raíz do paquete. Se non se indica, entón procurarase nos "
"directorios estándar para datos desta sesión de KDE."

#: main.cpp:120
msgctxt "package type"
msgid "plasmoid"
msgstr "plasmoide"

#: main.cpp:124
msgctxt "package type"
msgid "theme"
msgstr "tema"

#: main.cpp:126
msgctxt "package type"
msgid "wallpaper"
msgstr "fondo de escritorio"

#: main.cpp:128
msgctxt "package type"
msgid "dataengine"
msgstr "motor de datos"

#: main.cpp:132
msgctxt "package type"
msgid "runner"
msgstr "executor"

#: main.cpp:140
#, kde-format
msgid "Could not find a suitable installer for package of type %1"
msgstr ""
"Non foi posíbel achar un instalador apropriado para o tipo do paquete %1"

#: main.cpp:149
#, kde-format
msgid "Could not load installer for package of type %1. Error reported was: %2"
msgstr ""
"Non foi posíbel achar un instalador apropriado para o paquete do tipo %1. "
"Informouse do erro: %2"

#: main.cpp:205
#, kde-format
msgid "Successfully removed %1"
msgstr "Eliminouse satisfactoriamente %1"

#: main.cpp:207
#, kde-format
msgid "Removal of %1 failed."
msgstr "A eliminación de %1 fallou."

#: main.cpp:212
#, kde-format
msgid "Plugin %1 is not installed."
msgstr "A extensión %1 non está instalada."

#: main.cpp:217
#, kde-format
msgid "Successfully installed %1"
msgstr "Instalouse satisfactoriamente %1"

#: main.cpp:219
#, kde-format
msgid "Installation of %1 failed."
msgstr "A instalación de %1 fallou."

#: main.cpp:225
msgctxt ""
"No option was given, this is the error message telling the user he needs at "
"least one, do not translate install, remove, upgrade nor list"
msgid "One of install, remove, upgrade or list is required."
msgstr "Requírese unha de install, remove, upgrade ou list."

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Marce Villarino"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "mvillarino@users.sourceforge.net"
