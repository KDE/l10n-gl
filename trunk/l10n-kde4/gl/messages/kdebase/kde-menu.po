#: kde-menu.cpp:92
msgid "Menu item '%1' could not be highlighted."
msgstr "Non foi posíbel realzar o ítem \"%1\" do menú."

#: kde-menu.cpp:104
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""
"Ferramenta de pesquisa no menú de KDE.\n"
"Esta ferramenta pode ser usada para procurar o menú non que se mostrar un "
"programa específico.\n"
"A opción --highlight pode ser usada para indicarlle visualmente ao\n"
"usuario onde está un programa específico no menú de KDE."

#: kde-menu.cpp:109
msgid "kde-menu"
msgstr "kde-menu"

#: kde-menu.cpp:111
msgid "(c) 2003 Waldo Bastian"
msgstr "(c) 2003 Waldo Bastian"

#: kde-menu.cpp:112
msgid "Waldo Bastian"
msgstr "Waldo Bastian"

#: kde-menu.cpp:112
msgid "Author"
msgstr "Autor"

#: kde-menu.cpp:117
msgid "Output data in UTF-8 instead of local encoding"
msgstr "Sacar os dados en UTF-8 no cando de na codificación local"

#: kde-menu.cpp:118
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr "Imprimir a id do menú que contén ao programa"

#: kde-menu.cpp:119
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr "Imprimir o no nome do menú (título) que contén o programa"

#: kde-menu.cpp:120
msgid "Highlight the entry in the menu"
msgstr "Realzar a entrada no menú"

#: kde-menu.cpp:121
msgid "Do not check if sycoca database is up to date"
msgstr "Non comprobar se a base de dados sycoca está actualizada"

#: kde-menu.cpp:122
msgid "The id of the menu entry to locate"
msgstr "A id da entrada de menú a localizar"

#: kde-menu.cpp:131
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr "Debe especificar unha id de programa como \"kde4-console.desktop\""

#: kde-menu.cpp:140
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr ""
"Debe especificar polo menos unha entre --print-menu-id, --print-menu-name ou "
"--highlight"

#: kde-menu.cpp:162
msgid "No menu item '%1'."
msgstr "Non existe o ítem de menú \"%1\"."

#: kde-menu.cpp:166
msgid "Menu item '%1' not found in menu."
msgstr "O ítem de menú \"%1\" non foi atopado no menú."

