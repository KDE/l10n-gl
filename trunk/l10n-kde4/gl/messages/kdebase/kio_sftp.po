#: kio_sftp.cpp:432
msgid "An internal error occurred. Please retry the request again."
msgstr "Aconteceu un erro interno. Por favor, tente de novo o pedido."

#: kio_sftp.cpp:514
#, kde-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "A abrir unha conexión SFTP co servidor %1:%2"

#: kio_sftp.cpp:518
msgid "No hostname specified"
msgstr "Non se especificou o servidor"

#: kio_sftp.cpp:529
msgid "SFTP Login"
msgstr "Iniciar unha sesión SFTP"

#: kio_sftp.cpp:531
msgid "site:"
msgstr "sitio:"

#: kio_sftp.cpp:631
msgid "Please enter your username and key passphrase."
msgstr "Escriba o seu nome de usuario e o contrasinal."

#: kio_sftp.cpp:633
msgid "Please enter your username and password."
msgstr "Escriba o seu nome de usuario e o contrasinal."

#: kio_sftp.cpp:641
msgid "Incorrect username or password"
msgstr "O nome de usuario ou o contrasinal é incorrecto"

#: kio_sftp.cpp:698
msgid "Warning: Cannot verify host's identity."
msgstr "Aviso: Non se pode verificar a identidade do servidor."

#: kio_sftp.cpp:709
msgid "Warning: Host's identity changed."
msgstr "Aviso: Mudou a identidade do servidor."

#: kio_sftp.cpp:720 kio_sftp.cpp:721
msgid "Authentication failed."
msgstr "Fallou a autenticación."

#: kio_sftp.cpp:735 kio_sftp.cpp:753
msgid "Connection failed."
msgstr "Fallou a conexión."

#: kio_sftp.cpp:736 ksshprocess.cpp:833 ksshprocess.cpp:977
msgid "Connection closed by remote host."
msgstr "O servidor remoto pechou a conexión."

#: kio_sftp.cpp:755
#, kde-format
#| msgid "Unexpected SFTP error: %1"
msgid "unexpected SFTP error: %1"
msgstr "Aconteceu un erro de SFTP non agardado: %1"

#: kio_sftp.cpp:802
#, kde-format
msgid "SFTP version %1"
msgstr "Versión %1 de SFTP"

#: kio_sftp.cpp:808
msgid "Protocol error."
msgstr "Erro do protocolo."

#: kio_sftp.cpp:814
#, kde-format
msgid "Successfully connected to %1"
msgstr "Conectou con éxito con %1"

#: kio_sftp.cpp:1172
msgid "An internal error occurred. Please try again."
msgstr "Aconteceu un erro interno. Por favor, ténteo de novo."

#: kio_sftp.cpp:1193
#, kde-format
msgid ""
"Unknown error was encountered while copying the file to '%1'. Please try "
"again."
msgstr ""
"Atopouse un erro descoñecido mentres se copiaba o ficheiro para «%1». Por "
"favor, ténteo de novo."

#: kio_sftp.cpp:1411
msgid "The remote host does not support renaming files."
msgstr "O servidor remoto non permite mudar o nome dos ficheiros."

#: kio_sftp.cpp:1460
msgid "The remote host does not support creating symbolic links."
msgstr "A máquina remota non permite crear ligazóns simbólicas."

#: kio_sftp.cpp:1594
msgid "Connection closed"
msgstr "Pechouse a conexión"

#: kio_sftp.cpp:1596
msgid "Could not read SFTP packet"
msgstr "Non foi posíbel ler o paquete SFTP"

#: kio_sftp.cpp:1708
msgid "End of file."
msgstr "Final do ficheiro."

#: kio_sftp.cpp:1717
msgid "SFTP command failed for an unknown reason."
msgstr "A orde SFTP fallou por causas descoñecidas."

#: kio_sftp.cpp:1721
msgid "The SFTP server received a bad message."
msgstr "O servidor SFTP recibiu unha mensaxe non válida."

#: kio_sftp.cpp:1725
msgid "You attempted an operation unsupported by the SFTP server."
msgstr "Tentou realizar unha operación non soportada polo servidor SFTP."

#: kio_sftp.cpp:1729
#, kde-format
msgid "Error code: %1"
msgstr "Código do erro: %1"

#: ksshprocess.cpp:449
msgid "Cannot specify a subsystem and command at the same time."
msgstr "Non se pode especificar á vez un subsistema e unha orde."

#: ksshprocess.cpp:770
msgid "No options provided for ssh execution."
msgstr "Non se indicou ningunha opción para a execución do ssh."

#: ksshprocess.cpp:777
msgid "Failed to execute ssh process."
msgstr "Non se conseguiu executar o proceso ssh."

#: ksshprocess.cpp:801 ksshprocess.cpp:828 ksshprocess.cpp:944
#: ksshprocess.cpp:1015
msgid "Error encountered while talking to ssh."
msgstr "Atopouse un erro durante a comunicación con ssh."

#: ksshprocess.cpp:878
msgid "Please supply a password."
msgstr "Por favor introduza un contrasinal."

#: ksshprocess.cpp:916
msgid "Please supply the passphrase for your SSH private key."
msgstr "Introduza o contrasinal da súa chave privada SSH."

#: ksshprocess.cpp:930
#, kde-format
msgid "Authentication to %1 failed"
msgstr "Non se conseguiu autenticar en %1"

#: ksshprocess.cpp:952
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified because the "
"host's key is not in the \"known hosts\" file."
msgstr ""
"Non foi posíbel verificar a identidade do servidor remoto «%1» porque a chave "
"do servidor non está no ficheiro dos «servidores coñecidos»."

#: ksshprocess.cpp:958
msgid ""
" Manually, add the host's key to the \"known hosts\" file or contact your "
"administrator."
msgstr ""
"Engada manualmente a chave da máquina ao ficheiro de servidores coñecidos ou "
"contacte co seu administrador."

#: ksshprocess.cpp:964
#, kde-format
msgid " Manually, add the host's key to %1 or contact your administrator."
msgstr ""
"Engada manualmente a chave do servidor en %1 ou contacte co seu "
"administrador."

#: ksshprocess.cpp:996
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified. The host's key "
"fingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator before "
"connecting.\n"
"\n"
"Would you like to accept the host's key and connect anyway? "
msgstr ""
"Non foi posíbel verificar a identidade do servidor remoto «%1». A pegada "
"dixital da chave do servidor é:\n"
"%2\n"
"Debería verificar a pegada co administrador do servidor antes de "
"conectarse.\n"
"\n"
"Desexa aceptar a chave do servidor e conectarse aínda así? "

#: ksshprocess.cpp:1023
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator. The key fingerprint is:\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."
msgstr ""
"AVISO: A identidade do servidor remoto «%1» cambiou!\n"
"\n"
"Alguén pode estar a interceptar a conexión, ou poida que simplemente o "
"administrador cambiase a chave do servidor. De calquera xeito verifique a "
"pegada dixital da chave do servidor co administrador. A pegada dixital da "
"chave é:\n"
"%2\n"
"Engada a chave correcta do servidor a «%3» para desfacerse desta mensaxe."

#: ksshprocess.cpp:1058
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator before connecting. The key "
"fingerprint is:\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"
msgstr ""
"AVISO: A identidade do servidor remoto «%1» cambiou!\n"
"\n"
"Alguén pode estar a interceptar a conexión, ou poida que simplemente o "
"administrador cambiase a chave do servidor. De calquera xeito verifique a "
"pegada dixital da chave do servidor co administrador antes de conectarse. A "
"pegada dixital da chave é:\n"
"%2\n"
"\n"
"Desexa aceptar a nova chave do servidor e conectarse aínda así?"

#: ksshprocess.cpp:1080
msgid "Host key was rejected."
msgstr "Rexeitouse a chave da máquina."

#~ msgid "Please enter a username and password"
#~ msgstr "Escreba un nome de usuario e contrasinal"

