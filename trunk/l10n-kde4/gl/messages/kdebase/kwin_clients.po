msgstr ""
"Debuxar un separador entre a barra de título e o contido da fiestra activa"

#: oxygen/config/oxygenconfigurationui.cpp:183
#| msgid ""
#| "When enabled, this option increases the visibility of the window titlebar "
#| "by showing stripes"
msgid ""
"When enabled, this option makes an horizontal separator appear between the "
"window title bar and the window contents."
msgstr ""
"Se escolle esta opción mostrarase un separador horizontal entre a barra de "
"título e o contido da fiestra"

