#: notifierdialog.cpp:1033
msgid "Available Devices"
msgstr "Dispositivos dispoñíbel"

#: notifierdialog.cpp:1035
msgid "No Devices Available"
msgstr "Non hai ningún dispositivo dispoñíbel"

