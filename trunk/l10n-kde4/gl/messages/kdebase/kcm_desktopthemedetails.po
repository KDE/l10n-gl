#: desktopthemedetails.cpp:431
#, kde-format
msgid ""
"To change your desktop theme to \"%1\", open\n"
"Desktop Settings and select \"%2\" from the droplist."
msgstr ""
"Para trocar o tema do escritorio a \"%1\", abra\n"
"Configuración do escritorio e escolla \"%2\" na lista despregábel."

