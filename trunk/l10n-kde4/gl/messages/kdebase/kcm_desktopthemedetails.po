#: desktopthemedetails.cpp:450
msgid "Remove Desktop Theme"
msgstr "Eliminar o tema do escritorio"

#: desktopthemedetails.cpp:447
msgid "Removal of the default KDE theme is not allowed."
msgstr "Non se permite eliminar o tema predeterminado de KDE."

#: desktopthemedetails.cpp:450
#, kde-format
msgid "Are you sure you wish remove the \"%1\" theme?"
msgstr "Desexa realmente eliminar o tema \"%1\"?"

