msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # methods supported by the system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policies\n"
msgstr ""
"             # Lista un conxunto particular de información referente á "
"xestión da enerxía.\n"
"             # - De especificar a opción «suspend», dá a lista de métodos de "
"suspensión\n"
"             # soportados polo sistema\n"
"             # - De especificar a opción «scheme», dá a lista de\n"
"             # esquemas de xestión de enerxía soportados por este sistema\n"
"             # - De especificar a opción «cpufreq», dá a lista de políticas\n"
"             # soportadas de frecuencia da CPU\n"

#: solid-powermanagement.cpp:207
#, fuzzy
#| msgid ""
#| "             # Set power management options of the system.\n"
#| "             # - If the 'scheme' option is specified, the power "
#| "management\n"
#| "             # scheme set corresponds to 'value'\n"
#| "             # - If the 'cpufreq' option is specified, the CPU frequency "
#| "policy\n"
#| "             # set corresponds to 'value'\n"
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # Estabelece as opcións de xestión de enerxía do sistema.\n"
"             # - De especificar a opción «scheme», o esquema de xestión\n"
"             # da enerxía corresponde a «valor»\n"
"             # - De especificar a opción «cpufreq», a política de frecuencia "
"da CPU\n"
"             # corresponderá a «valor»\n"

#: solid-powermanagement.cpp:212
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # Suspende o ordenador empregando o «método» dado.\n"

#: solid-powermanagement.cpp:215
msgid ""
"             # Set and get brightness options of the system.\n"
"             # - If the 'set' option is specified, the brightness is\n"
"             # set to 'value' (as a percentage)\n"
"             # - If the 'get' option is specified, the current brightness\n"
"             # is returned (as a percentage)'\n"
msgstr ""
"             # Le e modifica a opción de brillo do sistema.\n"
"             # - De especificar a opción «set», o brillo axústase co\n"
"             # «valor» (en porcentaxe)\n"
"             # - De especificar a opción «get», devolverase o brillo\n"
"             # actual (como porcentaxe)\n"

