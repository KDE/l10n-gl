#: kwriteconfig.cpp:21
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:23
msgid "Write KConfig entries - for use in shell scripts"
msgstr "Escribe entradas KConfig - para uso en guións da shell"

#: kwriteconfig.cpp:25
msgid "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"
msgstr "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"

#: kwriteconfig.cpp:26
msgid "Luís Pedro Coelho"
msgstr "Luís Pedro Coelho"

#: kwriteconfig.cpp:27
msgid "Bernhard Rosenkraenzer"
msgstr "Bernhard Rosenkraenzer"

#: kwriteconfig.cpp:27
msgid "Wrote kreadconfig on which this is based"
msgstr "Escrebiu kreadconfig no que non baseamos para este programa"

#: kwriteconfig.cpp:31
msgid "Use <file> instead of global config"
msgstr "Usar <ficheiro> en troques da configuración global"

#: kwriteconfig.cpp:32
msgid "Group to look in. Use repeatedly for nested groups."
msgstr "O grupo no que procurar. Empregueo repetidamente para grupos aniñados."

#: kwriteconfig.cpp:33
msgid "Key to look for"
msgstr "A chave a procurar"

#: kwriteconfig.cpp:34
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"Tipo da variábel. Use \"bool\" para un booleano, se non, é tratado como unha "
"cadea"

#: kwriteconfig.cpp:35
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr "O valor a escribir. Obrigatorio usar '' nunha shell para nulo"
