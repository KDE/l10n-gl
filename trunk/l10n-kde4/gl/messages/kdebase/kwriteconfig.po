#: kwriteconfig.cpp:21
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:23
msgid "Write KConfig entries - for use in shell scripts"
msgstr "Escribe entradas KConfig, para uso en scripts da shell"

#: kwriteconfig.cpp:25
msgid "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"
