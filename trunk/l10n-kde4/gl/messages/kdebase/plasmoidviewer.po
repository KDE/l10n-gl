#: main.cpp:39
msgid "Run Plasma applets in their own window"
msgstr "Executa applets de Plasma nunha fiestra de seu"

#: main.cpp:44
msgid "Plasma Applet Viewer"
msgstr "Visor de applets de Plasma"

#: main.cpp:46
msgid "(C) 2007, The KDE Team"
msgstr "(C) 2007, A equipa de KDE"

#: main.cpp:48
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:49
msgid "Original author"
msgstr "Autor orixinal"

#: main.cpp:56
msgid "The formfactor to use (horizontal, vertical, mediacenter or planar)"
msgstr "As proporcións a empregar (horizontal, vertical, centrado ou chao)"

#: main.cpp:58
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right)"
msgstr ""
"A restrición de posición coa que iniciar o contedor (flutuante, escritorio, "
"pantalla completa, cume, fondal, esquerda, dereita)"

#: main.cpp:60
msgid "The size in KB to set the pixmap cache to"
msgstr "O tamaño en KB da caché do mapa de píxeles"

#: main.cpp:61
msgid "Name of applet to add (required)"
msgstr "O nome da applet a engadir (requerido)"

#: main.cpp:62
msgid "Optional arguments of the applet to add"
msgstr "Argumentos opcionais da applet a engadir"

#: main.cpp:69
msgid "No applet name specified"
msgstr "Non indicou nengún nome de applet"

