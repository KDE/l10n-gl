#: main.cpp:48
msgid "Run Plasma widgets in their own window"
msgstr "Executa widgets de Plasma nunha fiestra de seu"

#: main.cpp:83
msgid "Plasma Widget Viewer"
msgstr "Visor de widgets de Plasma"

#: main.cpp:85
msgid "2007-2008, Frerich Raabe"
msgstr "2007-2008, Frerich Raabe"

#: main.cpp:87
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:88
msgid "Original author"
msgstr "Autor orixinal"

#: main.cpp:95
msgid "Name of the containment plugin"
msgstr "O nome da extensión continente"

#: main.cpp:97
msgctxt "Do not translate horizontal, vertical, mediacenter nor planar"
msgid "The formfactor to use (horizontal, vertical, mediacenter or planar)"
msgstr ""
"As proporcións a empregar (horizontal, vertical, mediacenter ou planar)"

#: main.cpp:98
msgid "Displays a list of known applets"
msgstr "Mostra unha lista de applets coñecidas"

#: main.cpp:100
msgctxt ""
"Do not translate floating, desktop, fullscreen, top, bottom, left nor right"
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right)"
msgstr ""
"A restrición de posición coa que iniciar o contedor (floating, desktop, "
"fullscreen, top, bottom, left, right)"

#: main.cpp:102
msgid "The size in KB to set the pixmap cache to"
msgstr "O tamaño en KB da caché do mapa de píxeles"

#: main.cpp:104
msgid "Desktop SVG theme to use"
msgstr "O tema SVG de escritorio a empregar"

#: main.cpp:106
msgid "Name of the wallpaper plugin"
msgstr "O nome da extensión de fondo de escritorio"

#: main.cpp:107
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""
"O nome da applet a ver, pode referirse ao nome da extensión ou ser unha rota "
"(absoluta ou relativa) a un paquete. Se non se indica farase un intento de "
"cargar un paquete desde o directorio actual."

#: main.cpp:110
msgid "Optional arguments of the applet to add"
msgstr "Argumentos opcionais da applet a engadir"

#: main.cpp:111
msgid "List zeroconf announced remote widgets"
msgstr "Listar os widgets remotos anunciados en zeroconf"

#: main.cpp:135
msgid "No description available"
msgstr "Non se dispón de descrición"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Marce Villarino"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "mvillarino@users.sourceforge.net"

#~ msgid "Name of applet to add (required)"
#~ msgstr "O nome da applet a engadir (requirido)"

#~ msgid "No applet name specified"
#~ msgstr "Non indicou ningún nome de applet"
