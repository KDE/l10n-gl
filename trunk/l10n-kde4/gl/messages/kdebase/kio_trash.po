msgstr "(%1 %2)"

#: kcmtrash.cpp:264
msgid "Delete files older than:"
msgstr "Borrar os ficheiros máis vellos de:"

#: kcmtrash.cpp:275
msgid "Limit to maximum size"
msgstr "Limitar o tamaño máximo"

#: kcmtrash.cpp:286
msgid "Maximum size:"
msgstr "Tamaño máximo:"

#: kcmtrash.cpp:299
msgid "When limit reached:"
msgstr "Cando se acada o límite:"

#: kcmtrash.cpp:303
msgid "Warn Me"
msgstr "Avisarme"

#: kcmtrash.cpp:304
msgid "Delete Oldest Files From Trash"
