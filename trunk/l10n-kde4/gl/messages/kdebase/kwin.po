#~ "<qt><b>kompmgr cannot find the Xrender extension</b><br>You are using "
#~ "either an outdated or a crippled version of XOrg.<br>Get XOrg &ge; 6.8 "
#~ "from www.freedesktop.org.<br></qt>"
#~ msgstr ""
#~ "<qt><b>kompmgr non pode atopar a extensión Xrender</b> <br>Está a "
#~ "empregar ou unha versión desfasada ou unha versión modificada de XOrg. "
#~ "<br>Obteña XOrg &ge; 6.8 dende www.freedesktop.org.<br></qt>"

#~ msgid ""
#~ "<qt><b>Composite extension not found</b><br>You <i>must</i> use XOrg &ge; "
