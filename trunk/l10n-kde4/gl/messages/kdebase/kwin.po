#: activation.cpp:745
#, kde-format
msgid "Window '%1' demands attention."
msgstr "A fiestra «%1» demanda atención."

#: composite.cpp:292
#, kde-format
msgid ""
"Compositing has been suspended by another application.<br/>You can resume "
"using the '%1' shortcut."
msgstr ""

#: composite.cpp:535
msgid ""
"Compositing was too slow and has been suspended.\n"
"You can disable functionality checks in advanced compositing settings."
msgstr ""
"A composición era lenta de máis e foi suspendida.\n"
"Pode desactivar as comprobacións de funcionalidades na configuración "
"avanzada da composición."

#: composite.cpp:538
#, kde-format
msgid ""
"Compositing was too slow and has been suspended.\n"
"If this was only a temporary problem, you can resume using the '%1' "
"shortcut.\n"
"You can also disable functionality checks in advanced compositing settings."
msgstr ""
"A composición era lenta de máis e foi suspendida.\n"
"Se só foi un problema temporal, pode continuala mediante o atallo «%1».\n"
"Tamén pode desactivar as comprobacións de funcionalidades na configuración "
"avanzada da composición."

#: compositingprefs.cpp:87
msgid "Required X extensions (XComposite and XDamage) are not available."
msgstr ""
"Non están dispoñíbeis as extensións das X requiridas (XComposite e XDamage)."

#: compositingprefs.cpp:91
msgid "GLX/OpenGL are not available and only OpenGL support is compiled."
msgstr ""
"GLX/OpenGL non están dispoñíbeis e só ten compilado soporte para OpenGL."

#: compositingprefs.cpp:94
msgid ""
"XRender/XFixes extensions are not available and only XRender support is "
"compiled."
msgstr ""
"As extensións XRender/XFixes non están dispoñíbeis e só ten compilado "
"soporte para XRender."

#: compositingprefs.cpp:100
msgid "GLX/OpenGL and XRender/XFixes are not available."
msgstr "Non están dispoñíbeis GLX/OpenGL nin XRender/XFixes."

#: compositingprefs.cpp:105
msgid ""
"Compositing was disabled at compile time.\n"
"It is likely Xorg development headers were not installed."
msgstr ""
"A composición foi desactivado na compilación.\n"
"Posibelmente non fosen instaladas as cabeceiras de desenvolvemento de Xorg."

