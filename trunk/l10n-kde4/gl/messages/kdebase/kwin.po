#: activation.cpp:745
#, kde-format
msgid "Window '%1' demands attention."
msgstr "A fiestra \"%1\" demanda atención."

#: compositingprefs.cpp:88
msgid "Required X extensions (XComposite and XDamage) are not available."
msgstr ""
"Non están disponíbeis as extensións das X requeridas (XComposite e XDamage)."

#: compositingprefs.cpp:92
msgid "GLX/OpenGL are not available and only OpenGL support is compiled."
msgstr ""
"GLX/OpenGL non están disponíbeis e só ten compilado soporte para OpenGL."

#: compositingprefs.cpp:95
msgid ""
"XRender/XFixes extensions are not available and only XRender support is "
"compiled."
msgstr ""
"As extensións XRender/XFixes non están disponíbeis e só ten compilado "
"soporte para XRender."

#: compositingprefs.cpp:101
msgid "GLX/OpenGL and XRender/XFixes are not available."
msgstr "Non están disponíbeis GLX/OpenGL nen XRender/XFixes."

#: compositingprefs.cpp:106
msgid ""
"Compositing was disabled at compile time.\n"
"It is likely Xorg development headers were not installed."
msgstr ""
"A composición foi deshabilitado na compilación.\n"
"Posibelmente non fosen instaladas as cabeceiras de desenvolvimento de Xorg."

