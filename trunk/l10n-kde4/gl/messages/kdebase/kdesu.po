msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr ""
"Xabi García\n"
"Jesús Bravo"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr ""
