msgstr "Sebastian Trüg"

#: kcm/nepomukserverkcm.cpp:104
msgid "No Soprano Database backend available. Please check your installation."
msgstr ""
"Non hai disponíbel nengunha infraestrutura de base de datos de Soprano. "
"Verifique a instalación."

#: kcm/nepomukserverkcm.cpp:105
msgid "Nepomuk cannot be started"
msgstr "Non é posíbel inicial Nepomuk"

#: kcm/nepomukserverkcm.cpp:113
msgid ""
"The Nepomuk Server is not running. The settings will be used the next time "
"the server is started."
msgstr ""
"O servidor Nepomuk non se está a executar. A configuración será empregada a "
"vindeira vez que se inicie o servidor."

#: kcm/nepomukserverkcm.cpp:115 kcm/nepomukserverkcm.cpp:159
msgid "Nepomuk server not running"
msgstr "O servidor Nepomuk non se está a executar"

#: kcm/nepomukserverkcm.cpp:157
msgid ""
"The Nepomuk Server is not running. The settings have been saved and will be "
"used the next time the server is started."
msgstr ""
"O servidor Nepomuk non se está a executar. A configuración foi gardada e "
"será empregada a vindeira vez que se inicie o servidor."

