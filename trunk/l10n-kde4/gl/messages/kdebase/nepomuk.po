#: services/strigi/eventmonitor.cpp:83
msgid ""
"Strigi file indexing started. Indexing all files for fast desktop searches "
"may take a while."
msgstr ""
"Comezou a indexación de ficheiros de Strigi. Indexar todos os ficheiros para "
"facer procuras rápidas pode levar un tempo."

#: services/strigi/eventmonitor.cpp:121 services/strigi/eventmonitor.cpp:152
msgid "Resuming Strigi file indexing."
msgstr "A continuar a indexación de ficheiros con Strigi."

#: services/strigi/eventmonitor.cpp:128
msgid "Suspending Strigi file indexing to preserve resources."
msgstr ""
"A suspender a indexación de ficheiros con Strigi para conservar recursos."

#: services/strigi/eventmonitor.cpp:143
#, kde-format
msgid ""
"Local disk space is running low (%1 left). Suspending Strigi file indexing."
msgstr ""
"O espazo no disco local está a esgotarse (falta %1). Suspéndese a indexación "
"de ficheiros con Strigi."

#: services/strigi/eventmonitor.cpp:167
#, kde-format
msgid "Strigi file indexing finished. Elapsed time: %1"
msgstr "Rematou a indexación de ficheiros con Strigi. Tempo transcorrido: %1"

