#: desktop.cpp:66
msgid ""
"<h1>Multiple Desktops</h1>In this module, you can configure how many virtual "
"desktops you want and how these should be labeled."
msgstr ""
"<h1>Escritorios múltiplos</h1>Neste módulo pode configurar cantos "
"escritorios virtuais desexa ter e como deben ser chamados."

#: desktop.cpp:81
msgid "N&umber of desktops: "
msgstr "&Número de escritorios: "

#: desktop.cpp:87
msgid ""
"Here you can set how many virtual desktops you want on your KDE desktop. "
"Move the slider to change the value."
msgstr ""
"Aquí pode indicar cantos escritorios virtuais desexa ter no seu escritorio "
"KDE. Mova a barra deslizante para modificar o valor."

#: desktop.cpp:98
msgid "Desktop &Names"
msgstr "&Nomes dos escritorios"

#: desktop.cpp:104 desktop.cpp:108
msgid "Desktop %1:"
msgstr "Escritorio %1:"

#: desktop.cpp:112 desktop.cpp:113 desktop.cpp:114 desktop.cpp:115
msgid "Here you can enter the name for desktop %1"
msgstr "Aquí pode indicar o nome do escritorio %1"

#: desktop.cpp:130
msgid "Mouse wheel over desktop background switches desktop"
msgstr "A roda do rato sobre o fondo do escritorio cambia de escritorio"

#: desktop.cpp:250 desktop.cpp:270
msgid "Desktop %1"
msgstr "Escritorio %1"
