#: kxkb.cpp:384
msgid "A utility to switch keyboard maps"
msgstr "Unha utilidade para troca-lo mapa de teclado"

#: kxkb.cpp:388
msgid "KDE Keyboard Tool"
msgstr "Ferramenta de Teclado de KDE"

