#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 432
#: rc.cpp:104
msgid "Main shortcuts:"
msgstr "Atallos principais:"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 442
#: rc.cpp:107
msgid ""
"This is a shortcut for switching layouts which is handled by X.org. It "
"allows modifier-only shortcuts."
msgstr ""
"Este é un atallo xestionado por X.org para trocar as disposicións de "
"teclado. Só permite atallos con modificador."

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 459
#: rc.cpp:116
msgid "3rd level shortcuts:"
msgstr "Atallos de 3º nível:"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 469
#: rc.cpp:119
msgid ""
"This is a shortcut for switching to a third level of the active layout (if "
"it has one) which is handled by X.org. It allows modifier-only shortcuts."
msgstr ""
"Este é un atallo para mudar ao terceiro nivel da disposición activa (se hai "
"unha) que é xestionado por X.org. Só permite atallos con modificador."

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 486
#: rc.cpp:128
msgid "Alternative shortcut:"
msgstr "Atallo alternativo:"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 496
#: rc.cpp:131
msgid ""
"This is a shortcut for switching layouts which is handled by KDE. It does "
"not support modifier-only shortcuts and also may not work in some situations "
"(e.g. if popup is active or from screensaver)."
msgstr ""
"Este é un atallo xestionado por KDE para mudar a disposición de teclado. Non "
"soporta atallos só con modificador e tamén pode non funcionar nalgunhas "
"situacións (p.ex. se hai activa unha fiestra emerxente ou o protector de "
"pantalla)."

#. i18n: tag string
