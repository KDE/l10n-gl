msgid "VALUE(text)"
msgstr " VALUE(texto)"

#: functions/text.xml:537
msgid "VALUE(\"14.03\") returns 14.03"
msgstr " VALUE(\"14,03\") devolve 14,03"

#: functions/text.xml:545 functions/text.xml:574
