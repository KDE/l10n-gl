#: flake/odf/EncryptedStore.cpp:163 flake/odf/EncryptedStore.cpp:172
msgid ""
"The manifest file seems to be corrupted. The document could not be opened."
msgstr "O manifesto parece que está corrompido.O documento non se puido abrir."

#: flake/odf/EncryptedStore.cpp:230
msgid ""
"This document contains an unknown checksum. When you give a password it "
"might not be verified."
msgstr ""
"O documento conten unha comprobación de suma descoñecida. Cando lle dea un "
"contrasinal poida que non se verifique."

#: flake/odf/EncryptedStore.cpp:256 flake/odf/EncryptedStore.cpp:273
msgid ""
"This document contains an unknown encryption method. Some parts may be "
"unreadable."
msgstr ""
"O documento contén un modo de encriptamento descoñecido. Poida que algunhas "
"partes sexan ilexibles."

#: flake/odf/EncryptedStore.cpp:288
msgid ""
"This document contains incomplete encryption data. Some parts may be "
"unreadable."
msgstr ""
"Este documento contén información de encripción incompleta. Algunhas parte "
"poida que sexan ilexibles."

#: flake/odf/EncryptedStore.cpp:302
msgid ""
"QCA has currently no support for SHA1 or PBKDF2 using SHA1. The document can "
"not be opened."
msgstr ""
"QCA non ten soporte actualmente soporte para SHA1 ou PBKDF2 empregando SHA1. "
"Este documento non se pode abrir."

#: flake/odf/EncryptedStore.cpp:334
msgid ""
"The manifest file seems to be corrupted. It cannot be modified and the "
"document will remain unreadable. Please try and save the document again to "
"prevent losing your work."
msgstr ""
"O manifesto desta ficheiri parece que está corrupto. Non se pode modificar "
"polo que o ducumento quedará ilexible. Intente gravar o documento de novo "
"para evitar perdelos seus datos."

#: flake/odf/EncryptedStore.cpp:432
msgid ""
"The manifest file cannot be written. The document will remain unreadable. "
"Please try and save the document again to prevent losing your work."
msgstr ""
"O ficheiro de manifesto non se pode gravar. O documento quedará coma "
"ilexible. Intente gravar o ducumento de novo para evitar perde-lo seu "
"traballo. "

#: flake/odf/EncryptedStore.cpp:542
msgid "Please enter the password to open this file."
msgstr "Introduza o contrasinalpara abrir este ficheiro."

#: flake/odf/EncryptedStore.cpp:719
msgid "Please enter the password to encrypt the document with."
msgstr "Introduza o contrasinal co que encriptar este documento."

#: flake/odf/EncryptedStore.cpp:737
msgid "Do you want to save the password?"
msgstr "Desexa grada-lo contrasinal?"

