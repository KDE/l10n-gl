#: xml_doc.cpp:5588 xml_doc.cpp:5591 xml_doc.cpp:5594 xml_doc.cpp:5597
msgid "Floating point values or range of values"
msgstr "Número real ou rango de valores"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 688
#: xml_doc.cpp:5600
msgid ""
"The MEDIAN() function calculates the median of all the values given as "
"parameters. You can calculate the median of a range like MEDIAN(A1:B5) or a "
"list of values like MEDIAN(12; 5; 12.5). Blank cells will be considered as a "
"zero, and cells with text will be ignored."
msgstr ""
"A función MEDIAN() calcula a mediana de todos os valores pasados como "
"parámetros. Pode calcular a mediana dun intervalo, utilizando MEDIAN(A1:"
"B5),  ou dunha lista de valores, utilizando MEDIAN(12;5;12.5). As celas en "
"branco serán consideradas como cero, e as celas con texto serán ignoradas."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 689
#: xml_doc.cpp:5603
msgid "MEDIAN(value;value;...)"
msgstr "MEDIAN(valor;valor;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 690
#: xml_doc.cpp:5606
msgid "MEDIAN(12; 5; 5.5) equals 5.5"
msgstr "MEDIAN(12; 5; 5,5) é igual a 5,5"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 691
#: xml_doc.cpp:5609
msgid "MEDIAN(12; 7; 8;2) equals 7.5"
msgstr "MEDIAN(12; 7; 8;2) é igual a 7,5"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 699
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 703
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 707
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 711
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 906
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 910
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 914
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 918
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 934
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 938
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 942
#. i18n: tag Comment
