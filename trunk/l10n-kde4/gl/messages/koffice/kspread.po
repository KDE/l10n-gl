msgstr "LEVEL_COUPON(valor de face;taxa;anos) "

#. i18n: tag Example
#. i18n: file functions/financial.xml line 735
#: xml_doc.cpp:2583
msgid "LEVEL_COUPON(1000;.13;2;4;.1) equals 1096.95"
msgstr "LEVEL_COUPON(1000;0,13;2;4;0,1) é igual a 1096,95"

#. i18n: tag Text
