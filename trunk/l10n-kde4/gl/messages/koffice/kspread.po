#: xml_doc.cpp:4960
msgid "LOOKUP(1.232; A1:A6; B1:B6) for A1 = 1, A2 = 2 returns the value of B1."
msgstr "LOOKUP(1.232; A1:A6; B1:B6) para A1 = 1, A2 = 2 devolve o valor de B1."

