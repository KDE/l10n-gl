#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 829
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 979
#: xml_doc.cpp:5182 xml_doc.cpp:5197 xml_doc.cpp:5534 xml_doc.cpp:5732
#: xml_doc.cpp:5864
msgid "Cell range of values"
