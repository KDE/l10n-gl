#: xml_doc.cpp:5612 xml_doc.cpp:5615 xml_doc.cpp:5618 xml_doc.cpp:5621
#: xml_doc.cpp:5804 xml_doc.cpp:5807 xml_doc.cpp:5810 xml_doc.cpp:5813
#: xml_doc.cpp:5828 xml_doc.cpp:5831 xml_doc.cpp:5834 xml_doc.cpp:5837
msgid "Float"
msgstr "Real"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 715
#: xml_doc.cpp:5624
msgid ""
"The MODE() function returns the most frequently occuring value in the data "
"set."
msgstr ""
"A función MODE() devolve a moda dos datos, isto é, o valor que aparece con "
"máis frecuencia."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 716
#: xml_doc.cpp:5627
msgid "MODE(number; number2; ...)"
msgstr "MODE(número; número2; ...) "

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 717
#: xml_doc.cpp:5630
msgid "MODE(range)"
msgstr "MODE(rango)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 718
#: xml_doc.cpp:5633
msgid "MODE(12; 14; 12; 15) returns 12"
msgstr "MODE(12; 14; 12; 15) devolve 12"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 726
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1585
#: xml_doc.cpp:5636 xml_doc.cpp:6341
msgid "Number of failures"
msgstr "Número de fallos"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 730
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1544
#: xml_doc.cpp:5639 xml_doc.cpp:6305
msgid "Number of successful trials"
msgstr "Número de tentativas con éxito"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 734
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1548
#: xml_doc.cpp:5642 xml_doc.cpp:6308
msgid "Probability of success"
msgstr "Probabilidade de éxito"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 738
#: xml_doc.cpp:5645
msgid "The NEGBINOMDIST() function returns the negative binomial distribution."
msgstr "A función NEGBINOMDIST() devolve a distribuición binomial negativa."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 739
#: xml_doc.cpp:5648
msgid "NEGBINOMDIST(failures; success; prob_of_success)"
msgstr "NEGBINOMDIST(tentativas;acertos;probabilidade_de_acerto) "

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 740
#: xml_doc.cpp:5651
msgid "NEGBINOMDIST(2;5;0.55) returns 0.152872629"
msgstr "NEGBINOMDIST(2;5;0,55) devolve 0,152872629"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 752
#: xml_doc.cpp:5657
msgid "Linear middle of the distribution"
msgstr "Media linear da distribuición"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 756
#: xml_doc.cpp:5660
msgid "Standard deviation of the distribution"
msgstr "Desviación estándar da distribuición"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 764
#: xml_doc.cpp:5666
msgid "The NORMDIST() function returns the normal cumulative distribution."
msgstr "A función NORMDIST() devolve a distribuición normal acumulada."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 765
#: xml_doc.cpp:5669
msgid ""
"Number is the value of the distribution based on which the normal "
"distribution is to be calculated."
msgstr ""
"Número é o valor da distribuición con base no cal será calculada a "
"distribuición normal."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 766
#: xml_doc.cpp:5672
msgid "MV is the linear middle of the distribution."
msgstr "valorMedio é a media linear da distribuición."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 767
#: xml_doc.cpp:5675
msgid "STD is the standard deviation of the distribution."
msgstr "desviaciónEstandar é a desviación estándar da distribuición."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 768
#: xml_doc.cpp:5678
msgid ""
"K = 0 calculates the density function; K = 1 calculates the distribution."
msgstr "K = 0 calcula a función de densidade; K = 1 calcula a distribuición."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 769
#: xml_doc.cpp:5681
msgid "NORMDIST(Number;MV;STD;K)"
msgstr "NORMDIST(número;valorMedio;desviacionEstandar;K)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 770
#: xml_doc.cpp:5684
msgid "NORMDIST(0.859;0.6;0.258;0) equals 0.934236"
msgstr "NORMDIST(0.859;0.6;0.258;0) é igual a 0.934236"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 771
#: xml_doc.cpp:5687
msgid "NORMDIST(0.859;0.6;0.258;1) equals 0.842281"
msgstr "NORMDIST(0.859;0.6;0.258;1) é igual a 0.842281"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 783
#: xml_doc.cpp:5693
msgid "Middle value in the normal distribution"
msgstr "Valor central da distribuición normal"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 787
#: xml_doc.cpp:5696
msgid "Standard deviation of the normal distribution"
msgstr "Desviación estándar da distribuición normal"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 791
#: xml_doc.cpp:5699
msgid ""
"The NORMINV() function returns the inverse of the normal cumulative "
"distribution. The number must be between 0 and 1 (non-inclusive) and STD "
"must be positive."
msgstr ""
"A función NORMINV() devolve a inversa da distribuición normal acumulada. O "
"número debe estar entre 0 e 1 (exclusive) e STD debe ser positivo."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 792
#: xml_doc.cpp:5702
msgid "NORMINV(number;MV;STD)"
msgstr "NORMINV(número;valorCentral;desviaciónEstandar)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 793
#: xml_doc.cpp:5705
msgid "NORMINV(0.9;63;5) equals 69.41"
msgstr "NORMINV(0.9;63;5) é igual a 69.41"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 801
#: xml_doc.cpp:5708
msgid "Value to which the standard normal distribution is calculated"
msgstr "O valor para o cal é calculada a distribuición normal estándar"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 805
#: xml_doc.cpp:5711
msgid "The NORMSDIST() function returns the standard normal distribution."
msgstr "A función NORMSDIST() devolve a distribuición normal estándar."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 806
#: xml_doc.cpp:5714
msgid "NORMSDIST(Number)"
msgstr "NORMSDIST(número)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 807
#: xml_doc.cpp:5717
msgid "NORMSDIST(1) equals 0.84"
msgstr "NORMSDIST(1) é igual a 0.84"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 819
#: xml_doc.cpp:5723
msgid ""
"The NORMSINV() function returns the inverse of the standard normal "
"cumulative distribution. The number must be between 0 and 1 (non-inclusive)."
msgstr ""
"A función NORMINV() devolve a inversa da distribuición normal acumulada. O "
"número debe estar entre 0 e 1 (exclusive)."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 820
#: xml_doc.cpp:5726
msgid "NORMSINV(Number)"
msgstr "NORMSINV(número)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 821
#: xml_doc.cpp:5729
msgid "NORMSINV(0.908789) returns 1.3333"
msgstr "NORMSINV(0.908789) é igual a 1.3333"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 837
#: xml_doc.cpp:5738
msgid ""
"The PEARSON() function calculates the correlation coefficient of two cell "
"ranges. It is the same as the CORREL function."
msgstr ""
"A función PEARSON() calcula o coeficiente de correlación de dous rangos de "
"celas. É a mesma función que a CORREL."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 838
#: xml_doc.cpp:5741
msgid "PEARSON(range1; range2)"
msgstr "PEARSON(rango1; rango2)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 839
#: xml_doc.cpp:5744
msgid "PEARSON(A1:A3; B1:B3)"
msgstr "PEARSON(A1:A3; B1:B3)"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 852
#: xml_doc.cpp:5750
msgid "Number of elements to permutate"
msgstr "Número de elementos a permutar"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 856
#: xml_doc.cpp:5753
msgid ""
"The PERMUT() function returns the number of permutations. The first "
"parameter is the number of elements, and the second parameter is the number "
"of elements used in the permutation."
msgstr ""
"A función PERMUT() devolve o número de permutacións. O primeiro parámetro é "
"o número de elementos e o segundo parámetro é o número de elementos usados "
"en cada permutación."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 857
#: xml_doc.cpp:5756
msgid "PERMUT(total;permutated)"
msgstr "PERMUT(total;permutados)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 858
#: xml_doc.cpp:5759
msgid "PERMUT(8;5) equals 6720"
msgstr "PERMUT(8;5) é igual a 6720"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 859
#: xml_doc.cpp:5762
msgid "PERMUT(1;1) equals 1"
msgstr "PERMUT(1;1) é igual a 1"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 867
#: xml_doc.cpp:5765
msgid ""
"The number for which the standard normal distribution is to be calculated"
msgstr "O número para o cal a distribuición normal estándar será calculada"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 871
#: xml_doc.cpp:5768
msgid ""
"The PHI() function returns value of the distribution function for a standard "
"normal distribution."
msgstr ""
"A función PHí() devolve o valor da función de distribuición para a "
"distribuición estándar normal."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 872
#: xml_doc.cpp:5771
msgid "PHI(value)"
msgstr "PHI(valor)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 873
#: xml_doc.cpp:5774
msgid "PHI(0.25) equals 0.386668"
msgstr "PHI(0.25) é igual a 0.386668"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 885
#: xml_doc.cpp:5780
msgid "Lambda parameter (the middle value)"
msgstr "Parámetro lambda (o valor medio)"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 893
#: xml_doc.cpp:5786
msgid "The POISSON() function returns the Poisson distribution."
msgstr "A función POISSON() devolve a distribuición de Poisson."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 894
#: xml_doc.cpp:5789
msgid "The lambda and number parameters must be positive."
msgstr "Os valores lambda e número deben ser positivos."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 896
#: xml_doc.cpp:5795
msgid "POISSON(number;lambda;cumulative)"
msgstr "POISSON(número;lambda;acumulativo)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 897
#: xml_doc.cpp:5798
msgid "POISSON(60;50;0) equals 0.020105"
msgstr "POISSON(60;50;0) é igual a 0.020105"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 898
#: xml_doc.cpp:5801
msgid "POISSON(60;50;1) equals 0.927840"
msgstr "POISSON(60;50;1) é igual a 0.927840"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 922
#: xml_doc.cpp:5816
msgid "The SKEW() function returns an estimate for skewness of a distribution"
msgstr ""
"A función SKEW() devolve unha estimación da inclinación dunha distribuición"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 923
#: xml_doc.cpp:5819
msgid "SKEW(number; number2; ...)"
msgstr "SKEW(número; número2; ...)"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 924
#: xml_doc.cpp:5822
msgid "SKEW(range)"
msgstr "SKEW(rango)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 925
#: xml_doc.cpp:5825
msgid "SKEW(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.9768"
msgstr "SKEW(11,4; 17,3; 21,3; 25,9; 40,1) devolve 0,9768"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 950
#: xml_doc.cpp:5840
msgid "The SKEWP() function returns the population skewness of a distribution"
msgstr ""
"A función SKEWP() devolve a inclinación da povoación dunha distribuición"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 951
#: xml_doc.cpp:5843
msgid "SKEWP(number; number2; ...)"
msgstr "SKEWP(número; número2; ...)"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 952
#: xml_doc.cpp:5846
msgid "SKEWP(range)"
msgstr "SKEWP(rango)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 953
#: xml_doc.cpp:5849
msgid "SKEWP(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.6552"
msgstr "SKEWP(11,4; 17,3; 21,3; 25,9; 40,1) devolve 0,6552"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 970
#: xml_doc.cpp:5858
#, fuzzy
#| msgid "The COVAR() function calculates the covariance of two cell ranges."
msgid ""
"The SLOPE() function calculates the slope of the linear regression line."
msgstr "A función COVAR() calcula a co-varianza de dous rangos de celas."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 971
#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1157
#: xml_doc.cpp:5861 xml_doc.cpp:6011
#, fuzzy
#| msgid "LOG(x)"
msgid "SLOPE(y;x)"
msgstr "LOG(x)"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 983
#: xml_doc.cpp:5867
msgid "Position (from the smallest)"
msgstr "Posición (a partir do menor)"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 987
#: xml_doc.cpp:5870
msgid "The SMALL() function returns the k-th smallest value from the data set."
msgstr "A función SMALL() devolve o k-ésimo menor valor do conxunto de datos."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 988
#: xml_doc.cpp:5873
msgid "SMALL(range; k)"
msgstr "SMALL(rango; k)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 989
#: xml_doc.cpp:5876
msgid "A1: 3, A2: 1, A3: 5 => SMALL(A1:A3; 1) returns 1"
msgstr "A1: 3, A2: 1, A3: 5 => SMALL(A1:A3; 1) devolve 1"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 997
#: xml_doc.cpp:5879
msgid "Number to be normalized"
msgstr "Número a normalizar"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1001
#: xml_doc.cpp:5882
msgid "Mean of the distribution"
msgstr "Media da distribuición"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1005
#: xml_doc.cpp:5885
msgid "Standard deviation"
msgstr "Desviación estándar"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1009
#: xml_doc.cpp:5888
msgid "The STANDARDIZE() function calculates a normalized value."
msgstr "A función STANDARIZE() calcula un valor normalizado."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1010
#: xml_doc.cpp:5891
msgid "STANDARDIZE(x; mean, stdev)"
msgstr "STANDARIZE(x; media, desviazonEstandar) "

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1011
#: xml_doc.cpp:5894
msgid "STANDARDIZE(4; 3; 7) returns 0.1429"
msgstr "STANDARIZE(4; 3; 7) devolve 0,1429"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1039
#: xml_doc.cpp:5912
msgid ""
"The STDEV() function returns the estimate standard deviation based on a "
"sample. The standard deviation is a measure of how widely values are "
"dispersed from the average value."
msgstr ""
"A función STDEV() estima a desviación estándar con base nunha mostra. A "
"desviación estándar é unha medida de como os valores se encontran dispersos "
"do valor medio."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1040
#: xml_doc.cpp:5915
msgid "STDEV(value;value;...)"
msgstr "STDEV(valor;valor;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1041
#: xml_doc.cpp:5918
msgid "STDEV(6;7;8) equals 1"
msgstr "STDEV(6;7;8) é igual a 1"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1070
#: xml_doc.cpp:5936
msgid ""
"The STDEVA() function returns the estimate standard deviation based on a "
"sample. The standard deviation is a measure of how widely values are "
"dispersed from the average value. If a referenced cell contains text or "
"contains the boolean value FALSE, it is counted as 0. If the boolean value "
"is TRUE it is counted as 1."
msgstr ""
"A función STDEVA() estima a desviación estándar con base nunha mostra. A "
"desviación estándar é unha medida de como os valores se encontran dispersos "
"do valor medio. Se unha cela contivese texto ou o valor booleano Falso, "
"conta como 0. Se contivese o valor booleano Verdadeiro conta como 1."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1071
#: xml_doc.cpp:5939
msgid "STDEVA(value;value;...)"
msgstr "STDEVA(valor;valor;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1072
#: xml_doc.cpp:5942
msgid "STDEVA(6; 7; A1; 8) equals 1, if A1 is empty"
msgstr "STDEVA(6; 7; A1; 8) é igual a 1, se A1 fose vacío "

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1073
#: xml_doc.cpp:5945
msgid "STDEVA(6; 7; A1; 8) equals 3.109, if A1 is TRUE"
msgstr "STDEVA(6; 7; A1; 8) é igual a 3,109, se A1 fose TRUE"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1103
#: xml_doc.cpp:5963
msgid ""
"The STDEVP() function returns the standard deviation based on an entire "
"population"
msgstr ""
"A función STDEVP() calcula a desviación estándar con base nunha povoación "
"inteira"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1104
#: xml_doc.cpp:5966
msgid "STDEVP(value;value;...)"
msgstr "STDEVP(valor;valor;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1105
#: xml_doc.cpp:5969
msgid "STDEVP(6;7;8) equals 0.816497..."
msgstr "STDEVP(6;7;8) é igual a 0,816497..."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1134
#: xml_doc.cpp:5987
msgid ""
"The STDEVPA() function returns standard deviation based on an entire "
"population. If a referenced cell contains text or contains the boolean value "
"FALSE, it is counted as 0. If the boolean value is TRUE it is counted as 1."
msgstr ""
"A función STDEVPA() calcula a desviación estándar con base nunha povoación "
"inteira. Se unha cela referenciada contén texto ou o valor booleano Falso, "
"conta como 0. Se fose o valor booleano Verdadeiro, conta como 1."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1135
#: xml_doc.cpp:5990
msgid "STDEVPA(value;value;...)"
msgstr "STDEVPA(valor;valor;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1136
#: xml_doc.cpp:5993
msgid "STDEVPA(6; 7; A1; 8) equals 0.816497..., if A1 is empty"
msgstr "STDEVPA(6;7;8) é igual a 0,816497..., se A1 estivese vacío"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1137
#: xml_doc.cpp:5996
msgid "STDEVPA(6; 7; A1; 8) equals 2.69..., if A1 is TRUE"
msgstr "STDEVPA(6; 7; A1; 8) é igual a 2,69..., se A1 fose TRUE"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1138
#: xml_doc.cpp:5999
msgid "STDEVPA(6; 7; A1; 8) equals 3.11..., if A1 is FALSE"
msgstr "STDEVPA(6; 7; A1; 8) é igual a 3,11..., se A1 fose FALSE"

