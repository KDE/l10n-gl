#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 180
#: xml_doc.cpp:5161
msgid "Level of the confidence interval"
msgstr "Intervalo do nível de confianza"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 184
#: xml_doc.cpp:5164
msgid "Standard deviation for the total population"
msgstr "Desviación estándar para a povoación total"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 188
#: xml_doc.cpp:5167
msgid "Size of the total population"
msgstr "Tamaño da povoación total"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 192
#: xml_doc.cpp:5170
msgid ""
"The CONFIDENCE() function returns the confidence interval for a population "
"mean."
msgstr ""
"A función CONFIDENCE() devolve o intervalo de confianza para a media da "
"povoación."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 193
#: xml_doc.cpp:5173
msgid ""
"The alpha parameter must be between 0 and 1 (non-inclusive), stddev must be "
"positive and size must be greater or equal to 1."
msgstr ""
"O parámetro alfa debe estar entre 0 e 1 (exclusive), a desvíación estándar "
"debe ser positiva e o tamaño debe ser maior ou igual a 1."

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 194
#: xml_doc.cpp:5176
msgid "CONFIDENCE(alpha;stddev;size)"
msgstr "CONFIDENCE(alfa;desviazonEstandar;tamaño) "

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 195
#: xml_doc.cpp:5179
msgid "CONFIDENCE(0.05;1.5;100) equals 0.294059"
msgstr "CONFIDENCE(0.05;1.5;100) é igual a 0.294059"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 203
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 222
#. i18n: tag Comment
