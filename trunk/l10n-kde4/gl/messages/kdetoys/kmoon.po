#: kmoonapplet.cpp:84
msgid "&About"
msgstr "&Acerca de"

#: kmoonapplet.cpp:86
msgid "&Configure..."
msgstr "&Configurar..."

#: kmoonapplet.cpp:104
msgid "About Moon Phase Indicator"
msgstr "Acerca do indicador das fases da lúa"

#: kmoonapplet.cpp:110
msgid ""
"Written by Stephan Kulow <coolo@kde.org>\n"
"\n"
