#. (itstool) path: component/name
#: org.kde.jovie.appdata.xml:6
msgid "Jovie"
msgstr "Jovie"

#. (itstool) path: component/summary
#: org.kde.jovie.appdata.xml:7
msgid "KDE Text To Speech Daemon"
msgstr "Servizo de texto-para-voz de KDE"

#. (itstool) path: description/p
#: org.kde.jovie.appdata.xml:9
msgid ""
"Jovie KDE Text-to-Speech is a subsystem within the KDE desktop for "
"conversion of text to audible speech. Jovie is currently under development "
"and aims to become the standard subsystem for all KDE applications to "
"provide speech output."
msgstr ""
"Jovie é un subsistema do escritorio de KDE para converter texto en voz. "
"Jovie está en desenvolvemento e pretende converterse no subsistema estándar "
"de todos os aplicativos de KDE para fornecer saída de voz."

#. (itstool) path: description/p
#: org.kde.jovie.appdata.xml:14
msgid "User Features:"
msgstr "Funcionalidades para usuarios:"

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:16
msgid "Speak any text from the KDE clipboard."
msgstr "Ler calquera texto do portapapeis de KDE."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:19
msgid "Speak any plain text file."
msgstr "Ler calquera ficheiro de texto simple."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:22
msgid ""
"Speak all or any portion of a text file from Kate, including instances where "
"Kate is embedded in another KDE application."
msgstr ""
"Ler un ficheiro desde Kate, total ou parcialmente, incluíndo casos nos que "
"Kate estea incrustado noutro aplicativo de KDE."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:26
msgid "Speak all or any portion of an HTML page from Konqueror."
msgstr "Ler páxinas web desde Konqueror, total ou parcialmente."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:29
msgid "Use as the speech backend for KMouth and KSayIt."
msgstr "Usar como infraestrutura de voz para KMouth e KSayIt."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:32
msgid "Speak KDE notifications (KNotify)."
msgstr "Ler notificacións de KDE (KNotify)."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:35
msgid ""
"User-configurable filters for substituting misspoken words, choosing speech "
"synthesizers, and transforming XHMTL/XML documents."
msgstr ""
"Filtros personalizábeis para substituír palabras mal pronunciadas, escoller "
"sintetizadores de voz, e transformar documentos XHTML ou XML."

#. (itstool) path: description/p
#: org.kde.jovie.appdata.xml:40
msgid "Programmer Features:"
msgstr "Funcionalidades para programadores:"

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:42
msgid ""
"Priority system for screen reader outputs, warnings and messages, while "
"still playing regular texts."
msgstr ""
"Sistema de prioridades para saídas de lectores de pantalla, avisos e "
"mensaxes, sen impedir a reprodución de texto normal."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:45
msgid ""
"Permit generation of speech from the command line (or via shell scripts) "
"using the qdbus utility."
msgstr ""
"Permite a xeración de voz desde a liña de ordes (ou mediante scripts da "
"shell) mediante a ferramenta «qdbus»."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:48
msgid ""
"Provide a lightweight and easily usable interface for applications to "
"generate speech output."
msgstr ""
"Fornece unha interface lixeira e fácil de usar para que os aplicativos xeren "
"saída de voz."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:51
msgid ""
"Applications need not be concerned about contention over the speech device."
msgstr ""
"Os aplicativos non necesitan preocuparse sobre disputas polo dispositivo de "
"voz."

#. (itstool) path: ul/li
#: org.kde.jovie.appdata.xml:54
msgid "Asynchronous to prevent system blocking."
msgstr "É asíncrono para evitar bloquear o sistema."
