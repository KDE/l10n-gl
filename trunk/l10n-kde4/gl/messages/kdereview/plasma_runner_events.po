#: events.cpp:100
#, fuzzy
#| msgid ""
#| "Creates event in calendar by its description in :q:, which consists of "
#| "parts divided by semicolons.  The first two parts (both obligatory) are "
#| "the event summary and its start date.  The third, optional, is list of "
#| "event categories, divided by commas."
msgid ""
"Creates event in calendar by its description in :q:, which consists of parts "
"divided by semicolons. The first two parts (both obligatory) are the event "
"summary and its start date. The third, optional, is list of event "
"categories, divided by commas."
msgstr ""
"Crea eventos no calendario pola súa descrición en :q:, que consiste en "
"partes separadas por un punto e vírgula. As dúas primeiras partes, "
"obrigatorias, son o resumo do evento e a súa data de inicio. A terceira, "
"opcional, é unha lista de categorías de evento, separadas por vírgulas."

#: events.cpp:101
msgid "event description"
msgstr "descrición do evento"

#: events.cpp:104
#, fuzzy
#| msgid ""
#| "Creates todo in calendar by its description in :q:, which consists of "
#| "parts divided by semicolons. The first two parts (both obligatory) are a "
#| "summary of the todo, and its due date.  The third, optional, is list of "
#| "todo categories, divided by commas."
msgid ""
"Creates todo in calendar by its description in :q:, which consists of parts "
"divided by semicolons. The first two parts (both obligatory) are a summary "
"of the todo, and its due date. The third, optional, is list of todo "
"categories, divided by commas."
msgstr ""
"Crea unha tarefa no calendario pola súa descrición en :q:, que consiste en "
"partes separadas por un punto e vírgula. As dúas primeiras partes, "
"obrigatorias, son un resumo da tarefa e a súa data de vencemento. A "
"terceira, opcional, é unha lista de categorías de tarefa, separadas por "
"vírgulas."

#: events.cpp:105
msgid "todo description"
msgstr "descrición da tarefa"

