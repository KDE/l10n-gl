#: bodega/error.cpp:124
msgid "Session Error"
msgstr "Houbo un erro na sesión"

#: bodega/error.cpp:128
msgid "Connection failed."
msgstr "Fallou a conexión."

#: bodega/error.cpp:131
msgid "The add-ons database could not be reached."
msgstr "Non puido accederse á base de datos de complementos."

#: bodega/error.cpp:134
msgid "This account may not perform the requested action."
msgstr "Esta conta podería non realizar a acción solicitada."

#: bodega/error.cpp:137
msgid "Required information was missing from the request."
msgstr "Na solicitude faltaba información necesaria."

#: bodega/error.cpp:140
msgid "No matching records found."
msgstr "Non se atoparon coincidencias."

#: bodega/error.cpp:143
msgid "This account is not active."
msgstr "A conta non está activa."

#: bodega/error.cpp:146
msgid "An account for that email already exists."
msgstr "Xa existe unha conta para ese correo."

#: bodega/error.cpp:149
msgid "Could not purchase the requested item."
msgstr "Non foi posíbel mercar o elemento solicitado."

#: bodega/error.cpp:152
msgid "Failed to send email."
msgstr "Non foi posíbel enviar o correo."

#: bodega/error.cpp:155
msgid "Failed to change account information."
msgstr "Non foi posíbel cambiar a información da conta."

#: bodega/error.cpp:158
msgid "Encryption failed, please try again."
msgstr "Non foi posíbel aplicar o cifrado, vólvao intentar."

#: bodega/error.cpp:161
msgid "The password is too short, please try again."
msgstr "O contrasinal é corto de máis, inténteo de novo."

#: bodega/error.cpp:164 bodega/error.cpp:167
msgid "Could not complete the download of the requested item."
msgstr "Non foi posíbel completar a descarga do elemento solicitado."

#: bodega/error.cpp:170
msgid "The supplied points code was not valid."
msgstr "O código dos puntos fornecidos non era válido."

#: bodega/error.cpp:174 bodega/error.cpp:178 bodega/error.cpp:182
#: bodega/error.cpp:186
msgid "Payment Method Error"
msgstr "Erro co método de pagamento"

#: bodega/error.cpp:175 bodega/error.cpp:179 bodega/error.cpp:183
msgid "Failed to update purchase method details."
msgstr "Non foi posíbel actualizar os detalles do método de pagamento."

#: bodega/error.cpp:187
msgid ""
"A valid payment method could not be found. Please add a payment method to "
"your account."
msgstr ""
"Non foi posíbel atopar un método de pagamento válido. Engada un método de "
"pagamento á conta."

#: bodega/error.cpp:190
msgid "Purchase Method Error"
msgstr "Erro co método de compra"

#: bodega/error.cpp:191
msgid "No purchase method (e.g. credit card) information found."
msgstr ""
"Non se atopou información do método de compra; por exemplo: tarxeta de "
"crédito."

#: bodega/error.cpp:194
msgid "Could not locate the requested customer account."
msgstr "Non foi posíbel atopar a conta de usuario solicitada."

#: bodega/error.cpp:198 bodega/error.cpp:202 bodega/error.cpp:224
#: bodega/error.cpp:230 bodega/error.cpp:235 bodega/error.cpp:240
#: bodega/error.cpp:245 bodega/error.cpp:250 bodega/error.cpp:255
#: bodega/error.cpp:260 bodega/error.cpp:265 bodega/error.cpp:270
#: bodega/error.cpp:275
msgid "Transaction Error"
msgstr "Erro de transacción"

#: bodega/error.cpp:199
msgid ""
"Unable to complete the purchase process. No charge was made to your card."
msgstr ""
"Non é posíbel completar o proceso de compra. Non se cargou nada na súa "
"tarxeta."

#: bodega/error.cpp:203
msgid ""
"Transaction was successful, but could not record the result on the account"
msgstr ""
"A transacción efectuouse correctamente, pero non foi posíbel rexistrar o "
"resultado na conta."

#: bodega/error.cpp:206 bodega/error.cpp:210
msgid "Purchase Error"
msgstr "Erro de compra"

#: bodega/error.cpp:207
msgid "Your account lacks enough points to make this purchase."
msgstr "Non ten puntos dabondo na conta para realizar esta compra."

#: bodega/error.cpp:211
msgid "The requested amount of points exceeds the maximum purchase limit."
msgstr "A cantidade de puntos solicitada supera o límite máximo de compra."

#: bodega/error.cpp:215 bodega/error.cpp:219
msgid "Creation Error"
msgstr "Erro de creación"

#: bodega/error.cpp:216
msgid "The collection already exists."
msgstr "A colección xa existe."

#: bodega/error.cpp:220
msgid "The asset already exists."
msgstr "O recurso xa existe."

#: bodega/error.cpp:225
msgid "Your card has been declined. Please try another payment method"
msgstr "Rexeitouse a súa tarxeta. Probe con outro método de pagamento."

#: bodega/error.cpp:231
msgid "The card number supplied is incorrect. Please check it and try again."
msgstr ""
"O número de tarxeta fornecido é incorrecto. Compróbeo e vólvao intentar."

#: bodega/error.cpp:236
msgid "The card expiry month supplied is incorrect."
msgstr "O mes de caducidade da tarxeta fornecido é incorrecto."

#: bodega/error.cpp:241
msgid "The card expiry year supplied is incorrect."
msgstr "O ano de caducidade da tarxeta fornecido é incorrecto."

#: bodega/error.cpp:246
msgid "The card CVC supplied is incorrect."
msgstr "O CVC da tarxeta fornecido é incorrecto."

#: bodega/error.cpp:251
msgid "Your card has expired. Please try another payment method."
msgstr "A súa tarxeta caducou. Probe con outro método de pagamento."

#: bodega/error.cpp:256
msgid "The purchase amount was invalid. Please try again."
msgstr "A cantidade da compra non era correcta. Vólvao intentar."

#: bodega/error.cpp:261
msgid "This transaction was already processed."
msgstr "A transacción xa foi procesada."

#: bodega/error.cpp:266
msgid "A processing error occured when making the purchase. Please try again."
msgstr ""
"Produciuse un erro de procesamento ao realizar a compra. Vólvao intentar."

#: bodega/error.cpp:271
msgid ""
"Too few points were requested. A minimum of 500 points per purchase is "
"required."
msgstr ""
"Non se solicitaron puntos dabondo. Son necesarios un mínimo de 500 puntos "
"por compra."

#: bodega/error.cpp:276
msgid "Too many points were requested. Please purchase fewer points."
msgstr "Solicitáronse demasiados puntos. Merque menos puntos."

#: bodega/error.cpp:281
msgid "An unknown error occurred."
msgstr "Produciuse un erro descoñecido."

#: bodega/handlers/epub/bookhandler.cpp:84
msgid "Read book"
msgstr "Ler o libro"

#: bodega/handlers/epub/bookinstalljob.cpp:65
#: bodega/handlers/package/packageinstalljob.cpp:56
#: bodega/handlers/package/packageinstalljob.cpp:72
#: bodega/handlers/package/packageinstalljob.cpp:86
#: bodega/handlers/package/packageuninstalljob.cpp:44
#: bodega/handlers/rpm/packageidinstalljob.cpp:120
#: bodega/handlers/rpm/rpminstalljob.cpp:106
msgid "Install failed"
msgstr "Non foi posíbel realizar a instalación."

#: bodega/handlers/epub/bookinstalljob.cpp:66
msgid ""
"Impossible to install the book, wrong permissions or no space left on device."
msgstr ""
"Non foi posíbel instalar o libro. Ou non ten os permisos necesarios no "
"dispositivo, ou non ten espazo dabondo nel."

#: bodega/handlers/epub/bookuninstalljob.cpp:36
#: bodega/handlers/epub/bookuninstalljob.cpp:41
#: bodega/handlers/package/packageuninstalljob.cpp:61
#: bodega/handlers/rpm/rpmuninstalljob.cpp:44
#: bodega/handlers/rpm/rpmuninstalljob.cpp:70
#: bodega/handlers/wallpaper/wallpaperuninstalljob.cpp:53
msgid "Uninstall failed"
msgstr "Non foi posíbel realizar a desinstalación."

#: bodega/handlers/epub/bookuninstalljob.cpp:37
msgid "The book is not installed."
msgstr "O libro non está instalado."

#: bodega/handlers/epub/bookuninstalljob.cpp:42
msgid "Impossible to delete the file."
msgstr "Non é posíbel eliminar o ficheiro."

#: bodega/handlers/package/packageinstalljob.cpp:57
msgid "Service type tag not specified."
msgstr "Non se indicou a etiqueta do tipo de servizo."

#: bodega/handlers/package/packageuninstalljob.cpp:45
msgid "Plugin name or service type tags not specified."
msgstr ""
"Non se indicaron as etiquetas do tipo de servizo ou do nome do complemento."

#: bodega/handlers/package/packageuninstalljob.cpp:62
msgid "Impossible to uninstall the package."
msgstr "Non é posíbel desinstalar o paquete."

#: bodega/handlers/rpm/packageidinstalljob.cpp:53
#: bodega/handlers/rpm/packageidinstalljob.cpp:69
msgid "Install error"
msgstr "Erro de instalación"

#: bodega/handlers/rpm/packageidinstalljob.cpp:54
msgid "failed to open the descriptor file"
msgstr "Non foi posíbel abrir o ficheiro descritor."

#: bodega/handlers/rpm/packageidinstalljob.cpp:70
msgid "failed to parse the descriptor file"
msgstr "Non foi posíbel analizar o ficheiro descritor."

#: bodega/handlers/rpm/rpmhandler.cpp:125
msgid "Launch"
msgstr "Iniciar"

#: bodega/handlers/rpm/rpmuninstalljob.cpp:45
msgid "Package not installed."
msgstr "O paquete non está instalado."

#: bodega/handlers/wallpaper/wallpaperuninstalljob.cpp:54
msgid "Impossible to uninstall the wallpaper package."
msgstr "Non é posíbel desinstalar o paquete do fondo de escritorio."

#: bodega/historymodel.cpp:60
msgid "No events for this account. Go download something interesting! :)"
msgstr ""
"Non hai acontecementos nesta conta. Por que non vai descargar algo "
"interesante? :)"

#: bodega/historymodel.cpp:175
#, qt-format
msgid "Downloaded %1"
msgstr "Descargouse %1"

#: bodega/historymodel.cpp:177
#, qt-format
msgid "Purchased %1"
msgstr "Mercou %1"

#: bodega/historymodel.cpp:179
#, qt-format
msgid "Added %1 points"
msgstr "Engadiu %1 puntos"

#: bodega/networkjob.cpp:101
msgid "Invalid response from the server"
msgstr "Recibiuse unha resposta non válida do servidor."

#: bodega/networkjob.cpp:102
msgid "Server has sent an invalid response."
msgstr "O servidor enviou unha resposta incorrecta."

#: bodega/networkjob.cpp:126
msgid "Download error"
msgstr "Erro na descarga"

#: bodega/networkjob.cpp:127
msgid "Error downloading the asset."
msgstr "Produciuse un erro ao descargar o recurso."

#: bodega/networkjob.cpp:169
msgid "Network Error"
msgstr "Erro da rede"

#: bodega/networkjob.cpp:205
msgid "Authentication Error"
msgstr "Erro de autenticación"

#: bodega/networkjob.cpp:206
msgid "Invalid username or password"
msgstr "O nome de usuario ou contrasinal son incorrectos."

#: tests/model/window.cpp:32
msgid "Quit"
msgstr "Saír"
