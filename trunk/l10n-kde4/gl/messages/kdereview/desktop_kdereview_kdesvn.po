#: src/kdesvn.desktop:2
msgctxt "Name"
msgid "kdesvn"
msgstr "kdesvn"

#: src/kdesvn.desktop:23 src/kdesvnpart.desktop:21
msgctxt "GenericName"
msgid "SVN Client"
msgstr "Cliente de Subversion"

#: src/kdesvn.desktop:48 src/kdesvnpart.desktop:45
msgctxt "Comment"
msgid "A Subversion client for KDE"
msgstr "Un cliente de Subversion para KDE."

#: src/kdesvnd/kdesvnd.desktop:3
msgctxt "Name"
msgid "kdesvnd subversion module"
msgstr "Módulo de Subversion kdesvnd"

#: src/kdesvnd/kdesvnd.desktop:22
msgctxt "Comment"
msgid "Gives various Subversion actions to file managers and other software"
msgstr ""
"Fornece varias accións de Subversion aos xestores de ficheiros e outros "
"programas."

#: src/kdesvnd/kdesvn_subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion (kdesvn)"
msgstr "Subversion (kdesvn)"

#: src/kdesvnd/kdesvn_subversion.desktop:27
msgctxt "Name"
msgid "Subversion log (last 100)"
msgstr "Últimos 100 cambios de Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:48
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:29
msgctxt "Comment"
msgid "Displays the Subversion log"
msgstr "Mostra o historial de Subversion."

#: src/kdesvnd/kdesvn_subversion.desktop:69
msgctxt "Name"
msgid "Detailed Subversion info"
msgstr "Información detallada de Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:92
msgctxt "Name"
msgid "Add to Repository"
msgstr "Engadir ao repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:117
msgctxt "Name"
msgid "Check for unversioned items"
msgstr "Buscar elementos alleos"

#: src/kdesvnd/kdesvn_subversion.desktop:139
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Eliminar do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:162
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Anular as modificacións locais"

#: src/kdesvnd/kdesvn_subversion.desktop:183
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Borra as alteracións feitas a nivel local. Atención, isto non pode ser "
"anulado."

#: src/kdesvnd/kdesvn_subversion.desktop:204
msgctxt "Name"
msgid "Rename..."
msgstr "Renomear…"

#: src/kdesvnd/kdesvn_subversion.desktop:226
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Muda o nome dun ficheiro tanto localmente como no repositorio. Use isto en "
"vez de engadir e eliminar o ficheiro para mudar o nome."

#: src/kdesvnd/kdesvn_subversion.desktop:247
msgctxt "Name"
msgid "Import Repository"
msgstr "Importar un repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:268
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr ""
"Pon o cartafol nun repositorio existente para pólo baixo control de versións."

#: src/kdesvnd/kdesvn_subversion.desktop:289
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:50
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Obter do repositorio..."

#: src/kdesvnd/kdesvn_subversion.desktop:310
#: src/kdesvnd/kdesvn_subversion.desktop:628
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:71
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:197
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Obtén todos os ficheiros dun repositorio existente para este cartafol."

#: src/kdesvnd/kdesvn_subversion.desktop:331
msgctxt "Name"
msgid "Switch..."
msgstr "Mudar..."

#: src/kdesvnd/kdesvn_subversion.desktop:351
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Cambiar a copia de traballo indicada a unha outra rama."

#: src/kdesvnd/kdesvn_subversion.desktop:373
msgctxt "Name"
msgid "Merge..."
msgstr "Fusionar..."

#: src/kdesvnd/kdesvn_subversion.desktop:394
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Fusiona as modificacións entre esta galla e outra"

#: src/kdesvnd/kdesvn_subversion.desktop:416
msgctxt "Name"
msgid "Blame..."
msgstr "Autorías..."

#: src/kdesvnd/kdesvn_subversion.desktop:436
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Consulta quen escribiu unha liña dada no ficheiro e en que versión"

#: src/kdesvnd/kdesvn_subversion.desktop:458
msgctxt "Name"
msgid "Create Patch..."
msgstr "Crear un parche..."

#: src/kdesvnd/kdesvn_subversion.desktop:481
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:92
msgctxt "Name"
msgid "Export..."
msgstr "Exportar…"

#: src/kdesvnd/kdesvn_subversion.desktop:503
#: src/kdesvnd/kdesvn_subversion.desktop:669
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:114
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:238
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "Obtén unha copia sen control de versións dunha árbore do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:524
msgctxt "Name"
msgid "Diff (local)"
msgstr "Diferenzas (local)"

#: src/kdesvnd/kdesvn_subversion.desktop:545
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Mostra as modificacións locais desde a última actualización"

#: src/kdesvnd/kdesvn_subversion.desktop:566
msgctxt "Name"
msgid "KDESvn Update"
msgstr "Actualizar con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:588
msgctxt "Name"
msgid "KDESvn Commit"
msgstr "Remitir con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:609
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:178
msgctxt "Name"
msgid "Checkout from a repository..."
msgstr "Obter dun repositorio…"

#: src/kdesvnd/kdesvn_subversion.desktop:649
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:218
msgctxt "Name"
msgid "Export from a Subversion repository..."
msgstr "Exportar dun repositorio de Subversion…"

#: src/kdesvnd/kdesvn_subversion.desktop:690
msgctxt "Name"
msgid "Display revision tree"
msgstr "Mostrar a árbore de revisións"

#: src/kdesvnd/kdesvn_subversion.desktop:710
msgctxt "Comment"
msgid "Show complete revision tree"
msgstr "Mostrar a árbore de revisións completa."

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:9
msgctxt "Name"
msgid "kdesvn log (last 100)"
msgstr "Últimos 100 cambios de kdesvn"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:135
msgctxt "Name"
msgid "Update (Kdesvn)"
msgstr "Actualizar con Kdesvn"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:157
msgctxt "Name"
msgid "Commit (Kdesvn)"
msgstr "Remitir con Kdesvn"

#: src/kdesvn.notifyrc:3
msgctxt "Comment"
msgid "Kdesvn notification"
msgstr "Notificación de Kdesvn"

#: src/kdesvn.notifyrc:23
msgctxt "Name"
msgid "Kdesvn KIO Notification"
msgstr "Notificación de KIO de Kdesvn"

#: src/kdesvn.notifyrc:44
msgctxt "Name"
msgid "Kdesvn task notification"
msgstr "Notificación de tarefa de Kdesvn"

