msgstr "Pór o &volume:"

#. i18n: file: audioplayercontrolrunner_config.ui:323
#. i18n: ectx: property (toolTip), widget (KLineEdit, volume_edit)
#: rc.cpp:52
msgid ""
"The numbers are automatically added at the end:\n"
"Amarok:Volume=10"
msgstr ""
"Os números engádense automaticamente ao final:\n"
"Amarok:Volume=10"

