#: devicenotifier.cpp:201
#, kde-format
msgid "Last device seen:<br><b>%1</b>"
msgstr "Derradeiro dispositivo visto:<br><b>%1</b>"

#: devicenotifier.cpp:204
msgid "<i>No devices plugged in</i>"
msgstr "<i>Non hai ningún dispositivo conectado</i>"

#: devicenotifier.cpp:309
msgid ""
"Could not unmount the device.\n"
"One or more files on this device are open within an application."
msgstr ""
"Non se puido desmontar o dispositivo.\n"
"Unha aplicación ten abertos un ou máis ficheiros deste dispositivo."

#: devicenotifier.cpp:315
msgid ""
"Cannot eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""
"Non se pode expulsar o disco.\n"
"Unha aplicación ten abertos un ou máis ficheiros deste disco."

#: devicewidget.cpp:45 devicewidget.cpp:89
msgid "No devices detected"
msgstr "Non se detectou ningún dispositivo"
