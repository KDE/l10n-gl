#: rc.cpp:37 rc.cpp:96
#, no-c-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">You can use following macros here:</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"><span style=\" font-weight:600;\">exec(</span><span style=\" font-"
"weight:600; font-style:italic;\">program</span><span style=\" font-"
"weight:600;\">)</span> - Execute command and get output.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">e.g. <span style=\" font-style:italic;\">%{exec(sh myscript.sh)}</"
"span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans'; font-style:italic;\"><span style=\" font-weight:600; font-style:"
"normal;\">file</span><span style=\" font-style:normal;\"> - Insert file "
"contents (Supports kio slaves)</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"><span style=\" font-weight:600;\">time</span> - Current time.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"><span style=\" font-weight:600;\">date</span> - Current date.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"><span style=\" font-weight:600;\">password(character </span><span "
"style=\" font-weight:600; font-style:italic;\">count, character set</"
"span><span style=\" font-weight:600;\">)</span> - Random password. </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">Character set: </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">a = lowercase letters</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">A = upper case letters</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">0 = numbers</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"># = symbols</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">e.g. <span style=\" font-style:italic;\">%{password(12, aA0)}</"
"span></p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">Aquí pode empregar as seguintes macrosYou can use :</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"><span style=\" font-weight:600;\">exec(</span><span style=\" font-"
"weight:600; font-style:italic;\">programa</span><span style=\" font-"
"weight:600;\">)</span> - Executa o programa e obtén a saída.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">e.g. <span style=\" font-style:italic;\">%{exec(sh script.sh)}</"
"span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans'; font-style:italic;\"><span style=\" font-weight:600; font-style:"
"normal;\">file</span><span style=\" font-style:normal;\"> - Insere o "
"contido do ficheiro (Admite kio slaves)</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"><span style=\" font-weight:600;\">time</span> - A hora actual.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"><span style=\" font-weight:600;\">date</span> - A data actual.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"><span style=\" font-weight:600;\">password(</span><span "
"style=\" font-weight:600; font-style:italic;\">número de caracteres, "
"conxunto de caracteres</span> "
"<span style=\" font-weight:600;\">)</span> - Un contrasinal "
"aleatorio. </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">Conxunto de caracteres: </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">a = letras minúsculas</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">A = letras maiúsculas</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">0 = números</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\"># = símbolos</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Liberation "
"Sans';\">por ex. <span style=\" font-style:italic;\">%{password(12, aA0)}</"
"span></p></body></html>"

