#: main.cpp:112
msgid "Create new session with given name."
msgstr "Crear unha sesión nova co nome indicado."

#: main.cpp:114
msgid "Session to load. You can pass either hash or the name of the session."
msgstr ""
"Sesión para cargar. Pode indicar ou ben o código ou ben o nome da sesión."

#: main.cpp:116
msgid "List available sessions and quit"
msgstr "Lista as sesións dispoñíbeis e sae."

#: main.cpp:126
msgid "Available sessions (use '-s HASH' or '-s NAME' to open a specific one):"
