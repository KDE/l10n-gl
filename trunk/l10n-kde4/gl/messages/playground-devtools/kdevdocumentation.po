#: documentation_part.cpp:248 documentation_part.cpp:470
msgid ""
"<b>Find documentation</b><p>Opens the documentation finder tab and searches "
"all possible sources of documentation like table of contents, index, man and "
"info databases, Google, etc."
msgstr ""
"<b>Procurar a documentación</b><p>Abre a lingüeta de procura de "
"documentación e procura en todas as fontes de documentación posíbeis como "
"táboas de contido, índices, bases de datos de man e info, Google etc."

