#: documentation_part.cpp:487
msgid ""
"<b>Search in documentation</b><p>Searches for a term under the cursor in the "
"documentation. For this to work, a full text index must be created first, "
"which can be done in the configuration dialog of the documentation plugin."
msgstr ""
"<b>Procurar na documentación</b><p>Procura na documentación o termo baixo o "
"cursor. Para que isto funcione antes debe criarse un índice de todo o texto, "
"o que pode facerse no diálogo de configuración da extensión de documentación."

#: documentation_part.cpp:494
#, kde-format
msgid "Goto Manpage: %1"
msgstr "Ir á páxina de manual: %1"

#: documentation_part.cpp:496
msgid ""
"<b>Goto manpage</b><p>Tries to open a man page for the term under the cursor."
msgstr ""
"<b>Ir á páxina man</b><p>Tenta abrir a páxina man do termo sob o cursor."

#: documentation_part.cpp:499
#, kde-format
msgid "Goto Infopage: %1"
msgstr "Ir á páxina de info: %1"

#: documentation_part.cpp:501
msgid ""
"<b>Goto infopage</b><p>Tries to open an info page for the term under the "
"cursor."
msgstr ""
"<b>Ir á páxina info</b><p>Tenta abrir a páxina infor do termo son o cursor."

