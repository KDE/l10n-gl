#. i18n: file: debuggerconfigwidget.ui:26
#. i18n: ectx: property (text), widget (QLabel, textLabel1)
#: rc.cpp:6 rc.cpp:248
msgid ""
"Debug arguments can be set on the Run Options page\n"
" or directly in the project manager"
msgstr ""
"Os argumentos da depuración poden configurarse na páxina de\n"
"Opcións de execución ou directamente no xestor de proxectos"

#. i18n: file: debuggerconfigwidget.ui:42
#. i18n: ectx: property (text), widget (QLabel, gdbPath_label)
#: rc.cpp:10 rc.cpp:252
