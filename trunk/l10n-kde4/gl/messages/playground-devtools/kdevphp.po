#: duchain/contextbuilder.cpp:246
#, kde-format
msgid "Circular inheritance of %1 and %2"
msgstr "Herdanza circular de %1 e %2"

#: duchain/navigation/declarationnavigationcontext.cpp:55
msgid " extends "
msgstr "amplía"

#: duchain/navigation/declarationnavigationcontext.cpp:60
msgid " implements "
msgstr "implementa"

#: duchain/declarationbuilder.cpp:195
#, kde-format
msgid "Access type for interface method %1 must be omitted."
msgstr "Debe omitirse o tipo de acceso ao método %1 da interface."

#: duchain/declarationbuilder.cpp:199
#, kde-format
msgid "Interface function %1 cannot contain body."
msgstr "A función %1 da interface non pode ter corpo."

#: duchain/declarationbuilder.cpp:211
#, kde-format
msgid ""
"Class %1 contains abstract method %2 and must therefore be declared abstract "
"or implement the method."
msgstr ""
"A clase %1 contén o método abstracto %2 e polo tanto debe declararse como "
"abstracta ou implementar o método."

#: duchain/declarationbuilder.cpp:217
#, kde-format
msgid "Abstract function %1 cannot contain body."
msgstr "A función abstracta %1 non pode ter corpo."

#: duchain/declarationbuilder.cpp:220
msgid "Cannot use the final modifier on an abstract class member."
msgstr ""
"Non se pode empregar o modificador final nun membro dunha clase abstracta."

#: duchain/declarationbuilder.cpp:230
#, kde-format
msgid "Non-abstract method %1 must contain body."
msgstr "O método non abstracto %1 debe ter corpo."

#: duchain/declarationbuilder.cpp:244
msgid "Properties cannot be declared final."
msgstr "As propriedades non se poden declarar como finais."

#: duchain/declarationbuilder.cpp:247
msgid "Properties cannot be declared abstract."
msgstr "As propriedades non se poden declarar como abstractas."

#: duchain/declarationbuilder.cpp:407
#, kde-format
msgid "Cannot redeclare PHP internal %1."
msgstr "Non se pode declarar de novo %1 interno de PHP."

#: duchain/declarationbuilder.cpp:411
#, kde-format
msgid "Cannot redeclare %1, already declared in %2 on line %3."
msgstr "Non se pode declarar de novo %1, xa foi declarado na liña %3 de %2."

#: completion/implementationitem.cpp:63
msgid "Override"
msgstr "Sobrepor"

#: completion/implementationitem.cpp:66
msgid "Implement"
msgstr "Implementar"

#: completion/implementationitem.cpp:79
#, kde-format
msgid "From %1"
msgstr "De %1"

#: phpparsejob.cpp:140
#, kde-format
msgid "Could not open file '%1'"
msgstr "Non foi posíbel abrir o ficheiro «%1»"

#: phpparsejob.cpp:143
msgid "File could not be read from."
msgstr "Non foi posíbel ler o ficheiro."

#: phpparsejob.cpp:146
msgid "File could not be opened."
msgstr "Non foi posíbel abrir o ficheiro."

#: phpparsejob.cpp:149
msgid "File permissions prevent opening for read."
msgstr "Os permisos do ficheiro non permiten que o abra para ler."

#: phpparsejob.cpp:193
#, kde-format
#| msgid "File could not be opened."
msgid "Included file %1 could not be found."
msgstr "Non foi posíbel atopar o ficheiro incluído %1."

#: phpparsejob.cpp:205
#, kde-format
msgid "File %1 includes itself."
msgstr "O ficheiro %1 inclúese a si mesmo."

