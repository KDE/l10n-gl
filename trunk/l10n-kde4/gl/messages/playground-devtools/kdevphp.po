#, kde-format
msgid "Could not open file '%1'"
msgstr "Non foi posíbel abrir o ficheiro «%1»"

#: phpparsejob.cpp:141
msgid "File could not be read from."
msgstr "Non foi posíbel ler o ficheiro."

#: phpparsejob.cpp:144
msgid "File could not be opened."
msgstr "Non foi posíbel abrir o ficheiro."

#: phpparsejob.cpp:147
msgid "File permissions prevent opening for read."
msgstr "Os permisos do ficheiro non permiten que o abra para ler."

#: phpparsejob.cpp:188
#, kde-format
msgid "Included file %1 could not be found."
msgstr "Non foi posíbel atopar o ficheiro incluído %1."

#: phpparsejob.cpp:200
#, kde-format
msgid "File %1 includes itself."
msgstr "O ficheiro %1 inclúese a si mesmo."

