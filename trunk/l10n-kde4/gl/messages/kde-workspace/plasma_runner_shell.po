msgstr "Introduza aquí o usuario co que quere executar o programa."

#. i18n: file: shellOptions.ui:64
#. i18n: ectx: property (text), widget (QLabel, lbUsername)
#: rc.cpp:6
msgid "User&name:"
msgstr "Nome de u&suario:"

