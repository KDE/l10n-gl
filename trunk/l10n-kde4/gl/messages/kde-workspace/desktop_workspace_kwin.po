msgid "Inverts the color of the desktop and windows"
msgstr "Inverte a cor do escritorio e das xanelas"

#: effects/kscreen/kscreen.desktop:2
msgctxt "Name"
msgid "Kscreen"
msgstr "KScreen"

#: effects/kscreen/kscreen.desktop:43
msgctxt "Comment"
msgid "Helper Effect for KScreen"
msgstr "Efecto auxiliar para KScreen."

#: effects/kwineffect.desktop:5
msgctxt "Comment"
msgid "KWin Effect"
msgstr "Efecto de KWin"

#: effects/login/package/metadata.desktop:2
msgctxt "Name"
msgid "Login"
msgstr "Acceso"

#: effects/login/package/metadata.desktop:89
msgctxt "Comment"
msgid "Smoothly fade to the desktop when logging in"
msgstr "Suaviza a entrada no escritorio cun efecto de esvaecemento"

#: effects/logout/logout.desktop:2
msgctxt "Name"
msgid "Logout"
msgstr "Saír"

#: effects/logout/logout.desktop:89
msgctxt "Comment"
msgid "Desaturate the desktop when displaying the logout dialog"
msgstr "Desatura o escritorio ao mostrar o diálogo de saída"

#: effects/lookingglass/lookingglass_config.desktop:8
#: effects/lookingglass/lookingglass.desktop:2
msgctxt "Name"
msgid "Looking Glass"
msgstr "Espello"

