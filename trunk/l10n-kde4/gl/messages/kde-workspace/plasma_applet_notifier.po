#: package/contents/ui/DeviceItem.qml:132
msgctxt ""
"Accessing is a less technical word for Mounting; translation should be short "
"and mean 'Currently mounting this device'"
msgid "Accessing..."
msgstr "Estase a acceder..."

#: package/contents/ui/DeviceItem.qml:132
msgctxt ""
"Removing is a less technical word for Unmounting; translation shoud be short "
"and mean 'Currently unmounting this device'"
msgid "Removing..."
msgstr "Estase a eliminar..."

#: package/contents/ui/DeviceItem.qml:158
#, kde-format
msgid "%1 actions for this device"
msgstr "%1 accións para este dispositivo"

#: package/contents/ui/DeviceItem.qml:167
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free"
msgstr "%1 libre"

#: package/contents/ui/DeviceItem.qml:186
msgid "Click to mount this device."
msgstr "Prema para montar este dispositivo."

#: package/contents/ui/DeviceItem.qml:188
msgid "Click to eject this disc."
msgstr "Prema para expulsar este disco."

#: package/contents/ui/DeviceItem.qml:190
msgid "Click to safely remove this device."
msgstr "Prema para retirar con seguridade este dispositivo."

#: package/contents/ui/DeviceItem.qml:192
msgid "Click to access this device from other applications."
msgstr "Prema para acceder a este dispositivo desde outros programas."

#: package/contents/ui/DeviceItem.qml:202
msgid ""
"It is currently <b>not safe</b> to remove this device: applications may be "
"accessing it. Click the eject button to safely remove this device."
msgstr ""
"Na actualidade <b>non é seguro</b> eliminar este dispositivo: pode haber "
"programas accedendo a el. Prema no botón de expulsar para eliminar con "
"seguranza este dispositivo."

#: package/contents/ui/DeviceItem.qml:204
msgid "This device is currently accessible."
msgstr "Este dispositivo está accesíbel."

#: package/contents/ui/DeviceItem.qml:209
msgid ""
"It is currently <b>not safe</b> to remove this device: applications may be "
"accessing other volumes on this device. Click the eject button on these "
"other volumes to safely remove this device."
msgstr ""
"Na actualidade <b>non é seguro</b> eliminar este dispositivo: pode haber "
"programas accedendo a outros volumes do dispositivo. Prema no botón de "
"expulsar deses outros volumes para eliminar con seguranza este dispositivo."

#: package/contents/ui/DeviceItem.qml:211
msgid "It is currently safe to remove this device."
msgstr "Agora é seguro eliminar este dispositivo."

#: package/contents/ui/DeviceItem.qml:214
msgid "This device is not currently accessible."
msgstr "Este dispositivo non está accesíbel."

#: package/contents/ui/devicenotifier.qml:143
msgid "Available Devices"
msgstr "Dispositivos dispoñíbel"

#: package/contents/ui/devicenotifier.qml:143
msgid "No Devices Available"
msgstr "Non hai ningún dispositivo dispoñíbel"

#. i18n: file: package/contents/ui/config.ui:17
#. i18n: ectx: property (text), widget (QRadioButton, kcfg_removableDevices)
#: rc.cpp:3
msgid "Removable devices only"
msgstr "Só os dispositivos extraíbeis"

#. i18n: file: package/contents/ui/config.ui:24
#. i18n: ectx: property (text), widget (QRadioButton, kcfg_nonRemovableDevices)
#: rc.cpp:6
msgid "Non-removable devices only"
msgstr "Só os dispositivos non extraíbeis"

#. i18n: file: package/contents/ui/config.ui:44
#. i18n: ectx: property (text), widget (QRadioButton, kcfg_allDevices)
#: rc.cpp:9
msgid "All devices"
msgstr "Todos os dispositivos"
