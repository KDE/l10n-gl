#: GeneralPage.cpp:110
msgid "Do nothing"
msgstr "Non facer nada"

#: GeneralPage.cpp:112
msgid "Sleep"
msgstr "Durmir"

#: GeneralPage.cpp:115
msgid "Hibernate"
msgstr "Hibernar"

#: GeneralPage.cpp:117
msgid "Shutdown"
