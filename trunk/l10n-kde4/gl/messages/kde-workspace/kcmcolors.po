#: colorscm.cpp:251
msgid "Selecting another scheme will discard any changes you have made"
msgstr "Se escolle outro esquema esquecerase calquera modificación que fixese"

#: colorscm.cpp:252
msgid "Are you sure?"
msgstr "Desexa realmente facelo?"

#: colorscm.cpp:318
msgid "You do not have permission to delete that scheme"
msgstr "Non ten permiso para borrar ese esquema"

#: colorscm.cpp:318 colorscm.cpp:534
msgid "Error"
msgstr "Erro"

#: colorscm.cpp:326
msgid "Import Color Scheme"
msgstr "Importar un esquemas de cores"

#: colorscm.cpp:339
msgid ""
"The scheme you have selected appears to be a KDE3 scheme.\n"
"\n"
"KDE will attempt to import this scheme, however many color roles have been "
"added since KDE3. Some manual work will likely be required.\n"
"\n"
"This scheme will not be saved automatically."
msgstr ""
"O esquema escollido semella ser de KDE3.\n"
"\n"
"KDE ha tentar importalo, pero engadíronse moitos roles de cores desde KDE3. "
"É moi posíbel que se precise facer traballo á mao.\n"
"\n"
"Este esquema non se gardará automaticamente."

#: colorscm.cpp:343
msgid "Notice"
msgstr "Aviso"

#: colorscm.cpp:415
msgid "Please save the color scheme before uploading it."
msgstr "Garde o esquema de cores antes de subilo."

#: colorscm.cpp:416
msgid "Please save"
msgstr "Gárdeo, por favor"

#: colorscm.cpp:446 colorscm.cpp:477
msgid "Save Color Scheme"
msgstr "Gardar o esquema de cores"

#: colorscm.cpp:447
msgid "&Enter a name for the color scheme:"
msgstr "&Escriba un nome para o esquema de cores:"

#: colorscm.cpp:476
msgid ""
"A color scheme with that name already exists.\n"
"Do you want to overwrite it?"
msgstr ""
"Xa existe un esquema de cores con ese nome.\n"
"Desexa sobrescribilo?"

#: colorscm.cpp:534
msgid "You do not have permission to overwrite that scheme"
msgstr "Non ten permiso para sobrescribir ese esquema"

