#. i18n: ectx: property (text), widget (QLabel, label_9)
#: rc.cpp:95
msgid "Effect:"
msgstr "Efecto:"

#. i18n: file: main.ui:307
#. i18n: ectx: property (toolTip), widget (KComboBox, effectCombo)
#: rc.cpp:98
