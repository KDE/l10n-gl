msgstr "<b>Cambio de nome da lapela:</b>"

#: src/widgets/serverpreferenceswidget.cpp:365
#, kde-format
msgid "Double click on current tab for server renaming"
msgstr ""
"Prema dúas veces seguidas a lapela actual para cambiar o nome do servidor."

