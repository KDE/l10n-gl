#: kfritz.desktop:2
msgctxt "Name"
msgid "KFritz"
msgstr "KFritz"

#: kfritz.desktop:31
msgctxt "GenericName"
msgid "Call notificator"
msgstr "Notificador de chamadas"

#: kfritz.desktop:54
msgctxt "Comment"
msgid ""
"Access call history and phone book of your Fritz!Box and get notifications "
"on incoming and outgoing calls."
msgstr ""
"Acceda ao historial de chamadas e ao caderno de enderezos da súa Fritz!Box e "
"obteña notificacións sobre as chamadas entrantes e saíntes."

#: kfritz.notifyrc:5
msgctxt "Name"
msgid "Incoming Call"
msgstr "Chamada entrante"

#: kfritz.notifyrc:33
msgctxt "Name"
msgid "Outgoing Call"
msgstr "Chamada saínte"

#: kfritz.notifyrc:60
msgctxt "Name"
msgid "Call got connected"
msgstr "Ligouse a chamada"

#: kfritz.notifyrc:85
msgctxt "Name"
msgid "Call got disconnected"
msgstr "Desligouse a chamada"
