"dh2 = modp1024\n"
"dh5 = modp1536\n"
"d14 = modp2048 (only racoon)\n"
"dh15 = modp3072 (only racoon)\n"
"dh16 = modp4096 (only racoon)\n"
"dh17 = modp6144 (only racoon)\n"
"dh18 = modp8192 (only racoon)"
