"server = O grupo DH é recibido desde o servidor (só cisco)\n"
"nopfs = non se usa pfs\n"
"dh1 = modp768\n"
"dh2 = modp1024\n"
"dh5 = modp1536\n"
"d14 = modp2048 (só racoon)\n"
"dh15= modp3072 (só racoon)\n"
