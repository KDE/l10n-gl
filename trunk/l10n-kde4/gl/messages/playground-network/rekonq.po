#: settings.cpp:173
msgid "Specifies whether images are automatically loaded in web pages."
msgstr "Especificar se as imaxes se cargan automaticamente nas páxinas web."

#: settings.cpp:174
msgid "Enables the execution of JavaScript programs."
msgstr "Activa a execución de aplicacións en JavaScript"

#: settings.cpp:175
msgid "Enables support for Java applets."
msgstr "Activa o soporte para applets de Java"

#: settings.cpp:176
msgid "Enables support for plugins in web pages."
msgstr "Activa o soporte para engadidos de páxinas web."

#: settings.cpp:177
msgid "If enabled, JavaScript programs are allowed to open new windows."
msgstr ""
"De se activar, as aplicacións de JavaScript poden abrir fiestras novas."

#: settings.cpp:178
msgid ""
"If enabled, JavaScript programs are allowed to read from and to write to the "
"clipboard."
msgstr ""
"De se activar, as aplicacións en JavaScript pode ler e copiar do "
"portaretallos."

#: settings.cpp:179
msgid "If enabled, hyperlinks are included in the keyboard focus chain."
msgstr "De se activar, as hiperligazóns inclúense na cadea de foco do teclado."

#: settings.cpp:180
msgid "If enabled, the zoom factor on a frame is only applied to the text."
msgstr ""
"De se activar, o factor de ampliación dunha moldura só se aplica ao texto."

#: settings.cpp:181
msgid ""
"If enabled, background colors and images are also drawn when the page is "
"printed."
msgstr ""
"De se activar, as cores do fondo e as imaxes só se debuxan cando se imprime "
"a páxina."

#: settings.cpp:182
msgid "Enables support for the HTML 5 offline storage feature."
msgstr ""
"Activa o soporte para capacidade de almacenamento fóra de liña de HTML 5"

#: settings.cpp:183
msgid "Enables support for the HTML 5 web application cache feature."
msgstr "Activa o soporte para o caché das aplicacións web de HTML 5. "

#: settings.cpp:184
msgid "Enables support for the HTML 5 local storage feature."
msgstr "Activa o soporte de HTML 5 para o almacenamento local. "

