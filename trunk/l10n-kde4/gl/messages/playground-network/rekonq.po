#: settings.cpp:173
msgid "Specifies whether images are automatically loaded in web pages."
msgstr "Indica se as imaxes das páxinas web se cargan automaticamente."

#: settings.cpp:174
msgid "Enables the execution of JavaScript programs."
msgstr "Activa a execución do programas en JavaScript."

#: settings.cpp:175
msgid "Enables support for Java applets."
msgstr "Activa o funcionamento das applets en Java."

#: settings.cpp:176
msgid "Enables support for plugins in web pages."
msgstr "Activa o funcionamento dos engadidos das páxinas web."

#: settings.cpp:177
msgid "If enabled, JavaScript programs are allowed to open new windows."
msgstr "De se activar, os programas en JavaScript poden abrir xanelas novas."

#: settings.cpp:178
msgid ""
"If enabled, JavaScript programs are allowed to read from and to write to the "
"clipboard."
msgstr ""
"De se activar, os programas en JavaScript poden ler e escribir no "
"portarretallos."

#: settings.cpp:179
msgid "If enabled, hyperlinks are included in the keyboard focus chain."
msgstr "De se activar, as hiperligazóns inclúense na cadea de foco do teclado."

#: settings.cpp:180
msgid "If enabled, the zoom factor on a frame is only applied to the text."
msgstr ""
"De se activar, o factor de ampliación dunha moldura só se lle aplica ao "
"texto."

#: settings.cpp:181
msgid ""
"If enabled, background colors and images are also drawn when the page is "
"printed."
msgstr ""
"De se activar, tamén se debuxan as cores de fondo e as imaxes cando se "
"imprime a páxina."

#: settings.cpp:182
msgid "Enables support for the HTML 5 offline storage feature."
msgstr "Activa a funcionalidade de almacenamento fóra de liña da HTML 5."

#: settings.cpp:183
msgid "Enables support for the HTML 5 web application cache feature."
msgstr "Activa a funcionalidade da caché de aplicacións web da HTML 5."

#: settings.cpp:184
msgid "Enables support for the HTML 5 local storage feature."
msgstr "Activa a funcionalidade de almacenamento local da HTML 5."

