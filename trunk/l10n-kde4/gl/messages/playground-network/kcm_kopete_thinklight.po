#. i18n: ectx: label, entry (Duration), group (Think Light Plugin)
#: kopete_thinklight.kcfg:11
#, kde-format
msgid "Flash duration in milliseconds."
msgstr "Duración do flash en milisegundos."

#. i18n: ectx: label, entry (NumFlashes), group (Think Light Plugin)
#: kopete_thinklight.kcfg:18
#, kde-format
msgid "Number of flashes."
msgstr "Número de flashes."

#. i18n: ectx: label, entry (Path), group (Think Light Plugin)
#: kopete_thinklight.kcfg:25
#, kde-format
msgid "Path to thinklight device file."
msgstr "Ruta ao ficheiro do dispositivo thinklight."

#. i18n: ectx: label, entry (initScript), group (Think Light Plugin)
#: kopete_thinklight.kcfg:30
#, kde-format
msgid "Path to thinklight initialization script."
msgstr "Ruta ao script de inicialización de thinklight."

#: thinklightplugin.cpp:73
#, kde-format
msgid ""
"%1 does not exist. If you have a Thinkpad laptop, please do a \"modprobe "
"ibm_acpi\" as root."
msgstr ""
"%1 non existe. Se ten un portátil Thinkpad, faga un «modprobe ibm_acpi» como "
"usuario root."

#: thinklightplugin.cpp:79
#, kde-format
msgid ""
"%1 cannot be written to. Thinklight plugin could not initialize correctly. "
"Please contact your system administrator."
msgstr ""
"Non se pode escribir en %1. O complemento Thinklight non se puido inicializar "
"correctamente. Contacte co seu administrador de sistema."

#: thinklightplugin.cpp:91
#, kde-format
msgid ""
"The program \"kopete_thinklght_fixpermissons\" failed to start. Please "
"contact your system administrator."
msgstr ""
"O programa «kopete_thinklght_fixpermissons» non se dá iniciado. Contacte co "
"seu administrador de sistema."

#: thinklightplugin.cpp:94
#, kde-format
msgid ""
"The program \"kopete_thinklght_fixpermissons\" failed with error %1. Please "
"contact your system administrator."
msgstr ""
"O programa «kopete_thinklght_fixpermissons» fallou co erro %1. Contacte co "
"seu administrador de sistema."

