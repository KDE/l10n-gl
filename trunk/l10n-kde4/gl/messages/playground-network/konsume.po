#: ebay.cpp:37
#, kde-format
msgid ""
"There was an error parsing eBay's XML Response: Line %1, Column %2: %3\n"
"\n"
"%4"
msgstr ""
"Houbo un erro ao a analizar a resposta XML de eBay: Liña %1, columna %2: %3\n"
"\n"
"%4"

#: ebay.cpp:37 ebay.cpp:47 ebay.cpp:212 ebay.cpp:525
msgid "XML Response Error"
msgstr "Erro na resposta XML"

#: ebay.cpp:47
msgid "The response's ack-tag is not present or did not indicate success."
msgstr "A etiqueta ack da resposta non está presente ou non indica éxito."

#: ebay.cpp:67
msgid "setting authentication token."
msgstr "a configurar o token de autenticación."

#: ebay.cpp:124
#, kde-format
msgid "There was an error communicating with the eBay servers: %1"
msgstr "Houbo un erro ao tentar comunicar cos servidores de eBay: %1"

#: ebay.cpp:124
msgid "HTTP Communication Error"
msgstr "Erro de comunicación de HTTP"

#: ebay.cpp:175
msgid "Are you sure you want to revoke the saved eBay authentication token?"
msgstr "Ten certeza de querer revogar o token de autenticación de eBay?"

#: ebay.cpp:175
msgid "Reset token"
msgstr "Reiniciar o token"

#: ebay.cpp:212
msgid "Unable to revoke eBay authentication token."
msgstr "Foi imposíbel revogar o token de autenticación de eBay."

#: ebay.cpp:280
msgid "Could not find session ID in response."
msgstr "Non foi posíbel atopar o identificador da sesión da resposta."

#: ebay.cpp:280 ebay.cpp:353 ebay.cpp:624 ebay.cpp:678
msgid "Response Error"
msgstr "Erro na resposta"

#: ebay.cpp:290
msgid ""
"Please wait for a browser to open eBay's login-page, log in and follow the "
"instructions. Then, press Ok."
msgstr ""
"Agarde a que un navegador abra a páxina de rexistro de eBay, rexístrese e "
"siga as instrucións. A seguir, prema Aceptar."

#: ebay.cpp:290 ebay.cpp:291
msgid "Generating Token"
msgstr "A xerar o token"

#: ebay.cpp:291
msgid "Did you successfully link your account to the generated token?"
msgstr "Ligou con éxito a súa conta ao token xerado?"

#: ebay.cpp:314
msgid "Internal Error"
msgstr "Erro interno"

#: ebay.cpp:353
msgid "Could not find auth token in response."
msgstr "Non foi posíbel atopar o token de autenticación na resposta."

#: ebay.cpp:380
msgid ""
"Please generate an eBay-authentication-token for access to your eBay-"
"Watchlist using the Settings-tab."
msgstr ""
"Xere un token de autenticación de eBay para acceder á súa lista de vixilancia "
"de eBay na lapela Configuración."

#: ebay.cpp:380
msgid "Setup required"
msgstr "Requírese configurar"

#: ebay.cpp:525
msgid "Could not find timestamp in response."
msgstr "Non foi posíbel atopar a marca temporal na resposta."

#: ebay.cpp:624
msgid "The current Item is not an XML-Element."
msgstr "Este elemento non é un elemento XML."

#: ebay.cpp:678
msgid "Could not confirm item deletion from watchlist"
msgstr ""
"Non foi posíbel confirmar que se eliminou o elemento da lista de vixilancia"

#: konsume.cpp:23
msgid "Open in Browser"
msgstr "Abrir nun navegador"

#: konsume.cpp:24
msgid "Remove from Watchlist"
msgstr "Eliminar da lista de vixilancia"

#: konsume.cpp:272
