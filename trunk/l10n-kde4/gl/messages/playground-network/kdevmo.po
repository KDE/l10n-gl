#. i18n: tag string
#. i18n: file prefsdialog.ui line 64
#: rc.cpp:12
msgid ""
"<b>Refresh time</b>\n"
"<p>\n"
"The refresh time determines how often diagrams and stats are updated. You "
"can select one of the proposed values or edit the field manually.\n"
"</p>"
msgstr ""
"<b>Tempo de refresco</b>\n"
"<p>\n"
"O tempo de refresco determina o periodo entre actualizacións dos diagramas e "
"estatísticas. Pode escoller un dos valores propostos ou editar manualmente o "
"campo.</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 67
#: rc.cpp:18
msgid "Refresh time"
msgstr "Tempo de refresco"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 83
#. i18n: tag string
#. i18n: file prefsdialog.ui line 92
#: rc.cpp:21 rc.cpp:30
msgid "Smooth factor"
msgstr "Factor de suavizado"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 89
#: rc.cpp:24
msgid ""
"<b>Smooth factor</b>\n"
"<p>\n"
"A smooth factor of <b>n</b> means that the last <b>n</b> traffic values are "
"averaged. With a high <b>n</b> the graphs look smoother. You can choose one "
"of the values in the combo box or select a custom value.\n"
"</p>"
msgstr ""
"<b>Factor de suavizado</b>\n"
"<p>\n"
"Un factor de suavizado de <b>n</b> significa que os últimos <b>n</b> valores "
"de tránsito son promediados. Cun <b>n</b> alto os gráficos son máis suaves. "
"Pode escoller un dos valores na lista despregábel ou un valor "
"personalizado.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 134
#. i18n: tag string
#. i18n: file prefsdialog.ui line 143
#. i18n: tag string
#. i18n: file prefsdialog.ui line 611
#. i18n: tag string
#. i18n: file prefsdialog.ui line 620
#: rc.cpp:33 rc.cpp:42 rc.cpp:206 rc.cpp:215
msgid "Colors"
msgstr "Cores"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 140
#: rc.cpp:36
msgid ""
"<b>Colors</b>\n"
"<p>\n"
"Set the colors for incoming and outgoing traffic. This influences both the "
"diagram and the stats views.\n"
"</p>"
msgstr ""
"<b>Cores</b>\n"
"<p>\n"
"Estabelece as cores do tránsito entrante e saínte. Isto afecta tanto á vista "
"de diagrama como á de estatísticas.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 168
#: rc.cpp:45
msgid "Incoming traffic"
msgstr "Tránsito entrante"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 184
#: rc.cpp:48
msgid "Outgoing traffic"
msgstr "Transito saínte"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 214
#. i18n: tag string
#. i18n: file prefsdialog.ui line 223
#: rc.cpp:51 rc.cpp:60
msgid "Unit"
msgstr "Unidade"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 220
#: rc.cpp:54
msgid ""
"<b>Unit</b>\n"
"<p>\n"
"Set whether the stats are shown in bits or bytes per second.\n"
"</p>"
msgstr ""
"<b>Unidade</b>\n"
"<p>\n"
"Indica se mostrar as estatísticas en bits ou en bytes por segundo.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 235
#: rc.cpp:63
msgid "Bytes per second"
msgstr "Bytes por segundo"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 248
#: rc.cpp:66
msgid "Bits per second"
msgstr "Bits por segundo"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 263
#: rc.cpp:69
msgid "Diagram"
msgstr "Diagrama"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 301
#: rc.cpp:72
msgid "Network device"
msgstr "Dispositivo de rede"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 307
#: rc.cpp:75
msgid ""
"<b>device</b>\n"
"<p>\n"
"Set the device to be monitored. If the device you look for is not in the "
"list you can edit the field manually.\n"
"</p>"
msgstr ""
"<b>dispositivo</b>\n"
"<p>\n"
"Indica o dispositivo a vixiar. Se o dispositivo que anda a procurar non está "
"na lista pode editar manualmente o campo.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 310
#: rc.cpp:81
msgid "Device"
msgstr "Dispositivo"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 326
#: rc.cpp:84
msgid "Graph style"
msgstr "Estilo do gráfico"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 332
#: rc.cpp:87
msgid ""
"<b>Graph style</b>\n"
"<p>\n"
"Set the graph style. It determines whether the graph is drawn <b>shaded</b>, "
"<b>solid</b> or with <b>lines</b>.\n"
"</p>"
msgstr ""
"<b>Estilo do gráfico</b>\n"
"<p>\n"
"Estabelece o estilo do gráfico. Isto determina se o gráfico é <b>sombreado</"
"b>, <b>sólido</b> ou con <b>liñas</b>.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 335
#: rc.cpp:93
msgid "Graph Style"
msgstr "Estilo do gráfico"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 347
#: rc.cpp:96
msgid "Shaded"
msgstr "Sombreado"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 360
#: rc.cpp:99
msgid "Solid"
msgstr "Sólido"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 373
#: rc.cpp:102
msgid "Lines"
msgstr "Liñas"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 387
#: rc.cpp:105
msgid "Scaling mode (determines how small traffic rates are drawn)"
msgstr ""
"Modo de escalado (determina o pequenas que se debuxan as taxas de tránsito "
"pequenas)"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 394
#: rc.cpp:108
msgid ""
"<b>Scaling mode</b>\n"
"<p>\n"
"<b>Cubic root</b> means that the diagrams are drawn with the cubic root of "
"each traffic value. The result is that small values are shown higher than "
"they are.\n"
"<b>Normal</b> means just what it says.\n"
"</p>"
msgstr ""
"<b>Modo de escalado</b>\n"
"<p>\n"
"<b>Raíz cúbica</b> significa que os diagramas son debuxados coa raíz cúbica "
"de cada valor de tránsito. O resultado é que os valores pequenos son "
"debuxados maiores do de son.\n"
"<b>Normal</b> indica iso mesmo.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 397
#: rc.cpp:115
msgid "Scaling mode"
msgstr "Modo de escalado"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 409
#: rc.cpp:118
msgid "Normal"
msgstr "Normal"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 422
#: rc.cpp:121
msgid "Cubic root"
msgstr "Raíz cúbica"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 436
#. i18n: tag string
#. i18n: file prefsdialog.ui line 446
#: rc.cpp:124 rc.cpp:134
msgid "Graph position"
msgstr "Posición do gráfico"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 443
#: rc.cpp:127
msgid ""
"<b>Graph position</b>\n"
"<p>\n"
"<b>Top and bottom</b> means that the output graph is drawn on the top of the "
"frame and the output graph on the bottom.<br>\n"
"With <b>Only bottom</b> the input graph is drawn on the bottom of the frame "
"and the output graph on top of the input graph.\n"
"</p>"
msgstr ""
"<b>Posición do gráfico</b>\n"
"<p>\n"
"<b>Arriba e abaixo</b> significa que o gráfico de entrada é debuxado na "
"parte de riba da área e o de saída na de baixo.<br>\n"
"Con <b>Só ao fondo</b> o gráfico de entrada é debuxado ao fondo da moldura e "
"o de saída sobre o de entrada.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 458
#: rc.cpp:137
msgid "Top and bottom"
msgstr "Arriba e abaixo"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 471
#: rc.cpp:140
msgid "Only bottom"
msgstr "Só ao fondo"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 485
#: rc.cpp:143
msgid "Scale factor (bits per second)"
msgstr "Factor de escala (bits por segundo)"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 491
#: rc.cpp:146
msgid ""
"<b>Scaling</b>\n"
"<p>\n"
"Set the scaling of the diagrams (bits per second). It is a good idea to "
"select the maximum throughput rate of your device. If none of the entries "
"fits edit the field manually.\n"
"</p>"
msgstr ""
"<b>Escalado</b>\n"
"<p>\n"
"Indica o escalado dos diagramas (bits por segundo). É boa idea escoller a "
"taxa máxima de transferencia do dispositivo. Se nengunha das alternativas se "
"corresponde edite o campo manualmente.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 494
#: rc.cpp:152
msgid "Scaling (bits per second)"
msgstr "Escalado (bits or segundo)"

#. i18n: tag string
