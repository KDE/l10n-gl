#. i18n: tag string
#. i18n: file prefsdialog.ui line 551
#: rc.cpp:173
msgid ""
"<b>Transparent</b>\n"
"<p>\n"
"Toggle pseudo transparency for the main frame.\n"
"</p>"
msgstr ""
"<b>Transparente</b>\n"
"<p>\n"
"Comuta a pseudotransparencia na áreaa principal.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 554
#: rc.cpp:179
