msgid "Show tooltips"
msgstr "Mostrar as axudiñas"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 697
#: rc.cpp:227
msgid ""
"<b>Show tooltips</b>\n"
"<p>\n"
"If this checkbox is enabled a tooltip is shown when you hold the mouse "
"cursor on the main Frame. The tooltip shows the throughput rate of the "
"device during a particular time.\n"
"</p>"
msgstr ""
"<b>Mostrar as axudiñas</b>\n"
"<p>\n"
"Se sinala esta opción mostrarase unha axudiña cando deixe o rato na área "
"principal. Esta axudiña mostrará a taxa de tránsito do dispositivo durante "
"un tempo determinado.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 714
#: rc.cpp:236
msgid "Other frames"
msgstr "Outras areas"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 722
#: rc.cpp:239
