#. i18n: file prefsdialog.ui line 855
#: rc.cpp:272 rc.cpp:281
msgid "Stats frame"
msgstr "Área de estatísticas"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 852
#: rc.cpp:275
msgid ""
"<b>Stats frame</b>\n"
"<p>\n"
"Set the background and the foreground color of the stats frame. The stats "
"frame is the small window that shows some stats and popups when you middle-"
"click on the dock or the main frame.\n"
"</p>"
msgstr ""
"<b>Área de estatísticas</b>\n"
"<p>\n"
"Indica a core de fondo e primeiro plano da área de estatísticas. Esta área é "
"a fiestra pequena que mostra algunhas estatísticas e que aparece cando preme "
"co botón central do rato na acoplaxe ou na área principal.\n"
"</p>"

