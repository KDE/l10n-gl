#: rc.cpp:158
msgid ""
"<b>Show grid</b>\n"
"<p>\n"
"Decide whether the diagram in the main frame should show a grid or not.\n"
"</p>"
msgstr ""
"<b>Mostrar a grella</b>\n"
"<p>\n"
"Indica de o diagrama na área principal debe ter unha grella ou non.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 533
#: rc.cpp:167
msgid "Main frame"
