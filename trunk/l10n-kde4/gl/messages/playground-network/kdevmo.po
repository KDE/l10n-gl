#. i18n: tag string
#. i18n: file prefsdialog.ui line 573
#: rc.cpp:185
msgid ""
"<b>Show decorations</b>\n"
"<p>\n"
"If this checkbox is not selected the main frame has no window decorations "
"like titlebar and borders.\n"
"</p>"
msgstr ""
"<b>Mostrar as decoracións</b>\n"
"<p>\n"
"Se non sinala esta opción a área principal non terá decoracións de fiestra "
"como barra de título e contornos.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 589
#. i18n: tag string
#. i18n: file prefsdialog.ui line 598
#: rc.cpp:194 rc.cpp:203
msgid "Show stats bar"
msgstr "Mostrar a barra de estado"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 595
#: rc.cpp:197
msgid ""
"<b>Show stats bar</b>\n"
"<p>\n"
"Choose whether the small bar that shows the current traffic rate should be "
"shown.\n"
"</p>"
msgstr ""
"<b>Mostrar a barra de estado</b>\n"
"<p>\n"
"Escolle se debe mostrarse a barriña que mostra a taxa de tránsito actual.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 617
#: rc.cpp:209
msgid ""
"<b>Colors</b>\n"
"<p>\n"
"Set the colors for background and grid. \n"
"</p>"
msgstr ""
"<b>Cores</b>\n"
"<p>\n"
"Estabelece as cores do fondo e da grella.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 658
#. i18n: tag string
#. i18n: file prefsdialog.ui line 737
#. i18n: tag string
#. i18n: file prefsdialog.ui line 867
#: rc.cpp:218 rc.cpp:251 rc.cpp:284
