msgstr "acoplaxe"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 728
#: rc.cpp:242
msgid ""
"<b>Dock frame</b>\n"
"<p>\n"
"Select the background color and the grid color of the diagram in the dock "
"frame.\n"
"</p>"
msgstr ""
"<b>Acoplaxe</b>\n"
"<p>\n"
"Escolle a cor de fondo e da grella do diagrama na acoplaxe.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 731
#: rc.cpp:248
msgid "Dock frame"
msgstr "Acoplaxe"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 771
#. i18n: tag string
#. i18n: file prefsdialog.ui line 780
#: rc.cpp:257 rc.cpp:266
msgid "Show text instead of diagram"
msgstr "Mostrar texto no canto do diagrama"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 777
#: rc.cpp:260
msgid ""
"<b>Show grid instead of diagram</b>\n"
"<p>\n"
"If this box is checked the dock frame shows the current traffic value "
"instead of a diagram.\n"
"</p>"
msgstr ""
"<b>Mostrar texto no canto do diagrama</b>\n"
"<p>\n"
"Se escolle esta opción a acoplaxe mostrará o valor actual do tránsito no "
"canto dun diagrama.\n"
"</p>"

#. i18n: tag string
#. i18n: file prefsdialog.ui line 805
#: rc.cpp:269
