#: telepathy_launcher.desktop:9
msgctxt "Name"
msgid "Telepathy Launcher"
msgstr "Iniciador do Telepathy"

#: telepathy_launcher.desktop:32
msgctxt "Comment"
msgid ""
"A tool to make sure Telepathy infrastructure components needed by the KDE "
"session are running"
msgstr ""
"Unha ferramenta para asegurarse de que se están a executar os compoñentes da "
"infraestrutura do Telepathy que precisa a sesión do KDE"
