#: AirsyncDownloadResource.cxx:77
#, kde-format
msgid "The resource is not configured correctly and can not work."
msgstr "O recurso non está configurado correctamente e non pode funcionar."

#: AirsyncDownloadResource.cxx:83
#, kde-format
msgid "The resource is offline."
msgstr "O recurso está desconectado."

#: AirsyncDownloadResource.cxx:91
#, kde-format
msgid "Mail check already in progress, unable to start a second check."
msgstr ""
"Xa se está a comprobar o correo; non é posíbel iniciar unha segunda "
"comprobación."

#: AirsyncDownloadResource.cxx:122
#, kde-format
msgid "Mail check aborted."
msgstr "Cancelouse a comprobación do correo."

#: AirsyncDownloadResource.cxx:133
#, kde-format
msgid "Mail check was canceled manually."
msgstr "Cancelouse manualmente a comprobación do correo."

#: AirsyncDownloadResource.cxx:134
#, kde-format
msgid "Ready"
msgstr "Listo"

#: AirsyncDownloadResource.cxx:180
#, kde-format
msgid "The configured mail target folder is not valid"
msgstr "O cartafol de destino configurado para o correo non é correcto."

#: AirsyncDownloadResource.cxx:225
#, kde-format
msgid "The server authentication failed. Check username and password."
msgstr ""
"Fallou a autenticación co servidor. Revise o seu nome de usuario e "
"contrasinal."

#: AirsyncDownloadResource.cxx:239
#, kde-format
msgid "Checking for new mails"
msgstr "Comprobando se hai mensaxes novas."

#: AirsyncDownloadResource.cxx:256
#, kde-format
msgid "Could not fetch mails from server"
msgstr "Non se puido obter o correo do servidor."

#: AirsyncDownloadResource.cxx:278
#, kde-format
msgid "Deleting mails from the server."
msgstr "Eliminando as mensaxes do servidor."

#: AirsyncDownloadResource.cxx:282
#, kde-format
msgid "Could not delete mails from the server"
msgstr "Non foi pos'ibel eliminar as mensaxes do servidor."

#: AirsyncDownloadResource.cxx:295
#, kde-format
msgid "Finished mail check, no mails downloaded."
msgstr "Rematou a comprobación do correo, non se descargou ningunha mensaxe."

#: AirsyncDownloadResource.cxx:298
#, kde-format
msgid "Finished mail check, 1 mail downloaded."
msgid_plural "Finished mail check, %1 mails downloaded."
msgstr[0] "Rematou a comprobación do correo, descargouse 1 mensaxe."
msgstr[1] "Rematou a comprobación do correo, descargáronse %1 mensaxes."

#: AirsyncDownloadResource.cxx:331
#, kde-format
msgid "Unable to store downloaded mails."
msgstr "Foi imposíbel almacenar o correo descargado."

#: AirsyncDownloadResource.cxx:353
#, kde-format
msgid "Mail check aborted after going offline."
msgstr "Interrompeuse a comprobación do correo ao desconectarse."

#: SettingsDialog.cxx:49
#, kde-format
msgid "AirSyncDownload Account Settings"
msgstr "Configuración da conta de AirSyncDownload"

#: SettingsDialog.cxx:56
#, kde-format
msgid " minute"
msgid_plural " minutes"
msgstr[0] " minuto"
msgstr[1] " minutos"

#: SettingsDialog.cxx:125
#, kde-format
msgid "Wallet disabled in system settings"
msgstr "Carteira desactivada na configuración do sistema."
