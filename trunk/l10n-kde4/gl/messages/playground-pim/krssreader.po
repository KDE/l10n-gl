#: importitemsjob.cpp:120
msgid "Could not generate a temporary file for export."
msgstr "Non foi posíbel xerar un ficheiro temporal a onde exportar."

#: importitemsjob.cpp:131
#, kde-format
msgid ""
"Could not start storage exporter %1. Make sure it is properly installed."
msgstr ""
"Non foi posíbel iniciar o exportador de almacén %1. Verifique que estea "
"correctamente instalado."

#: importitemsjob.cpp:140
#, kde-format
msgid "Item export failed. Storage exporter %1 crashed."
msgstr ""
"Fallou a exportación do ítem. O exportador de almacén %1 pechouse "
"inesperadamente."

#: importitemsjob.cpp:147
#, kde-format
msgid "Item export failed. Storage exporter %1 returned exit code %2."
msgstr ""
"Fallou a exportación do ítem. O exportador de almacén %1 devolveu o código "
"de saída %2."

#: importitemsjob.cpp:154
msgid "Item import failed, target resource was already deleted."
msgstr "Fallou a importación do ítem, o recurso de destino xa fora borrado."

