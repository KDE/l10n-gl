#: migratefeedscommand.cpp:60 migratefeedscommand.cpp:204
msgid "Akonadi Data Migration"
msgstr "Migración de datos de Akonadi"

#: migratefeedscommand.cpp:62
msgid ""
"Since version 1.4, Akregator uses the Akonadi framework to store feeds and "
"articles. Your feeds and articles from older Akregator versions will now be "
"migrated."
msgstr ""
"Desde a versión 1.4 Akregator emprega o framework Akonadi para gardar "
"fontes "
"e artigos. Agora vanse migrar as fontes e artigos de versións anteriores de "
"Akregator."

#: migratefeedscommand.cpp:66
msgid "Please choose the resource to use for importing feeds and articles."
msgstr "Escolla o recurso a empregar para importar fontes e artigos."

#: migratefeedscommand.cpp:74
msgid "Resource:"
msgstr "Recurso:"

#: migratefeedscommand.cpp:124
#, kde-format
#| msgid "Import failed: %1 (%2)"
msgid "Failed: %1 (%2)"
msgstr "Fallou: %1 (%2)"

#: migratefeedscommand.cpp:128
#, kde-format
msgid "Success: %1"
msgstr "Éxito: %1"

#: migratefeedscommand.cpp:293
#, kde-format
msgid ""
"<p>The import of the existing feed list failed:</p><p>%1</p><p>Could not "
"import your feeds and archived articles!</p>"
msgstr ""
"<p>Fallou a importación da lista de fontes existente:</p> <p>%1</p> "
"<p>Non foi posíbel importar as fontes e artigos arquivados!</p>"

#: migratefeedscommand.cpp:297
msgid ""
"<p>The existing feed list was successfully imported. In the next step, the "
"archived articles from these feeds will be imported.</p>"
msgstr ""
"<p>Importouse con éxito a lista de fontes existentes. No seguinte paso "
"importaranse os artigos arquivados desas fontes.</p>"

#: migratefeedscommand.cpp:307
msgid "Importing feed list..."
msgstr "A importar a lista de fontes..."

#: migratefeedscommand.cpp:312
msgid "Import of archived articles finished."
msgstr "Rematou a importación de artigos arquivados."

#: migratefeedscommand.cpp:327
msgid "TODO"
msgstr "POR FACER"

#: migratefeedscommand.cpp:327
#, kde-format
