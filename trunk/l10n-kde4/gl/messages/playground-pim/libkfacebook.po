#: error.cpp:47
#| msgid "The XML response from the server could not be parsed"
msgid "The XML response from the server could not be parsed."
msgstr "Non foi posíbel procesar a resposta XML do servidor."

#: error.cpp:50
msgid "No error.  You can test for this using Error::isValid()."
msgstr "Non hai erro ningún. Pode probar isto usando Error::isValid()."

#: error.cpp:53
msgid "An unknown error occurred. Please resubmit the request."
msgstr "Aconteceu un erro descoñecido. Por favor envíe de novo o pedido."

#: error.cpp:56
msgid "The service is not available at this time."
msgstr "O servizo non está dispoñíbel neste instante."

#: error.cpp:59
msgid ""
"The application has reached the maximum number of requests allowed. More "
"requests are allowed once the time window has completed."
msgstr ""
"O programa acadou o número máximo de pedidos que se lle permiten. Poderá "
"facer máis cando se complete a xanela temporal."

#: error.cpp:62
msgid "The request came from a remote address not allowed by this application."
msgstr "O pedido chegou dun enderezo remoto non admitido por este programa."

#: error.cpp:65
msgid "One of the parameters specified was missing or invalid."
msgstr "Faltaba un dos parámetros especificados ou non era válido."

#: error.cpp:68
msgid "The api key submitted is not associated with any known application."
msgstr "A chave da api enviada non está asociada con ningún programa coñecido."

#: error.cpp:71
msgid ""
"The session key was improperly submitted or has reached its timeout. Direct "
"the user to log in again to obtain another key."
msgstr ""
"A chave da sesión foi enviada impropiamente ou acadou o seu tempo límite. "
"Dígalle ao usuario que acceda de novo para obter outra chave."

#: error.cpp:74
msgid ""
"The submitted call_id was not greater than the previous call_id for this "
"session."
msgstr "A call_id enviada non era maior que a anterior call_id desta sesión."

#: error.cpp:77
msgid "Incorrect signature."
msgstr "A sinatura é incorrecta."

#: error.cpp:80
msgid "Invalid user id."
msgstr "A id de usuario non é válida."

#: error.cpp:83
msgid "Invalid photo id."
msgstr "A id da foto non é válida."

#: error.cpp:86
msgid "The uid cannot be specified from a desktop application."
msgstr "Non se pode especificar o uid desde un programa de escritorio."

#: error.cpp:89
msgid "Invalid photo tag subject."
msgstr "O asunto da etiqueta da foto non é válido."

#: error.cpp:92
msgid "Cannot tag photo already visible on Facebook."
msgstr "Non se pode etiquetar unha foto xa visíbel en Facebook."

#: error.cpp:95
msgid "Too many photo tags pending."
msgstr "Hai demasiadas etiquetas de foto pendentes."

#: error.cpp:98
msgid "The markup was invalid"
msgstr "As etiquetas non eran válidas"

#: error.cpp:101
msgid "Error while parsing FQL statement."
msgstr "Erro ao procesar a sentenza FQL."

#: error.cpp:104
msgid "The field you requested does not exist."
msgstr "O campo que pediu non existe."

#: error.cpp:107
msgid "The table you requested does not exist."
msgstr "A táboa que pediu non existe."

#: error.cpp:110
msgid "Your statement is not indexable."
msgstr "A súa sentenza non é indexábel."

#: error.cpp:113
msgid "The function you called down not exist."
msgstr "A función que chamou non existe."

#: error.cpp:116
msgid "Wrong number of arguments passed into the function."
msgstr "Pasóuselle un número incorrecto de argumentos á función."

#: error.cpp:119
msgid "An unrecognized error was received from Facebook."
msgstr "Recibiuse un erro non recoñecido de Facebook."

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "mvillarino"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "mvillarino@users.sourceforge.net"

