#: fetchfeedjob.cpp:277
msgid "File downloading/parsing was aborted."
msgstr "Abortouse a obtención/procesamento do ficheiro."

#: fetchfeedjob.cpp:278
msgid "File download timed out."
msgstr "Esgotouse o tempo-límite da obtención do ficheiro."

#: fetchfeedjob.cpp:279
#, fuzzy
#| msgid "The hostname couldn't get resolved to an IP address."
msgid "The hostname could not be resolved to an IP address."
msgstr "Non foi posíbel resolver o nome do servidor a un enderezo IP."

#: fetchfeedjob.cpp:280
msgid "The host was contacted successfully, but reported a 404 error."
msgstr "Contactouse co servidor, pero informou dun erro 404."

#: fetchfeedjob.cpp:281
msgid "Retriever error not covered by the error codes above."
msgstr ""
"O erro que se obtivo non está cuberto por ningún dos códigos de erro de riba."

#: fetchfeedjob.cpp:282
msgid "The XML is invalid."
msgstr "O XML non é válido."

#: fetchfeedjob.cpp:283
msgid "The source is valid XML, but no parser accepted it."
msgstr ""
"A fonte é XML válido, pero non foi aceptado por ningún analizador de sintaxe."

#: fetchfeedjob.cpp:284
msgid "The source was accepted by a parser, but the actual parsing failed."
msgstr "A fonte foi aceptada por un analizador, pero a análise fallou."

#: importitemsjob.cpp:53
#, kde-format
msgid "Could not open file %1 for reading."
msgstr "Non foi posíbel abrir o ficheiro %1 para lectura."

#: rssresource.cpp:346
msgid "OPML Document (*.opml)"
msgstr "Documento OPML (*.opml)"

#: rssresource.cpp:347
msgid "Select an OPML Document"
msgstr "Escoller un documento OPML"
