msgstr "O paquete xa está instalado"

#: Common/KpkStrings.cpp:293
msgid "The package download failed"
msgstr "Fallou a obtención do paquete"

#: Common/KpkStrings.cpp:295
msgid "The group was not found"
msgstr "Non se achou o grupo"

#: Common/KpkStrings.cpp:297
msgid "The group list was invalid"
msgstr "A lista de grupo non era válida"

#: Common/KpkStrings.cpp:299
msgid "Dependency resolution failed"
msgstr "Fallou a resolución de dependencias"

#: Common/KpkStrings.cpp:301
msgid "Search filter was invalid"
msgstr "O filtro de procuras non era válido"

#: Common/KpkStrings.cpp:303
msgid "Failed to create a thread"
msgstr "Non foi posíbel criar un fío"

#: Common/KpkStrings.cpp:305
msgid "Transaction error"
msgstr "Erro da transacción"

#: Common/KpkStrings.cpp:307
msgid "The task was canceled"
msgstr "Cancelouse a tarefa"

#: Common/KpkStrings.cpp:309
msgid "No package cache is available"
msgstr "Non se dispón de caché de paquetes"

#: Common/KpkStrings.cpp:311
msgid "Repository name was not found"
msgstr "Non se atopou o nome do repositorio"

#: Common/KpkStrings.cpp:313
msgid "Could not remove a protected system package"
msgstr "Non foi posíbel eliminar do sistema un paquete protexido"

#: Common/KpkStrings.cpp:315
msgid "The task was forcibly canceled"
msgstr "A tarefa cancelouse pola forza"

#: Common/KpkStrings.cpp:317
msgid "Failed to initialize"
msgstr "Fallou a inicialización"

#: Common/KpkStrings.cpp:319
msgid "Failed to finalize"
msgstr "Fallou a finalización"

#: Common/KpkStrings.cpp:321
msgid "Reading the config file failed"
msgstr "Fallou a leitura do ficheiro de configuración"

#: Common/KpkStrings.cpp:323
msgid "The task cannot be cancelled"
msgstr "Non foi posíbel cancelar a tarefa"

#: Common/KpkStrings.cpp:325
msgid "Cannot get lock"
msgstr "Non é posíbel obter o bloqueo"

#: Common/KpkStrings.cpp:327
msgid "No packages to update"
msgstr "Non hai nengún paquete para actualizar"

#: Common/KpkStrings.cpp:329
msgid "Cannot write repository configuration"
msgstr "Non é posíble escreber a configuración do repositorio"

#: Common/KpkStrings.cpp:331
msgid "Local install failed"
msgstr "Fallou a instalación local"

#: Common/KpkStrings.cpp:333
msgid "Bad GPG signature"
msgstr "Sinatura GPG incorrecta"

#: Common/KpkStrings.cpp:335
msgid "Missing GPG signature"
msgstr "Falta a sinatura GPG"

#: Common/KpkStrings.cpp:337
msgid "Source packages cannot be installed"
msgstr "Non foi posíbel instalar os paquetes de fontes"

#: Common/KpkStrings.cpp:339
msgid "Repository configuration invalid"
msgstr "A configuración do repositorio non é válida"

#: Common/KpkStrings.cpp:341
msgid "The license agreement failed"
msgstr "Fallou a aceitación da licenza"

#: Common/KpkStrings.cpp:343
msgid "Local file conflict between packages"
msgstr "Hai un conflito entre paquetes sobre un ficheiro local"

#: Common/KpkStrings.cpp:345
msgid "Packages are not compatible"
msgstr "Os paquetes non son compatíbeis"

#: Common/KpkStrings.cpp:347
msgid "Problem connecting to a software source"
msgstr "Aconteceu un problema ao conectar a unha fonte de software"

#: Common/KpkStrings.cpp:349
msgid "Invalid package file"
msgstr "Ficheiro de paquete non válido"

#: Common/KpkStrings.cpp:351
msgid "Package install blocked"
msgstr "Paquete instalado bloqueado"

#: Common/KpkStrings.cpp:353
msgid "Package is corrupt"
msgstr "O paquete está corrompido"

#: Common/KpkStrings.cpp:355
msgid "All packages are already installed"
msgstr "Xa están instalados todos os paquetes"

#: Common/KpkStrings.cpp:357
msgid "The specified file could not be found"
msgstr "Non foi posíbel atopar o ficheiro que se especificou"

#: Common/KpkStrings.cpp:359
msgid "No more mirrors are available"
msgstr "Non hai disponíbeis máis réplicas"

#: Common/KpkStrings.cpp:361
msgid "Unknown error"
msgstr "Erro descoñecido"

#: Common/KpkStrings.cpp:372
msgid ""
"The service that is responsible for handling user requests is out of "
"memory.\n"
"Please restart your computer."
msgstr ""
"O servizo responsábel da xestión dos pedidos dos usuarios esgotou a memoria.\n"
"Reinicie o ordenador."

#: Common/KpkStrings.cpp:375
msgid ""
"There is no network connection available.\n"
"Please check your connection settings and try again"
msgstr ""
"Non dispón de conexón á rede.\n"
"Verifique a conexón á rede e probe de novo"

#: Common/KpkStrings.cpp:378
msgid ""
"The action is not supported by this backend.\n"
"Please report a bug as this shouldn't have happened."
msgstr ""
"Esa acción non está permitida pola infraestrutura.\n"
"Por favor, informe do erro, isto non debera ter acontecido."

#: Common/KpkStrings.cpp:381
msgid ""
"A problem that we were not expecting has occurred.\n"
"Please report this bug with the error description."
msgstr ""
"Aconteceu un problema que non se estaba a agardar.\n"
"Por favor informe deste erro coa descrición deste."

#: Common/KpkStrings.cpp:384
msgid ""
"A security trust relationship could not be made with software source.\n"
"Please check your security settings."
msgstr ""
"Non se puido estabelecer unha relación de confianza coa fonte de software.\n"
"Verifique a configuración da seguridade."

#: Common/KpkStrings.cpp:387
msgid ""
"The package identifier was not well formed when sent to the server.\n"
"This normally indicates an internal error and should be reported."
msgstr ""
"O identificador do paquete non estaba ben formado cando se enviou ao servidor.\n"
"Polo xeral isto indica un erro interno e debería ser informado."

#: Common/KpkStrings.cpp:390
msgid "The package that is trying to be removed or updated is not already installed."
msgstr "Non ten instalado o paquete que está a tentar eliminar ou actualizar."

#: Common/KpkStrings.cpp:392
msgid ""
"The package that is being modified was not found on your system or in any "
"software source."
msgstr ""
"O paquete que se está a modificar non foi atopado no sistema nen en nengunha fonte "
"de software."

#: Common/KpkStrings.cpp:394
msgid "The package that is trying to be installed is already installed."
msgstr "Xa está instalado o paquete que está a tentar instalar."

#: Common/KpkStrings.cpp:396
msgid ""
"The package download failed.\n"
"Please check your network connectivity."
msgstr ""
"Fallou a obtención do paquete.\n"
"Verifique a conexón á rede."

#: Common/KpkStrings.cpp:399
msgid ""
"The group type was not found.\n"
"Please check your group list and try again."
msgstr ""
"Non se atopuo o tipo do grupo.\n"
"Verifique a lista de grupos e ténteo de novo."

#: Common/KpkStrings.cpp:402
msgid ""
"The group list could not be loaded.\n"
"Refreshing your cache may help, although this is normally a software source "
"error."
msgstr ""
"Non foi posíbel cargar a lista de grupos.\n"
"Pode axudalo actualizar a caché, aínda que normalmente isto é un erro da fonte de "
"software."

#: Common/KpkStrings.cpp:406
msgid ""
"A package could not be found that allows the task to complete.\n"
"More information is available in the detailed report."
msgstr ""
"Non foi posíbel achar un paquete que permitise completar a tarefa.\n"
"Hai máis información no informe pormenorizado."

#: Common/KpkStrings.cpp:409
msgid "The search filter was not correctly formed."
msgstr "O filtro de procuras non estaba correctamente formado."

#: Common/KpkStrings.cpp:411
msgid "A thread could not be created to service the user request."
msgstr "Non foi posíbel criar un fío de execución para servir o pedido do usuario."

#: Common/KpkStrings.cpp:413
msgid ""
"An unspecified task error has occurred.\n"
"More information is available in the detailed report."
msgstr ""
"Aconteceu un erro non especificado coa tarefa.\n"
"Hai máis información no informe pormenorizado."

#: Common/KpkStrings.cpp:416
msgid "The task was canceled successfully and no packages were changed."
msgstr "A tarefa cancelouse con éxito e non se modificou nengún paquete."

#: Common/KpkStrings.cpp:418
msgid ""
"The package list needs to be rebuilt.\n"
"This should have been done by the backend automatically."
msgstr ""
"Debe reconstruir a lista de paquetes.\n"
"Isto debería ter sido feito automaticamente pola infraestrutura."

#: Common/KpkStrings.cpp:421
msgid ""
"The remote software source name was not found.\n"
"You may need to enable an item in Software Sources."
msgstr ""
"Non se achou o nome da fonte remota de software.\n"
"Poida que teña que habilitar un ítem nas Fontes de software."

#: Common/KpkStrings.cpp:424
msgid "Removing a protected system package is not alloed."
msgstr "Non se permite eliminar do sistema paquetes protexidos."

#: Common/KpkStrings.cpp:426
msgid ""
"The task was canceled successfully and no packages were changed.\n"
"The backend did not exit cleanly."
msgstr ""
"A tarefa cancelouse con éxito e non se modificou nengún paquete.\n"
"A infraestrutura non saiu limpamente."

#: Common/KpkStrings.cpp:429
msgid ""
"Failed to initialize packaging backend.\n"
"This may occur if other packaging tools are being used simultaneously."
msgstr ""
"Non foi posíbel inicializar a infraestrutura de empaquetamento.\n"
"Isto pode acontecer se está a empregar á vez outra ferramenta de paquetería."

#: Common/KpkStrings.cpp:432
msgid ""
"Failed to close down the backend instance.\n"
"This error can normally be ignored."
msgstr ""
"Non foi posíbel pechar a instancia da infraestrutura.\n"
"Normalmente pode ignorar este erro."

#: Common/KpkStrings.cpp:435
msgid ""
"The native package configuration file could not be opened.\n"
"Please make sure configuration is valid."
msgstr ""
"Non foi posíbel abrir o ficheiro nativo de configuración do paquete.\n"
"Verifique que a configuración sexa válida."

#: Common/KpkStrings.cpp:438
msgid "The task is not safe to be cancelled at this time."
msgstr "Non é seguro cancelar agora a tarefa."

#: Common/KpkStrings.cpp:440
msgid ""
"Cannot get the exclusive lock on the packaging backend.\n"
"Please close any other legacy packaging tools that may be open."
msgstr ""
"Non foi posíbel obter o bloqueo exclusivo na infraestrutura de paquetería.\n"
"Peche calquera outra ferramenta de paquetería que poda ter aberta."

#: Common/KpkStrings.cpp:443
msgid "None of the selected packages could be updated."
msgstr "Non foi posíbel actualizar nengún dos paquetes escollidos."

#: Common/KpkStrings.cpp:445
msgid "The repository configuration could not be modified."
msgstr "Non foi posíbel modificar a configuración do repositorio."

#: Common/KpkStrings.cpp:447
msgid ""
"Installing the local file failed.\n"
"More information is available in the detailed report."
msgstr ""
"Fallou a instalación do ficheiro local.\n"
"Hai máis información no informe pormenorizado."

#: Common/KpkStrings.cpp:450
msgid "The package signature could not be verified."
msgstr "Non foi posíbel comprobar a sinatura do paquete."

#: Common/KpkStrings.cpp:452
msgid ""
"The package signature was missing and this package is untrusted.\n"
"This package was not signed with a GPG key when created."
msgstr ""
"Falta a sinatura do paquete, que fica sen validar.\n"
"O paquete non foi asinado cunha chave GPG cando foi criado."

#: Common/KpkStrings.cpp:455
msgid ""
"Source packages are not normally installed this way.\n"
"Check the extension of the file you are trying to install."
msgstr ""
"Normalmente os paquetes de código fonte non son instalados deste xeito.\n"
"Comprobe a extensión do ficheiro que está a tentar instalar."

#: Common/KpkStrings.cpp:458
msgid "Repository configuration was invalid and could not be read."
msgstr "A configuración do repositorio non era válida e non se puido ler."

#: Common/KpkStrings.cpp:460
msgid ""
"The license agreement was not agreed to.\n"
"To use this software you have to accept the license."
msgstr ""
"Non se aceitou o acordo de licenza.\n"
"Para utilizar este software terá que aceitar a licenza."

#: Common/KpkStrings.cpp:463
msgid ""
"Two packages provide the same file.\n"
"This is usually due to mixing packages for different software sources."
msgstr ""
"Dous paquetes fornecen o mesmo ficheiro.\n"
"Polo xeral isto débese a que se mesturan paquetes de distintas fontes."

#: Common/KpkStrings.cpp:466
msgid ""
"Multiple packages exist that are not compatible with each other.\n"
"This is usually due to mixing packages from different software sources."
msgstr ""
"Hai varios paquetes incompatíbeis entre si.\n"
"Polo xeral isto débesa a que se mesturan paquetes de distintas fontes."

#: Common/KpkStrings.cpp:469
msgid ""
"There was a (possibly temporary) problem connecting to a software source\n"
"Please check the detailed error for further details."
msgstr ""
"Aconteceu un problema (posibelmente temporal) ao conectar cunha fonte de software\n"
"Consulte os detalles do erro."

#: Common/KpkStrings.cpp:472
msgid ""
"The package you are attempting to install is not valid.\n"
"The package file could be corrupt, or not a proper package."
msgstr ""
"O paquete que está a tentar instalar non é válido.\n"
"O ficheiro do paquete pode estar corrompido, ou non ser un paquete correcto."

#: Common/KpkStrings.cpp:475
msgid ""
"Installation of this package prevented by your packaging system's "
"configuration."
msgstr "A configuración do sistema de paquetería impediu que se instalase este paquete."

#: Common/KpkStrings.cpp:477
msgid "The package that was downloaded is corrupt and needs to be downloaded again."
msgstr "O paquete que obtivo está corrompido e debe descargalo de novo."

#: Common/KpkStrings.cpp:479
msgid "All of the packages selected for install are already installed on the system."
msgstr "Todos os paquetes escollidos para instalar están xa instalados no sistema."

#: Common/KpkStrings.cpp:481
msgid ""
"The specified file could not be found on the system.\n"
"Check the file still exists and has not been deleted."
msgstr ""
"Non foi posíbel achar no sistema o ficheiro especificado.\n"
"Comprobe que o ficheiro aínda existe e que non foi borrado."

#: Common/KpkStrings.cpp:484
