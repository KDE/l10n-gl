#. i18n: tag string
#. i18n: file backendselection.ui line 42
#: rc.cpp:3 rc.cpp:6
msgid ""
"A list of Phonon Backends found on your system.  The order here determines "
"the order Phonon will use them in."
msgstr ""
"Unha lista coas infraestruturas de Phonon que se atoparon non seu sistema. A "
"orden aquí determina a orden coa que as usará Phonon."

#. i18n: tag string
#. i18n: file backendselection.ui line 58
#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 130
#: rc.cpp:9 rc.cpp:40
msgid "Prefer"
msgstr "Preferir"

#. i18n: tag string
#. i18n: file backendselection.ui line 71
#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 101
#: rc.cpp:12 rc.cpp:31
msgid "Defer"
msgstr "Demorar"

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 23
#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 26
#: rc.cpp:15 rc.cpp:18
msgid ""
"Various categories of outputs.  For each category you may choose what device "
"you wish to output to."
msgstr ""
"Varias categorías de saídas. Para cada categoría pode escoller o dispositivo "
"onde desexa ter a saída."

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 54
#: rc.cpp:21
msgid ""
"Audio Outputs found on your system.  Choose the device that you wish sound "
"to come out of."
msgstr ""
"Saídas de són atopadas non seu sistema. Escolla o dispositivo polo que "
"desexe sacar o són."

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 58
#: rc.cpp:24
msgid ""
"The order determines the preference of the output devices. If for some "
"reason the first device cannot be used Phonon will try to use the second, "
"and\n"
"so on."
msgstr ""
"A orden determina a prioridade dos dispositivos de saída. Se por algunha "
"razón non é posíbel usar o primeiro dispositivo, Phonon tentará usar o "
"segundo, e así en diante."

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 98
#: rc.cpp:28
msgid "no preference for the selected device"
msgstr "non se indicou a prioridade do dispositivo escollido"

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 114
#: rc.cpp:34
msgid "Remove"
msgstr "Eliminar"

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 127
#: rc.cpp:37
msgid "prefer the selected device"
msgstr "preferir o dispositivo escollido"

