#. i18n: tag string
#. i18n: file ./dialogs/cursorconfigwidget.ui line 85
#: rc.cpp:365
msgid ""
"Sets the number of lines to maintain visible above and below the cursor when "
"possible."
msgstr ""
"Indica o número de liñas a manter visíbeis sobre e baixo o cursor cando sexa "
"posíbel."

#. i18n: tag string
#. i18n: file ./dialogs/cursorconfigwidget.ui line 113
#: rc.cpp:371
msgid "Text Selection Mode"
msgstr "Modo de selección de texto"

#. i18n: tag string
#. i18n: file ./dialogs/cursorconfigwidget.ui line 125
#: rc.cpp:374
