msgstr "Xeral"

#: dialogs/katedialogs.cpp:382
msgid "Cursor & Selection"
msgstr "Cursor e selección"

#: dialogs/katedialogs.cpp:383
msgid "Indentation"
msgstr "Sangrado"

#: dialogs/katedialogs.cpp:462
msgid "Off"
msgstr "Desactivado"

#: dialogs/katedialogs.cpp:463
msgid "Follow Line Numbers"
msgstr "Seguir os números de liña"

#: dialogs/katedialogs.cpp:464
msgid "Always On"
msgstr "Sempre activo"

#: dialogs/katedialogs.cpp:629
msgid "Modes & Filetypes"
msgstr "Modos e tipos de ficheiro"

#: dialogs/katedialogs.cpp:654
msgid ""
"You did not provide a backup suffix or prefix. Using default suffix: '~'"
msgstr ""
"Non indicou un prefixo ou sufixo para as salvaguardas. Usaráse o sufixo "
"predeterminado \"~\""

