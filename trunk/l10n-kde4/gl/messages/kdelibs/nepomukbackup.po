#: backupwizardpages.cpp:43 backupwizardpages.cpp:66 backupwizardpages.cpp:249
msgid "Nepomuk Backup"
msgstr "Copia de seguranza de Nepomuk"

#: backupwizardpages.cpp:44
msgid "Please choose one of the following options"
msgstr "Escolla unha destas opcións"

#: backupwizardpages.cpp:67
msgid "Performing backup"
msgstr "Estase a facer a copia de seguranza"

#: backupwizardpages.cpp:81
#, kde-format
msgctxt "@info"
msgid "Writing Nepomuk database backup to <filename>%1</filename>..."
msgstr ""
"Estase a escribir a copia de seguranza da base de datos de Nepomuk en "
"<filename>%1</filename>..."

#: backupwizardpages.cpp:99
#, kde-format
msgctxt "@info"
msgid ""
"Backup of the Nepomuk database successfully written to <filename>%1</"
"filename>."
msgstr ""
"A copia de seguranza da base de datos de Nepomuk escribiuse con éxito en "
"<filename>%1</filename>."

#: backupwizardpages.cpp:101
msgid "Backup completed successfully"
msgstr "A copia de seguranza completouse con éxito"

#: backupwizardpages.cpp:127
msgctxt "@info"
msgid "No system backups found. Please select a custom backup path."
msgstr ""
"Non se atopou ningunha copia de seguranza do sistema. Escolla unha ruta "
"personalizada para a copia."

#: backupwizardpages.cpp:181
msgid "Restoring Backup"
msgstr "Estase a repor a copia de seguranza"

#: backupwizardpages.cpp:182
msgid "The backup is being restored..."
msgstr "Estase a restaurar a copia de seguranza..."

#: backupwizardpages.cpp:210
msgid "Invalid backup file"
msgstr "O ficheiro de copia de seguranza non é válido"

#: backupwizardpages.cpp:250
msgid "Please configure the Nepomuk backup"
msgstr "Configure a copia de seguranza de Nepomuk"

#: backupwizardpages.cpp:290
msgctxt "@info"
msgid "Merging the backup into the local Nepomuk database..."
msgstr ""
"Estase a fusionar a copia de seguranza coa base de datos local de Nepomuk.."
"."

#: backupwizardpages.cpp:307
msgctxt "@info"
msgid "Backup restored successfully"
msgstr "A copia de seguranza restaurouse con éxito"

