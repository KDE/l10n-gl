"Non foi posíbel criar a ligazón simbólica %1.\n"
"Verifique os permisos."

#: kio/global.cpp:338
#, kde-format
msgid ""
"Could not write file %1.\n"
"Disk full."
msgstr ""
"Non foi posíbel escreber no ficheiro %1.\n"
"O disco está completo."

#: kio/global.cpp:341
#, kde-format
msgid ""
"The source and destination are the same file.\n"
"%1"
msgstr ""
"A orixe e o destino son o mesmo ficheiro.\n"
"%1"

#: kio/global.cpp:347
#, kde-format
msgid "%1 is required by the server, but is not available."
msgstr "O servidor requere %1, pero non está disponíbel."

#: kio/global.cpp:350
msgid "Access to restricted port in POST denied."
msgstr "Denegouse o aceso no POST a un porto restrinxido."

#: kio/global.cpp:353
#, kde-format
msgid ""
"Unknown error code %1\n"
"%2\n"
"Please send a full bug report at http://bugs.kde.org."
msgstr ""
"Código de erro %1 descoñecido\n"
"%2\n"
"Por favor, envíe un informe de erro en http://bugs.kde.org."

#: kio/global.cpp:363
#, kde-format
msgid "Opening connections is not supported with the protocol %1."
msgstr "Non está soportada a abertura de conexóns co protocolo %1."

#: kio/global.cpp:365
#, kde-format
msgid "Closing connections is not supported with the protocol %1."
msgstr "Non está soportado o peche de conexóns co protocolo %1."

#: kio/global.cpp:367
#, kde-format
msgid "Accessing files is not supported with the protocol %1."
msgstr "Non está soportado o aceso a ficheiros co protocolo %1."

#: kio/global.cpp:369
#, kde-format
msgid "Writing to %1 is not supported."
msgstr "Non está soportada a escrita en %1."

#: kio/global.cpp:371
#, kde-format
msgid "There are no special actions available for protocol %1."
msgstr "Non hai accións especiais disponíbeis para o protocolo %1."

#: kio/global.cpp:373
#, kde-format
msgid "Listing folders is not supported for protocol %1."
msgstr "Non está soportado o listar cartafoles co protocolo %1."

#: kio/global.cpp:375
#, kde-format
msgid "Retrieving data from %1 is not supported."
msgstr "Non está soportada a obtención de dados de %1."

#: kio/global.cpp:377
#, kde-format
msgid "Retrieving mime type information from %1 is not supported."
msgstr "Non está soportada a obtención de información do tipo mime desde %1."

#: kio/global.cpp:379
#, kde-format
msgid "Renaming or moving files within %1 is not supported."
msgstr "Non está soportado o mudar o nome ou mover ficheiros dentro de %1."

#: kio/global.cpp:381
#, kde-format
msgid "Creating symlinks is not supported with protocol %1."
msgstr "Non está soportada a criación de ligazóns simbólicas co protocolo %1."

#: kio/global.cpp:383
#, kde-format
msgid "Copying files within %1 is not supported."
msgstr "Non está soportado o copiado de ficheiros dentro de %1."

#: kio/global.cpp:385
#, kde-format
msgid "Deleting files from %1 is not supported."
msgstr "Non está soportado o borrado de ficheiros de %1."

#: kio/global.cpp:387
#, kde-format
msgid "Creating folders is not supported with protocol %1."
msgstr "Non está soportada a criación de cartafoles co protocolo %1."

#: kio/global.cpp:389
#, kde-format
msgid "Changing the attributes of files is not supported with protocol %1."
msgstr ""
"Non está soportada a modificación dos atributos dos ficheiros co protocolo %"
"1."

#: kio/global.cpp:391
#, kde-format
msgid "Changing the ownership of files is not supported with protocol %1."
msgstr ""
"Non está soportada a modificación dos donos dos ficheiros co protocolo %1."

#: kio/global.cpp:393
#, kde-format
msgid "Using sub-URLs with %1 is not supported."
msgstr "Non está soportado o uso de sub-URLs con %1."

#: kio/global.cpp:395
#, kde-format
msgid "Multiple get is not supported with protocol %1."
msgstr "Non están soportadas as obtencións múltiplas co protocolo %1."

#: kio/global.cpp:397
#, kde-format
msgid "Opening files is not supported with protocol %1."
msgstr "Non está soportada a abertura de ficheiros co protocolo %1."

#: kio/global.cpp:399
#, kde-format
msgid "Protocol %1 does not support action %2."
msgstr "O protocolo %1 non soporta a acción %2."

