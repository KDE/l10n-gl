msgid "L&ayout"
msgstr "D&isposición"

#: part/kateprinter.cpp:955 part/kateschema.cpp:686
msgid "&Schema:"
msgstr "&Esquema:"

#: part/kateprinter.cpp:960
msgid "Draw bac&kground color"
msgstr "Debuxar cor de &fondo"

#: part/kateprinter.cpp:963
msgid "Draw &boxes"
msgstr "Debuxar &cadros"

#: part/kateprinter.cpp:967
msgid "Box Properties"
msgstr "Propriedades do Cadro"

#: part/kateprinter.cpp:971
msgid "W&idth:"
msgstr "A&ncho:"

