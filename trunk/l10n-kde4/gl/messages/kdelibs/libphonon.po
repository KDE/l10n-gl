#: audiooutput.cpp:304
msgid ""
"<html>The audio playback device <b>%1</b> does not work.<br/>Falling back to "
"<b>%2</b>.</html>"
msgstr ""
"<html>O dispositivo de reprodución de són <b>%1</b> non funciona.<br/>No seu "
"lugar usarase o <b>%2</b>.</html>"

#: audiooutput.cpp:309
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which just became "
"available and has higher preference.</html>"
msgstr ""
"<html>Mudando para o dispositivo de reprodución de són <b>%1</b><br/>que "
"acaba de porse disponíbel e ten maior preferencia.</html>"

