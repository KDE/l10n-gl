#: eventmonitor.cpp:70
msgid "Indexing files for fast searching. This process may take a while."
msgstr ""
"Estanse a indexar todos os ficheiros para facer buscas rápidas. Isto pode "
"levar un tempo."

#: eventmonitor.cpp:103 eventmonitor.cpp:133
msgid "Resuming indexing of files for fast searching."
msgstr ""
"Estase a continuar coa indexación de ficheiros para facer buscas rápidas."

#: eventmonitor.cpp:111
msgid "Suspending the indexing of files to preserve resources."
msgstr "Estase a suspender a indexación de ficheiros para conservar recursos."

#: eventmonitor.cpp:125
#, kde-format
msgid "Disk space is running low (%1 left). Suspending indexing of files."
msgstr ""
"O espazo no disco está a esgotarse (quédalle %1). Suspéndese a indexación de "
"ficheiros."

#: eventmonitor.cpp:153
#, kde-format
msgctxt "@info %1 is a duration formatted using KLocale::prettyFormatDuration"
msgid "Initial indexing of files for fast searching finished in %1"
msgstr "A indexación inicial de ficheiros para buscas rápidas rematou en %1"

#: fileindexer.cpp:133
msgctxt "@info:status"
msgid "File indexer is suspended."
msgstr "O indexador de ficheiros está suspendido."

#: fileindexer.cpp:141
msgctxt "@info:status"
msgid "Scanning for recent changes in files for desktop search"
msgstr ""
"Estanse a buscar cambios recentes nos ficheiros para a busca no "
"escritorio"

#: fileindexer.cpp:144
msgctxt "@info:status"
msgid "Indexing files for desktop search."
msgstr "Estanse a indexar ficheiros para a busca no escritorio."

# skip-rule: PT-2010-dual_buscar
#: fileindexer.cpp:149
#, kde-format
msgctxt "@info:status"
msgid "Scanning for recent changes in %1"
msgstr "Estanse a buscar cambios recentes en %1"

#: fileindexer.cpp:153
#, kde-format
msgctxt "@info:status"
msgid "Indexing files in %1"
msgstr "Estanse a indexar os ficheiros que hai en %1"

#: fileindexer.cpp:155
#, kde-format
msgctxt "@info:status"
msgid "Indexing %1"
msgstr "Estase a indexar %1"

#: fileindexer.cpp:160
msgctxt "@info:status"
msgid "File indexer is idle."
msgstr "O indexador de ficheiros está ocioso."

#: indexer/main.cpp:47
msgid "NepomukIndexer"
msgstr "NepomukIndexer"

#: indexer/main.cpp:49
msgid ""
"NepomukIndexer indexes the contents of a file and saves the results in "
"Nepomuk"
msgstr ""
"NepomukIndexer indexa o contido dun ficheiro e garda o resultado en Nepomuk"

