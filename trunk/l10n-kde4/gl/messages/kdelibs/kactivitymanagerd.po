#: ActivityManager.cpp:177
msgid "Activity password"
msgstr "Contrasinal da actividade"

#: ActivityManager.cpp:177
msgid "Enter the password to use for encryption"
msgstr "Introduza o contrasinal que se ha usar para cifrar"

#: ActivityManager.cpp:182 ActivityManager.cpp:217 ActivityManager.cpp:326
#: ActivityManager.cpp:501
msgid "Error"
msgstr "Erro"

#: ActivityManager.cpp:182
msgid "Error setting up the activity encryption"
msgstr "Aconteceu un erro ao configurar a cifraxe da actividade"

#: ActivityManager.cpp:215
msgid "Unprotect activity"
msgstr "Desprotexer a actividade"

#: ActivityManager.cpp:215
msgid ""
"You are cancelling the protection of this activity. Its content will become "
"public again and be accessed without a password."
msgstr ""
"Está a cancelar a protección desta actividade, polo que o seu contido hase "
"voltar facer público e estar accesíbel sen contrasinal."

#: ActivityManager.cpp:217 ActivityManager.cpp:326 ActivityManager.cpp:501
msgid ""
"Error unlocking the activity.\n"
"You've probably entered a wrong password."
msgstr ""
"Aconteceu un erro ao desatrancar a actividade.\n"
"Posibelmente escribise un contrasinal errado."

#: ActivityManager.cpp:323
#, fuzzy
#| msgid "Unprotect activity"
msgid "Unlock activity"
msgstr "Desprotexer a actividade"

#: ActivityManager.cpp:323
msgid "Enter the password to unlock the activity"
msgstr "Introduza o contrasinal para destrancar a actividade"

#: ActivityManager.cpp:486
msgid "Confirmation"
msgstr "Confirmación"

#: ActivityManager.cpp:487
msgid ""
"If you delete a private activity, all the documents and files that belong to "
"it will also be deleted."
msgstr ""
"Se elimina unha actividade privada tamén ha eliminar todos os documentos e "
"ficheiros que lle pertenzan."

#: ActivityManager.cpp:499
msgid "Delete activity"
msgstr "Eliminar a actividade"

#: ActivityManager.cpp:499
msgid "Enter the password to delete this protected activity."
msgstr "Introduza o contrasinal para eliminar esta actividade protexida."

#: main.cpp:37
msgid "KDE Activity Manager"
msgstr "Xestor de actividades de KDE"

#: main.cpp:38
