msgid "Comma-separated list of the common attribute groups"
msgstr "Lista separada por vírgulas dos grupos de atributos comúns"

#. i18n: file: UNPORTED/quantacore/dialogs/dtepeditdlgs.ui:550
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel12)
#. i18n: file: UNPORTED/quantacore/dialogs/dtepeditdlgs.ui:636
#. i18n: ectx: property (whatsThis), widget (KLineEdit, groupsEdit1)
