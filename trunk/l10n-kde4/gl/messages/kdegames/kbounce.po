"Benvido a KBounce.\n"
" Preme para comezar unha partida"

#: gamewidget.cpp:345
msgid "Paused"
msgstr "En pausa"

#: gamewidget.cpp:348
#, kde-format
msgid "You have successfully cleared more than %1% of the board\n"
msgstr "Limpaches con éxito máis do %1% do taboleiro\n"

#: gamewidget.cpp:349
#, kde-format
msgid "%1 points: %2 points per remaining life\n"
msgstr "%1 pontos: %2 pontos por cada vida que che quedou\n"

#: gamewidget.cpp:350
#, kde-format
