msgstr "Pasas ao nível %1. Lembra que obtés %2 vidas desta vez!"

#: gamewidget.cpp:355
msgid ""
"Game over.\n"
" Click to start a game"
msgstr ""
"Partida rematada.\n"
" Preme para comezar unha partida"

