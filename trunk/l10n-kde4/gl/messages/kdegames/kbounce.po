msgstr "Pasas ao nivel %1. Lembra que obtés %2 vidas desta vez!"

#: gamewidget.cpp:355
msgid ""
"Game over.\n"
" Click to start a game"
msgstr ""
"Rematou a partida.\n"
" Preme para comezar unha partida"

