#: gamewidget.cpp:342
msgid ""
"Welcome to KBounce.\n"
" Click to start a game"
msgstr ""
"Benvido a KBounce.\n"
" Preme para comezar unha partida"

#: gamewidget.cpp:345
msgid "Paused"
msgstr "En pausa"

#: gamewidget.cpp:348
#, kde-format
msgid "You have successfully cleared more than %1% of the board\n"
msgstr "Limpaches con éxito máis do %1% do taboleiro\n"

#: gamewidget.cpp:349
#, kde-format
msgid "%1 points: %2 points per remaining life\n"
msgstr "%1 puntos: %2 puntos por cada vida que che quedou\n"

#: gamewidget.cpp:350
#, kde-format
msgid "%1 points: Bonus\n"
msgstr "%1 puntos: bonificación\n"

#: gamewidget.cpp:351
#, kde-format
msgid "%1 points: Total score for this level\n"
msgstr "%1 puntos: puntuación total deste nivel\n"

#: gamewidget.cpp:352
#, kde-format
