#: kcubeboxwidget.cpp:348
#, kde-format
msgid ""
"The file's cube box size is outside the range %1 to %2. It will be set to %1."
msgstr ""
"O tamaño da caixa de cubos do ficheiro non está entre %1 e %2. Deixarase en "
"%1."

