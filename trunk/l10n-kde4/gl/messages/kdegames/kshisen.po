#: app.cpp:122 app.cpp:311
msgid "Select a tile"
msgstr "Escolla unha peza"

#: app.cpp:125
msgid "Time: 0:00:00"
msgstr "Tempo: 0:00:00"

#: app.cpp:128
msgid "Removed: 0/0"
msgstr "Eliminadas: 0/0"

#: app.cpp:131
msgid "Cheat mode"
msgstr "Modo con trampas "

#: app.cpp:188
msgid "This game is solvable."
msgstr "Esta partida ten solución."

#: app.cpp:190
msgid "This game is NOT solvable."
msgstr "Esta partida NON ten solución."

#: app.cpp:264
msgid "No more moves possible!"
msgstr "Non hai máis movimentos!"

#: app.cpp:264 app.cpp:301
msgid "End of Game"
msgstr "Fin da partida"

#: app.cpp:291
#, qt-format
msgid "Congratulations! You made it in %1:%2:%3"
msgstr "Noraboa! Fíxoo en %1:%2:%3"

#: app.cpp:298
msgid ""
"You could have been in the higscores if you did not use Undo or Hint. Try "
"without them next time."
msgstr ""
"Podería ter entrado nas máximas pontuacións de non usar Desfacer ou "
"Consello. A próxima vez tente non usalas."

#: app.cpp:316
msgid "Select a matching tile"
msgstr "Escolla unha peza coa que case"

#: app.cpp:321
msgid "Select the move you want by clicking on the blue line"
msgstr "Escolla o movimento que queira premendo na liña azul"

#: app.cpp:326
msgid "This tile did not match the one you selected"
msgstr "Esta peza non casa coa que escolleu"

#: app.cpp:331
msgid "You cannot make this move"
msgstr "Non pode facer este movimento"

#: app.cpp:341
msgid "(Paused) "
msgstr "(Pausado) "

#: app.cpp:337
#, qt-format
msgid " Your time: %1:%2:%3 %4"
msgstr " O teu tempo: %1:%2:%3 %4"

#: app.cpp:348
#, qt-format
msgid " Removed: %1/%2 "
msgstr " Eliminadas: %1/%2 "

#: app.cpp:385
msgid ""
"You have made it into the \"Hall Of Fame\". Type in\n"
"your name so mankind will always remember\n"
"your cool rating."
msgstr ""
"Conseguiu entrar no \"Salón da Fama\". Introduza\n"
"o seu nome e así a humanidade sempre recordará\n"
"a súa pontuación."

#: app.cpp:387
msgid "Your name:"
msgstr "O seu nome:"

#: app.cpp:607 app.cpp:615
msgid "Hall of Fame"
msgstr "Salón da Fama"

#: app.cpp:635
msgid "Rank"
