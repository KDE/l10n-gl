msgstr "Fichar: %1 Pos: %2,%3,%4"

#: Editor.cpp:306 Editor.cpp:338
msgid ""
"*.layout|Board Layout (*.layout)\n"
"*|All Files"
msgstr ""
"*.layout|Disposición do taboleiro(*.layout)\n"
"*|Todos os ficheiros"

#: Editor.cpp:309
msgid "Open Board Layout"
msgstr "Abrir unha disposición do taboleiro"

#: Editor.cpp:341 Editor.cpp:360
msgid "Save Board Layout"
msgstr "Gardar a disposición do taboleiro"

#: Editor.cpp:348 kmahjongg.cpp:563
msgid "Only saving to local files currently supported."
msgstr "Por agora só se pode gardar en ficheiros locais."

#: Editor.cpp:357
msgid "A file with that name already exists. Do you wish to overwrite it?"
msgstr "Xa existe un ficheiro con ese nome. Desexa sobescrebelo?"

#: Editor.cpp:384
msgid "The board has been modified. Would you like to save the changes?"
msgstr "O taboleiro foi modificado. Desexa gardar os cambios?"

#: Editor.cpp:392
msgid "Save failed. Aborting operation."
msgstr "Fallo ao gardar. Cancélase a operación."

#: boardwidget.cpp:410
msgid "Undo operation done successfully."
msgstr "A operación de desfacer tivo éxito."

#: boardwidget.cpp:414
msgid "What do you want to undo? You have done nothing!"
msgstr "Que quer desfacer? Aínda non fixo ren!"

#: boardwidget.cpp:433
msgid "Sorry, you have lost the game."
msgstr "Lamentámolo, perdeu a partida."

#: boardwidget.cpp:478
msgid "Demo mode. Click mousebutton to stop."
msgstr "Modo de demonstración. Prema o botón do rato para parar."

#: boardwidget.cpp:487
msgid "Now it is you again."
msgstr "Agora volta a ter o control."

#: boardwidget.cpp:510
msgid "Your computer has lost the game."
msgstr "O seu ordenador perdeu a partida."

#: boardwidget.cpp:605
msgid "Congratulations. You have won!"
msgstr "Noraboa. Gañou!"

#: boardwidget.cpp:652
msgid "Calculating new game..."
msgstr "A calcular a nova partida..."

#: boardwidget.cpp:657
msgid "Error converting board information!"
msgstr "Erro ao converter a información do taboleiro!"

#: boardwidget.cpp:683
msgid "Ready. Now it is your turn."
msgstr "Listo. É o seu turno."

#: boardwidget.cpp:690
msgid "Error generating new game!"
msgstr "Erro ao xerar a nova partida!"

#: boardwidget.cpp:853
msgid "Game over: You have no moves left."
msgstr "Partida finalizada: Non pode sacar máis fichas."

#: kmahjongg.cpp:149
msgid "New Numbered Game..."
msgstr "Nova partida numerada..."

#: kmahjongg.cpp:156
msgid "Shu&ffle"
msgstr "&Barallar"

