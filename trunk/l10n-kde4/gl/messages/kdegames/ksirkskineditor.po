#~ msgid "Cannon individual frame width"
#~ msgstr "Anchura da moldura individual do canón"

#~ msgid ""
#~ "<p>Cannon individual frame width.</p><p>The pool <i>cannon</i> element "
#~ "will be rendered on a pixmap of width (<i>Width</i> * <i>Number of "
#~ "frames</i>) and then split into individual frames.</p>"
#~ msgstr ""
#~ "<p>Anchura da moldura individual do canón.</p><p>O elemento <i>canón</i> "
#~ "do depósito debúxase sobre un mapa de píxeles de anchura: <i>Anchura</i> "
#~ "* N<i>número de molduras</i> e despois divídese en molduras individuais.</"
#~ "p>"

#~ msgid "Individual cannon frame height"
#~ msgstr "Altura da moldura individual do canón"

#~ msgid ""
#~ "<p>Individual cannon frame height.</p><p>The pool <i>cannon<i> element "
#~ "will be rendered on a pixmap of height (<i>Height</i> * <i>Number of "
#~ "versions</i>) and then split into individual frames.</p>"
#~ msgstr ""
#~ "<p>Altura da moldura individual do canón.</p><p>O elemento <i>canón</i> "
#~ "do depósito móstrase nun mapa de píxeles de altura: (<i>Altura</i> * "
#~ "<i>Número de versións</i>) e despois divídese en molduras individuais.</p>"

#~ msgid "Number of individual cannon frames"
#~ msgstr "Número de molduras de canón individuais"

#~ msgid ""
#~ "<p>Number of individual cannon frames.</p><p>The pool <i>cannon</i> "
#~ "element will be rendered on a pixmap of width (<i>Width</i> * <i>Number "
#~ "of frames</i>) and then split into individual frames.</p>"
#~ msgstr ""
#~ "<p>Número de molduras de canón individuais.</p><p>O elemento <i>canón</i> "
#~ "do depósito móstrase nun mapa de píxeles de anchura: (<i>Anchura</i> * "
#~ "<i>Número de molduras</i>) e despois divídese en molduras individuais.</p>"

#~ msgid "Number of cannon versions"
#~ msgstr "Número de versións do canón"

#~ msgid ""
#~ "<p>Number of cannon versions.</p><p>The pool <i>cannon</i> element will "
#~ "be rendered on a pixmap of height (<i>Height</i> * <i>Number of versions</"
#~ "i>) and then split into individual frames.</p><p>Each version shows the "
#~ "sprite visible from one direction: the first one is directed towards the "
#~ "right, the second towards the left, the third one from front and the last "
#~ "one from the back. However, not all sprites need all versions.</p>"
#~ msgstr ""
#~ "<p>Número de versións do canón.</p><p>O elemento <i>canón</i> do depósito "
#~ "móstrase nun mapa de píxeles de altura: (<i>Altura</i> *<i> Número de "
#~ "versións</i>) e despois divídese en molduras individuais.</p><p>Cada "
#~ "versión mostra a imaxe visíbel desde unha dirección: a primeira está "
#~ "dirixida cara a dereita, a segunda cara a esquerda, a terceira desde "
#~ "diante e a última desde atrás. Porén, non todas as imaxes precisan de "
#~ "todas as versións.</p>"

