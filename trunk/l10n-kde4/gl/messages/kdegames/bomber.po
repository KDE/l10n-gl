#. i18n: file: src/bomberui.rc:14
#. i18n: ectx: ToolBar (mainToolBar)
#: rc.cpp:5
msgid "Main Toolbar"
msgstr "Barra de ferramentas principal"

#. i18n: file: src/bomber.kcfg:9
#. i18n: ectx: label, entry (Theme), group (General)
#: rc.cpp:8
msgid "The graphical theme to be used."
msgstr "O tema gráfico que se usará."

#. i18n: file: src/bomber.kcfg:15
#. i18n: ectx: label, entry (PlaySounds), group (Sound)
#: rc.cpp:11
msgid "Whether game sounds are played."
msgstr "Se se han reproducir os sons."

#: src/bomber.cpp:40 src/bomber.cpp:198
#, kde-format
msgctxt "Used to display the current level of play to the user"
msgid "Level: %1"
msgstr "Nivel: %1"

#: src/bomber.cpp:41 src/bomber.cpp:204
#, kde-format
msgctxt "Used to inform the user of their current score"
msgid "Score: %1"
msgstr "Puntuación: %1"

#: src/bomber.cpp:42 src/bomber.cpp:211
#, kde-format
msgctxt "Used to tell the user how many lives they have left"
msgid "Lives: %1"
msgstr "Vidas: %1"

#: src/bomber.cpp:81
msgctxt "Menu item used to disable or enable sound"
msgid "&Play Sounds"
msgstr "&Reproducir os sons"

#: src/bomber.cpp:86
msgctxt "The name of the action used for dropping bombs"
msgid "&Drop bomb"
msgstr "&Soltar unha bomba"

#: src/bomber.cpp:87
msgctxt "The tool tip text for the action used to drop bombs"
msgid "Drop bomb"
msgstr "Soltar unha bomba"

#: src/bomber.cpp:89
msgctxt "Description of the action used to drop bombs"
msgid "Makes the plane drop a bomb while flying"
msgstr "Fai que o avión solte unha bomba mentres está a voar"

#: src/bomber.cpp:136
msgctxt ""
"Message displayed when play tries to quit a game that is currently running"
msgid "Do you really want to close the running game?"
msgstr "Seguro que queres rematar a partida que estás a xogar?"

#: src/bomber.cpp:177
msgid "Theme"
msgstr "Tema visual"

#: src/bomber.cpp:229
#, kde-format
msgctxt "Game over messaged displayed in the status bar"
msgid "Game over. Press '%1' for a new game"
msgstr "Rematou a partida. Preme «%1» para volver xogar."

#: src/bomberwidget.cpp:317
msgctxt "Message show to the user when the game is loaded"
msgid ""
"Welcome to Bomber.\n"
"Click to start a game"
msgstr ""
"Benvido ao Bomber.\n"
"Preme para comezar unha partida."

#: src/bomberwidget.cpp:320
msgctxt "Message show to the user while the game is paused"
msgid "Paused"
msgstr "En pausa"

#: src/bomberwidget.cpp:323
#, kde-format
msgctxt "Message telling user which level they just completed"
msgid "You have successfully cleared level %1\n"
msgstr "Completaches o nivel %1\n"

#: src/bomberwidget.cpp:324
#, kde-format
msgctxt "Message telling user which level they are about to start"
msgid "On to level %1."
msgstr "Agora ao nivel %1."

#: src/bomberwidget.cpp:327
msgctxt "Used to tell the user that the game is over"
msgid "Game over."
msgstr "Rematou a partida."

#: src/main.cpp:25
msgid "Arcade bombing game"
msgstr "Xogo arcade de bombardeo"

