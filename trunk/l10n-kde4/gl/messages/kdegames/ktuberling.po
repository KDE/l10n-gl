#: toplevel.cpp:327
msgid ""
"*.xpm|UNIX Pixmaps (*.xpm)\n"
"*.jpg|JPEG Compressed Files (*.jpg)\n"
"*.png|Next Generation Pictures (*.png)\n"
"*.bmp|Windows Bitmaps (*.bmp)\n"
"*|All Picture Formats"
