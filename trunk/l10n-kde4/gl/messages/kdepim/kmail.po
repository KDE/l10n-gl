msgid "Classify as Spam"
msgstr "Clasificar como Lixo"

#: antispamwizard.cpp:403
msgid "Spam"
msgstr "Correo Lixo"

#: antispamwizard.cpp:435 antispamwizard.cpp:437 antispamwizard.cpp:614
