msgid ""
"<qt>Not all characters fit into the chosen encoding.<br /><br />Send the "
"message anyway?</qt>"
msgstr ""
"<qt>Non todos os caracteres tiveron cabida na codificación escollida.<br /"
"><br />Enviar esta mensaxe de calquera xeito?</qt>"

