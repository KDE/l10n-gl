#: main.cpp:34
msgid "KDE Commandline Emailer."
msgstr ""
"Programa de envío de correo electrónico do KDE para a liña de comandos."

#: main.cpp:40
msgid "Set subject of message"
msgstr "Estabelecer o asunto da mensaxe"

#: main.cpp:42
msgid "Send CC: to 'address'"
msgstr "Enviar CC: a \"enderezo\""

#: main.cpp:44
msgid "Send BCC: to 'address'"
msgstr "Enviar BCC: a \"enderezo\""

#: main.cpp:46
msgid "Add 'header' to message"
msgstr "Engadir \"cabeceira\" á mensaxe"

#: main.cpp:47
msgid "Read message body from 'file'"
msgstr "Ler corpo da mensaxe dende o \"ficheiro\""

#: main.cpp:48
msgid "Set body of message"
msgstr "Estabelecer corpo da mensaxe"

#: main.cpp:49
msgid "Add an attachment to the mail. This can be repeated"
msgstr "Engadir un ficheiro anexo ao correo. Isto pode repetirse"

#: main.cpp:50
msgid "Only open composer window"
msgstr "Só abrir a fiestra de edición"

#: main.cpp:51
msgid "Send message to 'address' resp. attach the file the 'URL' points to"
msgstr ""
"Enviar a mensaxe ao enderezo de resposta anexo co arquivo ao que apunta o URL"

#: main.cpp:158
msgid "Unable to find or start Kontact."
msgstr "Foi imposíbel atopar ou iniciar o Kontact."

#: main.cpp:169
msgid "Can't connect to Kontact."
msgstr "Non é posíbel conectarse co Kontact."

#: main.cpp:175
msgid "KSendEmail"
msgstr "KSendMail"

