#: kalarmdirresource.cpp:627
#, kde-format
msgctxt "@info"
msgid "Failed to save event file: %1"
msgstr "Non foi posíbel gravar o ficheiro de acontecemento: %1."

#. i18n: file: settingsdialog.ui:26
#. i18n: ectx: attribute (title), widget (QWidget, tab)
#: rc.cpp:3
msgid "Directory"
msgstr "Directorio"

#. i18n: file: settingsdialog.ui:32
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:6
msgid "Directory Name"
msgstr "Nome do directorio"

#. i18n: file: settingsdialog.ui:40
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:9
msgid "&Directory:"
msgstr "&Directorio:"

#. i18n: file: settingsdialog.ui:55
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:12
msgid ""
"Select the directory whose contents should be represented by this resource. "
"If the directory does not exist, it will be created."
msgstr ""
"Seleccione o directorio cuxo contido desexa que estea representado por este "
"recurso. De non existir o directorio, créase."

#. i18n: file: settingsdialog.ui:68
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: rc.cpp:15
msgid "Display Name"
msgstr "Nome público"

#. i18n: file: settingsdialog.ui:76
#. i18n: ectx: property (text), widget (QLabel, label_1)
#: rc.cpp:18
msgid "&Name:"
msgstr "&Nome:"

#. i18n: file: settingsdialog.ui:91
#. i18n: ectx: property (text), widget (QLabel, label_5)
#: rc.cpp:21
msgid ""
"Enter the name used to identify this resource in displays. If not specified, "
"the directory name will be used."
msgstr ""
"Introduza o nome empregado para identificar este recurso en pantalla. Se non "
"se especifica utilízase o nome do directorio."

#. i18n: file: settingsdialog.ui:104
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:24
msgid "Access Rights"
msgstr "Dereitos de acceso"

#. i18n: file: settingsdialog.ui:110
#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#: rc.cpp:27
msgid "Read only"
msgstr "Só lectura"

#. i18n: file: settingsdialog.ui:117
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:30
msgid ""
"If read-only mode is enabled, no changes will be written to the directory "
"selected above. Read-only mode will be automatically enabled if you do not "
"have write access to the directory."
msgstr ""
"Se o modo só para lectura estiver activado, non se escriben as modificacións "
"no directorio seleccionado arriba. O modo só para lectura actívase "
"automaticamente se non se ten acceso de escrita ao directorio."

#. i18n: file: kalarmdirresource.kcfg:9
#. i18n: ectx: label, entry (Path), group (General)
#: rc.cpp:33
msgid "Path to KAlarm directory."
msgstr "Ruta ao ficheiro de calendario do KAlarm."

#. i18n: file: kalarmdirresource.kcfg:13
#. i18n: ectx: label, entry (DisplayName), group (General)
#: rc.cpp:36
msgid "Display name."
msgstr "Mostrar o nome."

#. i18n: file: kalarmdirresource.kcfg:17
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:39
msgid "Do not change the actual backend data."
msgstr "Non modificar os datos reais da infraestrutura."

#. i18n: file: kalarmdirresource.kcfg:21
#. i18n: ectx: label, entry (MonitorFiles), group (General)
#: rc.cpp:42
msgid "Monitor directory for changes."
msgstr "Vixiar o ficheiro por se hai cambios."

#. i18n: file: kalarmdirresource.kcfg:25
#. i18n: ectx: label, entry (AlarmTypes), group (General)
#: rc.cpp:45
msgid "Alarm types."
msgstr "Tipos de alarma."

