#: imapresource.cpp:172
msgid "No message retrieved, server reply was empty."
msgstr "Non se obtivo nengunha mensaxe; a resposta do servidor estaba baleira."

#: imapresource.cpp:208, kde-format
#| msgid ""
#| "You requested TLS/SSL to connect to %1, but your system does not appear "
#| "to support it."
msgid ""
"You requested TLS/SSL to connect to %1, but your system does not seem to be "
"set up for that."
msgstr ""
"Solicitouse TLS/SSL para conectar con %1, mais parece que este sistema non "
"está configurado para iso."

#: imapresource.cpp:573
msgid "Failed to create the folder, restoring folder list."
msgstr "Non se puido crear o cartafol; restáurase a lista de cartafoles."

#: imapresource.cpp:612
#| msgid "Failed to create the folder, restoring folder list."
msgid "Failed to rename the folder, restoring folder list."
msgstr ""
"Non se puido mudar o cartafol de nome; restáurase a lista de cartafoles."

#: imapresource.cpp:635
msgid "Failed to delete the folder, restoring folder list."
msgstr "Non se pode eliminar o cartafol; restáurase a lista de cartafoles."

#: imapresource.cpp:653
msgid ""
"The server refused the supplied username and password. Do you want to go to "
"the settings, have another attempt at logging in, or do nothing?"
msgstr ""
"O servidor rexeitou o nome de usuario e contrasinal que se lle enviaron. "
"Quere ir á configuración, tentar ligar outra vez ou non facer nada?"

#: imapresource.cpp:656
msgid "Could Not Authenticate"
msgstr "Non foi posíbel autenticar"

#: imapresource.cpp:657
msgid "Settings"
msgstr "Configuración"

#: imapresource.cpp:658
msgid "Single Input"
msgstr "Entrada sinxela"

#: imapresource.cpp:666
#, kde-format
msgid "Could not connect to the IMAP-server %1."
msgstr "Non foi posíbel conectar co servidor de IMAP %1."

#: imapresource.cpp:673, kde-format
#| msgid "Could not connect to the IMAP-server %1."
msgid "Could not test the capabilities supported by the IMAP server %1."
msgstr ""
"Non foi posíbel examinar as capacidades admitidas polo servidor de IMAP %1."

#: imapresource.cpp:691
#, kde-format
msgid ""
"Cannot use the IMAP server %1, some mandatory capabilities are missing: %2. "
"Please ask your sysadmin to upgrade the server."
msgstr ""
"Non se pode empregar o servidor de IMAP %1 porque faltan algunhas "
"capacidadas requiridas: %2. "
"Pídalle ao administrador do sistema que actualice o servidor."

#: imapresource.cpp:918
msgid "Could not find a valid password, please enter it here."
msgstr "Non se atopou ningún contrasinal válido; escríbao aquí."

