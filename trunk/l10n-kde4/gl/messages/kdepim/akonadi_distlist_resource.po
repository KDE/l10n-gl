msgstr "Camiño ao ficheiro da lista de distribución."

#. i18n: file: distlistresource.kcfg:13
#. i18n: ectx: label, entry (AutosaveInterval), group (General)
#: rc.cpp:6
msgid "Autosave interval time (in minutes)."
msgstr "Intervalo do gardado automático (en minutos)."

#. i18n: file: distlistresource.kcfg:17
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:9
msgid "Do not change the actual backend data."
msgstr "Non modificar os datos reais da infraestrutura."

#. i18n: file: distlistresource.kcfg:21
