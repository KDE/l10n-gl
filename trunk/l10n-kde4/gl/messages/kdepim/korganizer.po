msgid "RSVP"
msgstr "RSVP"

#: koeditordetails.cpp:192
msgctxt "@title:column attendee delegated to"
msgid "Delegated To"
msgstr "Delegado en"

#: koeditordetails.cpp:193
msgctxt "@title:column attendee delegated from"
msgid "Delegated From"
msgstr "Delegado de"

