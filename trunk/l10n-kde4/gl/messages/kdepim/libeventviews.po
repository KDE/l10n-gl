#~ "Introduza aquí a hora de comezo das actividades. Esta hora debería ser a "
#~ "máis cedo que use para as actividades, xa que se mostra na parte superior."

#~ msgid "Daily starting hour"
#~ msgstr "Hora de comezo diaria"

#~ msgid ""
#~ "Enter the start time for the working hours here. The working hours will "
#~ "be marked with color by KOrganizer."
#~ msgstr ""
#~ "Introduza aquí a hora de comezo das horas de traballo. As horas de "
#~ "traballo marcaranse con cor por KOrganizer."

#~ msgid "Daily ending hour"
#~ msgstr "Hora de remate diaria"

#~ msgid ""
#~ "Enter the ending time for the working hours here. The working hours will "
#~ "be marked with color by KOrganizer."
