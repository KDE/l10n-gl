#: rc.cpp:67
msgid ""
"<qt>\n"
"<h1>Add a Directory Service</h1>\n"
"By clicking this button, you can select a new directory service to be used "
"for retrieving certificates and CRLs. You will be asked for the server name "
"and an optional description.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Engadir un servizo de directorio</h1>\n"
"Premendo neste botón pode seleccionar un novo servizo de directorio a se "
"empregar para obter certificados e CRLs. Preguntaráselle polo nome do "
"servidor e unha descrición opcional.\n"
"</qt>"

#. i18n: tag string
#. i18n: file ui/directoryserviceswidgetbase.ui line 170
#: rc.cpp:73
msgid "&Add Service..."
msgstr "Eng&adir un servizo..."

#. i18n: tag string
#. i18n: file ui/directoryserviceswidgetbase.ui line 196
#: rc.cpp:76
msgid "Click to remove the currently selected service"
msgstr "Prema para borrar o servizo actualmente escollido"

#. i18n: tag string
#. i18n: file ui/directoryserviceswidgetbase.ui line 202
#: rc.cpp:79
msgid ""
"<qt>\n"
"<h1>Remove Directory Service</h1>\n"
"By clicking this button, you can remove the currently selected directory "
"service in the list above. You will have a chance to rethink your decision "
"before the entry is deleted from the list.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Borrar o servizo de directorio</h1>\n"
"Premendo neste botón pode borrar o servizo de directorio actualmente "
"escollido na lista de riba. Terá unha oportunidade para pensar a súa "
"decisión antes de que se borre a entrada da lista.\n"
"</qt>"

#. i18n: tag string
#. i18n: file ui/directoryserviceswidgetbase.ui line 205
#: rc.cpp:85
msgid "&Remove Service"
msgstr "&Borrar o servizo"

