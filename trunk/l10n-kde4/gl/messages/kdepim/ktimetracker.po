msgid "&Edit..."
msgstr "&Editar..."

#: timetrackerwidget.cpp:333
msgid "Edits name or times for selected task"
msgstr "Editar os nomes ou tempos da tarefa seleccionada"

#: timetrackerwidget.cpp:333
msgid ""
"This will bring up a dialog box where you may edit the parameters for the "
"selected task."
msgstr ""
"Isto abrirá un diálogo onde poderá editar os parámetros da tarefa "
"seleccionada."

#: timetrackerwidget.cpp:335
msgid "&Mark as Complete"
msgstr "&Marcar como Completa"

#: timetrackerwidget.cpp:337
msgid "&Mark as Incomplete"
msgstr "Marcar &como Incompleta"

