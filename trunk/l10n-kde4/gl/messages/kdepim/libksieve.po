#: ksieveui/autocreatescripts/sieveconditions/sieveconditionexists.cpp:57
msgid "headers:"
msgstr "cabeceiras:"

#: ksieveui/autocreatescripts/sieveactions/sieveactionenclose.cpp:63
#: ksieveui/autocreatescripts/sieveactions/sieveactionreject.cpp:46
