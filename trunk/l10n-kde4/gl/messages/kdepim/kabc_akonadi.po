#: resourceakonadiconfig.cpp:169
msgctxt "@title:window"
msgid "Manage Address Book Sources"
msgstr "Xestión das fontes do Caderno de enderezos"

#: resourceakonadiconfig.cpp:178
#, kde-format
msgctxt "@info"
msgid ""
"<title>Please select the folder for storing newly created contacts.</"
"title><note>If the folder list below is empty, you might have to add an "
"addressbook source through <interface>%1</interface> <br>or change which "
"folders you are subscribed to through <interface>%2</interface></note>"
msgstr ""
"<title>Escolla o cartafol onde gardar os contactos novos.</title> "
"<note>Se a lista de cartafoles en baixo está en branco, poida que teña que "
"engadir unha fonte de caderno de enderezos mediante <interface>%1</interface><br> "
"ou mudar os cartafoles aos que está subscrito mediante <interface>%2</interface></note>"

#: resourceakonadiconfig.cpp:265
msgctxt "@title:window"
msgid "Select Addressbook Folder"
msgstr "Escolla o cartafol do caderno de enderezos"

