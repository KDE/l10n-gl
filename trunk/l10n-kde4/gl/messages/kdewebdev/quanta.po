#. i18n: file: scripts/tablewizard.kmdr:369
#: rc.cpp:2530
msgid "&informaltable"
msgstr "táboa &informal"

#. i18n: file: scripts/tablewizard.kmdr:389
#: rc.cpp:2532
msgid "Select this option to generate an informal table (informaltable)."
msgstr "Escolla esta opción para xerar unha táboa informal (informaltable)."

#. i18n: file: scripts/tablewizard.kmdr:409
#: rc.cpp:2534
msgid ""
"<qt>\n"
"Select the table type:\n"
"<ul>\n"
"<li><b>informaltable:</b> the most used table type in KDE docs. A "
"informaltable does not contain title, table head or entry in the table of "
"contents.</li>\n"
"<li><b>table:</b> a complete and formal table type, including title, table "
"head and entry in the table of contents.</li>\n"
"</ul>\n"
"</qt>"
msgstr ""
"<qt>\n"
"Escolla o tipo de táboa:\n"
"<ul>\n"
"<li><b>informaltable:</b> o tipo de táboa máis usado nos documentos do KDE."
"Unha táboa informal non ten título, cabezallo nen entrada no índice.</li>\n"
"<li><b>table:</b> un tipo de táboa completo e formal que inclúe título, "
"cabezallo e entrada no índice.</li>\n"
"</ul>\n"
"</qt>"

