#: rc.cpp:694 rc.cpp:963
msgid ""
"Comma-separated list of area borders for comments. <i>EOL</i> means end of "
"line, used for single line comments.<br>\n"
"Example: <b>//&nbsp;EOL,&nbsp;/*&nbsp;*/</b>"
msgstr ""
"Lista separada por vírgulas de contornos de área para notas. <i>EOL</i> "
"significa «fin da liña», e utilízase para comentarios de unha só liña.<br>\n"
"Exemplo: <b>//&nbsp;EOL,&nbsp;/*&nbsp;*/</b>"

