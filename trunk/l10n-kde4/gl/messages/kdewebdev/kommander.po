#: lib/parser.cpp:116
#, kde-format
msgid "Invalid character: '%1'"
msgstr "Caracter non válido: \"%1\""

#: lib/parser.cpp:209 lib/parser.cpp:461
#, kde-format
msgid "'%1' is not a widget"
msgstr "\"%1\" non é un widget"

#: lib/parser.cpp:214 lib/parser.cpp:463
#, kde-format
msgid "'%1' is not a function"
msgstr "\"%1\" non é unha función"

#: lib/parser.cpp:225
msgid "Expected value"
msgstr "Valor esperado"

#: lib/parser.cpp:389
msgid "too few parameters"
msgstr "parámetros de menos"

#: lib/parser.cpp:389 lib/parser.cpp:391 lib/parser.cpp:397
#, kde-format
msgid "in function '%1': %2"
msgstr "na función \"%1\": %2"

#: lib/parser.cpp:391
msgid "too many parameters"
msgstr "parámetros de máis"

#: lib/parser.cpp:433
#, kde-format
msgid "in widget function '%1.%2': %3"
msgstr "na función do widget \"%1.%2\": %3"

#: lib/parser.cpp:465
#, kde-format
msgid "Unexpected symbol after variable '%1'"
msgstr "Símbolo non esperado tras a variábel \"%1\""

#: lib/parser.cpp:628
#, kde-format
msgid "Expected '%1'"
msgstr "Esperábase \"%1\""

#: lib/parser.cpp:641 lib/parser.cpp:654
msgid "Expected variable"
msgstr "Variábel esperada"

#: lib/specials.cpp:24
msgid "Inserts the item if it will not create a duplicate."
msgstr "Insere o ítem se con iso non se cría un duplicado."

#: lib/specials.cpp:26
msgid ""
"Returns scripts associated with widget. This is an advanced feature that "
"would not be commonly used."
msgstr ""
"Devolve os scripts asociados cun widget. Esta é unha funcionalidade avanzada "
"que non debería ser usada habitualmente."

#: lib/specials.cpp:27
msgid "Stops execution of the script associated with the widget."
msgstr "Deten a execución do script asociado co widget."

#: lib/specials.cpp:29
msgid "Returns text of a cell in a table."
msgstr "Devolve o texto dunha cela nunha táboa."

#: lib/specials.cpp:31
msgid "Returns 1 for checked boxes, 0 for unchecked."
msgstr "Devolve 1 para opcións sinaladas, 0 para as non sinaladas."

#: lib/specials.cpp:33
msgid ""
"Returns the list of child widgets contained in the parent widget. Set the "
"<i>recursive</i> parameter to <i>true</i> to include widgets contained by "
"child widgets."
msgstr ""
"Devolve a lista de widgets fillos contidos no widget pai. Axuste o parámetro "
"<i>recursivo</i> a <i>certo</i> para incluir os widgets contidos polos "
"widgets fillos."

#: lib/specials.cpp:35
msgid "Removes all content from the widget."
msgstr "Elimina todo o contido do widget."

#: lib/specials.cpp:38
msgid "Returns number of items in a widget such as combobox or listbox."
msgstr ""
"Devolve o número de itens nun widget como unha lista ou lista despregábel."

#: lib/specials.cpp:40
msgid "Returns index of current column."
msgstr "Devolve o índice da coluna actual."

#: lib/specials.cpp:42
msgid "Returns index of current item."
msgstr "Devolve o índice do ítem actual."

#: lib/specials.cpp:44
msgid "Returns index of current row."
msgstr "Devolve o índice da fila actual."

#: lib/specials.cpp:45
msgid "Executes the script associated with the widget."
msgstr "Executa o script asociado co widget."

#: lib/specials.cpp:47
msgid "Returns the index of an item with the given text."
msgstr "Devolve o índice dun ítem co texto dado."

#: lib/specials.cpp:49
msgid "Inserts new column (or <i>count</i> columns) at <i>column</i> position."
msgstr ""
"Insere unha nova coluna (ou a <i>cantidade</i> de colunas) na posición da "
"<i>coluna</i>."

#: lib/specials.cpp:51
msgid "Inserts item at <i>index</i> position."
msgstr "Insere un ítem na posición <i>índice</i>."

#: lib/specials.cpp:54
msgid "Inserts multiple items (EOL-separated) at <i>index</i> position."
msgstr ""
"Insere múltiplos itens (separados ou un EOL) na posición <i>índice</i>."

#: lib/specials.cpp:57
msgid "Inserts new row (or <i>count</i> rows) at <i>row</i> position."
msgstr ""
"Insere unha nova fila (ou a <i>cantidade</i> de filas) na posición da "
"<i>fila</i>."

#: lib/specials.cpp:59
msgid "Returns the text of the item at the given index."
msgstr "Devolve o texto do ítem co índice dado."

#: lib/specials.cpp:61
msgid ""
"Returns the depth of the current item in the tree. Root items have depth 0."
msgstr ""
"Devolve a profundidade do ítem actual na árbore. Os itens raíz teñen "
"profundidade 0."

#: lib/specials.cpp:63
msgid "Returns the slash-separated path to the given item in the tree."
msgstr "Devolve a rota separada por barras do ítem dado na árbore."

#: lib/specials.cpp:65
msgid ""
"Removes the column (or <i>count</i> consecutive columns) with the given "
"index."
msgstr ""
"Elimina a coluna (ou <i>conta</i> as colunas consecutivas) co índice dado."

#: lib/specials.cpp:67
msgid "Removes the item with the given index."
msgstr "Elimina o ítem co índice dado."

#: lib/specials.cpp:70
msgid ""
"Removes the row (or <i>count</i> consecutive rows) with the given index."
msgstr ""
"Eliminar a fila (ou <i>conta</i> as filas consecutivas) co índice dado."

#: lib/specials.cpp:73
msgid "Returns selected text or text of current item."
msgstr "Devolve o texto escollido ou o texto do ítem actual."

#: lib/specials.cpp:75
msgid ""
"Sets scripts associated with widget. This is an advanced feature that would "
"not be commonly used."
msgstr ""
"Indica os scripts asociados co widget. Esta é unha funcionalidade avanzada "
"que non debería ser usada habitualmente."

#: lib/specials.cpp:77
msgid "Enables or disables widget."
msgstr "Habilita ou deshabilita o widget."

#: lib/specials.cpp:80
msgid "Sets text of a cell in a table."
msgstr "Estabelece o texto dunha cela nunha táboa."

#: lib/specials.cpp:82
msgid "Sets/unsets checkbox."
msgstr "Sinala/Desmarca a opcion."

#: lib/specials.cpp:84
msgid "Sets caption of the column <i>column</i>."
msgstr "Estabelece o título da coluna <i>coluna</i>."

#: lib/specials.cpp:86
msgid "Selects the item at the specified index. Indexes are zero based."
msgstr "Escolla o ítem no índice especificado. Os índices comezan polo cero."

#: lib/specials.cpp:89
msgid "Sets maximum numeric value"
msgstr "Estabelece o máximo valor numérico"

#: lib/specials.cpp:91
msgid ""
"Sets pixmap at the given index to the specified icon. Use <i>index = -1</i> "
"to set the pixmap for all items."
msgstr ""
"Estabelece como mapa de píxeles do índice dado o ícone especificado. Use "
"<i>index = -1</i> para axustar o mapa de todos os itens."

#: lib/specials.cpp:93
msgid "Sets caption of the row <i>row</i>."
msgstr "Estabelece o título da fila <i>fila</i>."

#: lib/specials.cpp:95
msgid "Selects given text or select item containing given text."
msgstr "Escolle o texto dado ou escolle o ítem que contén o texto dado."

#: lib/specials.cpp:98
msgid "Sets widget's content."
msgstr "Estabelece o contido do widget."

#: lib/specials.cpp:101
msgid "Shows/hides widget."
msgstr "Mostra/Agocha o widget."

#: lib/specials.cpp:102
msgid "Returns content of widget."
msgstr "Devolve o contido do widget."

#: lib/specials.cpp:104
msgid "Returns type(class) of widget."
msgstr "Devolve o tipo (clase) do widget."

#: lib/specials.cpp:108
msgid ""
"Returns current widget's content. This was required inside widget A to "
"return widget A content when requested by widget B. The new method is to use "
"@A.text inside B instead of just @A if you just want the unaltered text."
msgstr ""
"Devolve o contido do widget actual. Era requerido que dentro do widget A se "
"devolvese o contido de A cando era pedido polo widget B. O novo método é "
"usar @A.text dentro de B no canto de só @A se só quer o texto sen alterar."

#: lib/specials.cpp:110
msgid ""
"Returns selected text or text of current item. This is deprecated for "
"<i>@mywidget.selected</i>."
msgstr ""
"Devolve o texto escollido ou o texto do ítem actual. Isto foi declarado "
"obsoleto e agora recoméndase <i>@oMeuWidget.selected</i>."

#: lib/specials.cpp:112
msgid ""
"Does nothing. This is useful if you request a CheckBox or RadioButton to "
"return a value where a state, typically the unchecked state, has no value. "
"The @null prevents an error indicating it is empty."
msgstr ""
"Non fai nada. Isto é útil se lle pide a unha opción ou alternativa que "
"devolva un valor cando un estado, polo xeral o non sinalado, non ten valor. "
"O @null evita a aparición dun erro indicando que está vacío."

#: lib/specials.cpp:114
msgid "Returns the pid (process ID) of the current process."
msgstr "Devolve o pid (ID do proceso) do proceso actual."

#: lib/specials.cpp:117
msgid ""
"Returns DCOP identifier of current process. This is shorthand for <i>kmdr-"
"executor-@pid</i>."
msgstr ""
"Devolve o identificador DCOP do proceso actual. Isto é un atallo de <i>kmdr-"
"executor-@pid</i>."

#: lib/specials.cpp:120
msgid "Returns the pid of the parent Kommander window."
msgstr "Devolve o pid da fiestra pai de Kommander."

#: lib/specials.cpp:122
msgid "Writes <i>text</i> on stderr."
msgstr "Escrebe <i>texto</i> en stderr."

#: lib/specials.cpp:124
msgid "Writes <i>text</i> on standard output."
msgstr "Escrebe <i>texto</i> na saída estándar."

#: lib/specials.cpp:126
msgid ""
"Executes a script block. Bash is used if no shell is given. It is primarily "
"for use in non-button widgets where script actions are not expected. Full "
"path is not required for the shell which may be useful for portability. "
"<p><i>If this is used inside a button it allows alternate script languages "
"to be used and will return a value to the main script, which may be "
"unexpected.</i>"
msgstr ""
"Executa un bloque de script. Usarase Bash se non se indica a shell. O seu "
"uso principal é en widgets que non sexan botóns onde non se agardan accións "
"de scripts. Non se requere a rota completa da shell, o que é interesante "
"para a portabilidade.<p><i>Se isto é usado nun botón permítelle alternar as "
"linguaxes de scripting a usar e devolverá un valor para o script principal, "
"o que pode non ser o agardado.</i>"

#: lib/specials.cpp:128
msgid ""
"Returns value of an environment (shell) variable. Do not use <i>$</i> in the "
"name. For example, <i>@env(PATH)</i>."
msgstr ""
"Devolve o valos unha variábel de entorno (shell). Non use <i>$</i> no nome. "
"Por exemplo, <i>@env(PATH)</i>."

#: lib/specials.cpp:130
msgid "Executes an external shell command."
msgstr "Executa un comando da shell."

#: lib/specials.cpp:132
msgid "Parses an expression and returns computed value."
msgstr "Procesa unha expresión e devolve o valor computado."

#: lib/specials.cpp:134
msgid ""
"Executes loop: values from <i>items</i> list (passed as EOL-separated "
"string) are assigned to the variable. <br> <i>@forEach(i,A\\nB\\nC\\n)<br>  "
"@# @i=A<br>@endif</i>"
msgstr ""
"Executar un bucle: os valores da lista <i>itens</i> (pasados como cadeas "
"separadas por EOL) serán asinados á variábel.<br> <i>@forEach(i,A\\nB\\nC\\n)"
"<br> @# @i=A<br> @endif</i>"

#: lib/specials.cpp:136
msgid ""
"Executes loop: variable is set to <i>start</i> and is increased by <i>step</"
"i> each time loop is executed. Execution stops when variable becomes larger "
"then <i>end</i>. <br><i>@for(i,1,10,1)<br>  @# @i=1<br>@endif</i>."
msgstr ""
"Executa un bucle: asínaselle <i>comezo</i> á variábel, que é incrementada en "
"<i>paso</i> cada vez que se executa o bucle. A execución detense cando a "
"variábel é maior que <i>fin</i>.<br> <i>@for(i,1,10,1<br> @# @i=1<br> "
"@endif</i>."

#: lib/specials.cpp:138
msgid "Returns the value of a global variable."
msgstr "Devolve o valor dunha variábel global."

#: lib/specials.cpp:140
msgid ""
"Translates the string into the current language. Texts in GUI would be "
"automatically extracted for translation."
msgstr ""
"Traduce a cadea ao idioma actual. Os textos na GUI serán extraídos "
"automaticamente para a súa tradución."

#: lib/specials.cpp:142
msgid ""
"Executes block if expression is true (non-zero number or non-empty string.) "
"<p>Close with <b>@endif</b></p>"
msgstr ""
"Executar o bloque se a expresión é certa (un número distinto de cero ou unha "
"cadea non vacía.) <p>Péchea cun <b>@endif</b></p>"

#: lib/specials.cpp:144
msgid ""
"Executes another Kommander dialog. Current dialog directory is used if no "
"path is given. Arguments may be given as named arguments which will become "
"global variables in the new dialog. For instance: <i>var=val</i>"
msgstr ""
"Executa outro diálogo de Kommander. O cartafol do diálogo actual é usado se "
"non se indica a rota. Pode pasarlle argumentos como argumentos por nome que "
"serán variábeis globais no novo diálogo. Por exemplo: <i>var=val</i>"

#: lib/specials.cpp:146
msgid "Reads setting from configration file for this dialog."
msgstr "Le a configuración no ficheiro de configuración deste diálogo."

#: lib/specials.cpp:148
msgid ""
"Sets the value of a global variable. Global variables exist for the life of "
"the Kommander window."
msgstr ""
"Estabelece o valor dunha variábel global. As variábeis globais existen "
"durante a vida da fiestra de Kommander."

#: lib/specials.cpp:150
msgid "Stores setting in configuration file for this dialog."
msgstr "Garda a configuración no ficheiro de configuración deste diálogo."

#: lib/specials.cpp:152
msgid ""
"Begin of <b>switch</b> block. Following <b>case</b> values are compared to "
"<i>expression</i>.<p>@switch()<br>@case()<br>@end"
msgstr ""
"Comeza un bloque <b>switch</b>. Os sucesivos valores <b>case</b> son "
"comparados con <i>expresión</i>.<p>@switch()<br>@case()<br>@end"

#: lib/specials.cpp:155
msgid "Executes an external DCOP call."
msgstr "Executa unha chamada DCOP externa."

#: lib/specials.cpp:157
msgid "Adds a comment to EOL that Kommander will not parse"
msgstr ""
"Engade un comentario non fin da liña que non será procesado por Kommander"

#: lib/specials.cpp:161
msgid "Returns an EOL-separated list of all values in the array."
msgstr "Devolve unha lista separada por EOL con todos os valores no vector."

#: lib/specials.cpp:163
msgid "Returns an EOL-separated list of all keys in the array."
msgstr "Devolve unha lista separada por EOL con todas as chaves no vector."

#: lib/specials.cpp:165
msgid "Removes all elements from the array."
msgstr "Elimina todos os elementos do vector."

#: lib/specials.cpp:167
msgid "Returns the number of elements in the array."
msgstr "Devolve o número de elementos no vector."

#: lib/specials.cpp:169
msgid "Returns the value associated with the given key."
msgstr "Devolve o valor asociado coa chave dada."

#: lib/specials.cpp:171
msgid "Removes element with the given key from the array."
msgstr "Elimina do vector o elemento coa chave dada."

#: lib/specials.cpp:173
msgid "Adds element with the given key and value to the array"
msgstr "Engade ao vector un elemento coa chave e o valor dados"

#: lib/specials.cpp:175
msgid ""
"Adds all elements in the string to the array. String should have <i>key"
"\\tvalue\\n</i> format."
msgstr ""
"Engade todos os elementos na cadea ao vector. A cadea debe ter o formato "
"<i>chave\\tvalor\\n</i>."

#: lib/specials.cpp:178
msgid "Returns all elements in the array in <pre>key\\tvalue\\n</pre> format."
msgstr ""
"Devolve todos os elementos no vector co formato <pre>chave\\tvalor\\n</pre>."

#: lib/specials.cpp:183
msgid "Returns number of chars in the string."
msgstr "Devolve o número de caracteres na cadea."

#: lib/specials.cpp:185
msgid "Checks if the the string contains the given substring."
msgstr "Comprob se a cadea contén a subcadea dada."

#: lib/specials.cpp:187
msgid ""
"Returns the position of a substring in the string, or -1 if it is not found."
msgstr ""
"Devolve a posición dunha subcadea dentro da cadea, ou -1 se non a contén."

#: lib/specials.cpp:189
msgid ""
"Returns the position of a substring in the string, or -1 if it is not found. "
"String is searched backwards"
msgstr ""
"Devolve a posición dunha subcadea na cadea, ou -1 se non se atopa. A cadea é "
"procurada cara tras"

#: lib/specials.cpp:191
msgid "Returns the first <i>n</i> chars of the string."
msgstr "Devolve os primeiros <i>n</i> caracteres da cadea."

#: lib/specials.cpp:193
msgid "Returns the last <i>n</i> chars of the string."
msgstr "Devolve os últimos <i>n</i> caracteres da cadea."

#: lib/specials.cpp:195
msgid "Returns <i>n</i> chars of the string, starting from <i>start</i>."
msgstr "Devolve <i>n</i> caracteres da cadea, comezando desde <i>inicio</i>."

#: lib/specials.cpp:197
msgid "Removes all occurrences of given substring."
msgstr "Elimina todas as aparicións da subcadea dada."

#: lib/specials.cpp:199
msgid ""
"Replaces all occurrences of the given substring with the given replacement."
msgstr "Substitue todas as aparicións da subcadea dada pola substituta."

#: lib/specials.cpp:201
msgid "Converts the string to uppercase."
msgstr "Converte a cadea para maiúsculas."

#: lib/specials.cpp:203
msgid "Converts the string to lowercase."
msgstr "Converte a cadea para minúsculas."

#: lib/specials.cpp:205
msgid ""
"Compares two strings. Returns 0 if they are equal, -1 if the first one is "
"lower, 1 if the first one is higher"
msgstr ""
"Compara dúas cadeas. Devolve 0 se son iguais, -1 se a primeira é menor, e 1 "
"se a primeira é maior"

#: lib/specials.cpp:208
msgid "Checks if the string is empty."
msgstr "Comproba se a cadea está vacía."

#: lib/specials.cpp:210
msgid "Checks if the string is a valid number."
msgstr "Comproba se a cadea é un número válido."

#: lib/specials.cpp:212
msgid "Returns given section of a string."
msgstr "Devolve a sección dada dunha cadea."

#: lib/specials.cpp:214
#, kde-format
msgid ""
"Returns the given string with %1, %2, %3 replaced with <i>arg1</i>, <i>arg2</"
"i>, <i>arg3</i> accordingly."
msgstr ""
"Devolve a cadea dada con %1, %2, %3 substituidos por <i>arg1</i>, <i>arg2</"
"i>, e <i>arg3</i> segundo corresponda."

#: lib/specials.cpp:218
msgid "Returns content of given file."
msgstr "Devolve o contido dun ficheiro dado."

#: lib/specials.cpp:220
msgid "Writes given string to a file."
msgstr "Escrebe a cadea dada nun ficheiro."

#: lib/specials.cpp:222
msgid "Appends given string to the end of a file."
msgstr "Engade a cadea dada no final dun ficheiro."

#: lib/specials.cpp:225
msgid "Shows color dialog. Returns color in #RRGGBB format."
msgstr "Mostra o selector de cores. Devolve a cor no formato #RRGGBB."

#: lib/specials.cpp:227
msgid "Shows text selection dialog. Returns entered text."
msgstr "Mostra o diálogo de escolla de texto. Devolve o texto inserido."

#: lib/specials.cpp:229
msgid "Shows a dialog asking user for password and returns it."
msgstr "Mostra un diálogo de contrasinais, e devolve o contrasinal."

#: lib/specials.cpp:231
msgid "Shows value selection dialog. Returns entered value."
msgstr "Mostra un diálogo de escolla de valor. Devolve o valor inserido."

#: lib/specials.cpp:233
msgid "Shows float value selection dialog. Returns entered value."
msgstr ""
"Mostra un diálogo de escolla de valor en ponto flutuante. Devolve o valor "
"inserido."

#: lib/specials.cpp:235
msgid "Shows existing file selection dialog. Returns selected file."
msgstr "Mostra o diálogo de escolla de ficheiro. Devolve o ficheiro escollido."

#: lib/specials.cpp:237
msgid "Shows save file selection dialog. Returns selected file."
msgstr "Mostra o diálogo de gardar ficheiro. Devolve o ficheiro escollido."

#: lib/specials.cpp:239
msgid "Shows directory selection dialog. Returns selected directory."
msgstr "Mostra o diálogo de escolla de cartafol. Devolve o cartafol escollido."

#: lib/specials.cpp:241
msgid ""
"Shows multiple files selection dialog. Returns EOL-separated list of "
"selected files."
msgstr ""
"Mostra o diálogo de escolla de múltiplos ficheiros. Devolve unha lista "
"separada por EOL cos ficheiros escollidos."

#: lib/specials.cpp:245
msgid "Shows an information dialog."
msgstr "Mostra un diálogo informativo."

#: lib/specials.cpp:247
msgid "Shows an error dialog."
msgstr "Mostra un diálogo de erro."

#: lib/specials.cpp:249
msgid ""
"Shows a warning dialog with up to three buttons. Returns number of selected "
"button."
msgstr ""
"Mostra un diálogo de avido con até tres botóns. Devolve o número do botón "
"premido."

#: lib/specials.cpp:251
msgid ""
"Shows a question dialog with up to three buttons. Returns number of selected "
"button."
msgstr ""
"Mostra un diálogo de pergunta con até tres botóns. Devolve o número do botón "
"premido."

#: lib/kommanderfunctions.cpp:110
msgid "Unterminated @execBegin ... @execEnd block."
msgstr "Bloqu @execBegin ... @execEnd non terminado."

#: lib/kommanderfunctions.cpp:128 lib/kommanderfunctions.cpp:154
msgid "Unterminated @forEach ... @end block."
msgstr "Bloque @forEach ... @end non terminado."

#: lib/kommanderfunctions.cpp:191
msgid "Unterminated @if ... @endif block."
msgstr "Bloque @if ... @endIf non terminado."

#: lib/kommanderfunctions.cpp:211
msgid "Unterminated @switch ... @end block."
msgstr "Bloque @switch ... @end non terminado."

#: lib/kommanderfunctions.cpp:298
#, kde-format
msgid "Unknown widget: @%1."
msgstr "Widget descoñecido: @%1."

#: lib/kommanderfunctions.cpp:316
#, kde-format
msgid "Infinite loop: @%1 called inside @%2."
msgstr "Bucle infinito: @%1 é chamado desde @%2."

#: lib/kommanderfunctions.cpp:321
#, kde-format
msgid "Script for @%1 is empty."
msgstr "O script para @%1 está vacío."

#: lib/kommanderwidget.cpp:120
msgid "Invalid state for associated text."
msgstr "Estado non válido para o texto asociado."

#: lib/kommanderwidget.cpp:140
#, kde-format
msgid "Line %1: %2.\n"
msgstr "Liña %1: %2.\n"

#: lib/kommanderwidget.cpp:241
#, kde-format
msgid "Unknown special: '%1'."
msgstr "Especial descoñecido: \"%1\"."

#: lib/kommanderwidget.cpp:264
#, kde-format
msgid "Unmatched parenthesis in D-Bus call '%1'."
msgstr "Parénteses non casados na chamada D-Bus \"%1\"."

#: lib/kommanderwidget.cpp:270
#, kde-format
