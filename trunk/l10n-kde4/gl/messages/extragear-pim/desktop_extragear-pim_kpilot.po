#: conduits/abbrowserconduit/abbrowser_conduit.desktop:4
msgctxt "Comment"
msgid "This conduit syncs the handheld addressbook with KDE's addressbook."
msgstr ""
"Este conduto sincroniza o caderno de enderezos do dispositivo co de KDE."

#: conduits/abbrowserconduit/abbrowser_conduit.desktop:22
msgctxt "Name"
msgid "Addressbook"
msgstr "Caderno de enderezos"

#: conduits/docconduit/doc_conduit.desktop:4
msgctxt "Comment"
msgid "Adds text files to your handheld, suitable for DOC readers."
msgstr ""
"Engade ficheiros de texto ao seu dispositivo, apropriado para leitores de "
"DOC."

#: conduits/docconduit/doc_conduit.desktop:22
msgctxt "Name"
msgid "Palm DOC"
msgstr "Palm DOC"

#: conduits/docconduit/kpalmdoc.desktop:4
msgctxt "Name"
msgid "KPalmDOC"
msgstr "KPalmDOC"

#: conduits/docconduit/kpalmdoc.desktop:6
msgctxt "GenericName"
msgid "PalmDOC Converter"
msgstr "Convertedor PalmDOC"

#: conduits/knotes/knotes-conduit.desktop:4
msgctxt "Comment"
msgid "This conduit syncs the Memo Pad application with KNotes."
msgstr "Este conduto sincroniza a aplicación Memo Pad con KNotes."

#: conduits/knotes/knotes-conduit.desktop:22
msgctxt "Name"
msgid "KNotes / Memos"
msgstr "KNotes / Memos"

#: conduits/malconduit/mal_conduit.desktop:4
msgctxt "Name"
msgid "MAL (AvantGo) Conduit"
msgstr "Conduto MAL (AvantGo)"

#: conduits/malconduit/mal_conduit.desktop:20
msgctxt "Comment"
msgid ""
"Syncronize AvantGo (or generally a MAL server's content) to the handheld. "
"This allows you to view web-pages offline on the handheld, like your cinema "
"or TV schedule, or any other web page."
msgstr ""
"Sincroniza AvantGo (en xeral un servidor de contidos MAL) co dispositivo. "
"Isto permítelle ver páxinas web no dispositivo sen conexón, como a "
"programación da televisión ou a carteleira, ou calquera outra páxina."

#: conduits/memofileconduit/memofile-conduit.desktop:4
msgctxt "Name"
msgid "Memo File"
msgstr "Ficheiro Memo"

#: conduits/memofileconduit/memofile-conduit.desktop:23
msgctxt "Comment"
msgid "This conduit syncs your handheld memos with a local directory."
msgstr ""
"Este conduto sincroniza as notas no seu dispositivo cun cartafol local."

#: conduits/notepadconduit/notepad-conduit.desktop:4
msgctxt "Name"
msgid "NotePad"
msgstr "NotePad"

#: conduits/notepadconduit/notepad-conduit.desktop:11
msgctxt "Comment"
msgid "This conduit backs up NotePad drawings to a local folder."
msgstr ""
"Este conduto fai unha copia de seguridade dos debuxos de NotePad nun "
"cartafol local."

#: conduits/null/null-conduit.desktop:4
msgctxt "Name"
msgid "NULL"
msgstr "NULO"

#: conduits/null/null-conduit.desktop:6
msgctxt "Comment"
msgid "This conduit does nothing."
msgstr "Este conduto non fai cousa ningunha."

#: conduits/perlconduit/perl-conduit.desktop:4
msgctxt "Name"
msgid "Perl (Sample)"
msgstr "Perl (Mostra)"

#: conduits/perlconduit/perl-conduit.desktop:24
msgctxt "Comment"
msgid "This sample conduit runs a Perl interpreter."
msgstr "Este conduto de exemplo executa un intérprete de Perl."

#: conduits/popmail/popmail-conduit.desktop:4
msgctxt "Comment"
msgid "Send mail from your handheld through KMail."
msgstr "Enviar correo electrónico desde o seu dispositivo mediante KMail."

#: conduits/popmail/popmail-conduit.desktop:22
msgctxt "Name"
msgid "Mail"
msgstr "Correo"

#: conduits/pythonconduit/python-conduit.desktop:4
msgctxt "Name"
msgid "Python (Sample)"
msgstr "Python (Mostra)"

#: conduits/pythonconduit/python-conduit.desktop:23
msgctxt "Comment"
msgid "This sample conduit runs a Python interpreter."
msgstr "Este conduto de mostra executa un intérprete de python."

#: conduits/sysinfoconduit/sysinfo_conduit.desktop:4
msgctxt "Comment"
msgid ""
"This conduit writes information about your handheld and the sync to a file."
msgstr ""
"Este conduto escrebe información acerca do seu dispositivo e da "
"sincronización nun ficheiro."

#: conduits/sysinfoconduit/sysinfo_conduit.desktop:22
msgctxt "Name"
msgid "System Information"
msgstr "Información do sistema"

#: conduits/timeconduit/time_conduit.desktop:4
msgctxt "Comment"
msgid "This conduit sets the time on your handheld from the PC clock."
msgstr "Este conduto axusta a hora do dispositivo coa do reloxo do PC."

#: conduits/timeconduit/time_conduit.desktop:22
msgctxt "Name"
msgid "Time Synchronization"
msgstr "Sincronización da hora"

#: conduits/vcalconduit/todo-conduit.desktop:4
msgctxt "Comment"
msgid "This conduit syncs the ToDo list from your handheld to KOrganizer."
msgstr ""
"Este conduto sincroniza a lista de tarefas pendentes do seu dispositivo con "
"KOrganizer."

#: conduits/vcalconduit/todo-conduit.desktop:22
msgctxt "Name"
msgid "ToDos (KOrganizer)"
msgstr "ToDos (KOrganizer)"

#: conduits/vcalconduit/vcal-conduit.desktop:4
msgctxt "Name"
msgid "Calendar (KOrganizer)"
msgstr "Axenda (KOrganizer)"

#: conduits/vcalconduit/vcal-conduit.desktop:24
msgctxt "Comment"
msgid "This conduit synchronizes your handheld with the KOrganizer datebook."
msgstr "Este conduto syncroniza o seu dispositivo coa axenda de KOrganizer."

#: kpilot/kpilot.desktop:4
msgctxt "Name"
msgid "KPilot"
msgstr "KPilot"

#: kpilot/kpilot.desktop:6
msgctxt "GenericName"
msgid "PalmPilot Tool"
msgstr "Ferramenta para PalmPilot"

#: kpilot/kpilot_config.desktop:14
msgctxt "Name"
msgid "KPilot Configuration"
msgstr "Configuración de KPilot"

#: kpilot/kpilot_config.desktop:34
msgctxt "Comment"
msgid "KPilot Main Configuration"
msgstr "Configuración principal de KPilot"

#: kpilot/kpilot_config.desktop:54
msgctxt "Keywords"
msgid "kpilot,main"
msgstr "kpilot,principal"

#: kpilot/kpilotconduit.desktop:5
msgctxt "Comment"
msgid "KPilot Conduit"
msgstr "Conduto de KPilot"

#: kpilot/kpilotdaemon.desktop:4
msgctxt "Name"
msgid "KPilotDaemon"
msgstr "KPilotDaemon"
