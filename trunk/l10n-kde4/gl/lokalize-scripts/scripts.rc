<KrossScripting>
  <collection comment="Utilidades" name="tools" text="Utilidades">
    <script icon="text-x-python" comment="Xera a versión traducida do documento ODF" name="xliff2odf" file="xliff2odf.py" interpreter="python" text="Xuntar no ODF"/>
    <script icon="text-x-python" comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" name="widget-text-capture" interpreter="python" text="Captura do texto de widgets"/>
    <script icon="text-x-python" name="Apertium MT" file="apertium.py" interpreter="python" text="Translate source text via Apertium"/>
    <script icon="text-x-python" comment="Open source file" name="opensrc" file="../../scripts/lokalize/opensrc.py" interpreter="python" text="Open source file">
      <property name="autorun">true</property>
    </script>
  </collection>
</KrossScripting>
