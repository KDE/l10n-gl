<KrossScripting>
  <collection text="Utilidades" name="tools" comment="Utilidades">
    <script text="Xuntar no ODF" interpreter="python" file="xliff2odf.py" name="xliff2odf" comment="Xera a versión traducida do documento ODF" icon="text-x-python"/>
    <script text="Translate source text via Apertium" interpreter="python" file="apertium.py" name="Apertium MT" icon="text-x-python"/>
    <script text="Adds a predefined comment intended to be a rejection mark" interpreter="python" file="rejectionMark.py" name="Mark as rejected" icon="text-x-python"/>
  </collection>
</KrossScripting>
