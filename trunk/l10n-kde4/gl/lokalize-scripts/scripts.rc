<KrossScripting>
  <collection text="Utilidades" name="tools" comment="Utilidades">
    <script text="Xuntar no ODF" name="xliff2odf" comment="Xera a versión traducida do documento ODF" interpreter="python" file="xliff2odf.py" icon="text-x-python"/>
    <script enabled="false" text="Translate source text via Apertium" name="Apertium MT" comment="(I18N_EMPTY_MESSAGE)" interpreter="python" file="apertium.py" icon="text-x-python"/>
    <script enabled="false" text="Adds a predefined comment intended to be a rejection mark" name="Mark as rejected" comment="(I18N_EMPTY_MESSAGE)" interpreter="python" file="rejectionMark.py" icon="text-x-python"/>
  </collection>
</KrossScripting>
