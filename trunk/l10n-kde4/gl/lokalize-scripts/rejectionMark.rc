<KrossScripting>
	<collection name="tools" text="Utilidades">
		<script text="Adds a predefined comment intended to be a rejection mark"
			name="Mark as rejected"
			interpreter="python"
			enabled="true"
			file="rejectionMark.py" />
	</collection>
</KrossScripting>
