msgstr "<title>Módulo de distancia angular</title>"

#. Tag: primary
#: calc-angdist.docbook:3
#, no-c-format
msgid "Tools"
msgstr "Ferramentas"

#. Tag: secondary
#: calc-angdist.docbook:4
#, no-c-format
msgid "Astrocalculator"
msgstr "Astrocalculadora"

#. Tag: tertiary
#: calc-angdist.docbook:5
