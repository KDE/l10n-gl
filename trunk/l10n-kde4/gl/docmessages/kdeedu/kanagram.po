#, no-c-format
msgid "New Stuff"
msgstr "Cousas Novas"

#. Tag: para
#: index.docbook:391
#, no-c-format
#| msgid ""
#| "The <guilabel>New Stuff</guilabel> configuration page allows you to "
#| "obtain new vocabulary files from the Internet:"
msgid ""
"The <guibutton>Download new vocabulary</guibutton> button on the "
"<guilabel>Vocabularies</guilabel> configuration page allows you to obtain "
"new vocabulary files from the Internet:"
msgstr ""
"O botón <guibutton>Descargar un vocabulario novo</guibutton> da páxina de "
"configuración <guilabel>Vocabularios</guilabel> permite obter ficheiros con "
"vocabularios novos da Internet:"

#. Tag: screeninfo
#: index.docbook:397
#, no-c-format
msgid "&kanagram; new stuff settings"
msgstr "Configuración de Cousas Novas do &kanagram;"

#. Tag: phrase
#: index.docbook:403
#, no-c-format
