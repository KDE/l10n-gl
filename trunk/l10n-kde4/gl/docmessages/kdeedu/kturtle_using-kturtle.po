"Here you can quickly reach the most used actions. The Toolbar also contains "
"the <guilabel>Console</guilabel> where you can quickly invoke commands, this "
"might be useful in case you want to test a command without modifying the "
"content of the <link linkend=\"the-editor\">Editor</link>."
msgstr ""

#. Tag: para
#: using-kturtle.docbook:44
#, fuzzy, no-c-format
#| msgid ""
#| "You can configure the toolbar using <menuchoice><guimenu>Settings</"
#| "guimenu><guimenuitem>Configure Toolbars...</guimenuitem></menuchoice>"
