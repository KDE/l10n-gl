msgstr ""

#. Tag: para
#: konfigurator.docbook:1180
#, no-c-format
msgid "copying file(s)"
msgstr ""

#. Tag: para
#: konfigurator.docbook:1183
#, no-c-format
msgid "moving file(s)"
msgstr ""

