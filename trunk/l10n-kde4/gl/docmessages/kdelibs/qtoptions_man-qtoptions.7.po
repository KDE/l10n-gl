#. Tag: title
#: man-qtoptions.7.docbook:8
#, no-c-format
msgid "KDE User's Manual"
msgstr "Manual do usuario de KDE"

#. Tag: author
#: man-qtoptions.7.docbook:9
#, no-c-format
msgid "&Lauri.Watts; &Lauri.Watts.mail;"
msgstr "&Lauri.Watts; &Lauri.Watts.mail;"

#. Tag: date
#: man-qtoptions.7.docbook:10
#, no-c-format
msgid "2004-02-02"
msgstr "2004-02-02"

#. Tag: productname
#: man-qtoptions.7.docbook:11
#, no-c-format
msgid "K Desktop Environment"
msgstr "O ambiente de escritorio K"

#. Tag: refentrytitle
#: man-qtoptions.7.docbook:15
#, no-c-format
msgid "<refentrytitle>qtoptions</refentrytitle>"
msgstr "<refentrytitle>qtoptions</refentrytitle>"

#. Tag: manvolnum
#: man-qtoptions.7.docbook:16
#, no-c-format
msgid "<manvolnum>7</manvolnum>"
msgstr "<manvolnum>7</manvolnum>"

#. Tag: refname
#: man-qtoptions.7.docbook:20
#, no-c-format
msgid "<refname>qtoptions</refname>"
msgstr "<refname>qtoptions</refname>"

#. Tag: refpurpose
#: man-qtoptions.7.docbook:21
#, no-c-format
msgid "Common commandline options for all applications based on the Qt toolkit"
msgstr ""
"Opcións habituais da liña de comandos para todos os aplicativos baseados nas "
"bibliotecas Qt"

#. Tag: cmdsynopsis
#: man-qtoptions.7.docbook:25
#, no-c-format
msgid ""
"<command><replaceable>Qt application</replaceable></command> <arg choice="
"\"opt\">Qt Generic Options</arg>"
msgstr ""
"<command><replaceable>Aplicativo baseado en Qt</replaceable></command> <arg "
"choice=\"opt\">Opcións xenéricas de Qt</arg>"

#. Tag: title
#: man-qtoptions.7.docbook:33
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: para
#: man-qtoptions.7.docbook:35
#, no-c-format
msgid "The following options apply to all &Qt; applications:"
msgstr ""
"As seguintes opcións son de aplicación a todos os aplicativos baseados en "
"&Qt;:"

#. Tag: term
#: man-qtoptions.7.docbook:39
#, no-c-format
msgid "<option>--display</option> <parameter>displayname</parameter>"
msgstr "<option>--display</option> <parameter>nomeDisplay</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:43
#, no-c-format
msgid "Use the X-server display <parameter>displayname</parameter>."
msgstr "Usa o display <parameter>nomeDisplay</parameter> do servidor das X."

#. Tag: term
#: man-qtoptions.7.docbook:49
#, no-c-format
msgid "<option>--session</option> <parameter>sessionId</parameter>"
msgstr "<option>--session</option> <parameter>sessionId</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:53
#, no-c-format
msgid "Restore the application for the given <parameter>sessionId</parameter>."
msgstr ""
"Restaura o aplicativo para a <parameter>sessionId</parameter> que se indica."

#. Tag: option
#: man-qtoptions.7.docbook:60
#, no-c-format
msgid "--cmap"
msgstr "--cmap"

#. Tag: para
#: man-qtoptions.7.docbook:63
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display."
msgstr ""
"Fai que o aplicativo instale un mapa de cores privado nun display de 8-bits."

#. Tag: term
#: man-qtoptions.7.docbook:69
#, no-c-format
msgid "<option>--ncols</option> <parameter>count</parameter>"
msgstr "<option>--ncols</option> <parameter>número</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:73
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on an 8-bit display, "
"if the application is using the <methodname>QApplication::ManyColor</"
"methodname> color specification."
msgstr ""
"Limita o número de cores reservadas no cubo de cores dun display de 8-bits, "
"se o aplicativo está a usar a especificación de cor "
"<methodname>QApplication::ManyColor</methodname>."

#. Tag: option
#: man-qtoptions.7.docbook:82
#, no-c-format
msgid "--nograb"
msgstr "--nograb"

#. Tag: para
#: man-qtoptions.7.docbook:85
#, no-c-format
msgid "Tells &Qt; to never grab the mouse or the keyboard."
msgstr "Indicalle a &Qt; que nunca capture o rato nin o teclado."

#. Tag: option
#: man-qtoptions.7.docbook:91
#, no-c-format
msgid "--dograb"
msgstr "--dograb"

#. Tag: para
#: man-qtoptions.7.docbook:94
#, no-c-format
msgid ""
"Running under a debugger can cause an implicit <option>--nograb</option>, "
"use <option>--dograb</option> to override."
msgstr ""
"Unha execución dentro dun depurador pode provocar un <option>--nograb</"
"option> implícito, use <option>-dograb</option> para sobrescribir."

#. Tag: option
#: man-qtoptions.7.docbook:102
#, no-c-format
msgid "--sync"
msgstr "--sync"

#. Tag: para
#: man-qtoptions.7.docbook:105
#, no-c-format
msgid "Switches to synchronous mode for debugging."
msgstr "Conmuta o modo sincrónico para depuración."

#. Tag: term
#: man-qtoptions.7.docbook:110
#, no-c-format
msgid ""
"<option>--fn</option>,<option>--font</option> <parameter>fontname</parameter>"
msgstr ""
"<option>--fn</option>,<option>--font</option> <parameter>nomeFonte</"
"parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:115
#, no-c-format
msgid "Defines the application font."
msgstr "Define o tipo de letra do aplicativo."

#. Tag: term
#: man-qtoptions.7.docbook:120
#, no-c-format
msgid ""
"<option>--bg</option>,<option>--background</option> <parameter>color</"
"parameter>"
msgstr ""
"<option>--bg</option>,<option>--background</option> <parameter>cor</"
"parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:125
#, no-c-format
msgid ""
"Sets the default background color and an application palette (light and dark "
"shades are calculated)."
msgstr ""
"Configura a cor de fondo por omisión e unha paleta do aplicativo (as sombras "
"claras e escuras son calculadas)."

#. Tag: term
#: man-qtoptions.7.docbook:131
#, no-c-format
msgid ""
"<option>--fg</option>,<option>--foreground</option> <parameter>color</"
"parameter>"
msgstr ""
"<option>--fg</option>,<option>--foreground</option> <parameter>cor</"
"parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:136
#, no-c-format
msgid "Sets the default foreground color"
msgstr "Configura a cor por omisión de primeiro plano"

#. Tag: term
#: man-qtoptions.7.docbook:141
#, no-c-format
msgid ""
"<option>--btn</option>,<option>--button</option> <parameter>color</parameter>"
msgstr ""
"<option>--btn</option>,<option>--button</option> <parameter>cor</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:146
#, no-c-format
msgid "Sets the default button color."
msgstr "Configura a cor por omisión dos botóns."

#. Tag: term
#: man-qtoptions.7.docbook:152
#, no-c-format
msgid "<option>--name</option> <parameter>name</parameter>"
msgstr "<option>--name</option> <parameter>nome</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:156
#, no-c-format
msgid "Sets the application name."
msgstr "Estabelece o nome do aplicativo."

#. Tag: term
#: man-qtoptions.7.docbook:161
#, no-c-format
msgid "<option>--title</option> <parameter>title</parameter>"
msgstr "<option>--title</option> <parameter>título</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:165
#, no-c-format
msgid "Sets the application title (caption)."
msgstr "Estabelece o título do aplicativo (para a barra de título)."

#. Tag: term
#: man-qtoptions.7.docbook:170
#, no-c-format
msgid "<option>--visual</option> <parameter>TrueColor</parameter>"
msgstr "<option>--visual</option> <parameter>TrueColor</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:174
#, no-c-format
msgid ""
"Forces the application to use a <parameter>TrueColor</parameter> visual on "
"an 8-bit display."
msgstr ""
"Obriga ao aplicativo a usar un aspeito <parameter>TrueColor</parameter> nun "
"display de 8-bits."

#. Tag: term
#: man-qtoptions.7.docbook:181
#, no-c-format
msgid "<option>--inputstyle</option> <parameter>inputstyle</parameter>"
msgstr "<option>--inputstyle</option> <parameter>estilo de entrada</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:185
#, no-c-format
msgid ""
"Sets XIM (X Input Method) input style. Possible values are "
"<parameter>onthespot</parameter>, <parameter>overthespot</parameter>, "
"<parameter>offthespot</parameter> and <parameter>root</parameter>."
msgstr ""
"Estabelece o estilo de entrada de XIM (X Input Method). Os valores posíbeis "
"son <parameter>onthespot</parameter>, <parameter>overthespot</parameter>, "
"<parameter>offthespot</parameter> e <parameter>root</parameter>."

#. Tag: term
#: man-qtoptions.7.docbook:193
#, no-c-format
msgid "<option>--im</option> <parameter>XIM server</parameter>"
msgstr "<option>--im</option> <parameter>servidor XIM</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:197
#, no-c-format
msgid "Set XIM server."
msgstr "Indica o servidor XIM."

#. Tag: option
#: man-qtoptions.7.docbook:203
#, no-c-format
msgid "--noxim"
msgstr "--noxim"

#. Tag: para
#: man-qtoptions.7.docbook:206
#, no-c-format
msgid "Disable XIM"
msgstr "Deshabilita o XIM"

#. Tag: option
#: man-qtoptions.7.docbook:212
#, no-c-format
msgid "--reverse"
msgstr "--reverse"

#. Tag: para
#: man-qtoptions.7.docbook:215
#, no-c-format
msgid "mirrors the whole layout of widgets"
msgstr "inverte a disposición dos trebellos"

#. Tag: term
#: man-qtoptions.7.docbook:220
#, no-c-format
msgid "<option>--stylesheet</option> <replaceable>file.qss</replaceable>"
msgstr "<option>--stylesheet</option> <replaceable>ficheiro.qss</replaceable>"

#. Tag: para
#: man-qtoptions.7.docbook:224
#, no-c-format
msgid "applies the Qt stylesheet to the application widgets"
msgstr "aplica a folla de estilos de Qt aos trebellos do aplicativo"

#. Tag: title
#: man-qtoptions.7.docbook:234
#, no-c-format
msgid "See Also"
msgstr "Consulte tamén"

#. Tag: para
#: man-qtoptions.7.docbook:235
#, no-c-format
msgid "<replaceable>kdeoptions</replaceable>(7)"
msgstr "<replaceable>kdeoptions</replaceable>(7)"

