msgstr "<refname>kconfig_compiler</refname>"

#. Tag: refpurpose
#: man-kconfig_compiler.1.docbook:54
#, no-c-format
msgid "KDE configuration compiler"
msgstr "Compilador da configuración de KDE"

#. Tag: cmdsynopsis
#: man-kconfig_compiler.1.docbook:58
#, no-c-format
msgid ""
"<command>kconfig_compiler</command> <arg>Qt-options</arg> <arg>KDE-options</"
"arg> <arg>options</arg> <arg choice=\"plain\"><replaceable>file.kcfg</"
"replaceable></arg> <arg choice=\"plain\"><replaceable>file.kcfgc</"
"replaceable></arg>"
msgstr ""
"<command>kconfig_compiler</command> <arg>Opcións de Qt</arg> <arg>Opcións de "
"KDE</arg> <arg>opcións</arg> <arg choice=\"plain\"><replaceable>file.kcfg</"
"replaceable></arg> <arg choice=\"plain\"><replaceable>file.kcfgc</"
"replaceable></arg>"

#. Tag: title
#: man-kconfig_compiler.1.docbook:69
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-kconfig_compiler.1.docbook:70
#, no-c-format
msgid ""
"<command>kconfig_compiler</command> generates C++ source code from two "
"files. The first file (.kcfg) contains information about configuration "
"options and the second file (.kcfgc) provides the code generation options."
msgstr ""
"<command>kconfig_compiler</command> xera código fonte en C++ a partir de "
"dous ficheiros. O primeiro deles (.kcfg) contén información sobre as opcións "
"de configuracion e o segundo (.kcfgc) fornece as opcións da xeración do "
"código."

#. Tag: para
#: man-kconfig_compiler.1.docbook:74
#, no-c-format
msgid ""
"The generated source code contains a class based on "
"<command>KConfigSkeleton</command> that provides an API to access the "
"applications configuration data."
msgstr ""
"O codigo fonte xerado contén unha clase baseada en <command>KConfigSkeleton</"
"command> que fornece unha API para acceder aos dados de configuración do "
"aplicativo."

#. Tag: title
#: man-kconfig_compiler.1.docbook:80
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: emphasis
#: man-kconfig_compiler.1.docbook:84
#, no-c-format
msgid "Arguments:"
msgstr "Argumentos:"

#. Tag: replaceable
#: man-kconfig_compiler.1.docbook:88
#, no-c-format
msgid "file.kcfg"
msgstr "file.kcfg"

#. Tag: para
#: man-kconfig_compiler.1.docbook:91
#, no-c-format
msgid "Input kcfg XML file"
msgstr "Ficheiro XML kcfg de entrada"

#. Tag: replaceable
#: man-kconfig_compiler.1.docbook:97
#, no-c-format
msgid "file.kcfgc"
msgstr "file.kcfgc"

#. Tag: para
#: man-kconfig_compiler.1.docbook:100
#, no-c-format
msgid "Code generation options file"
msgstr "Ficheiro de opcións da xeración do código"

#. Tag: emphasis
#: man-kconfig_compiler.1.docbook:108
#, no-c-format
msgid "Options:"
msgstr "Opcións:"

#. Tag: option
#: man-kconfig_compiler.1.docbook:112
#, no-c-format
msgid "-d, --directory &lt;dir&gt;"
msgstr "-d, --directory &lt;dir&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:115
#, no-c-format
msgid "Directory to generate files in [.]"
msgstr "O directorio onde xerar os ficheiros [.]"

#. Tag: emphasis
#: man-kconfig_compiler.1.docbook:123
#, no-c-format
msgid "Generic options:"
msgstr "Opcións xenéricas:"

#. Tag: option
#: man-kconfig_compiler.1.docbook:127
#, no-c-format
msgid "--help"
msgstr "--help"

#. Tag: para
#: man-kconfig_compiler.1.docbook:130
#, no-c-format
msgid "Show help about options"
msgstr "Mostra axuda sobre as opcións"

#. Tag: option
#: man-kconfig_compiler.1.docbook:136
#, no-c-format
msgid "--help-qt"
msgstr "--help-qt"

#. Tag: para
#: man-kconfig_compiler.1.docbook:139
#, no-c-format
msgid "Show Qt specific options"
msgstr "Mostra as opcións específicas de Qt"

#. Tag: option
#: man-kconfig_compiler.1.docbook:145
#, no-c-format
msgid "--help-kde"
msgstr "--help-kde"

#. Tag: para
#: man-kconfig_compiler.1.docbook:148
#, no-c-format
msgid "Show KDE specific options"
msgstr "Mostra as opcións específicas de KDE"

#. Tag: option
#: man-kconfig_compiler.1.docbook:154
#, no-c-format
msgid "--help-all"
msgstr "--help-all"

#. Tag: para
#: man-kconfig_compiler.1.docbook:157
#, no-c-format
msgid "Show all options"
msgstr "Mostra todas as opcións"

#. Tag: option
#: man-kconfig_compiler.1.docbook:163
#, no-c-format
msgid "--author"
msgstr "--author"

#. Tag: para
#: man-kconfig_compiler.1.docbook:166
#, no-c-format
msgid "Show author information"
msgstr "Mostra información do autor"

#. Tag: option
#: man-kconfig_compiler.1.docbook:172
#, no-c-format
msgid "-v, --version"
msgstr "-v, --version"

#. Tag: para
#: man-kconfig_compiler.1.docbook:175
#, no-c-format
msgid "Show version information"
msgstr "Mostra información da versión"

#. Tag: option
#: man-kconfig_compiler.1.docbook:181
#, no-c-format
msgid "--license"
msgstr "--license"

#. Tag: para
#: man-kconfig_compiler.1.docbook:184
#, no-c-format
msgid "Show license information"
msgstr "Mostra información da licenza"

#. Tag: emphasis
#: man-kconfig_compiler.1.docbook:192
#, no-c-format
msgid "KDE Options:"
msgstr "Opcións de KDE:"

#. Tag: option
#: man-kconfig_compiler.1.docbook:196
#, no-c-format
msgid "--caption &lt;caption&gt;"
msgstr "--caption &lt;título&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:199
#, no-c-format
msgid "Use 'caption' as name in the titlebar"
msgstr "Usa \"título\" como o nome na barra do título"

#. Tag: option
#: man-kconfig_compiler.1.docbook:205
#, no-c-format
msgid "--icon &lt;icon&gt;"
msgstr "--icon &lt;icona&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:208 man-kconfig_compiler.1.docbook:217
#, no-c-format
msgid "Use 'icon' as the application icon"
msgstr "Usar «icona» como a icona do aplicativo."

#. Tag: option
#: man-kconfig_compiler.1.docbook:214
#, no-c-format
msgid "--miniicon &lt;icon&gt;"
msgstr "--miniicon &lt;icona&gt;"

#. Tag: option
#: man-kconfig_compiler.1.docbook:223
#, no-c-format
msgid "--config &lt;filename&gt;"
msgstr "--config &lt;nomeFicheiro&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:226
#, no-c-format
msgid "Use alternative configuration file"
msgstr "Usa un ficheiro de configuración alternativo"

#. Tag: option
#: man-kconfig_compiler.1.docbook:232
#, no-c-format
msgid "--dcopserver &lt;server&gt;"
msgstr "--dcopserver &lt;servidor&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:235
#, no-c-format
msgid "Use the DCOP server specified by 'server'"
msgstr "Usa o servidor DCOP especificado por \"servidor\""

#. Tag: option
#: man-kconfig_compiler.1.docbook:241
#, no-c-format
msgid "--nocrashhandler"
msgstr "--nocrashhandler"

#. Tag: para
#: man-kconfig_compiler.1.docbook:244
#, no-c-format
msgid "Disable crash handler to get core dumps"
msgstr "Desactivar o xestor de quebras para obter emborcados de memoria"

#. Tag: option
#: man-kconfig_compiler.1.docbook:250
#, no-c-format
msgid "--waitforwm"
msgstr "--waitforwm"

#. Tag: para
#: man-kconfig_compiler.1.docbook:253
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager"
msgstr "Agarda por un xestor de xanelas compatíbel con WM_NET"

#. Tag: option
#: man-kconfig_compiler.1.docbook:259
#, no-c-format
msgid "--style &lt;style&gt;"
msgstr "--style &lt;estilo&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:262
#, no-c-format
msgid "Sets the application GUI style"
msgstr "Estabelece o estilo da GUI do aplicativo"

#. Tag: option
#: man-kconfig_compiler.1.docbook:268
#, no-c-format
msgid "--geometry &lt;geometry&gt;"
msgstr "--geometry &lt;xeometría&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:271
#, no-c-format
msgid ""
"Sets the client geometry of the main widget - see man X for the argument "
"format"
msgstr ""
"Estabelece da xeometría do trebello principal - consulte man X para saber "
"máis sobre o formato do argumento"

#. Tag: emphasis
#: man-kconfig_compiler.1.docbook:279
#, no-c-format
msgid "Qt options:"
msgstr "Opcións de Qt:"

#. Tag: option
#: man-kconfig_compiler.1.docbook:283
#, no-c-format
msgid "--display &lt;displayname&gt;"
msgstr "--display &lt;nomePantalla&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:286
#, no-c-format
msgid "Use the X-server display 'displayname'"
msgstr "Usa a pantalla «displayname» do servidor X"

#. Tag: option
#: man-kconfig_compiler.1.docbook:292
#, no-c-format
msgid "--session &lt;sessionId&gt;"
msgstr "--session &lt;idSesion&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:295
#, no-c-format
msgid "Restore the application for the given 'sessionId'"
msgstr "Restaura o aplicativo co \"idSesión\" indicado"

#. Tag: option
#: man-kconfig_compiler.1.docbook:301
#, no-c-format
msgid "--cmap"
msgstr "--cmap"

#. Tag: para
#: man-kconfig_compiler.1.docbook:304
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display"
msgstr ""
"Fai que o aplicativo instale un mapa de cores privado nunha pantalla de 8-bit"

#. Tag: option
#: man-kconfig_compiler.1.docbook:310
#, no-c-format
msgid "--ncols &lt;count&gt;"
msgstr "--ncols &lt;cantidade&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:313
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on an 8-bit display, "
"if the application is using the QApplication::ManyColor color specification"
msgstr ""
"Limita o número de cores reservadas no cubo de cores nunha pantalla de 8-"
"bit, se o aplicativo está a usar a especificación de cor "
"QApplication::ManyColor"

#. Tag: option
#: man-kconfig_compiler.1.docbook:319
#, no-c-format
msgid "--nograb"
msgstr "--nograb"

#. Tag: para
#: man-kconfig_compiler.1.docbook:322
#, no-c-format
msgid "Tells Qt to never grab the mouse or the keyboard"
msgstr "Indícalle a Qt que nunha capture o rato nin o teclado"

#. Tag: option
#: man-kconfig_compiler.1.docbook:328
#, no-c-format
msgid "--sync"
msgstr "--sync"

#. Tag: para
#: man-kconfig_compiler.1.docbook:331
#, no-c-format
msgid "Switches to synchronous mode for debugging"
msgstr "Cambia para o modo síncrono para depuración"

#. Tag: option
#: man-kconfig_compiler.1.docbook:337
#, no-c-format
msgid "--fn, --font &lt;fontname&gt;"
msgstr "--fn, --font &lt;tipoLetra&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:340
#, no-c-format
msgid "Defines the application font"
msgstr "Define o tipo de letra do aplicativo"

#. Tag: option
#: man-kconfig_compiler.1.docbook:346
#, no-c-format
msgid "--bg, --background &lt;color&gt;"
msgstr "--bg, --background &lt;cor&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:349
#, no-c-format
msgid ""
"Sets the default background color and an application palette (light and dark "
"shades are calculated)"
msgstr ""
"Estabelece a cor de fondo predeterminada e a paleta do aplicativo (as "
"sombras claras e escuras son calculadas)"

#. Tag: option
#: man-kconfig_compiler.1.docbook:355
#, no-c-format
msgid "--fg, --foreground &lt;color&gt;"
msgstr "--fg, --foreground &lt;cor&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:358
#, no-c-format
msgid "Sets the default foreground color"
msgstr "Estabelece a cor de primeiro plano predeterminada"

#. Tag: option
#: man-kconfig_compiler.1.docbook:364
#, no-c-format
msgid "--btn, --button &lt;color&gt;"
msgstr "--btn, --button &lt;cor&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:367
#, no-c-format
msgid "Sets the default button color"
msgstr "Estabelece a cor predeterminada dos botóns"

#. Tag: option
#: man-kconfig_compiler.1.docbook:373
#, no-c-format
msgid "--name &lt;name&gt;"
msgstr "--name &lt;nome&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:376
#, no-c-format
msgid "Sets the application name"
msgstr "Estabelece o nome do aplicativo"

#. Tag: option
#: man-kconfig_compiler.1.docbook:382
#, no-c-format
msgid "--title &lt;title&gt;"
msgstr "--title &lt;título&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:385
#, no-c-format
msgid "Sets the application title (caption)"
msgstr "Estabelece o título do aplicativo"

#. Tag: option
#: man-kconfig_compiler.1.docbook:391
#, no-c-format
msgid "--visual TrueColor"
msgstr "--visual TrueColor"

#. Tag: para
#: man-kconfig_compiler.1.docbook:394
#, no-c-format
msgid "Forces the application to use a TrueColor visual on an 8-bit display"
msgstr "Obriga ao aplicativo a empregar TrueColor nunha pantalla de 8-bit"

#. Tag: option
#: man-kconfig_compiler.1.docbook:400
#, no-c-format
msgid "--inputstyle &lt;inputstyle&gt;"
msgstr "--inputstyle &lt;estiloEntrada&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:403
#, no-c-format
msgid ""
"Sets XIM (X Input Method) input style. Possible values are onthespot, "
"overthespot, offthespot, and root"
msgstr ""
"Axusta o estilo de entrada de XIM (X Input Method). Os valores posíbeis son "
"\"onthespot\", \"overthespot\", \"offthespot\", e \"root\""

#. Tag: option
#: man-kconfig_compiler.1.docbook:409
#, no-c-format
msgid "--im &lt;XIM server&gt;"
msgstr "--im &lt;servidor XIM&gt;"

#. Tag: para
#: man-kconfig_compiler.1.docbook:412
#, no-c-format
msgid "Sets XIM server"
msgstr "Indica o servidor XIM"

#. Tag: option
#: man-kconfig_compiler.1.docbook:418
#, no-c-format
msgid "--noxim"
msgstr "--noxim"

#. Tag: para
#: man-kconfig_compiler.1.docbook:421
#, no-c-format
msgid "Disable XIM"
msgstr "Desactivar XIM"

#. Tag: option
#: man-kconfig_compiler.1.docbook:427
#, no-c-format
msgid "--reverse"
msgstr "--reverse"

#. Tag: para
#: man-kconfig_compiler.1.docbook:430
#, no-c-format
msgid "Mirrors the whole layout of widgets"
msgstr "Reflicte a disposición dos trebellos por enteiro"

#. Tag: title
#: man-kconfig_compiler.1.docbook:439
#, no-c-format
msgid "See Also"
msgstr "Consulte tamén"

#. Tag: option
#: man-kconfig_compiler.1.docbook:443
#, no-c-format
msgid "http://developer.kde.org"
msgstr "http://developer.kde.org"

#. Tag: para
#: man-kconfig_compiler.1.docbook:446
#, no-c-format
msgid "KDE Developer's Corner website"
msgstr "O sitio web dos desenvolvedores de KDE"

#. Tag: title
#: man-kconfig_compiler.1.docbook:453
#, no-c-format
msgid "Bugs"
msgstr "Fallos"

#. Tag: para
#: man-kconfig_compiler.1.docbook:454
#, no-c-format
msgid ""
"Please use <ulink url=\"http://bugs.kde.org\">bugs.kde.org</ulink> to report "
"bugs, do not mail the authors directly."
msgstr ""
"Use <ulink url=\"http://bugs.kde.org\">bugs.kde.org</ulink> para informar de "
"fallos, non envíe correos directamente aos autores."

