#. Tag: title
#: man-kde4-config.1.docbook:8
#, no-c-format
msgid "&kde; User's Manual"
msgstr "Manual do usuario de &kde;"

#. Tag: author
#: man-kde4-config.1.docbook:9
#, no-c-format
msgid "<firstname>Stephan</firstname> <surname>Kulow</surname>"
msgstr "<firstname>Stephan</firstname> <surname>Kulow</surname>"

#. Tag: email
#: man-kde4-config.1.docbook:12
#, no-c-format
msgid "coolo@kde.org"
msgstr "coolo@kde.org"

#. Tag: date
#: man-kde4-config.1.docbook:14
#, no-c-format
msgid "2007-09-28"
msgstr "2007-09-28"

#. Tag: productname
#: man-kde4-config.1.docbook:15
#, no-c-format
msgid "K Desktop Environment"
msgstr "O ambiente de escritorio K"

#. Tag: manvolnum
#: man-kde4-config.1.docbook:20
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr "<manvolnum>1</manvolnum>"

#. Tag: refpurpose
#: man-kde4-config.1.docbook:25
#, no-c-format
msgid "Prints &kde; installation paths"
msgstr "Imprime as rutas de instalación de &kde;"

#. Tag: cmdsynopsis
#: man-kde4-config.1.docbook:29
#, no-c-format
msgid ""
"<command>kde4-config</command> <arg>--expandvars</arg> <arg>--prefix</arg> "
"<arg>--exec-prefix</arg> <arg>--libsuffix</arg> <arg>--localprefix</arg> "
"<arg>--version</arg> <arg>--types</arg> <arg>--path <replaceable>type</"
"replaceable></arg> <arg>--userpath <replaceable>type</replaceable></arg> "
"<arg>--install <replaceable>type</replaceable></arg>"
msgstr ""
"<command>kde4-config</command> <arg>--expandvars</arg> <arg>--prefix</arg> "
"<arg>--exec-prefix</arg> <arg>--libsuffix</arg> <arg>--localprefix</arg> "
"<arg>--version</arg> <arg>--types</arg> <arg>--path <replaceable>tipo</"
"replaceable></arg> <arg>--userpath <replaceable>tipo</replaceable></arg> "
"<arg>--install <replaceable>tipo</replaceable></arg>"

#. Tag: title
#: man-kde4-config.1.docbook:45
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-kde4-config.1.docbook:46
#, no-c-format
msgid ""
"kde4-config is a command line program used to retrieve information about "
"&kde; installation or user paths."
msgstr ""
"kde4-config é un programa da liña de ordes que se emprega para obter "
"información sobre a instalación de &kde; ou das rutas do usuario."

#. Tag: para
#: man-kde4-config.1.docbook:49
#, no-c-format
msgid ""
"Use this program to determine where the various aspects of the &kde; "
"installation reside on your system."
msgstr ""
"Empregue este programa para determinar onde están os distintos elementos da "
"instalación de &kde; no sistema."

#. Tag: title
#: man-kde4-config.1.docbook:56
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: option
#: man-kde4-config.1.docbook:60
#, no-c-format
msgid "--expandvars"
msgstr "--expandvars"

#. Tag: para
#: man-kde4-config.1.docbook:62
#, no-c-format
msgid "expand ${prefix} and ${exec_prefix} in output"
msgstr "expande ${prefix} e ${exec_prefix} na saída"

#. Tag: option
#: man-kde4-config.1.docbook:67
#, no-c-format
msgid "--prefix"
msgstr "--prefix"

#. Tag: para
#: man-kde4-config.1.docbook:69
#, no-c-format
msgid "Compiled in prefix for &kde; libraries"
msgstr "Prefixo compilado para as bibliotecas de &kde;"

#. Tag: option
#: man-kde4-config.1.docbook:74
#, no-c-format
msgid "--exec-prefix"
msgstr "--exec-prefix"

#. Tag: para
#: man-kde4-config.1.docbook:76
#, no-c-format
msgid "Compiled in exec_prefix for &kde; libraries"
msgstr "O exec_prefix compilado das bibliotecas de &kde;"

#. Tag: option
#: man-kde4-config.1.docbook:81
#, no-c-format
msgid "--libsuffix"
msgstr "--libsuffix"

#. Tag: para
#: man-kde4-config.1.docbook:83
#, no-c-format
msgid "Compiled in library path suffix"
msgstr "O sufixo compilado da ruta da biblioteca"

#. Tag: option
#: man-kde4-config.1.docbook:88
#, no-c-format
msgid "--localprefix"
msgstr "--localprefix"

#. Tag: para
#: man-kde4-config.1.docbook:90
#, no-c-format
msgid "Prefix in $<envar>HOME</envar> used to write files"
msgstr "O prefixo en $<envar>HOME</envar> empregado para escribir os ficheiros"

#. Tag: option
#: man-kde4-config.1.docbook:95
#, no-c-format
msgid "--version"
msgstr "--version"

#. Tag: para
#: man-kde4-config.1.docbook:97
#, no-c-format
msgid "Compiled in version string for &kde; libraries"
msgstr "A cadea de versión compilada das bibliotecas de &kde;"

#. Tag: option
#: man-kde4-config.1.docbook:102
#, no-c-format
msgid "--types"
msgstr "--types"

#. Tag: para
#: man-kde4-config.1.docbook:104
#, no-c-format
msgid "Print a list of all available &kde; resource types"
msgstr "Mostra unha lista de todos os tipos de recurso de &kde; dispoñíbeis"

#. Tag: option
#: man-kde4-config.1.docbook:109
#, no-c-format
msgid "--path <replaceable>type</replaceable>"
msgstr "--path <replaceable>tipo</replaceable>"

#. Tag: para
#: man-kde4-config.1.docbook:111
#, no-c-format
msgid "Search path for the specified <replaceable>type</replaceable>"
msgstr "Ruta de busca do <replaceable>tipo</replaceable> especificado"

#. Tag: option
#: man-kde4-config.1.docbook:116
#, no-c-format
msgid "--userpath <replaceable>type</replaceable>"
msgstr "--userpath <replaceable>tipo</replaceable>"

#. Tag: para
#: man-kde4-config.1.docbook:118
#, no-c-format
msgid "User paths for the types: desktop|autostart|trash|document"
msgstr "Rutas de usuario para os tipos: desktop|autostart|trash|document"

#. Tag: option
#: man-kde4-config.1.docbook:123
#, no-c-format
msgid "--install <replaceable>type</replaceable>"
msgstr "--install <replaceable>tipo</replaceable>"

#. Tag: para
#: man-kde4-config.1.docbook:125
#, no-c-format
msgid "Prefix to install resource files to"
msgstr "Prefixo onde instalar os ficheiros do recurso"

#. Tag: title
#: man-kde4-config.1.docbook:133
#, no-c-format
msgid "Examples"
msgstr "Exemplos"

#. Tag: para
#: man-kde4-config.1.docbook:135
#, no-c-format
msgid "Print the top-level &kde; installation directory:"
msgstr "Imprime o directorio superior da instalación de &kde;:"

#. Tag: para
#: man-kde4-config.1.docbook:136
#, no-c-format
msgid ""
"<prompt>&percnt;</prompt><userinput> <command>kde4-config --prefix</command> "
"</userinput>"
msgstr ""
"<prompt>&percnt;</prompt><userinput> <command>kde4-config --prefix</command> "
"</userinput>"

#. Tag: para
#: man-kde4-config.1.docbook:141
#, no-c-format
msgid "Print a list of all resource types:"
msgstr "Imprime unha lista con todos os tipos de recurso:"

#. Tag: para
#: man-kde4-config.1.docbook:143
#, no-c-format
msgid ""
"<prompt>&percnt;</prompt><userinput> <command>kde4-config --types</command> "
"</userinput>"
msgstr ""
"<prompt>&percnt;</prompt><userinput> <command>kde4-config --types</command> "
"</userinput>"

#. Tag: para
#: man-kde4-config.1.docbook:148
#, no-c-format
msgid "Print the installed wallpaper path:"
msgstr "Imprime a ruta do fondo de escritorio instalado:"

#. Tag: para
#: man-kde4-config.1.docbook:150
#, no-c-format
msgid ""
"<prompt>&percnt;</prompt><userinput> <command>kde4-config --path wallpaper</"
"command> </userinput>"
msgstr ""
"<prompt>&percnt;</prompt><userinput> <command>kde4-config --path wallpaper</"
"command> </userinput>"

