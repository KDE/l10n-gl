#. Tag: para
#: lan.docbook:10
#, no-c-format
msgid ""
"This protocol is intended to provide a kind of <quote>network neighborhood</"
"quote> but only relying on the TCP/IP protocol stack and with the ability to "
"use other protocols than just <acronym>SMB</acronym>."
msgstr ""

#. Tag: para
#: lan.docbook:15
#, no-c-format
msgid ""
"The lan kioslave can use &FTP;, &HTTP;, <acronym>SMB</acronym>, "
"<acronym>NFS</acronym>, and <acronym>FISH</acronym>"
msgstr ""

#. Tag: para
#: lan.docbook:18
#, no-c-format
