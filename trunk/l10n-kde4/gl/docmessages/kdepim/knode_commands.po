#. Tag: title
#: commands.docbook:5
#, no-c-format
msgid "Command reference"
msgstr "Referencia dos comandos"

#. Tag: para
#: commands.docbook:7
#, no-c-format
msgid ""
"The following keybindings assume you did not change the default settings."
msgstr ""
"Para os atallos seguintes asúmese que vostede non alterou a configuración "
"inicial."

#. Tag: title
#: commands.docbook:11
#, no-c-format
msgid "The main &knode; window"
msgstr "A xanela principal do &knode;"

#. Tag: title
#: commands.docbook:14 commands.docbook:1310
#, no-c-format
msgid "The <guimenu>File</guimenu> menu"
msgstr "O menú <guimenu>Ficheiro</guimenu>"

#. Tag: menuchoice
#: commands.docbook:19
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo></"
"shortcut> <guimenu>Ficheiro</guimenu><guimenuitem>Gravar Como...</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:29
#, no-c-format
msgid "Saves the selected article in a file."
msgstr "Garda nun ficheiro o artigo seleccionado."

#. Tag: menuchoice
#: commands.docbook:36
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap> </keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap> </keycombo> </"
"shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Imprimir...</guimenuitem>"

#. Tag: action
#: commands.docbook:47
#, no-c-format
msgid "Prints the selected article."
msgstr "Imprime o artigo seleccionado."

#. Tag: menuchoice
#: commands.docbook:54
#, no-c-format
msgid ""
"<guimenu> File</guimenu> <guimenuitem>Send Pending Messages</guimenuitem>"
msgstr ""
"<guimenu> Ficheiro </guimenu> <guimenuitem>Enviar Mensaxes Pendentes</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:62
#, no-c-format
msgid "The messages in the <guilabel>Outbox</guilabel> folder are sent."
msgstr "Envíanse as mensaxes do cartafol de <guilabel>Saída</guilabel>."

#. Tag: menuchoice
#: commands.docbook:69
#, no-c-format
msgid "<guimenu> File</guimenu> <guimenuitem>Stop Network</guimenuitem>"
msgstr "<guimenu> Ficheiro</guimenu> <guimenuitem>Deter Rede</guimenuitem>"

#. Tag: action
#: commands.docbook:77
#, no-c-format
msgid "Disconnects the current connection to a newsserver."
msgstr "Desconecta a conexión actual a un servidor de novas."

#. Tag: menuchoice
#: commands.docbook:84
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Sair</guimenuitem>"

#. Tag: action
#: commands.docbook:94
#, no-c-format
msgid "Quits &knode;."
msgstr "Sae do &knode;"

#. Tag: title
#: commands.docbook:104 commands.docbook:1391
#, no-c-format
msgid "The <guimenu>Edit</guimenu> menu"
msgstr "O menú <guimenu>Editar</guimenu>"

#. Tag: menuchoice
#: commands.docbook:110
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap> </keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap> </keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Copiar</guimenuitem>"

#. Tag: action
#: commands.docbook:121
#, no-c-format
msgid "Copy the selected text to the clipboard."
msgstr "Copia o texto seleccionado para o porta-retallos."

#. Tag: menuchoice
#: commands.docbook:128
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Seleccionar Todo</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:136
#, no-c-format
msgid "Selects the whole article."
msgstr "Selecciona o artigo completo."

#. Tag: menuchoice
#: commands.docbook:143
#, no-c-format
msgid ""
"<shortcut> <keycap>F4</keycap></shortcut><guimenu>Edit</guimenu> "
"<guimenuitem>Search Articles...</guimenuitem>"
msgstr ""
"<shortcut> <keycap>F4</keycap></shortcut><guimenu>Edit</guimenu> "
"<guimenuitem>Search Articles...</guimenuitem>"

#. Tag: action
#: commands.docbook:151
#, no-c-format
msgid ""
"Opens the <guilabel>Search for Articles</guilabel> dialog box for searching "
"in the active group."
msgstr ""
"Abre o diálogo <guilabel>Procurar por Artigos</guilabel> para procurar no "
"grupo activo."

#. Tag: menuchoice
#: commands.docbook:158
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F</keycap> </keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find in Article...</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F</keycap> </keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Procurar en Artigo...</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:168
#, no-c-format
msgid "To be written"
msgstr "Falta por escribir"

#. Tag: menuchoice
#: commands.docbook:175
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Fetch Article with ID...</guimenuitem>"
msgstr ""
"<guimenu>Editar</guimenu> <guimenuitem>Obter Artigo con ID...</guimenuitem>"

#. Tag: action
#: commands.docbook:182
#, no-c-format
msgid "Enables the download of an article with a specified article-ID."
msgstr "Permite a transferencia dun artigo cun ID de artigo determinado."

#. Tag: title
#: commands.docbook:192
#, no-c-format
msgid "The <guimenu>View</guimenu> menu"
msgstr "O menú <guimenu>Vista</guimenu>"

#. Tag: menuchoice
#: commands.docbook:200
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Show/Hide Threads</guimenuitem>"
msgstr ""
"<guimenu>Vista</guimenu> <guimenuitem>Amosar/Agochar Fíos</guimenuitem>"

#. Tag: para
#: commands.docbook:206
#, no-c-format
msgid ""
"When this is activated, &knode; shows discussions as a tree view in the "
"article view."
msgstr ""
"Cando está activado, o &knode; mostra as discusións como unha vista de "
"árbore na vista do artigo."

#. Tag: menuchoice
#: commands.docbook:212
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Expand All Threads</guimenuitem>"
msgstr ""
"<guimenu>Vista</guimenu> <guimenuitem>Expandir Todos os Fíos</guimenuitem>"

#. Tag: para
#: commands.docbook:218
#, no-c-format
msgid ""
"When this is activated, &knode; shows the complete threads; this is only "
"functional when <guilabel>Show threads</guilabel> is active."
msgstr ""
"Cando está activado, o &knode; mostra os fíos completos; isto só funciona "
"cando está activo <guilabel> Amosar fíos</guilabel>."

#. Tag: menuchoice
#: commands.docbook:226
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Collapse All Threads</guimenuitem>"
msgstr ""
"<guimenu>Vista</guimenu> <guimenuitem> Contraer Todos os Fíos</guimenuitem>"

#. Tag: para
#: commands.docbook:232
#, no-c-format
msgid ""
"When this is activated, &knode; shows no threads; this is only functional "
"when <guilabel>Show threads</guilabel> is active."
msgstr ""
"Cando isto está activado, o &knode; non mostra ningún fío; isto só funciona "
"cando está activo <guilabel>Amosar fíos</guilabel>."

#. Tag: menuchoice
#: commands.docbook:239
#, no-c-format
msgid ""
"<shortcut><keycap>T</keycap></shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Toggle Subthread</guimenuitem>"
msgstr ""
"<shortcut><keycap>T</keycap></shortcut> <guimenu>Vista</guimenu> "
"<guimenuitem>Alternar Sub-fío</guimenuitem>"

#. Tag: action
#: commands.docbook:247
#, no-c-format
msgid "Toggles between showing and collapsing the selected thread."
msgstr "Alterna entre mostrar e recoller o fío seleccionado."

#. Tag: menuchoice
#: commands.docbook:254
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Filter</guimenuitem>"
msgstr "<guimenu>Vista</guimenu> <guimenuitem>Filtro</guimenuitem>"

#. Tag: action
#: commands.docbook:261
#, no-c-format
msgid "Allows you to choose a filter for the article view."
msgstr "Permite escoller un filtro para a vista do artigo."

#. Tag: menuchoice
#: commands.docbook:268
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Sort</guimenuitem>"
msgstr "<guimenu>Vista</guimenu> <guimenuitem>Ordenar</guimenuitem>"

#. Tag: action
#: commands.docbook:275
#, no-c-format
msgid "Allows you to sort the article view."
msgstr "Permite ordenar a vista de artigos."

#. Tag: menuchoice
#: commands.docbook:282
#, no-c-format
msgid ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Refresh List</guimenuitem>"
msgstr ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>Vista</guimenu> "
"<guimenuitem>Refrescar Lista</guimenuitem>"

#. Tag: action
#: commands.docbook:290
#, no-c-format
msgid "Refreshes the article view"
msgstr "Anova a vista de artigos"

#. Tag: menuchoice
#: commands.docbook:311
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Unscramble (ROT 13)</guimenuitem>"
msgstr "<guimenu>Vista</guimenu> <guimenuitem>Descifrar (ROT 13)</guimenuitem>"

#. Tag: action
#: commands.docbook:318
#, no-c-format
msgid ""
"When this setting is activated, &knode; shows all characters of the complete "
"article rotated by 13 characters."
msgstr ""
"Cando esta opción está activada, o &knode; mostra todos os caracteres do "
"artigo completo rotados 13 caracteres."

#. Tag: menuchoice
#: commands.docbook:325
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Verify PGP signature</guimenuitem>"
msgstr ""
"<guimenu>Vista</guimenu> <guimenuitem>Verificar a sinatura PGP</guimenuitem>"

#. Tag: action
#: commands.docbook:332
#, no-c-format
msgid "Checks the PGP signature in the article."
msgstr "Verifica a sinatura PGP do artigo."

#. Tag: menuchoice
#: commands.docbook:338
#, no-c-format
msgid ""
"<shortcut><keycap>V</keycap></shortcut> <guimenu>View</guimenu> "
"<guimenuitem>View Source</guimenuitem>"
msgstr ""
"<shortcut><keycap>V</keycap></shortcut> <guimenu>Vista</guimenu> "
"<guimenuitem>Ver Código</guimenuitem>"

#. Tag: action
#: commands.docbook:346
#, no-c-format
msgid "The source code of the active article is opened in a new window."
msgstr "Ábrese unha xanela nova co código fonte do artigo activo."

#. Tag: menuchoice
#: commands.docbook:353
#, no-c-format
msgid ""
"<shortcut><keycap>X</keycap></shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Use Fixed Font</guimenuitem>"
msgstr ""
"<shortcut><keycap>X</keycap></shortcut> <guimenu>Vista</guimenu> "
"<guimenuitem>Usar Fonte Fixa</guimenuitem>"

#. Tag: action
#: commands.docbook:361
#, no-c-format
msgid "Activates the configured fixed-width font for the viewer."
msgstr "Activa o tipo de letra de largo fixo no visualizador."

#. Tag: menuchoice
#: commands.docbook:371
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Charset</guimenuitem>"
msgstr "<guimenu>Vista</guimenu> <guimenuitem>Codificación</guimenuitem>"

#. Tag: action
#: commands.docbook:378
#, no-c-format
msgid "Here you can configure the charset which is used for the articles."
msgstr ""
"Aquí pódese configurar o conxunto de caracteres que se ha empregar para os "
"artigos."

#. Tag: title
#: commands.docbook:388
#, no-c-format
msgid "The <guimenu>Go</guimenu> menu"
msgstr "O menú <guimenu>Ir</guimenu>"

#. Tag: menuchoice
#: commands.docbook:394
#, no-c-format
msgid ""
"<shortcut><keycap>P</keycap></shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Previous Article</guimenuitem>"
msgstr ""
"<shortcut><keycap>P</keycap></shortcut> <guimenu>Ir</guimenu> "
"<guimenuitem>Artigo Previo</guimenuitem>"

#. Tag: action
#: commands.docbook:402
#, no-c-format
msgid "Jumps to previous article in the article view."
msgstr "Vai ao artigo anterior na vista de artigos."

#. Tag: menuchoice
#: commands.docbook:409
#, no-c-format
msgid ""
"<shortcut><keycap>N</keycap></shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Next Article</guimenuitem>"
msgstr ""
"<shortcut><keycap>N</keycap></shortcut> <guimenu>Ir</guimenu> "
"<guimenuitem>Artigo Seguinte</guimenuitem>"

#. Tag: action
#: commands.docbook:417
#, no-c-format
msgid "Jumps to next article in the article view."
msgstr "Vai ao seguinte artigo da vista de artigos."

#. Tag: menuchoice
#: commands.docbook:424
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;&Shift;<keycap>Space</keycap></"
"keycombo> </shortcut> <guimenu>Go</guimenu> <guimenuitem>Next Unread "
"Article</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Alt;&Shift;<keycap>Espazo</keycap></"
"keycombo> </shortcut> <guimenu>Ir</guimenu> <guimenuitem>Artigo Seguinte Sen "
"Ler</guimenuitem>"

#. Tag: action
#: commands.docbook:433
#, no-c-format
msgid ""
"Jumps to the next unread article, and to the first unread article of the "
"next newsgroup if necessary."
msgstr ""
"Vai ao artigo seguinte non lido ou ao primeiro artigo sen ler do seguinte "
"grupo de novas, de ser preciso."

#. Tag: menuchoice
#: commands.docbook:440
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>Space</keycap></"
"keycombo></shortcut> <guimenu>Go</guimenu> <guimenuitem>Next Unread Thread</"
"guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>Espazo</keycap></"
"keycombo></shortcut> <guimenu>Go</guimenu> <guimenuitem>Fío Seguinte Sen "
"Ler</guimenuitem>"

#. Tag: action
#: commands.docbook:448
#, no-c-format
msgid ""
"Jumps to the next unread thread, and to the next unread thread in the next "
"newsgroup if necessary."
msgstr ""
"Vai ao fío seguinte non lido, ou ao seguinte fío sen ler do grupo de novas "
"seguinte, de ser preciso."

#. Tag: menuchoice
#: commands.docbook:456
#, no-c-format
msgid ""
"<shortcut><keycap>-</keycap></shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Previous Group</guimenuitem>"
msgstr ""
"<shortcut><keycap>-</keycap></shortcut> <guimenu>Ir</guimenu> "
"<guimenuitem>Grupo Anterior</guimenuitem>"

#. Tag: action
#: commands.docbook:464
#, no-c-format
msgid "Jumps to the previous news group in the folder view"
msgstr "Vai ao grupo de novas anterior da vista de cartafoles."

#. Tag: menuchoice
#: commands.docbook:472
#, no-c-format
msgid ""
"<shortcut><keycap>+</keycap></shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Next Group</guimenuitem>"
msgstr ""
"<shortcut><keycap>+</keycap></shortcut> <guimenu>Ir</guimenu> "
"<guimenuitem>Grupo Seguinte</guimenuitem>"

#. Tag: action
#: commands.docbook:480
#, no-c-format
msgid "Jumps to the next newsgroup in the folder view"
msgstr "Vai ao grupo de novas seguinte da vista de cartafoles."

#. Tag: title
#: commands.docbook:490
#, no-c-format
msgid "The <guimenu>Account</guimenu> menu"
msgstr "O menú <guimenu>Conta</guimenu>"

#. Tag: menuchoice
#: commands.docbook:495
#, no-c-format
msgid ""
"<guimenu>Account</guimenu> <guimenuitem>Get New Articles in All Groups</"
"guimenuitem>"
msgstr ""
"<guimenu>Conta</guimenu> <guimenuitem>Obter Artigos Novos de Todos os "
"Grupos</guimenuitem>"

#. Tag: action
#: commands.docbook:502 commands.docbook:597
#, no-c-format
msgid "Connects with the active account and fetches any new messages."
msgstr "Liga coa conta activa e obtén todas as mensaxes novas."

#. Tag: menuchoice
#: commands.docbook:509
#, no-c-format
msgid ""
"<guimenu>Account</guimenu> <guimenuitem>Get New Articles in All Accounts</"
"guimenuitem>"
msgstr ""
"<guimenu>Conta</guimenu> <guimenuitem>Ober Artigos Novos en Todas as Contas</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:516
#, no-c-format
msgid "Connects with all account and fetches any new messages."
msgstr "Liga con todas as contas e obtén todas as mensaxes novas."

#. Tag: menuchoice
#: commands.docbook:523
#, no-c-format
msgid ""
"<guimenu>Account</guimenu> <guimenuitem>Subscribe to Newsgroups...</"
"guimenuitem>"
msgstr ""
"<guimenu>Conta</guimenu> <guimenuitem>Subscribirse a Grupos de novas...</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:530
#, no-c-format
msgid ""
"Opens the Dialog Box for subscribing to newsgroups for the active account."
msgstr ""
"Abre a caixa de diálogo para poderse subscribir a grupos de novas coa conta "
"activa."

#. Tag: menuchoice
#: commands.docbook:538
#, no-c-format
msgid "<guimenu>Account</guimenu> <guimenuitem>Expire All Groups</guimenuitem>"
msgstr ""
"<guimenu>Conta</guimenu> <guimenuitem>Expirar Todos os Grupos</guimenuitem>"

#. Tag: action
#: commands.docbook:545
#, no-c-format
msgid "Here you can expire all groups of an account manually."
msgstr ""
"Aquí pódese facer que todos os grupos dunha conta caduquen manualmente."

#. Tag: menuchoice
#: commands.docbook:553
#, no-c-format
msgid ""
"<guimenu>Account</guimenu> <guimenuitem>Account Properties</guimenuitem>"
msgstr ""
"<guimenu>Conta</guimenu> <guimenuitem>Propiedades da Conta</guimenuitem>"

#. Tag: action
#: commands.docbook:560
#, no-c-format
msgid "Opens the properties dialog for the active account."
msgstr "Abre o diálogo de propiedades da conta activa."

#. Tag: menuchoice
#: commands.docbook:567
#, no-c-format
msgid "<guimenu>Account</guimenu> <guimenuitem>Delete Account</guimenuitem>"
msgstr "<guimenu>Conta</guimenu> <guimenuitem>Eliminar Conta</guimenuitem>"

#. Tag: action
#: commands.docbook:574
#, no-c-format
msgid "Deletes the active account and all subscribed newsgroups therein."
msgstr ""
"Elimina a conta activa e todos os grupos de novas aos que estaba subscrita."

#. Tag: title
#: commands.docbook:584
#, no-c-format
msgid "The <guimenu>Group</guimenu> menu"
msgstr "O menú <guimenu>Grupo</guimenu>"

#. Tag: menuchoice
#: commands.docbook:590
#, no-c-format
msgid "<guimenu>Group</guimenu> <guimenuitem>Get New Articles</guimenuitem>"
msgstr ""
"<guimenu>Grupo</guimenu> <guimenuitem>Obter Artigos Novos</guimenuitem>"

#. Tag: menuchoice
#: commands.docbook:604
#, no-c-format
msgid "<guimenu>Group</guimenu> <guimenuitem>Expire Group</guimenuitem>"
msgstr "<guimenu>Grupo</guimenu> <guimenuitem>Cacucar Grupo</guimenuitem>"

#. Tag: action
#: commands.docbook:611
#, no-c-format
msgid "Checks if there are any old articles and, if so, deletes them."
msgstr "Verifica se existen artigos vellos e, de ser así, elimínaos."

#. Tag: menuchoice
#: commands.docbook:618
#, no-c-format
msgid "<guimenu>Group</guimenu> <guimenuitem>Reorganize Group</guimenuitem>"
msgstr "<guimenu>Grupo</guimenu> <guimenuitem>Reorganizar Grupo</guimenuitem>"

#. Tag: action
#: commands.docbook:625
#, no-c-format
msgid "Rebuilds the article view by using the configured sortings."
msgstr "Reconstrúe a vista dos artigos empregando as ordenacións configuradas."

#. Tag: menuchoice
#: commands.docbook:632
#, no-c-format
msgid "<guimenu>Group</guimenu> <guimenuitem>Mark All as Read</guimenuitem>"
msgstr ""
"<guimenu>Grupo</guimenu> <guimenuitem>Marcar Todos como Lidos</guimenuitem>"

#. Tag: action
#: commands.docbook:639
#, no-c-format
msgid "Sets the status of all articles in the active newsgroup to read."
msgstr "Muda o estado de todos os artigos do grupo de novas activo como lido."

#. Tag: menuchoice
#: commands.docbook:646
#, no-c-format
msgid "<guimenu>Group</guimenu> <guimenuitem>Mark All as Unread</guimenuitem>"
msgstr ""
"<guimenu>Grupo</guimenu> <guimenuitem>Marcar Todos como Sen Ler</guimenuitem>"

#. Tag: action
#: commands.docbook:653
