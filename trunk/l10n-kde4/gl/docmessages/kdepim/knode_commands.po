#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Configurar Barras de "
"ferramentas...</guimenuitem>"

#. Tag: action
#: commands.docbook:1274 commands.docbook:1859
#, no-c-format
msgid "Opens a dialog for configuring the toolbars."
msgstr "Abre un diálogo para configurar as barras de ferramentas."

#. Tag: menuchoice
#: commands.docbook:1281
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &knode;...</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Configurar &knode;...</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1288
#, no-c-format
msgid "Opens a dialog for configuring &knode;."
msgstr "Abre un diálogo para configurar o &knode;."

#. Tag: title
#: commands.docbook:1298 commands.docbook:1883
#, no-c-format
msgid "The <guimenu>Help</guimenu> menu"
msgstr "O menú <guimenu>Axuda</guimenu>"

#. Tag: sect2
#: commands.docbook:1299 commands.docbook:1883
#, no-c-format
msgid "&help.menu.documentation;"
msgstr "&help.menu.documentation;"

#. Tag: title
#: commands.docbook:1307
#, no-c-format
msgid "The composer menus."
msgstr "Os menús do compositor."

#. Tag: menuchoice
#: commands.docbook:1316
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Return</keycap></"
"keycombo></shortcut> <guimenu>File</guimenu> <guimenuitem>Send Now</"
"guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Intro</keycap></"
"keycombo></shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Enviar Agora</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1324
#, no-c-format
msgid "Sends the current article immediately."
msgstr "Envía inmediatamente o artigo actual."

#. Tag: menuchoice
#: commands.docbook:1331
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Send Later</guimenuitem>"
msgstr ""
"<guimenu>Ficheiro</guimenu> <guimenuitem>Enviar Máis Tarde</guimenuitem>"

#. Tag: para
#: commands.docbook:1337
#, no-c-format
msgid ""
"Stores the current article in the <guilabel> Outbox</guilabel> to be sent "
"later."
msgstr ""
"Almacena o artigo actual na caixa de <guilabel> Saída</guilabel> para o "
"enviar máis tarde."

#. Tag: menuchoice
#: commands.docbook:1345
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save as Draft</guimenuitem>"
msgstr "<guimenu>Ficheiro</guimenu> <guimenu>Gravar como Borrador</guimenu>"

#. Tag: para
#: commands.docbook:1351
#, no-c-format
msgid ""
"Saves the current article in the <guilabel> Drafts</guilabel> folder, so you "
"can finish editing it another time."
msgstr ""
"Garda o artigo actual no cartafol de <guilabel>Borradores</guilabel> para "
"que vostede poida rematar de redixilo noutro momento."

#. Tag: menuchoice
#: commands.docbook:1359
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Delete</guimenuitem>"
msgstr "<guimenu>Ficheiro</guimenu> <guimenuitem>Eliminar</guimenuitem>"

#. Tag: action
#: commands.docbook:1366
#, no-c-format
msgid "Deletes the current article, closing the editor."
msgstr "Elimina o artigo actual e fecha o editor."

#. Tag: menuchoice
#: commands.docbook:1373
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo></"
"shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Fechar</guimenuitem>"

#. Tag: action
#: commands.docbook:1381
#, no-c-format
msgid "Closes the editor window"
msgstr "Fecha a xanela do editor"

#. Tag: menuchoice
#: commands.docbook:1397
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Desfacer</guimenuitem>"

#. Tag: action
#: commands.docbook:1405
#, no-c-format
msgid "Undo the last edit."
msgstr "Defai a última modificación."

#. Tag: menuchoice
#: commands.docbook:1412
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Editar</guimenu> <guimenuitem>Refacer</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:1419
#, no-c-format
msgid ""
"Redo the last action undone with the <guimenuitem> Undo</guimenuitem> menu "
"entry."
msgstr ""
"Volve a facer a última acción que se desfixo coa entrada de menú "
"<guimenuitem> Desfacer</guimenuitem>."

#. Tag: menuchoice
#: commands.docbook:1427
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Cortar</guimenuitem>"

#. Tag: action
#: commands.docbook:1435
#, no-c-format
msgid ""
"Cuts the currently-selected text to the clipboard, deleting it from the "
"editor window."
msgstr ""
"Recorta o texto seleccionado nese momento para o porta-retallos e elimínao "
"da xanela do editor."

#. Tag: menuchoice
#: commands.docbook:1442
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo></"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Copiar</guimenuitem>"

#. Tag: action
#: commands.docbook:1450
#, no-c-format
msgid "Copies the selected text to the clipboard."
msgstr "Copia o texto seleccionado para o porta-retallos."

#. Tag: menuchoice
#: commands.docbook:1457
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Pegar</guimenuitem>"

#. Tag: action
#: commands.docbook:1465
#, no-c-format
msgid "Pastes the current contents of the clipboard into the editor window."
msgstr "Apega o contido actual do porta-retallos na xanela do editor."

#. Tag: menuchoice
#: commands.docbook:1472
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Paste as Quotation</guimenuitem>"
msgstr "<guimenu>Editar</guimenu> <guimenuitem>Pegar como Cita</guimenuitem>"

#. Tag: para
#: commands.docbook:1478
#, no-c-format
msgid ""
"<action> Pastes the current contents of the clipboard into the editor window "
"with a quote character </action> (<quote>&gt;</quote>) at the beginning of "
"each line."
msgstr ""
"<action> Apega o contido actual do porta-retallos na xanela do editor cun "
"carácter de cita</action> (<quote>&gt;</quote>) no inicio de cada liña."

#. Tag: menuchoice
#: commands.docbook:1488
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr "<guimenu>Editar</guimenu> <guimenuitem>Seleccionar Todo</guimenuitem>"

#. Tag: action
#: commands.docbook:1495
#, no-c-format
msgid "Selects all the text in the editor window."
msgstr "Selecciona todo o texto da xanela do editor."

#. Tag: menuchoice
#: commands.docbook:1502
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Procurar</guimenuitem>"

#. Tag: action
#: commands.docbook:1510
#, no-c-format
msgid "Opens the Find dialog."
msgstr "Abre o diálogo de procuras."

#. Tag: menuchoice
#: commands.docbook:1517
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Substituir...</guimenuitem>"

#. Tag: action
#: commands.docbook:1525
#, no-c-format
msgid "Opens the Replace dialog."
msgstr "Abre o diálogo de substitucións."

#. Tag: title
#: commands.docbook:1535
#, no-c-format
msgid "The <guimenu>Attach</guimenu> menu"
msgstr "O menú <guimenu>Xuntar</guimenu>"

#. Tag: menuchoice
#: commands.docbook:1541
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Append Signature</guimenuitem>"
msgstr "<guimenu>Xuntar</guimenu> <guimenuitem>Engadir Sinatura</guimenuitem>"

#. Tag: action
#: commands.docbook:1548
#, no-c-format
msgid "Inserts your signature at the end of the article you are editing."
msgstr "Insire a súa sinatura ao final do artigo que está a redixir."

#. Tag: menuchoice
#: commands.docbook:1555
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Insert File...</guimenuitem>"
msgstr ""
"<guimenu>Xuntar</guimenu> <guimenuitem>Inserir Ficheiro...</guimenuitem>"

#. Tag: action
#: commands.docbook:1562
#, no-c-format
msgid "Inserts the contents of a file into the editor window."
msgstr "Insire o contido dun ficheiro na xanela do editor."

#. Tag: menuchoice
#: commands.docbook:1570
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Insert File (in a box)...</"
"guimenuitem>"
msgstr ""
"<guimenu>Xuntar</guimenu> <guimenuitem>Inserir Ficheiro (nunha caixa)...</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1577
#, no-c-format
msgid ""
"Inserts the contents of a file into the editor window and puts a box around "
"of it."
msgstr ""
"Insire o contido dun ficheiro na xanela do editor e arrodéao cun recadro."

#. Tag: menuchoice
#: commands.docbook:1586
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Attach File...</guimenuitem>"
msgstr ""
"<guimenu>Xuntar</guimenu> <guimenuitem>Anexar Ficheiro...</guimenuitem>"

#. Tag: action
#: commands.docbook:1593
#, no-c-format
msgid "Inserts a file as an attachment."
msgstr "Insire un ficheiro como anexo."

#. Tag: title
#: commands.docbook:1603
#, no-c-format
msgid "The <guimenu>Options</guimenu> menu"
msgstr "O menú <guimenu>Opcións</guimenu>"

#. Tag: menuchoice
#: commands.docbook:1609
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Send News-Article</guimenuitem>"
msgstr ""
"<guimenu>Opcións</guimenu> <guimenuitem>Enviar Artigo de Novas</guimenuitem>"

#. Tag: action
#: commands.docbook:1616
#, no-c-format
msgid "Toggles whether the message is to be sent as an article or not."
msgstr "Alterna entre se se envía a mensaxe como artigo ou non."

#. Tag: menuchoice
#: commands.docbook:1623
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Send Email</guimenuitem>"
msgstr "<guimenu>Opcións</guimenu> <guimenuitem>Enviar Email</guimenuitem>"

#. Tag: action
#: commands.docbook:1630
#, no-c-format
msgid ""
"Toggles whether the message is to be sent as an email or not; if it's "
"configured, an external editor will be activated."
msgstr ""
"Alterna entre que a mensaxe se envíe como mensaxe de correo ou non; de estar "
"configurado, actívase un editor externo."

#. Tag: menuchoice
#: commands.docbook:1637
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Set Charset</guimenuitem>"
msgstr ""
"<guimenu>Opcións</guimenu> <guimenuitem>Configurar Codificación</guimenuitem>"

#. Tag: action
#: commands.docbook:1644
#, no-c-format
msgid ""
"Here you can configure the charset used for this article; normally you use "
"us-ascii for English-speaking areas."
msgstr ""
"Aquí pódese configurar o conxunto de caracteres que se queira empregar neste "
"artigo; normalmente emprégase us-ascii nas áreas de fala inglesa."

#. Tag: menuchoice
#: commands.docbook:1651
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Word Wrap</guimenuitem>"
msgstr ""
"<guimenu>Opcións</guimenu> <guimenuitem>Axuste de Palabras</guimenuitem>"

#. Tag: action
#: commands.docbook:1658
#, no-c-format
msgid "Toggles the word wrapping in the editor on or off."
msgstr "Activa ou desactiva o axuste de palabras no editor."

#. Tag: title
#: commands.docbook:1668
#, no-c-format
msgid "The <guimenu>Tools</guimenu> menu"
msgstr "O menú <guimenu>Ferramentas</guimenu>"

#. Tag: menuchoice
#: commands.docbook:1674
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Add Quote Characters</guimenuitem>"
msgstr ""
"<guimenu>Ferramentas</guimenu> <guimenuitem>Engadir Caracteres de Cita</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:1680
#, no-c-format
msgid "Puts <quote>&gt;</quote> in front of the marked lines."
msgstr "Pun <quote>&gt;</quote> diante das liñas marcadas."

#. Tag: menuchoice
#: commands.docbook:1688
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Remove Quote Characters</guimenuitem>"
msgstr ""
"<guimenu>Ferramentas</guimenu> <guimenuitem>Eliminar Caracteres de Cita</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1695
#, no-c-format
msgid "Removes the quote characters at the beginning of the marked lines."
msgstr "Elimina os caracters de cita que aparecen diante das liñas marcadas."

#. Tag: menuchoice
#: commands.docbook:1702
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Add Box</guimenuitem>"
msgstr ""
"<guimenu>Ferramentas</guimenu> <guimenuitem>Engadir Caixa</guimenuitem>"

#. Tag: action
#: commands.docbook:1709
#, no-c-format
msgid "Puts the marked lines in an ASCII box."
msgstr "Pon as liñas marcadas nun cadro feito con ASCII."

#. Tag: menuchoice
#: commands.docbook:1716
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Remove Box</guimenuitem>"
msgstr ""
"<guimenu>Ferramentas</guimenu> <guimenuitem>Eliminar Caixa</guimenuitem>"

#. Tag: action
#: commands.docbook:1723
#, no-c-format
msgid "Removes the ASCII box around the marked area."
msgstr "Retira o cadro feito en ASCII arredor da área marcada."

#. Tag: menuchoice
#: commands.docbook:1730
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Sign Article with PGP</guimenuitem>"
msgstr ""
"<guimenu>Ferramentas</guimenu> <guimenuitem>Asinar Artigo co PGP</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1737
#, no-c-format
msgid "Signs the article with PGP."
msgstr "Asina o artigo co PGP."

#. Tag: menuchoice
#: commands.docbook:1744
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Get Original Text (not rewrapped)</"
"guimenuitem>"
msgstr ""
"<guimenu>Ferramentas</guimenu> <guimenuitem>Obter o Texto Orixinal (sen "
"axuste de palabras)</guimenuitem>"

#. Tag: action
#: commands.docbook:1751
#, no-c-format
msgid "Rebuilds the original posting when answering to an article."
msgstr "Reconstrúe a publicación orixinal ao respostar a un artigo."

#. Tag: menuchoice
#: commands.docbook:1758
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Scramble (Rot-13)</guimenuitem>"
msgstr ""
"<guimenu>Ferramentas</guimenu> <guimenuitem>Barallar (Rot-13)</guimenuitem>"

#. Tag: action
#: commands.docbook:1765
#, no-c-format
msgid ""
"Encrypts the marked text by rotating every character 13 characters of the "
"alphabet."
msgstr ""
"Cifra o texto marcado rotando todos os caracteres 13 caracteres do alfabeto."

#. Tag: menuchoice
#: commands.docbook:1772
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Start External Editor</guimenuitem>"
msgstr ""
"<guimenu>Ferramentas</guimenu> <guimenuitem>Iniciar Editor Externo</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1779
#, no-c-format
msgid ""
"Start the external editor (if one is configured) with the current contents "
"of the editor window."
msgstr ""
"Inicia o editor externo (de haber algún configurado) co contido actual da "
"xanela do editor."

#. Tag: menuchoice
#: commands.docbook:1786
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Spelling...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Ferramentas</guimenu> <guimenuitem>Ortografía...</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1794
#, no-c-format
msgid "Opens a dialog box to check your spelling."
msgstr "Abre unha caixa de diálogo para correxir a ortografía."

#. Tag: menuchoice
#: commands.docbook:1810
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Amosar Barra de ferramentas</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1817
#, no-c-format
msgid "Toggles whether the toolbar should be shown or not."
msgstr "Alterna entre que se mostre ou non a barra de ferramentas."

#. Tag: menuchoice
#: commands.docbook:1824
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Amosar Barra de estado</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1831
#, no-c-format
msgid "Toggles whether the statusbar should be shown or not."
msgstr "Alterna entre que se mostre ou non a barra de estado."

#. Tag: menuchoice
#: commands.docbook:1866
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure KNode...</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Configurar KNode...</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:1873
#, no-c-format
msgid "Open the &knode; Preferences dialog."
msgstr "Abre o diálogo de preferencias do &knode;."
