#. Tag: title
#: index.docbook:721
#, no-c-format
msgid "&DBus; Interface"
msgstr ""

#. Tag: refentrytitle
#: index.docbook:725
#, no-c-format
msgid "<refentrytitle>version</refentrytitle>"
msgstr ""

#. Tag: refname
#: index.docbook:728
#, no-c-format
msgid "<refname>version</refname>"
msgstr ""

#. Tag: refpurpose
#: index.docbook:729
#, no-c-format
msgid "Return &karm;'s version."
msgstr ""

#. Tag: synopsis
#: index.docbook:732
#, no-c-format
msgid "QString version()"
msgstr ""

#. Tag: title
#: index.docbook:735 index.docbook:754 index.docbook:784 index.docbook:820
#, no-c-format
msgid "Description"
msgstr ""

#. Tag: para
#: index.docbook:736
#, no-c-format
msgid ""
"<function>version()</function> is a &DBus; call that returns &karm;'s "
"version number; for example 1.5.0. The version number is returned as a "
"string in the typical &GNU; format of major.minor.bugfix."
msgstr ""

#. Tag: refentrytitle
#: index.docbook:744
#, no-c-format
msgid "<refentrytitle>quit</refentrytitle>"
msgstr ""

#. Tag: refname
#: index.docbook:747
#, no-c-format
msgid "<refname>quit</refname>"
msgstr ""

#. Tag: refpurpose
#: index.docbook:748
#, no-c-format
msgid "Return &karm;'s quit."
msgstr ""

#. Tag: synopsis
#: index.docbook:751
#, no-c-format
msgid "QString quit()"
msgstr ""

#. Tag: para
#: index.docbook:755
#, no-c-format
msgid ""
"<function>quit()</function> is a &DBus; call that provides a way that an "
"external program can gracefully shutdown &karm;."
msgstr ""

#. Tag: refentrytitle
#: index.docbook:763
#, no-c-format
msgid "<refentrytitle>hastodo</refentrytitle>"
msgstr ""

#. Tag: refname
#: index.docbook:766
#, no-c-format
msgid "<refname>hastodo</refname>"
msgstr ""

#. Tag: refpurpose
#: index.docbook:767
#, no-c-format
msgid "Check if top-level to-do exists."
msgstr ""

#. Tag: synopsis
#: index.docbook:770
#, no-c-format
msgid "QString hastodo(QString taskname)"
msgstr ""

#. Tag: title
#: index.docbook:772 index.docbook:807
#, no-c-format
msgid "Parameters"
msgstr ""

#. Tag: parameter
#: index.docbook:775
#, no-c-format
msgid "taskname"
msgstr ""

#. Tag: para
#: index.docbook:777
#, no-c-format
msgid "The name of the to-do to look for."
msgstr ""

#. Tag: para
#: index.docbook:785
#, no-c-format
msgid ""
"<function>hastodo(QString taskname)</function> is a &DBus; call that looks "
"for a of the given name. If found, it returns the iCalendar UID that "
"identifies that to-do. If not found, it returns an empty string."
msgstr ""

#. Tag: para
#: index.docbook:790
#, no-c-format
msgid ""
"The iCalendar file that &karm; currently has opened is the file that is "
"searched. All to-do trees are searched, not just top-level to-do's. If more "
"than one to-do has a matching name, the first one found is returned."
msgstr ""

#. Tag: refentrytitle
#: index.docbook:798
#, no-c-format
msgid "<refentrytitle>addtodo</refentrytitle>"
msgstr ""

#. Tag: refname
#: index.docbook:801
#, no-c-format
msgid "<refname>addtodo</refname>"
msgstr ""

#. Tag: refpurpose
#: index.docbook:802
#, no-c-format
msgid "Add new todo."
msgstr ""

#. Tag: synopsis
#: index.docbook:805
#, no-c-format
msgid "QString addtodo(QString todoname)"
msgstr ""

#. Tag: parameter
#: index.docbook:810
#, no-c-format
msgid "todoname"
msgstr ""

#. Tag: para
#: index.docbook:812
#, no-c-format
msgid "The name of new to-do."
msgstr ""

#. Tag: para
#: index.docbook:821
#, no-c-format
msgid ""
"<function>addtodo(QString todoname)</function> is a &DBus; call that adds a "
"new top-level to-do to the current storage. The UID of the new to-do is "
"returned."
msgstr ""
