msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Procurar...</guimenuitem>"

#. Tag: para
#: index.docbook:312
#, no-c-format
msgid ""
"<action>Searches</action> for text in the main text box. Note that this only "
"searches the current page."
msgstr ""
"<action>Procura</action> por un texto do campo de texto principal. Teña en "
"conta que isto só procura na páxina actual."

#. Tag: menuchoice
#: index.docbook:318
#, no-c-format
msgid ""
"<shortcut> <keycombo><keycap>F3</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Find Next</guimenuitem>"
msgstr ""
"<shortcut> <keycombo><keycap>F3</keycap></keycombo> </shortcut> "
"<guimenu>Editar</guimenu> <guimenuitem>Procurar Seguinte</guimenuitem>"

#. Tag: para
#: index.docbook:325
#, no-c-format
msgid ""
"<action>Searches</action> for the next occurrence of the search text "
"(specified with Find)."
msgstr ""
"<action>Procura</action> pola próxima aparición do texto que se busca "
"(especificado con Procurar)."

#. Tag: menuchoice
#: index.docbook:330
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Substituir...</guimenuitem>"

#. Tag: para
#: index.docbook:337
#, no-c-format
msgid ""
"<action>Replaces</action> one bit of text with another, only on the current "
"page."
msgstr ""
"<action>Substitúe</action> un bloque de texto por outro, só na páxina actual."

#. Tag: menuchoice
#: index.docbook:343
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>M</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Rename...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>M</keycap></keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Mudar o Nome...</"
"guimenuitem>"

#. Tag: para
#: index.docbook:350
#, no-c-format
msgid "Gives the possibility to <action>rename</action> the current page."
msgstr "Dá a posibilidade de <action>mudar o nome</action> da páxina actual."

#. Tag: menuchoice
#: index.docbook:355
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Insert Date</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Inserir a Data</guimenuitem>"

#. Tag: para
#: index.docbook:362
#, no-c-format
msgid "<action>Inserts</action> the date and time in the current page."
msgstr "<action>Insire</action> a data e hora na páxina actual."

#. Tag: title
#: index.docbook:369
#, no-c-format
msgid "The <guimenu>Bookmarks</guimenu> Menu"
msgstr "O menú <guimenu>Marcadores</guimenu>"

#. Tag: menuchoice
#: index.docbook:373
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo> </"
"shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>Add bookmark</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo> </"
"shortcut> <guimenu>Marcadores</guimenu> <guimenuitem>Engadir Marcador</"
"guimenuitem>"

#. Tag: para
#: index.docbook:380
#, no-c-format
msgid ""
"<action>Adds</action> the current page to the list of bookmarks. See <link "
"linkend=\"kjots-books\">Using Books</link>."
msgstr ""
"<action>Engade</action> a páxina actual á lista de marcadores. Vexa <link "
"linkend=\"kjots-books\">Uso dos libros</link>."

#. Tag: menuchoice
#: index.docbook:386
#, no-c-format
msgid "<guimenu>Bookmarks</guimenu> <guimenuitem>Edit bookmarks</guimenuitem>"
msgstr ""
"<guimenu>Marcadores</guimenu> <guimenuitem>Editar Marcadores</guimenuitem>"

#. Tag: para
#: index.docbook:390
#, no-c-format
msgid ""
"<action>Edits</action> the bookmarks. Here you can search bookmarks, make "
"comments, organize them in different folders and much more."
msgstr ""
"<action>Modifica</action> os marcadores. Aquí pódense procurar marcadores, "
"facer comentarios, organizalos en cartafoles diferentes e moito máis."

#. Tag: menuchoice
#: index.docbook:397
#, no-c-format
msgid ""
"<guimenu>Bookmarks</guimenu> <guimenuitem>New Bookmark Folder</guimenuitem>"
msgstr ""
"<guimenu>Marcadores</guimenu> <guimenuitem>Novo Cartafol de Marcadores</"
"guimenuitem>"

#. Tag: para
#: index.docbook:401
#, no-c-format
msgid "<action>Makes</action> a new folder where you can store your bookmarks."
msgstr ""
"<action>Crea</action> un cartafol novo, no que se poden almacenar os "
"marcadores."

#. Tag: title
#: index.docbook:409
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "O menú <guimenu>Configuración</guimenu>"

#. Tag: menuchoice
#: index.docbook:413
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Hide/Show Toolbar</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Agochar/Amosar a Barra de "
"ferramentas</guimenuitem>"

#. Tag: para
#: index.docbook:417
#, no-c-format
msgid "<action>Toggles</action> display of the toolbar below the menu bar."
msgstr ""
"<action>Activa ou desactiva</action> a visibilidade da barra de ferramentas "
"por baixo do menú."

#. Tag: menuchoice
#: index.docbook:422
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Configurar Atallos...</"
"guimenuitem>"

#. Tag: para
#: index.docbook:426
#, no-c-format
msgid "<action>Choose</action> shortcut keys for various menu items."
msgstr ""
"<action>Escolla</action> atallos de teclado para diversos elementos do menú."

#. Tag: menuchoice
#: index.docbook:431
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Configurar as Barras de "
"ferramentas...</guimenuitem>"

#. Tag: para
#: index.docbook:435
#, no-c-format
msgid "<action>Choose</action> which items are present in the toolbar."
msgstr ""
"<action>Escolla</action> que elementes quere que estean presentes na barra "
"de ferramentas."

#. Tag: menuchoice
#: index.docbook:440
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure KJots...</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Configurar KJots...</"
"guimenuitem>"

#. Tag: para
#: index.docbook:444
#, no-c-format
msgid ""
"<action>Configure</action> options for &kjots;, including the font to use "
"and the settings for autosaving."
msgstr ""
"<action>Configura</action> as opcións do &kjots;, incluido o tipo de letra a "
"usar e as opcións de gravación automática."

