#: index.docbook:485
#, no-c-format
msgid "<guibutton>OK</guibutton>"
msgstr "<guibutton>Aceptar</guibutton>"

#. Tag: para
#: index.docbook:486
#, no-c-format
msgid "Saves your changes and closes the dialog."
msgstr "Grava as alteracións e fecha o diálogo."

#. Tag: guibutton
#: index.docbook:492
#, no-c-format
msgid "Apply"
msgstr "Aplicar"

#. Tag: para
#: index.docbook:493
#, no-c-format
msgid "Saves your changes but does not close the dialog."
msgstr "Grava as alteracións mais non fecha o diálogo."

#. Tag: guibutton
