msgstr "Mostrar a versión e saír."

#. Tag: title
#: man-kpat.6.docbook:110
#, no-c-format
msgid "Qt Options"
msgstr "Opcións do Qt"

#. Tag: option
#: man-kpat.6.docbook:114
#, no-c-format
msgid "--display <replaceable>displayname</replaceable>"
msgstr "--display <replaceable>displayname</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:116
#, no-c-format
msgid "Use the X-server display <emphasis>displayname</emphasis>."
msgstr "Utilizar a pantalla do servidor de X <emphasis>displayname</emphasis>."

#. Tag: option
#: man-kpat.6.docbook:121
#, no-c-format
msgid "--session <replaceable>sessionId</replaceable>"
msgstr "--session <replaceable>sessionId</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:123
#, no-c-format
msgid ""
"Restore the application for the given <replaceable>sessionId</replaceable>."
msgstr ""
"Restaurar o aplicativo que teña o <replaceable>identificador de sesión</"
"replaceable> indicado."

#. Tag: option
#: man-kpat.6.docbook:130
#, no-c-format
msgid "--cmap"
msgstr "--cmap"

#. Tag: para
#: man-kpat.6.docbook:132
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display."
msgstr ""
"Fai que o programa instale un mapa de cores privado nunha pantalla de 8 bits."

#. Tag: option
#: man-kpat.6.docbook:140
#, no-c-format
msgid "--ncols <replaceable>count</replaceable>"
msgstr "--ncols <replaceable>count</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:142
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on a 8-bit display, "
"if the application is using the <methodname>QApplication::ManyColor</"
"methodname> color specification."
msgstr ""
"Limita o número de cores asignadas no cubo de cores dunha pantalla de 8 "
"bits, se o aplicativoestiver a utilizar a especificación de cores "
"<methodname>QApplication::ManyColor</methodname>."

#. Tag: option
#: man-kpat.6.docbook:151
#, no-c-format
msgid "--nograb"
msgstr "--nograb"

#. Tag: para
#: man-kpat.6.docbook:153
#, no-c-format
msgid "tells Qt to never grab the mouse or the keyboard."
msgstr "Obriga o Qt a nunca agarrar o rato ou o teclado."

#. Tag: option
#: man-kpat.6.docbook:157
#, no-c-format
msgid "--dograb"
msgstr "--dograb"

#. Tag: para
#: man-kpat.6.docbook:159
#, no-c-format
msgid ""
"running under a debugger can cause an implicit <option>-nograb</option>, use "
"<option>-dograb</option> to override."
msgstr ""
"executar baixo un depurador pode causar un <option>-nograb</option> "
"implícito; empregue <option>-dograb</option> para o cancelar."

#. Tag: option
#: man-kpat.6.docbook:167
#, no-c-format
msgid "--sync"
msgstr "--sync"

#. Tag: para
#: man-kpat.6.docbook:169
#, no-c-format
msgid "switches to synchronous mode for debugging."
msgstr "pasa para o modo síncrono na depuración."

#. Tag: term
#: man-kpat.6.docbook:173
#, no-c-format
msgid ""
"<option>--fn</option>, <option>--font <replaceable>fontname</replaceable></"
"option>"
msgstr ""
"<option>--fn</option>, <option>--font</option> <parameter>tipo_letra</"
"parameter>"

#. Tag: para
#: man-kpat.6.docbook:175
#, no-c-format
msgid "defines the application font."
msgstr "indica o tipo de letra do aplicativo."

#. Tag: term
#: man-kpat.6.docbook:179
#, no-c-format
msgid ""
"<option>--bg</option>, <option>--background <replaceable>color</"
"replaceable></option>"
msgstr ""
"<option>--bg</option>,<option>--background</option> <parameter>cor</"
"parameter>"

#. Tag: para
#: man-kpat.6.docbook:181
#, no-c-format
msgid ""
"sets the default background color and an application palette (light and dark "
"shades are calculated)."
msgstr ""
"cambia a cor de fondo por omisión e a paleta do aplicativo (calcúlanse as "
"sombras escuras e luminosas)."

#. Tag: term
#: man-kpat.6.docbook:189
#, no-c-format
msgid ""
"<option>--fg</option>,<option>--foreground <replaceable>color</replaceable></"
"option>"
msgstr ""
"<option>--fg</option>,<option>--foreground</option> <parameter>cor</"
"parameter>"

#. Tag: para
#: man-kpat.6.docbook:191
#, no-c-format
msgid "sets the default foreground color."
msgstr "cambia a cor de primeiro plano por omisión."

#. Tag: term
#: man-kpat.6.docbook:195
#, no-c-format
msgid ""
"<option>--btn</option>, <option>--button <replaceable>color</replaceable></"
"option>"
msgstr ""
"<option>--btn</option>,<option>--button</option> <parameter>cor</parameter>"

#. Tag: para
#: man-kpat.6.docbook:197
#, no-c-format
msgid "sets the default button color."
msgstr "cambia a cor dos botóns por omisión."

#. Tag: option
#: man-kpat.6.docbook:201
#, no-c-format
msgid "--name <replaceable>name</replaceable>"
msgstr "--name <replaceable>nome</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:203
#, no-c-format
msgid "sets the application name."
msgstr "indica o nome do aplicativo."

#. Tag: option
#: man-kpat.6.docbook:207
#, no-c-format
msgid "--title <replaceable>title</replaceable>"
msgstr "<option>--title</option> <parameter>título</parameter>"

#. Tag: para
#: man-kpat.6.docbook:209
#, no-c-format
msgid "sets the application title (caption)."
msgstr "indica o título do aplicativo."

#. Tag: option
#: man-kpat.6.docbook:213
#, no-c-format
msgid "--visual <replaceable>TrueColor</replaceable>"
msgstr "--visual <replaceable>TrueColor</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:215
#, no-c-format
msgid "forces the application to use a TrueColor visual on an 8-bit display."
msgstr "Obriga ao programa a empregar TrueColor nunha pantalla de 8 bits."

#. Tag: option
#: man-kpat.6.docbook:222
#, no-c-format
msgid "--inputstyle"
msgstr "--inputstyle"

#. Tag: para
#: man-kpat.6.docbook:224
#, no-c-format
msgid ""
"sets XIM (X Input Method) input style. Possible values are onthespot, "
"overthespot, offthespot and root."
msgstr ""
"axusta o estilo de entrada de XIM (X Input Method). Os valores posíbeis son "
"«onthespot», «overthespot», «offthespot», e «root»."

#. Tag: option
#: man-kpat.6.docbook:232
#, no-c-format
msgid "--im <replaceable>XIM server</replaceable>"
msgstr "--im <replaceable>XIM server</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:234
#, no-c-format
msgid "set XIM server."
msgstr "estabelece o servidor XIM."

#. Tag: option
#: man-kpat.6.docbook:238
#, no-c-format
msgid "--noxim"
msgstr "--noxim"

#. Tag: para
#: man-kpat.6.docbook:240
#, no-c-format
msgid "disable XIM."
msgstr "desactiva o XIM."

#. Tag: option
#: man-kpat.6.docbook:244
#, no-c-format
msgid "--reverse"
msgstr "--reverse"

#. Tag: para
#: man-kpat.6.docbook:246
#, no-c-format
msgid "mirrors the whole layout of widgets."
msgstr "reflicte toda a disposición dos widgets."

#. Tag: option
#: man-kpat.6.docbook:250
#, no-c-format
msgid "--stylesheet <replaceable>file.qss</replaceable>"
msgstr "--stylesheet <replaceable>ficheiro.qss</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:252
#, no-c-format
msgid "applies the Qt stylesheet to the application widgets."
msgstr "aplica a folla de estilo de Qt aos widgets do aplicativo."

#. Tag: option
#: man-kpat.6.docbook:256
#, no-c-format
msgid "--graphicssystem <replaceable>system</replaceable>"
msgstr "--graphicssystem <replaceable>sistema</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:258
#, no-c-format
msgid ""
"use a different graphics system instead of the default one, options are "
"<quote>raster</quote> and <quote>opengl</quote> (experimental)."
msgstr ""
"emprega un sistema de gráficos distinto do predeterminado. As opcións son "
"<quote>raster</quote> e <quote>opengl</quote> (experimental)."

#. Tag: title
#: man-kpat.6.docbook:266
#, no-c-format
msgid "KDE Options"
msgstr "Opcións do KDE"

#. Tag: option
#: man-kpat.6.docbook:269
#, no-c-format
msgid "--caption <replaceable>caption</replaceable>"
msgstr "--caption <replaceable>caption</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:271
#, no-c-format
msgid "Use <emphasis>caption</emphasis> as name in the titlebar."
msgstr "Utilizar <emphasis>caption</emphasis> como título do aplicativo."

#. Tag: option
#: man-kpat.6.docbook:276
#, no-c-format
msgid "--icon <replaceable>icon</replaceable>"
msgstr "<option>--icon</option> <parameter>icona</parameter>"

#. Tag: para
#: man-kpat.6.docbook:278
#, no-c-format
msgid "Use <emphasis>icon</emphasis> as the application icon."
msgstr "Utilizar <emphasis>icona</emphasis> como icona do aplicativo."

#. Tag: option
#: man-kpat.6.docbook:283
#, no-c-format
msgid "--config <replaceable>filename</replaceable>"
msgstr "--config <replaceable>ficheiro</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:285
#, no-c-format
msgid "Use alternative configuration file."
msgstr "Usar un ficheiro de configuración alternativo."

#. Tag: option
#: man-kpat.6.docbook:292
#, no-c-format
msgid "--nocrashhandler"
msgstr "--nocrashhandler"

#. Tag: para
#: man-kpat.6.docbook:294
#, no-c-format
msgid "Disable crash handler, to get core dumps."
msgstr ""
"Desactivar o tratamento de erros, para obter así envorcados de memoria."

#. Tag: option
#: man-kpat.6.docbook:299
#, no-c-format
msgid "--waitforwm"
msgstr "--waitforwm"

#. Tag: para
#: man-kpat.6.docbook:301
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager."
msgstr "Agardar por un xestor de xanelas compatíbel con WM_NET."

#. Tag: option
#: man-kpat.6.docbook:308
#, no-c-format
msgid "--style <replaceable>style</replaceable>"
msgstr "<option>--style</option> <parameter>estilo</parameter>"

#. Tag: para
#: man-kpat.6.docbook:310
#, no-c-format
msgid "sets the application &GUI; style."
msgstr "escoller o estilo gráfico do aplicativo."

#. Tag: option
#: man-kpat.6.docbook:315
#, no-c-format
msgid "--geometry <replaceable>geometry</replaceable>"
msgstr "--geometry <replaceable>geometry</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:317
#, no-c-format
msgid ""
"sets the client geometry of the main widget - see the manual page <ulink url="
"\"man:/X\">man:/X</ulink> for the argument format (usually WidthxHeight+XPos"
"+YPos)."
msgstr ""
"estabelece a xeometría do cliente do widget principal; consulte a páxina do "
"manual <ulink url=\"man:/X\">man:/X</ulink> para o formato do argumento "
"(polo xeral Largo×Alto+XPos+YPos)."

#. Tag: title
#: man-kpat.6.docbook:329
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: term
#: man-kpat.6.docbook:333
#, no-c-format
msgid "<option>--solvegame</option> <replaceable> file</replaceable>"
msgstr "<option>--solvegame</option> <replaceable>ficheiro</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:335
#, no-c-format
msgid "Try to find a solution to the given savegame"
msgstr "Tentar atopar unha solución á partida gardada dada"

#. Tag: term
#: man-kpat.6.docbook:340
#, no-c-format
msgid "<option>--solve</option> <replaceable> num</replaceable>"
msgstr "<option>--solve</option> <replaceable>número</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:342
#, no-c-format
msgid "Dealer to solve (debug)"
msgstr "Repartidor para resolver (depuración)"

#. Tag: term
#: man-kpat.6.docbook:347
#, no-c-format
msgid "<option>--start</option> <replaceable> num</replaceable>"
msgstr "<option>--start</option> <replaceable>número</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:349
#, no-c-format
msgid "Game range start (default 0:INT_MAX)"
msgstr "Inicio do intervalo de xogo (por omisión: 0:INT_MAX)"

#. Tag: term
#: man-kpat.6.docbook:354
#, no-c-format
msgid "<option>--end</option> <replaceable> num</replaceable>"
msgstr "<option>--end</option> <replaceable>número</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:356
#, no-c-format
msgid "Game range end (default start:start if start given)"
msgstr "Fin do intervalo de xogo (por omisión start:start de indicarse start)"

#. Tag: term
#: man-kpat.6.docbook:361
#, no-c-format
msgid "<option>--gametype</option> <replaceable> game</replaceable>"
msgstr "<option>--gametype</option> <replaceable> xogo</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:363
#, no-c-format
msgid ""
"Skip the selection screen and load a particular game type. Valid values are: "
"acesup, fortyeight, freecell, golf, grandfather, grandfathersclock, gypsy, "
"klondike, mod3, simplesimon, spider, yukon"
msgstr ""
"Ignorar a pantalla de selección e cargar un tipo determinado de xogo en "
"particular. Os valores válidos son: acesup, fortyeight, freecell, golf, "
"grandfather, grandfathersclock, gypsy, klondike, mod3, simplesimon, spider, "
"yukon"

#. Tag: title
#: man-kpat.6.docbook:371
#, no-c-format
msgid "Arguments"
msgstr "Argumentos"

#. Tag: replaceable
#: man-kpat.6.docbook:375
#, no-c-format
msgid "file"
msgstr "ficheiro"

#. Tag: para
#: man-kpat.6.docbook:377
#, no-c-format
msgid "File to load"
msgstr "Ficheiro que se vai cargar"

#. Tag: title
#: man-kpat.6.docbook:387
#, no-c-format
msgid "SEE ALSO"
msgstr "VEXA TAMÉN"

#. Tag: para
