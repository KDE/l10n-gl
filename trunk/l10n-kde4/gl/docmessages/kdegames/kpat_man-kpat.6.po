#, no-c-format
msgid ""
"&kpatience; is documented in detail in <emphasis>The &kpatience; Handbook</"
"emphasis> (<filename>$<envar>KDEDIR</envar>/share/doc/HTML/en/kpat/index."
"html</filename> or enter <userinput>help:/kpat/index.html</userinput> in "
"&konqueror;)."
msgstr ""
"O &kpatience; está documentado em detalle no <emphasis>Manual do &kpatience;"
"</emphasis> (<filename>$<envar>KDEDIR</envar>share/doc/HTML/en/kpat/index."
"html</filename> ou escriba <userinput>help:/kpat/index.html</userinput> no "
"&konqueror;)."

