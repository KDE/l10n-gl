msgstr "Mostrar axuda sobre as opcións"

#. Tag: option
#: man-kpat.6.docbook:71
#, no-c-format
msgid "--help-qt"
msgstr "--help-qt"

#. Tag: para
#: man-kpat.6.docbook:73
