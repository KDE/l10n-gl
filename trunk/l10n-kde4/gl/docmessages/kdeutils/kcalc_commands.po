#. Tag: title
#: commands.docbook:3
#, no-c-format
msgid "Command Reference"
msgstr "Referencia dos comandos"

#. Tag: title
#: commands.docbook:6
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr "O menú <guimenu>Ficheiro</guimenu>"

#. Tag: menuchoice
#: commands.docbook:11
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Sair</guimenuitem>"

#. Tag: para
#: commands.docbook:18
#, no-c-format
msgid "<action>Quit</action> &kcalc;."
msgstr "<action>Sae</action> do &kcalc;."

#. Tag: title
#: commands.docbook:26
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr "O menú <guimenu>Editar</guimenu>"

#. Tag: menuchoice
#: commands.docbook:31
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Desfacer</guimenuitem>"

#. Tag: action
#: commands.docbook:38
#, no-c-format
msgid "Go back in the result stack."
msgstr "Volve atrás na pila de resultados."

#. Tag: menuchoice
#: commands.docbook:43
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>Editar</guimenu> <guimenuitem>Refacer</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:50
#, no-c-format
msgid "Go forward in the result stack."
msgstr "Avanza na pila de resultados."

#. Tag: menuchoice
#: commands.docbook:56
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Cortar</guimenuitem>"

#. Tag: action
#: commands.docbook:63
#, no-c-format
msgid "Delete the displayed result and copy it to the clipboard."
msgstr "Borra o resultado presentado e cópiao para o porta-retallos."

#. Tag: menuchoice
#: commands.docbook:68
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Copiar</guimenuitem>"

#. Tag: action
#: commands.docbook:75
#, no-c-format
msgid "Copy the displayed result to the clipboard."
msgstr "Copia o resultado presentado para o porta-retallos."

#. Tag: menuchoice
#: commands.docbook:80
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo> </"
"shortcut> <guimenu>Editar</guimenu> <guimenuitem>Apegar</guimenuitem>"

#. Tag: action
#: commands.docbook:87
#, no-c-format
msgid "Insert the cut or copied result in the display."
msgstr "Insire na pantalla o resultado cortado ou copiado."

#. Tag: title
#: commands.docbook:96
#, no-c-format
msgid "The <guimenu>Constants</guimenu> Menu"
msgstr "O menú <guimenu>Constantes</guimenu>"

#. Tag: menuchoice
#: commands.docbook:101
#, no-c-format
msgid "<guimenu>Constants</guimenu> <guimenuitem>Mathematics</guimenuitem>"
msgstr "<guimenu>Constantes</guimenu> <guimenuitem>Matemáticas</guimenuitem>"

#. Tag: action
#: commands.docbook:105
#, no-c-format
msgid "Display Pi, Euler Number or Golden Ratio."
msgstr "Mostra o Pi, o número de Euler ou a Proporción áurea."

#. Tag: menuchoice
#: commands.docbook:110
#, no-c-format
msgid ""
"<guimenu>Constants</guimenu> <guimenuitem>Electromagnetism</guimenuitem>"
msgstr ""
"<guimenu>Constantes</guimenu> <guimenuitem>Electromagnetismo</guimenuitem>"

#. Tag: action
#: commands.docbook:114
#, no-c-format
msgid ""
"Display Light Speed, Elementary Charge, Impedance of Vacuum, Permeability of "
"Vacuum or Permittivity of Vacuum."
msgstr ""
"Mostra a Velocidade da luz, a Carga elemental, a Impedancia do Vacío, a "
"Permeabilidade do vacío ou a Permisividade do vacío."

#. Tag: menuchoice
#: commands.docbook:120
#, no-c-format
msgid ""
"<guimenu>Constants</guimenu> <guimenuitem>Atomic &amp; Nuclear</guimenuitem>"
msgstr ""
"<guimenu>Constantes</guimenu> <guimenuitem>Atómico &amp; nuclear</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:124
#, no-c-format
msgid ""
"Display Planck's Constant, Elementary Charge or Fine-Structure Constant."
msgstr ""
"Mostra a Constante de Planck, a Carga elemental ou a Constante de estrutura "
"fina."

#. Tag: menuchoice
#: commands.docbook:130
#, no-c-format
msgid "<guimenu>Constants</guimenu> <guimenuitem>Thermodynamics</guimenuitem>"
msgstr "<guimenu>Constantes</guimenu> <guimenuitem>Termodinámica</guimenuitem>"

#. Tag: action
#: commands.docbook:134
#, no-c-format
msgid ""
"Display Boltzmann Constant, Atomic Mass Unit, Molar Gas Constant, Stefan-"
"Boltzmann Constant or Avogadro's Number."
msgstr ""
"Mostra a Constante de Boltzmann, a Unidade de masa atómica, a Constante "
"molar dos gases, a Constante de Stefan-Boltzmann ou o Número de Avogadro."

#. Tag: menuchoice
#: commands.docbook:140
#, no-c-format
msgid "<guimenu>Constants</guimenu> <guimenuitem>Gravitation</guimenuitem>"
msgstr "<guimenu>Constantes</guimenu> <guimenuitem>Gravitación</guimenuitem>"

#. Tag: para
#: commands.docbook:144
#, no-c-format
msgid "Display Constant of Gravitation or Earth Acceleration."
msgstr "Mostra a Constante de gravitación ou a Aceleración da Terra."

#. Tag: title
#: commands.docbook:153
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "O menú <guimenu>Configuración</guimenu>"

#. Tag: menuchoice
#: commands.docbook:157
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Science/Engineering Buttons</"
"guimenuitem>"
