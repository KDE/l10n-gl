"<guimenu>Configuración</guimenu> <guimenuitem>Botóns Científicos/Enxeñaría</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:161
#, no-c-format
msgid "Display science and engineering buttons."
msgstr "Mostra os botóns científicos e de enxeñaría."

#. Tag: menuchoice
#: commands.docbook:166
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Statistic Buttons</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Botóns estatísticos</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:170
#, no-c-format
msgid "Display <link linkend=\"statistical-mode\">statistic buttons.</link>"
msgstr ""
"Mostra os <link linkend=\"statistical-mode\">botóns estatísticos.</link>"

#. Tag: menuchoice
#: commands.docbook:176
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Logic Buttons</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Botóns lóxicos</guimenuitem>"

#. Tag: action
#: commands.docbook:180
#, no-c-format
msgid "Display <link linkend=\"and-or-xor\">logic buttons.</link>"
msgstr "Mostra os <link linkend=\"and-or-xor\">botóns lóxicos.</link>"

#. Tag: menuchoice
#: commands.docbook:186
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Constants Buttons</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Botóns de constantes</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:190
#, no-c-format
msgid "Display constants buttons."
msgstr "Mostra os botóns das constantes."

#. Tag: menuchoice
#: commands.docbook:195
#, fuzzy, no-c-format
#| msgid "<guimenu>Settings</guimenu> <guimenuitem>Show All</guimenuitem>"
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Bit Edit</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Mostrar todos</guimenuitem>"

#. Tag: action
#: commands.docbook:199
#, no-c-format
msgid "Displays a bit edit field. Click on a bit to toggle it."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:204
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show All</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Mostrar todos</guimenuitem>"

#. Tag: action
#: commands.docbook:208
#, no-c-format
msgid "Display all buttons available."
msgstr "Mostra todos os botóns disponíbeis."

#. Tag: menuchoice
#: commands.docbook:213
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Hide All</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Agochar todos</guimenuitem>"

#. Tag: action
#: commands.docbook:217
#, no-c-format
msgid "Hide all extra buttons and display only standard default buttons."
msgstr "Esconde todos os botóns extra e mostra apenas os botóns normais."

#. Tag: menuchoice
#: commands.docbook:223
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Configurar os atallos de "
