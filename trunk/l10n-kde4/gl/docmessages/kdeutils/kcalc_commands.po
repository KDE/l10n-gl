#. Tag: action
#: commands.docbook:227
#, no-c-format
msgid "Configure the keyboard shortcuts used by &kcalc;."
msgstr "Configura os atallos de teclado usados polo &kcalc;."

#. Tag: menuchoice
#: commands.docbook:233
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kcalc;...</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Configurar &kcalc;...</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:237
#, no-c-format
msgid "<action>Display</action> the &kcalc; settings dialog."
msgstr "<action>Mostra</action> o diálogo de configuración do &kcalc;."

