#: index.docbook:265
#, fuzzy, no-c-format
#| msgid "The contents of the selected folder entry"
msgid "The contents of the selected folder entry at the right side"
msgstr "O contido do elemento do cartafol seleccionado"

#. Tag: para
#: index.docbook:268
#, fuzzy, no-c-format
#| msgid ""
#| "Folders may be added or deleted, and selecting a folder will update the "
#| "folder entry list and the summary display. Selecting a folder entry will "
