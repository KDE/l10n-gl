#. Tag: title
#: man-nepomukserver.8.docbook:34
#, no-c-format
msgid "Synopsis"
msgstr "Resumo"

#. Tag: cmdsynopsis
#: man-nepomukserver.8.docbook:36
#, no-c-format
msgid ""
"<command>nepomukserver</command> <arg choice=\"opt\">--help</arg> <arg "
"choice=\"opt\">Generic options</arg> <arg choice=\"opt\">&Qt;-options</arg> "
"<arg choice=\"opt\">&kde;-options</arg>"
msgstr ""
"<command>nepomukserver</command> <arg choice=\"opt\">--help</arg> <arg "
"choice=\"opt\">Opcións xenéricas</arg> <arg choice=\"opt\">Opcións de &Qt;</"
"arg> <arg choice=\"opt\">Opcións de &kde;</arg>"

#. Tag: title
#: man-nepomukserver.8.docbook:47
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-nepomukserver.8.docbook:49
#, no-c-format
msgid ""
"<command>nepomukserver</command> starts the Nepomuk server which manages all "
"Nepomuk services and provides a DBus API."
msgstr ""
"<command>nepomukserver</command> inicia o servidor de Nepomuk que xestiona "
"todos os servizos Nepomuk e fornece unha API para DBus."

#. Tag: para
#: man-nepomukserver.8.docbook:53
#, no-c-format
msgid ""
"It uses <command>nepomukservicestub</command> to run all configured Nepomuk "
"services."
msgstr ""
"Utiliza o <command>nepomukservicestub</command> para executar todos os "
"servizos configurados no Nepomuk."

