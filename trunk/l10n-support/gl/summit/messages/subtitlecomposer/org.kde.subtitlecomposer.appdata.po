#: org.kde.subtitlecomposer.appdata.xml:9
msgid "Subtitle Composer"
msgstr "Subtitle Composer"

#. (itstool) path: component/summary
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:10
msgid "Video subtitle editor that supports basic and advanced editing operations"
msgstr "Editor de subtítulos de vídeo que permite operacións de edición básicas e avanzadas"

#. (itstool) path: description/p
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:12
msgid "Subtitle Composer is an open source text-based subtitle editor that supports basic and advanced editing operations."
msgstr "Subtitle Composer é un editor de subtítulos de vídeo libre baseado en texto que permite operacións de edición básicas e avanzadas."

#. (itstool) path: description/p
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:13
msgid "Features"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:15
msgid "Open/Save Text Subtitle Formats - SubRip/SRT, MicroDVD, SSA/ASS, MPlayer, TMPlayer and YouTube captions"
msgstr "Abrir e gardar formatos de subtítulos de texto: SubRip/SRT, MicroDVD, SSA/ASS, MPlayer, TMPlayer e lendas de YouTube."

#. (itstool) path: ul/li
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:16
msgid "Open/OCR Graphics Subtitle Formats - VobSub (.idx/.sub/.rar), BluRay/PGS (*.sup), formats supported by ffmpeg (DVD/Vob, DVB, XSUB, HDMV-PGS)"
msgstr "Formatos de subtítulos gráficos abertos ou de OCR: VobSub (.idx/.sub/.rar), BluRay/PGS (*.sup) e formatos permitidos por ffmpeg (DVD/Vob, DVB, XSUB, HDMV-PGS)."

#. (itstool) path: ul/li
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:17
msgid "Demux Graphics/Text Subtitle Stream from video file - SRT, SSA/ASS, MOV text, MicroDVD, DVD/Vob, DVB, XSUB, HDMV-PGS"
msgstr "Gráficos de desmultiplexación ou fluxo de subtítulos de texto dun ficheiro de vídeo: SRT, SSA/ASS, texto de MOV, MicroDVD, DVD/Vob, DVB, XSUB e HDMV-PGS."

#. (itstool) path: ul/li
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:18
msgid "Speech recognition from audio/video file using PocketSphinx"
msgstr "Recoñecemento de fala a partir de ficheiros de son ou de vídeo mediante PocketSphinx."

#. (itstool) path: ul/li
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:19
msgid "Smart language/text encoding** detection"
msgstr "Detección intelixente de idioma e codificación de texto**."

#. (itstool) path: ul/li
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:20
msgid "Live preview of subtitles in integrated video player w/ audio stream selection"
msgstr "Previsualizar en vivo de subtítulos nun reprodutor de vídeo integrado con selección de fluxo de son."

#. (itstool) path: ul/li
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:21
msgid "Preview/editing of subtitles on graphical audio waveform w/ audio stream selection"
msgstr "Vista previa ou edición de subtítulos en forma de onda de son gráfica con selección de fluxo de son."

#. (itstool) path: ul/li
#. +> trunk5
#: org.kde.subtitlecomposer.appdata.xml:22
msgid "Sync by dragging several anchors/graftpoints and stretching timeline"
msgstr "Sincronizar arrastrando varias áncoras e puntos de grafo e estiramento de cronoloxía."

