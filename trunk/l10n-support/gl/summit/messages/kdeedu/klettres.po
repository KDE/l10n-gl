#: klettres.cpp:141
#, kde-format
msgid "Replay Sound"
msgstr "Repetir o son"

#. +> trunk5 stable5
#: klettres.cpp:144
#, kde-format
msgid "Play the same sound again"
msgstr "Tocar de novo o mesmo son"

#. +> trunk5 stable5
#: klettres.cpp:146
#, kde-format
msgid "You can replay the same sound again by clicking this button or using the File menu, Replay Sound."
msgstr "Podes reproducir de novo o mesmo son premendo este botón ou empregando o menú Ficheiro -> Repetir o son."

