#: klettres.cpp:132
#, kde-format
msgid "Play a new sound"
msgstr "Reproducir un son novo"

#. +> trunk5 stable5
#: klettres.cpp:133
#, kde-format
msgid "You can play a new sound by clicking this button or using the File menu, New Sound."
msgstr "Podes tocar un son novo se premes este botón ou utilizas a opción do menú Ficheiro->Novo son."

