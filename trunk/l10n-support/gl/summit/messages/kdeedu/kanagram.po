msgstr "Esta opción contén o vocabulario actual."

#. i18n: ectx: label, entry (singlePlayerMode), group (kanagram)
#. +> trunk5 stable5
#: kanagram.kcfg:13
#, kde-format
msgid "This setting allows you to decide one-player or two-player mode"
msgstr "Esta opción permite escoller entre os modos dun xogador ou dous xogadores."

#. i18n: ectx: label, entry (hintHideTime), group (kanagram)
#. +> trunk5 stable5
#: kanagram.kcfg:17
#, kde-format
msgid "This setting allows you to set in seconds how long Kanagram's hint bubble is shown."
msgstr "Esta opción permite indicar en segundos durante canto tempo aparecerá a burbulla da axuda de Kanagram."

#. i18n: ectx: label, entry (resolveTime), group (kanagram)
#. +> trunk5 stable5
#: kanagram.kcfg:21
#, kde-format
msgid "This setting allows you to set in seconds how much time is available for resolving the anagram."
msgstr "Esta opción permite indicar en segundos durante de canto tempo se dispón para resolver o anagrama."

#. i18n: ectx: label, entry (scoreTime), group (kanagram)
