#. +> trunk6 stable6
#: history_module/kcmhistory.cpp:54
#, kde-format
msgid ""
"Action to carry out when opening an URL from history:"
"<dl>"
"<dl>"
"<dt>Auto:</dt>"
"<dd>opens the URL in a new tab unless the current tab is empty or an intro page</dd>"
"<dt>Open URL in a new tab:</dt>"
"<dd>always opens the URL in a new tab</dd>"
"<dt>Open URL in current tab:</dt>"
"<dd>always opens the URL in the current tab</dd>"
"<dt>Open URL in new window:</dt>"
"<dd>always opens the URL in a new window</dd>"
"</dl>"
msgstr ""
"Acción a realizar ao abrir un URL do historial:"
"<dl>"
"<dl>"
"<dt>Automática:</dt>"
"<dd>Abre o URL nunha lapela a menos que a lapela actual estea baleira ou sexa a páxina de inicio.</dd>"
"<dt>Abrir nunha lapela:</dt>"
"<dd>Abre sempre o URL nunha nova lapela.</dd>"
"<dt>Abrir na lapela actual:</dt>"
"<dd>Abre sempre o URL na lapela actual.</dd>"
"<dt>Abrir o URL nunha nova xanela:</dt>"
"<dd>Abre sempre o URL nunha nova xanela.</dd>"
"</dl>"

