msgstr "Uso non interactivo: sen diálogos"

#. +> trunk5 stable5
#: kfmclient.cpp:67
#, kde-format
msgid "Show available commands"
msgstr "Amosar as ordes dispoñíbeis"

#. +> trunk5
#: kfmclient.cpp:76
#, kde-format
msgid "The mimetype of the URL. Allows Konqueror to determine in advance which component to use, making it start faster."
msgstr "O tipo MIME do URL. Permite a Konqueror determinar por adiantado que compoñente usar, acelerando o inicio."

#. +> trunk5
#: kfmclient.cpp:77
#, kde-format
msgctxt "the name for a the value of an option on the command line help"
msgid "type"
msgstr "tipo"

#. +> trunk5 stable5
#: kfmclient.cpp:79
#, kde-format
msgid "Command (see --commands)"
msgstr "Orde (consulte --commands)"

#. +> trunk5 stable5
#: kfmclient.cpp:81
#, kde-format
msgid "Arguments for command"
msgstr "Argumentos para a orde"

#. +> trunk5 stable5
#: kfmclient.cpp:83
#, kde-format
msgid "The files/URLs opened by the application will be deleted after use"
msgstr "Os ficheiros ou enderezos URL abertos pola aplicación eliminaranse despois de usalos"

#. +> trunk5 stable5
#: kfmclient.cpp:91
#, kde-format
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Sintaxe:\n"

#. +> trunk5
#: kfmclient.cpp:92
#, kde-format
#| msgid ""
#| "  kfmclient openURL 'url' ['mimetype']\n"
#| "            # Opens a window showing 'url'.\n"
#| "            #  'url' may be a relative path\n"
#| "            #   or file name, such as . or subdir/\n"
#| "            #   If 'url' is omitted, $HOME is used instead.\n"
#| "\n"
msgid ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # Opens a window showing 'url'.\n"
"            #  'url' may be a relative path\n"
"            #   or file name, such as . or subdir/\n"
"            #   If 'url' is omitted, the start page is shown.\n"
"\n"
msgstr ""
"  kfmclient openURL 'URL' ['tipo MIME']\n"
"            # Abre unha xanela amosando o URL.\n"
"            #   'URL' pode ser unha ruta relativa\n"
"            #   ou un nome de ficheiro, como . ou subcartafol/\n"
"            #   Se omite 'URL', amosarase a páxina de inicio.\n"
"\n"

#. +> stable5
#: kfmclient.cpp:94
#, kde-format
msgid ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # Opens a window showing 'url'.\n"
"            #  'url' may be a relative path\n"
"            #   or file name, such as . or subdir/\n"
"            #   If 'url' is omitted, $HOME is used instead.\n"
"\n"
msgstr ""
"  kfmclient openURL 'URL' ['tipo MIME']\n"
"            # Abre unha xanela amosando o URL.\n"
"            #   'URL' pode ser unha ruta relativa\n"
"            #   ou un nome de ficheiro, como . ou subcartafol/\n"
"            #   Se omite 'URL', usarase no seu canto $HOME.\n"
"\n"

#. +> trunk5
#: kfmclient.cpp:97
#, kde-format
#| msgid ""
#| "            # If 'mimetype' is specified, it will be used to determine the\n"
#| "            #   component that Konqueror should use. For instance, set it to\n"
#| "            #   text/html for a web page, to make it appear faster\n"
#| "\n"
msgid ""
"            # If 'mimetype' is specified, it will be used to determine the\n"
"            #   component that Konqueror should use. For instance, set it to\n"
"            #   text/html for a web page, to make it appear faster\n"
"            # Note: this way of specifying mimetype is deprecated.\n"
"            #   Please use the --mimetype option\n"
"\n"
msgstr ""
"            # De indicar «mimetype», usarase para determinar a\n"
"            #   compoñente que deberá usar Konqueror. Por exemplo, póñao como\n"
"            #   text/html para unha páxina web, para facer que apareza máis axiña.\n"
"            # Nota: este xeito de indicar o tipo MIME está obsoleto.\n"
"            #   Use a opción «--mimetype».\n"

#. +> stable5
#: kfmclient.cpp:99
#, kde-format
msgid ""
"            # If 'mimetype' is specified, it will be used to determine the\n"
"            #   component that Konqueror should use. For instance, set it to\n"
"            #   text/html for a web page, to make it appear faster\n"
"\n"
msgstr ""
"            # De indicar «mimetype», usarase para determinar a\n"
"            #   compoñente que deberá usar Konqueror. Por exemplo, póñao como\n"
"            #   text/html para unha páxina web, para facer que apareza máis axiña\n"
"\n"

#. +> trunk5 stable5
#: kfmclient.cpp:103
#, kde-format
msgid ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # Same as above but opens a new tab with 'url' in an existing Konqueror\n"
"            #   window on the current active desktop if possible.\n"
"\n"
msgstr ""
"  kfmclient newTab 'URL' ['tipo MIME']\n"
"            # Igual que enriba pero abre unha nova lapela co 'URL' nunha xanela de Konqueror\n"
"            #   xa existente no escritorio activo se é posíbel.\n"
"\n"

