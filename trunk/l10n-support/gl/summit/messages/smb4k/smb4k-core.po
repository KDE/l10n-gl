#. +> trunk6 stable6
#: smb4k.kcfg:103
#, kde-format
msgid "Icon size:"
msgstr "Tamaño das iconas:"

#. i18n: ectx: whatsthis, entry (NetworkBrowserIconSize), group (UserInterface)
#. +> trunk6 stable6
#: smb4k.kcfg:104
#, kde-format
