#. +> trunk6
#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "System Notifications"
msgstr "Notificacións do sistema."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:36
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Lixo: Baleiro"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:89
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Baleirouse o lixo."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:146
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Completación de texto: rotación"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:198
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Acadouse a fin da lista de coincidencias."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:254
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Completación de texto: sen coincidencias"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:306
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Non se atopou ningún acabamento."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:362
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Completación de texto: coincidencia parcial"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:414
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Hai máis dun posíbel acabamento."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:471
msgctxt "Name"
msgid "Fatal Error"
msgstr "Erro fatal"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:525
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Produciuse un erro grave que fixo que o programa saíse."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:582
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:636
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Ocorreu algo especial no programa."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:692
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:746
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Produciuse un erro no programa que pode causar problemas."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:803
msgctxt "Name"
msgid "Catastrophe"
msgstr "Catástrofe"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:856
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Produciuse un erro moi grave, que como mínimo fixo que o programa saíse."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:912
msgctxt "Name"
msgid "Application Crash"
msgstr "Quebra dunha aplicación"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:962
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Unha aplicación pechouse inesperadamente."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1014
msgctxt "Name"
msgid "Login"
msgstr "Acceso"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1067
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Iniciando unha nova sesión."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1123
msgctxt "Name"
msgid "Logout"
msgstr "Saír"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1176
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Estase a saír da sesión."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1233
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Cancelouse a saída"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1286
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Cancelouse a saída de Plasma."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1342
msgctxt "Name"
msgid "Print Error"
