#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1396
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Produciuse un erro na impresión."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1453
msgctxt "Name"
msgid "Information Message"
