#: plasma_workspace.notifyrc:1507
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Está a amosarse unha mensaxe de información."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1564
msgctxt "Name"
msgid "Warning Message"
msgstr "Mensaxe de aviso"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1618
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Está a amosarse unha mensaxe de aviso."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1675
msgctxt "Name"
msgid "Critical Message"
msgstr "Mensaxe crítica"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1729
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Está a amosarse unha mensaxe crítica."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1786
msgctxt "Name"
msgid "Question"
msgstr "Pregunta"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1840
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Está a facerse unha pregunta."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1898
msgctxt "Name"
msgid "Beep"
msgstr "Badalada"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1951
msgctxt "Comment"
msgid "Sound bell"
msgstr "Badalada sonora."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:2007
msgctxt "Name"
msgid "Widget failed to install"
msgstr "O trebello non puido instalarse"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:2057
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "Non foi posíbel instalar un trebello."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:2110
msgctxt "Name"
msgid "Widget deleted"
msgstr "Eliminouse o trebello"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:2162
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Eliminouse un trebello."

#. +> trunk6
#: plasma_workspace.notifyrc:2217
msgctxt "Name"
msgid "Device plugged in"
msgstr "Dispositivo conectado"

#. +> trunk6
#: plasma_workspace.notifyrc:2255
msgctxt "Comment"
msgid "A device was plugged in"
msgstr "Conectouse un dispositivo."

#. +> trunk6
#: plasma_workspace.notifyrc:2297
msgctxt "Name"
msgid "Device unplugged"
msgstr "Dispositivo desconectado"

#. +> trunk6
#: plasma_workspace.notifyrc:2335
msgctxt "Comment"
msgid "A device was unplugged"
msgstr "Desconectouse un dispositivo."

