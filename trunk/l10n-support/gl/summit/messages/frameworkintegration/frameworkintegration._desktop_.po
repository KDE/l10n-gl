#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Espazo de traballo de Plasma."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:58
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Lixo: Baleiro"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:111
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Baleirouse o lixo."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:168
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Completación de texto: rotación"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:220
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Acadouse a fin da lista de coincidencias."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:276
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Completación de texto: sen coincidencias"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:328
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Non se atopou ningún acabamento."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:384
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Completación de texto: coincidencia parcial"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:436
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Hai máis dun posíbel acabamento."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:493
msgctxt "Name"
msgid "Fatal Error"
msgstr "Erro fatal"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:547
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Produciuse un erro grave que fixo que o programa saíse."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:604
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:658
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Ocorreu algo especial no programa."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:714
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:768
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Produciuse un erro no programa que pode causar problemas."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:825
msgctxt "Name"
msgid "Catastrophe"
msgstr "Catástrofe"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:878
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Produciuse un erro moi grave, que como mínimo fixo que o programa saíse."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:934
msgctxt "Name"
msgid "Application Crash"
msgstr "Quebra dunha aplicación"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:984
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Unha aplicación pechouse inesperadamente."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1036
msgctxt "Name"
msgid "Login"
msgstr "Acceso"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1089
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Iniciando unha nova sesión."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1145
msgctxt "Name"
msgid "Logout"
msgstr "Saír"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1198
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Estase a saír da sesión."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1255
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Cancelouse a saída"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1308
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Cancelouse a saída de Plasma."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1364
msgctxt "Name"
msgid "Print Error"
msgstr "Erro de impresión"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1418
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Produciuse un erro na impresión."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1475
msgctxt "Name"
msgid "Information Message"
msgstr "Mensaxe de información"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1529
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Está a amosarse unha mensaxe de información."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1586
msgctxt "Name"
msgid "Warning Message"
msgstr "Mensaxe de aviso"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1640
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Está a amosarse unha mensaxe de aviso."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1697
msgctxt "Name"
msgid "Critical Message"
msgstr "Mensaxe crítica"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1751
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Está a amosarse unha mensaxe crítica."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1808
msgctxt "Name"
msgid "Question"
msgstr "Pregunta"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1862
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Está a facerse unha pregunta."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1920
msgctxt "Name"
msgid "Beep"
msgstr "Badalada"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:1973
msgctxt "Comment"
msgid "Sound bell"
msgstr "Badalada sonora."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:2029
msgctxt "Name"
msgid "Widget failed to install"
msgstr "O trebello non puido instalarse"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:2079
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "Non foi posíbel instalar un trebello."

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:2132
msgctxt "Name"
msgid "Widget deleted"
msgstr "Eliminouse o trebello"

#. +> trunk6 trunk5
#: plasma_workspace.notifyrc:2184
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Eliminouse un trebello."

#. +> trunk6
#: plasma_workspace.notifyrc:2239
msgctxt "Name"
msgid "Device plugged in"
msgstr "Dispositivo conectado"

#. +> trunk6
#: plasma_workspace.notifyrc:2275
msgctxt "Comment"
msgid "A device was plugged in"
msgstr "Conectouse un dispositivo."

#. +> trunk6
#: plasma_workspace.notifyrc:2315
msgctxt "Name"
msgid "Device unplugged"
msgstr "Dispositivo desconectado"

#. +> trunk6
#: plasma_workspace.notifyrc:2351
msgctxt "Comment"
msgid "A device was unplugged"
msgstr "Desconectouse un dispositivo."
