#. i18n: ectx: property (text), item, widget (QComboBox, combo_means_match)
#. +> trunk6 stable6
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:117
#, kde-format
msgid "Closest"
msgstr "Maior proximidade"

#. i18n: ectx: property (html), widget (QTextEdit, textEdit)
#. +> trunk6 stable6
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:141
#, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">k-Means divides the colors into clusters and refines the assignment at every iteration.</p>"
"\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br />"
"</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">This is the best option when tracing images with a lot of colors or shading.</p>"
"\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br />"
"</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">For pictures with a lot of colors increasing the number of iterations will yield better results but it might be slower.</p>"
"\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br />"
"</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The <span style=\" font-style:italic;\">Match</span> option performs some post-processing:</p>"
"\n"
"<ul style=\"margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;\">"
"<li style=\"\" style=\" margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">None</span>: Don't perform any post-processing and return the means (note this might result in colors not present in the original image)</li>"
"\n"
"<li style=\"\" style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Closest</span>: Find the color in the original image that is the closest to the mean</li>"
"\n"
"<li style=\"\" style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Most Frequent</span>: Find the color in the cluster that appears most often in the source image</li>"
"</ul>"
"</body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">«Medias k» divide as cores en grupos e axusta a asignación en cada iteración.</p>"
"\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br />"
"</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Esta é a mellor opción para trazar imaxes con moitas cores e matices.</p>"
"\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br />"
"</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">En imaxes con moitas cores, aumentar o número de iteracións pode dar mellores resultados, pero podería levar máis tempo.</p>"
"\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br />"
"</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">A opción <span style=\" font-style:italic;\">Coincidencia</span> realiza post-procesamento:</p>"
"\n"
"<ul style=\"margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;\">"
"<li style=\"\" style=\" margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Nada</span>: non realizar post-procesamento, devolver as medias (isto pode resultar en cores non presentes na imaxe orixinal).</li>"
"\n"
"<li style=\"\" style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Maior proximidade</span>: atopar a cor da imaxe orixinal máis próxima á media.</li>"
"\n"
"<li style=\"\" style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Maior frecuencia</span>: atopar a cor do grupo que aparece con maior frecuencia na imaxe orixinal.</li>"
"</ul>"
"</body></html>"

#. i18n: ectx: property (plainText), widget (QPlainTextEdit, plainTextEdit)
#. +> trunk6 stable6
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:159
#, kde-format
msgid ""
"k-Modes gives you the colors that appear most often in the source image.\n"
"\n"
"It's very fast but it does not give accurate colors for complex images.\n"
"\n"
"This is the best option when tracing images with flat colors."
msgstr ""
"«Modos k» devolve as cores que aparecen con maior frecuencia na imaxe orixinal.\n"
"\n"
"É moi rápido pero non devolve cores precisas para imaxes complexas.\n"
"\n"
"É a mellor opción ao trazar imaxes con cores planas."

#. i18n: ectx: property (html), widget (QTextEdit, textEdit_2)
#. +> trunk6 stable6
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:178
#, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The Octree algorithm merges similar colors from the bottom up.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">It gives more accurate colors for complex images but it might result into colors that are not present in the source image.</p>"
"</body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">O algoritmo de árbore octal fusiona cores similares de abaixo a arriba.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Devolve cores máis precisas para imaxes complexas pero pode devolver cores non presentes na imaxe orixinal.</p>"
"</body></html>"

#. i18n: ectx: property (text), widget (QLabel, label_4)
#. +> trunk6 stable6
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:189
#, kde-format
msgid "Min Frequency"
msgstr "Frecuencia mínima"

#. i18n: ectx: property (html), widget (QTextEdit, textEdit_3)
#. +> trunk6 stable6
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:205
#, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Edge Exclusion Modes takes the most frequent color (mode) in the image, then excludes all pixels touching said area, then repeats the process until the appropriate number of colors has been found.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">This approach removes anti-aliased edges but it might cause small details to not be detected.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Min Frequency</span> refers to the minimum amount of pixels that a color must have to be considered (as a percentage of the total number of pixels in the image).</p>"
"</body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">«Modos de exclusión de extremos» atopa a cor máis frecuente da imaxe (moda), exclúe todos os píxeles que a tocan, e repíteo ata atopar un número axeitado de cores.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Este método elimina bordos suavizados pero pode impedir a detección de pequenos detalles.</p>"
"\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Frecuencia mínima</span> é a cantidade mínima de píxeles que debe ter unha cor para terse en conta (como porcentaxe do número total de píxeles da imaxe).</p>"
"</body></html>"

