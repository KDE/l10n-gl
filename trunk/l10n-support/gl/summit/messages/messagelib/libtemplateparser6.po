#. +> trunk6 stable6
#: ui/templatesconfiguration_base.ui:326
#, kde-format, no-c-format
msgctxt "@info:whatsthis"
msgid ""
"\n"
"             <qt>The following placeholders are supported in the quote indicator:\n"
"             "
"<ul>\n"
"             "
"<li>%f: sender's initials</li>"
"\n"
"             "
"<li>%%: percent sign</li>"
"\n"
"             "
"<li>%_: space</li>"
"\n"
"             </ul>"
"</qt>\n"
"           "
msgstr ""
"\n"
"             <qt>Permítense os substitutos seguintes no indicador de citas:\n"
"             "
"<ul>\n"
"             "
"<li>%f: iniciais do remitente</li>"
"\n"
"             "
"<li>%%: símbolo de porcentaxe</li>"
"\n"
"             "
"<li>%_: espazo</li>"
"\n"
"             </ul>"
"</qt>\n"
"           "

