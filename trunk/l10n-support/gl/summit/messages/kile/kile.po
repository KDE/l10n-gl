msgstr "Enumeración — \\begin{enumerate}"

#. +> trunk6
#: kilestdactions.cpp:56
#, kde-format
msgid "Enumeration"
msgstr "Enumeración"

#. +> trunk6
#: kilestdactions.cpp:56
#, kde-format
