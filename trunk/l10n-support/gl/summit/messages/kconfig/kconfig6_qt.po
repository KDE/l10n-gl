#. +> trunk6 trunk5
#: kconf_update/kconf_update.cpp:368
msgctxt "main|"
msgid "KDE Tool for updating user configuration files"
msgstr ""
"Ferramenta de KDE para actualizar os ficheiros de configuración da persoa"
" usuaria."

#. +> trunk6 trunk5
#: kconf_update/kconf_update.cpp:370
msgctxt "main|"
msgid "Keep output results from scripts"
msgstr "Conservar a saída dos guións"

#. +> trunk6
#: kconf_update/kconf_update.cpp:373
msgctxt "main|"
msgid ""
"For unit tests only: do not write the done entries, so that with every"
" re-run, the scripts are executed again"
msgstr ""
"Só para probas unitarias: non escribir as entradas feitas, para que os guións"
" se executen de novo cada vez"

#. +> trunk6 trunk5
#: kconf_update/kconf_update.cpp:375
msgctxt "main|"
msgid "Check whether config file itself requires updating"
msgstr "Comprobar se o ficheiro de configuración precisa actualizarse"

#. +> trunk6 trunk5
#: kconf_update/kconf_update.cpp:378
msgctxt "main|"
msgid "File(s) to read update instructions from"
msgstr "Ficheiros dos que ler as instrucións de actualización."

#. +> trunk5
#: kconf_update/kconf_update.cpp:964
msgctxt "main|"
msgid ""
"For unit tests only: use test directories to stay away from the user's real"
" files"
msgstr ""
"Só para probas unitarias: usar cartafoles de proba para evitar os ficheiros"
" reais da persoa usuaria."

#. +> trunk6 trunk5
#: kconfig_compiler/kconfig_compiler.cpp:726
msgctxt "main|"
