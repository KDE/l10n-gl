#. +> stable5
#: duchain/builders/declarationbuilder.cpp:321
#, kde-format
msgid "Access type for interface method %1 must be omitted."
msgstr "Debe omitirse o tipo de acceso ao método %1 da interface."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:325
#, kde-format
msgid "Interface function %1 cannot contain body."
msgstr "A función %1 da interface non pode ter corpo."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:337
#, kde-format
msgid "Class %1 contains abstract method %2 and must therefore be declared abstract or implement the method."
msgstr "A clase %1 contén o método abstracto %2 e polo tanto debe declararse como abstracta ou realizar o método."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:343
#, kde-format
msgid "Abstract function %1 cannot contain body."
msgstr "A función abstracta %1 non pode ter corpo."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:346
#, kde-format
msgid "Cannot use the final modifier on an abstract class member."
msgstr ""
"Non é posíbel usar o modificador final nun membro dunha clase abstracta."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:356
#, kde-format
msgid "Non-abstract method %1 must contain body."
msgstr "O método non abstracto %1 debe ter corpo."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:374
#, kde-format
msgid "Properties cannot be declared final."
msgstr "As propiedades non se poden declarar como finais."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:377
#, kde-format
msgid "Properties cannot be declared abstract."
msgstr "As propiedades non se poden declarar como abstractas."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:423
#, kde-format
msgid "Trait method %1 has not been applied, because there are collisions with other trait methods on %2"
msgstr "Non se aplicou o método de trazo %1 porque entra en conflito con outros métodos de trazo en %2."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:577
#, kde-format
msgid "Cannot redeclare private property %1 from this context."
msgstr ""
"Non é posíbel declarar de novo a propiedade privada %1 desde este contexto."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:583
#, kde-format
msgid "Cannot redeclare protected property %1 from this context."
msgstr ""
"Non é posíbel declarar de novo a propiedade protexida %1 desde este contexto."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:616
#, kde-format
msgid "Traits cannot have constants."
msgstr "Os trazos non poden ter constantes."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:657
#, kde-format
msgid "Only booleans, ints, floats and strings are allowed for class constants."
msgstr "Só se permiten valores lóxicos, enteiros, de coma flutuante ou cadeas para as constantes das clases."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:709
#, kde-format
msgid "Cannot use 'final' as method modifier"
msgstr "Non é posíbel usar «final» como modificador para un método."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:712
#, kde-format
msgid "Cannot use 'static' as method modifier"
msgstr "Non é posíbel usar «static» como modificador para un método."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:760
#, kde-format
msgid "Default value for parameters with a class type hint can only be NULL."
msgstr "O valor predeterminado dos parámetros cunha suxestión de tipo de clase só pode ser NULL."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:763
#, kde-format
msgid "Following parameters must have a default value assigned."
msgstr "Os parámetros seguintes teñen que ter asignado un valor predeterminado."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:870
#, kde-format
msgid "Cannot redeclare PHP internal %1."
msgstr "Non é posíbel declarar de novo %1 interno de PHP."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:873
#, kde-format
msgid "%1 and %2 define the same property (%3) in the composition of %1. This might be incompatible, to improve maintainability consider using accessor methods in traits instead."
msgstr "%1 e %2 definen a mesma propiedade (%3) na composición de %1. Isto podería ser incompatíbel, para facilitar o mantemento do código considere usar no seu lugar métodos de acceso en trazos."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:881
#, kde-format
msgid "Cannot redeclare %1, already declared in %2 on line %3."
msgstr "Non é posíbel declarar de novo %1, xa se declarou na liña %3 de %2."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:967
#, kde-format
msgid "Class %1 contains %2 abstract methods and must therefore be declared abstract or implement the remaining methods."
msgstr "A clase %1 contén %2 métodos abstractos e polo tanto debe declararse como abstracta ou realizar os métodos restantes."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:974
#, kde-format
msgid "Cannot re-assign $this."
msgstr "Non é posíbel asignar de novo $this."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:1410
#, kde-format
msgid "The use statement with non-compound name '%1' has no effect."
msgstr "A declaración use co nome non composto «%1» non ten efecto."

#. +> stable5
#: duchain/builders/declarationbuilder.cpp:1434
#, kde-format
msgid "Cannot use '%1' as '%2' because the name is already in use."
msgstr "Non pode usarse «%1» como «%2» porque o nome xa está en uso."

#. +> stable5
#: duchain/builders/usebuilder.cpp:191
