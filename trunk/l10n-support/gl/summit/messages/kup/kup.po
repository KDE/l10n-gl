#. +> trunk5
#: kcm/driveselectiondelegate.cpp:161
#, kde-kuit-format
msgctxt "@item:inlistbox"
msgid ""
"Warning: Symbolic links and file permissions can not be saved to this file sys"
"tem. File permissions only matters if there is more than one user of this comp"
"uter or if you are backing up executable program files."
msgstr ""
"Aviso: as ligazóns simbólicas e os permisos de ficheiros non poden gardarse ne"
"ste sistema de ficheiros. Os permisos de ficheiros só importan se o computador"
" ten máis dunha persoa usuaria ou se está salvagardando ficheiros de programas"
"."

#. +> trunk5
#: kcm/driveselectiondelegate.cpp:167
#, kde-kuit-format
msgctxt "@item:inlistbox"
msgid ""
"Warning: File permissions can not be saved to this file system. File permissio"
"ns only matters if there is more than one user of this computer or if you are "
"backing up executable program files."
msgstr ""
"Aviso: os permisos de ficheiros non poden gardarse neste sistema de ficheiros."
" Os permisos de ficheiros só importan se o computador ten máis dunha persoa us"
"uaria ou se está salvagardando ficheiros de programas."

#. +> trunk5
#: kcm/folderselectionmodel.cpp:93
#, kde-kuit-format
msgctxt "@info:tooltip %1 is the path of the folder in a listview"
msgid ""
"<filename>%1</filename><nl/>"
"will be included in the backup, except for unchecked subfolders"
msgstr ""
"<filename>%1</filename><nl/>"
"incluirase na salvagarda, salvo os subcartafoles sen marcar."

#. +> trunk5
#: kcm/folderselectionmodel.cpp:98
#, kde-kuit-format
msgctxt "@info:tooltip %1 is the path of the folder in a listview"
msgid ""
"<filename>%1</filename><nl/>"
"will be included in the backup"
msgstr ""
"<filename>%1</filename><nl/>"
"incluirase na salvagarda."

#. +> trunk5
#: kcm/folderselectionmodel.cpp:103
#, kde-kuit-format
msgctxt "@info:tooltip %1 is the path of the folder in a listview"
msgid ""
"<filename>%1</filename><nl/>"
" will <emphasis>not</emphasis> be included in the backup but contains folders "
"that will"
