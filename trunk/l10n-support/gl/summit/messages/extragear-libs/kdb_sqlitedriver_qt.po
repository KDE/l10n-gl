msgid "Extra paths for SQLite plugins"
msgstr "Rutas adicionais para complementos de SQLite"

#. +> trunk5 stable5
#: SqliteConnection.cpp:273
#, qt-format
msgctxt "SqliteConnection|"
msgid ""
"Could not delete file \"%1\". Check the file's permissions and whether it is"
" already opened and locked by another application."
msgstr ""
"Non foi posíbel eliminar o ficheiro «%1». Comprobe os permisos do ficheiro e"
" asegúrese de que non está aberto e bloqueado por outra aplicación."

#. +> trunk5 stable5
