#. +> trunk5
#: template/index.html:157
msgid "computer discovery: keyboard, mouse, touchscreen ..."
msgstr "descubrimento do computador: teclado, rato, pantalla táctil…"

#. +> trunk5
#: template/index.html:158
msgid "reading: letters, words, reading practice, typing text ..."
