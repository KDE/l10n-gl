#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:38
#, kde-format
msgid "Invalid username/password"
msgstr "O nome de usuario ou o contrasinal son incorrectos"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:40
#, kde-format
msgid "Access forbidden"
msgstr "Denegouse o acceso"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:42
#, kde-format
msgid "Resource not found"
msgstr "Non se atopou o recurso."

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:44
#, kde-format
msgid "HTTP error"
msgstr "Erro de HTTP"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:46
#, kde-format
msgid ""
"There was a problem with the request.\n"
"%1 (%2)."
msgstr ""
"Houbo un problema coa solicitude.\n"
"%1 (%2)."

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:50
#, kde-format
msgid "Protocol for the collection does not support MULTIGET"
msgstr "O protocolo da colección non admite MULTIGET"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:53
#, kde-format
msgid "The server encountered an error that prevented it from completing your request: %1 (%2)"
msgstr "O servidor atopouse cun erro que evitou que realizase a súa solicitude: %1 (%2)"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:56
#, kde-format
msgid ""
"There was a problem with the request. The collection has not been deleted from the server.\n"
"%1 (%2)."
msgstr ""
"Produciuse un problema coa solicitude. A colección non se eliminou do servidor.\n"
"%1 (%2)."

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:60
#, kde-format
msgid "Invalid responses from backend"
msgstr "Responsas incorrectas da infraestrutura"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:63
#, kde-format
msgid "Error setting focus for XQuery"
msgstr "Produciuse un erro ao configurar o foco de XQuery"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:66
#, kde-format
msgid "Invalid XQuery submitted by DAV implementation"
msgstr "A realización de DAV enviou unha XQuery incorrecta"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:69
#, kde-format
msgid ""
"There was a problem with the request. The collection has not been modified on the server.\n"
"%1 (%2)."
msgstr ""
"Houbo un problema coa solicitude. A colección non se modificou no servidor.\n"
"%1 (%2)."

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:73
#, kde-format
msgid "No properties to change or remove"
msgstr "Non hai propiedades que cambiar ou retirar"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:76
#, kde-format
msgid "There was an error when modifying the properties"
msgstr "Produciuse un erro ao modificar as propiedades."

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:78
#, kde-format
msgid ""
"\n"
"The server returned more information:\n"
"%1"
msgstr ""
"\n"
"O servidor devolveu máis información:\n"
"%1"

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:82
#, kde-format
msgid ""
"There was a problem with the request. The item has not been created on the server.\n"
"%1 (%2)."
msgstr ""
"Houbo un problema coa solicitude. O elemento non se creou no servidor.\n"
"%1 (%2)."

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:86
#, kde-format
msgid ""
"There was a problem with the request. The item has not been deleted from the server.\n"
"%1 (%2)."
msgstr ""
"Houbo un problema coa solicitude. O elemento non se eliminou do servidor.\n"
"%1 (%2)."

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:90
#, kde-format
msgid ""
"There was a problem with the request. The item was not modified on the server.\n"
"%1 (%2)."
msgstr ""
"Houbo un problema coa solicitude. O elemento non se modificou no servidor.\n"
"%1 (%2)."

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:95
#, kde-format
msgid "There was a problem with the request."
msgstr "Houbo un problema coa solicitude."

#. +> trunk5 stable5
#: daverror-kdepim-runtime.cpp:99
#, kde-format
msgid "There was a problem with the request. The requested MIME types are not supported."
msgstr "Houbo un problema coa solicitude. O tipos MIME solicitados non son compatíbeis."
