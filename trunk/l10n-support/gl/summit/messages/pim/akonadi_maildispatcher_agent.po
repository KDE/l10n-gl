msgstr "Non se puido obter a interface D-Bus do recurso %1."

#. +> trunk5 stable5
#: sendjob.cpp:124
#, kde-format
msgid "Invalid D-Bus reply from resource %1."
msgstr "A resposta D-Bus do recurso %1 é incorrecta."

#. +> trunk5 stable5
#: sendjob.cpp:244
#, kde-format
msgid "Default sent-mail folder unavailable. Keeping message in outbox."
msgstr "O cartafol de correo enviado predeterminado non está dispoñíbel. A mensaxe gardarase na caixa de saída."

#. +> trunk5 stable5
#: sendjob.cpp:256
#, kde-format
msgid "Message transport aborted."
msgstr "Interrompeuse o transporte das mensaxes."

#. +> trunk5 stable5
#: sendjob.cpp:257
#, kde-format
msgid "Failed to transport message."
msgstr "Non se puido transportar a mensaxe."

#. +> trunk5 stable5
#: sendjob.cpp:299
