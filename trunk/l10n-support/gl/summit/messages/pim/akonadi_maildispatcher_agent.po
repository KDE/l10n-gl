msgstr "Non se puido obter a interface D-Bus do axente de filtro de correo."

#. +> trunk5 stable5
#: sendjob.cpp:306
#, kde-format
msgid "Invalid D-Bus reply from mailfilteragent"
msgstr "A resposta D-Bus do axente de filtro de correo é incorrecta."

#. +> trunk5 stable5
#: sendjob.cpp:349
#, kde-format
msgid "Sending succeeded, but failed to remove the message from the outbox."
msgstr "A mensaxe enviouse correctamente, pero non se puido retirar da caixa de saída."

#. +> trunk5 stable5
#: sendjob.cpp:353
#, kde-format
msgid "Sending succeeded, but failed to move the message to the sent-mail folder."
msgstr "A mensaxe enviouse correctamente, pero non se puido mover ao cartafol de correo enviado."

#. +> trunk5 stable5
#: sendjob.cpp:389
#, kde-format
msgid "Failed to store result in item."
msgstr "Non se puido almacenar o resultado no elemento."

#. +> trunk5 stable5
