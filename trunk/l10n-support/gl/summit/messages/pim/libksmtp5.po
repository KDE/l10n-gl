#. +> trunk5 stable5
#: job.cpp:72
#, kde-format
msgid "Service not available"
msgstr "Servizo non dispoñíbel"

#. +> trunk5 stable5
#: job.cpp:74
#, kde-format
msgid "Mailbox unavailable. The server said: %1"
msgstr "Caixa de correo non dispoñíbel. O servidor dixo: %1"

#. +> trunk5 stable5
#: job.cpp:76
#, kde-format
msgid "Insufficient storage space on server. The server said: %1"
msgstr "Espazo de almacenamento insuficiente no servidor. O servidor dixo: %1"

#. +> trunk5 stable5
#: job.cpp:78
#, kde-format
msgid "Server error: %1"
msgstr "Erro do servidor: %1"

#. +> trunk5 stable5
#: job.cpp:87
#, kde-format
msgid "Connection to server lost."
msgstr "Perdeuse a conexión co servidor."

#. +> trunk5 stable5
#: loginjob.cpp:94
#, kde-format
msgid "Login"
msgstr "Identificación"

#. +> trunk5 stable5
#: loginjob.cpp:159
#, kde-format
msgid "STARTTLS is not supported by the server, try using SSL/TLS instead."
msgstr "O servidor non é compatíbel con STARTTLS, probe a usar SSL/TLS."

#. +> trunk5 stable5
#: loginjob.cpp:223
#, kde-format
msgid "Could not authenticate to the SMTP server because no matching authentication method has been found"
msgstr "Non se puido autenticar co servidor de SMTP porque non se atopou ningún método de autenticación correspondente."

#. +> trunk5 stable5
#: loginjob.cpp:286
#, kde-format
msgid "Token expired"
msgstr "O código caducou"

#. +> trunk5 stable5
#: loginjob.cpp:331
#, kde-format
msgid "Login failed, cannot initialize the SASL library"
msgstr "O acceso fallou, non se pode inicializar a biblioteca SASL."

#. +> trunk5 stable5
#: sendjob.cpp:69
#, kde-format
msgid "SendJob"
msgstr "Tarefa de envío"

#. +> trunk5 stable5
#: sendjob.cpp:118
#, kde-format
msgid "Could not send the message because either the sender or recipient field is missing or invalid"
msgstr "Non se puido enviar a mensaxe porque faltan ou son incorrectos os campos do remitente ou do destinatario."

#. +> trunk5 stable5
#: sendjob.cpp:126
#, kde-format
msgid "Could not send the message because it exceeds the maximum allowed size of %1 bytes. (Message size: %2 bytes.)"
msgstr "Non se puido enviar a mensaxe porque supera o tamaño límite de %1 bytes. O tamaño da mensaxe é de %2 bytes."
