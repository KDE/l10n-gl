#: attachmenthandler.cpp:135
#, kde-format
msgid "The calendar invitation stored in this email message is broken in some way. Unable to continue."
msgstr "O convite de calendario almacenado nesta mensaxe de correo está estragado por algunha causa. Non se pode continuar."

#. +> trunk5 stable5
#: attachmenthandler.cpp:196 attachmenthandler.cpp:254
#, kde-format
msgid "Unable to create a temporary file for the attachment."
msgstr "Non se pode crear un ficheiro temporal para o anexo."

