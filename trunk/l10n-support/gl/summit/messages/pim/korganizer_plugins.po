#. +> trunk5 stable5
#: plugins/picoftheday/configdialog.cpp:69
#, kde-format
msgid "Keep aspect ratio by expanding"
msgstr "Manter a proporción aumentando"

#. +> trunk5 stable5
#: plugins/picoftheday/configdialog.cpp:71
#, kde-format
msgid "The thumbnail will be scaled to a rectangle as small as possible outside a given rectangle, preserving the aspect ratio."
msgstr "A miniatura cambiarase de dimensións ata que ocupe un rectángulo tan pequeno como for posíbel fóra dun rectángulo dado e conservando a proporción."

