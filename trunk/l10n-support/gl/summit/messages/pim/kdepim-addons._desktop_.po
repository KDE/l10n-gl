#. +> trunk5 stable5
#: korganizer/plugins/datenums/datenums.desktop:3
msgctxt "Name"
msgid "Date Numbers Plugin for Calendars"
msgstr "Complemento para os números dos días para os calendarios"

#. +> trunk5 stable5
#: korganizer/plugins/datenums/datenums.desktop:39
msgctxt "Comment"
msgid "For each day this plugin shows its daynumber of the year at the top of the agenda view. For example, February 1 is day 32 of the year."
msgstr "Este complemento mostra o día do ano na vista superior da axenda. Por exemplo, o 1 de febreiro é o día 32 do ano."

#. +> trunk5 stable5
#: korganizer/plugins/hebrew/hebrew.desktop:3
msgctxt "Name"
msgid "Jewish Calendar Plugin"
msgstr "Complemento para o calendario xudeu"

#. +> trunk5 stable5
#: korganizer/plugins/hebrew/hebrew.desktop:39
msgctxt "Comment"
msgid "Shows all dates in KOrganizer also in the Jewish calendar system."
msgstr "Mostra todas as datas en KOrganizer tamén no sistema de calendario xudeu."

#. +> trunk5 stable5
#: korganizer/plugins/lunarphases/lunarphases.desktop:3
msgctxt "Name"
msgid "Lunar Phases Plugin for Calendars"
msgstr "Complemento para as fases lunares para os calendarios"

#. +> trunk5 stable5
#: korganizer/plugins/lunarphases/lunarphases.desktop:26
msgctxt "Comment"
msgid "This plugin shows the day's lunar phase (New, First, Last, Full)"
msgstr "O complemento mostra a fase lunar do día (lúa nova, cuarto crecente, lúa chea, cuarto minguante)."

#. +> trunk5 stable5
#: korganizer/plugins/picoftheday/picoftheday.desktop:3
msgctxt "Name"
msgid "Wikipedia Picture Of the Day Plugin for Calendars"
msgstr "Complemento para a imaxe do día de Wikipedia nos calendarios"

#. +> trunk5 stable5
#: korganizer/plugins/picoftheday/picoftheday.desktop:40
msgctxt "Comment"
msgid "This plugin provides the Wikipedia Picture of the Day"
msgstr "Este complemento fornece a imaxe do día de Wikipedia"

