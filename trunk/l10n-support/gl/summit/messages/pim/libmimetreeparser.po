#. +> trunk5 stable5
#: src/messagepart.cpp:440
#, kde-format
msgctxt "display name for an unnamed attachment"
msgid "Unnamed"
msgstr "Sen nome"

#. +> trunk5 stable5
#: src/messagepart.cpp:716 src/messagepart.cpp:751 src/messagepart.cpp:1076
#, kde-format
msgid "Wrong Crypto Plug-In."
msgstr "O complemento de cifrado é incorrecto."

#. +> trunk5 stable5
#: src/messagepart.cpp:810 src/messagepart.cpp:1287
#, kde-format
msgid "No appropriate crypto plug-in was found."
msgstr "Non se atopou ningún complemento de cifrado axeitado."

#. +> trunk5 stable5
#: src/messagepart.cpp:813
#, kde-format
msgctxt "%1 is either 'OpenPGP' or 'S/MIME'"
msgid "No %1 plug-in was found."
msgstr "Non se atopou o complemento %1."

#. +> trunk5 stable5
#: src/messagepart.cpp:817
#, kde-format
msgid "Crypto plug-in \"%1\" cannot verify signatures."
msgstr "O complemento de cifrado «%1» non pode verificar sinaturas."

#. +> trunk5 stable5
#: src/messagepart.cpp:820
#, kde-format
msgid ""
"The message is signed, but the validity of the signature cannot be verified.<br />"
"Reason: %1"
msgstr ""
"A mensaxe está asinada pero non se pode verificar a validez da sinatura. <br />"
"Razón: %1"

#. +> trunk5 stable5
#: src/messagepart.cpp:1289
#, kde-format
msgid "Crypto plug-in \"%1\" cannot decrypt messages."
msgstr "O complemento de cifrado «%1» non pode descifrar mensaxes."

#. +> trunk5 stable5
#: src/messagepart.cpp:1292
#, kde-format
msgid "Crypto plug-in \"%1\" could not decrypt the data."
msgstr "O complemento de cifrado «%1» non puido descifrar os datos."

#. +> trunk5 stable5
#: src/messagepart.cpp:1294
#, kde-format
msgid "Error: %1"
msgstr "Erro: %1"
