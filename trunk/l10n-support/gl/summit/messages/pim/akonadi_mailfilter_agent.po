msgstr "<b>Estanse a avaliar as regras de filtrado:</b>"

#. +> trunk5 stable5
#: filtermanager.cpp:248
#, kde-format
msgid "<b>Filter rules have matched.</b>"
msgstr "<b>As regras de filtrado atoparon coincidencias.</b>"

