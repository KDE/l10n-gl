#. Activity title
#. +> trunk5 stable5
#: activities/planegame/ActivityInfo.qml:15
msgctxt "ActivityInfo|"
msgid "Numbers in order"
msgstr "Números en orde"

#. Help title
#. +> trunk5 stable5
#: activities/planegame/ActivityInfo.qml:17
msgctxt "ActivityInfo|"
msgid "Move the helicopter to catch the clouds in the correct order."
msgstr "Move o helicóptero para capturar nubes na orde correcta."

#. Help manual
#. +> trunk5 stable5
#: activities/planegame/ActivityInfo.qml:23
msgctxt "ActivityInfo|"
msgid "Catch the clouds in increasing order. With a keyboard, use the arrow keys to move the helicopter. With a pointing device, just click or tap on the target location. To know which number you have to catch you can either remember it or check the number on the bottom right corner."
msgstr "Colle as nubes en orde ascendente. Co teclado, usa as teclas de frecha para mover o helicóptero. Cun dispositivo de punteiro, preme ou toca o lugar de destino. Para saber que número tes que coller, tes que lembralo ou comprobar o número na esquina inferior dereita."

#. +> trunk5 stable5
#: activities/play_piano/ActivityConfig.qml:34
msgctxt "ActivityConfig|"
msgid "Display colored notes."
msgstr "Amosar notas coloradas."

#. +> trunk5 stable5
#: activities/play_piano/ActivityConfig.qml:46
msgctxt "ActivityConfig|"
msgid "Display colorless notes."
msgstr "Amosar notas sen cores."

#. Activity title
#. +> trunk5 stable5
#: activities/play_piano/ActivityInfo.qml:19
msgctxt "ActivityInfo|"
msgid "Play piano"
msgstr "Tocar o piano"

#. Help goal
#. +> trunk5 stable5
#: activities/play_piano/ActivityInfo.qml:23
msgctxt "ActivityInfo|"
msgid "Understand how the piano keyboard can play music as written on the musical staff."
msgstr "Entende como o teclado do piano pode tocar música como se escribe no pentagrama musical."

#. Help prerequisite
#. +> trunk5 stable5
#: activities/play_piano/ActivityInfo.qml:25
msgctxt "ActivityInfo|"
msgid "Knowledge of musical notation and musical staff."
msgstr "Coñecementos de notación musical e pentagrama musical."

#. Help manual
#. +> trunk5 stable5
#: activities/play_piano/ActivityInfo.qml:27
msgctxt "ActivityInfo|"
msgid "Some notes are played on the staff. Click on the keyboard keys matching the notes on the staff."
msgstr "Unhas notas reprodúcense no pentagrama. Preme as teclas correspondentes ás notas do pentagrama."

#. +> trunk5 stable5
#: activities/play_piano/ActivityInfo.qml:28
msgctxt "ActivityInfo|"
msgid "On levels 1 to 5 you will practice treble clef notes and on levels 6 to 10 you will practice bass clef notes."
msgstr "Nos niveis do 1 ao 5 practicarás coa clave de sol e nos niveis do 6 ao 10 practicarás coa clave de fa."

#. +> trunk5 stable5
#: activities/play_piano/ActivityInfo.qml:33
msgctxt "ActivityInfo|"
msgid "Backspace or Delete: undo"
msgstr "Borrar ou Suprimir: desfacer"

#. +> trunk5 stable5
#: activities/play_piano/PlayPiano.qml:187
msgctxt "PlayPiano|"
msgid "Click on the piano keys that match the given notes."
msgstr "Preme as teclas de piano que correspondan ás notas indicadas."

#. +> trunk5 stable5
#: activities/play_piano/PlayPiano.qml:300
msgctxt "PlayPiano|"
msgid "This activity requires sound, so it will play some sounds even if the audio voices or effects are disabled in the main configuration."
msgstr "Esta actividade precisa de son, polo que as voces soarán inda que desactivaras os efectos de son e as voces na configuración principal."

#. +> trunk5 stable5
#: activities/play_piano/PlayPiano.qml:301
msgctxt "PlayPiano|"
msgid "Quit"
msgstr "Saír?"

#. +> trunk5 stable5
#: activities/play_piano/PlayPiano.qml:302
msgctxt "PlayPiano|"
msgid "Continue"
msgstr "Continuar"

#. Activity title
#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:19
msgctxt "ActivityInfo|"
msgid "Play rhythm"
msgstr "Reproducir o ritmo"

#. Help goal
#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:23
msgctxt "ActivityInfo|"
msgid "Learn to follow a rhythm accurately."
msgstr "Aprende a seguir un ritmo con precisión."

#. Help prerequisite
#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:25
msgctxt "ActivityInfo|"
msgid "Simple understanding of musical rhythm."
msgstr "Comprensión básica de ritmo musical."

#. Help manual
#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:27
msgctxt "ActivityInfo|"
msgid "Listen to the rhythm played. When you're ready, click on the drum following the same rhythm. If you clicked at correct times, another rhythm is played. If not, you must try again."
msgstr "Escoita o ritmo que se reproduce. Prepárate, e reproduce o ritmo premendo o tambor. Se o fas correctamente, reproducirase outro ritmo. Senón, deberás intentalo de novo."

#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:28
msgctxt "ActivityInfo|"
msgid "Odd levels display a vertical line on the staff following the rhythm: click on the drum when the line is in the middle of the notes."
msgstr "Os niveis impares amosan unha liña vertical no pentagrama que segue o ritmo: preme o tambor cando a liña estea en medio das notas."

#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:29
msgctxt "ActivityInfo|"
msgid "Even levels are harder, because there is no vertical line. You must read the notes length and play the rhythm accordingly. You can also click on the metronome to hear the quarter notes as reference."
msgstr "Os niveis pares son máis difíciles, porque non hai liña vertical. Tes que ter en conta a duración das notas ao reproducir o ritmo. Tamén podes premer o metrónomo para escoitar unha negra como referencia."

#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:30
msgctxt "ActivityInfo|"
msgid "Click on the reload button if you want to replay the rhythm."
msgstr "Preme o botón de recargar se queres reproducir de novo o ritmo."

#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:32
msgctxt "ActivityInfo|"
msgid "Space bar: click on the drum"
msgstr "Espazador: premer o tambor"

#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:33
msgctxt "ActivityInfo|"
msgid "Enter or Return: replay the rhythm"
msgstr "Intro: reproducir de novo o ritmo"

#. +> trunk5 stable5
#: activities/play_rhythm/ActivityInfo.qml:34
msgctxt "ActivityInfo|"
msgid "Up and Down: increase or decrease the tempo"
msgstr "Arriba e abaixo: aumenta ou diminúe o tempo"

#. +> trunk5 stable5
