#. Activity title
#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:16
msgctxt "ActivityInfo|"
msgid "Programming maze"
msgstr "Labirinto de programación"

#. Help title
#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:18
msgctxt "ActivityInfo|"
msgid "This activity teaches to program Tux to reach its goal using simple instructions like move forward, turn left or right."
msgstr "Esta actividade ensina a programar a Tux para acadar o obxectivo con instrucións sinxelas como mover adiante, xirar á esquerda ou xirar á dereita."

#. Help goal
#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:21
msgctxt "ActivityInfo|"
msgid "Tux is hungry. Help him find fish by programming him to the correct ice spot."
msgstr "Tux está famento. Axúdalle a atopar peixes programándoo ata o bloque de xeo correcto."

#. Help prerequisite
#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:23
msgctxt "ActivityInfo|"
msgid "Can read instructions, and think logically to find a path."
msgstr "Podes ler instrucións, e pensar de maneira lóxica como atopar un camiño."

#. Help manual
#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:25
msgctxt "ActivityInfo|"
msgid "Choose the instructions from the menu, and arrange them in order to lead Tux to his goal."
msgstr "Escolle as instrucións do menú, e colócalas en orde para levar a Tux ao obxectivo."

#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:27
msgctxt "ActivityInfo|"
msgid "Left and Right arrows: navigate inside selected area"
msgstr "Frechas esquerda e dereita: navegar dentro da zona seleccionada."

#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:28
msgctxt "ActivityInfo|"
msgid "Up and Down arrows: increase or decrease the loop counter if the loop area is selected"
msgstr "Frechas de arriba e abaixo: aumentar ou diminuír o contador de bucles se se selecciona a zona do bucle."

#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:29
msgctxt "ActivityInfo|"
msgid "Space: select an instruction or append selected instruction in main/procedure/loop area"
msgstr "Espazo: seleccionar unha instrución ou engadir a instrución seleccionada á zona principal, de procedemento ou de bucle."

#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:30
msgctxt "ActivityInfo|"
msgid "Tab: switch between instructions area and main/procedure/loop area"
msgstr "Tab: cambiar entre a zona de instrucións e a zona principal, de procedemento ou de bucle."

#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:31
msgctxt "ActivityInfo|"
msgid "Delete: remove selected instruction from main/procedure/loop area"
msgstr "Suprimir: retirar a instrución seleccionada da zona principal, de procedemento ou de bucle."

#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:32
msgctxt "ActivityInfo|"
msgid "Enter: run the code or reset Tux when it fails to reach the fish"
msgstr "Intro: executar o código ou restabelecer a Tux cando non consegue chegar ata o peixe."

#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:33
msgctxt "ActivityInfo|"
msgid "To add an instruction in main/procedure/loop area, select it from instructions area, then switch to the main/procedure/loop area and press Space."
msgstr "Para engadir unha instrución na zona principal, de procedemento ou de bucle, selecciónaa na zona de instrucións, cambia á zona principal, de procedemento ou de bucle e preme Espazo."

#. +> trunk5 stable5
#: activities/programmingMaze/ActivityInfo.qml:34
msgctxt "ActivityInfo|"
msgid "To modify an instruction in main/procedure/loop area, select it from main/procedure/loop area, then switch to instructions area, choose the new instruction and press Space."
msgstr "Para modificar unha instrución na zona principal, de procedemento ou de bucle, selecciónaa na zona principal, de procedemento ou de bucle, cambia á zona de instrucións, escolle a nova instrución e preme Espazo."

#. +> trunk5 stable5
#: activities/programmingMaze/InstructionArea.qml:27
msgctxt "InstructionArea|"
msgid "Choose the instructions"
msgstr "Escolle as instrucións"

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:96
msgctxt "programmingMaze|"
msgid "Instruction Area:"
msgstr "Zona de instrucións:"

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:97
msgctxt "programmingMaze|"
msgid "There are 3 instructions which you can use to code and lead Tux to the fish:"
msgstr "Hai 3 instrucións que podes usar para codificar e levar a Tux onde o peixe:"

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:98
msgctxt "programmingMaze|"
msgid "<b>1. Move forward:</b> Moves Tux one step forward in the direction it is facing."
msgstr "<b>1. Avanzar:</b> Move a Tux un paso cada adiante na dirección cara a que mira."

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:99
msgctxt "programmingMaze|"
msgid "<b>2. Turn left:</b> Turns Tux to the left."
msgstr "<b>2. Xirar á esquerda:</b> Xira a Tux cara á esquerda."

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:100
msgctxt "programmingMaze|"
msgid "<b>3. Turn right:</b> Turns Tux to the right."
msgstr "<b>3. Xirar á dereita:</b> Xira a Tux á dereita."

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:104
msgctxt "programmingMaze|"
msgid "Main Function:"
msgstr "Función principal:"

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:105
msgctxt "programmingMaze|"
msgid "The execution of the code starts here."
msgstr "A execución do código comeza aquí."

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:106
msgctxt "programmingMaze|"
msgid "-Click on any instruction in the <b>instruction area</b> to add it to the <b>Main Function</b>."
msgstr "-Preme unha instrución na <b>zona de instrucións</b> para engadila á <b>función principal</b>."

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:107
msgctxt "programmingMaze|"
msgid "-The instructions will execute in order until there's none left, or until a dead-end, or when Tux reaches the fish."
msgstr "-As instrucións executaranse en orde ata que non quede ningunha, ou ata chegar a un punto sen fin, ou cando Tux acada o peixe."

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:114
msgctxt "programmingMaze|"
msgid "Procedure:"
msgstr "Procedemento:"

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:115
msgctxt "programmingMaze|"
msgid "<b>Procedure</b> is a reusable set of instructions which can be <b>used in the code by calling it where needed</b>."
msgstr "Un <b>procedemento</b> é un conxunto reutilizábel de instrucións que poden <b>usarse no código chamándoas onde sexa necesario</b>."

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:116
msgctxt "programmingMaze|"
msgid "-To <b>switch</b> between the <b>Procedure area</b> and the <b>Main Function area</b> to add your code, click on the <b>Procedure</b> or <b>Main Function</b> label."
msgstr "-Preme a etiqueta de <b>procedemento</b> ou de <b>función principal</b> para <b>cambiar</b> entre a <b>zona de procedemento</b> e a <b>zona de función principal</b> para engadir código."

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:123
msgctxt "programmingMaze|"
msgid "Loop:"
msgstr "Bucle:"

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:124
msgctxt "programmingMaze|"
msgid "<b>Loop</b> is a sequence of instructions that is <b>continually repeated the number of times defined by the number inside it</b>."
msgstr "Un <b>bucle</b> é unha secuencia de instrucións que se <b>repiten continuamente o número de veces indicado no número que teñen dentro</b>."

#. +> trunk5 stable5
#: activities/programmingMaze/programmingMaze.js:125
msgctxt "programmingMaze|"
msgid "-To <b>switch</b> between the <b>Loop area</b> and the <b>Main Function area</b> to add your code, click on the <b>Loop</b> or <b>Main Function</b> label."
msgstr "-Preme a etiqueta de <b>bucle</b> ou de <b>función principal</b> para <b>cambiar</b> entre a <b>zona de bucle</b> e a <b>zona de función principal</b> para engadir código."

#. +> trunk5 stable5
#: activities/programmingMaze/ProgrammingMaze.qml:198
#, qt-format
msgctxt "ProgrammingMaze|"
msgid "Reach the fish in less than %1 instructions."
msgstr "Acadar o peixe en menos de %1 instrucións."

#. +> trunk5 stable5
#: activities/programmingMaze/ProgrammingMaze.qml:262
msgctxt "ProgrammingMaze|"
msgid "Main function"
msgstr "Función principal"

#. +> trunk5 stable5
#: activities/programmingMaze/ProgrammingMaze.qml:290
msgctxt "ProgrammingMaze|"
msgid "Procedure"
msgstr "Procedemento"

#. +> trunk5 stable5
#: activities/programmingMaze/ProgrammingMaze.qml:290
msgctxt "ProgrammingMaze|"
msgid "Loop"
msgstr "Bucle"

#. +> trunk5 stable5
#: activities/programmingMaze/resource/1/Data.qml:14
msgctxt "Data|"
msgid "Using the main area only."
msgstr "Usando só a zona principal."

#. +> trunk5 stable5
#: activities/programmingMaze/resource/2/Data.qml:14
msgctxt "Data|"
msgid "Using both the main area and the procedure area."
msgstr "Usando tanto a zona principal como a zona de procedemento."

#. +> trunk5 stable5
#: activities/programmingMaze/resource/3/Data.qml:14
msgctxt "Data|"
msgid "Using both the main area and the loop area."
msgstr "Usando tanto a zona principal como a zona de bucle."

#. Activity title
