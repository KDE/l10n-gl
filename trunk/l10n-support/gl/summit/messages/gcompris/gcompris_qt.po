#. Activity title
#. +> trunk5 stable5
#: activities/scalesboard_weight/ActivityInfo.qml:15
msgctxt "ActivityInfo|"
msgid "Balance using the International System of Units"
msgstr "Equilibrio co sistema internacional de unidades"

#. Help title
#. +> trunk5 stable5
#: activities/scalesboard_weight/ActivityInfo.qml:17
#: activities/scalesboard_weight_avoirdupois/ActivityInfo.qml:17
msgctxt "ActivityInfo|"
msgid "Drag and Drop some masses to balance the scales and calculate the weight."
msgstr "Arrastra e solta pesos para que equilibren as balanzas e calcular o peso."

#. Help goal
#. +> trunk5 stable5
#: activities/scalesboard_weight/ActivityInfo.qml:20
#: activities/scalesboard_weight_avoirdupois/ActivityInfo.qml:20
msgctxt "ActivityInfo|"
msgid "Mental calculation, arithmetic equality, unit conversion."
msgstr "Cálculo mental, igualdade aritmética, conversión de unidades."

#. Help manual
#. +> trunk5 stable5
#: activities/scalesboard_weight/ActivityInfo.qml:23
msgctxt "ActivityInfo|"
msgid "To balance the scales, move some masses to the left or the right side (on higher levels). They can be arranged in any order. Take care of the weight and the unit of the masses, remember that a kilogram (kg) is 1000 grams (g)."
msgstr "Para equilibrar a balanza move pesos á dereita ou á esquerda (en niveis máis superiores). Os pesos poden colocarse en calquera orde. Coida do peso e a unidade dos pesos, lembra que un quilogramo (kg) ten 1000 gramos (g)."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/1/Data.qml:13
msgctxt "Data|"
msgid "Balance up to 5 grams."
msgstr "Equilibrio ata 5 gramos."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/1/Data.qml:18
#: activities/scalesboard_weight/resource/2/Data.qml:18
#: activities/scalesboard_weight/resource/3/Data.qml:18
#: activities/scalesboard_weight/resource/5/Data.qml:18
#: activities/scalesboard_weight/resource/6/Data.qml:18
#, qt-format
msgctxt "Data|"
msgid "%1 g"
msgstr "%1 g"

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/1/Data.qml:26
msgctxt "Data|"
msgid "The \"g\" symbol at the end of a number means gram."
msgstr "O símbolo «g» ao final dun número significa «gramo»."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/1/Data.qml:32
msgctxt "Data|"
msgid "Take care, you can drop weights on both sides of the scale."
msgstr "Coidado, podes botar os pesos en ambos os lados da balanza."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/1/Data.qml:39
#, qt-format
msgctxt "Data|"
msgid "Enter the weight of the gift in grams: %1"
msgstr "Insire o peso do agasallo en gramos: %1"

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/2/Data.qml:13
msgctxt "Data|"
msgid "Balance up to 10 grams."
msgstr "Equilibrio ata 10 gramos."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/2/Data.qml:26
#: activities/scalesboard_weight/resource/3/Data.qml:26
#: activities/scalesboard_weight/resource/5/Data.qml:25
msgctxt "Data|"
msgid ""
"The \"g\" symbol at the end of a number means gram. \n"
" Drop weights on the left side to balance the scales."
msgstr ""
"O símbolo «g» ao final dun número significa «gramo».\n"
"Solta pesos na esquerda para equilibrar as balanzas."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/2/Data.qml:45
#: activities/scalesboard_weight/resource/2/Data.qml:52
