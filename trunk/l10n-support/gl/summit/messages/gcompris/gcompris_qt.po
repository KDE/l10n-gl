#: activities/railroad/ActivityInfo.qml:17
msgctxt "ActivityInfo|"
msgid "Railroad activity"
msgstr "Actividade de vía férrea"

#. Help title
#. +> trunk5 stable5
#: activities/railroad/ActivityInfo.qml:19
msgctxt "ActivityInfo|"
msgid "Rebuild the train model at the top of the screen."
msgstr "Reconstrúe a maqueta de tren da parte superior da pantalla."

#. Help goal
#. +> trunk5 stable5
#: activities/railroad/ActivityInfo.qml:22
msgctxt "ActivityInfo|"
msgid "Memory training."
msgstr "Adestramento de memoria."

#. Help manual
#. +> trunk5 stable5
#: activities/railroad/ActivityInfo.qml:25
msgctxt "ActivityInfo|"
msgid "A train is displayed for a few seconds. Rebuild it at the top of the screen by dragging the appropriate items. Remove an item from the answer area by dragging it down."
msgstr "Amósase un tren durante uns segundos. Reconstrúeo na parte superior da pantalla arrastrando os elementos axeitados. Para retirar un elemento da zona da resposta arrástrao cara abaixo."

#. +> trunk5 stable5
#: activities/railroad/ActivityInfo.qml:26
msgctxt "ActivityInfo|"
msgid "<b>Keyboard Controls:</b>"
msgstr "<b>Controis de teclado:</b>"

#. +> trunk5 stable5
#: activities/railroad/ActivityInfo.qml:27
msgctxt "ActivityInfo|"
msgid "Arrows: navigate in the sample area and in the answer area"
msgstr "Frechas: navegar na zona de mostras e na de resposta."

#. +> trunk5 stable5
#: activities/railroad/ActivityInfo.qml:28
msgctxt "ActivityInfo|"
msgid "Space: add an item from the samples to the answer area, or swap two items in the answer area"
msgstr "Espazo: engadir un elemento das mostras á zona da resposta, ou intercambiar dous elementos na zona da resposta."

#. +> trunk5 stable5
#: activities/railroad/ActivityInfo.qml:29
msgctxt "ActivityInfo|"
msgid "Delete or Backspace: remove the selected item from the answer area"
msgstr "Suprimir ou Retroceso: retirar o elemento seleccionado da zona da resposta."

#. +> trunk5 stable5
#: activities/railroad/ActivityInfo.qml:30
msgctxt "ActivityInfo|"
msgid "Enter or Return: submit your answer"
msgstr "Intro: entregar a resposta."

#. +> trunk5 stable5
#: activities/railroad/Railroad.qml:108
msgctxt "Railroad|"
msgid "Observe and remember the train before the timer ends and then drag the items to set up a similar train."
msgstr "Observa e lembra o tren antes de que remate o temporizador e a continuación arrastra os elementos para preparar un tren similar."

#. +> trunk5 stable5
#: activities/railroad/Railroad.qml:109
msgctxt "Railroad|"
msgid "If you forgot the model, you can click on the Hint button to view it again."
msgstr "Se esqueces a maqueta podes premer o botón de consello para vela de novo."

