#. Help title
#. +> trunk5 stable5
#: activities/find_the_day/ActivityInfo.qml:17
msgctxt "ActivityInfo|"
msgid "Find the correct date and select it on the calendar."
msgstr "Atopa a data correcta e selecciónaa no calendario."

#. Help goal
#. +> trunk5 stable5
#: activities/find_the_day/ActivityInfo.qml:20
msgctxt "ActivityInfo|"
msgid "Learn how to count days and find a date on a calendar."
msgstr "Aprende a contar os días e atopa a data no calendario."

#. Help prerequisite
#. +> trunk5 stable5
#: activities/find_the_day/ActivityInfo.qml:22
msgctxt "ActivityInfo|"
msgid "Basics of calendar."
msgstr "Fundamentos de calendario."

#. Help manual
#. +> trunk5 stable5
#: activities/find_the_day/ActivityInfo.qml:24
msgctxt "ActivityInfo|"
msgid "Read the instructions and perform the requested calculation to find the date. Then select this date on the calendar, and validate your answer by clicking on the OK button."
msgstr "Le as instrucións e realiza o cálculo solicitado para atopar a data. A continuación selecciona a data no calendario e preme o botón de aceptar para validar a túa resposta."

#. +> trunk5 stable5
#: activities/find_the_day/find_the_day_dataset.js:35
msgctxt "find_the_day_dataset|"
msgid "Find the date 13 days after May 3rd."
msgstr "Atopa a data 13 días despois do 3 de maio."

#. +> trunk5 stable5
#: activities/find_the_day/find_the_day_dataset.js:39
msgctxt "find_the_day_dataset|"
msgid "Find the date 7 days after October 1st."
msgstr "Atopa a data 7 días despois do 1 de outubro."

#. +> trunk5 stable5
#: activities/find_the_day/find_the_day_dataset.js:43
msgctxt "find_the_day_dataset|"
