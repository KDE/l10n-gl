#: activities/piano_composition/ActivityInfo.qml:16
msgctxt "ActivityInfo|"
msgid "Piano composition"
msgstr "Composición de piano"

#. Help title
#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:18
msgctxt "ActivityInfo|"
msgid "Learn how the piano keyboard works, and how notes are written on a musical staff."
msgstr "Aprender como funciona o teclado do piano, e como se escriben as notas nun pentagrama."

#. Help goal
#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:21
msgctxt "ActivityInfo|"
msgid "Develop an understanding of music composition, and increase interest in making music with a piano keyboard. This activity covers many fundamental aspects of music, but there is much more to explore about music composition. If you enjoy this activity but want a more advanced tool, try downloading Minuet (https://minuet.kde.org/), an open source software for music education or MuseScore (https://musescore.org), an open source music notation tool."
msgstr "Desenvolver un coñecemento sobre composición musical e aumenta o interese en compoñer música cun teclado de piano. Esta actividade cubre moitos aspectos fundamentais da música, pero hai moito máis para explorar sobre composición musical. Se gozas desta actividade pero queres unha ferramenta máis avanzada proba a descargar Minuet (https://minuet.kde.org/), un software libre de educación musical, ou MuseScore (https://musescore.org), unha ferramenta libre de notación musical."

#. Help prerequisite
#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:23
msgctxt "ActivityInfo|"
msgid "Familiarity with note naming conventions."
msgstr "Familiaridade con convencións de nome de notas."

#. Help manual
#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:25
msgctxt "ActivityInfo|"
msgid "This activity has several levels, each level adding a new functionality to the previous one."
msgstr "A actividade ten varios niveis, e cada un engade unha nova funcionalidade ao anterior."

#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:26
msgctxt "ActivityInfo|"
msgid "Level 1: Basic piano keyboard (white keys only) where users can experiment with clicking the colored rectangle keys to write music."
msgstr "Nivel 1: teclado básico de piano (só con teclas brancas) no que experimentar premendo as teclas rectangulares coloradas para escribir música."

#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:27
msgctxt "ActivityInfo|"
msgid "Level 2: The musical staff switches to bass clef, so notes are lower than in previous level."
msgstr "Nivel 2: O pentagrama cambia a clave de fa, así que as notas están máis abaixo que no nivel anterior."

#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:28
msgctxt "ActivityInfo|"
msgid "Level 3: Option to choose between treble and bass clef, addition of black keys (sharp keys)."
msgstr "Nivel 3: Podes escoller entre clave de sol ou clave de fa, e engádense as teclas negras (sostidas)."

#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:29
msgctxt "ActivityInfo|"
msgid "Level 4: Flat notation used for black keys."
msgstr "Nivel 4: Úsase unha notación plana para as teclas negras."

#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:30
msgctxt "ActivityInfo|"
msgid "Level 5: Option to select a note duration (whole, half, quarter, eighth notes)."
msgstr "Nivel 5: Podes seleccionar a duración dunha nota (redonda, branca, negra, corchea)."

#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:31
msgctxt "ActivityInfo|"
msgid "Level 6: Addition of rests (whole, half, quarter, eighth rests)."
msgstr "Nivel 6: Engádense silencios (redonda, branca, negra, corchea)."

#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:32
msgctxt "ActivityInfo|"
msgid "Level 7: Save your compositions and load pre-defined or saved melodies."
msgstr "Nivel 7: Garda as composicións e carga melodías predefinidas ou gardadas."

#. +> trunk5 stable5
#: activities/piano_composition/ActivityInfo.qml:34
#: activities/play_piano/ActivityInfo.qml:31
