msgctxt "ActivityInfo|"
msgid "Compare numbers"
msgstr "Comparar números"

#. Help title
#. +> trunk5 stable5
#: activities/comparator/ActivityInfo.qml:19
msgctxt "ActivityInfo|"
msgid "Compare the numbers and choose the corresponding sign."
msgstr "Compara os números e escolle o signo axeitado."

#. Help goal
#. +> trunk5 stable5
#: activities/comparator/ActivityInfo.qml:22
msgctxt "ActivityInfo|"
msgid "Learn how to compare number values."
msgstr "Aprende a comparar valores numéricos."

#. Help manual
#. +> trunk5 stable5
#: activities/comparator/ActivityInfo.qml:25
msgctxt "ActivityInfo|"
msgid "Select a pair of numbers in the list. Then select the correct comparison symbol for this pair. When each line contains a symbol, select the OK button to validate the answers."
msgstr "Escolle un par de números da lista. Despois escolle o símbolo de comparación axeitado para eses dous valores. Cando remates con todas as liñas preme o botón «Aceptar»."

#. +> trunk5 stable5
#: activities/comparator/ActivityInfo.qml:26
msgctxt "ActivityInfo|"
msgid "If some answers are incorrect, a cross icon will appear on the corresponding lines. Correct the errors, then select the OK button again."
msgstr "Aparecerá unha cruz nas liñas con fallos. Corrixe os erros e volve a premer en «Aceptar»."

#. +> trunk5 stable5
#: activities/comparator/ActivityInfo.qml:28
msgctxt "ActivityInfo|"
msgid "Up and Down arrows: select a pair of numbers in the list"
msgstr "Frechas arriba e abaixo: Escolle un par de números da lista"

#. +> trunk5 stable5
#: activities/comparator/ActivityInfo.qml:29
msgctxt "ActivityInfo|"
msgid "Left and Right arrows: select a symbol button"
msgstr "Frechas dereita e esquerda: escolle un símbolo"

