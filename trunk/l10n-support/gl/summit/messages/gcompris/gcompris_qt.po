#, qt-format
msgctxt "Data|"
msgid "Enter the weight of the gift in gram: %1"
msgstr "Insire o peso do agasallo en gramos: %1"

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/3/Data.qml:13
msgctxt "Data|"
msgid "Balance up to 20 grams."
msgstr "Equilibrio ata 20 gramos."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/4/Data.qml:13
msgctxt "Data|"
msgid "Balance up to 10 kilograms."
msgstr "Equilibrio ata 10 quilogramos."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/4/Data.qml:18
#: activities/scalesboard_weight/resource/6/Data.qml:23
#, qt-format
msgctxt "Data|"
msgid "%1 kg"
msgstr "%1 kg"

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/4/Data.qml:26
msgctxt "Data|"
msgid "The \"kg\" symbol at the end of a number means kilogram."
msgstr "O símbolo «kg» ao final dun número significa «quilogramo»."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/4/Data.qml:27
msgctxt "Data|"
msgid ""
"The kilogram is a unit of mass, a property which corresponds to the common perception of how \"heavy\" an object is. \n"
" Drop weights on the left side to balance the scales."
msgstr ""
"O quilogramo é unha unidade de masa, unha propiedade que se corresponde coa percepción común de como de «pesado» é un obxecto.\n"
"Solta pesos na esquerda para equilibrar as balanzas."

#. +> trunk5 stable5
#: activities/scalesboard_weight/resource/4/Data.qml:80
#: activities/scalesboard_weight/resource/4/Data.qml:87
#: activities/scalesboard_weight/resource/4/Data.qml:94
