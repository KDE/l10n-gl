msgid "Braille fun"
msgstr "Diversión con braille"

#. Help title
#. +> trunk5 stable5
#: activities/braille_fun/ActivityInfo.qml:17
msgctxt "ActivityInfo|"
msgid "Practice braille letters."
msgstr "Representa as letras con braille."

#. Help prerequisite
#. +> trunk5 stable5
#: activities/braille_fun/ActivityInfo.qml:21
msgctxt "ActivityInfo|"
msgid "Braille alphabet."
msgstr "Alfabeto braille."

#. Help manual
#. +> trunk5 stable5
