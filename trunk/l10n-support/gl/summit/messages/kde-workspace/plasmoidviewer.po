#. +> trunk5 stable5
#: main.cpp:52
#, kde-format
msgid "Plasmoidviewer"
msgstr "Visor de plasmoides"

#. +> trunk5 stable5 plasma5lts
#: main.cpp:59
#, kde-format
msgid "Run Plasma widgets in their own window"
msgstr "Executa trebellos de Plasma nunha xanela de seu"

#. +> trunk5 stable5 plasma5lts
#: main.cpp:64
#, kde-format
msgid "The name of the containment plugin"
msgstr "O nome do complemento contedor."

#. +> trunk5 stable5 plasma5lts
#: main.cpp:66
#, kde-format
msgid "The name of the applet plugin"
msgstr "O nome do complemento do miniaplicativo."

#. +> trunk5 stable5 plasma5lts
#: main.cpp:68
#, kde-format
msgid ""
"The formfactor to use (horizontal, vertical, mediacenter, planar or"
" application)"
msgstr ""
"O factor de forma para usar (horizontal, vertical, de centro de medios,"
" planar ou de aplicación)."

# skip-rule: PT-2012-dual_border(2)
#. +> trunk5 stable5 plasma5lts
#: main.cpp:70
#, kde-format
msgid ""
"The location constraint to start the Containment with (floating, desktop,"
" fullscreen, topedge, bottomedge, leftedge, rightedge)"
msgstr ""
"A restrición de posición coa que iniciar o contedor (flotante, de escritorio,"
" a pantalla completa, bordo superior, bordo inferior, bordo esquerdo, ou"
" bordo dereito)."

#. +> trunk5 stable5 plasma5lts
#: main.cpp:74
#, kde-format
msgid "Set the x position of the plasmoidviewer on the Plasma desktop"
msgstr ""
"Definir a posición horizontal (X) do visor de plasmoides no escritorio Plasma."

#. +> trunk5 stable5 plasma5lts
#: main.cpp:77
#, kde-format
msgid "Set the y position of the plasmoidviewer on the Plasma desktop"
msgstr ""
"Definir a posición vertical (Y) do visor de plasmoides no escritorio Plasma."

#. +> trunk5 stable5 plasma5lts
#: main.cpp:80
#, kde-format
msgid "Set the window size of the plasmoidview"
msgstr "Definir o tamaño da xanela do visor de plasmoides."

#. +> trunk5 stable5 plasma5lts
#: main.cpp:83
#, kde-format
msgid "The size in kB to set the pixmap cache to"
msgstr "O tamaño en kB para asignarlle á caché do mapa de píxeles."

#. +> trunk5 stable5 plasma5lts
#: main.cpp:86
#, kde-format
msgid "The name of the theme which the shell will use"
msgstr "O nome do tema que usar na shell."

#. +> trunk5 stable5 plasma5lts
#: main.cpp:89
#, kde-format
msgid "Data that should be passed to the applet as 'externalData' event"
msgstr ""
"Data que debería pasarse ao miniaplicativo como o evento «externalData»."

#. +> trunk5 stable5 plasma5lts
#: view.cpp:132
#, kde-format, no-c-format
msgid "Applet %1 does not exist."
msgstr "O miniaplicativo %1 non existe."

#. +> trunk5 stable5 plasma5lts
#: view.cpp:149
#, kde-format, no-c-format
msgid "Containment %1 does not exist."
msgstr "O contedor %1 non existe."

