#. +> plasma5lts
#: devicewrapper.cpp:144 devicewrapper.cpp:160
#, kde-format
msgid "Eject medium"
msgstr "Expulsar o medio"

#. +> plasma5lts
#: devicewrapper.cpp:148
#, kde-format
msgid "Mount the device"
msgstr "Montar o dispositivo"

#. +> plasma5lts
#: devicewrapper.cpp:150
#, kde-format
msgid "Unmount the device"
msgstr "Desmontar o dispositivo"

#. +> plasma5lts
#: devicewrapper.cpp:154
#, kde-format
msgctxt "Unlock the encrypted container; will ask for a password; partitions inside will appear as they had been plugged in"
msgid "Unlock the container"
msgstr "Desatrancar o contedor"

#. +> plasma5lts
#: devicewrapper.cpp:156
#, kde-format
msgctxt "Close the encrypted container; partitions inside will disappear as they had been unplugged"
msgid "Lock the container"
msgstr "Trancar o contedor"

#. +> plasma5lts
#: solidrunner.cpp:47
#, kde-format
msgid "Finds devices whose name match :q:"
msgstr "Atopa dispositivos que teñan un nome que case con :q:"

#. +> plasma5lts
#: solidrunner.cpp:49 solidrunner.cpp:137
#, kde-format
msgctxt "Note this is a KRunner keyword"
msgid "device"
msgstr "dispositivo"

#. +> plasma5lts
#: solidrunner.cpp:50
#, kde-format
msgid "Lists all devices and allows them to be mounted, unmounted or ejected."
msgstr "Lista todos os dispositivos e permite montalos, desmontalos ou expulsalos."

#. +> plasma5lts
#: solidrunner.cpp:51 solidrunner.cpp:143
#, kde-format
msgctxt "Note this is a KRunner keyword"
msgid "mount"
msgstr "montar"

#. +> plasma5lts
#: solidrunner.cpp:52
#, kde-format
msgid "Lists all devices which can be mounted, and allows them to be mounted."
msgstr "Lista todos os dispositivos que se poidan montar, e permite desmontalos."

#. +> plasma5lts
#: solidrunner.cpp:53 solidrunner.cpp:156
#, kde-format
msgctxt "Note this is a KRunner keyword"
msgid "unlock"
msgstr "desbloquear"

#. +> plasma5lts
#: solidrunner.cpp:54
#, kde-format
msgid "Lists all encrypted devices which can be unlocked, and allows them to be unlocked."
msgstr "Lista todos os dispositivos cifrados que se poidan desbloquear e permite desbloquealos."

#. +> plasma5lts
#: solidrunner.cpp:55 solidrunner.cpp:147
#, kde-format
msgctxt "Note this is a KRunner keyword"
msgid "unmount"
msgstr "desmontar"

#. +> plasma5lts
#: solidrunner.cpp:56
#, kde-format
msgid "Lists all devices which can be unmounted, and allows them to be unmounted."
msgstr "Lista todos os dispositivos que se poidan desmontar e permite desmontalos."

#. +> plasma5lts
#: solidrunner.cpp:57 solidrunner.cpp:161
#, kde-format
msgctxt "Note this is a KRunner keyword"
msgid "lock"
msgstr "bloquear"

#. +> plasma5lts
#: solidrunner.cpp:58
#, kde-format
msgid "Lists all encrypted devices which can be locked, and allows them to be locked."
msgstr "Lista todos os dispositivos cifrados que se poidan bloquear, e permite bloquealos."

#. +> plasma5lts
#: solidrunner.cpp:60 solidrunner.cpp:151
#, kde-format
msgctxt "Note this is a KRunner keyword"
msgid "eject"
msgstr "expulsar"

#. +> plasma5lts
#: solidrunner.cpp:61
#, kde-format
msgid "Lists all devices which can be ejected, and allows them to be ejected."
msgstr "Lista todos os dispositivos que se poidan expulsar e permite facelo."
