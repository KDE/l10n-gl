#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:163
#, kde-format
msgid "This device can now be safely removed."
msgstr "O dispositivo pode retirarse con seguranza."

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:170
#, kde-format
msgid "You are not authorized to mount this device."
msgstr "Non ten autorización para montar o dispositivo."

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:173
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "You are not authorized to remove this device."
msgstr "Non ten autorización para retirar o dispositivo."

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:176
#, kde-format
msgid "You are not authorized to eject this disc."
msgstr "Non ten autorización para expulsar o disco."

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:183
#, kde-format
msgid "Could not mount this device as it is busy."
msgstr "Non se puido montar o dispositivo porque está en uso."

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:213
#, kde-format
msgid "One or more files on this device are open within an application."
msgstr "Hai aberto polo menos un ficheiro deste dispositivo nalgún aplicativo."

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:215
#, kde-format
msgid "One or more files on this device are opened in application \"%2\"."
msgid_plural "One or more files on this device are opened in following applications: %2."
msgstr[0] "Hai aberto polo menos un ficheiro deste dispositivo no aplicativo «%2»."
msgstr[1] "Hai aberto polo menos un ficheiro deste dispositivo nos seguintes aplicativos: %2."

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:217
#, kde-format
msgctxt "separator in list of apps blocking device unmount"
msgid ", "
msgstr ", "

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:234
#, kde-format
msgid "Could not mount this device."
msgstr "Non se puido montar o dispositivo."

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:237
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "Could not remove this device."
msgstr "Non se puido retirar o dispositivo."

#. +> trunk5 stable5 plasma5lts
#: ksolidnotify.cpp:240
#, kde-format
msgid "Could not eject this disc."
msgstr "Non se puido expulsar o disco."
