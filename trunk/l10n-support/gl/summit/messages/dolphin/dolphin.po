msgid "This will copy the path of the first selected item into the clipboard."
msgstr "Isto copiará a ruta do primeiro elemento seleccionado no portapapeis."

#. +> trunk6 stable6
#: views/dolphinviewactionhandler.cpp:161
#, kde-format
