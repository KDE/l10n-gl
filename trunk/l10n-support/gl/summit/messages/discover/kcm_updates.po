#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:40
#, kde-format
msgid "Update software:"
msgstr "Actualizar o soporte lóxico:"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:41
#, kde-format
msgid "Manually"
msgstr "Manualmente"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:51
#, kde-format
msgid "Automatically"
msgstr "Automaticamente"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:58
#, kde-kuit-format
msgctxt "@info"
msgid "Software updates will be downloaded automatically when they become available. Updates for applications will be installed immediately, while system updates will be installed the next time the computer is restarted."
msgstr "As actualizacións de soporte lóxico descargaranse automaticamente cando estean dispoñíbeis. As actualizacións de aplicacións instalaranse inmediatamente, mentres que as actualizacións do sistema instalaranse a próxima vez que se reinicie o computador."

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:69
#, kde-format
msgctxt "@title:group"
msgid "Update frequency:"
msgstr "Frecuencia de actualización:"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:69
#, kde-format
msgctxt "@title:group"
msgid "Notification frequency:"
msgstr "Frecuencia de notificación:"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:72
#, kde-format
msgctxt "@item:inlistbox"
msgid "Daily"
msgstr "Diaria"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:73
#, kde-format
msgctxt "@item:inlistbox"
msgid "Weekly"
msgstr "Semanal"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@item:inlistbox"
msgid "Monthly"
msgstr "Mensual"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:75
#, kde-format
msgctxt "@item:inlistbox"
msgid "Never"
msgstr "Nunca"

#. +> stable5
#: kcm/package/contents/ui/main.qml:111
#, kde-format
msgid "Use offline updates:"
msgstr "Usar actualizacións sen conexión:"

#. +> trunk6 stable6
#: kcm/ui/main.qml:119
#, kde-format
msgid "Apply system updates:"
msgstr "Aplicar as actualizacións do sistema:"

#. +> stable5
#: kcm/package/contents/ui/main.qml:124
#, kde-format
msgid "Offline updates maximize system stability by applying changes while restarting the system. Using this update mode is strongly recommended."
msgstr "As actualizacións sen conexión maximizan a estabilidade do sistema aplicando os cambios durante o reinicio do sistema. Recoméndase encarecidamente usar este método de actualización."

#. +> trunk6 stable6
#: kcm/ui/main.qml:126
#, kde-format
msgctxt "@option:radio part of the logical sentence 'Apply system updates after rebooting'"
msgid "After rebooting"
msgstr "Tras reiniciar"

#. +> trunk6 stable6
#: kcm/ui/main.qml:133
#, kde-format
msgctxt "@label The thing being recommended is to use the 'apply updates when rebooting' setting"
msgid "Recommended to maximize system stability"
msgstr "Recoméndase para maximizar a estabilidade do sistema."

#. +> trunk6 stable6
#: kcm/ui/main.qml:139
#, kde-format
msgctxt "@option:radio part of the logical sentence 'Apply system updates immediately'"
msgid "Immediately"
msgstr "Inmediatamente"

#. +> stable5
#: kcm/updates.cpp:31
#, kde-format
msgid "Software Update"
msgstr "Actualización de soporte lóxico"

#. +> stable5
#: kcm/updates.cpp:33
#, kde-format
msgid "Configure software update settings"
msgstr "Configurar as actualizacións de soporte lóxico"
