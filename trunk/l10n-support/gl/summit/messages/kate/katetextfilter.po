#. +> trunk6 stable6
#: plugin_katetextfilter.cpp:142
#, kde-format
msgid "Failed to start process"
msgstr "Non foi posíbel iniciar o proceso."

#. +> trunk6 stable6
#: plugin_katetextfilter.cpp:156
#, kde-format
msgid ""
"You are not allowed to execute arbitrary external applications. If you want to"
" be able to do this, contact your system administrator."
msgstr ""
"Non ten permisos para executar aplicacións externas á súa vontade. Se quere es"
"te permiso contacte co administrador do sistema."

#. +> trunk6 stable6
#: plugin_katetextfilter.cpp:158
