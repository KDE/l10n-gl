msgstr "&Retirar a extensión"

#. +> trunk6 stable6
#: kateconsole.cpp:699
#, kde-format
msgid "Prefix:"
msgstr "Prefixo:"

#. +> trunk6 stable6
#: kateconsole.cpp:707
#, kde-format
msgid "&Show warning next time"
msgstr "&Amosar o aviso a próxima vez."

#. +> trunk6 stable6
#: kateconsole.cpp:709
#, kde-format
msgid "The next time '%1' is executed, make sure a warning window will pop up, displaying the command to be sent to terminal, for review."
msgstr "A próxima vez que se execute «%1», asegurarse de que aparece unha xanela de aviso, amosando a orde que se vai enviar ao terminal, para revisala."

#. +> trunk6 stable6
#: kateconsole.cpp:720
#, kde-format
msgid "Set &EDITOR environment variable to 'kate -b'"
msgstr "Configurar a variábel de contorno &EDITOR como «kate -b»"

#. +> trunk6 stable6
#: kateconsole.cpp:723
#, kde-format
msgid "Important: The document has to be closed to make the console application continue"
msgstr "Importante: O documento debe estar pechado para facer continuar a aplicación de consola"

#. +> trunk6 stable6
#: kateconsole.cpp:726
#, kde-format
msgid "Hide Konsole on pressing 'Esc'"
msgstr "Agochar Konsole ao premer Esc"

#. +> trunk6 stable6
#: kateconsole.cpp:729
#, kde-format
msgid "This may cause issues with terminal apps that use Esc key, for e.g., vim. Add these apps in the input below (Comma separated list)"
msgstr "Esto pode causar problemas con aplicacións de terminal que usan a tecla Esc, p. ex. vim. Liste esas aplicacións a continuación, separada por comas."

#. +> trunk6 stable6
#: kateconsole.cpp:773
