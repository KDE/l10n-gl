#: kateconsole.cpp:679
#, kde-format
msgid "&Don't synchronize terminal tab with current document"
msgstr "Non &sincronizar a lapela do terminal co documento actual."

#. +> trunk6 stable6
#: kateconsole.cpp:682
#, kde-format
msgid "&Automatically synchronize the current terminal tab with the current document when possible"
msgstr "Sincronizar &automaticamente a lapela actual do terminal co documento actual cando sexa posíbel."

#. +> trunk6 stable6
#: kateconsole.cpp:685
#, kde-format
msgid "&Automatically create a terminal tab for the directory of the current document and switch to it"
msgstr "Crear &automaticamente unha lapela de terminal para o cartafol do documento actual e cambiar a ela."

#. +> trunk6 stable6
#: kateconsole.cpp:692 kateconsole.cpp:713
#, kde-format
msgid "Run in terminal"
msgstr "Executar nun terminal"

