#. +> trunk6 stable6 stable5
#: l2tpipsec.ui:271
#, kde-format
msgid "Phase1 Lifetime:"
msgstr "Duración da primeira fase:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, ike)
#. +> trunk6 stable6 stable5
#: l2tpipsec.ui:278
#, kde-format
msgid ""
"<html><head/><body>"
"<p>Optional. A list of proposals for IKE - Main Mode. The format is “enc-integ-group,enc-integ-group, …”.</p>"
"</body></html>"
msgstr ""
"<html><head/><body>"
"<p>Optional. Lista de propostas para o modo principal de IKE. O formato é «enc-integ-group,enc-integ-group,…».</p>"
"</body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, cbSalifetime)
#. +> trunk6 stable6 stable5
#: l2tpipsec.ui:285
#, kde-format
