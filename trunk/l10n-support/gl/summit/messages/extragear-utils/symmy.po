#. +> trunk5
#: plugins/decryptfileitemaction.cpp:40
#, kde-format
msgctxt "@action:inmenu Decrypt action in Dolphin context menu"
msgid "Decrypt"
msgstr "Descifrar"

#. +> trunk5
#: plugins/encryptfileitemaction.cpp:50
#, kde-format
msgctxt "@action:inmenu Encrypt action in Dolphin context menu"
msgid "Encrypt"
msgstr "Cifrar"

#. +> trunk5
#: src/compositejob.cpp:70
#, kde-kuit-format
msgctxt "@info"
msgid "Encryption operation failed. Please check whether the <application>gpg-agent</application> process is running."
msgstr "A operación de cifraxe fallou. Comprobe se o proceso <application>gpg-agent</application> está en execución."

#. +> trunk5
#: src/compositejob.cpp:96
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Decryption operation failed. Please check whether the decryption key is correct.<nl/>"
"You should also check whether the <application>gpg-agent</application> process is running."
msgstr ""
"A operación de descifraxe fallou. Comprobe que a chave de descifraxe é correcta.<nl/>"
" Tamén debería comprobar se o proceso de <application>gpg-agent</application> está en execución."

#. +> trunk5
#: src/compositejob.cpp:99
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Could not decrypt the following ciphertexts.<nl/>"
"Please check whether the decryption key is correct."
msgstr ""
"Non se puideron descifrar os seguintes textos cifrados.<nl/>"
" Comprobe se a chave de descifraxe é correcta."

#. +> trunk5
#: src/compositejob.cpp:139
#, kde-format
msgid "Asking Passphrase"
msgstr "Solicitando a frase de paso"

#. +> trunk5
#: src/compositejob.cpp:143
#, kde-format
msgid "Please supply a password or passphrase to be used as encryption key."
msgstr "Forneza un contrasinal ou frase de paso para usar como chave de cifraxe."

#. +> trunk5
#: src/compositejob.cpp:148
#, kde-format
msgid "Please supply a password or passphrase to be used as decryption key."
msgstr "Forneza un contrasinal ou frase de paso para usar como chave de descifraxe."

#. +> trunk5
#: src/compositejob.cpp:169
#, kde-format
