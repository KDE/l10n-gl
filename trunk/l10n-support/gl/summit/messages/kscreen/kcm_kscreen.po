#. +> trunk6 stable6
#: ui/OutputPanel.qml:532
#, kde-format
msgctxt "@option:check"
msgid "Control hardware brightness with DDC/CI"
msgstr "Controlar o brillo físico con DDC/CI."

#. +> trunk6 stable6
#: ui/OutputPanel.qml:538
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"DDC/CI is a feature supported by many monitors. Plasma can use it to adjust sc"
"reen brightness with desktop controls, as if using the monitor's own hardware "
"buttons and OSD menu."
msgstr ""
"DDC/CI é unha funcionalidade que ofrecen moitos monitores. Plasma pode usala p"
"ara axustar o brillo da pantalla con controis do escritorio, como se estivese "
"a usar os botóns físicos ou o menú da propia pantalla."

#. +> trunk6 stable6
#: ui/OutputPanel.qml:568
#, kde-format
msgctxt "Brightness expressed in percentage form"
msgid "%1%"
msgstr "%1%"

