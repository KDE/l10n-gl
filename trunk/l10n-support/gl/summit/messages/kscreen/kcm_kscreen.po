#| msgid "Enable HDR"
msgctxt "@option:check"
msgid "Enable EDR"
msgstr "Activar o EDR."

#. +> trunk6 stable6
#: ui/OutputPanel.qml:590
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid ""
"EDR allows viewing HDR content on SDR displays by dynamically adjusting the ba"
"cklight.<nl/>"
"<nl/>"
"Note that this increases battery usage while viewing HDR content."
msgstr ""
"EDR permite axustar dinamicamente a retroiluminación en pantallas SDR para ver"
" contido de HDR .<nl/>"
"<nl/>"
"Teña en conta que isto aumenta o uso de batería mentres visualiza contido de H"
"DR."

