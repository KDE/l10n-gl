#. +> trunk5 stable5
#: gdbconfigpage.ui:207 gdbconfigpage.ui:249
#, kde-format
msgid ""
"<html><head/><body>"
"<p>This script is sourced by gdb when the debugging starts.</p>"
"</body></html>"
msgstr ""
"<html><head/><body>"
"<p>Este script impórtao GDB cando comeza a depuración.</p>"
"</body></html>"

#. i18n: ectx: property (text), widget (QLabel, configGdbScript_label)
#. +> trunk5 stable5
#: gdbconfigpage.ui:210
#, kde-format
msgid "Gdb &config script:"
msgstr "Script de &configuración de GDB:"

# skip-rule: normalization-shell
#. i18n: ectx: property (toolTip), widget (KUrlRequester, kcfg_runGdbScript)
#. i18n: ectx: property (toolTip), widget (QLabel, runGdbScript_label)
#. +> trunk5 stable5
#: gdbconfigpage.ui:223 gdbconfigpage.ui:233
#, kde-format
msgid ""
"<html><head/><body>"
"<p>Script to connect with remote application</p>"
"<p>For example:</p>"
"<p>\tshell sleep 5\t #wait for remote program to start</p>"
"<p>\ttarget remote ...\t#connect to the remote debugger</p>"
"<p>\tcontinue\t#[optional] run debugging to the first breakpoint.</p>"
"</body></html>"
msgstr ""
"<html><head/><body> "
"<p>Script para conectar cunha aplicación remota</p>"
" "
"<p>Por exemplo:</p>"
" "
"<p>\tshell sleep 5\t# Agarda a que se inicie o programa remoto.</p>"
" "
"<p>\ttarget remote …\t# Conectar co depurador remoto.</p>"
" "
"<p>\tcontinue\t# Opcionalmente, executar o depurador ata o primeiro punto de ruptura.</p>"
" </body></html>"

