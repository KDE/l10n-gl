#: org.kde.bomber.appdata.xml:6
msgid "Bomber"
msgstr "Bomber"

#. (itstool) path: component/summary
#. +> trunk5 stable5
#: org.kde.bomber.appdata.xml:7
msgid "Arcade Bombing Game"
msgstr "Xogo arcade de bombardeo"

#. (itstool) path: description/p
#. +> trunk5 stable5
#: org.kde.bomber.appdata.xml:9
msgid "Bomber is a single player arcade game. The player is invading various cities in a plane that is decreasing in height."
msgstr "Bomber é un xogo arcade para un único xogador, que montado nun avión invadirá varias cidades mentres o aparello vai reducindo a súa altitude."

#. (itstool) path: description/p
#. +> trunk5 stable5
#: org.kde.bomber.appdata.xml:12
msgid "The goal of the game is to destroy all the buildings and advance to the next level. Each level gets a bit harder by increasing the speed of the plane and the height of the buildings."
msgstr "O obxectivo do xogo consiste en destruír os edificios e avanzar ao seguinte nivel. Cada novo nivel resultará máis difícil, pois aumentará a velocidade do avión, así como a altura dos edificios."

#. (itstool) path: component/developer_name
#. +> trunk5 stable5
#: org.kde.bomber.appdata.xml:27
msgid "The KDE Community"
msgstr "A comunidade de KDE"
