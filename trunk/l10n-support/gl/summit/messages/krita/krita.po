#, kde-format
msgctxt "JPEG-XL encoder options"
msgid "Color channel resampling"
msgstr "Nova toma de mostras da canle de cor"

#. i18n: ectx: property (toolTip), widget (QComboBox, resampling)
#. +> trunk5 stable5
#: plugins/impex/jxl/kis_wdg_options_jpegxl.ui:409
#, kde-format
msgid "Sets resampling option. If enabled, the image's color channels are downsampled before compression, and upsampled to original size in the decoder."
msgstr "Define a opción de nova toma de mostras. Se se activa, redúcese a taxa de mostras das canles de cor da imaxe antes da compresión, e auméntase ao tamaño orixinal no descodificador."

#. i18n: ectx: property (text), widget (QLabel, lblAlphaResampling)
#. +> trunk5 stable5
#: plugins/impex/jxl/kis_wdg_options_jpegxl.ui:416
