#. i18n: ectx: property (text), widget (QLabel, labelSupportText)
#. +> trunk5 stable5
#: libs/ui/forms/KisWelcomePage.ui:1559
#, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Krita is an open source and community-driven tool for digital artists everywhere.<br />"
"Progress is made possible thanks to ongoing support from our community of <a href=\"https://docs.krita.org/en/contributors_manual.html\">contributors</a>, sponsors, and <a href=\"https://fund.krita.org/\">development fund </a>members.</p>"
"</body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Krita é unha ferramenta para artistas dixitais de todo o mundo, de soporte lóxico libre e liderada pola comunidade.<br />"
"O que fai posíbel o progreso é o apoio continuo da comunidade de <a href=\"https://docs.krita.org/en/contributors_manual.html\">persoas colaboradoras</a>, patrocinios, e a xente do <a href=\"https://fund.krita.org/\">fondo de desenvolvemento</a>.</p>"
"</body></html>"

