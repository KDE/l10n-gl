msgstr "Rec 2100 PQ"

#. +> trunk5 stable5
#: plugins/impex/heif/HeifExport.cpp:545
#: plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:188
#, kde-format
msgctxt "@tooltip"
msgid "The image will be converted to Rec 2020 linear first, and then encoded with a perceptual quantizer curve (also known as SMPTE 2048 curve). Recommended for HDR images where the absolute brightness is important."
msgstr "A imaxe converterase en Rec 2020 linear primeiro, e logo codificarase cunha curva de medición da percepción (a curva SMPTE 2048). Recoméndase para imaxes HDR nas que o brillo absoluto resulta importante."

#. +> trunk5 stable5
#: plugins/impex/heif/HeifExport.cpp:547
#: plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:195
#, kde-format
msgctxt "@tooltip"
msgid "The image will be converted to Rec 2020 linear first, and then encoded with a Hybrid Log Gamma curve. Recommended for HDR images where the display may not understand HDR."
msgstr "A imaxe converterase en Rec 2020 linear primeiro, e logo codificarase cunha curva de gama logarítmica híbrida (HLG). Recoméndase para imaxes HDR nas que a pantalla pode non entender HDR."

#. +> trunk5 stable5
#: plugins/impex/heif/HeifExport.cpp:553
#: plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:202
#, kde-format
msgctxt "Color space option plus transfer function name"
msgid "Keep colorants, encode PQ"
msgstr "Manter os colorantes, codificar o PQ"

#. +> trunk5 stable5
#: plugins/impex/heif/HeifExport.cpp:554
#: plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:204
#, kde-format
msgctxt "@tooltip"
msgid "The image will be linearized first, and then encoded with a perceptual quantizer curve (also known as the SMPTE 2048 curve). Recommended for images where the absolute brightness is important."
msgstr "A imaxe converterase en linear primeiro, e logo codificarase cunha curva de medición da percepción (a curva SMPTE 2048). Recoméndase para imaxes nas que o brillo absoluto resulta importante."

#. +> trunk5 stable5
#: plugins/impex/heif/HeifExport.cpp:558
#: plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:210
#, kde-format
msgctxt "Color space option plus transfer function name"
