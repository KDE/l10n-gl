#. +> trunk5
#: floppy.cpp:126 floppy.cpp:136
#, kde-format
msgctxt "Linux"
msgid "KFloppy supports three file formats under Linux: MS-DOS, Ext2, and Minix"
msgstr "KFloppy é compatíbel con tres formatos de ficheiro en Linux: MS-DOS, Ext2 e Minix."

#. +> trunk5
#: floppy.cpp:128
#, kde-format
msgctxt "BSD"
msgid "KFloppy supports three file formats under BSD: MS-DOS, UFS, and Ext2"
msgstr "KFloppy é compatíbel con tres formatos de ficheiro en BSD: MS-DOS, UFS e Ext2."

