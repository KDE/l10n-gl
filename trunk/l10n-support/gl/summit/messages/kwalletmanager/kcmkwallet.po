#. i18n: ectx: attribute (title), widget (QWidget, tab1)
#. +> trunk6 stable6
#: walletconfigwidget.ui:27
#, kde-format
msgid "Wallet Preferences"
msgstr "Preferencias da carteira"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, _enabled)
#. +> trunk6 stable6
#: walletconfigwidget.ui:33
#, kde-format
msgid ""
"<p>The wallet subsystem provides a convenient and secure way to manage all you"
"r passwords. This option specifies whether or not you want to use it.</p>"
msgstr ""
"<p>O subsistema de carteira fornece un xeito sinxelo e seguro de xestionar os "
"seus contrasinais. Esta opción indica se quere ou non usar este subsistema.</p"
">"

#. i18n: ectx: property (text), widget (QCheckBox, _enabled)
#. +> trunk6 stable6
#: walletconfigwidget.ui:36
#, kde-format
msgid "&Enable the KDE wallet subsystem"
msgstr "&Activar o subsistema de carteira de KDE."

#. i18n: ectx: property (whatsThis), widget (QGroupBox, groupBox2)
#. +> trunk6 stable6
#: walletconfigwidget.ui:49
#, kde-format
msgid ""
"It is best to close your wallets when you are not using them to prevent others"
" from viewing or using them."
msgstr ""
"É mellor pechar as carteiras cando non as estea a usar para previr que outros "
"as vexan ou as usen."

#. i18n: ectx: property (title), widget (QGroupBox, groupBox2)
#. +> trunk6 stable6
#: walletconfigwidget.ui:52
#, kde-format
msgid "Close Behavior"
msgstr "Comportamento ao pechar"

#. i18n: ectx: property (text), widget (QLabel, closeWalletLabel)
#. +> trunk6 stable6
#: walletconfigwidget.ui:69
#, kde-format
msgid "Close wallet:"
msgstr "Pechar a carteira:"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, _autoclose)
#. +> trunk6 stable6
#: walletconfigwidget.ui:76
#, kde-format
msgid ""
"<p><b>Close wallet as soon as applications that use it have stopped.</b><br>"
"Note that your wallet will only be closed when all applications that use it ha"
"ve stopped.<br>"
"When a wallet is closed the password is needed to access it again.</p>"
msgstr ""
"<p>Pecha a carteira en canto as aplicacións que a usen se deteñan.<b></b><br>"
"Lembre que a carteira só se pechará cando as aplicacións que a use se deteñan."
"<br>"
"Cando unha carteira estea pechada precisará do contrasinal para abrila de novo"
".</p>"

#. i18n: ectx: property (text), widget (QCheckBox, _autoclose)
#. +> trunk6 stable6
#: walletconfigwidget.ui:79
#, kde-format
msgid "When last application stops using it"
msgstr "Cando a última aplicación deixe de usala."

#. i18n: ectx: property (whatsThis), widget (QCheckBox, _screensaverLock)
#. +> trunk6 stable6
#: walletconfigwidget.ui:86
#, kde-format
msgid ""
"<p><b>Close wallet as soon as the screensaver starts.</b><br>"
"When a wallet is closed the password is needed to access it again.</p>"
msgstr ""
"<p><b>Pecha a carteira en canto o protector de pantalla comeza.</b><br>"
"Cando unha carteira se pecha precisará de novo o contrasinal para abrila.</p>"

#. i18n: ectx: property (text), widget (QCheckBox, _screensaverLock)
#. +> trunk6 stable6
#: walletconfigwidget.ui:89
#, kde-format
msgid "When screensaver starts"
msgstr "Cando o protector de pantalla se inicie."

#. i18n: ectx: property (whatsThis), widget (QCheckBox, _closeIdle)
#. i18n: ectx: property (whatsThis), widget (QSpinBox, _idleTime)
#. +> trunk6 stable6
#: walletconfigwidget.ui:96 walletconfigwidget.ui:115
#, kde-format
msgid ""
"<p><b>Close wallet after a period of inactivity.</b><br>"
"When a wallet is closed the password is needed to access it again.</p>"
msgstr ""
"<p><b>Pechar a carteira despois dun período de inactividade</b><br>"
"Cando unha carteira se peche o contrasinal será preciso para acceder a ela de "
"novo.</p>"

#. i18n: ectx: property (text), widget (QCheckBox, _closeIdle)
#. +> trunk6 stable6
#: walletconfigwidget.ui:99
#, kde-format
msgid "When unused for:"
msgstr "Cando non se use por máis de:"

#. i18n: ectx: property (suffix), widget (QSpinBox, _idleTime)
#. +> trunk6 stable6
#: walletconfigwidget.ui:121
#, kde-format
msgid " minutes"
msgstr " minutos"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox4)
#. +> trunk6 stable6
#: walletconfigwidget.ui:145
#, kde-format
msgid "Automatic Wallet Selection"
msgstr "Escolla automática da carteira"

#. i18n: ectx: property (text), widget (QCheckBox, _localWalletSelected)
#. +> trunk6 stable6
#: walletconfigwidget.ui:165
#, kde-format
msgid "Use different default wallet for local passwords"
msgstr ""
"Usar unha carteira predeterminada distinta para os contrasinais locais."

#. i18n: ectx: property (text), widget (QPushButton, _newLocalWallet)
#. i18n: ectx: property (text), widget (QPushButton, _newWallet)
#. +> trunk6 stable6
#: walletconfigwidget.ui:202 walletconfigwidget.ui:242
#, kde-format
msgid "New..."
msgstr "Nova…"

#. i18n: ectx: property (text), widget (QLabel, selectDefaultWalletLabel)
#. +> trunk6 stable6
#: walletconfigwidget.ui:211
#, kde-format
msgid "Default wallet:"
msgstr "Carteira predeterminada:"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox3)
#. +> trunk6 stable6
#: walletconfigwidget.ui:256
#, kde-format
msgid "Wallet Manager"
msgstr "Xestor de carteiras"

#. i18n: ectx: property (text), widget (QCheckBox, _launchManager)
#. +> trunk6 stable6
#: walletconfigwidget.ui:270
#, kde-format
msgid "Show manager in system tray"
msgstr "Amosar o xestor na área de notificación."

#. i18n: ectx: property (text), widget (QCheckBox, _autocloseManager)
#. +> trunk6 stable6
#: walletconfigwidget.ui:298
#, kde-format
msgid "Hide system tray icon when last wallet closes"
msgstr "Agochar a icona da bandexa cando peche a última das carteiras."

#. i18n: ectx: property (title), widget (QGroupBox, groupBox5)
#. +> trunk6 stable6
#: walletconfigwidget.ui:312
#, kde-format
msgid "Secret Service"
msgstr "Servizo de segredos"

#. i18n: ectx: property (text), widget (QCheckBox, _secretServiceAPI)
#. +> trunk6 stable6
#: walletconfigwidget.ui:331
#, kde-format
msgid "Use &KWallet for the Secret Service interface"
msgstr "Usar &KWallet como interface do servizo de segredos."

#. i18n: ectx: property (contextualHelpText), widget (KContextualHelpButton, kcontextualhelpbutton)
#. +> trunk6 stable6
#: walletconfigwidget.ui:341
#, kde-format
msgid ""
"The Secret Service interface lets applications store passwords and other confi"
"dential data. Disable this to allow third-party wallet services such as KeePas"
"sXC or GNOME Keyring to manage it instead."
msgstr ""
"A interface do servizo de segredos permite ás aplicacións almacenar contrasina"
"is e outros datos confidenciais. Desactive isto para permitir que o xestionen "
"no seu lugar servizos de carteira de terceiras partes como KeePassXC ou GNOME "
"Keyring."

#. i18n: ectx: attribute (title), widget (QWidget, tab2)
#. +> trunk6 stable6
#: walletconfigwidget.ui:388
#, kde-format
msgid "Access Control"
msgstr "Control de acceso"

#. i18n: ectx: property (text), widget (QCheckBox, _openPrompt)
#. +> trunk6 stable6
#: walletconfigwidget.ui:394
#, kde-format
msgid "&Prompt when an application accesses a wallet"
msgstr "&Preguntar cando unha aplicación accede a unha carteira."

#. i18n: ectx: property (text), widget (QTreeWidget, _accessList)
#. +> trunk6 stable6
#: walletconfigwidget.ui:408
#, kde-format
msgid "Wallet"
msgstr "Carteira"

#. i18n: ectx: property (text), widget (QTreeWidget, _accessList)
#. +> trunk6 stable6
#: walletconfigwidget.ui:413
#, kde-format
msgid "Application"
msgstr "Aplicación"

#. i18n: ectx: property (text), widget (QTreeWidget, _accessList)
#. +> trunk6 stable6
#: walletconfigwidget.ui:418
#, kde-format
msgid "Policy"
msgstr "Política"

#. i18n: ectx: property (text), widget (QPushButton, _launch)
#. +> trunk6 stable6
#: walletconfigwidget.ui:451
#, kde-format
msgid "&Launch Wallet Manager"
msgstr "&Iniciar o xestor de carteiras"

