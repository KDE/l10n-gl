#. (itstool) path: component/name
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:7
msgid "Gwenview"
msgstr "Gwenview"

#. (itstool) path: component/summary
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:8
msgid "Image Viewer"
msgstr "Visor de imaxes"

#. (itstool) path: description/p
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:10
msgid "Gwenview is a fast and easy to use image viewer by KDE, ideal for browsing and displaying a collection of images."
msgstr "Gwenview é un visor de imaxes por KDE rápido e doado de usar, ideal para examinar e amosar unha colección de imaxes."

#. (itstool) path: description/p
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:13
msgid "Features:"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:15
msgid "Simple image editing: rotate, crop, resize, mirror, flip, reduce red eye, and adjust brightness, contrast, or gamma"
msgstr "Edición sinxela de imaxes: rotar, recortar, cambiar de tamaño, inverter en horizontal ou vertical, reducir os ollos vermellos e axustar o brillo, o contraste e a tonalidade."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:16
msgid "Annotate and mark up images with arrows, shapes, text boxes, image stamps, and more"
msgstr "Anotar e marcar imaxes con frechas, formas, caixas de texto, selos de imaxe e máis."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:17
msgid "Basic file management actions such as copy, move, delete, and others"
msgstr "Accións básicas de xestión de ficheiros como copiar, mover, eliminar, etc."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:18
msgid "Functions both as a standalone application and an embedded viewer in the Konqueror web browser"
msgstr "Pode usarse como unha aplicación autónoma e tamén como un visor incrustado no navegador web Konqueror."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:28
msgid "Main application window displaying an image and controls on the left"
msgstr "Xanela principal da aplicación que amosa unha imaxe e controls na esquerda."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.gwenview.appdata.xml:32
msgid "Use Gwenview to manage your image collection"
msgstr "Use Gwenview para xestionar a súa colección de imaxes"

#~ msgid "Supports simple image manipulations: rotate, mirror, flip, and resize"
#~ msgstr "Permite manipulacións sinxelas de imaxes de maneira individual: rotar, reflectir, inverter e cambiar o tamaño."

#~ msgid "Supports basic file management actions such as copy, move, delete, and others"
#~ msgstr "Permite realizar accións básicas de xestión de ficheiros como copiar, mover, eliminar, etc."

#~ msgid "Can be extended using KIPI plugins."
#~ msgstr "Poden ampliarse as súas funcionalidades mediante complementos KIPI."

#~ msgid "Gwenview displaying an image, with additional metadata shown in the sidebar"
#~ msgstr "Gwenview amosando unha imaxe, con metadatos adicionais mostrador na barra lateral."
