msgstr ""

#. +> trunk5
#: content/announcements/gear/22.12.2.md:9
msgid "libkdegames: Fix finding knewstuff themes ([Commit](http://commits.kde.org/libkdegames/fae6ef9b8785fdbdc8518000a5865d88026c7148), fixes bug [#464288](https://bugs.kde.org/464288))"
msgstr ""

