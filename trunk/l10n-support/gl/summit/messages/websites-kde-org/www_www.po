msgstr "Cambios de deseño da configuración do sistema"

#. +> trunk5
#: content/announcements/gear/23.08.0.md:103
msgid "We renamed Kalendar to Merkuro since the application not only lets you manage your events and tasks any more, but also your contacts."
msgstr ""

#. +> trunk5
#: content/announcements/gear/23.08.0.md:105
msgid "And soon we'll be adding email!"
msgstr ""

#. +> trunk5
#: content/announcements/gear/23.08.0.md:107
