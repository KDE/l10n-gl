#. (itstool) path: component/name
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:14
msgid "KDE Itinerary"
msgstr "KDE Itinerary"

#. (itstool) path: component/summary
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:15
msgid "Digital travel assistant"
msgstr "Asistente de viaxes dixital."

#. (itstool) path: description/p
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:17
msgid "KDE Itinerary is a digital travel assistant with a priority on protecting your privacy."
msgstr "KDE Itinerary é un asistente dixital de viaxe coa protección da súa privacidade como prioridade."

#. (itstool) path: description/p
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:18
msgid "Features:"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:20
msgid "Timeline view of a unified travel itinerary with automatic trip grouping."
msgstr "Vista da cronoloxía dun itinerario de viaxe sen definir con agrupamento automático de viaxes."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:21
msgid "Supports train, bus and flight bookings as well as hotel, restaurant, event and rental car reservations."
msgstr "Permite billetes de tren, bus e voo, así como reservas de hotel, restaurante, eventos e alugamento de coche."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:22
msgid "Boarding pass management."
msgstr "Xestión de pases de embarque."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:23
msgid "Supports ticket management for multi-traveler and multi-ticket bookings."
msgstr "Permite xestión de billetes diversos de varias persoas."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:24
msgid "Automatic booking data extraction from various input formats, performed locally on your device."
msgstr "Extracción automática de datos de billetes de varios formatos de entrada, executada localmente no seu dispositivo."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:25
msgid "Real-time delay and platform change information for trains."
msgstr "Información de cambio de atraso e de plataforma de trens en tempo real."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:26
msgid "Weather forecast for destination along your trip."
msgstr "Prognóstico meteorolóxico do destino durante a viaxe."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:27
msgid "Full control over all online access."
msgstr "Control absoluto de todo o acceso por Internet."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:28
msgid "Selection of alternative train connections on unbound tickets or on missed connections."
msgstr "Selección de conexións alternativas de tren en billetes flexíbeis ou en caso de perda de conexións."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:29
msgid "Local ground transportation navigation between elements of your itinerary."
msgstr "Navegación de transporte terrestre local entre puntos do itinerario."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:30
msgid "Train coach layout view (for some operators only)."
msgstr "Vista do plano do coche de tren (só para algúns operadores)."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:31
msgid "Train station and airport per-floor maps based on OpenStreetMap data."
msgstr "Mapas das plantas de estacións de tren e de aeroportos baseados en datos de OpenStreetMap."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:32
msgid "Available dock-based or free-floating rental bikes can be displayed on the train station map."
msgstr "As bicicletas de alugamento dispoñíbeis, en puntos de aparcamento ou fóra deles, poden amosarse nos mapas das estacións de tren."

#. (itstool) path: ul/li
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:33
msgid "Personal travel statistics to monitor environmental impact."
msgstr "Estatísticas de viaxe persoal para facer seguimento do impacto medioambiental."

#. (itstool) path: description/p
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:35
msgid "KDE Itinerary works best alongside KMail's itinerary extraction plug-in and KDE Connect, or Nextcloud Hub and DavDroid."
msgstr "KDE Itinerary funciona mellor co complemento de extracción de itinerario de KMail e KDE Connect, ou Nextcloud Hub e DavDroid."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:39
msgid "Timeline view"
msgstr "Vista cronolóxica."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:43
msgid "Boarding pass view"
msgstr "Vista de pase de embarque."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:47
msgid "Train layout view highlighting the coach with a seat reservation"
msgstr "Vista de mapa de tren que realza o coche coa reserva de asento."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:51
msgid "Train station platform map, highlighting arrival and departure platforms"
msgstr "Mapa da plataforma da estación de tren que realiza as plataformas de chegada e de saída."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:55
msgid "Train station map showing real-time availability of rental bikes"
msgstr "Mapa de estación de tren que amosa a dispoñibilidade de bicicletas de alugamento en tempo real."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:59
msgid "Detailed information for the select entity on the train station map"
msgstr "Información detallada da entidade seleccionada no mapa da estación de tren."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.itinerary.appdata.xml:63
msgid "Travel statistics view"
msgstr "Vista de estatísticas de viaxe."

