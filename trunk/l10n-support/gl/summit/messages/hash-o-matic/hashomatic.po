msgctxt "@label"
msgid "This file has been signed VS-NfD compliant using the key <a href=\"%1\">%2</a>."
msgstr "Este ficheiro asinouse en cumprimento de VS-NfD coa chave <a href=\"%1\">%2</a>."

#. +> trunk6
#: hashhelper.cpp:71
#, kde-format
msgctxt "@label"
msgid "This file has been signed using the key <a href=\"%1\">%2</a>."
msgstr "Este ficheiro asinouse coa chave <a href=\"%1\">%2</a>."

#. +> trunk6
#: hashhelper.cpp:74
#, kde-format
msgctxt "@label"
msgid "The key details are not available."
msgstr "Os detalles da chave non están dispoñíbeis."

#. +> trunk6
#: hashhelper.cpp:77
#, kde-format
msgctxt "@label"
msgid "This file has been signed VS-NfD compliant by %1."
msgstr "%1 asinou este ficheiro en cumprimento de VS-NfD."

#. +> trunk6
#: hashhelper.cpp:79
#, kde-format
msgctxt "@label"
msgid "This file has been signed by %1."
msgstr "%1 asinou este ficheiro."

#. +> trunk6
#: hashhelper.cpp:82
#, kde-format
msgctxt "@label"
msgid "The <a href=\"%1\">key</a> was revoked."
msgstr "Revogouse a <a href=\"%1\">chave</a>."

#. +> trunk6
#: hashhelper.cpp:85
#, kde-format
msgctxt "@label"
msgid "The <a href=\"%1\">key</a> was expired."
msgstr "A <a href=\"%1\">chave</a> caducou."

#. +> trunk6
#: hashhelper.cpp:89
#, kde-format
msgctxt "@label"
msgid "The signature is valid, but the <a href=\"%1\">key</a>'s validity is unknown."
msgstr "A sinatura é correcta, pero descoñécese a validez da <a href=\"%1\">chave</a>."

#. +> trunk6
#: hashhelper.cpp:91
#, kde-format
msgctxt "@label"
msgid "The signature is valid and the <a href=\"%1\">key</a> is marginally trusted."
msgstr "A sinatura é correcta e a <a href=\"%1\">chave</a> é de confianza marxinal."

#. +> trunk6
#: hashhelper.cpp:93
#, kde-format
msgctxt "@label"
msgid "The signature is valid and the <a href=\"%1\">key</a> is fully trusted."
msgstr "A sinatura é correcta e a <a href=\"%1\">chave</a> é de confianza absoluta."

#. +> trunk6
#: hashhelper.cpp:95
#, kde-format
msgctxt "@label"
msgid "The signature is valid and the <a href=\"%1\">key</a> is ultimately trusted."
msgstr "A sinatura é correcta e a <a href=\"%1\">chave</a> é de confianza total."

#. +> trunk6
#: hashhelper.cpp:97
#, kde-format
msgctxt "@label"
msgid "The signature is valid, but the <a href=\"%1\">key</a> is untrusted."
msgstr "A sinatura é correcta, pero a <a href=\"%1\">chave</a> non é de confianza."

#. +> trunk6
#: hashhelper.cpp:101
#, kde-format
msgctxt "@label"
msgid "The signature is invalid."
msgstr "A sinatura é incorrecta."

