msgid "Generate checksums"
msgstr "Xere sumas de comprobación."

#. (itstool) path: screenshot/caption
#. +> trunk6
#: org.kde.hashomatic.metainfo.xml:44
msgid "Compare two files"
msgstr "Compare dous ficheiros."

#. (itstool) path: screenshot/caption
#. +> trunk6
#: org.kde.hashomatic.metainfo.xml:48
msgid "Verify the validity of a file"
msgstr "Verifique a validez dun ficheiro."
