#, kde-format
msgid "Logout canceled by '%1'"
msgstr "«%1» cancelou a saída."

#. +> trunk6
#: logout.cpp:371
#, kde-format
msgctxt "@info:status"
msgid "Session is exiting"
msgstr "A sesión está saíndo."

#. +> trunk6 stable6 stable5
#: main.cpp:66
#, kde-format
msgid "$HOME not set!"
msgstr "$HOME non está definida."

#. +> trunk6 stable6 stable5
#: main.cpp:70 main.cpp:79
#, kde-format
msgid "$HOME directory (%1) does not exist."
msgstr "O cartafol persoal (%1) non existe."

#. +> trunk6 stable6
#: main.cpp:73
#, kde-kuit-format
msgctxt "@info"
msgid "No write access to $HOME directory (%1). If this is intentional, set <envar>KDE_HOME_READONLY=1</envar> in your environment."
msgstr "Non ten acceso de escritura ao cartafol $HOME (%1). Se isto é intencional, defina <envar>KDE_HOME_READONLY=1</envar> no contorno."

#. +> trunk6 stable6 stable5
#: main.cpp:81
#, kde-format
msgid "No read access to $HOME directory (%1)."
msgstr "Non dispón de acceso de lectura ao cartafol persoal (%1)."

#. +> stable5
#: main.cpp:124
#, kde-format
msgid "No write access to $HOME directory (%1)."
msgstr "Non dispón de acceso de escritura ao cartafol persoal (%1)."

#. +> trunk6 stable6 stable5
#: main.cpp:86
#, kde-format
msgid "$HOME directory (%1) is out of disk space."
msgstr "Non queda espazo libre no cartafol persoal (%1)."

#. +> trunk6 stable6 stable5
#: main.cpp:89
#, kde-format
msgid "Writing to the $HOME directory (%2) failed with the error '%1'"
msgstr "A escritura no cartafol $HOME (%2) fallou cun erro «%1»."

#. +> trunk6 stable6 stable5
#: main.cpp:103 main.cpp:142
#, kde-format
msgid "No write access to '%1'."
msgstr "Non ten acceso de escritura a «%1»."

#. +> trunk6 stable6 stable5
#: main.cpp:105 main.cpp:144
#, kde-format
msgid "No read access to '%1'."
msgstr "Non ten acceso de lectura a «%1»."

#. +> trunk6 stable6 stable5
#: main.cpp:115 main.cpp:129
#, kde-format
msgid "Temp directory (%1) is out of disk space."
msgstr "Non queda espazo libre no cartafol temporal (%1)."

#. +> trunk6 stable6 stable5
#: main.cpp:118 main.cpp:132
#, kde-format
msgid ""
"Writing to the temp directory (%2) failed with\n"
"    the error '%1'"
msgstr "A escritura no cartafol temporal (%2) fallou co erro «%1»."

#. +> trunk6 stable6 stable5
#: main.cpp:149
#, kde-format
msgid ""
"The following installation problem was detected\n"
"while trying to start Plasma:"
msgstr "Detectouse o seguinte problema de instalación ao intentar iniciar Plasma:"

#. +> trunk6 stable6 stable5
#: main.cpp:152
#, kde-format
msgid ""
"\n"
"\n"
"Plasma is unable to start.\n"
msgstr ""
"\n"
"\n"
"Non é posíbel iniciar Plasma.\n"

#. +> trunk6 stable6 stable5
#: main.cpp:159
#, kde-format
msgid "Plasma Workspace installation problem!"
msgstr "Detectouse un problema na instalación do espazo de traballo de Plasma!"

#. +> trunk6 stable6 stable5
#: main.cpp:194
#, kde-format
msgid ""
"The reliable Plasma session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"O xestor de sesións de Plasma que conversa co protocolo estándar de\n"
"X11R6 para xestión de sesións (XSMP)."

#. +> trunk6 stable6 stable5
#: main.cpp:198
#, kde-format
msgid "Restores the saved user session if available"
msgstr "Restaura a sesión de persoa usuaria gardada se está dispoñíbel."

#. +> trunk6 stable6 stable5
#: main.cpp:201
#, kde-format
msgid "Also allow remote connections"
msgstr "Permitir tamén conexións remotas"

#. +> trunk6 stable6 stable5
#: main.cpp:204
#, kde-format
msgid "Starts the session in locked mode"
msgstr "Inicia a sesión no modo trancado"

#. +> trunk6 stable6 stable5
#: main.cpp:208
#, kde-format
msgid "Starts without lock screen support. Only needed if other component provides the lock screen."
msgstr "Inicia sen a funcionalidade de bloquear a pantalla. Só é necesario se outro compoñente xa fornece esa funcionalidade."

#. +> trunk6 stable6
#: server.cpp:778
#, kde-format
msgctxt "@label an unknown executable is using resources"
msgid "[unknown]"
msgstr "(descoñecido)"

#. +> trunk6 stable6
#: server.cpp:801
#, kde-kuit-format
msgctxt "@label notification; %1 is a list of executables"
msgid ""
"Unable to manage some apps because the system's session management resources are exhausted. Here are the top three consumers of session resources:\n"
"%1"
msgstr ""
"Non é posíbel xestionar algunhas aplicacións porque se esgotaron os recursos de xestión da sesión do sistema. Estes son os tres consumidores principais dos recursos da sesión:\n"
"%1"

#. +> stable5
#: server.cpp:853
#, kde-format
msgid "Session Management"
msgstr "Xestión de sesións"

#. +> stable5
#: server.cpp:856
#, kde-format
msgid "Log Out"
msgstr "Saír"

#. +> stable5
#: server.cpp:861
#, kde-format
msgid "Log Out Without Confirmation"
msgstr "Saír sen confirmar"

#. +> stable5
#: server.cpp:866
#, kde-format
msgid "Halt Without Confirmation"
msgstr "Deter sen confirmar"

#. +> stable5
#: server.cpp:871
#, kde-format
msgid "Reboot Without Confirmation"
msgstr "Reiniciar sen confirmar"

#. +> trunk6 stable6
#: server.cpp:1073
#, kde-kuit-format
msgctxt "@label notification; %1 is an executable name"
msgid "Unable to restore <application>%1</application> because it is broken and has exhausted the system's session restoration resources. Please report this to the app's developers."
msgstr "Non é posíbel restaurar <application>%1</application> porque rompeu e esgotou os recursos de restauración da sesión do sistema. Informe disto ao equipo desenvolvedor da aplicación."

