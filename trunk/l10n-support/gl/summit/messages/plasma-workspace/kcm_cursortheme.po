#: cursorthemesettings.kcfg:9
#, kde-format
msgid "Name of the current cursor theme"
msgstr "Nome do tema de cursores actual."

#. i18n: ectx: label, entry (cursorSize), group (Mouse)
#. +> trunk6 stable6 stable5
#: cursorthemesettings.kcfg:13
#, kde-format
msgid "Current cursor size"
msgstr "Tamaño de cursor actual"

#. +> trunk6 stable6 stable5
#: kcmcursortheme.cpp:314
#, kde-format
msgid "You have to restart the Plasma session for these changes to take effect."
msgstr "Debe reiniciar a sesión de Plasma para que estes cambios xurdan efecto."

#. +> trunk6 stable6 stable5
#: kcmcursortheme.cpp:388
#, kde-format
msgid "Unable to create a temporary file."
msgstr "Non é posíbel crear un ficheiro temporal."

#. +> trunk6 stable6 stable5
#: kcmcursortheme.cpp:399
#, kde-format
msgid "Unable to download the icon theme archive: %1"
msgstr "Non é posíbel descargar o arquivo «%1» de tema do iconas."

#. +> trunk6 stable6 stable5
#: kcmcursortheme.cpp:430
#, kde-format
msgid "The file is not a valid icon theme archive."
msgstr "O ficheiro non é un arquivo de tema de iconas correcto."

# skip-rule: trasno-icon
#. +> trunk6 stable6 stable5
#: kcmcursortheme.cpp:437
#, kde-format
msgid "Failed to create 'icons' folder."
msgstr "Non foi posíbel crear o cartafol «icons»."

#. +> trunk6 stable6 stable5
#: kcmcursortheme.cpp:446
#, kde-format
msgid "A theme named %1 already exists in your icon theme folder. Do you want replace it with this one?"
msgstr "Xa existe un tema chamado %1 no cartafol de temas de iconas. Quere substituílo con este outro?"

#. +> trunk6 stable6 stable5
#: kcmcursortheme.cpp:450
#, kde-format
msgid "Overwrite Theme?"
msgstr "Quere sobrescribir o tema?"

#. +> trunk6 stable6 stable5
#: kcmcursortheme.cpp:474
#, kde-format
msgid "Theme installed successfully."
msgstr "O tema instalouse."

#. i18n: ectx: label, entry (cursorTimeout), group (BusyCursorSettings)
#. i18n: ectx: label, entry (taskbarTimeout), group (TaskbarButtonSettings)
#. +> trunk6 stable6 stable5
#: launchfeedbacksettings.kcfg:19 launchfeedbacksettings.kcfg:33
#, kde-format
msgid "Timeout in seconds"
msgstr "Tempo límite en segundos"

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:44
#, kde-format
msgid "The requested size '%1' is not available, using %2 instead."
msgstr "O tamaño solicitado, «%1», non está dispoñíbel, estase usando «%2» no seu lugar."

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:65
#, kde-format
msgid "This tool allows you to set the mouse cursor theme for the current Plasma session, without accidentally setting it to one that is either not available, or which is already set."
msgstr "Esta ferramenta permítelle definir o tema de cursores para a sesión actual de Plasma, sen definir accidentalmente unha que non estea dispoñíbel ou xa estea definida."

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:69
#, kde-format
msgid "The name of the cursor theme you wish to set for your current Plasma session (passing a full path will only use the last part of the path)"
msgstr "O nome do tema de cursores que quere definir para a sesión de Plasma actual (se indica unha ruta completa só se usará a última parte da ruta)."

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:70
#, kde-format
msgid "Show all the themes available on the system (and which is the current theme)"
msgstr "Amosar todos os temas dispoñíbeis no sistema (e cal é o actual)."

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:71
#, kde-format
msgid "Use a specific size, rather than the theme default size"
msgstr "Usar un tamaño específico en vez do predeterminado do tema."

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:92
#, kde-format
msgid "The requested theme \"%1\" is already set as the theme for the current Plasma session."
msgstr "O tema solicitado, «%1», xa está definido como o tema da sesión de Plasma actual."

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:103
#, kde-format
msgid "Successfully applied the mouse cursor theme %1 to your current Plasma session"
msgstr "Aplicouse o tema de cursores %1 á sesión actual de Plasma."

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:105
#, kde-format
msgid "You have to restart the Plasma session for your newly applied mouse cursor theme to display correctly."
msgstr "Debe reiniciar a sesión de Plasma para que o novo tema de cursores aplicado se amose correctamente."

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:115
#, kde-format
msgid "Could not find theme \"%1\". The theme should be one of the following options: %2"
msgstr "Non foi posíbel atopar o tema «%1». O tema debería ser unha das seguintes opcións: %2"

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:123
#, kde-format
msgid "You have the following mouse cursor themes on your system:"
msgstr "Ten os seguintes temas de cursores no sistema:"

#. +> trunk6 stable6 stable5
#: plasma-apply-cursortheme.cpp:128
#, kde-format
msgid "(Current theme for this Plasma session)"
msgstr "(o tema actual desta sesión de Plasma)"

