#: servicemenuinstaller.cpp:200
#, kde-format
msgid "Failed to copy .desktop file %1 to %2: %3"
msgstr "Non se puido copiar o ficheiro .desktop %1 a %2: %3"

#. +> trunk5 stable5
#: servicemenuinstaller.cpp:207 servicemenuinstaller.cpp:311
#, kde-format
msgid "Failed to remove directory %1"
msgstr "Non se puido retirar o directorio %1"

#. +> trunk5 stable5
#: servicemenuinstaller.cpp:213
#, kde-format
msgid "Failed to create directory %1"
msgstr "Non se puido crear o directorio %1."

#. +> trunk5 stable5
#: servicemenuinstaller.cpp:248
#, kde-format
