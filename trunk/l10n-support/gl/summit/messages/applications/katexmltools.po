#. +> trunk5 stable5
#: plugin_katexmltools.cpp:124
#, kde-format
msgid "Kate XML Tools"
msgstr "Ferramentas de XML para Kate"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:127
#, kde-format
msgid "&Insert Element..."
msgstr "&Inserir un elemento…"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:132
#, kde-format
msgid "&Close Element"
msgstr "Pe&char o elemento"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:137
#, kde-format
msgid "Assign Meta &DTD..."
msgstr "Asignar un meta &DTD…"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:454
#, kde-format
msgid "Assign Meta DTD in XML Format"
msgstr "Asignar un Meta DTD en formato XML"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:459
#, kde-format
msgid "The current file has been identified as a document of type \"%1\". The meta DTD for this document type will now be loaded."
msgstr "O ficheiro actual identificouse como un documento do tipo «%1». O meta DTD para este tipo de documento cargarase agora."

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:462
#, kde-format
msgid "Loading XML Meta DTD"
msgstr "Estase a cargar o meta DTD XML"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:493
#, kde-format
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "Non se puido abrir o ficheiro «%1». O servidor devolveu un erro."

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:495 pseudo_dtd.cpp:47 pseudo_dtd.cpp:57
#, kde-format
msgid "XML Plugin Error"
msgstr "Erro do complemento de XML"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:1016
#, kde-format
msgid "XML entities"
msgstr "Entidades XML"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:1018
#, kde-format
msgid "XML attribute values"
msgstr "Valores do atributo XML"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:1020
#, kde-format
msgid "XML attributes"
msgstr "Atributos XML"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:1023
#, kde-format
msgid "XML elements"
msgstr "Elementos XML"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:1064
#, kde-format
msgid "Insert XML Element"
msgstr "Inserir un elemento XML"

#. +> trunk5 stable5
#: plugin_katexmltools.cpp:1069
#, kde-format
msgid "Enter XML tag name and attributes (\"<\", \">\" and closing tag will be supplied):"
msgstr "Insira o nome da etiqueta XML e os seus atributos (forneceranse o «<», o «>» e a etiqueta de peche):"

#. +> trunk5 stable5
#: pseudo_dtd.cpp:45
#, kde-format
msgid "The file '%1' could not be parsed. Please check that the file is well-formed XML."
msgstr "Non se puido procesar o ficheiro «%1». Comprobe que o ficheiro contén XML correcto."

#. +> trunk5 stable5
#: pseudo_dtd.cpp:52
#, kde-format
msgid ""
"The file '%1' is not in the expected format. Please check that the file is of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse. See the Kate Plugin documentation for more information."
msgstr ""
"O ficheiro «%1» non ten o formato agardado. Comprobe que o ficheiro é deste tipo:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"Pode crear estes ficheiros con dtdparse. Consulte a documentación do complemento de Kate para máis información."

#. +> trunk5 stable5
#: pseudo_dtd.cpp:67
#, kde-format
msgid "Analyzing meta DTD..."
msgstr "Estase a analizar o meta DTD…"

#. +> trunk5 stable5
#: pseudo_dtd.cpp:67
#, kde-format
msgid "Cancel"
msgstr "Cancelar"

