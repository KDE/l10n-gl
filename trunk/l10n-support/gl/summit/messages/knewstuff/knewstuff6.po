msgstr "Non foi posíbel abrir o ficheiro de arquivo %1. O erro do que se informou foi: %2"

#. +> trunk6 trunk5
#: core/installation.cpp:465
#, kde-format
msgid "This file already exists on disk (possibly due to an earlier failed download attempt). Continuing means overwriting it. Do you wish to overwrite the existing file?"
msgstr "Este ficheiro xa existe en disco (posibelmente por un intento de descarga errado anterior). Continuar implica sobrescribilo. Quere sobrescribir o ficheiro existente?"

#. +> trunk6 trunk5
#: core/installation.cpp:468
#, kde-format
msgid "Overwrite File"
msgstr "Substituír o ficheiro"

#. +> trunk6 trunk5
#: core/installation.cpp:487
#, kde-format
msgid "Unable to move the file %1 to the intended destination %2"
msgstr "Non -e posíbel mover o ficheiro %1 ao destino desexado %2"

#. +> trunk5
#: core/installation.cpp:493
#, kde-format
msgid "The installation of %1 failed to create the expected new directory %2"
msgstr "A instalación de %1 non puido crear o novo cartafol esperado %2"

#. +> trunk6 trunk5
#: core/installation.cpp:510
#, kde-format
msgid ""
"The installation failed while attempting to run the command:\n"
"%1\n"
"\n"
"The returned output was:\n"
"%2"
msgstr ""
"A instalación fallou ao intentar executar a orde:\n"
"%1\n"
"\n"
"A saída devolta foi:\n"
"%2"

#. +> trunk6 trunk5
#: core/installation.cpp:521
#, kde-format
msgid ""
"The installation failed with code %1 while attempting to run the command:\n"
"%2\n"
"\n"
"The returned output was:\n"
"%3"
msgstr ""
"A instalación fallou co código %1 ao intentar executar a orde:\n"
"%2\n"
"\n"
"A saída devolta foi:\n"
"%3"

#. +> trunk5
#: core/installation.cpp:525
#, kde-format
msgid "The installation of %1 failed, as the service type %2 was not accepted by the system (did you forget to install the KPackage support plugin for this type of package?)"
msgstr "A instalación de %1 fallou porque o sistema non acepta o tipo de servizo %2 (esqueceu instalar o complemento de compatibilidade con KPackage para este tipo de paquete?)."

#. +> trunk5
#: core/installation.cpp:535
#, kde-format
msgid "The installation of %1 failed, as the downloaded package does not contain a correct KPackage structure."
msgstr "A instalación de %1 fallou porque o paquete descargado non contén a estrutura correcta de KPackage."

#. +> trunk5
#: core/installation.cpp:541
#, kde-format
msgid "The installation of %1 failed, as the downloaded package does not list a service type."
msgstr "A instalación de %1 fallou porque o paquete descargado non lista un tipo de servizo."

#. +> trunk5
#: core/installation.cpp:548
#, kde-format
msgid "The installation of %1 failed, as the downloaded package does not contain any useful meta information, which means it is not a valid KPackage."
msgstr "A instalación de %1 fallou porque o paquete descargado non contén metadatos útiles, o que significa que non é un paquete válido para KPackage."

#. +> trunk6 trunk5
#: core/installation.cpp:563
#, kde-format
msgid "The removal of %1 failed, as the installed file %2 could not be automatically removed. You can attempt to manually delete this file, if you believe this is an error."
msgstr "Non foi posíbel eliminar %1 porque non foi posíbel eliminar automaticamente o ficheiro instalado %2. Pode intentar eliminar o ficheiro manualmente se pensa que se trata dun erro."

#. +> trunk5
#: core/installation.cpp:900
#, kde-format
msgid "The removal of %1 failed, as the downloaded file %2 could not be automatically removed."
msgstr "Non foi posíbel eliminar %1 porque non foi posíbel eliminar automaticamente o ficheiro descargado %2."

#. +> trunk5
#: core/installation.cpp:905
#, kde-format
msgid "The removal of %1 failed, due to the installed file not being a KPackage. The file in question was %2, and you can attempt to delete it yourself, if you are certain that it is not needed."
msgstr "A eliminación de %1 fallou porque o ficheiro instalado non é un paquete de KPackage. O ficheiro en cuestión era %2, e pode intentar eliminalo se quere, se ten a certeza de que non é necesario."

#. +> trunk6 trunk5
#: core/installation.cpp:632
#, kde-format
msgid ""
"The uninstallation process failed to successfully run the command %1\n"
"The output of was: \n"
"%2\n"
"If you think this is incorrect, you can continue or cancel the uninstallation process"
msgstr ""
"O proceso de instalación non conseguir executar correctamente a orde %1.\n"
"A saída foi: \n"
"%2\n"
"Se pensa que é incorrecto, pode continuar ou cancelar o proceso de instalación."

#. +> trunk5
#: core/installation.cpp:848
#, kde-format
msgid "The removal of %1 failed, as the installed package does not contain a correct KPackage structure."
msgstr "A eliminación de %1 fallou porque o paquete instalado non contén a estrutura correcta de KPackage."

#. +> trunk5
#: core/installation.cpp:853
#, kde-format
msgid "The removal of %1 failed, as the installed package is not a supported type (did you forget to install the KPackage support plugin for this type of package?)"
msgstr "A eliminación de %1 fallou porque o paquete instalado non é dun tipo compatíbel (esqueceu instalar o complemento de compatibilidade con KPackage para este tipo de paquete?)."

#. +> trunk5
#: core/installation.cpp:860
#, kde-format
msgid "The removal of %1 failed, as the installed package does not contain any useful meta information, which means it is not a valid KPackage."
msgstr "A eliminación de %1 fallou porque o paquete instalado non contén metadatos útiles, o que significa que non é un paquete válido para KPackage."

#. +> trunk5
#: core/installation.cpp:913
#, kde-format
msgid "The removal of %1 failed, as there seems to somehow be more than one thing installed, which is not supposed to be possible for KPackage based entries."
msgstr "A eliminación de %1 fallou porque parece haber máis dunha cousa instalada, e iso non debería ser posíbel con entradas baseadas en KPackage."

