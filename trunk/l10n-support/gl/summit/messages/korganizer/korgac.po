#. +> trunk5 stable5
#: alarmdialog.cpp:174
#, kde-format
msgctxt "@title:window"
msgid "Reminders"
msgstr "Lembranzas"

#. +> trunk5 stable5
#: alarmdialog.cpp:192
#, kde-format
msgctxt "@action:button"
msgid "Dismiss Reminder"
msgstr "Descartar a lembranza"

#. +> trunk5 stable5
#: alarmdialog.cpp:194
#, kde-format
msgctxt "@info:tooltip"
msgid "Dismiss the reminders for the selected incidences"
msgstr "Descartar as lembranzas das incidencias seleccionadas"

#. +> trunk5 stable5
#: alarmdialog.cpp:196
#, kde-format
msgctxt "@info:whatsthis"
msgid "Press this button to dismiss the currently selected incidence.  All non-selected non-incidences will be unaffected."
msgstr "Prema este botón para descartar a incidencia seleccionada actualmente. Non afectará a nada que non sexa unha incidencia nin estea seleccionado."

#. +> trunk5 stable5
#: alarmdialog.cpp:199
#, kde-format
msgctxt "@action:button"
msgid "Dismiss All"
msgstr "Descartalo todo"

#. +> trunk5 stable5
#: alarmdialog.cpp:201
#, kde-format
msgctxt "@info:tooltip"
msgid "Dismiss the reminders for all listed incidences"
msgstr "Descartar as lembranzas de todas as incidencias listadas"

#. +> trunk5 stable5
#: alarmdialog.cpp:203
#, kde-format
msgctxt "@info:whatsthis"
msgid "Press this button to dismiss all the listed incidences."
msgstr "Prema este botón para descartar todas as incidencias listadas."

#. +> trunk5 stable5
#: alarmdialog.cpp:204
#, kde-format
msgctxt "@action:button"
msgid "Edit..."
msgstr "Editar…"

#. +> trunk5 stable5
#: alarmdialog.cpp:206
#, kde-format
msgctxt "@info:tooltip"
msgid "Edit the selected incidence"
msgstr "Editar a incidencia seleccionada"

#. +> trunk5 stable5
#: alarmdialog.cpp:208
#, kde-format
msgctxt "@info::whatsthis"
msgid "Press this button if you want to edit the selected incidence.  A dialog will popup allowing you to edit the incidence."
msgstr "Prema este botón se quere editar a incidencia seleccionada. Aparecerá un diálogo que lle permitirá editar a incidencia."

#. +> trunk5 stable5
#: alarmdialog.cpp:210
#, kde-format
msgctxt "@action:button"
msgid "Suspend"
msgstr "Suspender"

#. +> trunk5 stable5
#: alarmdialog.cpp:212
#, kde-format
msgctxt "@info:tooltip"
msgid "Suspend the reminders for the selected incidences by the specified interval"
msgstr "Suspender as lembranzas das incidencias seleccionadas polo intervalo especificado"

#. +> trunk5 stable5
#: alarmdialog.cpp:215
#, kde-format
msgctxt "@info:whatsthis"
msgid "Press this button to suspend the currently selected incidences.  The suspend interval is configurable by the Suspend duration settings."
msgstr "Prema este botón para suspender as incidencias seleccionadas actualmente. O intervalo de suspensión pode configurarse desde a configuración da duración da suspensión."

#. +> trunk5 stable5
#: alarmdialog.cpp:230
#, kde-format
msgctxt "@label"
msgid "Reminders: Clicking on the title toggles details for item"
msgstr "Lembranzas: Premer o título conmuta os detalles do elemento"

#. +> trunk5 stable5
#: alarmdialog.cpp:239
#, kde-format
msgctxt "@title:column reminder title"
msgid "Title"
msgstr "Título"

#. +> trunk5 stable5
#: alarmdialog.cpp:240
#, kde-format
msgctxt "@title:column happens at date/time"
msgid "Date Time"
msgstr "Data e hora"

#. +> trunk5 stable5
#: alarmdialog.cpp:241
#, kde-format
msgctxt "@title:column trigger date/time"
msgid "Trigger Time"
msgstr "Hora de activación"

#. +> trunk5 stable5
#: alarmdialog.cpp:245
#, kde-format
msgctxt "@info:tooltip"
msgid "The event or to-do title"
msgstr "Título do evento ou tarefa"

#. +> trunk5 stable5
#: alarmdialog.cpp:248
#, kde-format
msgctxt "@info:tooltip"
msgid "The reminder is set for this date/time"
msgstr "A lembranza está configurada para esta data/hora"

#. +> trunk5 stable5
#: alarmdialog.cpp:251
#, kde-format
msgctxt "@info:tooltip"
msgid "The date/time the reminder was triggered"
msgstr "Activouse a data/hora da lembranza"

#. +> trunk5 stable5
#: alarmdialog.cpp:266
#, kde-kuit-format
msgctxt "@info default incidence details string"
msgid "<emphasis>Select an event or to-do from the list above to view its details here.</emphasis>"
msgstr "<emphasis>Escolla un evento ou tarefa da lista de enriba para ver aquí os seus detalles.</emphasis>"

#. +> trunk5 stable5
#: alarmdialog.cpp:278
#, kde-format
msgctxt "@label:spinbox"
msgid "Suspend &duration:"
msgstr "&Duración da suspensión:"

#. +> trunk5 stable5
#: alarmdialog.cpp:287
#, kde-format
msgctxt "@info:tooltip"
msgid "Suspend the reminders by this amount of time"
msgstr "Suspender as lembranzas durante este tempo"

#. +> trunk5 stable5
#: alarmdialog.cpp:290
#, kde-format
msgctxt "@info:whatsthis"
msgid "Each reminder for the selected incidences will be suspended by this number of time units. You can choose the time units (typically minutes) in the adjacent selector."
msgstr "Cada unha das lembranzas das incidencias seleccionadas suspenderase durante este número de unidades de tempo. Pode escoller as unidades de tempo (o típico son minutos) no selector que hai a carón."

#. +> trunk5 stable5
#: alarmdialog.cpp:298
#, kde-format
msgctxt "@item:inlistbox suspend in terms of minutes"
msgid "minute(s)"
msgstr "minuto(s)"

#. +> trunk5 stable5
#: alarmdialog.cpp:299
#, kde-format
msgctxt "@item:inlistbox suspend in terms of hours"
msgid "hour(s)"
msgstr "hora(s)"

#. +> trunk5 stable5
#: alarmdialog.cpp:300
#, kde-format
msgctxt "@item:inlistbox suspend in terms of days"
msgid "day(s)"
msgstr "día(s)"

#. +> trunk5 stable5
#: alarmdialog.cpp:301
#, kde-format
msgctxt "@item:inlistbox suspend in terms of weeks"
msgid "week(s)"
msgstr "semana(s)"

#. +> trunk5 stable5
#: alarmdialog.cpp:304
#, kde-format
msgctxt "@info:tooltip"
msgid "Suspend the reminders using this time unit"
msgstr "Suspender as lembranzas empregando esta unidade de tempo"

#. +> trunk5 stable5
#: alarmdialog.cpp:307
#, kde-format
msgctxt "@info:whatsthis"
msgid "Each reminder for the selected incidences will be suspended using this time unit. You can set the number of time units in the adjacent number entry input."
msgstr "Cada unha das lembranzas das incidencias seleccionadas hase suspender empregando esta unidade de tempo. Pode axustar o número de unidades de tempo no campo que hai a carón."

#. +> trunk5 stable5
#: alarmdialog.cpp:316
#, kde-format
msgctxt "@action:inmenu"
msgid "Reset"
msgstr "Restaurar"

#. +> trunk5 stable5
#: alarmdialog.cpp:319
#, kde-format
msgctxt "@info:tooltip"
msgid "Reset the suspend time to the default value"
msgstr "Restaurar o valor predeterminado do tempo de suspensión."

#. +> trunk5 stable5
#: alarmdialog.cpp:321
#, kde-format
msgctxt "@info:whatsthis"
msgid "Reset the suspend time to the default value"
msgstr "Restaurar o valor predeterminado do tempo de suspensión."

#. +> trunk5 stable5
#: alarmdialog.cpp:324
#, kde-format
msgctxt "@action:inmenu"
msgid "Set as Default"
msgstr "Facer predeterminado"

#. +> trunk5 stable5
#: alarmdialog.cpp:327
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the current suspend time as the new default"
msgstr "Estabelecer o tempo actual de suspensión como o novo valor predeterminado."

#. +> trunk5 stable5
#: alarmdialog.cpp:329
#, kde-format
msgctxt "@info:whatsthis"
msgid "Press this button to set the current suspend time as the new default value"
msgstr "Prema este botón para estabelecer o valor de tempo actual de suspensión como o novo valor predeterminado."

