#. +> trunk6 stable6
#: plugins/datenums/datenums.json
msgctxt "Name"
msgid "Date Numbers Plugin for Calendars"
msgstr "Complemento para os números das datas para os calendarios"

#. +> trunk6 stable6
#: plugins/datenums/datenums.json
msgctxt "Description"
msgid "For each day this plugin shows its daynumber of the year at the top of the agenda view. For example, February 1 is day 32 of the year."
msgstr "Este complemento amosa o día do ano na vista superior da axenda. Por exemplo, o 1 de febreiro é o día 32 do ano."

#. +> trunk6 stable6
#: plugins/hebrew/hebrew.json
msgctxt "Name"
msgid "Jewish Calendar Plugin"
msgstr "Complemento para o calendario xudeu"

#. +> trunk6 stable6
#: plugins/hebrew/hebrew.json
msgctxt "Description"
msgid "Shows all dates in KOrganizer also in the Jewish calendar system."
msgstr "Amosa todas as datas en KOrganizer tamén no sistema de calendario xudeu."

#. +> trunk6 stable6
#: plugins/lunarphases/lunarphases.json
msgctxt "Name"
msgid "Lunar Phases Plugin for Calendars"
msgstr "Complemento para as fases lunares para os calendarios"

#. +> trunk6 stable6
#: plugins/lunarphases/lunarphases.json
msgctxt "Description"
msgid "This plugin shows the day's lunar phase (New, First, Last, Full)"
msgstr "O complemento amosa a fase lunar do día (lúa nova, cuarto crecente, lúa chea, cuarto minguante)."

#. +> trunk6 stable6
#: plugins/picoftheday/picoftheday.json
msgctxt "Name"
msgid "Wikipedia Picture Of the Day Plugin for Calendars"
msgstr "Complemento para a imaxe do día de Wikipedia nos calendarios"

#. +> trunk6 stable6
#: plugins/picoftheday/picoftheday.json
msgctxt "Description"
msgid "This plugin provides the Wikipedia Picture of the Day"
msgstr "Este complemento fornece a imaxe do día de Wikipedia."

# skip-rule: trasno-history
#. +> trunk6 stable6
#: plugins/thisdayinhistory/thisdayinhistory.json
msgctxt "Name"
msgid "Wikipedia 'This Day in History' Plugin"
msgstr "Complemento «Este día na historia» de Wikipedia"

# skip-rule: trasno-history
#. +> trunk6 stable6
#: plugins/thisdayinhistory/thisdayinhistory.json
msgctxt "Description"
msgid "This plugin provides links to Wikipedia's 'This Day in History' pages"
msgstr "Este complemento fornece ligazóns ás páxinas «Este día na historia» de Wikipedia."

