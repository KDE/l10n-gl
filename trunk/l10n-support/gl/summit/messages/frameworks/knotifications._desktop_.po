#: src/android_defaults.notifyrc:2
msgctxt "Name"
msgid "Fatal Error"
msgstr "Erro fatal"

#. +> trunk5
#: src/android_defaults.notifyrc:48
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Produciuse un erro grave que fixo que o programa saíse"

#. +> trunk5
#: src/android_defaults.notifyrc:97
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#. +> trunk5
#: src/android_defaults.notifyrc:144
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Ocorreu algo especial no programa"

#. +> trunk5
#: src/android_defaults.notifyrc:193
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#. +> trunk5
#: src/android_defaults.notifyrc:240
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Produciuse un erro no programa que pode causar problemas"

#. +> trunk5
#: src/android_defaults.notifyrc:289
msgctxt "Name"
msgid "Catastrophe"
msgstr "Catástrofe"

#. +> trunk5
#: src/android_defaults.notifyrc:335
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Produciuse un erro moi grave, que como mínimo fixo que o programa saíse"
