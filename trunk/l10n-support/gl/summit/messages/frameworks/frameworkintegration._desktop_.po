#. +> trunk5
#: plasma_workspace.notifyrc:52
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Lixo: Baleiro"

#. +> trunk5
#: plasma_workspace.notifyrc:99
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Baleirouse o lixo"

#. +> trunk5
#: plasma_workspace.notifyrc:150
msgctxt "Name"
msgid "Textcompletion: Rotation"
