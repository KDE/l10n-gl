#: plasma_workspace.notifyrc:387
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Hai máis dun posíbel acabamento"

#. +> trunk5
#: plasma_workspace.notifyrc:437
msgctxt "Name"
msgid "Fatal Error"
msgstr "Erro fatal"

