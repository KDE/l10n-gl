msgstr "Produciuse un erro ao crear a galería."

#. +> trunk5
#: kookapref.cpp:242
#, kde-kuit-format
msgctxt "@info"
msgid ""
"An old Kooka gallery was found at <filename>%1</filename>.<nl/>"
"The preferred new location is now <filename>%2</filename>.<nl/>"
"<nl/>"
"Do you want to create a new gallery at the new location?"
msgstr ""
"Atopouse unha galería dunha versión anterior de Kooka en <filename>%1<"
"/filename>.<nl/>"
" <nl/>"
" A ruta configurada agora é <filename>%2</filename>.<nl/>"
" <nl/>"
" Quere crear unha nova galería na nova ruta?"

#. +> trunk5
#: kookapref.cpp:246
#, kde-format
msgid "Create New Gallery"
msgstr "Crear unha galería nova"

#. +> trunk5
#: kookapref.cpp:255 kookapref.cpp:269
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Kooka will use the new gallery, <link url=\"file:%1\"><filename>%1</filename"
"></link>.<nl/>"
"<nl/>"
"If you wish to add the images from your old gallery <link url=\"file:%2\"><"
"filename>%2</filename></link>,<nl/>"
"then you may do so by simply copying or moving the files."
msgstr ""
"Kooka usará a galería nova, <link url=\"file:%1\"><filename>%1</filename><"
"/link>.<nl/>"
" <nl/>"
" Se quere engadir imaxes da galería antiga <link url=\"file:%2\"><filename>"
"%2</filename></link>,<nl/>"
" pode facelo copiando ou movendo os ficheiros."

