#. +> trunk6 stable6 stable5
#: instabilities.cpp:27
#, kde-format
msgctxt "@label"
msgid "Prefail attributes <= threshold."
msgstr "Atributos pre-fallo ≤ límite"

#. +> trunk6 stable6 stable5
#: instabilities.cpp:31
#, kde-format
msgctxt "@label"
msgid "SMART status check returned 'DISK OK' but we found that some (usage or prefail) attributes have been <= threshold at some time in the past."
msgstr "A comprobación de estado de SMART devolveu «DISK OK» (o disco está ben) pero algúns atributos (de uso ou de pre-fallo) tiveron un valor menor ou igual que o límite nalgún momento pasado."

#. +> trunk6 stable6 stable5
#: instabilities.cpp:33
#, kde-format
msgctxt "@label"
msgid "The device error log contains records of errors."
msgstr "O rexistro de erros do dispositivo ten entradas."

#. +> trunk6 stable6 stable5
#: instabilities.cpp:37
#, kde-format
msgctxt "@label"
msgid "The device self-test log contains records of errors. [ATA only] Failed self-tests outdated by a newer successful extended self-test are ignored."
msgstr "O rexistro de auto-comprobación do dispositivo ten entradas de erros. No caso de ATA, ignóranse as comprobacións falladas se se pasa unha comprobación estendida máis nova."

