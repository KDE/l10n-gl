msgid "G'Mic Settings"
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:17
msgid "G'Mic or GREYC's Magic for Image Computing is an opensource filter framework, or, it is an extra program you can download to have access to a whole lot of image filters."
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:19
msgid "Krita has had G'Mic integration for a long time, but this is its most stable incarnation."
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:21
msgid "You set it up as following:"
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:23
msgid "First download the proper krita plugin from `the G'Mic website. <http://gmic.eu/download.shtml>`_"
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:24
msgid "Then, unzip and place it somewhere you can find it."
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:25
msgid "Go to :menuselection:`Settings --> Configure Krita --> G'Mic plugin` and set G'MIC to the filepath there."
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:26
msgid "Then restart Krita."
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:30
msgid "Updates to G'Mic"
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:32
msgid "There is a refresh button at the bottom of the G'Mic window that will update your version. You will need an internet connection to download the latest version."
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:34
msgid "If you have issues downloading the update through the plugin, you can also do it manually. If you are trying to update and get an error, copy the URL that is displayed in the error dialog. It will be to a \".gmic\" file. Download it from from your web browser and place the file in one of the following directories."
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:36
msgid "Windows : %APPDATA%/gmic/update2XX.gmic"
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:37
msgid "Linux : $HOME/.config/gmic/update2XX.gmic"
msgstr ""

#. +> trunk5
#: ../../reference_manual/preferences/g_mic_settings.rst:39
msgid "Load up the G'Mic plugin and press the refresh button for the version to update."
msgstr ""
