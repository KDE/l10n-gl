msgstr "Atopouse o programa mke2fs."

#. +> trunk5 stable5
#: floppy.cpp:158 floppy.cpp:196
#, kde-format
msgid "Program mke2fs <b>not found</b>. Ext2 formatting <b>not available</b>"
msgstr "<b>Non foi posíbel atopar</b> o programa mke2fs. <b>Non poderá</b> formatar en Ext2."

#. +> trunk5 stable5
#: floppy.cpp:162 floppy.cpp:651
#, kde-format
msgid "Minix"
msgstr "Minix"

