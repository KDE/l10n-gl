#: floppy.cpp:167
#, kde-format
msgctxt "Linux"
msgid "Program mkfs.minix <b>not found</b>. Minix formatting <b>not available</b>"
msgstr "<b>Non foi posíbel atopar</b> o programa mkfs.minix. <b>Non poderá</b> formatar en Minix."

#. +> trunk5 stable5
#: floppy.cpp:171
#, kde-format
msgctxt "BSD"
msgid "KFloppy supports two file formats under BSD: MS-DOS and UFS"
msgstr "KFloppy é compatíbel con dous formatos de ficheiro en BSD: MS-DOS e UFS."

