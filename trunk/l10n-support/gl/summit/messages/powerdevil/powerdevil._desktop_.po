#. +> trunk6 stable6 stable5
#: daemon/chargethreshold_helper_actions.actions:62
msgctxt "Name"
msgid "Get current battery charge limit"
msgstr "Obter o límite actual de carga da batería"

#. +> trunk6 stable6
#: daemon/chargethreshold_helper_actions.actions:108
msgctxt "Description"
msgid "Authenticate to see the current battery charge limit."
msgstr "Autentíquese para ver o límite actual de carga da batería."

#. +> stable5
#: daemon/chargethreshold_helper_actions.actions:101
msgctxt "Description"
msgid "System policies prevent you from getting the current battery charge limit."
msgstr "As políticas do sistema evitan que coñeza o límite actual de carga da batería."

#. +> trunk6 stable6 stable5
#: daemon/chargethreshold_helper_actions.actions:151
msgctxt "Name"
msgid "Set battery charge limit"
msgstr "Definir o límite de carga da batería"

#. +> trunk6 stable6
#: daemon/chargethreshold_helper_actions.actions:197
msgctxt "Description"
msgid "Authenticate to set the battery charge limit."
msgstr "Autentíquese para definir o límite de carga da batería."

#. +> stable5
#: daemon/chargethreshold_helper_actions.actions:188
msgctxt "Description"
msgid "System policies prevent you from setting a battery charge limit."
msgstr "As políticas do sistema impídenlle definir o límite de carga da batería."

#. +> trunk6 stable6
#: daemon/chargethreshold_helper_actions.actions:240
msgctxt "Name"
msgid "Check battery conservation mode"
msgstr "Comprobar o modo de conservación da batería"

#. +> trunk6 stable6
#: daemon/chargethreshold_helper_actions.actions:272
msgctxt "Description"
msgid "Authenticate to check the current state of battery conservation mode."
msgstr "Autenticarse para comprobar o estado actual do modo de conservación da batería."

#. +> trunk6 stable6
#: daemon/chargethreshold_helper_actions.actions:308
msgctxt "Name"
msgid "Set battery conservation mode"
msgstr "Definir o modo de conservación da batería"

#. +> trunk6 stable6
#: daemon/chargethreshold_helper_actions.actions:340
msgctxt "Description"
msgid "Authenticate to set the battery conservation mode."
msgstr "Autenticarse para definir o modo de conservación da batería."

#. +> trunk6 stable6 stable5
#: daemon/controllers/backlight_helper_actions.actions:62
msgctxt "Name"
msgid "Get maximum brightness value"
msgstr "Obter o valor de brillo máximo"

#. +> trunk6 stable6
#: daemon/controllers/backlight_helper_actions.actions:118
msgctxt "Description"
msgid "Authenticate to see the maximum brightness level."
msgstr "Autentíquese para ver o nivel máximo de brillo."

#. +> trunk6 stable6 stable5
#: daemon/controllers/backlight_helper_actions.actions:161
msgctxt "Name"
msgid "Get brightness"
msgstr "Obter o brillo"

#. +> trunk6 stable6
#: daemon/controllers/backlight_helper_actions.actions:217
msgctxt "Description"
msgid "Authenticate to see the brightness level."
msgstr "Autentíquese para ver o nivel de brillo."

#. +> trunk6 stable6 stable5
#: daemon/controllers/backlight_helper_actions.actions:260
msgctxt "Name"
msgid "Set brightness"
msgstr "Definir o brillo"

#. +> trunk6 stable6
#: daemon/controllers/backlight_helper_actions.actions:316
msgctxt "Description"
msgid "Authenticate to set the brightness level."
msgstr "Autentíquese para definir o nivel de brillo."

#. +> stable5
#: daemon/backends/upower/backlight_helper_actions.actions:112
#: daemon/backends/upower/backlight_helper_actions.actions:220
msgctxt "Description"
msgid "System policies prevent you from getting the brightness level."
msgstr "As políticas do sistema evitan que coñeza o nivel de brillo."

#. +> stable5
#: daemon/backends/upower/backlight_helper_actions.actions:328
msgctxt "Description"
msgid "System policies prevent you from setting the brightness level."
msgstr "As políticas do sistema evitan que modifique o nivel de brillo."

#. +> trunk6 stable6 stable5
#: daemon/controllers/backlight_helper_actions.actions:358
msgctxt "Name"
msgid "Get syspath"
msgstr "Obter syspath"

#. +> trunk6 stable6
#: daemon/controllers/backlight_helper_actions.actions:412
msgctxt "Description"
msgid "Authenticate to see the syspath."
msgstr "Autentíquese para ver a ruta do sistema."

#. +> stable5
#: daemon/backends/upower/backlight_helper_actions.actions:432
msgctxt "Description"
msgid "System policies prevent you from getting the syspath"
msgstr "As políticas do sistema evitan que coñeza a ruta do sistema."

#. +> trunk6 stable6
#: daemon/discretegpu_helper_actions.actions:62
msgctxt "Name"
msgid "Check for existence of discrete GPU"
msgstr "Comprobar se se dispón dun procesador gráfico discreto"

#. +> trunk6 stable6
#: daemon/discretegpu_helper_actions.actions:101
msgctxt "Description"
msgid "Authenticate to check for the existence of a discrete GPU."
msgstr "Autentíquese para comprobar se dispón dun procesador gráfico discreto."

#. +> trunk6 stable6 stable5
#: daemon/powerdevil.desktop.cmake:4 powerdevil.notifyrc:2
msgctxt "Name"
msgid "Power Management"
msgstr "Xestión da enerxía"

#. +> trunk6 stable6 stable5
#: daemon/powerdevil.desktop.cmake:65
msgctxt "Comment"
msgid "Battery, Display and CPU power management and notification"
msgstr "Xestión e notificacións da xestión enerxética da batería, da pantalla e do procesador."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:58
msgctxt "Comment"
msgid "Power Management System"
msgstr "Sistema de xestión da enerxía."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:116
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:171
msgctxt "Comment"
msgid "Used for warning notifications"
msgstr "Úsase para as notificacións de aviso."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:228
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:284
msgctxt "Comment"
msgid "Used for standard notifications"
msgstr "Úsase para as notificacións estándar."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:341
msgctxt "Name"
msgid "Critical notification"
msgstr "Notificación crítica"

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:396
msgctxt "Comment"
msgid "Notifies a critical event"
msgstr "Notifica un evento crítico."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:453
msgctxt "Name"
msgid "Battery Low"
msgstr "Batería baixa"

#. +> trunk6
#: powerdevil.notifyrc:508
msgctxt "Comment"
msgid "Battery has reached low level"
msgstr "A batería acadou o nivel de carga baixa."

#. +> stable6 stable5
#: powerdevil.notifyrc:508
msgctxt "Comment"
msgid "Your battery has reached low level"
msgstr "A batería acadou o nivel de carga baixa."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:534
msgctxt "Name"
msgid "Battery Critical"
msgstr "Batería no nivel crítico"

#. +> trunk6
#: powerdevil.notifyrc:589
msgctxt "Comment"
msgid "Battery has reached critical level. This notification triggers a countdown before doing the configured action, hence it is strongly advised to leave it on."
msgstr "A batería acadou o nivel crítico. Esta notificación activa unha conta-atrás previa a realizar a acción configurada, polo que se recomenda que a deixe seguir."

#. +> stable6 stable5
#: powerdevil.notifyrc:624
msgctxt "Comment"
msgid "Your battery has reached critical level. This notification triggers a countdown before doing the configured action, hence it is strongly advised to leave that on."
msgstr "A batería acadou o nivel crítico. Esta notificación activa unha conta-atrás previa a realizar a acción configurada, polo que se recomenda que a deixe seguir."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:616
msgctxt "Name"
msgid "Charge Complete"
msgstr "Carga completa"

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:670
msgctxt "Comment"
msgid "The battery is fully charged"
msgstr "A batería ten a carga completa."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:730
msgctxt "Name"
msgid "Peripheral Battery Low"
msgstr "Batería de periférico baixa"

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:782
msgctxt "Comment"
msgid "The battery in a connected device, such as mouse or keyboard, is low"
msgstr "A batería dun dispositivo conectado, como pode ser un rato ou un teclado, está baixa."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:840
msgctxt "Name"
msgid "Power source connected"
msgstr "Conectouse unha fonte de electricidade"

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:886
msgctxt "Comment"
msgid "The power source has been connected"
msgstr "Conectouse unha fonte de electricidade."

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:938
msgctxt "Name"
msgid "Power source disconnected"
msgstr "Desconectouse a fonte de electricidade"

#. +> trunk6 stable6 stable5
#: powerdevil.notifyrc:984
msgctxt "Comment"
msgid "The power source has been disconnected"
msgstr "Desconectouse a fonte de electricidade."

#. +> stable5
#: daemon/backends/upower/discretegpu_helper_actions.actions:59
msgctxt "Name"
msgid "Check existence of discrete gpu"
msgstr "Comprobar se dispón dun procesador gráfico discreto"

#. +> stable5
#: daemon/backends/upower/discretegpu_helper_actions.actions:106
msgctxt "Description"
msgid "System policies prevent you from checking the existence of discrete gpu."
msgstr "As políticas do sistema impídenlle comprobar se se dispón dun procesador gráfico discreto."

#. +> stable5
#: daemon/backends/upower/powerdevilupowerbackend.desktop:7
msgctxt "Name"
msgid "UPower PowerDevil Backend"
msgstr "Motor de UPower para PowerDevil"

#. +> stable5
#: daemon/backends/upower/powerdevilupowerbackend.desktop:57
msgctxt "Comment"
msgid "Use KDE Power Management system through freedesktop.org upower daemon"
msgstr "Usa o sistema de xestión de enerxía de KDE mediante o servizo de upower de freedesktop.org."

