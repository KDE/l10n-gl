msgstr "10%"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:57
#, kde-format
msgctxt "@title:group"
msgid "Battery Levels"
msgstr "Niveis de batería"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:65
#, kde-format
msgctxt "@label:spinbox Low battery level percentage for the main power supply battery"
msgid "&Low level:"
msgstr "Nivel &baixo:"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:73
#, kde-format
msgctxt "@accessible:name:spinbox"
msgid "Low battery level"
msgstr "Nivel baixo da batería"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:98
#, kde-format
msgctxt "@info:whatsthis"
msgid "The battery charge will be considered low when it drops to this level. Settings for low battery will be used instead of regular battery settings."
msgstr "A carga da batería considerarase baixa cando baixe a este nivel. A configuración da batería baixa usarase en vez da configuración de batería normal."

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:105
#, kde-format
msgctxt "@label:spinbox Critical battery level percentage for the main power supply battery"
msgid "Cr&itical level:"
msgstr "Nivel crít&ico:"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:113
#, kde-format
msgctxt "@accessible:name:spinbox"
msgid "Critical battery level"
msgstr "Nivel crítico de batería"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:138
#, kde-format
msgctxt "@info:whatsthis"
msgid "The battery charge will be considered critical when it drops to this level. After a brief warning, the system will automatically suspend or shut down, according to the configured critical battery level action."
msgstr "A carga da batería considerarase crítica cando baixe a este nivel. Tras unha breve advertencia, o sistema suspenderase ou apagarase automaticamente segundo a acción configurada do nivel de batería crítico."

#. +> trunk6
#: ui/GlobalConfig.qml:147
#, kde-format
msgctxt "@info:status"
msgid "The action you had previously configured for reaching the critical battery level is now unsupported on your system. Please select a different one."
msgstr "O seu sistema xa non permite a acción que configurara para cando se acadase o nivel crítico de batería. Seleccione outra."

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:154
#, kde-format
msgctxt "@label:combobox Power action such as sleep/hibernate that will be executed when the critical battery level is reached"
msgid "A&t critical level:"
msgstr "No nivel crí&tico:"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:156
#, kde-format
msgctxt "@accessible:name:combobox"
msgid "Action performed at critical battery level"
msgstr "Acción para realizar no nivel de batería crítico"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:181
#, kde-format
msgctxt "@label:spinbox Low battery level percentage for peripheral devices"
msgid "Low level for peripheral d&evices:"
msgstr "Nivel baixo para dispositivos p&eriféricos:"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:189
#, kde-format
msgctxt "@accessible:name:spinbox"
msgid "Low battery level for peripheral devices"
msgstr "Nivel de batería baixo para dispositivos periféricos"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:214
#, kde-format
msgctxt "@info:whatsthis"
msgid "The battery charge for peripheral devices will be considered low when it reaches this level."
msgstr "Considerarase que a carga de batería dos dispositivos periféricos será baixa cando acade este nivel."

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:222
#, kde-format
msgctxt "@title:group"
msgid "Charge Limit"
msgstr "Límite de carga"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:231
#, kde-format
msgctxt "@label:spinbox Battery will stop charging when this charge percentage is reached"
msgid "&Stop charging at:"
msgstr "Dei&xar de cargar ao chegar ao:"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:257
#, kde-format
msgctxt "@label:spinbox Battery will start charging again when this charge percentage is reached, after having hit the stop-charging threshold earlier"
msgid "Start charging once &below:"
msgstr "Comezar a cargar cando &baixe de:"

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:314
#, kde-format
msgctxt "@info:status"
msgid "You might have to disconnect and re-connect the power source to start charging the battery again."
msgstr "Pode que teña que desconectar e volver conectar a fonte de electricidade para comezar a cargar de novo a batería."

#. +> trunk6 stable6
#: ui/GlobalConfig.qml:324
#, kde-format
msgctxt "@info"
msgid "Regularly charging the battery close to 100%, or fully discharging it, may accelerate deterioration of battery health. By limiting the maximum battery charge, you can help extend the battery lifespan."
msgstr "Cargar habitualmente a batería ata preto do 100%, ou descargala completamente, pode acelerar a deterioración da batería. Liminar a batería máxima pode axudar a ampliar a vida útil da batería."

