#. +> trunk5 stable5
#: ktorrent/org.kde.ktorrent.desktop:2
#: plasma/applet/plasma-applet-ktorrent.desktop:3
#: plasma/dataengine/plasma-dataengine-ktorrent.desktop:2
msgctxt "Name"
msgid "KTorrent"
msgstr "KTorrent"

#. +> trunk5 stable5
#: ktorrent/org.kde.ktorrent.desktop:60
msgctxt "GenericName"
msgid "BitTorrent Client"
msgstr "Cliente de BitTorrent"

#. +> trunk5 stable5
#: ktorrent/org.kde.ktorrent.desktop:125
msgctxt "Comment"
msgid "A BitTorrent program by KDE"
msgstr "Un programa BitTorrent de KDE"

#. +> trunk5 stable5
#: plasma/applet/plasma-applet-ktorrent.desktop:62
msgctxt "Comment"
msgid "Plasma widget to keep track of a single torrent"
msgstr "Trebello para seguir un torrente."

#. +> trunk5 stable5
#: plasma/dataengine/plasma-dataengine-ktorrent.desktop:60
msgctxt "Comment"
msgid "KTorrent data engine, for getting information from KTorrent"
msgstr "Motor de datos de KTorrent, para obter información de KTorrent."

#. +> trunk5 stable5
#: plugins/bwscheduler/ktorrent_bwscheduler.desktop:2
msgctxt "Name"
msgid "Scheduler"
msgstr "Planificador"

#. +> trunk5 stable5
#: plugins/bwscheduler/ktorrent_bwscheduler.desktop:49
msgctxt "Comment"
msgid "Schedule upload and download limits over a period of a week"
msgstr "Planificar os límites de envío e descarga dun período semanal."

#. +> trunk5 stable5
#: plugins/downloadorder/ktorrent_downloadorder.desktop:2
msgctxt "Name"
msgid "Download Order"
msgstr "Orde de descarga"

#. +> trunk5 stable5
#: plugins/downloadorder/ktorrent_downloadorder.desktop:52
msgctxt "Comment"
msgid "Specify the download order of a multi-file torrent"
msgstr "Indicar a orde de descarga dos ficheiros dun torrente."

#. +> trunk5 stable5
#: plugins/infowidget/ktorrent_infowidget.desktop:2
msgctxt "Name"
msgid "Information Widget"
msgstr "Trebello de información"

#. +> trunk5 stable5
#: plugins/infowidget/ktorrent_infowidget.desktop:52
msgctxt "Comment"
msgid "Displays general information about a torrent in several tabs"
msgstr "Mostrar información sobre un torrente en varios separadores"

#. +> trunk5 stable5
#: plugins/ipfilter/ktorrent_ipfilter.desktop:2
msgctxt "Name"
msgid "IP Filter"
msgstr "Filtro de IP"

#. +> trunk5 stable5
#: plugins/ipfilter/ktorrent_ipfilter.desktop:53
msgctxt "Comment"
msgid "Filter IP addresses through a blocklist"
msgstr "Filtrar os enderezos IP mediante unha lista de bloqueos."

#. +> trunk5 stable5
#: plugins/logviewer/ktorrent_logviewer.desktop:2
msgctxt "Name"
msgid "Log Viewer"
msgstr "Visor do rexistro"

#. +> trunk5 stable5
#: plugins/logviewer/ktorrent_logviewer.desktop:55
msgctxt "Comment"
msgid "Displays the logging output"
msgstr "Mostra o rexistro da saída."

#. +> trunk5 stable5
#: plugins/magnetgenerator/ktorrent_magnetgenerator.desktop:2
msgctxt "Name"
msgid "Magnet Generator"
msgstr "Xerador de magnets"

#. +> trunk5 stable5
#: plugins/magnetgenerator/ktorrent_magnetgenerator.desktop:46
msgctxt "Comment"
msgid "Generates magnet links"
msgstr "Xera ligazóns magnet."

#. +> trunk5 stable5
#: plugins/mediaplayer/ktorrent_mediaplayer.desktop:2
msgctxt "Name"
msgid "Media Player"
msgstr "Reprodutor"

#. +> trunk5 stable5
#: plugins/mediaplayer/ktorrent_mediaplayer.desktop:56
msgctxt "Comment"
msgid "Phonon-based media player"
msgstr "Reprodutor de imaxe e son baseado en Phonon."

#. +> trunk5 stable5
#: plugins/scanfolder/ktorrent_scanfolder.desktop:2
msgctxt "Name"
msgid "Scan Folder"
msgstr "Exame de cartafoles"

#. +> trunk5 stable5
#: plugins/scanfolder/ktorrent_scanfolder.desktop:53
msgctxt "Comment"
msgid "Scan folders for torrent files and load them"
msgstr "Examina cartafoles na busca de ficheiros torrent e os carga."

#. +> trunk5 stable5
#: plugins/scripting/ktorrent_scripting.desktop:2
msgctxt "Name"
msgid "Scripting"
msgstr "Scripts"

#. +> trunk5 stable5
#: plugins/scripting/ktorrent_scripting.desktop:52
msgctxt "Comment"
msgid "Enables Kross scripting support"
msgstr "Permite o uso de scripts escritos en Kross."

#. +> trunk5 stable5
#: plugins/scripting/scripts/auto_remove/auto_remove.desktop:2
msgctxt "Name"
msgid "Automatic Remove"
msgstr "Retiro automático"

#. +> trunk5 stable5
#: plugins/scripting/scripts/auto_remove/auto_remove.desktop:52
msgctxt "Comment"
msgid ""
"Script to automatically remove torrents when they finish downloading or"
" seeding"
msgstr ""
"Un script para retirar os torrentes automaticamente cando remate a súa"
" descarga ou espallamento."

#. +> trunk5 stable5
#: plugins/scripting/scripts/auto_resume/auto_resume.desktop:2
msgctxt "Name"
msgid "Automatic Resume"
msgstr "Continuación automática"

#. +> trunk5 stable5
#: plugins/scripting/scripts/auto_resume/auto_resume.desktop:53
msgctxt "Comment"
msgid ""
"Script to automatically resume after some time, when the suspended state is"
" enabled"
msgstr ""
"Un script para continuar automaticamente despois dun tempo, cando se activa o"
" estado de suspensión."

#. +> trunk5 stable5
#: plugins/scripting/scripts/email_notifications/email_notifications.desktop:2
msgctxt "Name"
msgid "E-Mail Notifications"
msgstr "Notificacións por correo"

#. +> trunk5 stable5
#: plugins/scripting/scripts/email_notifications/email_notifications.desktop:53
msgctxt "Comment"
msgid "Script to notify you of events via e-mail"
msgstr "Un script para notificarlle por correo os sucesos."

#. +> trunk5 stable5
#: plugins/scripting/scripts/tracker_groups/tracker_groups.desktop:2
msgctxt "Name"
msgid "Tracker Grouping"
msgstr "Agrupamento por localizador"

#. +> trunk5 stable5
#: plugins/scripting/scripts/tracker_groups/tracker_groups.desktop:51
msgctxt "Comment"
msgid "Script to create automatic groups based upon tracker URLs"
msgstr ""
"Un script para crear grupos automaticamente baseados no URL dos localizadores."

#. +> trunk5 stable5
#: plugins/search/ktorrent_search.desktop:2
msgctxt "Name"
msgid "Search"
msgstr "Busca"

#. +> trunk5 stable5
#: plugins/search/ktorrent_search.desktop:55
msgctxt "Comment"
msgid "Search for torrents"
msgstr "Buscar torrentes."

#. +> trunk5 stable5
#: plugins/shutdown/ktorrent_shutdown.desktop:2
msgctxt "Name"
msgid "Shutdown"
msgstr "Apagado"

#. +> trunk5 stable5
#: plugins/shutdown/ktorrent_shutdown.desktop:56
msgctxt "Comment"
msgid "Allows you to shutdown your computer when torrents finish"
msgstr "Permite apagar o computador cando rematan os torrentes."

#. +> trunk5 stable5
#: plugins/stats/ktorrent_stats.desktop:3
msgctxt "Name"
msgid "Statistics"
msgstr "Estatísticas"

#. +> trunk5 stable5
#: plugins/stats/ktorrent_stats.desktop:57
msgctxt "Comment"
msgid "Shows statistics about torrents in several graphs"
msgstr "Mostra estatísticas sobre os torrentes en varios gráficos."

#. +> trunk5 stable5
#: plugins/syndication/ktorrent_syndication.desktop:2
msgctxt "Name"
msgid "Syndication"
msgstr "Sindicación"

#. +> trunk5 stable5
#: plugins/syndication/ktorrent_syndication.desktop:50
msgctxt "Comment"
msgid "Syndication plugin for KTorrent, supporting RSS and Atom feeds"
msgstr ""
"Complemento de sindicación para KTorrent compatíbel con fontes RSS e Atom."

#. +> trunk5 stable5
#: plugins/upnp/ktorrent_upnp.desktop:2
msgctxt "Name"
msgid "UPnP"
msgstr "UPnP"

#. +> trunk5 stable5
#: plugins/upnp/ktorrent_upnp.desktop:54
msgctxt "Comment"
msgid "Forward ports using UPnP"
msgstr "Reencamiñar portos mediante UPnP."

#. +> trunk5 stable5
#: plugins/webinterface/ktwebinterfaceplugin.desktop:2
msgctxt "Name"
msgid "Web Interface"
msgstr "Interface web"

#. +> trunk5 stable5
#: plugins/webinterface/ktwebinterfaceplugin.desktop:56
msgctxt "Comment"
msgid "Allows control of KTorrent via a web interface"
msgstr "Permite controlar KTorrent mediante unha interface web."

#. +> trunk5 stable5
#: plugins/zeroconf/ktorrent_zeroconf.desktop:2
msgctxt "Name"
msgid "Zeroconf"
msgstr "Zeroconf"

#. +> trunk5 stable5
#: plugins/zeroconf/ktorrent_zeroconf.desktop:53
msgctxt "Comment"
msgid "Discover peers on the local network using the Zeroconf protocol"
msgstr "Descubrir parceiros na rede local mediante o protocolo Zeroconf."
