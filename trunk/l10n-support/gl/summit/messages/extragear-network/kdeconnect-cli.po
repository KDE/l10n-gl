#. +> trunk5 stable5
#: kdeconnect-cli.cpp:44
#, kde-format
msgid "KDE Connect CLI tool"
msgstr "Ferramenta da liña de ordes de KDE Connect"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:46
#, kde-format
msgid "(C) 2015 Aleix Pol Gonzalez"
msgstr "© 2015 Aleix Pol Gonzalez"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:49
#, kde-format
msgid "Aleix Pol Gonzalez"
msgstr "Aleix Pol Gonzalez"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:50
#, kde-format
msgid "Albert Vaca Cintora"
msgstr "Albert Vaca Cintora"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:52
#, kde-format
msgid "List all devices"
msgstr "Listar todos os dispositivos"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:53
#, kde-format
msgid "List available (paired and reachable) devices"
msgstr "Lista todos os dispositivos dispoñíbeis (emparellados e alcanzábel)."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:54
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices id, to ease"
" scripting"
msgstr ""
"Facer que «--list-devices» e «--list-available» só mostren os identificadores"
" dos dispositivos, para facilitar o seu uso en scripts."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:55
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices name, to ease"
" scripting"
msgstr ""
"Facer que «--list-devices» e «--list-available» só mostren os nomes dos"
" dispositivos, para facilitar o seu uso en scripts."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:56
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices id and name,"
" to ease scripting"
msgstr ""
"Facer que «--list-devices» e «--list-available» só mostren os identificadores"
" e nomes dos dispositivos, para facilitar o seu uso en scripts."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:57
#, kde-format
msgid "Search for devices in the network and re-establish connections"
msgstr "Buscar dispositivos na rede e conectarse de novo con eles."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:58
#, kde-format
msgid "Request pairing to a said device"
msgstr "Solicitar emparellarse co dispositivo indicado."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:59
#, kde-format
msgid "Find the said device by ringing it."
msgstr "Chamar ao dispositivo para atopalo."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:60
#, kde-format
msgid "Stop pairing to a said device"
msgstr "Deixar de emparellar con ese dispositivo."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:61
#, kde-format
msgid "Sends a ping to said device"
msgstr "Envía un ping ao dispositivo indicado."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:62
#, kde-format
msgid "Same as ping but you can set the message to display"
msgstr "Igual que «ping», pero permítelle definir a mensaxe para mostrar."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:62 kdeconnect-cli.cpp:67
#, kde-format
msgid "message"
msgstr "mensaxe"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:63
#, kde-format
msgid "Share a file to a said device"
msgstr "Compartir un ficheiro co dispositivo indicado."

#. +> trunk5
#: kdeconnect-cli.cpp:64
#, kde-format
msgid "Share text to a said device"
msgstr "Compartir o texto co dispositivo indicado"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:65
#, kde-format
msgid "Display the notifications on a said device"
msgstr "Mostrar as notificacións do dispositivo indicado."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:66
#, kde-format
msgid "Lock the specified device"
msgstr "Bloquear o dispositivo indicado."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:67
#, kde-format
msgid "Sends an SMS. Requires destination"
msgstr "Envía un SMS. Require un destino."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:68
#, kde-format
msgid "Phone number to send the message"
msgstr "Número de teléfono ao que enviar a mensaxe."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:68
#, kde-format
msgid "phone number"
msgstr "número de teléfono"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:69
#, kde-format
msgid "Device ID"
msgstr "Identificador do dispositivo"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:70
#, kde-format
msgid "Device Name"
msgstr "Nome do dispositivo"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:71
#, kde-format
msgid "Get encryption info about said device"
msgstr "Obter a información de cifrado sobre dito dispositivo"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:72
#, kde-format
msgid "Lists remote commands and their ids"
msgstr "Lista as ordes remotas e os seus identificadores."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:73
#, kde-format
msgid "Executes a remote command by id"
msgstr "Executa unha orde remota por identificador."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:74
#, kde-format
msgid "Sends keys to a said device"
msgstr "Envía teclas ao dispositivo indicado."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:75
#, kde-format
msgid "Display this device's id and exit"
msgstr "Mostrar o identificador do dispositivo e saír."

#. +> trunk5
#: kdeconnect-cli.cpp:76
#, kde-format
msgid "Open the connected device's camera and transfer the photo"
msgstr "Abrir a cámara do dispositivo conectado e transferir a foto"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:124
#, kde-format
msgid "(paired and reachable)"
msgstr "(emparellado e alcanzábel)"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:126
#, kde-format
msgid "(reachable)"
msgstr "(alcanzábel)"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:128 kdeconnect-cli.cpp:149
#, kde-format
msgid "(paired)"
msgstr "(emparellado)"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:135
#, kde-format
msgid "1 device found"
msgid_plural "%1 devices found"
msgstr[0] "Atopouse un dispositivo."
msgstr[1] "Atopáronse %1 dispositivos."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:137
#, kde-format
msgid "No devices found"
msgstr "Non se atopou ningún dispositivo."

#. +> trunk5
#: kdeconnect-cli.cpp:151
#, kde-format
msgid "(unpaired)"
msgstr "(desemparellado)"

#. +> stable5
#: kdeconnect-cli.cpp:158
#, kde-format
msgid "Can't find the file: %1"
msgstr "Non se pode atopar o dispositivo: %1"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:185
#, kde-format
msgid "No device specified"
msgstr "Non se indicou ningún dispositivo."

#. +> trunk5
#: kdeconnect-cli.cpp:214
#, kde-format
msgid "Shared %1"
msgstr "Compartiuse %1"

#. +> stable5
#: kdeconnect-cli.cpp:169
#, kde-format
msgid "Sent %1"
msgstr "Enviouse %1"

#. +> trunk5
#: kdeconnect-cli.cpp:220
#, kde-format
msgid "Shared text: %1"
msgstr "Texto compartido: %1"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:226
#, kde-format
msgid "waiting for device..."
msgstr "Agardando polo dispositivo…"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:240
#, kde-format
msgid "Device not found"
msgstr "Non se atopou o dispositivo"

#. +> stable5
#: kdeconnect-cli.cpp:201
#, kde-format
msgid "Device does not exist"
msgstr "O dispositivo non existe"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:242
#, kde-format
msgid "Already paired"
msgstr "Xa está emparellado."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:244
#, kde-format
msgid "Pair requested"
msgstr "Solicitude de emparellamento"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:251
#, kde-format
msgid "Already not paired"
msgstr "Xa está desemparellado."

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:253
#, kde-format
msgid "Unpaired"
msgstr "Desemparellado"

#. +> trunk5 stable5
#: kdeconnect-cli.cpp:269
#, kde-format
msgid ""
"error: should specify the SMS's recipient by passing --destination <phone"
" number>"
msgstr ""
"Erro: ebe indicar o destinatario do SMS pasando «--destination <phone number"
">»."

#. +> trunk5
#: kdeconnect-cli.cpp:282
#, kde-format
msgid "Please specify a filename for the photo"
msgstr "Indique un nome de ficheiro para a foto"

