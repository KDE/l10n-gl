#. (itstool) path: component/name
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:6
msgid "KTorrent"
msgstr "KTorrent"

#. (itstool) path: component/summary
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:7
msgid "BitTorrent Client"
msgstr "Cliente de BitTorrent"

#. (itstool) path: description/p
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:9
msgid "KTorrent is a BitTorrent application by KDE which allows you to download files using the BitTorrent protocol. It enables you to run multiple torrents at the same time and comes with extended features to make it a full-featured client for BitTorrent."
msgstr "KTorrent é un aplicativo de BitTorrent por KDE que permítelle descargar ficheiros usando o protocolo BitTorrent. Permítelle executar varios torrents ao mesmo tempo e inclúe funcionalidades adicionais que o convirten nun cliente de BitTorrent completo."

#. (itstool) path: description/p
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:14
msgid "Features:"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:16
msgid "Queuing of torrents"
msgstr "Consulta de torrents."

#. (itstool) path: ul/li
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:17
msgid "Global and per torrent speed limits"
msgstr "Límites de velocidade globais e por torrent."

#. (itstool) path: ul/li
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:18
msgid "Previewing of certain file types, build in (video and audio)"
msgstr "Previsualización de certos tipos de ficheiros, incluída (vídeo e son)."

#. (itstool) path: ul/li
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:19
msgid "Importing of partially or fully downloaded files"
msgstr "Importación de ficheiros descargados total ou parcialmente."

#. (itstool) path: ul/li
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:20
msgid "File prioritization for multi-file torrents"
msgstr "Priorización de ficheiros para os torrents con varios ficheiros."

#. (itstool) path: ul/li
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:21
msgid "Selective downloading for multi-file torrents"
msgstr "Descarga selectiva para torrents con varios ficheiros."

#. (itstool) path: ul/li
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:22
msgid "Kick/ban peers with an additional IP Filter dialog for list/edit purposes"
msgstr "Expulsar e prohibir parceiros cun diálogo adicional de filtraxe por IP para listar e editar."

