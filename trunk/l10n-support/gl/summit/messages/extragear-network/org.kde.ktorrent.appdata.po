#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:23
msgid "UDP tracker support"
msgstr "Compatibilidade con localizadores UDP."

#. (itstool) path: ul/li
#. +> trunk5 stable5
#: org.kde.ktorrent.appdata.xml:24
