#. +> trunk6 stable6 stable5
#: main.cpp:128
#, kde-format
msgid "Greeter for the KDE Plasma Workspaces Screen locker"
msgstr "Interface de benvida do bloqueador de pantalla dos espazos de traballo de Plasma"

#. +> trunk6 stable6 stable5
#: main.cpp:132
#, kde-format
msgid "Starts the greeter in testing mode"
msgstr "Inicia a interface de benvida no modo de probas"

#. +> trunk6
#: main.cpp:135
#, kde-format
#| msgid "Starts the greeter with the selected theme (only in Testing mode)"
msgid "Starts the greeter with the selected shell theme (only in Testing mode)"
msgstr "Inicia a interface de benvida co tema de interface seleccionado (só no modo de probas)."

#. +> stable6 stable5
#: main.cpp:135
#, kde-format
msgid "Starts the greeter with the selected theme (only in Testing mode)"
msgstr "Inicia a interface de benvida co tema seleccionado (só no modo de probas)."

#. +> trunk6 stable6 stable5
#: main.cpp:139
#, kde-format
msgid "Lock immediately, ignoring any grace time etc."
msgstr "Trancar inmediatamente, ignorando calquera tempo de graza ou similar."

#. +> trunk6 stable6 stable5
#: main.cpp:141
#, kde-format
msgid "Delay till the lock user interface gets shown in milliseconds."
msgstr "Tempo en milisegundos ata que se amosa a interface de usuario de bloqueo."

#. +> trunk6 stable6 stable5
#: main.cpp:144
#, kde-format
msgid "Don't show any lock user interface."
msgstr "Non amosar ningunha interface de usuario de bloqueo."

#. +> trunk6 stable6 stable5
#: main.cpp:145
#, kde-format
msgid "Default to the switch user UI."
msgstr "Usar a interface de cambio de usuario de maneira predeterminada."

#. +> trunk6 stable6 stable5
#: main.cpp:147
#, kde-format
msgid "File descriptor for connecting to ksld."
msgstr "Descriptor de ficheiro para conectar a KSLD."
