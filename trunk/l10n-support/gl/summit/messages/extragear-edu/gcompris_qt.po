msgid "Move a piece"
msgstr "Move unha peza"

#. +> trunk5 stable5
#: activities/nine_men_morris/nine_men_morris.js:935
msgctxt "nine_men_morris|"
msgid "Remove a piece"
msgstr "Retira unha peza"

#. +> trunk5 stable5
#: activities/nine_men_morris/nine_men_morris.js:1137
