#: activities/solar_system/SolarSystem.qml:290
msgctxt "SolarSystem|"
msgid "Hint"
msgstr "Consello"

#. +> trunk5 stable5
#: activities/solar_system/SolarSystem.qml:297
msgctxt "SolarSystem|"
msgid "View solar system"
msgstr "Ver o Sistema Solar"

