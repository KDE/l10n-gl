#: launcher/embeddedlauncher.ui:448
#, kde-format, no-c-format
msgid "-f board/board.cfg -c init -c targets -c \"reset\" -c \"halt\" -c \"flash write_image erase %hex\" -c \"verify_image %hex\" -c \"reset run\" -c shutdown"
msgstr "-f placa/placa.cfg -c init -c targets -c \"reset\" -c \"halt\" -c \"flash write_image erase %hex\" -c \"verify_image %hex\" -c \"reset run\" -c shutdown"

