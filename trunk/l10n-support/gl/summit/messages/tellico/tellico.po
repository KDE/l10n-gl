#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:178
#, kde-format
msgid "The type of the field determines what values may be used. "
msgstr "O tipo do campo determina que valores poden usarse."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:179
#, kde-format
msgid "<i>Simple Text</i> is used for most fields. "
msgstr "<i>Texto simple</i> é o usado na maioría dos campos."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:180
#, kde-format
msgid "<i>Paragraph</i> is for large text blocks. "
msgstr "<i>Parágrafo</i> é para bloques de texto grandes."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:181
#, kde-format
msgid "<i>Choice</i> limits the field to certain values. "
msgstr "<i>Alternativa</i> restrinxe o campo a certos valores."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:182
#, kde-format
msgid "<i>Checkbox</i> is for a simple yes/no value. "
msgstr "A <i>caixa para marcar</i> é para un único valor de si ou non."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:183
#, kde-format
msgid "<i>Number</i> indicates that the field contains a numerical value. "
msgstr "<i>Número</i> indica que o campo contén un valor numérico."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:184
#, kde-format
msgid "<i>URL</i> is for fields which refer to URLs, including references to other files. "
msgstr "<i>URL</i> é para campos que se refiran a un URL, incluíndo referencias a outros ficheiros."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:185
#, kde-format
msgid "A <i>Table</i> may hold one or more columns of values. "
msgstr "Unha <i>Táboa</i> pode conter unha ou varias columnas de valores."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:186
#, kde-format
msgid "An <i>Image</i> field holds a picture. "
msgstr "Un campo de <i>Imaxe</i> contén unha imaxe."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:187
#, kde-format
msgid "A <i>Date</i> field can be used for values with a day, month, and year. "
msgstr "Un campo de <i>Data</i> pode usarse para valores cun día, mes e ano."

#. +> trunk6 stable6 stable5
#: src/collectionfieldsdialog.cpp:188
#, kde-format
msgid "A <i>Rating</i> field uses stars to show a rating number. "
msgstr "Un campo de <i>Cualificación</i> usa estrelas para amosar un nivel."

