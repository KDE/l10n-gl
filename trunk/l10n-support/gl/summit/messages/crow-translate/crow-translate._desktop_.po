#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:3
msgctxt "Name"
msgid "Crow Translate"
msgstr "Crow Translate"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:25
msgctxt "GenericName"
msgid "Translator"
msgstr "Tradutor"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:49
msgctxt "Comment"
msgid "A simple and lightweight translator that allows to translate and speak the selected text using Mozhi"
msgstr "Un sistema de tradución simple e lixeiro que permite traducir e pronunciar texto seleccionado usando Mozhi."

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:70
msgctxt "Keywords"
msgid "google;yandex;deepl;duckduckgo;libre';mymemory;reverso;text-to-speech;"
msgstr "google;yandex;deepl;duckduckgo;libre';mymemory;reverso;text-to-speech;texto a fala;texto para fala;fala;"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:103
msgctxt "Name"
msgid "Translate selected text"
msgstr "Traducir o texto seleccionado"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:128
msgctxt "Name"
msgid "Speak selected text"
msgstr "Pronunciar o texto seleccionado"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:153
msgctxt "Name"
msgid "Speak translation of selected text"
msgstr "Pronunciar a tradución do texto seleccionado"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:178
msgctxt "Name"
msgid "Stop text speaking"
msgstr "Deter a pronuncia do texto"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:203
msgctxt "Name"
msgid "Show main window"
msgstr "Amosar a xanela principal"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:230
msgctxt "Name"
msgid "Translate selected text and copy to clipboard"
msgstr "Traducir o texto seleccionado e copialo no portapapeis"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:254
msgctxt "Name"
msgid "Recognize text in screen area"
msgstr "Recoñecer o texto dunha zona da pantalla"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:279
msgctxt "Name"
msgid "Translate text in screen area"
msgstr "Traducir o texto dunha zona da pantalla"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:304
msgctxt "Name"
msgid "Toggle the option to negate (invert) the captured image before OCR"
msgstr "Conmute a opción para negar (inverter) a imaxe capturada antes do recoñecemento óptico de caracteres"
