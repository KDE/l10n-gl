#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:18
msgctxt "GenericName"
msgid "Translator"
msgstr "Tradutor"

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:34
msgctxt "Comment"
msgid ""
"A simple and lightweight translator that allows to translate and speak the"
" selected text using Mozhi"
msgstr ""
"Un sistema de tradución simple e lixeiro que permite traducir e pronunciar"
" texto seleccionado usando Mozhi."

#. +> trunk5
#: data/org.kde.CrowTranslate.desktop.in:49
msgctxt "Keywords"
msgid "google;yandex;deepl;duckduckgo;libre';mymemory;reverso;text-to-speech;"
msgstr ""
"google;yandex;deepl;duckduckgo;libre';mymemory;reverso;text-to-speech;texto a"
" fala;texto para fala;fala;"

#. +> trunk5
