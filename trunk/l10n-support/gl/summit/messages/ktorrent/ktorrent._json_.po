msgid "Shows statistics about torrents in several graphs"
msgstr "Amosa estatísticas sobre os torrentes en varios gráficos."

#. +> trunk6 stable5
#: plugins/stats/ktorrent_stats.json
msgctxt "Authors Name"
msgid "Krzysztof Kundzicz"
msgstr "Krzysztof Kundzicz"

#. +> trunk6 stable5
#: plugins/syndication/ktorrent_syndication.json
msgctxt "Name"
msgid "Syndication"
msgstr "Sindicación"

#. +> trunk6 stable5
#: plugins/syndication/ktorrent_syndication.json
msgctxt "Description"
msgid "Syndication plugin for KTorrent, supporting RSS and Atom feeds"
msgstr "Complemento de sindicación para KTorrent compatíbel con fontes RSS e Atom."

#. +> trunk6 stable5
#: plugins/upnp/ktorrent_upnp.json
msgctxt "Name"
msgid "UPnP"
msgstr "UPnP"

#. +> trunk6 stable5
#: plugins/upnp/ktorrent_upnp.json
msgctxt "Description"
msgid "Forward ports using UPnP"
msgstr "Reencamiñar portos mediante UPnP."

#. +> trunk6 stable5
#: plugins/zeroconf/ktorrent_zeroconf.json
msgctxt "Name"
msgid "Zeroconf"
msgstr "Zeroconf"

#. +> trunk6 stable5
#: plugins/zeroconf/ktorrent_zeroconf.json
msgctxt "Description"
msgid "Discover peers on the local network using the Zeroconf protocol"
msgstr "Descubrir parceiros na rede local mediante o protocolo Zeroconf."

#. +> trunk6 stable5
#: plugins/zeroconf/ktorrent_zeroconf.json
