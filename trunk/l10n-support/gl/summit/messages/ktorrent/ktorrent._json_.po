#: plugins/scanforlostfiles/ktorrent_scanforlostfiles.json
msgctxt "Description"
msgid "Display files in the selected folder that don't belong to any torrent"
msgstr "Amosar os ficheiros do cartafol seleccionado que non corresponden a ningún torrent."

#. +> trunk6 stable5
#: plugins/scanforlostfiles/ktorrent_scanforlostfiles.json
msgctxt "Authors Name"
msgid "Alexander Trufanov"
msgstr "Alexander Trufanov"

#. +> trunk6 stable5
#: plugins/search/ktorrent_search.json
msgctxt "Name"
msgid "Search"
msgstr "Busca"

#. +> trunk6 stable5
#: plugins/search/ktorrent_search.json
msgctxt "Description"
msgid "Search for torrents"
msgstr "Buscar torrentes."

#. +> trunk6 stable5
#: plugins/shutdown/ktorrent_shutdown.json
msgctxt "Name"
msgid "Shutdown"
msgstr "Apagado"

#. +> trunk6 stable5
#: plugins/shutdown/ktorrent_shutdown.json
msgctxt "Description"
msgid "Allows you to shutdown your computer when torrents finish"
msgstr "Permite apagar o computador cando rematan os torrentes."

#. +> trunk6 stable5
#: plugins/stats/ktorrent_stats.json
msgctxt "Name"
msgid "Statistics"
msgstr "Estatísticas"

#. +> trunk6 stable5
#: plugins/stats/ktorrent_stats.json
