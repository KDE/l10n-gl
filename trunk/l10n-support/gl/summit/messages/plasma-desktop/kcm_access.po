msgstr "Bloquear as teclas pegañentas"

#. +> trunk6 stable6
#: ui/ModifierKeys.qml:51
#, kde-format
msgctxt "@info:tooltip"
msgid "Pressing a modifier key twice will keep it in active state until pressed again."
msgstr "Prema unha tecla modificador dúas veces para mantela no estado activo ata volvela premer."

