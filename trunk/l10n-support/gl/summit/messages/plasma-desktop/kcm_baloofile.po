#. +> stable5
#: package/contents/ui/main.qml:21
#, kde-format
msgid "This module lets you configure the file indexer and search functionality."
msgstr "Este módulo permítelle configurar o indexador de ficheiros e a funcionalidade de busca."

#. +> trunk6 stable5
#: package/contents/ui/main.qml:57
#, kde-format
msgid "This will disable file searching in KRunner and launcher menus, and remove extended metadata display from all KDE applications."
msgstr "Isto desactivará a busca de ficheiros en KRunner e menús de inicio, e deixará de mostrar os metadatos estendidos en todas as aplicacións de KDE."

#. +> trunk6 stable5
#: package/contents/ui/main.qml:66
#, kde-format
msgid "Do you want to delete the saved index data? %1 of space will be freed, but if indexing is re-enabled later, the entire index will have to be re-created from scratch. This may take some time, depending on how many files you have."
msgstr "Quere eliminar os datos de indexación gardados? Liberaranse %1 de espazo, pero se volve activar a indexación máis tarde, haberá que crear de novo o índice completo. Isto podería levar un tempo, segundo o número de ficheiros que teña."

#. +> trunk6 stable5
#: package/contents/ui/main.qml:68
#, kde-format
msgid "Delete Index Data"
msgstr "Eliminar os datos do índice"

#. +> trunk6 stable5
#: package/contents/ui/main.qml:88
#, kde-format
msgid "The system must be restarted before these changes will take effect."
msgstr "Debe reiniciarse o sistema para que os cambios xurdan efecto."

#. +> trunk6 stable5
#: package/contents/ui/main.qml:92
#, kde-format
msgctxt "@action:button"
msgid "Restart"
msgstr "Reiniciar"

#. +> trunk6 stable5
#: package/contents/ui/main.qml:99
#, kde-format
#| msgid "File Search helps you quickly locate all your files based on their content"
msgid "File Search helps you quickly locate all your files based on their content."
msgstr "A busca de ficheiros permítelle dar rapidamente cos seus ficheiros segundo o contido."

#. +> trunk6 stable5
#: package/contents/ui/main.qml:106
#, kde-format
msgid "Enable File Search"
msgstr "Activar a busca de ficheiros"

#. +> trunk6 stable5
#: package/contents/ui/main.qml:121
#, kde-format
msgid "Also index file content"
msgstr "Indexar tamén o contido do ficheiro."

#. +> trunk6 stable5
