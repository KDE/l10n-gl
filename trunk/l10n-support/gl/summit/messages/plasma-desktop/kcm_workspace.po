#, kde-format
msgctxt ""
"@radio part of a complete sentence: 'Clicking in scrollbar track scrolls one p"
"age up or down'"
msgid "Scrolls one page up or down"
msgstr "Despraza unha páxina arriba ou abaixo"

#. +> trunk6 stable6 stable5
#: ui/main.qml:273
#, kde-format
msgid "Middle-click to scroll to clicked location"
msgstr "Clic central para desprazar á localización premida"

#. +> trunk6 stable6
#: ui/main.qml:287
#, kde-format
msgctxt ""
"@label for checkbox, part of a complete sentence: 'Middle-click pastes selecte"
