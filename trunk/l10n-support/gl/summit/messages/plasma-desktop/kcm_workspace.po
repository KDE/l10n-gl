#: ui/main.qml:75
#, kde-format
msgid "Animation speed:"
msgstr "Velocidade das animacións:"

#. +> trunk6
#: ui/main.qml:77
#, kde-format
msgctxt "Part of the sentence 'Allow Plasma to show OSD popups for status changes'"
msgid "OSD popups for status changes"
msgstr "Mensaxes en pantalla ao cambiar de estado."

#. +> trunk6
#: ui/main.qml:87
#, kde-format
msgid "Allows all Plasma widgets to show on-screen display (OSD) popups for changes like volume and brightness level, or audio device switching."
msgstr "Permite aos trebellos de Plasma amosar mensaxes en pantalla sobre cambios en aspectos como o volume e o brillo, ou o dispositivo de son."

