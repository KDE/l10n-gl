#, kde-format
msgid "The system must be restarted before changes to the middle-click paste setting can take effect."
msgstr "Debe reiniciarse o sistema para que os cambios na opción de pegar co clic central xurdan efecto."

#. +> trunk6 stable6 stable5
#: ui/main.qml:29
#, kde-format
msgid "Restart"
msgstr "Reiniciar"

#. +> trunk6 stable6 stable5
#: ui/main.qml:45
#, kde-format
msgid "Visual behavior:"
msgstr "Comportamento visual:"

