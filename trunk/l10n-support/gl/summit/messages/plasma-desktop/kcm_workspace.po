msgid "Slow"
msgstr "Lenta"

#. +> trunk6 stable6 stable5
#: ui/main.qml:108
#, kde-format
msgctxt "Animation speed"
msgid "Instant"
msgstr "Instantánea"

#. +> trunk6 stable6 stable5
#: ui/main.qml:123
#, kde-format
msgctxt "part of a sentence: 'Clicking files or folders [opens them/selects them]'"
msgid "Clicking files or folders:"
msgstr "Premer ficheiros e cartafoles:"

#. +> trunk6 stable6 stable5
#: ui/main.qml:130
#, kde-format
msgctxt "part of a sentence: 'Clicking files or folders selects them'"
msgid "Selects them"
msgstr "Selecciónaos"

#. +> trunk6 stable6 stable5
#: ui/main.qml:144
#, kde-format
msgid "Open by double-clicking instead"
msgstr "Abrir con prema dupla no seu lugar"

#. +> trunk6 stable6 stable5
#: ui/main.qml:157
#, kde-format
msgctxt "part of a sentence: 'Clicking files or folders opens them'"
msgid "Opens them"
msgstr "Ábreos"

#. +> trunk6 stable6 stable5
#: ui/main.qml:170
#, kde-format
msgid "Select by clicking on item's selection marker"
msgstr "Seleccionar premendo o marcador de selección dos elementos"

#. +> trunk6 stable6 stable5
#: ui/main.qml:186
#, kde-format
msgid "Clicking in scrollbar track:"
msgstr "Premer na pista de barra de desprazamento:"

#. +> trunk6 stable6 stable5
#: ui/main.qml:187
#, kde-format
msgctxt "@radio part of a complete sentence: 'Clicking in scrollbar track scrolls to the clicked location'"
msgid "Scrolls to the clicked location"
msgstr "Despraza á localización premida"

#. +> trunk6 stable6 stable5
#: ui/main.qml:205
#, kde-format
msgctxt "@radio part of a complete sentence: 'Clicking in scrollbar track scrolls one page up or down'"
msgid "Scrolls one page up or down"
msgstr "Despraza unha páxina arriba ou abaixo"

#. +> trunk6 stable6 stable5
#: ui/main.qml:218
#, kde-format
msgid "Middle-click to scroll to clicked location"
msgstr "Clic central para desprazar á localización premida"

#. +> stable5
#: package/contents/ui/main.qml:219
#, kde-format
msgid "Paste selected text"
msgstr "Pegar o texto seleccionado"

#. +> trunk6 stable6
#: ui/main.qml:232
#, kde-format
msgctxt "@radio part of a complete sentence: 'Middle click pastes selected text'"
msgid "Middle Click:"
msgstr "Clic central:"

#. +> stable5
#: package/contents/ui/main.qml:217
#, kde-format
msgid "Middle Click:"
msgstr "Clic central:"

#. +> trunk6 stable6
#: ui/main.qml:234
#, kde-format
msgctxt "@radio part of a complete sentence: 'Middle click pastes selected text'"
msgid "Pastes selected text"
msgstr "Pega o texto seleccionado"

#. +> trunk6 stable6 stable5
#: ui/main.qml:251
#, kde-format
msgid "Touch Mode:"
msgstr "Modo táctil:"

#. +> trunk6 stable6 stable5
#: ui/main.qml:253
#, kde-format
msgctxt "As in: 'Touch Mode is automatically enabled as needed'"
msgid "Automatically enable as needed"
msgstr "Activar automaticamente cando se necesite"

#. +> trunk6 stable6 stable5
#: ui/main.qml:253 ui/main.qml:296
#, kde-format
msgctxt "As in: 'Touch Mode is never enabled'"
msgid "Never enabled"
msgstr "Non activar nunca"

#. +> trunk6 stable6 stable5
#: ui/main.qml:269
#, kde-format
msgid "Touch Mode will be automatically activated whenever the system detects a touchscreen but no mouse or touchpad. For example: when a transformable laptop's keyboard is flipped around or detached."
msgstr "O modo táctil activarase automaticamente cando o sistema detecta unha pantalla táctil e ningún rato ou área táctil. Por exemplo,  cando ao teclado dun portátil transformábel se lle dá a volta ou se desconecta."

#. +> trunk6 stable6 stable5
#: ui/main.qml:274
#, kde-format
msgctxt "As in: 'Touch Mode is always enabled'"
msgid "Always enabled"
msgstr "Sempre activo"

#. +> trunk6 stable6 stable5
#: ui/main.qml:314
#, kde-format
msgid "In Touch Mode, many elements of the user interface will become larger to more easily accommodate touch interaction."
msgstr "No modo táctil, moitos elementos da interface aumentan de tamaño para facilitar a interacción táctil."

#. +> trunk6 stable6
#: ui/main.qml:332
#, kde-format
msgid "Double-click interval:"
msgstr "Intervalo de clic duplo:"

#. +> trunk6 stable6
#: ui/main.qml:347
#, kde-format
msgid "%1 msec"
msgid_plural "%1 msec"
msgstr[0] "%1 ms"
msgstr[1] "%1 ms"

#. +> trunk6 stable6
#: ui/main.qml:351
#, kde-format
msgid "msec"
msgstr "ms"

#. +> trunk6 stable6
#: ui/main.qml:365
#, kde-format
msgid "Two clicks within this duration are considered a double-click. Some applications may not honor this setting."
msgstr "Dous clics dentro desta duración considéranse clics duplos. Algunhas aplicacións poden ignorar esta opción."

#. i18n: ectx: label, entry (singleClick), group (KDE)
#. +> trunk6 stable6 stable5
#: workspaceoptions_kdeglobalssettings.kcfg:9
#, kde-format
msgid "Single click to open files"
msgstr "Un só clic para abrir ficheiros"

#. i18n: ectx: label, entry (animationDurationFactor), group (KDE)
#. +> trunk6 stable6 stable5
#: workspaceoptions_kdeglobalssettings.kcfg:13
#, kde-format
msgid "Animation speed"
msgstr "Velocidade das animacións"

#. i18n: ectx: label, entry (scrollbarLeftClickNavigatesByPage), group (KDE)
#. +> trunk6 stable6 stable5
#: workspaceoptions_kdeglobalssettings.kcfg:17
#, kde-format
msgid "Left-click in scrollbar track moves scrollbar by one page"
msgstr "Clic esquerdo na pista de barra de desprazamento move a barra de desprazamento unha páxina"

#. i18n: ectx: label, entry (doubleClickInterval), group (KDE)
#. +> trunk6 stable6
#: workspaceoptions_kdeglobalssettings.kcfg:21
#, kde-format
msgid "Double click interval"
msgstr "Intervalo de clic duplo"

#. i18n: ectx: label, entry (tabletMode), group (Input)
#. +> trunk6 stable6 stable5
#: workspaceoptions_kwinsettings.kcfg:9
#, kde-format
msgid "Automatically switch to touch-optimized mode"
msgstr "Cambiar automaticamente ao modo optimizado para tacto"

#. i18n: ectx: label, entry (primarySelection), group (Wayland)
#. +> trunk6 stable6 stable5
#: workspaceoptions_kwinsettings.kcfg:15
#, kde-format
msgid "Enable middle click selection pasting"
msgstr "Activar o pegado da selección co clic central"

#. i18n: ectx: tooltip, entry (osdEnabled), group (OSD)
#. +> trunk6 stable6 stable5
#: workspaceoptions_plasmasettings.kcfg:16
#, kde-format
msgid "Show an on-screen display to indicate status changes such as brightness or volume"
msgstr "Amosar un cadro para indicar os cambios de estado como os de brillo ou volume."

#. i18n: ectx: label, entry (osdKbdLayoutChangedEnabled), group (OSD)
#. +> trunk6 stable6 stable5
#: workspaceoptions_plasmasettings.kcfg:20
#, kde-format
msgid "OSD on layout change"
msgstr "Cadro ao cambiar de disposición"

#. i18n: ectx: tooltip, entry (osdKbdLayoutChangedEnabled), group (OSD)
#. +> trunk6 stable6 stable5
#: workspaceoptions_plasmasettings.kcfg:21
#, kde-format
msgid "Show a popup on layout changes"
msgstr "Amosar unha xanela emerxente ao cambiar de disposición."

