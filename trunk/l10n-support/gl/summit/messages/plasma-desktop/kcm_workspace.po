#: ui/main.qml:409
#, kde-format
msgctxt "short for millisecond(s)"
msgid "%1 ms"
msgid_plural "%1 ms"
msgstr[0] "%1 ms"
msgstr[1] "%1 ms"

#. +> trunk6 stable6
#: ui/main.qml:413
#, kde-format
msgctxt "short for millisecond(s)"
msgid "ms"
msgstr "ms"

#. +> trunk6 stable6
#: ui/main.qml:427
#, kde-format
msgid ""
"Two clicks within this duration are considered a double-click. Some applicatio"
"ns may not honor this setting."
msgstr ""
"Dous clics dentro desta duración considéranse clics duplos. Algunhas aplicació"
"ns poden ignorar esta opción."

