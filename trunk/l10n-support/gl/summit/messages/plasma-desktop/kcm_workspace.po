#, kde-format
msgctxt ""
"@radio part of a complete sentence: 'Clicking in scrollbar track scrolls to th"
"e clicked location'"
msgid "Scrolls to the clicked location"
msgstr "Despraza á localización premida"

#. +> trunk6 stable6 stable5
