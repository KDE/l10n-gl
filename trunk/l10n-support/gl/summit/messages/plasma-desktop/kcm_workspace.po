#. +> trunk6 stable6 stable5
#: ui/main.qml:46 workspaceoptions_plasmasettings.kcfg:9
#, kde-format
msgid "Display informational tooltips on mouse hover"
msgstr "Amosar indicacións emerxentes informativas ao cubrir co rato."

#. i18n: ectx: label, entry (osdEnabled), group (OSD)
#. +> trunk6 stable6 stable5
#: ui/main.qml:57 workspaceoptions_plasmasettings.kcfg:15
#, kde-format
msgid "Display visual feedback for status changes"
msgstr "Amosar información visual sobre cambios de estado."

