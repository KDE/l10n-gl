msgid "Selects them"
msgstr "Selecciónaos"

#. +> trunk6 stable6 stable5
#: ui/main.qml:189
#, kde-format
msgid "Open by double-clicking instead"
msgstr "Abrir con prema dupla no seu lugar"

#. +> trunk6 stable6 stable5
#: ui/main.qml:202
#, kde-format
msgctxt "part of a sentence: 'Clicking files or folders opens them'"
msgid "Opens them"
msgstr "Ábreos"

