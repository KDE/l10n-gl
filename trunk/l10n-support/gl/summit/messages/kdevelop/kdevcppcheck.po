#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_inconclusiveAnalysis)
#. +> trunk6 stable6
#: config/projectconfigpage.ui:60
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Allow that Cppcheck reports even though the analysis is inconclusive. There ar"
"e false positives with this option. Each result must be carefully investigated"
" before you know if it is good or bad."
msgstr ""
"Permitir a Cppcheck informar aínda cando a análise sexa inconclusa. Hai falsos"
" positivos con esta opción. Cada resultado debe investigarse coidadosamente an"
"tes de saber se é bo ou malo."

