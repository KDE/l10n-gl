#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_useProjectIncludes)
#. +> trunk6 stable6
#: config/projectconfigpage.ui:164
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Add 'project' include directories to Cppcheck arguments. This option adds only"
" paths related with project's root and build directories."
msgstr ""
"Engadir os directorios de inclusión do proxecto aos argumentos de Cppcheck. Es"
"ta opción engade só rutas relacionadas coa raíz do proxecto e os cartafoles de"
" construción."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_useProjectIncludes)
#. +> trunk6 stable6
#: config/projectconfigpage.ui:167
#, kde-format
msgctxt "@option:check"
msgid "Use 'project' include dirs"
msgstr "Usar os directorios de inclusión do proxecto."

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_useSystemIncludes)
#. +> trunk6 stable6
#: config/projectconfigpage.ui:180
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p>Add other, 'system' include directories to Cppcheck arguments.<br/>"
"<br/>"
"Be careful with using this option - it can dramatically slow checking.</p>"
msgstr ""
"<p>Engadir outros directorios de inclusión do sistema aos argumentos de Cppche"
"ck.<br/>"
"<br/>"
"Teña coidado ao usar esta opción, pode lentificar drasticamente a comprobación"
".</p>"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_useSystemIncludes)
#. +> trunk6 stable6
#: config/projectconfigpage.ui:183
#, kde-format
msgctxt "@option:check"
msgid "Use 'system' include dirs"
msgstr "Usar os directorios de inclusión do sistema."

