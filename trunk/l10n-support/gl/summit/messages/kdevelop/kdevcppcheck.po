#: config/projectconfigpage.ui:47
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Check for unused functions. It is recommend to only enable this when the whole"
" program is scanned"
msgstr ""
"Comprobar se hai funcións sen usar. Recoméndase activalo só cando se analice t"
"odo o programa."

