#. +> trunk6 stable6
#: ui/perforceimportmetadatawidget.ui:97
#, kde-format
msgctxt "@info:tooltip"
msgid "Current Perforce user name. By default, the Perforce username is the same as the OS username"
msgstr "Nome de usuaria actual de Perforce. O nome de usuaria de Perforce predeterminado é o nome de usuaria do sistema operativo."

