#: ui/perforceimportmetadatawidget.ui:49
#, kde-format
msgid "P4 Port"
msgstr "Porto de P4"

#. i18n: ectx: property (toolTip), widget (QLineEdit, p4portEdit)
#. +> trunk6 stable6
#: ui/perforceimportmetadatawidget.ui:68
#, kde-format
msgctxt "@info:tooltip"
msgid "The format of P4PORT for Perforce applications is protocol:host:port, or port by itself if both the Perforce application and versioning service are running on the same host. Port numbers must be in the range 1024 through 32767"
msgstr "O formato de P4PORT para aplicacións que usan Perforce é protocolo:servidor:porto, ou simplemente o porto se tanto a aplicación que usa Perforce como o servizo de versións están a executarse na mesma máquina. Os números de porto deben estar entre o 1024 e o 32767."

#. i18n: ectx: property (text), widget (QLabel, labelP4user)
