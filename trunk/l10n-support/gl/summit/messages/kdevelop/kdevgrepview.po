msgid "Depth:"
msgstr "Profundidade:"

#. i18n: ectx: property (toolTip), widget (QSpinBox, depthSpin)
#. +> trunk6 stable6
#: grepwidget.ui:115
#, kde-format
msgid "Maximum level of subdirectory recursion"
msgstr "Nivel máximo de recursividade de subcartafoles."

#. i18n: ectx: property (whatsThis), widget (QSpinBox, depthSpin)
#. +> trunk6 stable6
#: grepwidget.ui:118
#, kde-format
msgid "For each search location, descend at most Depth levels of directories. Depth=0 means searching only in files directly inside selected search locations. Full Depth means no recursion limit."
msgstr "Por cada lugar de busca, descende como moito o número indicado de niveis de profundidade de cartafoles. Unha profundidade de 0 implica buscar só en ficheiros directamente dentro dos lugares de busca seleccionados. Unha profundidade total implica non limitar a recursividade."

#. i18n: Full recursion will be used. For folder-based searches, that means searching in the target folder and all the subfolders, their subfolders, and so on.
#. i18n: ectx: property (specialValueText), widget (QSpinBox, depthSpin)
#. +> trunk6 stable6
#: grepwidget.ui:121
#, kde-format
msgctxt "@item full recursion"
msgid "Full"
msgstr "Completa"

