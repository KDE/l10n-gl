#. (itstool) path: component/name
#. +> trunk6 stable6
#: org.kde.kdevelop.appdata.xml:9
msgid "KDevelop"
msgstr "KDevelop"

#. (itstool) path: component/summary
#. +> trunk6 stable6
#: org.kde.kdevelop.appdata.xml:10
msgid ""
"Featureful, plugin-extensible IDE for C/C++ and other programming languages"
msgstr ""
"Potente ambiente de desenvolvemento integrado para C, C++ e outras linguaxes"
" de programación. As súas funcionalidades poden estenderse mediante"
" complementos"

#. (itstool) path: description/p
#. +> trunk6 stable6
#: org.kde.kdevelop.appdata.xml:12
msgid ""
"KDevelop is a Free and Open Source integrated development environment (IDE)."
msgstr ""
"KDevelop é un ambiente integrado de desenvolvemento (IDE) libre e de código"
" aberto."

#. (itstool) path: description/p
#. +> trunk6 stable6
#: org.kde.kdevelop.appdata.xml:13
msgid ""
"It provides editing, navigation and debugging features for several"
" programming languages, as well as integration with multiple build systems"
" and version-control systems, using a plugin-based architecture."
msgstr ""
"Fornece funcionalidades de edición, navegación e depuración para varias"
" linguaxes de programación, así como integración con varios sistemas de"
" construción e sistemas de control de versións, usando unha arquitectura"
" baseada en complementos."

#. (itstool) path: description/p
#. +> trunk6 stable6
#: org.kde.kdevelop.appdata.xml:14
msgid ""
"KDevelop has parser backends for C, C++ and Javascript/QML, with further"
" external plugins supporting e.g. PHP or Python."
msgstr ""
"KDevelop ten infraestruturas de análise para C, C++ e JavaScript/QML, con"
" complementos externos adicionais que fornecen compatibilidade, por exemplo,"
" con PHP e Python."

#. (itstool) path: screenshot/caption
#. +> trunk6 stable6
#: org.kde.kdevelop.appdata.xml:23
msgid "Main window with code editor, terminal integration and project files"
msgstr ""
"Xanela principal con editor de código, integración co terminal e ficheiros de"
" proxectos."

