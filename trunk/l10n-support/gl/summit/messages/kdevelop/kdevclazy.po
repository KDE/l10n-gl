#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_onlyQt)
#. +> trunk5 stable5
#: config/projectconfigpage.ui:71
#, kde-format
msgid "Do not emit warnings for non-Qt files, or in other words, if -DQT_CORE_LIB is missing."
msgstr "Non emitir avisos para ficheiros non Qt, é dicir, se falta -DQT_CORE_LIB."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_onlyQt)
#. +> trunk5 stable5
#: config/projectconfigpage.ui:74
#, kde-format
msgid "Only Qt"
msgstr "Só Qt"

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_qt4Compat)
#. +> trunk5 stable5
#: config/projectconfigpage.ui:81
#, kde-format
