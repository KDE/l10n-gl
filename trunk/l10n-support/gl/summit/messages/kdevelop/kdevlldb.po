#. +> trunk5 stable5
#: debugsession.cpp:373
#, kde-format
msgid ""
"<b>Failed to load core file</b>"
"<p>Debugger reported the following error:"
"<p><tt>%1"
msgstr ""
"<b>Non se puido cargar o ficheiro principal.</b>"
"<p>O depurador informou do seguinte erro:"
"<p><tt>%1"

#. +> trunk5 stable5
#: debugsession.cpp:404
#, kde-format
msgid ""
"<b>Your lldb-mi version is unsupported, as it lacks an essential patch.</b><br/>"
"See https://llvm.org/bugs/show_bug.cgi?id=28026 for more information.<br/>"
"Debugger console will be disabled to prevent crash.<br/>"
"Do you want to continue?"
msgstr ""
"<b>A súa versión de lldb-mi non é compatíbel, fáltalle un parche esencial.</b><br/>"
"Consulte https://llvm.org/bugs/show_bug.cgi?id=28026 (en inglés) para máis información.<br/>"
"A consola do depurador desactivarase para evitar unha quebra.<br/>"
"Quere continuar?"

#. +> trunk5 stable5
#: debugsession.cpp:408
#, kde-format
msgid "LLDB Version Unsupported"
msgstr "Versión incompatíbel de LLDB"

#. +> trunk5 stable5
#: debugsession.cpp:456
#, kde-format
msgid ""
"<b>You need lldb-mi from LLDB 3.8.1 or higher.</b><br />"
"You are using: %1"
msgstr ""
"<b>Necesita lldb-mi de LLDB 3.8.1 ou superior.</b><br />"
"Está a usar: %1"

