#. +> trunk5
#: ../../effects_and_compositions/video_effects/blur_and_sharpen/boxblur.rst:10
msgid "Boxblur"
msgstr "Desenfoque bidireccional"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/blur_and_sharpen/boxblur.rst:12
msgid "This effect blurs the image based on the horizontal and vertical multiplicator allowing uneven blurring or blurring in only one direction. Not be confused with the deprecated Box Blur effect."
msgstr "Este efecto desenfoca unha imaxe segundo multiplicadores horizontal e vertical, o que permite un desenfoque desigual ou desenfocar nunha única dirección. Non debe confundirse co efecto obsoleto de desenfoque de caixa."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/blur_and_sharpen/boxblur.rst:14
msgid "This effect has keyframes."
msgstr "Este efecto ten fotogramas clave."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/blur_and_sharpen/boxblur.rst:22
msgid "Boxblur effect"
msgstr "Efecto de desenfoque bidireccional"
