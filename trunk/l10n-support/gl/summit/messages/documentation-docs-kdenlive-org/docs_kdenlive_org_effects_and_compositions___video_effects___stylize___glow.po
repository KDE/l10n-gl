#. +> trunk5
#: ../../effects_and_compositions/video_effects/stylize/glow.rst:1
msgid "Do your first steps with Kdenlive video editor, using glow effect"
msgstr "Dá os primeiros pasos co editor de vídeo Kdenlive co efecto de fulgor."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/stylize/glow.rst:1
msgid ""
"KDE, Kdenlive, video editor, help, learn, easy, effects, filter, video"
" effects, stylize, glow"
msgstr ""
"KDE, Kdenlive, editor de vídeo, axuda, aprender, fácil, efectos, filtro,"
" efectos de vídeo, estilizar, fulgor"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/stylize/glow.rst:16
msgid "Glow"
msgstr "Fulgor"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/stylize/glow.rst:18
msgid ""
"This effect/filter creates a glamorous glow by lightening the image and"
" adding some blur around the edges."
msgstr ""
"Este efecto crea un fulgor elegante aumentando o brillo da imaxe e engadindo"
" desenfoque nos límites. "

#. +> trunk5
#: ../../effects_and_compositions/video_effects/stylize/glow.rst:20
msgid "The effect has keyframes."
msgstr "O efecto ten fotogramas clave."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/stylize/glow.rst:28
msgid "Glow effect"
msgstr "Efecto de fulgor"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/stylize/glow.rst:30
msgid ""
"**Blur** - Set the amount of blurriness on the edges. The higher the number"
" the more blur is applied increasing the glow effect."
msgstr ""
"**Desenfoque**: definir a cantidade de desenfoque no límite. A maior valor,"
" maior desenfoque se aplica, aumentando o efecto de fulgor."

#~ msgid "This is the `Frei0r glow <https://www.mltframework.org/plugins/FilterFrei0r-glow/>`_ MLT filter."
#~ msgstr "Este é o filtro `brillo de Frei0r <https://www.mltframework.org/plugins/FilterFrei0r-glow/>`_ de MLT."

#~ msgid "Creates a Glamorous Glow."
#~ msgstr "Crea un brillo elegante."

