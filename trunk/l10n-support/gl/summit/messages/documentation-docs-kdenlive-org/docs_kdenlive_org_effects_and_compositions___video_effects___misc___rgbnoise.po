#: ../../effects_and_compositions/video_effects/misc/rgbnoise.rst:11
msgid "rgbnoise"
msgstr "Ruído RGB"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/misc/rgbnoise.rst:15
msgid "This is an effect in the Misc category."
msgstr "Este é un efecto da categoría «Varios»."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/misc/rgbnoise.rst:17
msgid ""
"This is the `Frei0r rgbnoise <https://www.mltframework.org/plugins/FilterFrei0"
"r-rgbnoise/>`_ MLT filter by Janne Liljeblad."
msgstr ""
"É o efecto de `ruído RGB de Frei0r <https://www.mltframework.org/plugins/Filte"
"rFrei0r-rgbnoise/>`_ de MLT de Janne Liljeblad."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/misc/rgbnoise.rst:19
msgid ""
"It adds RGB noise to image and takes one parameter *noise* in the range 0 to"
" 1 which controls the amount of noise added."
msgstr ""
"Engade ruído RGB a unha imaxe e acepta un parámetro *ruído* cun valor entre 0"
" e 1 que determina a cantidade de ruído para engadir."

