#. +> trunk5
#: ../../effects_and_compositions/video_effects/color_image_correction/white_balance_lms.rst:12
msgid "White Balance (LMS)"
msgstr "Equilibrio de brancos (LMS)"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/color_image_correction/white_balance_lms.rst:15
msgid "This is the `Frei0r colgate <https://www.mltframework.org/plugins/FilterFrei0r-colgate/>`_ MLT filter by Steiner H. Gunderson."
msgstr "Este é o filtro `colgate de Frei0r <https://www.mltframework.org/plugins/FilterFrei0r-colgate/>`_ de MLT de Steiner H. Gunderson."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/color_image_correction/white_balance_lms.rst:17
msgid "Do simple color correction, in a physically meaningful way."
msgstr "Realizar unha simple corrección da cor de maneira fisicamente significativa."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/color_image_correction/white_balance_lms.rst:19
msgid "**Parameters:**"
msgstr "**Parámetros:**"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/color_image_correction/white_balance_lms.rst:21
msgid "Neutral Color: Choose a color from the source image that should be white."
msgstr "Cor neutral: escolle a cor da imaxe orixinal que debería ser branca."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/color_image_correction/white_balance_lms.rst:23
msgid "Color Temperature: Choose an output color temperature, if different from 6500 K."
msgstr "Temperatura da cor: escolle unha temperatura de cor de saída; a predeterminada é 6500 K."
