msgid "Square Blur"
msgstr "Desenfoque cadrado "

#. +> trunk5
#: ../../effects_and_compositions/video_effects/blur_and_sharpen/square_blur.rst:16
msgid ""
"This effect blurs the entire clip. **Kernel size** determines the blurriness."
msgstr ""
"Este efecto desenfoca o fragmento completo. O **tamaño do núcleo** determina"
" a magnitude do desenfoque."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/blur_and_sharpen/square_blur.rst:18
msgid "This effect has keyframes."
msgstr "Este efecto ten fotogramas clave."

#. +> trunk5
