msgid "Planes Blur"
msgstr "Desenfoque de planos"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/blur_and_sharpen/planes_blur.rst:12
msgid "This effect applies just to three :term:`Planes<plane>`: Luma, Chroma and Alpha. You define the :guilabel:`Radius` and :guilabel:`Power` to determine the strength of the effect."
msgstr "Este efecto só ten efecto en tres :term:`planos <plane>`: luminancia, cromatismo, e alfa. Vostede define o :guilabel:`Raio` e a :guilabel:`Potencia` para determinar a intensidade do efecto."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/blur_and_sharpen/planes_blur.rst:14
msgid "This effect does not have keyframes."
msgstr "Este efecto non ten fotogramas clave."

