# well-spelled: Premultiplicar, despremultiplicar
#. +> trunk5
#: ../../effects_and_compositions/video_effects/alpha_mask_keying/premultiply.rst:20
msgid "Premultiply or Unpremultiply"
msgstr "Premultiplicar ou despremultiplicar"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/alpha_mask_keying/premultiply.rst:22
msgid ""
"Multiply (or divide) each color component by the pixel's alpha value"
" (frei0r.premultiply)."
msgstr ""
"Multiplicar (ou dividir) cada compoñente de cor polo valor de alfa do píxel"
" (frei0r.premultiply)."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/alpha_mask_keying/premultiply.rst:24
msgid ""
"Use this effect before any alpha effects if the result of your compositions"
" using alpha has odd-looking colors."
msgstr ""
"Usa este efecto antes de calquera efecto de alfa se o resultado das"
" composicións que usan alfa teñen cores raras."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/alpha_mask_keying/premultiply.rst:26
msgid "For more details see this article by Nvidia about |alpha_blending|."
msgstr ""
"Para máis información consulta o artigo de Nvidia sobre |alpha_blending|."
