#. +> trunk5
#: ../../effects_and_compositions/video_effects/alpha_mask_keying/lumakey.rst:14
msgid "Lumakey"
msgstr "Lumakey"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/alpha_mask_keying/lumakey.rst:16
msgid ""
"This filter modifies image's alpha channel as a function of its luma value."
" This is used together with a compositor to combine two images so that bright"
" or dark areas of source image are overwritten on top of the destination"
" image. (lumakey)"
msgstr ""
"Este filtro converte a canle alfa da imaxe nunha función do seu valor de"
" luma. Úsase xunto cun compositor para combinar dúas imaxes de xeito que as"
" zonas claras ou escuras da imaxe de orixe se substitúen sobre a imaxe de"
" destino (lumakey)."

#. +> trunk5
#: ../../effects_and_compositions/video_effects/alpha_mask_keying/lumakey.rst:21
msgid "Lumakey effect panel"
msgstr "Panel do efecto Lumakey"
