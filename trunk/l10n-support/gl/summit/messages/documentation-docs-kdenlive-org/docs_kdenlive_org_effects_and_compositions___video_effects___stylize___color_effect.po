#. +> trunk5
#: ../../effects_and_compositions/video_effects/stylize/color_effect.rst:19
msgid "Possible effects are:"
msgstr "Os efectos dispoñíbeis son:"

#. +> trunk5
#: ../../effects_and_compositions/video_effects/stylize/color_effect.rst:21
msgid "xpro, sepia, heat, red_green, old_photo, xraym, esses and yellow_blue."
msgstr "xpro, sepia, heat (calor), red_green (vermello verde), old_photo (foto antiga), xraym, esses e yellow_blue (amarelo azul)."
