#. +> trunk6 stable5
#: CalendarTool.cpp:62
#, kde-format
msgid "End date is before start date! Please make sure that end date comes after start date."
msgstr "A data de remate vai antes que a de comezo. Asegúrese de que a data de remate vai despois da data de comezo."

#. +> trunk6 stable5
#: CalendarTool.cpp:62 CalendarTool.cpp:69
#, kde-format
msgid "Error"
msgstr "Erro"

#. +> trunk6 stable5
#: CalendarTool.cpp:68
#, kde-format
msgid "Calendars should not be longer than 10 years. If you really need such long periods you need to split them up."
msgstr "Os calendarios non deberían pasar do 10 anos de longo. Se precisase un calendario maior que iso debería crear varios separados."

#. +> trunk6 stable5
#: CalendarTool.cpp:76
#, kde-format
msgid "Start and end dates are equal! Only one day will be inserted, do you want to continue?"
msgstr "A data de comezo e a de remates son a mesma!. Só se inserirá un día. Quere proseguir?"

#. +> trunk6 stable5
#: CalendarTool.cpp:77 CalendarTool.cpp:87 CalendarTool.cpp:111
#, kde-format
msgid "Warning"
msgstr "Advertencia"

#. +> trunk6 stable5
#: CalendarTool.cpp:86
#, kde-format
msgid "Creating a calendar for a longer period than a year can take up a lot of space, do you want to continue?"
msgstr "Crear un calendario maior que un ano pode consumir bastante espazo no disco. Quere seguir?"

#. +> trunk6 stable5
#: CalendarTool.cpp:109
#, kde-format
msgid "The area where the calendar is inserted is NOT empty, are you sure you want to continue, overwriting existing data? If you choose No the area that would be required for the desired calendar will be selected so you can see what data would be overwritten."
msgstr "A área onde o calendario se insire non está baleira. Seguro que quere seguir e sobrescribir os datos que alí haxa?. Se escolle «Non» a área que faría falta para o calendario desexado escollerase de maneira que poida ver que datos se sobrescribirán."

#. +> trunk6 stable5
#: CalendarTool.cpp:120
msgctxt "(qtundo-format)"
msgid "Insert Calendar"
msgstr "Inserir un calendario"

#. +> trunk6 stable5
#: CalendarTool.cpp:126
#, kde-format
msgid "Calendar from %1 to %2"
msgstr "Calendario de %1 a %2"

#. +> trunk6 stable5
#: CalendarTool.cpp:166
#, kde-format
msgid "week"
msgstr "semana"

