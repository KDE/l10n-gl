msgid "Developer Options"
msgstr "Opcións de desenvolvemento"

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_SaveFocusImages)
#. +> trunk5
#: options/opsdeveloper.ui:40
#, kde-format
msgid ""
"<html><head/><body>"
"<p>Save autofocus frames. Only enable to troubleshoot autofocus by examining frames. This can consume a lot of storage space.</p>"
"</body></html>"
msgstr ""
"<html><head/><body>"
"<p>Gardar os fotogramas de enfoque automático. Só activar para solucionar problemas de enfoque automático examinando os fotogramas. Isto pode consumir unha morea de espazo de almacenamento.</p>"
"</body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_SaveFocusImages)
#. +> trunk5
#: options/opsdeveloper.ui:43
#, kde-format
msgid "Save Focus Images"
msgstr "Gardar as imaxes do foco."

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_SaveGuideImages)
#. +> trunk5
#: options/opsdeveloper.ui:50
#, kde-format
msgid ""
"<html><head/><body>"
"<p>Save Internal Guider frames. Only enable to troubleshoot guider by examining frames. This can consume a lot of storage space.</p>"
"</body></html>"
msgstr ""
"<html><head/><body>"
"<p>Gardar os fotogramas de guieiro interno. Só activar para solucionar problemas de guieiro examinando os fotogramas. Isto pode consumir unha morea de espazo de almacenamento.</p>"
"</body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_SaveGuideImages)
#. +> trunk5
#: options/opsdeveloper.ui:53
#, kde-format
msgid "Save Guider Images"
msgstr "Gardar as imaxes de guieiro."

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_SaveAlignImages)
#. +> trunk5
#: options/opsdeveloper.ui:60
#, kde-format
msgid ""
"<html><head/><body>"
"<p>Save Internal Align frames. Only enable to troubleshoot align by examining frames. This can consume some extra storage space.</p>"
"</body></html>"
msgstr ""
"<html><head/><body>"
"<p>Gardar os fotogramas de aliñamento interno. Só activar para solucionar problemas de aliñamento examinando os fotogramas. Isto pode consumir algo de espazo de almacenamento adicional.</p>"
"</body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_SaveAlignImages)
#. +> trunk5
#: options/opsdeveloper.ui:63
#, kde-format
msgid "Save Align Images"
msgstr "Gardar as imaxes de aliñamento."

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_SaveFailedAlignImages)
#. +> trunk5
#: options/opsdeveloper.ui:70
#, kde-format
msgid ""
"<html><head/><body>"
"<p>Save Align images where align failed. Only enable to troubleshoot align by examining frames. This can consume some extra storage space.</p>"
"</body></html>"
msgstr ""
"<html><head/><body>"
"<p>Gardar as imaxes de aliñamento nas que este fallou. Só activar para solucionar problemas de aliñamento examinando os fotogramas. Isto pode consumir algo de espazo de almacenamento adicional.</p>"
"</body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_SaveFailedAlignImages)
#. +> trunk5
#: options/opsdeveloper.ui:73
#, kde-format
msgid "Save Failed Align Images"
msgstr "Gardar as imaxes de fallo de aliñamento."

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_DontSyncToRealTime)
#. +> trunk5
#: options/opsdeveloper.ui:80
#, kde-format
msgid ""
"<html><head/><body>"
"<p>Do not sync to the system clock when Ekos is started. This could cause issues for real imaging runs, but can be useful in reproducing/debugging issues.</p>"
"</body></html>"
msgstr ""

