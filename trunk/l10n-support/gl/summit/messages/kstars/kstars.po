msgstr "Duración dun pulso en milisegundos. Úsase para os pulsos de guía durante a fase de calibración."

#. i18n: ectx: label, entry (GuideSquareSize), group (Guide)
#. +> trunk5
#: kstars.kcfg:2887
#, kde-format
msgid "Guide square size selection in pixels."
msgstr "Selección en píxeles do tamaño cadrado da guía."

#. i18n: ectx: label, entry (GuideBinning), group (Guide)
#. +> trunk5
#: kstars.kcfg:2891
#, kde-format
msgid "Guide binning."
msgstr "Eliminación de ruído da guía."

#. i18n: ectx: label, entry (GuideAutoStar), group (Guide)
#. +> trunk5
#: kstars.kcfg:2895
#, kde-format
msgid "Automatically select calibration star and perform calibration."
msgstr "Escoller automaticamente a estrela que usar para a calibración e realizar a calibración."

#. i18n: ectx: label, entry (guideShowFrame), group (Guide)
#. +> trunk5
#: kstars.kcfg:2899
#, fuzzy, kde-format
#| msgid "Display Image Overlays."
msgid "Display guiding frames."
msgstr "Amosar imaxes sobrepostas."

#. i18n: ectx: label, entry (AutoModeIterations), group (Guide)
#. +> trunk5
#: kstars.kcfg:2907
#, kde-format
msgid "Number of automode iterations for calibration process."
msgstr "Número de iteracións do modo automático para o proceso de calibración."

#. i18n: ectx: label, entry (GuideLostStarTimeout), group (Guide)
#. +> trunk5
#: kstars.kcfg:2911
#, kde-format
msgid "When star tracking is lost, wait this many seconds before aborting."
msgstr "Cando se perde o seguimento de estrelas, agardar este número de segundos antes de interromper."

#. i18n: ectx: label, entry (GuideCalibrationTimeout), group (Guide)
#. +> trunk5
#: kstars.kcfg:2915
#, kde-format
msgid "When calibration starts, wait this many seconds before aborting."
msgstr "Cando comeza a calibración, agardar este número de segundos antes de interromper."

#. i18n: ectx: label, entry (GuideMaxDeltaRMS), group (Guide)
#. +> trunk5
#: kstars.kcfg:2919
#, kde-format
msgid "Maximum delta RMS permitted while guiding before aborting."
msgstr "RMS delta máximo permitido mestres se guía antes de interromper."

#. i18n: ectx: label, entry (GuideMaxHFR), group (Guide)
#. +> trunk5
#: kstars.kcfg:2923
#, kde-format
msgid "Maximum HFR permitted for SEP MultiStar guide star."
msgstr "HFR máximo permitido para estrelas guías de SEP MultiStar."

#. i18n: ectx: label, entry (MaxMultistarReferenceStars), group (Guide)
#. +> trunk5
#: kstars.kcfg:2931
#, kde-format
msgid "Maximum number of SEP MultiStar number of stars used as references."
msgstr "Número máximo de estrelas de SEP de varias estrelas para usar como referencia."

#. i18n: ectx: label, entry (AlwaysInventGuideStar), group (Guide)
#. +> trunk5
#: kstars.kcfg:2935
#, kde-format
msgid "Invent a guide star position from the multi-star references."
msgstr "Intentar unha posición de estrela guía a partir das referencias de estrelas múltiples."

#. i18n: ectx: label, entry (TwoAxisEnabled), group (Guide)
#. +> trunk5
#: kstars.kcfg:2939
#, kde-format
msgid "Use both axes to perform calibration."
msgstr "Usar ambos os dous eixes para realizar a calibración."

#. i18n: ectx: label, entry (UseGuideHead), group (Guide)
#. +> trunk5
#: kstars.kcfg:2943
#, kde-format
msgid "Use the guider chip for guiding from cameras that have a dedicated guider chip."
msgstr "Usar o chip do guieiro para guiar desde as cámaras que teñen un chip de guieiro dedicado."

#. i18n: ectx: label, entry (SaveGuideLog), group (Guide)
#. +> trunk5
#: kstars.kcfg:2947
#, kde-format
msgid "Automatically save internal guider user logs."
msgstr "Gardar automaticamente os rexistros de persoa usuaria internos do guieiro."

#. i18n: ectx: label, entry (GuideDarkFrame), group (Guide)
#. +> trunk5
#: kstars.kcfg:2951
#, kde-format
msgid "Take dark frame for autoguider images."
msgstr "Capturar un fotograma escuro para as imaxes do guieiro automático."

#. i18n: ectx: label, entry (GuideSubframe), group (Guide)
#. +> trunk5
#: kstars.kcfg:2955
#, kde-format
msgid "Subframe guide image around selected region"
msgstr "Imaxe de guía de fotograma subordinado arredor da rexión seleccionada"

#. i18n: ectx: label, entry (DitherPixels), group (Guide)
#. +> trunk5
#: kstars.kcfg:2959
#, kde-format
msgid "How many pixels to move between subsequent exposures under auto dithering mode."
msgstr "Número de píxeles para mover entre exposicións durante o modo de tramado automático."

#. i18n: ectx: label, entry (DitherFrames), group (Guide)
#. +> trunk5
#: kstars.kcfg:2963
#, kde-format
msgid "Dither after this many frames."
msgstr "Tramar tras este número de fotogramas."

#. i18n: ectx: label, entry (DitherThreshold), group (Guide)
#. +> trunk5
#: kstars.kcfg:2971
#, kde-format
msgid "Maximum distance (pixels) for guiding to be considered settled."
msgstr "Distancia máxima (píxeles) para que o proceso de guía se considere asentado."

#. i18n: ectx: label, entry (DitherTimeout), group (Guide)
#. +> trunk5
#: kstars.kcfg:2975
#, kde-format
msgid "Time limit (seconds) on dithering to settle down."
msgstr "Límite de tempo (en segundos) para que o tramado asente."

#. i18n: ectx: label, entry (DitherMaxIterations), group (Guide)
#. +> trunk5
#: kstars.kcfg:2979
#, kde-format
msgid "How many dithering attempts to undertake before giving up."
msgstr "Cantos intentos de tramado realizar antes de abandonar."

#. i18n: ectx: label, entry (DitherNoGuidingPulse), group (Guide)
#. +> trunk5
#: kstars.kcfg:2983
#, kde-format
msgid "Pulse length in milliseconds used for non-guiding dither."
msgstr "A lonxitude do pulso en milisegundos que se usa para o tramado sen guía."

#. i18n: ectx: label, entry (DitherFailAbortsAutoGuide), group (Guide)
#. +> trunk5
#: kstars.kcfg:2987
#, kde-format
msgid "If dithering fails then abort autoguide."
msgstr "Se o tramado falla interromper a guía automática."

#. i18n: ectx: label, entry (DitherWithOnePulse), group (Guide)
#. +> trunk5
#: kstars.kcfg:2991
#, kde-format
msgid "Dithering amount is randomly generated, pulses are sent, but the resultant pixel dithering amount is not enforced, so only the one dither pulse is sent. This is quicker, and recommended as dither amount is random anyway. It is necessary when 2-D dither is required but guiding is only done in one axis."
msgstr "A cantidade de tramado xérase automaticamente, envíanse os pulsos, pero a cantidade de píxeles do tramado resultante non se forza e só se envía un pulso. Isto é máis rápido, e recoméndase dado que a cantidade de tramado é aleatoria de todos os xeitos. É necesario cando o tramado 2D é necesario pero a guía só se fai nun eixe."

#. i18n: ectx: label, entry (DitherEnabled), group (Guide)
#. +> trunk5
#: kstars.kcfg:2995
#, kde-format
msgid "Use Auto Dithering when guiding."
msgstr "Usar tramado automático ao usar a guía."

#. i18n: ectx: label, entry (DitherNoGuiding), group (Guide)
#. +> trunk5
#: kstars.kcfg:2999
#, kde-format
msgid "Perform dithering even when not guiding."
msgstr "Tramar incluso mentres non se guía."

#. i18n: ectx: label, entry (RAGuideEnabled), group (Guide)
#. +> trunk5
#: kstars.kcfg:3003
#, kde-format
msgid "Enable autoguiding in the RA axis."
msgstr "Activar a guía automática no eixe de ascensión recta (α)."

#. i18n: ectx: label, entry (DECGuideEnabled), group (Guide)
#. +> trunk5
#: kstars.kcfg:3007
#, kde-format
msgid "Enable autoguiding in the DEC axis."
msgstr "Activar a guía automática no eixe de declinación (δ)."

#. i18n: ectx: label, entry (NorthDECGuideEnabled), group (Guide)
#. +> trunk5
#: kstars.kcfg:3011
#, kde-format
msgid "Enable North autoguiding in the DEC axis."
msgstr "Activar a guía automática do norte no eixe de declinación (δ)."

#. i18n: ectx: label, entry (SouthDECGuideEnabled), group (Guide)
#. +> trunk5
#: kstars.kcfg:3015
#, kde-format
msgid "Enable South autoguiding in the DEC axis."
msgstr "Activar a guía automática do sur no eixe de declinación (δ)."

#. i18n: ectx: label, entry (EastRAGuideEnabled), group (Guide)
#. +> trunk5
#: kstars.kcfg:3019
#, kde-format
msgid "Enable East autoguiding in the RA axis."
msgstr "Activar a guía automática do leste no eixe de ascensión recta (α)."

#. i18n: ectx: label, entry (WestRAGuideEnabled), group (Guide)
#. +> trunk5
#: kstars.kcfg:3023
#, kde-format
msgid "Enable West autoguiding in the RA axis."
msgstr "Activar a guía automática do oeste no eixe de ascensión recta (α)."

#. i18n: ectx: label, entry (GuiderAccuracyThreshold), group (Guide)
#. +> trunk5
#: kstars.kcfg:3102
#, kde-format
msgid "Accuracy threshold for the Guide Graphs."
msgstr "Limiar de precisión para os gráficos de guía."

#. i18n: ectx: label, entry (RADisplayedOnGuideGraph), group (Guide)
#. +> trunk5
#: kstars.kcfg:3106
#, kde-format
msgid "Display the RA Plot on the Guide Drift Graphics."
msgstr "Amosar a representación de α nos gráficos de deriva de guía."

#. i18n: ectx: label, entry (DEDisplayedOnGuideGraph), group (Guide)
#. +> trunk5
#: kstars.kcfg:3110
#, kde-format
msgid "Display the DEC Plot on the Guide Drift Graphics."
msgstr "Amosar a representación de δ nos gráficos de deriva de guía."

#. i18n: ectx: label, entry (RACorrDisplayedOnGuideGraph), group (Guide)
#. +> trunk5
#: kstars.kcfg:3114
#, kde-format
msgid "Display the RA Corrections Plot on the Guide Drift Graphics."
msgstr "Amosar a representación de correccións de α nos gráficos de deriva de guía."

#. i18n: ectx: label, entry (DECorrDisplayedOnGuideGraph), group (Guide)
#. +> trunk5
#: kstars.kcfg:3118
#, kde-format
msgid "Display the DEC Corrections Plot on the Guide Drift Graphics."
msgstr "Amosar a representación de correccións de δ nos gráficos de deriva de guía."

#. i18n: ectx: label, entry (SNRDisplayedOnGuideGraph), group (Guide)
#. +> trunk5
#: kstars.kcfg:3122
#, kde-format
msgid "Display the SNR Plot on the Guide Drift Graphics."
msgstr "Amosar a representación de SNR nos gráficos de deriva de guía."

#. i18n: ectx: label, entry (RMSDisplayedOnGuideGraph), group (Guide)
#. +> trunk5
#: kstars.kcfg:3126
#, kde-format
msgid "Display the RMS Error Plot on the Guide Drift Graphics."
msgstr "Amosar a representación do erro de RMS nos gráficos de deriva de guía."

#. i18n: ectx: label, entry (RAHysteresis), group (Guide)
#. +> trunk5
#: kstars.kcfg:3130
#, kde-format
msgid "If > 0, use the hysteresis guider for RA internal guiding with that value."
msgstr ""

#. i18n: ectx: label, entry (DECHysteresis), group (Guide)
#. +> trunk5
#: kstars.kcfg:3134
#, kde-format
msgid "If > 0, use the hysteresis guider for DEC internal guiding with that value."
msgstr ""

#. i18n: ectx: label, entry (SchedulerAlgorithm), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3140
#, kde-format
msgid "Scheduler algorithm"
msgstr "Algoritmo do planificador"

#. i18n: ectx: whatsthis, entry (SchedulerLogging), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3144
#, kde-format
msgid "Log Ekos Scheduler Module activity."
msgstr "Rexistrar a actividade do módulo de planificación de Ekos."

#. i18n: ectx: label, entry (StopEkosAfterShutdown), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3148
#, kde-format
msgid "After shutdown procedure is successfully executed, shutdown INDI and Ekos."
msgstr "Tras executar o proceso de apagado, apagar INDI e Ekos."

#. i18n: ectx: label, entry (AlwaysExecuteStartupScript), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3152
#, kde-format
msgid "Always execute startup script regardless of Ekos status."
msgstr "Executar sempre o guión de inicio, sen importar o estado de Ekos."

#. i18n: ectx: label, entry (ShutdownScriptTerminatesINDI), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3156
#, kde-format
msgid "Whether shutdown script, if exists, terminates INDI server in the process."
msgstr "Se o guión de apagamento, se existe, temina o servidor de INDI no proceso."

#. i18n: ectx: label, entry (PreemptiveShutdown), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3160
#, kde-format
msgid "Perform pre-emptive shutdown if no jobs are due for a number of hours."
msgstr "Realizar un apagamento preventivo se non hai ningunha tarefa programada durante un certo número de horas."

#. i18n: ectx: label, entry (ResetMountModelOnAlignFail), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3164
#, kde-format
msgid "Reset mount model in case of alignment failure."
msgstr "Restabelecer o modelo de montura en caso de fallo de aliñamento."

#. i18n: ectx: label, entry (ResetMountModelBeforeJob), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3168
#, kde-format
msgid "Reset mount model before starting each job."
msgstr "Restabelecer o modelo de montura antes de iniciar cada traballo."

#. i18n: ectx: label, entry (ResetGuideCalibration), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3172
#, kde-format
msgid "Always Reset guiding calibration before starting each job."
msgstr "Restabelecer sempre a calibración de guía antes de iniciar cada traballo."

#. i18n: ectx: label, entry (ForceAlignmentBeforeJob), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3176
#, kde-format
msgid "Force alignment before starting or restarting each job."
msgstr "Forzar o aliñamento antes de iniciar ou reiniciar cada traballo."

#. i18n: ectx: label, entry (ReuseGuideCalibration), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3180
#, kde-format
msgid "Guider may re-use guiding calibration if one is available."
msgstr "O guieiro pode reutilizar a calibración de guía se hai unha dispoñíbel."

#. i18n: ectx: label, entry (ReverseDecOnPierSideChange), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3184
#, kde-format
msgid "Reverse DEC on pier-side change when reusing calibration."
msgstr "Inverter δ ao cambiar de lado de observación ao reutilizar unha calibración."

#. i18n: ectx: label, entry (GuideCalibrationBacklash), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3188
#, kde-format
msgid "Remove DEC backlash when calibrating guider."
msgstr "Eliminar a folgura de δ ao calibrar o guieiro."

#. i18n: ectx: label, entry (SerializedCalibration), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3192
#, kde-format
msgid "Last Calibration serialized."
msgstr "Serializouse a última calibración."

#. i18n: ectx: label, entry (RealignAfterCalibrationFailure), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3195
#, kde-format
msgid "If guiding calibration fails, run alignment process again before proceeding to recalibration."
msgstr "Se a calibración da guía falla, executar o proceso de aliñamento de novo antes de retomar o novo proceso de calibración."

#. i18n: ectx: label, entry (PreemptiveShutdownTime), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3199
#, kde-format
msgid "Maximum number of hours before the next job is due to trigger a pre-emptive shutdown."
msgstr "Número máximo de horas que deben quedar para a seguinte tarefa programada para provocar un apagamento preventivo."

#. i18n: ectx: label, entry (RememberJobProgress), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3203
#, kde-format
msgid "When processing a scheduled job, resume the sequence starting from the last image present in storage."
msgstr "Ao procesar un traballo planificado, continuar a secuencia desde a última imaxe presente no almacenamento."

#. i18n: ectx: label, entry (GreedyScheduling), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3207
#, kde-format
msgid "When true, the scheduler tries to run lower priority jobs when no higher priority job can run. Recommended."
msgstr "Se se activa, o planificador intenta executar os traballos de menor prioridade cando non se poidan executar traballos de maior prioridade. Recoméndase."

#. i18n: ectx: label, entry (LeadTime), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3211
#, kde-format
msgid "Minimum time between jobs in minutes."
msgstr "Tempo mínimo entre as tarefas (en minutos)."

#. i18n: ectx: label, entry (PreDawnTime), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3215
#, kde-format
msgid "Do not permit jobs to be scheduled or executed past this many minutes before dawn."
msgstr "Non permitir que as tarefas se planifiquen ou executen este número de minutos antes do amencer."

#. i18n: ectx: label, entry (DawnOffset), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3219
#, kde-format
msgid "Offset astronomical dawn by this many hours to relax twilight restriction when using narrowband filters."
msgstr "Desprazar o amencer astronómico estas horas para relaxar a restrición do crepúsculo ao usar filtros de banda estreita."

#. i18n: ectx: label, entry (DuskOffset), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3223
#, kde-format
msgid "Offset astronomical dusk by this many hours to relax twilight restriction when using narrowband filters."
msgstr "Desprazar o anoitecer astronómico estas horas para relaxar a restrición do crepúsculo ao usar filtros de banda estreita."

#. i18n: ectx: label, entry (TelescopeFocalLength), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3227
#, kde-format
msgid "Telescope focal length in millimeters."
msgstr "Distancia focal do telescopio en milímetros."

#. i18n: ectx: label, entry (TelescopeFocalReducer), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3231
#, kde-format
msgid "Focal Reducer ratio"
msgstr "Taxa do redutor focal"

#. i18n: ectx: label, entry (CameraPixelWidth), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3235
#, kde-format
msgid "Camera pixel size width in micrometers."
msgstr "Anchura dun píxel da cámara en micrómetros."

#. i18n: ectx: label, entry (CameraPixelHeight), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3239
#, kde-format
msgid "Camera pixel size height in micrometers."
msgstr "Altura dun píxel da cámara en micrómetros."

#. i18n: ectx: label, entry (CameraWidth), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3243
#, kde-format
msgid "Camera Width in pixels."
msgstr "Anchura da cámara en píxeles."

#. i18n: ectx: label, entry (CameraHeight), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3247
#, kde-format
msgid "Camera Height in pixels."
msgstr "Altura da cámara en píxeles."

#. i18n: ectx: label, entry (CameraRotation), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3251
#, kde-format
msgid "Position angle of the camera with respect to north."
msgstr "Ángulo de posición da cámara respecto do norte."

#. i18n: ectx: label, entry (ErrorHandlingStrategy), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3255
#, kde-format
msgid "Strategy how to react, when a job aborts or steps into an error."
msgstr "Estratexia de reacción para cando un traballo se interrompe ou sofre un erro."

#. i18n: ectx: label, entry (ErrorHandlingStrategyDelay), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3259
#, kde-format
msgid "Delay in minutes how long the scheduler should pause before restarting an aborted job or a job that ran into an error."
msgstr "Demora en minutos do planificador antes de reiniciar un traballo interrompido ou un traballo que sufriu un erro."

#. i18n: ectx: label, entry (RescheduleErrors), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3263
#, kde-format
msgid "Re-schedule jobs that ran into errors."
msgstr "Planificar de novo os traballos que sufriron erros."

#. i18n: ectx: label, entry (SchedulerParkDome), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3275
#, kde-format
msgid "Default scheduler checkbox for parking dome on shutdown."
msgstr "Caixa para marcar predeterminada do planificador para estacionar a bóveda ao apagar."

#. i18n: ectx: label, entry (SchedulerParkMount), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3279
#, kde-format
msgid "Default scheduler checkbox for parking mount on shutdown."
msgstr "Caixa para marcar predeterminada do planificador para estacionar a montura ao apagar."

#. i18n: ectx: label, entry (SchedulerCloseDustCover), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3283
#, kde-format
msgid "Default scheduler checkbox for closing dust cover on shutdown."
msgstr "Caixa para marcar predeterminada do planificador para pechar a cuberta ao apagar."

#. i18n: ectx: label, entry (SchedulerWarmCCD), group (Scheduler)
#. +> trunk5
#: kstars.kcfg:3287
