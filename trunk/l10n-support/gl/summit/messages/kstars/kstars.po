#: kstars.kcfg:741
#, kde-format
msgid "Toggle whether the Mosaic Panel are drawn in the sky map."
msgstr "Indica se debe amosarse o panel de mosaico no mapa celeste."

#. i18n: ectx: label, entry (SlewTimeScale), group (View)
#. +> trunk5
#: kstars.kcfg:745
#, kde-format
msgid "Minimum timescale for forced-slewing mode"
msgstr "Escala temporal mínima para o modo de animación forzada"

#. i18n: ectx: whatsthis, entry (SlewTimeScale), group (View)
#. +> trunk5
#: kstars.kcfg:746
#, kde-format
msgid "The timescale above which slewing mode is forced on at all times."
msgstr "A escala temporal a partir da cal o modo con animación é obrigatorio sempre."

#. i18n: ectx: label, entry (BoxBGMode), group (View)
#. +> trunk5
#: kstars.kcfg:750
#, kde-format
msgid "InfoBoxes Background fill mode"
msgstr "Modo de enchemento do fondo dos paneis informativos"

#. i18n: ectx: whatsthis, entry (BoxBGMode), group (View)
#. +> trunk5
#: kstars.kcfg:751
#, kde-format
msgid "The background fill mode for the on-screen information boxes: 0=\"no BG\"; 1=\"semi-transparent BG\"; 2=\"opaque BG\""
msgstr "O modo de enchemento do fondo dos paneis informativos na pantalla: 0=«sen fondo», 1=«fondo translúcido», 2=«fondo opaco»"

#. i18n: ectx: label, entry (Projection), group (View)
#. +> trunk5
#: kstars.kcfg:755
#, kde-format
msgid "Mapping projection algorithm"
msgstr "Algoritmo de proxección do mapa"

#. i18n: ectx: whatsthis, entry (Projection), group (View)
#. +> trunk5
#: kstars.kcfg:756
#, kde-format
msgid "Algorithm for the mapping projection."
msgstr "O algoritmo co que se proxecta o mapa."

#. i18n: ectx: label, entry (UseAbbrevConstellNames), group (View)
#. +> trunk5
#: kstars.kcfg:760
#, kde-format
msgid "Use abbreviated constellation names?"
msgstr "Usar os nomes abreviados das constelacións?"

#. i18n: ectx: whatsthis, entry (UseAbbrevConstellNames), group (View)
#. +> trunk5
#: kstars.kcfg:761
#, kde-format
msgid "Use official IAU abbreviations for constellation names."
msgstr "Usar as abreviacións oficiais da IAU para os nomes das constelacións."

#. i18n: ectx: label, entry (UseLatinConstellNames), group (View)
#. +> trunk5
#: kstars.kcfg:765
#, kde-format
msgid "Use Latin constellation names?"
msgstr "Usar os nomes das constelacións en latín?"

#. i18n: ectx: whatsthis, entry (UseLatinConstellNames), group (View)
#. +> trunk5
#: kstars.kcfg:766
#, kde-format
msgid "Use Latin constellation names."
msgstr "Usa os nomes latinos das constelacións."

#. i18n: ectx: label, entry (UseLocalConstellNames), group (View)
#. +> trunk5
#: kstars.kcfg:770
#, kde-format
msgid "Use localized constellation names?"
msgstr "Usar os nomes das constelacións no teu idioma?"

#. i18n: ectx: whatsthis, entry (UseLocalConstellNames), group (View)
#. +> trunk5
#: kstars.kcfg:771
#, kde-format
msgid "Use localized constellation names (if localized names are not available, default to Latin names)."
msgstr "Usa os nomes traducidos das constelacións (se non estiveren dispoñíbeis, recorrerase aos latinos)."

#. i18n: ectx: label, entry (UseAltAz), group (View)
#. +> trunk5
#: kstars.kcfg:775
#, kde-format
msgid "Use horizontal coordinate system?"
msgstr "Usar un sistema de coordenadas horizontais?"

#. i18n: ectx: whatsthis, entry (UseAltAz), group (View)
#. +> trunk5
#: kstars.kcfg:776
#, kde-format
msgid "Display the sky with horizontal coordinates (when false, equatorial coordinates will be used)."
msgstr "Amosar o ceo con coordenadas horizontais (se non se escolle, usaranse as ecuatoriais)."

#. i18n: ectx: label, entry (UseAutoLabel), group (View)
#. +> trunk5
#: kstars.kcfg:780
#, kde-format
msgid "Automatically label focused object?"
msgstr "Etiquetar automaticamente o obxecto focalizado?"

#. i18n: ectx: whatsthis, entry (UseAutoLabel), group (View)
#. +> trunk5
#: kstars.kcfg:781
#, kde-format
msgid "Toggle whether a centered object automatically gets a name label attached."
msgstr "Indica se debe conectarse automaticamente unha lenda co nome do obxecto que está centrado."

#. i18n: ectx: label, entry (UseAutoTrail), group (View)
#. +> trunk5
#: kstars.kcfg:785 tools/scriptbuilder.cpp:664
#, kde-format
msgid "Automatically add trail to centered solar system body?"
msgstr "Engadir automaticamente o rastro do corpo do sistema solar centrado?"

#. i18n: ectx: whatsthis, entry (UseAutoTrail), group (View)
#. +> trunk5
#: kstars.kcfg:786
#, kde-format
msgid "Toggle whether a centered solar system object automatically gets a trail attached, as long as it remains centered."
msgstr "Indica se debe conectarse un rastro ao obxecto do sistema solar que estea centrado, mentres o estea."

#. i18n: ectx: label, entry (UseHoverLabel), group (View)
#. +> trunk5
#: kstars.kcfg:790
#, kde-format
msgid "Add temporary label on mouse hover?"
msgstr "Engadir unha etiqueta persoal ao pasar co rato?"

#. i18n: ectx: whatsthis, entry (UseHoverLabel), group (View)
#. +> trunk5
#: kstars.kcfg:791
#, kde-format
msgid "Toggle whether the object under the mouse cursor gets a transient name label."
msgstr "Indica se debe amosarse unha lenda co nome do obxecto que estea baixo o rato."

#. i18n: ectx: label, entry (UseRefraction), group (View)
#. +> trunk5
#: kstars.kcfg:795
#, kde-format
msgid "Correct positions for atmospheric refraction?"
msgstr "Corrixir a posicións segundo a refracción atmosférica?"

#. i18n: ectx: whatsthis, entry (UseRefraction), group (View)
#. +> trunk5
#: kstars.kcfg:796
#, kde-format
msgid "Toggle whether object positions are corrected for the effects of atmospheric refraction (only applies when horizontal coordinates are used)."
msgstr "Indica se deben corrixirse as posicións dos corpos polos efectos da refracción atmosférica (só se aplica de se empregaren as coordenadas horizontais)."

#. i18n: ectx: label, entry (UseRelativistic), group (View)
#. +> trunk5
#: kstars.kcfg:800
#, kde-format
msgid "Apply relativistic corrections due to the bending of light in sun's gravitational field"
msgstr "Aplicar as correccións relativistas debidas á curvatura da luz no campo gravitacional solar."

#. i18n: ectx: whatsthis, entry (UseRelativistic), group (View)
#. +> trunk5
#: kstars.kcfg:801
#, kde-format
msgid "Toggle whether corrections due to bending of light around the sun are taken into account"
msgstr "Indica se se teñen en conta as correccións debidas a que a luz se curva arredor do sol"

#. i18n: ectx: label, entry (UseAntialias), group (View)
#. +> trunk5
#: kstars.kcfg:805
#, kde-format
msgid "Use antialiasing when drawing the screen?"
msgstr "Usar suavizado ao debuxar a pantalla?"

#. i18n: ectx: whatsthis, entry (UseAntialias), group (View)
#. +> trunk5
#: kstars.kcfg:806
#, kde-format
msgid "Toggle whether the sky is rendered using antialiasing. Lines and shapes are smoother with antialiasing, but rendering the screen will take more time."
msgstr "Indica se o ceo é debuxado con suavizado. As liñas e outras formas son menos angulosas con suavizado, pero levará máis tempo debuxar a pantalla."

#. i18n: ectx: label, entry (ZoomFactor), group (View)
#. +> trunk5
#: kstars.kcfg:810
#, kde-format
msgid "Zoom Factor, in pixels per radian"
msgstr "Factor de ampliación, en píxeles por radián"

#. i18n: ectx: whatsthis, entry (ZoomFactor), group (View)
#. +> trunk5
#: kstars.kcfg:811
#, kde-format
msgid "The zoom level, measured in pixels per radian."
msgstr "O nivel de ampliación, medido en píxeles por radián."

#. i18n: ectx: label, entry (SkyRotation), group (View)
#. +> trunk5
#: kstars.kcfg:817
#, kde-format
msgid "Angle by which the sky map is rotated"
msgstr "Ángulo de rotación do mapa celeste."

#. i18n: ectx: whatsthis, entry (SkyRotation), group (View)
#. +> trunk5
#: kstars.kcfg:818
#, kde-format
msgid "The angle by which the sky map is rotated from its standard orientation (north up if using equatorial coordinates, zenith up if using horizontal coordinates)."
msgstr "Ángulo de rotación do mapa celeste con respecto á súa orientación estándar (o norte arriba se se usan coordenadas ecuatoriais, o cénit arriba se se usan coordenadas horizontais)."

#. i18n: ectx: label, entry (MirrorSkyMap), group (View)
#. +> trunk5
#: kstars.kcfg:824
#, kde-format
msgid "Mirrors the sky map"
msgstr "Reflicte o mapa celeste."

#. i18n: ectx: whatsthis, entry (MirrorSkyMap), group (View)
#. +> trunk5
#: kstars.kcfg:825
#, kde-format
msgid "Enable this if you want the sky map to be mirrored left-right, e.g. to match the view through an erecting prism."
msgstr "Active isto para reflectir o mapa celeste, de esquerda a dereita, p. ex. para que a vista coincida coa dun prisma en erección."

#. i18n: ectx: label, entry (ErectObserverCorrection), group (View)
#. +> trunk5
#: kstars.kcfg:829
#, kde-format
msgid "Orients the sky-map to account for an erect observer at the eyepiece"
msgstr "Orienta o mapa celeste para ter en conta un observador erecto na vista ocular."

#. i18n: ectx: whatsthis, entry (ErectObserverCorrection), group (View)
#. +> trunk5
#: kstars.kcfg:830
#, kde-format
msgid "Enable this if you are using your eye at the eyepiece in an altazimuth mounted Newtonian telescope. This accounts for the fact that the observer stands erect as the telescope moves up and down, so that the orientation of the sky map will track what is seen in your eyepiece once it is set up correctly. Choose the handedness of the correction according which side of the telescope the eyepiece appears when looking from the back of the telescope"
msgstr "Active isto se usa o seu ollo na vista ocular nun telescopio newtoniano en montura altazimutal. Isto ten en conta que o observador está erecto mentres o telescopio sube e baixa, de xeito que a orientación do mapa celeste faga seguimento ao que se ve na súa vista ocular unha vez configurado correctamente. Escolla a man dominante da corrección segundo en que lado do telescopio aparece a vista ocular ao mirar desde a parte traseira do telescopio."

#. i18n: ectx: label, entry (ErectObserverCorrection), group (View)
#. +> trunk5
#: kstars.kcfg:836
#, kde-format
msgid "Left"
msgstr "Esquerda"

#. i18n: ectx: label, entry (ErectObserverCorrection), group (View)
#. +> trunk5
#: kstars.kcfg:839
#, kde-format
msgid "Right"
msgstr "Dereita"

#. i18n: ectx: label, entry (ZoomScrollFactor), group (View)
#. +> trunk5
#: kstars.kcfg:845
#, kde-format
msgid "Zoom scroll sensitivity."
msgstr "Sensibilidade de desprazamento de ampliación."

#. i18n: ectx: whatsthis, entry (ZoomScrollFactor), group (View)
#. +> trunk5
#: kstars.kcfg:846
#, kde-format
msgid "When zooming in or out, change zoom speed factor by this multiplier."
msgstr "Ao achegar ou afastar, cambiar o factor de velocidade da ampliación segundo este multiplicador."

#. i18n: ectx: label, entry (MagLimitAsteroid), group (View)
#. i18n: ectx: property (toolTip), widget (MagnitudeSpinBox, kcfg_MagLimitAsteroid)
#. +> trunk5
#: kstars.kcfg:852 options/opssolarsystem.ui:447
#, kde-format
msgid "Faint limit for asteroids"
msgstr "Límite de visibilidade dos asteroides"

#. i18n: ectx: whatsthis, entry (MagLimitAsteroid), group (View)
#. +> trunk5
#: kstars.kcfg:853
#, kde-format
msgid "The faint magnitude limit for drawing asteroids."
msgstr "O límite de magnitude mínima para amosar os asteroides."

#. i18n: ectx: label, entry (MagLimitAsteroidDownload), group (View)
#. +> trunk5
#: kstars.kcfg:857
#, kde-format
msgid "Maximum magnitude for asteroids to be downloaded from JPL."
msgstr "Magnitude máxima para que os asteroides se descarguen do JPL."

#. i18n: ectx: whatsthis, entry (MagLimitAsteroidDownload), group (View)
#. +> trunk5
#: kstars.kcfg:858
#, kde-format
msgid "The maximum magnitude (visibility) to filter the asteroid data download from JPL."
msgstr "A magnitude máxima (visibilidade) para filtrar a descarga de datos de asteroides de JPL."

#. i18n: ectx: label, entry (AsteroidLabelDensity), group (View)
#. +> trunk5
#: kstars.kcfg:862
#, kde-format
msgid "Label density for asteroid names"
msgstr "Densidade das lendas cos nomes dos asteroides"

#. i18n: ectx: whatsthis, entry (AsteroidLabelDensity), group (View)
#. +> trunk5
#: kstars.kcfg:863
#, kde-format
msgid "Controls the relative number of asteroid name labels drawn in the map."
msgstr "Controla o número relativo de lendas con nomes de asteroides que son debuxadas no mapa."

#. i18n: ectx: label, entry (MagLimitDrawDeepSky), group (View)
#. +> trunk5
#: kstars.kcfg:867
#, kde-format
msgid "Faint limit for deep-sky objects"
msgstr "Límite de visibilidade para os obxectos do espazo profundo"

#. i18n: ectx: whatsthis, entry (MagLimitDrawDeepSky), group (View)
#. +> trunk5
#: kstars.kcfg:868
#, kde-format
msgid "The faint magnitude limit for drawing deep-sky objects, when fully zoomed in."
msgstr "O límite de magnitude mínima para debuxar os obxectos do espazo profundo cando a ampliación é completa."

#. i18n: ectx: label, entry (MagLimitDrawDeepSkyZoomOut), group (View)
#. +> trunk5
#: kstars.kcfg:872
#, kde-format
msgid "Faint limit for deep-sky objects when zoomed out"
msgstr "Límite de visibilidade dos obxectos do espazo profundo coa ampliación mínima"

#. i18n: ectx: whatsthis, entry (MagLimitDrawDeepSkyZoomOut), group (View)
#. +> trunk5
#: kstars.kcfg:873
#, kde-format
msgid "The faint magnitude limit for drawing deep-sky objects, when fully zoomed out."
msgstr "O límite de magnitude mínima para debuxar os obxectos do espazo profundo cando a redución é completa."

#. i18n: ectx: label, entry (ShowUnknownMagObjects), group (View)
#. +> trunk5
#: kstars.kcfg:877
#, kde-format
msgid "Show deep-sky objects of unknown magnitude"
msgstr "Amosar os obxectos do espazo profundo de magnitude descoñecida."

#. i18n: ectx: whatsthis, entry (ShowUnknownMagObjects), group (View)
#. +> trunk5
#: kstars.kcfg:878
#, kde-format
msgid "When enabled, objects whose magnitudes are unknown, or not available to KStars, are drawn irrespective of the faint limits set."
msgstr "Active esta opción para debuxar con independencia dos límites de visibilidade estabelecidos aqueles obxectos de magnitude descoñecida ou non dispoñíbeis en KStars."

#. i18n: ectx: label, entry (ShowInlineImages), group (View)
#. +> trunk5
#: kstars.kcfg:882
#, kde-format
msgid "Draw inline images for some objects on the sky?"
msgstr "Debuxar imaxes in situ para algúns obxectos celestes?"

#. i18n: ectx: label, entry (MagLimitDrawStar), group (View)
#. +> trunk5
#: kstars.kcfg:887
#, kde-format
msgid "Faint limit for stars"
msgstr "Límite de visibilidade das estrelas"

#. i18n: ectx: whatsthis, entry (MagLimitDrawStar), group (View)
#. +> trunk5
#: kstars.kcfg:888
#, kde-format
msgid "The faint magnitude limit for drawing stars, when fully zoomed in."
msgstr "O límite de magnitude para amosar as estrelas cando a ampliación é completa."

#. i18n: ectx: label, entry (StarDensity), group (View)
#. +> trunk5
#: kstars.kcfg:892
#, kde-format
msgid "Density of stars in the field of view"
msgstr "Densidade das estrelas no campo de visión"

#. i18n: ectx: whatsthis, entry (StarDensity), group (View)
#. +> trunk5
#: kstars.kcfg:893
#, kde-format
msgid "Sets the density of stars in the field of view"
msgstr "Indica a densidade das estrelas no campo de visión"

#. i18n: ectx: label, entry (MagLimitDrawStarZoomOut), group (View)
#. +> trunk5
#: kstars.kcfg:898
#, kde-format
msgid "Faint limit for stars when zoomed out"
msgstr "Límite de visibilidade das estrelas cando a ampliación é mínima"

#. i18n: ectx: whatsthis, entry (MagLimitDrawStarZoomOut), group (View)
#. +> trunk5
#: kstars.kcfg:899
#, kde-format
msgid "The faint magnitude limit for drawing stars, when fully zoomed out."
msgstr "O limite mínimo da visibilidade para debuxar as estrelas cando a redución é máxima."

#. i18n: ectx: label, entry (MagLimitHideStar), group (View)
#. +> trunk5
#: kstars.kcfg:904
#, kde-format
msgid "Faint limit for stars when slewing"
msgstr "Límite de visibilidade das estrelas cando se mostra a animación"

#. i18n: ectx: whatsthis, entry (MagLimitHideStar), group (View)
#. +> trunk5
#: kstars.kcfg:905
#, kde-format
msgid "The faint magnitude limit for drawing stars, when the map is in motion (only applicable if faint stars are set to be hidden while the map is in motion)."
msgstr "O límite de magnitude da visibilidade para debuxas as estrelas, cando o mapa está en movemento (só se aplica se deben agocharse as estrelas débiles cando o mapa está en movemento)."

#. i18n: ectx: label, entry (StarLabelDensity), group (View)
#. +> trunk5
#: kstars.kcfg:909
#, kde-format
msgid "Relative density for star name labels and/or magnitudes"
msgstr "A densidade relativa das lendas cos nomes e/ou magnitudes das estrelas"

#. i18n: ectx: whatsthis, entry (StarLabelDensity), group (View)
#. +> trunk5
#: kstars.kcfg:910
#, kde-format
msgid "The relative density for drawing star name and magnitude labels."
msgstr "A densidade relativa para amosar lendas cos nomes e magnitudes das estrelas."

#. i18n: ectx: label, entry (DeepSkyLabelDensity), group (View)
#. +> trunk5
#: kstars.kcfg:914
#, kde-format
msgid "Relative density for deep-sky object name labels and/or magnitudes"
msgstr "A densidade relativa das lendas dos obxectos do espazo profundo e/ou as magnitudes"

#. i18n: ectx: whatsthis, entry (DeepSkyLabelDensity), group (View)
#. +> trunk5
#: kstars.kcfg:915
#, kde-format
msgid "The relative density for drawing deep-sky object name and magnitude labels."
msgstr "A densidade relativa para amosar lendas cos nomes e magnitudes dos obxectos do espazo profundo."

#. i18n: ectx: label, entry (DeepSkyLongLabels), group (View)
#. +> trunk5
#: kstars.kcfg:919
#, kde-format
msgid "Show long names in deep-sky object name labels?"
msgstr "Amosar os nomes longos nas etiquetas dos nomes dos obxectos do espazo profundo?"

#. i18n: ectx: whatsthis, entry (DeepSkyLongLabels), group (View)
#. +> trunk5
#: kstars.kcfg:920
#, kde-format
msgid "If true, long names (common names) for deep-sky objects are shown in the labels."
msgstr "Se é verdadeiro, amosar os nomes longos (nomes comúns) dos obxectos do espazo profundo nas súas etiquetas."

#. i18n: ectx: label, entry (LabelFontScaling), group (View)
#. i18n: ectx: property (toolTip), widget (QSpinBox, kcfg_XplanetFontSize)
#. +> trunk5
#: kstars.kcfg:924 xplanet/opsxplanet.ui:656
#, kde-format
msgid "Label font size"
msgstr "Tamaño do tipo de letra da etiqueta"

#. i18n: ectx: whatsthis, entry (LabelFontScaling), group (View)
#. +> trunk5
#: kstars.kcfg:925
#, kde-format
msgid "Set this to adjust the font-size of labels placed on the sky map"
msgstr "Marque isto para axustar o tamaño de letra das etiquetas do mapa celeste."

#. i18n: ectx: label, entry (MaxRadCometName), group (View)
#. +> trunk5
#: kstars.kcfg:929
#, kde-format
msgid "Maximum distance from Sun for labeling comets, in AU"
msgstr "A distancia máxima ao Sol para etiquetar os cometas, en UA"

#. i18n: ectx: whatsthis, entry (MaxRadCometName), group (View)
#. +> trunk5
#: kstars.kcfg:930
#, kde-format
msgid "The maximum solar distance for drawing comets."
msgstr "A distancia máxima ao sol para debuxar os cometas."

#. i18n: ectx: label, entry (UseGL), group (View)
#. +> trunk5
#: kstars.kcfg:934
#, kde-format
msgid "Switch to OpenGL backend"
msgstr "Pasar á infraestrutura OpenGL"

#. i18n: ectx: whatsthis, entry (UseGL), group (View)
#. +> trunk5
#: kstars.kcfg:935
#, kde-format
msgid "Use experimental OpenGL backend (deprecated)."
msgstr "Usar a infraestrutura experimental de OpenGL (obsoleta)."

#. i18n: ectx: label, entry (RunClock), group (View)
#. +> trunk5
#: kstars.kcfg:939
#, kde-format
msgid "Run clock"
msgstr "Usar o reloxo"

#. i18n: ectx: whatsthis, entry (RunClock), group (View)
#. +> trunk5
#: kstars.kcfg:940
#, kde-format
msgid "The state of the clock (running or not)"
msgstr "O estado do reloxo (parado ou non)"

#. i18n: ectx: label, entry (ImagingPlannerAcceptOpenCluster), group (ImagingPlanner)
#. +> trunk5
#: kstars.kcfg:946
#, kde-format
msgid "Should the imaging Planner tool process open clusters."
msgstr "Debería a ferramenta de planificador de tomas procesar cúmulos abertos."

