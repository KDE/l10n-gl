msgstr "Usar a versión gráfica para contar capturas, secuencias e totais usando barras de progreso arredondadas."

#. i18n: ectx: label, entry (MinimumAltLimit), group (Mount)
#. +> trunk5
#: kstars.kcfg:1906
#, kde-format
msgid "Default minimum mount altitude limit"
msgstr "Altura mínima predeterminada da montura."

#. i18n: ectx: label, entry (MaximumAltLimit), group (Mount)
#. +> trunk5
#: kstars.kcfg:1911
#, kde-format
msgid "Default maximum mount altitude limit."
msgstr "Altura máxima predeterminada da montura."

#. i18n: ectx: whatsthis, entry (MaximumAltLimit), group (Mount)
#. +> trunk5
#: kstars.kcfg:1912
#, kde-format
msgid "Maximum telescope altitude limit. If the telescope is above this limit, it will be commanded to stop."
msgstr "Altitude máxima do telescopio. Se o telescopio está por riba deste límite, ordenarase que se deteña."

#. i18n: ectx: label, entry (EnableAltitudeLimits), group (Mount)
#. +> trunk5
#: kstars.kcfg:1916
#, kde-format
msgid "Enable mount altitude limits."
msgstr "Activar os límites da altura da montura."

#. i18n: ectx: label, entry (EnableAltitudeLimitsTrackingOnly), group (Mount)
#. +> trunk5
#: kstars.kcfg:1920
#, kde-format
msgid "Restrict altitude limits to tracking mode only."
msgstr "Restrinxir os límites de altitude ao modo de seguimento."

#. i18n: ectx: label, entry (ConfirmBelowHorizon), group (Mount)
#. +> trunk5
#: kstars.kcfg:1924
#, kde-format
msgid "Warn user before command mount to go to a target below horizon."
msgstr "Avisar á persoa usuaria antes de ordenar á montura ir a un destino baixo o horizonte."

#. i18n: ectx: label, entry (MeridianFlipOffsetDegrees), group (Mount)
#. +> trunk5
#: kstars.kcfg:1928
#, kde-format
msgid "Default hour angle to perform meridian flip in degrees."
msgstr "Ángulo de hora predeterminado para realizar a volta do meridiano en graos."

#. i18n: ectx: whatsthis, entry (MeridianFlipOffsetDegrees), group (Mount)
#. +> trunk5
#: kstars.kcfg:1929
#, kde-format
msgid "If the target hour angle exceeds this value, Ekos will command a meridian flip and if successful it will resume guiding and capture operations."
msgstr "Se o ángulo de hora de destino supera este valor, Ekos ordenará un movemento do meridiano, e se o movemento se completa correctamente, continuaranse as operacións de guía e captura."

#. i18n: ectx: label, entry (MaximumHaLimit), group (Mount)
#. +> trunk5
#: kstars.kcfg:1933
#, kde-format
msgid "Default maximum limit for the hour angle."
msgstr "Límite máximo predeterminado do ángulo de hora."

#. i18n: ectx: whatsthis, entry (MaximumHaLimit), group (Mount)
#. +> trunk5
#: kstars.kcfg:1934
#, kde-format
msgid "Maximum limit for the hour angle of the telescope. If the hour angle of the telescope is above this limit, a meridian flip will be forced."
msgstr "O límite máximo para o ángulo de hora do telescopio. Se o ángulo de hora do telescopio supera o límite, forzarase a volta do meridiano."

#. i18n: ectx: label, entry (EnableHaLimit), group (Mount)
#. +> trunk5
#: kstars.kcfg:1938
#, kde-format
msgid "Enable mount hour angle limit."
msgstr "Activar o límite do ángulo de hora da montura."

#. i18n: ectx: label, entry (ExecuteMeridianFlip), group (Mount)
#. +> trunk5
#: kstars.kcfg:1942
#, kde-format
msgid "Flips the mount when reaching the meridian, if supported."
msgstr "Move a montura ao acadar o meridiano, se se permite."

#. i18n: ectx: label, entry (LeftRightReversed), group (Mount)
#. +> trunk5
#: kstars.kcfg:1946
#, kde-format
msgid "Reverse the direction of right and left buttons in mount control."
msgstr "Inverter a dirección dos botóns dereito e esquerdo no control da montura."

#. i18n: ectx: label, entry (UpDownReversed), group (Mount)
#. +> trunk5
#: kstars.kcfg:1950
#, kde-format
msgid "Reverse the direction of up and down buttons in mount control."
msgstr "Inverter a dirección dos botóns de arriba e abaixo no control da montura."

#. i18n: ectx: label, entry (ParkEveryDay), group (Mount)
#. +> trunk5
#: kstars.kcfg:1954
#, kde-format
msgid "Automatically start parking timer on startup."
msgstr "Iniciar automaticamente o temporizador de estacionamento no inicio."

#. i18n: ectx: label, entry (ParkTime), group (Mount)
#. +> trunk5
#: kstars.kcfg:1958
#, kde-format
msgid "Park mount at this time in 12 hour format."
msgstr "Estacionar a montura neste hora en formato de 12 horas."

#. i18n: ectx: label, entry (DefaultObserver), group (Capture)
#. +> trunk5
#: kstars.kcfg:1964
#, kde-format
msgid "Default observer full name."
msgstr "Nome completo de observador predeterminado."

#. i18n: ectx: label, entry (SyncFOVPA), group (Capture)
#. +> trunk5
#: kstars.kcfg:1967
#, kde-format
msgid "Sync FOV indicator Position Angle with Rotator Settings Position Angle"
msgstr "Sincronizar o ángulo de posición do indicador de campo de visión co ángulo de posición da configuración do rotor"

#. i18n: ectx: label, entry (PAMultiplier), group (Capture)
#. +> trunk5
#: kstars.kcfg:1971
#, kde-format
msgid "Position angle multiplier"
msgstr "Multiplicador do ángulo de posición"

#. i18n: ectx: label, entry (PAOffset), group (Capture)
#. +> trunk5
#: kstars.kcfg:1975
#, kde-format
msgid "Position angle offset"
msgstr "Desprazamento do ángulo de posición"

#. i18n: ectx: label, entry (PAPierSide), group (Capture)
#. +> trunk5
#: kstars.kcfg:1979
#, kde-format
msgid "Position angle calibration pier side"
msgstr "Lado de observación de calibración do ángulo de posición"

#. i18n: ectx: label, entry (GuideDeviation), group (Capture)
#. +> trunk5
#: kstars.kcfg:1982
#, kde-format
msgid "Default maximum permittable guide deviation"
msgstr "Desviación da guía máxima permisíbel predeterminada"

#. i18n: ectx: whatsthis, entry (GuideDeviation), group (Capture)
#. +> trunk5
#: kstars.kcfg:1983
#, kde-format
msgid "If guide deviation exceeds this limit, the exposure will be automatically aborted and only resumed when the deviation is within this limit."
msgstr "Se a desviación da guía supera este límite, a exposición interromperase automaticamente e só continuara unha vez a desviación volva estar dentro do límite."

#. i18n: ectx: label, entry (GuideDeviationReps), group (Capture)
#. +> trunk5
#: kstars.kcfg:1987
#, kde-format
msgid "Number of consecutive samples guide deviation needs to be high to abort capture."
msgstr "Número de mostras consecutivas que a desviación da guía necesita que sexan altas para interromper a captura."

#. i18n: ectx: whatsthis, entry (GuideDeviationReps), group (Capture)
#. +> trunk5
#: kstars.kcfg:1988
#, kde-format
msgid "Sets the number of consecutive samples guide deviation needs to be high to abort capture."
msgstr "Define o número de mostras consecutivas que a desviación da guía necesita que sexan altas para interromper a captura."

#. i18n: ectx: label, entry (StartGuideDeviation), group (Capture)
#. +> trunk5
#: kstars.kcfg:1992
#, kde-format
msgid "Default maximum permittable guide deviation before capture start"
msgstr "Desviación da guía máxima permisíbel predeterminada antes de iniciar a captura."

#. i18n: ectx: whatsthis, entry (StartGuideDeviation), group (Capture)
#. +> trunk5
#: kstars.kcfg:1993
#, kde-format
msgid "If guide deviation exceeds this limit before capture start, starting an exposure will be suspended until the deviation is within this limit."
msgstr "Se a desviación da guía supera este límite antes de que se inicie a captura, iniciar unha exposición suspenderase ata que a desviación volva estar dentro do límite."

#. i18n: ectx: label, entry (GuideDitherPerJobFrequency), group (Capture)
#. +> trunk5
#: kstars.kcfg:1997
#, kde-format
msgid "Set global dither frequency to this value when starting a job. Set 0 to use global value."
msgstr "Definir a frecuencia global de tramado con este valor ao iniciar un traballo. Use 0 para usar o valor global."

#. i18n: ectx: label, entry (HFRDeviation), group (Capture)
#. +> trunk5
#: kstars.kcfg:2001
#, kde-format
msgid "Default maximum permittable HFR deviation"
msgstr "Desviación do HFR máxima permisíbel predeterminada"

#. i18n: ectx: whatsthis, entry (HFRDeviation), group (Capture)
#. +> trunk5
#: kstars.kcfg:2002
#, kde-format
msgid "If HFR deviation exceeds this limit, the autofocus routine will be automatically started."
msgstr "Se a desviación de HFR supera este límite, iníciase automaticamente a rutina para enfocar automaticamente."

#. i18n: ectx: label, entry (MaxFocusTemperatureDelta), group (Capture)
#. +> trunk5
#: kstars.kcfg:2006
#, kde-format
msgid "Default maximum focus temperature delta"
msgstr "Diferencia de temperatura predeterminada do enfoque máximo."

#. i18n: ectx: whatsthis, entry (MaxFocusTemperatureDelta), group (Capture)
#. +> trunk5
#: kstars.kcfg:2007
#, kde-format
msgid "If the temperature change exceeds this limit, the autofocus routine will be automatically started."
msgstr "Se o cambio de temperatura supera este límite, iníciase automaticamente a rutina para enfocar automaticamente."

#. i18n: ectx: label, entry (AutoDark), group (Capture)
#. +> trunk5
#: kstars.kcfg:2011
#, kde-format
msgid "Automatically apply dark subtraction if a suitable dark frame is available."
msgstr "Aplicar automaticamente unha resta de escuro se hai un fotograma escuro axeitado dispoñíbel."

#. i18n: ectx: label, entry (EnforceGuideDeviation), group (Capture)
#. +> trunk5
#: kstars.kcfg:2015
#, kde-format
msgid "Enforce guiding deviation limit."
msgstr "Aplicar o límite de desvío da guía."

#. i18n: ectx: label, entry (EnforceAutofocusHFR), group (Capture)
#. +> trunk5
#: kstars.kcfg:2019
#, kde-format
msgid "Enforce Autofocus on HFR limit."
msgstr "Forzar o enfoque automático no límite de HFR."

#. i18n: ectx: label, entry (EnforceAutofocusOnTemperature), group (Capture)
#. +> trunk5
#: kstars.kcfg:2023
#, kde-format
msgid "Enforce Autofocus on temperature change."
msgstr "Forzar o enfoque automático ao cambiar a temperatura."

#. i18n: ectx: label, entry (EnforceRefocusEveryN), group (Capture)
#. +> trunk5
#: kstars.kcfg:2027
#, kde-format
msgid "Enforce Refocus Every N Minutes."
msgstr "Forzar enfocar de novo cada N minutos."

#. i18n: ectx: label, entry (RefocusEveryN), group (Capture)
#. +> trunk5
#: kstars.kcfg:2031
#, kde-format
msgid "Number of minute between forced refocus attempts"
msgstr "Número de minutos entre intentos forzados de foco automático"

#. i18n: ectx: whatsthis, entry (RefocusEveryN), group (Capture)
#. +> trunk5
#: kstars.kcfg:2032
#, kde-format
msgid "Sets the time interval before forced autofocus attempts during a capture sequence."
msgstr "Define o intervalo de tempo ata que se forcen os intentos de enfoque automático durante a secuencia de captura."

#. i18n: ectx: label, entry (RefocusAfterMeridianFlip), group (Capture)
#. +> trunk5
#: kstars.kcfg:2036
#, kde-format
msgid "Refocus after meridian flip is done"
msgstr "Enfocar de novo tras completarse a volta do meridiano."

#. i18n: ectx: label, entry (ResetMountModelAfterMeridian), group (Capture)
#. +> trunk5
#: kstars.kcfg:2040
#, kde-format
msgid "Reset mount model after meridian flip."
msgstr "Restabelecer o modelo de montura tras a volta do meridiano."

#. i18n: ectx: label, entry (ForcedFlip), group (Capture)
#. +> trunk5
#: kstars.kcfg:2044
#, kde-format
msgid "Use Forced meridian flips if supported."
msgstr "Usar «Voltas do meridiano forzadas» se se permite."

#. i18n: ectx: label, entry (CalibrationADUValue), group (Capture)
#. +> trunk5
#: kstars.kcfg:2048
#, kde-format
msgid "Desired flat field ADU"
msgstr "ADU de campo simple desexada"

#. i18n: ectx: whatsthis, entry (CalibrationADUValue), group (Capture)
#. +> trunk5
#: kstars.kcfg:2049
#, kde-format
msgid "If set, Ekos will capture a few flat images to determine the optimal exposure time to achieve the desired ADU value."
msgstr "Se se define, Ekos capturará algunhas imaxes simples para determinar o tempo de exposición óptimo para conseguir o valor de conversión de analóxico a dixital (ADU) desexada."

#. i18n: ectx: label, entry (CalibrationADUValueTolerance), group (Capture)
#. +> trunk5
#: kstars.kcfg:2053
#, kde-format
msgid "ADU Value tolerance"
msgstr "Tolerancia de valor de ADU"

#. i18n: ectx: whatsthis, entry (CalibrationADUValueTolerance), group (Capture)
#. +> trunk5
#: kstars.kcfg:2054
#, kde-format
msgid "Maximum difference between measured and target ADU values to deem the value as acceptable."
msgstr "Diferenza máxima entre os valores de ADU medidos e de destino para considerar o valor aceptábel."

#. i18n: ectx: label, entry (CalibrationSkyFlat), group (Capture)
#. +> trunk5
#: kstars.kcfg:2058
#, kde-format
msgid "Sky Flat"
msgstr "Plano celeste"

#. i18n: ectx: whatsthis, entry (CalibrationSkyFlat), group (Capture)
#. +> trunk5
#: kstars.kcfg:2059
#, kde-format
msgid "When shooting flats on sky with changing intensity."
msgstr "Ao facer capturas planas nun ceo con intensidade cambiante."

#. i18n: ectx: label, entry (CalibrationPreActionIndex), group (Capture)
#. +> trunk5
#: kstars.kcfg:2063
#, kde-format
msgid "ORed list of calibration pre-actions."
msgstr "Lista de ORed de previas de accións de calibración."

#. i18n: ectx: label, entry (CalibrationFlatDurationIndex), group (Capture)
#. +> trunk5
#: kstars.kcfg:2067
#, kde-format
msgid "Index of flat duration option."
msgstr "Índice da opción de duración plana."

#. i18n: ectx: label, entry (CalibrationWallAz), group (Capture)
#. +> trunk5
#: kstars.kcfg:2071
#, kde-format
msgid "Azimuth of calibration wall location."
msgstr "Acimut do lugar da muralla de calibración."

#. i18n: ectx: label, entry (CalibrationWallAlt), group (Capture)
#. +> trunk5
#: kstars.kcfg:2075
#, kde-format
msgid "Altitude of calibration wall location."
msgstr "Altitude do lugar da muralla de calibración."

#. i18n: ectx: label, entry (MaxTemperatureDiff), group (Capture)
#. +> trunk5
#: kstars.kcfg:2079
#, kde-format
msgid "Maximum acceptable difference between requested and measured temperature set point."
msgstr "Diferenza máxima aceptábel entre a temperatura solicitada e a temperatura real medida."

#. i18n: ectx: label, entry (MaxStartGuiderDrift), group (Capture)
#. +> trunk5
#: kstars.kcfg:2083
#, kde-format
msgid "Maximum acceptable guider drift allowed before starting capture."
msgstr "Deriva máxima do guieiro permitida para iniciar a captura."

#. i18n: ectx: label, entry (EnforceStartGuiderDrift), group (Capture)
#. +> trunk5
#: kstars.kcfg:2087
#, kde-format
msgid "Enforce maximum acceptable guider drift allowed before starting capture."
msgstr "Facer que se cumpra a deriva máxima do guieiro permitida para iniciar a captura."

#. i18n: ectx: label, entry (GuidingSettle), group (Capture)
#. +> trunk5
#: kstars.kcfg:2091
#, kde-format
msgid "Wait this many seconds after guiding is resumed before starting capture."
msgstr "Agardar este número de segundos tras retomar a guía antes de iniciar a captura."

#. i18n: ectx: label, entry (AlwaysResetSequenceWhenStarting), group (Capture)
#. +> trunk5
#: kstars.kcfg:2095
#, kde-format
msgid ""
"<html><head/><body>"
"<p>When starting to process a sequence list, reset all capture counts to zero. Scheduler overrides this option when Remember Job Progress is enabled.</p>"
"</body></html>"
msgstr ""
"<html><head/><body>"
"<p>Ao iniciar o procesamento dunha lista de secuencia, restabelecer todos os contadores de captura a cero. O planificador sobrepón esta opción cando se activa «Lembrar o progreso do traballo».</p>"
"</body></html>"

#. i18n: ectx: label, entry (FlatSyncFocus), group (Capture)
#. +> trunk5
#: kstars.kcfg:2099
#, kde-format
msgid "Capture flat frames at the same focus position of light frames."
msgstr "Capturar os fotogramas planos na mesma posición de foco dos fotogramas claros."

#. i18n: ectx: label, entry (HFRThresholdPercentage), group (Capture)
#. +> trunk5
#: kstars.kcfg:2103
#, kde-format
msgid "Increase autofocus HFR value by this percentage gain and store it in Capture Module."
msgstr "Aumentar o valor de HFR de foco automático nesta ganancia en porcentaxe e almacenalo no módulo de captura."

#. i18n: ectx: whatsthis, entry (HFRCheckAlgorithm), group (Capture)
#. +> trunk5
#: kstars.kcfg:2107
#, kde-format
msgid "Algorithm for In Sequence HFR Check"
msgstr "Algoritmo da comprobación de HFR en secuencia."

#. i18n: ectx: label, entry (InSequenceCheckFrames), group (Capture)
#. +> trunk5
#: kstars.kcfg:2111
#, kde-format
msgid "Run In-Sequence HFR check after this many frames."
msgstr "Executar unha comprobación de HFR en secuencia despois deste número de fotogramas."

#. i18n: ectx: label, entry (AutoStretch), group (Capture)
#. +> trunk5
#: kstars.kcfg:2115
#, kde-format
msgid "Perform auto stretch on captured images in FITS Viewer."
msgstr "Realizar un estirón automático nas imaxes capturadas no visor de FITS."

#. i18n: ectx: label, entry (Clipping64KValue), group (Capture)
#. +> trunk5
#: kstars.kcfg:2123
#, kde-format
msgid "Min value of pixels marked as clipped in the fitsviewer for 16-bit images."
msgstr "Valor mínimo de píxeles marcados como recortados no visor de FITS para imaxes de 16 bits."

#. i18n: ectx: label, entry (Clipping256Value), group (Capture)
#. +> trunk5
#: kstars.kcfg:2127
#, kde-format
msgid "Min value of pixels marked as clipped in the fitsviewer for 8-bit images."
msgstr "Valor mínimo de píxeles marcados como recortados no visor de FITS para imaxes de 8 bits."

#. i18n: ectx: label, entry (AdaptiveSampling), group (Capture)
#. +> trunk5
#: kstars.kcfg:2132
#, kde-format
msgid "Automatically down sample images based on available resources."
msgstr "Reducir automaticamente a taxa de mostras das imaxes en liña cos recursos dispoñíbeis."

#. i18n: ectx: label, entry (useSummaryPreview), group (Capture)
#. +> trunk5
#: kstars.kcfg:2136
#, kde-format
msgid "Display every image captured sequence image in the Ekos summary screen preview window."
msgstr "Amosar todas as imaxes de secuencia capturadas na xanela de vista previa da pantalla de resumo de Ekos."

#. i18n: ectx: label, entry (useDSLRImageViewer), group (Capture)
#. +> trunk5
#: kstars.kcfg:2140
#, kde-format
msgid "Display every captured DSLR image in the Image Viewer window."
msgstr "Amosar todas as imaxes de DSLR capturadas na xanela do visor de imaxes."

#. i18n: ectx: label, entry (ForceDSLRPresets), group (Capture)
#. +> trunk5
#: kstars.kcfg:2144
#, kde-format
msgid "Force exposure times to align with DSLR exposure presets. This insures accurate exposure times for sub-second exposures."
msgstr "Forzar que os tempos de exposición se aliñen coas predefinicións de exposición de DSLR. Esto asegura que os tempos de exposición son precisos para exposicións de menos dun segundo."

#. i18n: ectx: label, entry (CaptureDirectory), group (Capture)
#. +> trunk5
#: kstars.kcfg:2148
#, kde-format
msgid "Path to capture directory to save images."
msgstr "Ruta do directorio de captura para gardar imaxes."

#. i18n: ectx: label, entry (PlaceholderFormat), group (Capture)
#. +> trunk5
#: kstars.kcfg:2151
#, kde-format
msgid "How to format captured image filename."
msgstr "Como formatar o nome de ficheiro da imaxe capturada."

#. i18n: ectx: label, entry (RemoteCaptureDirectory), group (Capture)
#. +> trunk5
#: kstars.kcfg:2155
#, kde-format
msgid "Path to remote capture directory to save images."
msgstr "Ruta do directorio remoto de captura para gardar imaxes."

#. i18n: ectx: label, entry (ManualCoverTimeout), group (Capture)
#. +> trunk5
#: kstars.kcfg:2158
#, kde-format
msgid "Cover or uncover telescope dialog timeout in seconds."
msgstr "Tempo límite do diálogo de cubrir ou descubrir o telescopio en segundos."

#. i18n: ectx: label, entry (CaptureOperationsTimeout), group (Capture)
#. +> trunk5
#: kstars.kcfg:2162
#, kde-format
msgid "Maximum number of seconds to wait before aborting the capture if operations like filter wheel changes or meridian flips take too long."
msgstr "Número máximo de segundos que agardar antes de interromper a captura se operacións como cambios da roda de filtro ou voltas do meridiano tardan demasiado."

#. i18n: ectx: label, entry (MinFlipDuration), group (Capture)
#. +> trunk5
#: kstars.kcfg:2166
#, kde-format
msgid "Minimal duration of a meridian flip."
msgstr "Duración mínima da volta do meridiano."

#. i18n: ectx: label, entry (CapturePosition), group (Capture)
#. +> trunk5
#: kstars.kcfg:2170
#, kde-format
msgid "Calculate position after captures."
msgstr "Calcular a posición tras as capturas."

#. i18n: ectx: label, entry (CaptureTrainID), group (Capture)
#. +> trunk5
#: kstars.kcfg:2174
#, kde-format
msgid "Optical train ID most recently used in Capture."
msgstr "Identificador de tren óptico cun uso máis recente na captura."

#. i18n: ectx: label, entry (CaptureCalibrationWall), group (Capture)
#. +> trunk5
#: kstars.kcfg:2177
#, kde-format
msgid "Go to specific coordinates on calibration."
msgstr "Ir a coordenadas específicas ao calibrar."

#. i18n: ectx: label, entry (CaptureCalibrationParkMount), group (Capture)
#. +> trunk5
#: kstars.kcfg:2181
#, kde-format
msgid "Park mount on calibration."
msgstr "Estacionar a montura ao calibrar."

#. i18n: ectx: label, entry (CaptureCalibrationParkDome), group (Capture)
#. +> trunk5
#: kstars.kcfg:2185
#, kde-format
msgid "Park dome on calibration."
msgstr "Estacionar a bóveda ao calibrar."

#. i18n: ectx: label, entry (CaptureCalibrationUseManual), group (Capture)
#. +> trunk5
#: kstars.kcfg:2189
#, kde-format
msgid "Capture calibration frames at the specified exposures."
msgstr "Capturar os fotogramas de calibración nas exposicións indicadas."

#. i18n: ectx: label, entry (CaptureCalibrationUseADU), group (Capture)
#. +> trunk5
#: kstars.kcfg:2193
#, kde-format
msgid "Capture calibration frames using ADU threshold."
msgstr "Capturar os fotogramas de calibración co limiar de ADU."

#. i18n: ectx: label, entry (CaptureCalibrationADUValue), group (Capture)
#. +> trunk5
#: kstars.kcfg:2197
#, kde-format
msgid "Desired flat frame ADU value."
msgstr "Valor de ADU desexado para os fotogramas planos."

#. i18n: ectx: label, entry (CaptureCalibrationADUTolerance), group (Capture)
#. +> trunk5
#: kstars.kcfg:2201
#, kde-format
msgid "Desired flat frame ADU tolerance."
msgstr "Tolerancia de ADU desexada para os fotogramas planos."

#. i18n: ectx: label, entry (CaptureCalibrationSkyFlats), group (Capture)
#. +> trunk5
#: kstars.kcfg:2205
#, kde-format
msgid "Capture calibration frames using Sky Flats."
msgstr "Capturar os fotogramas de calibración con planos celestes."

#. i18n: ectx: whatsthis, entry (AbsTicksSpin), group (Focus)
#. +> trunk5
#: kstars.kcfg:2211
#, kde-format
msgid "The desired focuser position."
msgstr "A posición desexada do enfocador."

#. i18n: ectx: label, entry (FocusExposure), group (Focus)
#. +> trunk5
#: kstars.kcfg:2215
#, kde-format
msgid "Exposure to use during focus"
msgstr "Exposición para usar durante o foco."

#. i18n: ectx: whatsthis, entry (FocusExposure), group (Focus)
#. +> trunk5
#: kstars.kcfg:2216
#, kde-format
msgid "Specifies the length of exposure to use during focus."
msgstr "Indica a duración da exposición para usar durante o foco."

#. i18n: ectx: label, entry (FocusBinning), group (Focus)
#. +> trunk5
#: kstars.kcfg:2220
#, kde-format
msgid "Default Camera binning"
msgstr "Eliminación predeterminada de ruído na cámara."

#. i18n: ectx: whatsthis, entry (FocusBinning), group (Focus)
#. +> trunk5
#: kstars.kcfg:2221
#, kde-format
msgid "Set binning of camera while in focus mode."
msgstr "Define a eliminación de ruído (binning) da cámara cando se está no modo de focalizar."

#. i18n: ectx: label, entry (FocusGain), group (Focus)
#. +> trunk5
#: kstars.kcfg:2225
#, kde-format
msgid "Default Focuser gain value"
msgstr "Valor predeterminado da ganancia do enfocador"

#. i18n: ectx: whatsthis, entry (FocusGain), group (Focus)
#. +> trunk5
#: kstars.kcfg:2226
#, kde-format
msgid "Specifies gain value of CCD when performing focusing if supported by camera."
msgstr "Indica o valor de ganancia do CCD ao enfocar se a cámara o permite."

#. i18n: ectx: label, entry (FocusISO), group (Focus)
#. +> trunk5
#: kstars.kcfg:2230
#, kde-format
msgid "Default Focuser Camera ISO value"
msgstr "Valor predeterminado da cámara ISO do enfocador."

#. i18n: ectx: label, entry (DefaultFocusTemperatureSource), group (Focus)
#. +> trunk5
#: kstars.kcfg:2233
#, kde-format
msgid "Default focus module temperature source."
msgstr "Fonte de temperatura predeterminada do módulo de foco."

#. i18n: ectx: label, entry (FocusFilter), group (Focus)
#. +> trunk5
#: kstars.kcfg:2236
#, kde-format
msgid "Default Filter Wheel filter"
msgstr "Filtro predeterminado de roda de filtro."

#. i18n: ectx: label, entry (UseFocusDarkFrame), group (Focus)
#. +> trunk5
#: kstars.kcfg:2239
#, kde-format
msgid "Take a dark frame and subtract it before running autofocus operation."
msgstr "Coller un fotograma escuro e restalo antes de executar unha operación de enfoque automático."

#. i18n: ectx: label, entry (FocusSubFrame), group (Focus)
#. +> trunk5
#: kstars.kcfg:2243
#, kde-format
msgid "Subframe the focus star during the autofocus procedure."
msgstr "Toma un recorte da estrela para enfocar durante o enfoque automático."

#. i18n: ectx: label, entry (FocusBoxSize), group (Focus)
#. +> trunk5
#: kstars.kcfg:2247
#, kde-format
msgid "Default Focuser star selection box size"
msgstr "Tamaño da caixa de escolla de estrela do enfocador predeterminado"

#. i18n: ectx: whatsthis, entry (FocusBoxSize), group (Focus)
#. +> trunk5
#: kstars.kcfg:2248
#, kde-format
msgid "Set box size to select a focus star."
msgstr "Define o tamaño da caixa para escoller unha estrela para enfocar."

#. i18n: ectx: label, entry (FocusUseFullField), group (Focus)
#. +> trunk5
#: kstars.kcfg:2252
#, kde-format
msgid "Measure average HFR from all stars combined in a full frame. This method defaults to the Centroid detection, but can use SEP detection too. Its performance decreases as the number of stars increases."
msgstr "Medir o HFR medio de todas as estrelas combinadas nun fotograma completo. Este método usar a detección de centroide de maneira predeterminada, pero tamén pode usar a detección SEP. O seu rendemento redúcese a medida que aumenta o número de estrelas."

#. i18n: ectx: label, entry (FocusNoMaskRB), group (Focus)
#. +> trunk5
#: kstars.kcfg:2256
#, kde-format
msgid "No mask is applied."
msgstr "Non se aplica ningunha máscara."

#. i18n: ectx: label, entry (focusRingMaskRB), group (Focus)
#. +> trunk5
#: kstars.kcfg:2260
#, kde-format
msgid "A ring mask is applied."
msgstr "Aplícase unha máscara de anel."

#. i18n: ectx: label, entry (focusMosaicMaskRB), group (Focus)
#. +> trunk5
#: kstars.kcfg:2264
#, kde-format
msgid "A mosaic mask is applied."
msgstr "Aplícase unha máscara de mosaico."

#. i18n: ectx: label, entry (FocusFullFieldInnerRadius), group (Focus)
#. +> trunk5
#: kstars.kcfg:2268
#, kde-format
msgid "Full field inner radius."
msgstr "Raio interno do campo completo."

# skip-rule: trasno-remove_reverse
#. i18n: ectx: whatsthis, entry (FocusFullFieldInnerRadius), group (Focus)
#. +> trunk5
#: kstars.kcfg:2269
#, no-c-format, kde-format
msgid "During full field focusing, stars which are inside this percentage of the frame are filtered out of HFR calculation (default 0%). Detection algorithms may also have an inherent filter."
msgstr "Durante o enfoque de campo completo as estrelas de dentro desta porcentaxe do marco retíranse do cálculo de HFR (predeterminado: 0%). Os algoritmos de detección tamén poderían ter un filtro inherente."

#. i18n: ectx: label, entry (FocusFullFieldOuterRadius), group (Focus)
#. +> trunk5
#: kstars.kcfg:2273
#, kde-format
msgid "Full field outer radius."
msgstr "Raio externo do campo completo."

# skip-rule: trasno-remove_reverse
#. i18n: ectx: whatsthis, entry (FocusFullFieldOuterRadius), group (Focus)
#. +> trunk5
#: kstars.kcfg:2274
#, no-c-format, kde-format
msgid "During full field focusing, stars which are outside this percentage of the frame are filtered out of HFR calculation (default 100%). Detection algorithms may also have an inherent filter."
msgstr "Durante o enfoque de campo completo as estrelas de fóra desta porcentaxe do marco retíranse do cálculo de HFR (predeterminado: 100%). Os algoritmos de detección tamén poderían ter un filtro inherente."

#. i18n: ectx: label, entry (FocusMosaicTileWidth), group (Focus)
#. +> trunk5
#: kstars.kcfg:2278
#, kde-format
msgid "Mosaic filter tile width in percent of the frame width."
msgstr "Anchura da tesela de filtro de mosaico como porcentaxe da anchura do fotograma."

#. i18n: ectx: label, entry (focusMosaicSpace), group (Focus)
#. +> trunk5
#: kstars.kcfg:2282
#, kde-format
msgid "Space between the mosaic elements for the mosaic filter."
msgstr "Espazo entre os elementos do mosaico para o filtro de mosaico."

#. i18n: ectx: label, entry (FocusAutoStarEnabled), group (Focus)
#. +> trunk5
#: kstars.kcfg:2286
#, kde-format
msgid "Automatically select a star to focus."
msgstr "Escoller automaticamente unha estrela para enfocala."

#. i18n: ectx: label, entry (FocusSuspendGuiding), group (Focus)
#. +> trunk5
#: kstars.kcfg:2290
#, kde-format
msgid "Suspend guiding while autofocus in progress."
msgstr "Suspender a guía durante o proceso de enfocar automaticamente."

#. i18n: ectx: whatsthis, entry (FocusGuideSettleTime), group (Focus)
#. +> trunk5
#: kstars.kcfg:2294
#, kde-format
msgid "Wait for this many seconds after resuming guide."
msgstr "Agardar este número de segundos tras retomar a guía."

#. i18n: ectx: whatsthis, entry (FocusUnits), group (Focus)
#. +> trunk5
#: kstars.kcfg:2298
#, kde-format
msgid "Display units for HFR and FWHM"
msgstr "Amosar as unidades para HFR e FWHM"

#. i18n: ectx: whatsthis, entry (FocusAdaptive), group (Focus)
#. +> trunk5
#: kstars.kcfg:2302
#, kde-format
msgid "Whether Adaptive Focusing is enabled."
msgstr "Se a opción de enfoque adaptativo está activada."

#. i18n: ectx: whatsthis, entry (focusAdaptiveMinMove), group (Focus)
#. +> trunk5
#: kstars.kcfg:2306
#, kde-format
msgid "When using Adaptive Focusing the minimum allowable focuser move in ticks."
msgstr "O movemento mínimo permitido do enfocador, en marcas, cando se usa o enfoque adaptativo."

#. i18n: ectx: whatsthis, entry (FocusAdaptStart), group (Focus)
#. +> trunk5
#: kstars.kcfg:2310
#, kde-format
msgid "Whether to adapt the focuser starting position at the beginning of an Autofocus run."
msgstr "Se adaptar a posición inicial do enfocador ao principio da execución do enfoque automático."

#. i18n: ectx: whatsthis, entry (focusAdaptiveMaxMove), group (Focus)
#. +> trunk5
#: kstars.kcfg:2314
#, kde-format
msgid "When using Adaptive Focusing the maximum total allowable focuser move in ticks."
msgstr "O movemento máximo total permitido do enfocador, en marcas, cando se usa o enfoque adaptativo."

#. i18n: ectx: label, entry (FocusDetection), group (Focus)
#. +> trunk5
#: kstars.kcfg:2319
#, kde-format
msgid "Star detection algorithm"
msgstr "Algoritmo de detección de estrelas"

#. i18n: ectx: label, entry (FocusSEPProfile), group (Focus)
#. +> trunk5
#: kstars.kcfg:2323
#, kde-format
msgid "Focus source extraction profile"
msgstr "Perfil de extracción da fonte do foco."

#. i18n: ectx: label, entry (FocusAlgorithm), group (Focus)
#. +> trunk5
#: kstars.kcfg:2326
#, kde-format
msgid "Focus process algorithm"
msgstr "Algoritmo de proceso de foco"

#. i18n: ectx: whatsthis, entry (FocusCurveFit), group (Focus)
#. +> trunk5
#: kstars.kcfg:2330
#, kde-format
msgid "The type of curve to fit"
msgstr "O tipo de curva para axustar."

#. i18n: ectx: whatsthis, entry (FocusStarMeasure), group (Focus)
#. +> trunk5
#: kstars.kcfg:2334
#, kde-format
msgid "The type of star measure to use."
msgstr "O tipo de medición de estrela para usar."

#. i18n: ectx: whatsthis, entry (FocusStarPSF), group (Focus)
#. +> trunk5
#: kstars.kcfg:2338
#, kde-format
msgid "The type of star PSF to use if curve fitting star profiles."
msgstr "O tipo de PSF de estrelas para usar ao axustar as curvas de perfís de estrelas."

#. i18n: ectx: whatsthis, entry (FocusUseWeights), group (Focus)
#. +> trunk5
#: kstars.kcfg:2342
#, kde-format
msgid "Whether to use weights in the curve fitting process."
msgstr "Se usar pesos no proceso de axuste de curvas."

#. i18n: ectx: whatsthis, entry (FocusR2Limit), group (Focus)
#. +> trunk5
#: kstars.kcfg:2346
#, kde-format
msgid "The minimum acceptable R2 value of a curve fit."
msgstr "O valor mínimo aceptábel de R² dun axuste de curva."

#. i18n: ectx: whatsthis, entry (FocusRefineCurveFit), group (Focus)
#. +> trunk5
#: kstars.kcfg:2350
#, kde-format
msgid "Whether to refine the curve fit by looking for and discarding outliers."
msgstr "Se refinar o axuste de curva buscando e descartando valores atípicos."

#. i18n: ectx: whatsthis, entry (focusFramesCount), group (Focus)
#. +> trunk5
#: kstars.kcfg:2354
#, kde-format
msgid "How many frames to average over at each step in the Autofocus process."
msgstr "Cantos fotogramas usar para o cálculo da media a cada paso do proceso de enfoque automático."

#. i18n: ectx: whatsthis, entry (focusHFRFramesCount), group (Focus)
#. +> trunk5
#: kstars.kcfg:2358
#, kde-format
msgid "How many frames to average over when performing in-sequence HFR Check."
msgstr "Cantos fotogramas usar para o cálculo da media ao realizar a comprobación de HFR en secuencia."

#. i18n: ectx: label, entry (FocusMultiRowAverage), group (Focus)
#. +> trunk5
#: kstars.kcfg:2362
#, kde-format
msgid "Number of rows to combine in the Bahtinov average calculation."
msgstr "Número de filas para combinar no cálculo da media de Bahtinov."

#. i18n: ectx: label, entry (FocusGaussianSigma), group (Focus)
#. +> trunk5
#: kstars.kcfg:2366
#, kde-format
msgid "Gaussian blur sigma value."
msgstr "Valor sigma do desenfoque de Gauss."

#. i18n: ectx: label, entry (FocusThreshold), group (Focus)
#. +> trunk5
#: kstars.kcfg:2370
#, kde-format
msgid "Relative percentage strength of centroid edge pixel strength to average pixel value."
msgstr "Forza de porcentaxe relativa da forza de píxel de bordo de centroide para calcular a media de valor de píxel."

#. i18n: ectx: whatsthis, entry (FocusDenoise), group (Focus)
#. +> trunk5
#: kstars.kcfg:2374
#, kde-format
msgid "Whether to denoise the focus image before further processing."
msgstr "Se eliminar o ruído da imaxe de enfoque antes de calquera procesamento."

#. i18n: ectx: whatsthis, entry (FocusDonut), group (Focus)
#. +> trunk5
#: kstars.kcfg:2378
#, kde-format
msgid "Whether to use Donut Busting functionality during Autofocus."
msgstr "Se usar a funcionalidade de destrución de aneis durante o enfoque automático."

#. i18n: ectx: label, entry (FocusTimeDilation), group (Focus)
#. +> trunk5
#: kstars.kcfg:2382
#, kde-format
msgid "Factor to multiply focus exposure by for out of focus frames when using Donut Buster."
msgstr "O factor polo que multiplicar a exposición do foco para os fotogramas desenfocados ao usar a destrución de aneis."

#. i18n: ectx: label, entry (focusOutlierRejection), group (Focus)
#. +> trunk5
#: kstars.kcfg:2386
#, kde-format
msgid "Aggressiveness factor to apply to outlier rejection when using Donut Buster."
msgstr "O factor de agresividade para aplicar ao rexeitamento de valores atípicos ao usar a destrución de aneis."

#. i18n: ectx: whatsthis, entry (focusScanStartPos), group (Focus)
#. +> trunk5
#: kstars.kcfg:2390
#, kde-format
msgid "Whether to use scan for optimum start position at the start of Autofocus."
msgstr "Se usar a busca dunha posición de inicio óptima no inicio do enfoque automático."

#. i18n: ectx: whatsthis, entry (focusScanAlwaysOn), group (Focus)
#. +> trunk5
#: kstars.kcfg:2394
#, kde-format
msgid "Whether scan for start position is always used or just after an Autofocus failure."
msgstr "Se usar sempre a busca dunha posición inicial ou só tras un fallo do enfoque automático."

#. i18n: ectx: whatsthis, entry (focusScanDatapoints), group (Focus)
#. +> trunk5
#: kstars.kcfg:2398
#, kde-format
msgid "Number of datapoints to use during scan when focusScanStartPos is checked."
msgstr "Número de puntos de datos para usar durante a busca cando se marca «focusScanStartPos» (posición inicial da busca do foco)."

#. i18n: ectx: label, entry (focusScanStepSizeFactor), group (Focus)
#. +> trunk5
#: kstars.kcfg:2402
#, kde-format
msgid "Factor to apply to Initial Step Size during scan when focusScanStartPos is checked."
msgstr "O factor para aplicar ao tamaño de paso inicial durante a busca cando se marca «focusScanStartPos» (posición inicial da busca do foco)."

#. i18n: ectx: label, entry (FocusGaussianKernelSize), group (Focus)
#. +> trunk5
#: kstars.kcfg:2406
#, kde-format
msgid "Gaussian blur kernel size."
msgstr "Tamaño de núcleo do desenfoque de Gauss."

#. i18n: ectx: label, entry (FocusTolerance), group (Focus)
#. +> trunk5
#: kstars.kcfg:2410
#, kde-format
msgid "Default Focuser tolerance value"
msgstr "Valor predeterminado da tolerancia do enfocador"

#. i18n: ectx: whatsthis, entry (FocusTolerance), group (Focus)
#. +> trunk5
#: kstars.kcfg:2411
#, kde-format
msgid "The tolerance specifies the percentage difference between the current focusing position and the minimum obtained during the focusing run. Adjustment of this value is necessary to prevent the focusing algorithm from oscillating back and forth."
msgstr "A tolerancia indica a diferenza de porcentaxe entre a posición de enfoque actual e o mínimo obtido durante o enfoque. Precísase axustar este valor para evitar que o algoritmo de enfoque oscile para diante e para atrás."

#. i18n: ectx: whatsthis, entry (FocusWalk), group (Focus)
#. +> trunk5
#: kstars.kcfg:2416
#, kde-format
msgid "The type of walk the focuser will take during an Autofocus run."
msgstr "O tipo de camiño que o enfocador seguirá durante unha execución do enfoque automático."

#. i18n: ectx: whatsthis, entry (FocusSettleTime), group (Focus)
#. +> trunk5
#: kstars.kcfg:2420
#, kde-format
msgid "Wait for this many seconds after moving the focuser before capturing the next image during AutoFocus."
msgstr "Agardar este número de segundos tras mover o enfocador antes de capturar a seguinte imaxe durante o enfoque automático."

#. i18n: ectx: label, entry (FocusTicks), group (Focus)
#. +> trunk5
#: kstars.kcfg:2424
#, kde-format
msgid "Default Focuser step ticks"
msgstr "Marcas de paso do enfocador predeterminado"

#. i18n: ectx: whatsthis, entry (FocusTicks), group (Focus)
#. +> trunk5
#: kstars.kcfg:2425
#, kde-format
msgid "Step size of the absolute focuser. The step size TICKS should be adjusted so that when the focuser moves TICKS steps, the difference in HFR is more than 0.1 pixels. Lower the value when you are close to optimal focus."
msgstr "Tamaño de paso do enfocador absoluto. Hai que axustar as marcas do tamaño do paso para que cando o enfocador se mova o número de pasos que indica a variábel TICKS (marcas), a diferenza en HFR sexa maior de 0,1 píxeles. Un valor máis baixo cando se estea preto do foco óptimo."

#. i18n: ectx: whatsthis, entry (FocusOutSteps), group (Focus)
#. +> trunk5
#: kstars.kcfg:2429
#, kde-format
msgid "The number of steps to move outwards for a Classic Autofocus run."
msgstr "O número de pasos para mover cara fóra para unha execución do enfoque automático clásico."

# skip-rule: trasno-change_reverse
#. i18n: ectx: whatsthis, entry (focusNumSteps), group (Focus)
#. +> trunk5
#: kstars.kcfg:2433
#, kde-format
msgid "The total number of steps for a Fixed Steps or CFZ Shuffle Autofocus run."
msgstr "O número total de pasos para unha execución do enfoque automático con pasos fixos ou con cambio de CFZ."

#. i18n: ectx: label, entry (FocusMaxTravel), group (Focus)
#. +> trunk5
#: kstars.kcfg:2437
#, kde-format
msgid "Maximum Focus Travel Distance"
msgstr "Distancia máxima de viaxe do foco"

#. i18n: ectx: whatsthis, entry (FocusMaxTravel), group (Focus)
#. +> trunk5
#: kstars.kcfg:2438
#, kde-format
msgid "Set the maximum travel distance of an absolute focuser."
msgstr "Define a distancia máxima viaxada por un enfocador absoluto."

#. i18n: ectx: whatsthis, entry (FocusMaxSingleStep), group (Focus)
#. +> trunk5
#: kstars.kcfg:2442
#, kde-format
msgid "The maximum size of a single step."
msgstr "O tamaño máximo dun paso."

#. i18n: ectx: whatsthis, entry (FocusBacklash), group (Focus)
#. +> trunk5
#: kstars.kcfg:2446
#, kde-format
msgid "The amount of driver backlash."
msgstr "A cantidade de folgura do controlador."

#. i18n: ectx: whatsthis, entry (FocusAFOverscan), group (Focus)
#. +> trunk5
#: kstars.kcfg:2450
#, kde-format
msgid "The amount of Autofocus Overscan."
msgstr "A cantidade de sobrebusca do enfoque automático."

#. i18n: ectx: whatsthis, entry (FocusOverscanDelay), group (Focus)
#. +> trunk5
#: kstars.kcfg:2454
#, kde-format
msgid "Delay between outward and inward movements of an AF Overscan. For most focusers set 0s."
msgstr "Atraso entre movementos cara fóra e cara dentro nunha sobrebusca do enfoque automático. Para a maioría dos enfocadores defina «0 s»."

#. i18n: ectx: whatsthis, entry (FocusMotionTimeout), group (Focus)
#. +> trunk5
#: kstars.kcfg:2462
#, kde-format
msgid "Maximum time in seconds to wait for a focuser to move to desired position before declaring a timeout."
msgstr "Tempo máximo en segundos para agardar a que un enfocador se mova á posición desexada antes de declarar que se superou o tempo límite."

#. i18n: ectx: whatsthis, entry (focusCFZAlgorithm), group (Focus)
#. +> trunk5
#: kstars.kcfg:2467
#, kde-format
msgid "The type of CFZ Algorithm to use."
msgstr "O tipo de algoritmo de CFZ que usar."

#. i18n: ectx: whatsthis, entry (focusCFZTolerance), group (Focus)
#. +> trunk5
#: kstars.kcfg:2471
#, kde-format
msgid "The user defined tolerance to use for Classic and Wavefront algos."
msgstr "A tolerancia definida pola persoa usuaria para o uso dos algoritmos clásico e de fronte de onda."

#. i18n: ectx: whatsthis, entry (focusCFZTau), group (Focus)
#. +> trunk5
#: kstars.kcfg:2475
#, kde-format
msgid "The user defined tolerance to use for the Gold algo."
msgstr "A tolerancia definida pola persoa usuaria para o uso do algoritmo dourado."

#. i18n: ectx: whatsthis, entry (focusCFZDisplayVCurve), group (Focus)
#. +> trunk5
#: kstars.kcfg:2479
#, kde-format
