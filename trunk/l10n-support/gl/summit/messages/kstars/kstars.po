"<html><head/><body>"
"<p>Minimum focuser movement when using Adaptive Focus.</p>"
"</body></html>"
msgstr ""
"<html><head/><body>"
"<p>Movemento mínimo de enfocador ao usar o enfoque adaptativo.</p>"
"</body></html>"

#. i18n: ectx: property (text), widget (QLabel, label_7)
#. +> trunk5
#: ekos/focus/opsfocussettings.ui:579
#, kde-format
msgid "Min Move:"
msgstr "Movemento mínimo:"

