#~ "</ul>"
#~ "<p>Any filter string can be preceded by '<tt>@@</tt>' to whitelist (allow) any matching URL, which takes priority over any blacklist (blocking) filter.<br>"
#~ "<a href='%1'>%2</a></qt>"
