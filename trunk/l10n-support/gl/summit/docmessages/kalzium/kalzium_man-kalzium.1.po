#. Tag: title
#. +> trunk5 stable5
#: man-kalzium.1.docbook:36
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#. +> trunk5 stable5
#: man-kalzium.1.docbook:38
#, no-c-format
msgid "&kalzium; is a program which shows you the Periodic System of the Elements (PSE). You can use &kalzium; to search for information about the elements or to learn facts about the PSE."
msgstr "&kalzium; é un programa que mostra a táboa periódica dos elementos. Pode usar &kalzium; para buscar información sobre os elementos ou para aprender cousas sobre a táboa mesma."

#. Tag: para
#. +> trunk5 stable5
#: man-kalzium.1.docbook:42
#, no-c-format
msgid "&kalzium; provides you with all kinds of information about the PSE. You can look up lots of information about the elements and also use visualisations to show them."
msgstr "&kalzium; fornece todo tipo de información sobre a táboa periódica. Pode buscar moreas de información sobre os elementos e tamén usar visualizacións para amosalos."

#. Tag: para
#. +> trunk5 stable5
#: man-kalzium.1.docbook:46
#, no-c-format
msgid "This package is part of the official KDE edutainment module."
msgstr "Este paquete é parte do módulo oficial de KDE para educación."

