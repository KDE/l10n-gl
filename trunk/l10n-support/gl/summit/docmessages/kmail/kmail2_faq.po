#| msgid "See the section <link linkend=\"importing\">Using other Mailbox files With &kmail;</link>."
msgid "See the section <link linkend=\"importing-options\">Importing in &kmail;</link>."
msgstr "Vexa a sección <link linkend=\"importing\">Empregar outros ficheiros Mailbox con &kmail;</link>."

#. Tag: para
#. +> trunk5 stable5
#: faq.docbook:428
#, no-c-format
msgid "Can I use encryption with my normal (non-<acronym>SSL</acronym>) POP3 account?"
msgstr "Podo usar cifrado coa miña conta normal de POP3 (sen <acronym>SSL</acronym>)?"

#. Tag: para
#. +> trunk5 stable5
#: faq.docbook:430
#, no-c-format
msgid "If your POP3 server runs an <application>ssh</application> daemon, you can use ssh to tunnel your POP3 connection using the following command:"
msgstr "Se o seu servidor de POP3 executa un servidor de <application>ssh</application>, pode empregar o ssh para crear un túnel para a súa conexión de POP3 mediante a orde seguinte:"

#. Tag: userinput
