#. +> trunk5 stable5
#: development.docbook:1779
#, no-c-format
msgid "Cursor view.virtualCursorPosition();"
msgstr "Cursor view.virtualCursorPosition();"

#. Tag: para
#. +> trunk5 stable5
#: development.docbook:1780
#, no-c-format
msgid "Returns the virtual cursor position with each tab counting the corresponding amount of spaces depending on the current tab width."
msgstr "Devolve a posición do cursor virtual con cada tabulación contando como a cantidade correspondente de espazos, de acordo coa anchura actual das tabulacións."

#. Tag: synopsis
#. +> trunk5 stable5
#: development.docbook:1787
#, no-c-format
msgid ""
"void view.setVirtualCursorPosition(<parameter>int <replaceable>line</replaceable></parameter>, <parameter>int <replaceable>column</replaceable></parameter>);\n"
"void view.setVirtualCursorPosition(<parameter>Cursor <replaceable>cursor</replaceable></parameter>);"
msgstr ""
"void view.setVirtualCursorPosition(<parameter>int <replaceable>liña</replaceable></parameter>, <parameter>int <replaceable>columna</replaceable></parameter>);\n"
"void view.setVirtualCursorPosition(<parameter>Cursor <replaceable>cursor</replaceable></parameter>);"

#. Tag: para
#. +> trunk5 stable5
#: development.docbook:1788
#, no-c-format
msgid "Set the current virtual cursor position to (line, column) or to the given cursor."
msgstr "Situar o cursor virtual na posición (liña, columna) ou o cursor indicado."

#. Tag: synopsis
#. +> trunk5 stable5
#: development.docbook:1795
#, no-c-format
msgid "String view.selectedText();"
msgstr "String view.selectedText();"

#. Tag: para
#. +> trunk5 stable5
#: development.docbook:1796
#, no-c-format
msgid "Returns the selected text. If no text is selected, the returned string is empty."
msgstr "Devolve o texto seleccionado. Se non hai texto seleccionado, a cadea devolta estará baleira."

#. Tag: synopsis
#. +> trunk5 stable5
#: development.docbook:1803
#, no-c-format
msgid "bool view.hasSelection();"
msgstr "bool view.hasSelection();"

#. Tag: para
#. +> trunk5 stable5
#: development.docbook:1804
#, no-c-format
msgid "Returns <literal>true</literal>, if the view has selected text, otherwise <literal>false</literal>."
msgstr "Devolve <literal>true</literal> se hai texto seleccionado na vista, ou <literal>false</literal> en caso contrario."

#. Tag: synopsis
#. +> trunk5 stable5
#: development.docbook:1811
#, no-c-format
msgid "Range view.selection();"
msgstr "Range view.selection();"

#. Tag: para
#. +> trunk5 stable5
#: development.docbook:1812
#, no-c-format
msgid "Returns the selected text range. The returned range is invalid if there is no selected text."
msgstr "Devolve o intervalo do texto seleccionado. Se non hai texto seleccionado, o intervalo será incorrecto."

#. Tag: synopsis
#. +> trunk5 stable5
#: development.docbook:1820
#, no-c-format
