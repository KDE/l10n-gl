#. Tag: synopsis
#. +> trunk5 stable5
#: development.docbook:1837
#, no-c-format
msgid "void view.selectAll();"
msgstr "void view.selectAll();"

#. Tag: para
#. +> trunk5 stable5
#: development.docbook:1838
#, no-c-format
msgid "Selects the entire text in the document."
msgstr "Selecciona todo o texto do documento."

#. Tag: synopsis
#. +> trunk5 stable5
#: development.docbook:1845
#, no-c-format
msgid "void view.clearSelection();"
msgstr "void view.clearSelection();"

#. Tag: para
#. +> trunk5 stable5
#: development.docbook:1846
#, no-c-format
msgid "Clears the text selection without removing the text."
msgstr "Retira a selección sen retirar o texto seleccionado."

