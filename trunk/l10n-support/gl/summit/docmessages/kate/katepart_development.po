#. Tag: title
#. +> trunk5 stable5
#: development.docbook:1869
#, no-c-format
msgid "The Document API"
msgstr "A API do documento"

#. Tag: para
#. +> trunk5 stable5
#: development.docbook:1870
#, no-c-format
