#: conf-options-table.docbook:82
#, no-c-format
msgid "<member>git</member>"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:83
#, no-c-format
msgid "History information"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:83
#, no-c-format
msgid "This option was added in &kdesrc-build; 1.16. Prior to 20.06 this option was used to configure the fetch URL instead of the push URL. As of 20.06 <literal>https</literal> is always used when updating KDE projects."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:87
#, no-c-format
msgid "This option only applies to modules from a <link linkend=\"kde-projects-module-sets\">&kde; project</link> repository."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:90
#, no-c-format
msgid "What this option actually does is configure which network protocol to prefer when pushing source code for these modules. Normally the very-efficient <literal>git</literal> protocol is used, but this may be blocked in some networks (e.g. corporate intranets, public Wi-Fi). An alternative protocol which is much better supported is the <literal>https</literal> protocol used for Internet web sites."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:97
#, no-c-format
msgid "If you are using one of these constrained networks you can set this option to <userinput>http</userinput> to prefer <literal>https</literal> communications instead."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:101
#, no-c-format
msgid "You may also need the <link linkend=\"conf-http-proxy\">http-proxy</link> option if an HTTP proxy is also needed for network traffic."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:105
#, no-c-format
msgid "In any other situation you should not set this option as the default protocol is most efficient."
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:112
#, no-c-format
msgid "install-environment-driver"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:117
#, no-c-format
msgid "17.08"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:119
#, no-c-format
msgid "Install a shell script that can be sourced in a user's profile setup scripts to easily establish needed environment variables to run the Plasma desktop built by &kdesrc-build;."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:123 conf-options-table.docbook:159
#, no-c-format
msgid "This driver will alter the following files:"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:126 conf-options-table.docbook:163
#, no-c-format
msgid "<filename>$XDG_CONFIG_HOME/kde-env-master.sh</filename> (normally found at <filename>~/.config/kde-env-master.sh</filename>)."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:127 conf-options-table.docbook:164
#, no-c-format
msgid "<filename>$XDG_CONFIG_HOME/kde-env-user.sh</filename> (normally found at <filename>~/.config/kde-env-user.sh</filename>)."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:130
#, no-c-format
msgid "The <filename>kde-env-user.sh</filename> is optional. It is intended for user customizations (see the <ulink url=\"https://userbase.kde.org/KDE_System_Administration/Environment_Variables#Troubleshooting_and_Debugging\">Troubleshooting and Debugging</ulink> section of the &kde; UserBase for examples of customizable settings), but these settings can be set elsewhere by the user in their existing profile setup scripts."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:135
#, no-c-format
msgid "You can disable this feature by setting this option to <replaceable>false</replaceable>, and ensuring that the <link linkend=\"conf-install-session-driver\">install-session-driver</link> option is also disabled."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:140 conf-options-table.docbook:171
#, no-c-format
msgid "&kdesrc-build; will not overwrite your existing files (if present) unless you also pass the <option><link linkend=\"cmdline-delete-my-settings\">--delete-my-settings</link></option> command-line option."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:144
#, no-c-format
msgid "Related command-line option: --install-environment-driver, --no-install-environment-driver"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:149
#, no-c-format
msgid "install-session-driver"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:154 conf-options-table.docbook:702
#: conf-options-table.docbook:992 conf-options-table.docbook:1059
#: conf-options-table.docbook:1131 conf-options-table.docbook:1209
#: conf-options-table.docbook:1301
#, no-c-format
msgid "1.16"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:156
#, no-c-format
msgid "If enabled, &kdesrc-build; will try to install a driver for the graphical login manager that allows you to login to your &kdesrc-build;-built &kde; desktop."
msgstr ""

#. Tag: filename
#. +> trunk5
#: conf-options-table.docbook:162
#, no-c-format
msgid "~/.xsession"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:167
#, no-c-format
msgid "If you maintain your own login driver then you can disable this feature by setting this option to <replaceable>false</replaceable>. If enabled, this feature also enables the <link linkend=\"conf-install-environment-driver\">install-environment-driver</link> feature."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:175
#, no-c-format
msgid "Related command-line option: --install-session-driver, --no-install-session-driver"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:180
#, no-c-format
msgid "niceness"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:183 conf-options-table.docbook:197
#: conf-options-table.docbook:216
#, no-c-format
msgid "Integer"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:184
#, no-c-format
msgid "<member>10</member>"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:186
#, no-c-format
msgid "Set this option to a number between 20 and 0. The higher the number, the lower a priority &kdesrc-build; will set for itself, i.e. the higher the number, the \"nicer\" the program is."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:189
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-nice\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:194
#, no-c-format
msgid "num-cores"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:198 conf-options-table.docbook:217
#, no-c-format
msgid "Depends on system"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:199 conf-options-table.docbook:218
#, no-c-format
msgid "20.07"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:201
#, no-c-format
msgid "This option is defined by &kdesrc-build; (when using <command>kdesrc-build --generate-config</command>), set to be the number of available CPUs (as indicated by the external application <application>nproc</application>). If &kdesrc-build; cannot detect the number of CPUs, this value is set to 4."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:206
#, no-c-format
msgid "See <xref linkend=\"make-options-example\"/> for an example of this option's usage."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:208
#, no-c-format
msgid "Related command-line option: --num-cores <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:213
#, no-c-format
msgid "num-cores-low-mem"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:220
#, no-c-format
msgid "This option is defined by &kdesrc-build; (when using <command>kdesrc-build --generate-config</command>), set to be the number of CPUs that is deemed safe for heavyweight or other highly-intensive modules, such as <literal>qtwebengine</literal>, to avoid running out of memory during the build."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:225
#, no-c-format
msgid "The typical calculation is one CPU core for every 2 gigabytes (GiB) of total memory. At least 1 core will be specified, and no more than <option><link linkend=\"conf-num-cores\">num-cores</link></option> cores will be specified."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:230
#, no-c-format
msgid "Although this option is intended to support &Qt; modules, you can use it for your any module in the same way that <option>num-cores</option> is used."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:233
#, no-c-format
msgid "If &kdesrc-build; cannot detect available memory then this value will be set to 2."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:236
#, no-c-format
msgid "Related command-line option: --num-cores-low-mem <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:241
#, no-c-format
msgid "persistent-data-file"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:245
#, no-c-format
msgid "1.15"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:247
#, no-c-format
msgid "Use this option to change where &kdesrc-build; stores its persistent data. The default is to store this data in a file called <filename>.kdesrc-build-data</filename>, placed in the same directory as the configuration file in use. If the global configuration file is in use, it will be saved to <filename>~/.local/state/kdesrc-build-data</filename> (<filename>$XDG_STATE_HOME/kdesrc-build-data</filename>, if <envar>$XDG_STATE_HOME</envar> is set). If you have multiple available configurations in the same directory, you may want to manually set this option, so that different configurations do not end up with conflicting persistent data."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:257
#, no-c-format
msgid "Related command-line option: --persistent-data-file <replaceable>file</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:262
#, no-c-format
msgid "ssh-identity-file"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:266
#, no-c-format
msgid "1.14.2"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:268
#, no-c-format
msgid "Set this option to control which private SSH key file is passed to the <command>ssh-add</command> command when &kdesrc-build; is downloading source code from repositories that require authentication. See also: <xref linkend=\"ssh-agent-reminder\"/>."
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:276
#, no-c-format
msgid "use-idle-io-priority"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:281 conf-options-table.docbook:1226
#, no-c-format
msgid "1.12"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:283
#, no-c-format
msgid "Use lower priority for disk and other I/O, which can significantly improve the responsiveness of the rest of the system at the expense of slightly longer running times for &kdesrc-build;."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:286
#, no-c-format
msgid "Related command-line option: --use-idle-io-priority, --no-use-idle-io-priority"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:291
#, no-c-format
msgid "use-inactive-modules"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:297
#, no-c-format
msgid "Allow kdesrc-build to also clone and pull from repositories marked as inactive."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:298
#, no-c-format
msgid "Related command-line option: --use-inactive-modules, --no-use-inactive-modules"
msgstr ""

#. Tag: title
#. +> trunk5
#: conf-options-table.docbook:309
#, no-c-format
msgid "All scopes (module, module-set and global) options"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:322
#, no-c-format
msgid "binpath"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:327
#, no-c-format
