msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:567
#, no-c-format
msgid "configure-flags"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:574
#, no-c-format
msgid "Use this option to specify what flags to pass to ./configure when creating the build system for the module. When this is used as a global-option, it is applied to all modules that this script builds. <emphasis>This option only works for qt.</emphasis>"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:579
#, no-c-format
msgid "To change configuration settings for KDE modules, see <link linkend=\"conf-cmake-options\">cmake-options</link>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:582
#, no-c-format
msgid "Related command-line option: --configure-flags <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:587
#, no-c-format
msgid "custom-build-command"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:592
#, no-c-format
msgid "This option can be set to run a different command (other than <command>make</command>, for example) in order to perform the build process. &kdesrc-build; should in general do the right thing, so you should not need to set this option. However it can be useful to use alternate build systems."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:599
#, no-c-format
msgid "The value of this option is used as the command line to run, modified by the <link linkend=\"conf-make-options\">make-options</link> option as normal."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:603
#, no-c-format
msgid "Related command-line option: --custom-build-command <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:608
#, no-c-format
msgid "cxxflags"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:615
#, no-c-format
msgid "Use this option to specify what flags to use for building the module. This option is specified here instead of with <link linkend=\"conf-configure-flags\">configure-flags</link> or <link linkend=\"conf-cmake-options\">cmake-options</link> because this option will also set the environment variable <envar>CXXFLAGS</envar> during the build process."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:622
#, no-c-format
msgid "Note that for &kde; 4 and any other modules that use &cmake;, it is necessary to set the CMAKE_BUILD_TYPE option to <userinput>none</userinput> when configuring the module. This can be done using the <link linkend=\"conf-cmake-options\">cmake-options</link> option."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:627
#, no-c-format
msgid "Related command-line option: --cxxflags <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:632
#, no-c-format
msgid "dest-dir"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:637
#, no-c-format
msgid "Use this option to change the name a module is given on disk. For example, if your module was extragear/network, you could rename it to extragear-network using this option. Note that although this changes the name of the module on disk, it is not a good idea to include directories or directory separators in the name as this will interfere with any <link linkend=\"conf-build-dir\">build-dir</link> or <link linkend=\"conf-source-dir\">source-dir</link> options."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:644
#, no-c-format
msgid "Related command-line option: --dest-dir <replaceable>path</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:649
#, no-c-format
msgid "do-not-compile"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:654
#, no-c-format
msgid "Use this option to select a specific set of directories not to be built in a module (instead of all of them). The directories not to build should be space-separated."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:657
#, no-c-format
msgid "Note that the sources to the programs will still be downloaded."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:659
#, no-c-format
msgid "For example, to disable building the <literal>codeeditor</literal> and <literal>minimaltest</literal> directories of the <literal>syntaxhighlighting</literal> framework, you would add <userinput>do-not-compile codeeditor minimaltest</userinput> compiling, you would add \"do-not-compile juk kscd\" to your syntaxhighlighting options."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:665
#, no-c-format
msgid "See <xref linkend=\"not-compiling\"/> for an example."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:666
#, no-c-format
msgid "Related command-line option: --do-not-compile <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:671
#, no-c-format
msgid "git-user"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:675
#, no-c-format
msgid "15.09"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:677
#, no-c-format
msgid "This option is intended for &kde; developers. If set, it will be used to automatically setup identity information for the &git; source control software for <emphasis>newly downloaded</emphasis> &git; modules (including the vast majority of &kde; modules)."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:682
#, no-c-format
msgid "Specifically, the user's name and email fields for each new &git; repository are filled in to the values set by this option."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:685
#, no-c-format
msgid "The value must be specified in the form <option><replaceable>User Name</replaceable> &lt;<replaceable>email@example.com</replaceable>&gt;</option>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:688
#, no-c-format
msgid "For instance, a developer named <quote>Foo Barbaz</quote> with the email address <quote>foo@abc.xyz</quote> would use:"
msgstr ""

#. Tag: programlisting
#. +> trunk5
#: conf-options-table.docbook:691
#, no-c-format
msgid "<symbol>git-user</symbol> <replaceable>Foo Barbaz</replaceable> &lt;<replaceable>foo@abc.xyz</replaceable>&gt;"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:698
#, no-c-format
msgid "http-proxy"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:704
#, no-c-format
msgid "This option, if set, uses the specified URL as a proxy server to use for any HTTP network communications (for example, when downloading the <link linkend=\"kde-projects-module-sets\">KDE project database</link>)."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:708
#, no-c-format
msgid "In addition, &kdesrc-build; will try to ensure that the tools it depends on also use that proxy server, if possible, by setting the <envar>http_proxy</envar> environment variable to the indicated server, <emphasis>if that environment variable is not already set</emphasis>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:712
#, no-c-format
msgid "Related command-line option: --http-proxy <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:717
#, no-c-format
msgid "directory-layout"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:721 conf-options-table.docbook:991
#: conf-options-table.docbook:1090
#, no-c-format
msgid "Valid values"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:721
#, no-c-format
msgid "<userinput>flat</userinput>, <userinput>invent</userinput>, <userinput>metadata</userinput>"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:723
#, no-c-format
msgid "flat"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:725
#, no-c-format
msgid "This option is used to configure the layout which &kdesrc-build; should use when creating source and build directories."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:727
#, no-c-format
msgid "The <userinput>flat</userinput> layout will group all modules directly underneath the top level source and build directories. For example, <literal>source/extragear/network/telepathy/ktp-text-ui</literal> in the <userinput>metadata</userinput> layout would be <literal>source/ktp-text-ui</literal> using the <userinput>flat</userinput> layout instead."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:733
#, no-c-format
msgid "The <userinput>invent</userinput> layout creates a directory hierarchy mirroring the relative paths of repositories on <ulink url=\"https://invent.kde.org/\">invent.kde.org</ulink>. For example <literal>source/kde/applications/kate</literal> in the <userinput>metadata</userinput> layout would be <literal>source/utilities/kate</literal> using the <userinput>invent</userinput> layout instead. This layout only affects KDE projects. It is a good choice for people starting out with &kdesrc-build;."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:740
#, no-c-format
msgid "Finally, the <userinput>metadata</userinput> layout is the same as the old default behaviour. This layout organises KDE projects according to the project paths specified in the project metadata for these modules. This is a good choice if you want a directory layout which tracks with certain KDE processes, but note that this path is therefore not always stable. As a result, &kdesrc-build; may abandon an old copy of the repository and clone a new one for a project due to changes in the project metadata."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:746
#, no-c-format
msgid "Related command-line option: --directory-layout <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:751
#, no-c-format
msgid "generate-vscode-project-config"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:759
#, no-c-format
msgid "Module setting overrides global"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:761
#, no-c-format
msgid "Set this option to <userinput>true</userinput> to make &kdesrc-build; create VS Code project files (.vscode directory) in the module source directory."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:765
#, no-c-format
msgid "The .vscode folder will be created in the project source directory, only if it does not already exist. The configurations will enable the use of LSP, building, debugging, and running the project from within VS Code."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:769
#, no-c-format
msgid "The configuration also recommends extensions to install that are useful for working on most KDE projects."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:772
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-generate-vscode-project-config\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:777
#, no-c-format
msgid "include-dependencies"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:783
#, no-c-format
msgid "Controls if &kdesrc-build; will include known dependencies of this module in its build, without requiring you to mention those dependencies (even indirectly)."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:786
#, no-c-format
msgid "This option only works for <link linkend=\"kde-projects-module-sets\"><literal>kde-project</literal>-based modules</link>, and requires that the metadata maintained by the &kde; developers is accurate for your selected <link linkend=\"conf-branch-group\">branch-group</link>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:792
#, no-c-format
msgid "This is to support building applications that need versions of &Qt; or &plasma; more recent than supported on common operating systems."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:795
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-include-dependencies\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:800
#, no-c-format
msgid "install-after-build"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:806
#, no-c-format
msgid "This option is used to install the package after it successfully builds. You can also use the <link linkend=\"cmdline-no-install\"><option>--no-install</option></link> command line flag."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:810
#, no-c-format
msgid "Related command-line option: --install-after-build, --no-install-after-build"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:815
#, no-c-format
msgid "install-dir"
msgstr ""

#. Tag: filename
#. +> trunk5
#: conf-options-table.docbook:819
#, no-c-format
msgid "~/kde/usr"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:821
#, no-c-format
msgid "This option controls where to install the module after it is built. If you change this to a directory needing root access, you may want to read about the <link linkend=\"conf-make-install-prefix\">make-install-prefix</link> option as well."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:826
#, no-c-format
msgid "Changing this option for specific module allows you to install it to a different directory than where the &kde; Platform libraries are installed, such as if you were using &kdesrc-build; only to build applications."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:830
#, no-c-format
msgid "You can use <varname>${MODULE}</varname> or <varname>$MODULE</varname> in the path to have them expanded to the module's name."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:832
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-install-dir\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:837
#, no-c-format
msgid "libname"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:841 conf-options-table.docbook:990
#, no-c-format
msgid "Auto detected"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:843
#, no-c-format
msgid "Set this option to change the default name of the installed library directory inside ${install-dir} and ${qt-install-dir}. On many systems this is either \"lib\" or \"lib64\". Auto-detection is attempted to set the correct name by default, but if the guess is wrong then it can be changed with this setting."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:847
#, no-c-format
msgid "Related command-line option: --libname <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:852
#, no-c-format
msgid "libpath"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:857
#, no-c-format
msgid "Set this option to set the environment variable <envar>LD_LIBRARY_PATH</envar> while building. You cannot override this setting in a module option. The default value is blank, but the paths <filename class=\"directory\">${install-dir}/$<envar>LIBNAME</envar></filename> and <filename class=\"directory\">${qt-install-dir}/$<envar>LIBNAME</envar></filename> are automatically added. You may use the tilde (~) for any paths you add using this option."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:863
#, no-c-format
msgid "Related command-line option: --libpath <replaceable>path</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:868
#, no-c-format
msgid "log-dir"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:873
#, no-c-format
msgid "Use this option to change the directory used to hold the log files generated by the script."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:875
#, no-c-format
msgid "Related command-line option: --log-dir <replaceable>path</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:880
#, no-c-format
msgid "make-install-prefix"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:885
#, no-c-format
msgid "Set this variable to a space-separated list, which is interpreted as a command and its options to precede the <userinput><command>make</command> <option>install</option></userinput> command used to install modules. This is useful for installing packages with &sudo; for example, but please be careful while dealing with root privileges."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:889
#, no-c-format
msgid "Related command-line option: --make-install-prefix <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:894
#, no-c-format
msgid "make-options"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:899
#, no-c-format
msgid "Set this variable in order to pass command line options to the <command>make</command> command. This is useful for programs such as <ulink url=\"https://github.com/distcc/distcc\"><application>distcc</application></ulink> or systems with more than one processor core."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:903
#, no-c-format
msgid "Note that not all supported build systems use <command>make</command>. For build systems that use <command>ninja</command> for build (such as the <link linkend=\"conf-override-build-system\"><application>Meson</application> build system</link>), see the <link linkend=\"conf-ninja-options\">ninja-options</link> setting."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:908
#, no-c-format
msgid "Related command-line option: --make-options <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:913
#, no-c-format
msgid "manual-build"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:919
#, no-c-format
msgid "Set the option value to <userinput>true</userinput> to keep the build process from attempting to build this module. It will still be kept up-to-date when updating from &git;. This option is exactly equivalent to the <link linkend=\"cmdline-no-build\"> <option>--no-build</option> </link> command line option."
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:932
#, no-c-format
msgid "manual-update"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:938
#, no-c-format
msgid "Set the option value to <userinput>true</userinput> to keep the build process from attempting to update (and by extension, build or install) this module. If you set this option for a module, then you have essentially commented it out."
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:946
#, no-c-format
msgid "ninja-options"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:951
#, no-c-format
msgid "Set this variable in order to pass command line options to the <command>ninja</command> build command. This can be useful to enable <quote>verbose</quote> output or to manually reduce the number of parallel build jobs that <command>ninja</command> would use."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:957
#, no-c-format
msgid "Note that this setting only controls ninja when used by &kdesrc-build;. The &Qt; <quote>webengine</quote> module uses <command>ninja</command> indirectly, but only officially supports being built by <command>make</command>. In this situation, you can set <literal>NINJAFLAGS</literal> as a way to have <command>make</command> pass the appropriate flags when it later calls <command>ninja</command>, by using <link linkend=\"conf-make-options\">make-options</link>."
msgstr ""

#. Tag: programlisting
#. +> trunk5
#: conf-options-table.docbook:965
#, no-c-format
msgid ""
"options <replaceable>qtwebengine</replaceable>\n"
"    # Restrict make and ninja to using no more than 6 separate compile jobs even\n"
"    # when more CPU is available, to avoid running out of memory\n"
"    <option><link linkend=\"conf-make-options\">make-options</link></option> -j<replaceable>6</replaceable> NINJAFLAGS=-j<replaceable>6</replaceable>\n"
"end options"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:967
#, no-c-format
msgid "Related command-line option: --ninja-options <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:972
#, no-c-format
msgid "no-src"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:978
#, no-c-format
msgid "If this option is set to true then &kdesrc-build; will not update the source code for the module automatically. It will still try to build the module if it normally would have tried anyways."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:981
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-no-src\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:986
#, no-c-format
msgid "override-build-system"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:991
#, no-c-format
msgid "KDE, Qt, qmake, generic, autotools, meson"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:994
#, no-c-format
msgid "Normally &kdesrc-build; will detect the appropriate build system to use for a module after it is downloaded. This is done by checking for the existence of specific files in the module's source directory."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:998
#, no-c-format
msgid "Some modules may include more than one required set of files, which could confuse the auto-detection. In this case you can manually specify the correct build type."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1001
#, no-c-format
msgid "Currently supported build types that can be set are:"
msgstr ""

#. Tag: term
#. +> trunk5
#: conf-options-table.docbook:1005
#, no-c-format
msgid "<term>KDE</term>"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1006
#, no-c-format
msgid "Used to build &kde; modules. In reality it can be used to build almost any module that uses &cmake; but it is best not to rely on this."
msgstr ""

#. Tag: term
#. +> trunk5
#: conf-options-table.docbook:1010
#, no-c-format
msgid "<term>Qt</term>"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1011
#, no-c-format
msgid "Used to build the &Qt; library itself."
msgstr ""

#. Tag: term
#. +> trunk5
#: conf-options-table.docbook:1014
#, no-c-format
msgid "qmake"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1015
#, no-c-format
msgid "Used to build &Qt; modules that use <application>qmake</application>-style <literal>.pro</literal> files."
msgstr ""

#. Tag: term
#. +> trunk5
#: conf-options-table.docbook:1020
#, no-c-format
msgid "generic"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1021
#, no-c-format
msgid "Used to build modules that use plain Makefiles and that do not require any special configuration."
msgstr ""

#. Tag: term
#. +> trunk5
#: conf-options-table.docbook:1025
#, no-c-format
msgid "autotools"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1026
#, no-c-format
msgid "This is the standard configuration tool used for most Free and open-source software not in any of the other categories."
msgstr ""

#. Tag: term
#. +> trunk5
#: conf-options-table.docbook:1030
#, no-c-format
msgid "meson"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1031
#, no-c-format
msgid "This is a <ulink url=\"https://mesonbuild.com\">relatively new tool</ulink> gaining popularity as a replacement for the autotools and may be required for some non-&kde; modules."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1037
#, no-c-format
msgid "Related command-line option: --override-build-system <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1042
#, no-c-format
msgid "purge-old-logs"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1048
#, no-c-format
msgid "This option controls whether old log directories are automatically deleted or not."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1050
#, no-c-format
msgid "Related command-line option: --purge-old-logs, --no-purge-old-logs"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1055
#, no-c-format
msgid "qmake-options"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1061
#, no-c-format
msgid "Any options specified here are passed to the <command>qmake</command> command, for modules that use the <symbol>qmake</symbol> build system. For instance, you can use the <userinput>PREFIX=/path/to/qt</userinput> option to qmake to override where it installs the module."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1067
#, no-c-format
msgid "Related command-line option: --qmake-options <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1072
#, no-c-format
msgid "qt-install-dir"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1077
#, no-c-format
msgid "This option controls where to install qt modules after build. If you do not specify this option, &kdesrc-build; will assume that &Qt; is provided by the operating system."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1081
#, no-c-format
msgid "Related command-line option: --qt-install-dir <replaceable>path</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1086
#, no-c-format
msgid "remove-after-install"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:1090
#, no-c-format
msgid "none, builddir, all"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:1091
#, no-c-format
msgid "none"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1093
#, no-c-format
msgid "If you are low on hard disk space, you may want to use this option in order to automatically delete the build directory (or both the source and build directories for one-time installs) after the module is successfully installed."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1098
#, no-c-format
msgid "Possible values for this option are:"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1100
#, no-c-format
msgid "none - Do not delete anything."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1101
#, no-c-format
msgid "builddir - Delete the build directory, but not the source."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1102
#, no-c-format
msgid "all - Delete both the source code and build directory."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1106
#, no-c-format
msgid "Note that using this option can have a significant detrimental impact on both your bandwidth usage (if you use <replaceable>all</replaceable>) and the time taken to compile &kde; software, since &kdesrc-build; will be unable to perform incremental builds."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1109
#, no-c-format
msgid "Related command-line option: --remove-after-install <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1114
#, no-c-format
msgid "repository"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:1118
#, no-c-format
msgid "1.10"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1120
#, no-c-format
msgid "This option is used to specify the &git; repository to download the source code for the module. &Qt; (and therefore qt) would need this option, as well as various &kde; modules that are in the process of conversion to use &git;."
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1127
#, no-c-format
msgid "revision"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1133
#, no-c-format
msgid "If this option is set to a value other than 0 (zero), &kdesrc-build; will force the source update to bring the module to the exact revision given, even if options like <link linkend=\"conf-branch\">branch</link> are in effect. If the module is already at the given revision then it will not be updated further unless this option is changed or removed from the configuration."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1139
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-revision\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1144
#, no-c-format
msgid "run-tests"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1150
#, no-c-format
msgid "If set to <userinput>true</userinput>, then the module will be built with support for running its test suite, and the test suite will be executed as part of the build process. &kdesrc-build; will show a simple report of the test results. This is useful for developers or those who want to ensure their system is setup correctly."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1155
#, no-c-format
msgid "Related command-line option: --run-tests, --no-run-tests"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1160
#, no-c-format
msgid "set-env"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1165
#, no-c-format
msgid "This option accepts a space-separated set of values, where the first value is the environment variable to set, and the rest of the values is what you want the variable set to. For example, to set the variable <envar>RONALD</envar> to McDonald, you would put in the appropriate section this command:"
msgstr ""

#. Tag: programlisting
#. +> trunk5
#: conf-options-table.docbook:1169
#, no-c-format
msgid "<command>set-env</command> <envar>RONALD</envar> <userinput>McDonald</userinput>"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1170
#, no-c-format
msgid "This option is special in that it can be repeated without overriding earlier set-env settings in the same section of the <link linkend=\"configure-data\">configuration file</link>. This way you can set more than one environment variable per module (or globally)."
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1178
#, no-c-format
msgid "source-dir"
msgstr ""

#. Tag: filename
#. +> trunk5
#: conf-options-table.docbook:1182
#, no-c-format
msgid "~/kde/src"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1184
#, no-c-format
msgid "This option is used to set the directory on your computer to store the &kde; &git; sources at. You may use the tilde (~) to represent the home directory if using this option."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1187
#, no-c-format
msgid "Related command-line option: --source-dir <replaceable>path</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1192
#, no-c-format
msgid "stop-on-failure"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1198
#, no-c-format
msgid "Setting this option to <userinput>false</userinput> allows the script to continue execution after an error occurs during the build or install process."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1200
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-stop-on-failure\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1205
#, no-c-format
msgid "<link>tag</link>"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1211
#, no-c-format
msgid "Use this option to download a specific release of a module."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1212
#, no-c-format
msgid "<emphasis>Note:</emphasis> The odds are very good that you <emphasis>do not want</emphasis> to use this option. &kde; releases are available in tarball form from the <ulink url=\"https://download.kde.org/\">&kde; download site</ulink>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1216
#, no-c-format
msgid "Related command-line option: --tag <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1221
#, no-c-format
msgid "use-clean-install"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1228
#, no-c-format
msgid "Set this option to <userinput>true</userinput> in order to have &kdesrc-build; run <command>make uninstall</command> directly before running <command>make install</command>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1232
#, no-c-format
msgid "This can be useful in ensuring that there are not stray old library files, &cmake; metadata, etc. that can cause issues in long-lived &kde; installations. However this only works on build systems that support <command>make uninstall</command>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1236
#, no-c-format
msgid "Related command-line option: --use-clean-install, --no-use-clean-install"
msgstr ""

#. Tag: title
#. +> trunk5
#: conf-options-table.docbook:1247
#, no-c-format
msgid "Module-set and global scope options"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1259
#, no-c-format
msgid "git-repository-base"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:1263 conf-options-table.docbook:1333
#, no-c-format
msgid "1.12.1"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1265
#, no-c-format
msgid "This option is used to create a short name to reference a specific Git repository base URL in later <link linkend=\"module-sets\">module set</link> declarations, which is useful for quickly declaring many Git modules to build."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1270
#, no-c-format
msgid "You must specify two things (separated by a space): The name to assign to the base URL, and the actual base URL itself. For example:"
msgstr ""

#. Tag: programlisting
#. +> trunk5
#: conf-options-table.docbook:1274
#, fuzzy, no-c-format
#| msgid ""
#| "global\n"
#| "    <option><link linkend=\"conf-git-repository-base\">git-repository-base</link></option> <replaceable>kde-git</replaceable> <replaceable>kde:</replaceable>\n"
#| "end global\n"
#| "\n"
#| "module <replaceable>qt</replaceable>\n"
#| "    # Options removed for brevity\n"
#| "end module\n"
#| "\n"
#| "module-set <replaceable>kde-support-libs</replaceable>\n"
#| "    <option><link linkend=\"conf-repository\">repository</link></option> <replaceable>kde-git</replaceable>\n"
#| "    <option><link linkend=\"conf-use-modules\">use-modules</link></option> <replaceable>automoc</replaceable> <replaceable>attica</replaceable> <replaceable>akonadi</replaceable>\n"
#| "end module-set\n"
#| "\n"
#| "# Other modules as necessary...\n"
#| "module <replaceable>kdesupport</replaceable>\n"
#| "end module"
msgid ""
"global\n"
"    # other options\n"
"    # This is the common path to all anonymous Git server modules.\n"
"    git-repository-base <replaceable>kde-git</replaceable> <replaceable>kde:</replaceable>\n"
"end global\n"
"\n"
"# Module declarations\n"
"\n"
"module-set\n"
"    # Now you can use the alias you defined earlier, but <emphasis>only</emphasis> in a module-set.\n"
"    repository <replaceable>kde-git</replaceable>\n"
"    <link linkend=\"conf-use-modules\">use-modules</link> <replaceable>module1.git</replaceable> <replaceable>module2.git</replaceable>\n"
"end module-set"
msgstr ""
"global\n"
"    <option><link linkend=\"conf-git-repository-base\">git-repository-base</link></option> <replaceable>kde-git</replaceable> <replaceable>kde:</replaceable>\n"
"end global\n"
"\n"
"module <replaceable>qt</replaceable>\n"
"    # Opcións retiradas por brevidade\n"
"end module\n"
"\n"
"module-set <replaceable>kde-support-libs</replaceable>\n"
"    <option><link linkend=\"conf-repository\">repository</link></option> <replaceable>kde-git</replaceable>\n"
"    <option><link linkend=\"conf-use-modules\">use-modules</link></option> <replaceable>automoc</replaceable> <replaceable>attica</replaceable> <replaceable>akonadi</replaceable>\n"
"end module-set\n"
"\n"
"# Outros módulos…\n"
"module <replaceable>kdesupport</replaceable>\n"
"end module"

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1277
#, no-c-format
msgid "The module-set's <literal>use-modules</literal> option created two modules internally, with &kdesrc-build; behaving as if it had read:"
msgstr ""

#. Tag: programlisting
#. +> trunk5
#: conf-options-table.docbook:1280
#, no-c-format
msgid ""
"module module1\n"
"    repository kde:<replaceable>module1.git</replaceable>\n"
"end module\n"
"\n"
"module module2\n"
"    repository kde:<replaceable>module2.git</replaceable>\n"
"end module"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1282
#, no-c-format
msgid "The <literal>kde:</literal> &git; repository prefix used above is a shortcut which will be setup by &kdesrc-build; automatically. See the TechBase <ulink url=\"https://techbase.kde.org/Development/Git/Configuration#URL_Renaming\">URL Renaming</ulink> article for more information. Note that unlike most other options, this option can be specified multiple times in order to create as many aliases as necessary."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1290
#, no-c-format
msgid "It is not required to use this option to take advantage of module-set, this option exists to make it easy to use the same repository across many different module sets."
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1297
#, no-c-format
msgid "ignore-modules"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1303
#, no-c-format
msgid "Currently can only be used in module-set, see <ulink url=\"https://bugs.kde.org/show_bug.cgi?id=472917\">Bug 472917</ulink>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1305
#, no-c-format
msgid "Modules named by this option, which would be chosen by &kdesrc-build; due to a <link linkend=\"conf-use-modules\">use-modules</link> option, are instead skipped entirely. Use this option when you want to build an entire <link linkend=\"kde-projects-module-sets\">kde-projects</link> project grouping <emphasis>except for</emphasis> some specific modules."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1311
#, no-c-format
msgid "The option value does not necessarily have to name the module directly. Any module that has full consecutive parts of its <link linkend=\"kde-projects-module-sets\">&kde; projects module path</link> match one of the option values will be ignored, so you can ignore multiple modules this way."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1317
#, no-c-format
msgid "For example, an option value of <replaceable>libs</replaceable> would result in both <symbol>kde/kdegraphics/libs</symbol> and <symbol>playground/libs</symbol> being excluded (though not <symbol>kde/kdelibs</symbol> since the full part <quote>kdelibs</quote> is what is compared)."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1323
#, no-c-format
msgid "See also <xref linkend=\"example-ignoring-a-module\"/>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1324
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-ignore-modules\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:1329
#, no-c-format
msgid "use-modules"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1335
#, fuzzy, no-c-format
#| msgid "Notable <link linkend=\"features\">features</link>."
msgid "Can only be used in <link linkend=\"module-sets\">module-set</link>."
msgstr "<link linkend=\"features\">Funcionalidades</link> salientábeis."

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1336
#, no-c-format
msgid "This option allows you to easily specify many different modules to build at the same point in <link linkend=\"kdesrc-buildrc\">the configuration file</link>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1340
#, no-c-format
msgid "Every identifier passed to this option is internally converted to a &kdesrc-build; module, with a <link linkend=\"conf-repository\"><option>repository</option></link> option set to the module-set's repository combined with the identifier name in order to setup the final repository to download from. All other options that are assigned in the module-set are also copied to the generated modules unaltered."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1347
#, no-c-format
msgid "The order that modules are defined in this option is important, because that is also the order that &kdesrc-build; will process the generated modules when updating, building, and installing. All modules defined in the given module-set will be handled before &kdesrc-build; moves to the next module after the module-set."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1353
#, no-c-format
msgid "If you need to change the options for a generated module, simply declare the module again after it is defined in the module-set, and set your options as needed. Although you will change the options set for the module this way, the module will still be updated and built in the order set by the module-set (i.e. you can't reorder the build sequence doing this)."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1359
#, no-c-format
msgid "The name to use for the module if you do this is simply the name that you passed to <option>use-modules</option>, with the exception that any <literal>.git</literal> is removed."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:1363
#, no-c-format
msgid "See <xref linkend=\"module-sets\"/> and <link linkend=\"conf-git-repository-base\">git-repository-base</link> for a description of its use and an example."
msgstr ""
