#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:41
#, no-c-format
msgid "This option enables the asynchronous mode of operation, where the source code update and the build process will be performed in parallel, instead of waiting for all of the source code updates before starting the build process."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:44
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-async\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:49
#, no-c-format
msgid "colorful-output"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:53
#, no-c-format
msgid "Set this option to <userinput>false</userinput> to disable the colorful output of &kdesrc-build;. Note that &kdesrc-build; will not output the color codes to anything but a terminal (such as xterm, &konsole;, or the normal &Linux; console)."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:57
#, no-c-format
msgid "Related command-line option: <xref linkend=\"cmdline-color\"/>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:62
#, no-c-format
msgid "disable-agent-check"
msgstr ""

#. Tag: member
#. +> trunk5
#: conf-options-table.docbook:66 conf-options-table.docbook:280
#: conf-options-table.docbook:295 conf-options-table.docbook:557
#: conf-options-table.docbook:756 conf-options-table.docbook:917
#: conf-options-table.docbook:936 conf-options-table.docbook:976
#: conf-options-table.docbook:1148 conf-options-table.docbook:1225
#, no-c-format
msgid "False"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:68
#, no-c-format
msgid "If you are using &ssh; to download the &git; sources (such as if you are using the git+ssh protocol), this option controls if &kdesrc-build; will try and make sure that if you are using ssh-agent, it is actually managing some &ssh; identities. This is to try and prevent &ssh; from asking for your pass phrase for every module."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:73
#, no-c-format
msgid "Related command-line option: --disable-agent-check, --no-disable-agent-check"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:78
#, no-c-format
msgid "git-desired-protocol"
msgstr ""

