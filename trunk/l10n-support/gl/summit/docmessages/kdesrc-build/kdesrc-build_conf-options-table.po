#. +> trunk5
#: conf-options-table.docbook:459
#, no-c-format
msgid "Unix Makefiles"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:461
#, no-c-format
msgid "Specify which generator to use with &cmake;. Currently both <literal>Ninja</literal> and <literal>Unix Makefiles</literal> as well as extra generators based on them like <literal>Eclipse CDT4 - Ninja </literal> are supported. Invalid (unsupported) values are ignored and treated as if unset."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:468
#, no-c-format
msgid "Note that if a valid generator is also specified through <link linkend=\"conf-cmake-options\">cmake-options</link> it will override the value for <literal>cmake-generator</literal>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:471
#, no-c-format
msgid "Related command-line option: --cmake-generator <replaceable>value</replaceable>"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:476
#, no-c-format
msgid "cmake-toolchain"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:481
#, no-c-format
msgid "Specify a toolchain file to use with &cmake;."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:483
#, no-c-format
msgid "When a valid toolchain file is configured, &kdesrc-build; will <emphasis>no longer set environment variables automatically</emphasis>. You can use &set-env;, &binpath; and &libpath; to fix up the environment manually if your toolchain file does not work out of the box with &kdesrc-build;. Refer to <link linkend=\"kdesrc-build-std-flags\">the overview of standard flags added by &kdesrc-build;</link> for more information."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:490
#, no-c-format
msgid "Note that if a valid toolchain is also specified through <link linkend=\"conf-cmake-options\">cmake-options</link> it will override the value for <literal>cmake-toolchain</literal>."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:493
#, no-c-format
msgid "Related command-line option: --cmake-toolchain <replaceable>value</replaceable>"
msgstr ""

