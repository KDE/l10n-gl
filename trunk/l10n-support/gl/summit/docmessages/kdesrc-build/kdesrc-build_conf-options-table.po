#: conf-options-table.docbook:540
#, no-c-format
msgid "compile-commands-export"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:546
#, no-c-format
msgid "Enables the generation of a <literal>compile_commands.json</literal> via CMake inside the build directory."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:548
#, no-c-format
msgid "Related command-line option: --compile-commands-export, --no-compile-commands-export"
msgstr ""

#. Tag: link
#. +> trunk5
#: conf-options-table.docbook:553
#, no-c-format
msgid "compile-commands-linking"
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:559
#, no-c-format
msgid "Enables the creation of symbolic links from <literal>compile_commands.json</literal> generated via CMake inside the build directory to the matching source directory."
msgstr ""

#. Tag: para
#. +> trunk5
#: conf-options-table.docbook:562
#, no-c-format
