#. Tag: title
#. +> trunk5
#: supported-cmdline-params.docbook:2
#, no-c-format
msgid "Supported command-line parameters"
msgstr ""

#. Tag: title
#. +> trunk5
#: supported-cmdline-params.docbook:5
#, no-c-format
msgid "Generic"
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:9
#, no-c-format
msgid "<option>--pretend</option> (or <option>--dry-run</option> or <option>-p</option>)"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:10
#, no-c-format
msgid "&kdesrc-build; will run through the update and build process, but instead of performing any actions to update or build, will instead output what the script would have done (e.g. what commands to run, general steps being taken, etc.)."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:16
#, no-c-format
msgid "Simple read-only commands (such as reading file information) may still be run to make the output more relevant (such as correctly simulating whether source code would be checked out or updated)."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:21
#, no-c-format
msgid "This option requires that some needed metadata is available, which is normally automatically downloaded, but downloads are disabled in pretend mode. If you've never run &kdesrc-build; (and therefore, don't have this metadata), you should run <command>kdesrc-build <option>--metadata-only</option></command> to download the required metadata first."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:32
#, no-c-format
msgid "<option>--include-dependencies</option> (or <option>-d</option>), <option>--no-include-dependencies</option> (or <option>-D</option>)"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:33
#, no-c-format
msgid "This option causes &kdesrc-build; to automatically include other &kde; and &Qt; modules in the build, if required for the modules you have requested to build on the command line or in your <link linkend=\"configure-data\">configuration file</link>."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:39
#, fuzzy, no-c-format
#| msgid "Note that this option relies on information available from the &kde; project database, so this feature only works for these modules. See also <xref linkend=\"kde-projects-module-sets\"/>."
msgid "The modules that are added are as recorded within the &kde; source code management system. See <xref linkend=\"kde-projects-module-sets\"/>."
msgstr "Esta opción depende de información dispoñíbel na base de datos to proxecto &kde;, polo que esta funcionalidade unicamente ten efecto neses módulos. Véxase tamén <xref linkend=\"kde-projects-module-sets\"/>."

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:42
#, no-c-format
msgid "The corresponding configuration file option is <link linkend=\"conf-include-dependencies\">include-dependencies</link>."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:45
#, no-c-format
msgid "This option is enabled by default."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:50
#, no-c-format
msgid "<option>--ignore-modules</option> (or <option>-!</option>) <parameter>module [module ...]</parameter>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:51
#, no-c-format
msgid "Do not include the modules passed on the rest of the command line in the update/build process (this is useful if you want to build most of the modules in your <link linkend=\"configure-data\">configuration file</link> and just skip a few)."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:60
#, no-c-format
msgid "<option>--run</option> (or <option>--start-program</option>) <parameter>program [parameters ...]</parameter>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:61
#, no-c-format
msgid "This option interprets the next item on the command line as a program to run, and &kdesrc-build; will then finish reading the configuration file, update the environment as normal, and then execute the given program."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:66
#, no-c-format
msgid "This will not work to start a shell with the &kdesrc-build; environment in most cases however, since interactive shells typically reset at least part of the environment variables (such as <envar>PATH</envar> and ${install-dir}) in the startup sequence."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:72
#, no-c-format
msgid "If you want to see the environment used by &kdesrc-build;, you can run the <command>printenv</command> command:"
msgstr ""

#. Tag: screen
#. +> trunk5
#: supported-cmdline-params.docbook:75
#, no-c-format
msgid ""
"$ <command>kdesrc-build</command> <parameter>--run</parameter> <parameter>printenv</parameter>\n"
"KDE_SESSION_VERSION=4\n"
"SDL_AUDIODRIVER=alsa\n"
"LANGUAGE=\n"
"XCURSOR_THEME=Oxygen_Blue\n"
"LESS=-R -M --shift 5\n"
"QMAIL_CONTROLDIR=/var/qmail/control\n"
"... etc."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:81
#, no-c-format
msgid "<option>--revision</option> <replaceable>id</replaceable>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:82
#, fuzzy, no-c-format
#| msgid "&kdesrc-build; can checkout a specific <link linkend=\"using-branches\">branch or tag</link> of a module. You can also ensure that a specific <link linkend=\"conf-revision\">revision</link> is checked out of a module."
msgid "This option causes &kdesrc-build; to checkout a specific numbered revision for each &git; module, overriding any <link linkend=\"conf-branch\">branch</link>, <link linkend=\"conf-tag\">tag</link>, or <link linkend=\"conf-revision\">revision</link> options already set for these modules."
msgstr "&kdesrc-build; pode descargar unha <link linkend=\"using-branches\">póla ou etiqueta</link> específica dun módulo. Pode asegurarse de que se descarga unha <link linkend=\"conf-revision\">revisión</link> específica dun módulo."

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:88
#, no-c-format
msgid "This option is likely not a good idea, and is only supported for compatibility with older scripts."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:94
#, no-c-format
msgid "<option>--delete-my-patches</option>, <option>--no-delete-my-patches</option>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:95
#, no-c-format
msgid "This option is used to let &kdesrc-build; delete source directories that may contain user data, so that the module can be re-downloaded. This would normally only be useful for &kde; developers (who might have local changes that would be deleted)."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:101
#, no-c-format
msgid "You should not use this option normally, &kdesrc-build; will prompt to be re-run with it if it is needed."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:107
#, no-c-format
msgid "<option>--delete-my-settings</option>, <option>--no-delete-my-settings</option>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:108
#, no-c-format
msgid "This option is used to let &kdesrc-build; overwrite existing files which may contain user data."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:112
#, no-c-format
msgid "This is currently only used for xsession setup for the login manager. You should not use this option normally, &kdesrc-build; will prompt to be re-run with it if it is needed."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:119
#, no-c-format
msgid "<option>--<replaceable>&lt;option-name&gt;</replaceable></option> <replaceable>value</replaceable>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:120
#, no-c-format
msgid "You can use this option to override an option in your <link linkend=\"configure-data\">configuration file</link> for every module. For instance, to override the <link linkend=\"conf-log-dir\">log-dir</link> option, you would do: <userinput><parameter>--log-dir <filename class=\"directory\"><replaceable>/path/to/dir</replaceable></filename></parameter></userinput>."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:127
#, no-c-format
msgid "This feature can only be used for option names already recognized by &kdesrc-build;, that are not already supported by relevant command line options. For example the <link linkend=\"conf-async\">async</link> configuration file option has specific <link linkend=\"cmdline-async\">--async</link> and <link linkend=\"cmdline-async\">--no-async</link> command line options that are preferred by &kdesrc-build;."
msgstr ""

#. Tag: option
#. +> trunk5
#: supported-cmdline-params.docbook:139
#, no-c-format
msgid "--set-module-option-value <replaceable>&lt;module-name&gt;</replaceable>,<replaceable>&lt;option-name&gt;</replaceable>,<replaceable>&lt;option-value&gt;</replaceable>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:140
#, no-c-format
msgid "You can use this option to override an option in your <link linkend=\"configure-data\">configuration file</link> for a specific module."
msgstr ""

#. Tag: title
#. +> trunk5
#: supported-cmdline-params.docbook:150
#, no-c-format
msgid "Resuming and stopping"
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:154
#, no-c-format
msgid "<option>--resume-from</option> (or <option>--from</option> or <option>-f</option>) <replaceable>module</replaceable>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:155
#, no-c-format
msgid "This option is used to resume the build starting from the given module. You should not specify other module names on the command line."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:159
#, no-c-format
msgid "If you want to avoid source updates when resuming, simply pass <option>--no-src</option> in addition to the other options."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:164
#, no-c-format
msgid "See also: <link linkend=\"cmdline-resume-after\">--resume-after</link> and <xref linkend=\"resuming-failed\"/>. You would prefer to use this command line option if you have fixed the build error and want &kdesrc-build; to complete the build."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:171
#, no-c-format
msgid "<option>--resume-after</option> (or <option>--after</option> or <option>-a</option>) <replaceable>module</replaceable>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:172
#, no-c-format
msgid "This option is used to resume the build starting after the given module. You should not specify other module names on the command line."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:177
#, no-c-format
msgid "If you want to avoid source updates when resuming, simply pass <option><userinput>--no-src</userinput></option> in addition to the other options."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:182
#, no-c-format
msgid "See also: <link linkend=\"cmdline-resume-from\">--resume-from</link> and <xref linkend=\"resuming-failed\"/>. You would prefer to use this command line option if you have fixed the build error and have also built and installed the module yourself, and want &kdesrc-build; to start again with the next module."
msgstr ""

#. Tag: option
#. +> trunk5
#: supported-cmdline-params.docbook:190
#, no-c-format
msgid "--resume"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:191
#, no-c-format
msgid "This option can be used to run &kdesrc-build; after it has had a build failure."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:194
#, no-c-format
msgid "It resumes the build from the module that failed, using the list of modules that were waiting to be built before, and disables source and metadata updates as well. The use case is when a simple mistake or missing dependency causes the build failure. Once you correct the error you can quickly get back into building the modules you were building before, without fiddling with <option><link linkend=\"cmdline-resume-from\">--resume-from</link></option> and <option><link linkend=\"cmdline-stop-before\">--stop-before</link></option>."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:206
#, no-c-format
msgid "<option>--stop-before</option> (or <option>--until</option>) <replaceable>module</replaceable>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:207
#, no-c-format
msgid "This option is used to stop the normal build process just <emphasis>before</emphasis> a module would ordinarily be built."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:210
#, no-c-format
msgid ""
"For example, if the normal build list was "
"<simplelist type=\"inline\"> <member>moduleA</member><member>moduleB</member><member>moduleC</member></simplelist>"
", then <option>--stop-before <replaceable>moduleB</replaceable></option> would cause &kdesrc-build; to only build <literal>moduleA</literal>."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:219
#, no-c-format
msgid "<option>--stop-after</option> (or <option>--to</option>) <replaceable>module</replaceable>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:220
#, no-c-format
msgid "This option is used to stop the normal build process just <emphasis>after</emphasis> a module would ordinarily be built."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:223
#, no-c-format
msgid ""
"For example, if the normal build list was "
"<simplelist type=\"inline\"> <member>moduleA</member><member>moduleB</member><member>moduleC</member></simplelist>"
", then <option>--stop-after <replaceable>moduleB</replaceable></option> would cause &kdesrc-build; to build <literal>moduleA</literal> and <literal>moduleB</literal>."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:232
#, no-c-format
msgid "<option>--stop-on-failure</option>, <option>--no-stop-on-failure</option>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:233
#, no-c-format
msgid "This option controls if the build will be aborted as soon as a failure occurs. Default behavior is --stop-on-failure. You may override it if you wish to press on with the rest of the modules in the build, to avoid wasting time in case the problem is with a single module."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:237
#, fuzzy, no-c-format
#| msgid "The <link linkend=\"configure-data\">configuration file</link> syntax and options."
msgid "See also the <link linkend=\"conf-stop-on-failure\">stop-on-failure</link> configuration file option."
msgstr "A sintaxe e as opcións do <link linkend=\"configure-data\">ficheiro de configuración</link>."

#. Tag: option
#. +> trunk5
#: supported-cmdline-params.docbook:243
#, no-c-format
msgid "--rebuild-failures"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:244
#, no-c-format
msgid "Use this option to build only those modules which failed to build on a previous &kdesrc-build; run. This is useful if a significant number of failures occurred mixed with successful builds. After fixing the issue causing the build failures you can then easily build only the modules that failed previously."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:250
#, no-c-format
msgid "Note that the list of <quote>previously-failed modules</quote> is reset every time a &kdesrc-build; run finishes with some module failures. However, it is not reset by a completely successful build, so you can successfully rebuild a module or two and this flag will still work."
msgstr ""

#. Tag: title
#. +> trunk5
#: supported-cmdline-params.docbook:262
#, no-c-format
msgid "Modules information"
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:266
#, no-c-format
msgid "<option>--query</option> <userinput><replaceable>mode</replaceable></userinput>"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:267
#, no-c-format
msgid "This command causes &kdesrc-build; to query a parameter of the modules in the build list (either passed on the command line or read in from the configuration file), outputting the result to screen (one module per line)."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:272
#, no-c-format
msgid "This option must be provided with a <quote>mode</quote>, which may be one of the following:"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:275
#, no-c-format
msgid "<parameter>source-dir</parameter>, which causes &kdesrc-build; to output the full path to where the module's source code is stored."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:278
#, no-c-format
msgid "<parameter>build-dir</parameter>, which causes &kdesrc-build; to output the full path to where the module build process occurs."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:281
#, no-c-format
msgid "<parameter>install-dir</parameter>, which causes &kdesrc-build; to output the full path to where the module will be installed."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:284
#, no-c-format
msgid "<parameter>project-path</parameter>, which causes &kdesrc-build; to output the location of the module within the hierarchy of KDE source code repositories. See <xref linkend=\"kde-projects-module-sets\"/> for more information on this hierarchy."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:289
#, fuzzy, no-c-format
#| msgid "&kdesrc-build; can checkout a specific <link linkend=\"using-branches\">branch or tag</link> of a module. You can also ensure that a specific <link linkend=\"conf-revision\">revision</link> is checked out of a module."
msgid "<parameter>branch</parameter>, which causes &kdesrc-build; to output the resolved git branch that will be used for each module, based on the <link linkend=\"conf-tag\">tag</link>, <link linkend=\"conf-branch\">branch</link> and <link linkend=\"conf-branch-group\">branch-group</link> settings in effect."
msgstr "&kdesrc-build; pode descargar unha <link linkend=\"using-branches\">póla ou etiqueta</link> específica dun módulo. Pode asegurarse de que se descarga unha <link linkend=\"conf-revision\">revisión</link> específica dun módulo."

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:295
#, fuzzy, no-c-format
#| msgid "The <link linkend=\"configure-data\">configuration file</link> syntax and options."
msgid "Any option name that is valid for modules in the <link linkend=\"conf-options-table\">configuration file</link>."
msgstr "A sintaxe e as opcións do <link linkend=\"configure-data\">ficheiro de configuración</link>."

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:300
#, no-c-format
msgid "If a single module is passed on the command line, then the output is simply the value of the parameter being queried. If multiple (or no) modules are passed on the command line, then each line is prefixed by the name of the module. Either way, &kdesrc-build; stops running once each value is output."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:308
#, no-c-format
msgid "For example, the command <userinput><command>kdesrc-build</command> <option>--query</option> <option>branch</option> <replaceable>kactivities</replaceable> <replaceable>kdepim</replaceable></userinput> might end up with output like:"
msgstr ""

#. Tag: screen
#. +> trunk5
#: supported-cmdline-params.docbook:311
#, no-c-format
msgid ""
"kactivities: master\n"
"kdepim: master"
msgstr ""

#. Tag: option
#. +> trunk5
#: supported-cmdline-params.docbook:318
#, no-c-format
msgid "--print-modules"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:320
#, no-c-format
msgid "Takes all actions up to and including dependency reordering of the modules specified on the command line (or configuration file), prints the modules that would be processed one per line, and then exits without further action."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:325
#, no-c-format
msgid "The <literal>kde-project</literal> metadata is downloaded first (though, see <link linkend=\"cmdline-pretend\"><option>--pretend</option></link> or <link linkend=\"cmdline-no-src\"><option>--no-src</option></link>)."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:330
#, no-c-format
msgid "The output is not fully compatible with usage by scripts as other output messages may be generated until the module list is shown."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:334
#, no-c-format
msgid "This is mostly just useful for quickly determining what &kdesrc-build; understands a module's dependencies to be, which means it's only useful for <link linkend=\"kde-projects-module-sets\"><literal>kde-projects</literal></link> modules. This option is also compatible with <link linkend=\"cmdline-resume-from\"><option>--resume-from</option></link>, <link linkend=\"cmdline-resume-after\"><option>--resume-after</option></link>, <link linkend=\"cmdline-stop-before\"><option>--stop-before</option></link>, <link linkend=\"cmdline-stop-after\"><option>--stop-after</option></link>."
msgstr ""

#. Tag: option
#. +> trunk5
#: supported-cmdline-params.docbook:348
#, no-c-format
msgid "--list-build"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:350
#, no-c-format
msgid "Lists the modules that would be built, in the order in which they would be built. If applicable, the output listing also mentions which commit/branch/tag would be selected for checkout."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:355
#, no-c-format
msgid "This option is similar to <link linkend=\"cmdline-print-modules\"><option>--print-modules</option></link>. For more detailed information on how modules relate to each other, see also: <link linkend=\"cmdline-dependency-tree\"><option>--dependency-tree</option></link>."
msgstr ""

#. Tag: option
#. +> trunk5
#: supported-cmdline-params.docbook:365
#, no-c-format
msgid "--dependency-tree"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:367
#, no-c-format
msgid "Prints out dependency information on the modules that would be built using a tree format (recursive). Listed information also includes which specific commit/branch/tag is depended on and whether the dependency would be built. Note: the generated output may become quite large for applications with many dependencies."
msgstr ""

#. Tag: option
#. +> trunk5
#: supported-cmdline-params.docbook:377
#, no-c-format
msgid "--dependency-tree-fullpath"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:379
#, no-c-format
msgid "Prints out dependency information on the modules that would be built using a tree format (recursive). In fullpath format. Note: the generated output may become quite large for applications with many dependencies."
msgstr ""

#. Tag: title
#. +> trunk5
#: supported-cmdline-params.docbook:391
#, no-c-format
msgid "Exclude specific action"
msgstr ""

#. Tag: option
#. +> trunk5
#: supported-cmdline-params.docbook:395
#, no-c-format
msgid "--no-metadata"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:396
#, no-c-format
msgid "Do not automatically download the extra metadata needed for &kde; git modules. The source updates for the modules themselves will still occur unless you pass <link linkend=\"cmdline-no-src\">--no-src</link> as well."
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:400
#, no-c-format
msgid "This can be useful if you are frequently re-running &kdesrc-build; since the metadata does not change very often. But note that many other features require the metadata to be available. You might want to consider running &kdesrc-build; with the <link linkend=\"cmdline-metadata-only\">--metadata-only</link> option one time and then using this option for subsequent runs."
msgstr ""

#. Tag: term
#. +> trunk5
#: supported-cmdline-params.docbook:410
#, no-c-format
msgid "<option>--no-src</option> (or <option>-S</option>)"
msgstr ""

#. Tag: para
#. +> trunk5
#: supported-cmdline-params.docbook:411
#, no-c-format
msgid "Skip contacting the &git; server."
