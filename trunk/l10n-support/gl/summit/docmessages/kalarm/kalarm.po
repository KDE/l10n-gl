#. Tag: para
#. +> trunk6 stable6
#: index.docbook:310
#, no-c-format
msgid "Command alarms: the command line or command script is searched."
msgstr "Alarmas con orde: búscase a liña de ordes ou o guión."

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:315
#, no-c-format
msgid "Email alarms: in addition to the subject and body of the email, the recipients and the URLs of attachments are searched."
msgstr "Alarmas con correo electrónico: búscanse, ademais do asunto e o corpo da mensaxe, os destinatarios e os URLs dos arquivos anexos."

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:320
#, fuzzy, no-c-format
#| msgid "File display alarms: the file path/&URL; is searched."
