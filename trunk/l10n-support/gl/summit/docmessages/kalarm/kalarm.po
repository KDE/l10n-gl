msgid "Unselect <menuchoice><guimenu>Actions</guimenu> <guimenuitem>Enable Alarms</guimenuitem></menuchoice>."
msgstr "Seleccione <menuchoice><guimenu>Accións</guimenu> <guimenuitem>Activar Alarmas</guimenuitem></menuchoice>."

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:2442
