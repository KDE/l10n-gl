#, no-c-format
msgid "Translates an DocBook XML file using a PO file"
msgstr "Traduce un ficheiro XML DocBook usando un ficheiro PO."

#. Tag: cmdsynopsis
#. +> trunk6 stable6
#: man-po2xml.1.docbook:24
#, no-c-format
msgid "<command>po2xml</command> <group><option><replaceable>original-XML</replaceable> <replaceable>translated-PO</replaceable></option></group>"
msgstr "<command>po2xml</command> <group><option><replaceable>XML-orixinal</replaceable> <replaceable>PO-traducido</replaceable></option></group>"

#. Tag: title
#. +> trunk6 stable6
#: man-po2xml.1.docbook:33
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#. +> trunk6 stable6
#: man-po2xml.1.docbook:35
#, no-c-format
msgid "<command>po2xml</command> is a command-line tool that translates the DocBook XML file <replaceable>original-XML</replaceable> using the gettext message file <replaceable>translated-PO</replaceable>. The resulting translated XML file is sent to standard output."
msgstr "<command>po2xml</command> é unha ferramenta para a liña de ordes que traduce o ficheiro XML Docbook <replaceable>XML-orixinal</replaceable> usando o ficheiro de mensaxes gettext <replaceable>PO-traducido</replaceable>. O ficheiro XML traducido que se obtén é enviado á saída estándar."

