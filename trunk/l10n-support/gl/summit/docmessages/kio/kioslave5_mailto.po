#| msgid "The kioslave mailto is responsible for launching the mail composer of your choice when you open a &URL; in the mailto scheme (<ulink url=\"http://tools.ietf.org/html/rfc6068\">RFC6068</ulink>)."
msgid "The kioslave mailto is responsible for launching the mail composer of your choice when you open a &URL; in the mailto scheme (<ulink url=\"https://tools.ietf.org/html/rfc6068\">RFC6068</ulink>)."
msgstr "O kioslave mailto inicia o editor de correo preferido polo usuario cando este abre un &URL; co esquema mailto (<ulink url=\"http://tools.ietf.org/html/rfc6068\">RFC6068</ulink>)."

#. Tag: term
#. +> trunk5
#: index.docbook:30
#, no-c-format
msgid "Syntax"
msgstr "Sintaxe"

#. Tag: para
#. +> trunk5
#: index.docbook:31
#, no-c-format
msgid "The syntax of a mailto &URL; follows the following pattern:"
msgstr "A sintaxe dun &URL; mailto segue o seguinte padrón:"

#. Tag: para
#. +> trunk5
#: index.docbook:33
#, no-c-format
msgid "mailto:recipients?query"
msgstr "mailto:destinatarios?query"

#. Tag: para
#. +> trunk5
#: index.docbook:35
#, no-c-format
msgid "where recipients form a list of restricted &SMTP; address specifications, and the query part may contain one or more of the following parameters:"
msgstr "onde destinatarios forma unha lista de especificacións de enderezos &SMTP; restrinxida, e a parte query pode conter un ou máis dos seguintes parámetros:"

#. Tag: term
#. +> trunk5
#: index.docbook:40
#, no-c-format
msgid "&amp;to=recipients"
msgstr "&amp;to=destinatarios"

#. Tag: para
#. +> trunk5
#: index.docbook:41
#, no-c-format
msgid "Specifies additional recipients."
msgstr "Especifica destinatarios adicionais."

#. Tag: term
#. +> trunk5
#: index.docbook:45
#, no-c-format
msgid "&amp;cc=recipients"
msgstr "&amp;cc=destinatarios"

#. Tag: para
#. +> trunk5
#: index.docbook:46
#, no-c-format
msgid "Specifies additional recipients of carbon copies."
msgstr "Indica destinatarios adicionais de copias."

#. Tag: term
#. +> trunk5
#: index.docbook:50
#, no-c-format
msgid "&amp;bcc=recipients"
msgstr "&amp;bcc=destinatarios"

#. Tag: para
#. +> trunk5
#: index.docbook:51
#, no-c-format
msgid "Specifies additional recipients of blind carbon copies. These recipients will receive the message, but all other recipients will not know about that."
msgstr "Indica destinatarios adicionais de copias agochadas. Estes han recibir a mensaxe, pero os demais destinatarios non o han saber."

#. Tag: term
#. +> trunk5
#: index.docbook:56
#, no-c-format
msgid "&amp;body=text"
msgstr "&amp;body=texto"

#. Tag: para
#. +> trunk5
#: index.docbook:57
#, no-c-format
msgid "Specifies the text of the message. This text should not be long, as there may be hard limits on how long an &URL; may be."
msgstr "Especifica o texto da mensaxe. Non debe ser longo xa que poden haber limitacións na lonxitude do &URL;."

#. Tag: term
#. +> trunk5
#: index.docbook:62
#, no-c-format
msgid "&amp;subject=text"
msgstr "&amp;subject=texto"

#. Tag: para
#. +> trunk5
#: index.docbook:63
#, no-c-format
msgid "Specifies the subject of the message."
msgstr "Indica o asunto da mensaxe."

#. Tag: term
#. +> trunk5
#: index.docbook:72
#, no-c-format
msgid "Example"
msgstr "Exemplo"

#. Tag: literal
#. +> trunk5
#: index.docbook:74
#, no-c-format
msgid "mailto:info@kde.org?cc=kde@kde.org&amp;subject=Thank%20you!&amp;body=KDE%20rocks!%20How%20can%20I%20help%3F"
msgstr "mailto:info@kde.org?cc=kde@kde.org&amp;subject=Moitas%20grazas!&amp;body=KDE%20mola!%20Como%20poido%20axudar%3F"

#. Tag: term
#. +> trunk5
#: index.docbook:79
#, no-c-format
msgid "Configuration"
msgstr "Configuración"

#. Tag: para
#. +> trunk5
#: index.docbook:80
#, fuzzy, no-c-format
#| msgid "Choose the application to handle mailto locators in &systemsettings; <menuchoice><guimenu>Workspace Appearance and Behaviour</guimenu><guimenuitem>Default Applications</guimenuitem></menuchoice>."
msgid "Choose the application to handle mailto locators in &systemsettings; module <menuchoice><guimenu>Applications</guimenu><guimenuitem>Default Applications</guimenuitem></menuchoice> in the category <guilabel>Personalization</guilabel>."
msgstr "Pode escoller o aplicativo co que manexar os localizadores mailto en &systemsettings; <menuchoice><guimenu>Aparencia e comportamento da área de traballo</guimenu><guimenuitem>Aplicativos predeterminados</guimenuitem></menuchoice>."
