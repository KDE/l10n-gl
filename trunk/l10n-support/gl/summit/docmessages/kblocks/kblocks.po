#. Tag: title
#. +> trunk6 stable6
#: index.docbook:79
#, no-c-format
msgid "Rules"
msgstr "Regras"

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:81
#, no-c-format
msgid "The rules are simple: just keep space for the blocks to fall!"
msgstr "As regras son simples: hai que deixar sitio para que caian os bloques!"

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:82
#, no-c-format
msgid "When a new block cannot fall, the game is over."
msgstr "Cando un bloque novo non pode caer acábase o xogo."

#. Tag: title
#. +> trunk6 stable6
#: index.docbook:87
#, no-c-format
msgid "Strategies and Tips"
msgstr "Estratexias e suxestións"

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:89
#, no-c-format
msgid "Do not forget to check the preview area: it shows the next piece that will be released."
msgstr "Non esquezas revisar a área de vista previa: mostra a peza seguinte que se vai soltar."

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:90
#, no-c-format
msgid "For additional points, try to remove several lines at once."
msgstr "Para obter puntos adicionais, intenta retirar varias liñas de vez."

