#. Tag: title
#. +> trunk5 stable5
#: man-cvslastchange.1.docbook:33
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#. +> trunk5 stable5
#: man-cvslastchange.1.docbook:35
#, no-c-format
msgid "&cvslastchange; displays the last change committed to &CVS; for a file. It uses <command>cvs diff</command> and <command>cvs log</command> to do this."
msgstr "&cvslastchange; mostra o último cambio remitido a &CVS; que afecta a un ficheiro. Usa <command>cvs diff</command> e <command>cvs log</command>."

#. Tag: para
#. +> trunk5 stable5
#: man-cvslastchange.1.docbook:39
#, no-c-format
msgid "&cvslastchange; works on any &CVS; branch, not just HEAD."
msgstr "&cvslastchange; traballa sobre calquera galla do &CVS;, non só sobre HEAD."

#. Tag: para
#. +> trunk5 stable5
#: man-cvslastchange.1.docbook:41
#, no-c-format
msgid "This utility is part of the &kde; Software Development Kit."
msgstr "Esta utilidade forma parte do Kit de Desenvolvemento de Software de &kde;."

