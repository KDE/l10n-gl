#. +> trunk6 stable5
#: man-pruneemptydirs.1.docbook:51
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: option
#. +> trunk6 stable5
#: man-pruneemptydirs.1.docbook:55
#, no-c-format
msgid "<option>-f</option>"
msgstr "<option>-f</option>"

#. Tag: para
#. +> trunk6 stable5
#: man-pruneemptydirs.1.docbook:56
#, no-c-format
msgid ""
"Actually perform the deletions instead of just printing them out. Use this"
" option with care."
msgstr ""
"Aplica as eliminacións en vez de imprimilas. Use esta opción con moito"
" coidado."

