#. Tag: refpurpose
#. +> trunk5 stable5
#: man-qtdoc.1.docbook:19
#, no-c-format
msgid "Open a &Qt; help page in &konqueror;"
msgstr "Abre unha páxina de axuda de &Qt; en &konqueror;."

#. Tag: cmdsynopsis
#. +> trunk5 stable5
#: man-qtdoc.1.docbook:23
#, no-c-format
msgid "<command>qtdoc</command> <group><option><replaceable>classname</replaceable></option></group>"
msgstr "<command>qtdoc</command> <group><option><replaceable>clase</replaceable></option></group>"

#. Tag: title
#. +> trunk5 stable5
#: man-qtdoc.1.docbook:31
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#. +> trunk5 stable5
#: man-qtdoc.1.docbook:33
#, no-c-format
msgid "<command>qtdoc</command> opens a &Qt; help page in &konqueror;. If <replaceable>classname</replaceable> is given, it opens the help page for that class. Otherwise the main &Qt; help page is opened. <replaceable>classname</replaceable> is case insensitive."
msgstr "<command>qtdoc</command> abre unha páxina de axuda de &Qt; en &konqueror;. De indicarse <replaceable>clase</replaceable>, abrirá a axuda desa clase. De non indicarse abrirase a páxina inicial da axuda de &Qt;. <replaceable>clase</replaceable> non distingue maiúsculas de minúsculas."

#. Tag: para
#. +> trunk5 stable5
#: man-qtdoc.1.docbook:38
#, no-c-format
msgid "This utility is part of the &kde; Software Development Kit"
msgstr "Esta utilidade forma parte do Kit de Desenvolvemento de Software de &kde;"

#. Tag: title
#. +> trunk5 stable5
#: man-qtdoc.1.docbook:43
#, no-c-format
msgid "Environment"
msgstr "Contorno"

#. Tag: envar
#. +> trunk5 stable5
#: man-qtdoc.1.docbook:47
#, no-c-format
msgid "QTDIR"
msgstr "QTDIR"

#. Tag: para
#. +> trunk5 stable5
#: man-qtdoc.1.docbook:48
#, no-c-format
msgid "The directory beneath which &Qt; is installed. The main &Qt; help page is expected to be in <filename class=\"directory\">$<envar>QTDIR</envar>/doc/html/</filename>."
msgstr "O cartafol no que está instalada &Qt;. A páxina inicial da axuda de &Qt; debería estar en <filename class=\"directory\">$<envar>QTDIR</envar>/doc/html</filename>."

