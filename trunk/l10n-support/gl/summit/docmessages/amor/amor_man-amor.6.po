#: man-amor.6.docbook:47
#, no-c-format
msgid ""
"More detailed user documentation is available from <ulink url=\"help:/amor\""
">help:/amor</ulink> (either enter this &URL; into &konqueror;, or run <"
"userinput><command>khelpcenter</command> <parameter>help:/amor</parameter><"
"/userinput>)."
msgstr ""
"Hai documentación de uso máis detallada en <ulink url=\"help:/amor\""
">help:/amor</ulink> (escriba o &URL; en &konqueror;, ou execute <userinput><"
"command>khelpcenter</command> <parameter>help:/amor</parameter></userinput>)."

