msgstr "<guimenu>Zona de xogo</guimenu> <guimenuitem>Nome da zona de xogo</guimenuitem>"

#. Tag: para
#. +> trunk5 stable5
#: index.docbook:494
#, no-c-format
msgid "<action>Switches to the playground</action>."
msgstr "<action>Vai á zona de xogo</action>."

#. Tag: para
#. +> trunk5 stable5
#: index.docbook:500
#, no-c-format
