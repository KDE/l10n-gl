#| msgid ""
#| "Kleopatra is a certificate manager and a universal crypto GUI. It "
#| "supports managing X.509 and OpenPGP certificates in the GpgSM keybox and "
#| "retrieving certificates from LDAP servers."
msgid ""
"Kleopatra is a certificate manager and a universal crypto GUI. It supports "
"managing OpenPGP and S/MIME certificates and encrypts files and text."
msgstr ""
"Kleopatra é un xestor de certificados e unha interface gráfica universal de "
"criptografía. Permite xestionar certificados X.509 e OpenPGP na caixa de "
"chaves GpgSM e obter certificados de servidores LDAP."

