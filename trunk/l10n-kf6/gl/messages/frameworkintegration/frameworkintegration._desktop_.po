#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "System Notifications"
msgstr "Notificacións do sistema."

#: plasma_workspace.notifyrc:35
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Lixo: Baleiro"

#: plasma_workspace.notifyrc:88
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Baleirouse o lixo."

#: plasma_workspace.notifyrc:145
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Completación de texto: rotación"

#: plasma_workspace.notifyrc:197
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Acadouse a fin da lista de coincidencias."

#: plasma_workspace.notifyrc:253
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Completación de texto: sen coincidencias"

#: plasma_workspace.notifyrc:305
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Non se atopou ningún acabamento."

#: plasma_workspace.notifyrc:361
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Completación de texto: coincidencia parcial"

#: plasma_workspace.notifyrc:413
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Hai máis dun posíbel acabamento."

#: plasma_workspace.notifyrc:470
msgctxt "Name"
msgid "Fatal Error"
msgstr "Erro fatal"

#: plasma_workspace.notifyrc:524
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Produciuse un erro grave que fixo que o programa saíse."

#: plasma_workspace.notifyrc:581
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: plasma_workspace.notifyrc:635
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Ocorreu algo especial no programa."

#: plasma_workspace.notifyrc:691
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#: plasma_workspace.notifyrc:745
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Produciuse un erro no programa que pode causar problemas."

#: plasma_workspace.notifyrc:802
msgctxt "Name"
msgid "Catastrophe"
msgstr "Catástrofe"

#: plasma_workspace.notifyrc:855
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr ""
"Produciuse un erro moi grave, que como mínimo fixo que o programa saíse."

#: plasma_workspace.notifyrc:911
msgctxt "Name"
msgid "Application Crash"
msgstr "Quebra dunha aplicación"

#: plasma_workspace.notifyrc:961
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Unha aplicación pechouse inesperadamente."

#: plasma_workspace.notifyrc:1013
msgctxt "Name"
msgid "Login"
msgstr "Acceso"

#: plasma_workspace.notifyrc:1066
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Iniciando unha nova sesión."

#: plasma_workspace.notifyrc:1122
msgctxt "Name"
msgid "Logout"
msgstr "Saír"

#: plasma_workspace.notifyrc:1175
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Estase a saír da sesión."

#: plasma_workspace.notifyrc:1232
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Cancelouse a saída"

#: plasma_workspace.notifyrc:1285
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Cancelouse a saída de Plasma."

#: plasma_workspace.notifyrc:1341
msgctxt "Name"
msgid "Print Error"
msgstr "Erro de impresión"

#: plasma_workspace.notifyrc:1395
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Produciuse un erro na impresión."

#: plasma_workspace.notifyrc:1452
msgctxt "Name"
msgid "Information Message"
msgstr "Mensaxe de información"

#: plasma_workspace.notifyrc:1506
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Está a amosarse unha mensaxe de información."

#: plasma_workspace.notifyrc:1563
msgctxt "Name"
msgid "Warning Message"
msgstr "Mensaxe de aviso"

#: plasma_workspace.notifyrc:1617
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Está a amosarse unha mensaxe de aviso."

#: plasma_workspace.notifyrc:1674
msgctxt "Name"
msgid "Critical Message"
msgstr "Mensaxe crítica"

#: plasma_workspace.notifyrc:1728
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Está a amosarse unha mensaxe crítica."

#: plasma_workspace.notifyrc:1785
msgctxt "Name"
msgid "Question"
msgstr "Pregunta"

#: plasma_workspace.notifyrc:1839
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Está a facerse unha pregunta."

#: plasma_workspace.notifyrc:1897
msgctxt "Name"
msgid "Beep"
msgstr "Badalada"

#: plasma_workspace.notifyrc:1950
msgctxt "Comment"
msgid "Sound bell"
msgstr "Badalada sonora."

#: plasma_workspace.notifyrc:2006
msgctxt "Name"
msgid "Widget failed to install"
msgstr "O trebello non puido instalarse"

#: plasma_workspace.notifyrc:2056
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "Non foi posíbel instalar un trebello."

#: plasma_workspace.notifyrc:2109
msgctxt "Name"
msgid "Widget deleted"
msgstr "Eliminouse o trebello"

#: plasma_workspace.notifyrc:2161
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Eliminouse un trebello."

#: plasma_workspace.notifyrc:2216
msgctxt "Name"
msgid "Device plugged in"
msgstr "Dispositivo conectado"

#: plasma_workspace.notifyrc:2254
msgctxt "Comment"
msgid "A device was plugged in"
msgstr "Conectouse un dispositivo."

#: plasma_workspace.notifyrc:2296
msgctxt "Name"
msgid "Device unplugged"
msgstr "Dispositivo desconectado"

#: plasma_workspace.notifyrc:2334
msgctxt "Comment"
msgid "A device was unplugged"
msgstr "Desconectouse un dispositivo."

#~ msgctxt "Comment"
#~ msgid "Plasma Workspace"
#~ msgstr "Espazo de traballo de Plasma."
