msgid "Smb4K"
msgstr "Smb4K"

#: core/smb4k.notifyrc:45 smb4k/org.kde.smb4k.desktop:81
msgctxt "Comment"
msgid "Advanced Network Neighborhood Browser"
msgstr "Navegador avanzado da veciñanza de rede."

#: core/smb4k.notifyrc:88
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: core/smb4k.notifyrc:130
msgctxt "Comment"
msgid "The user is notified about an action"
msgstr "O usuario recibe unha notificación sobre unha acción."

#: core/smb4k.notifyrc:171
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#: core/smb4k.notifyrc:213
msgctxt "Comment"
msgid "A warning is shown to the user"
msgstr "O usuario recibe un aviso."

#: core/smb4k.notifyrc:255
msgctxt "Name"
msgid "Error"
msgstr "Erro"

#: core/smb4k.notifyrc:297
msgctxt "Comment"
msgid "An error message is shown to the user"
msgstr "O usuario recibe unha mensaxe de erro."

#: core/smb4k.notifyrc:337
msgctxt "Name"
msgid "Share mounted"
msgstr "Montouse unha compartición"

#: core/smb4k.notifyrc:375
msgctxt "Comment"
msgid "A share has been mounted"
msgstr "Montouse unha compartición."

#: core/smb4k.notifyrc:417
msgctxt "Name"
msgid "Share unmounted"
msgstr "Desmontouse unha compartición"

#: core/smb4k.notifyrc:455
msgctxt "Comment"
msgid "A share has been unmounted"
msgstr "Desmontouse unha compartición."

#: core/smb4k.notifyrc:497
msgctxt "Name"
msgid "Shares mounted"
msgstr "Montáronse varias comparticións"

#: core/smb4k.notifyrc:535
msgctxt "Comment"
msgid "Multiple shares have been mounted"
msgstr "Montáronse varias comparticións."

#: core/smb4k.notifyrc:577
msgctxt "Name"
msgid "Shares unmounted"
msgstr "Desmontáronse varias comparticións"

#: core/smb4k.notifyrc:615
msgctxt "Comment"
msgid "Multiple shares have been unmounted"
msgstr "Desmontáronse varias comparticións."

#: core/smb4k.notifyrc:657
msgctxt "Name"
msgid "Migrating login credentials"
msgstr "Migrando as credenciais de acceso"

#: core/smb4k.notifyrc:686
msgctxt "Comment"
msgid ""
"The login credentials are migrated to the new format and the active password "
"manager"
msgstr ""
"As credenciais de acceso migráronse ao novo formato e ao xestor de "
"contrasinais activo."

#: core/smb4k.notifyrc:718
msgctxt "Name"
msgid "Mimetype not supported"
msgstr "O tipo MIME é incompatíbel"

#: core/smb4k.notifyrc:756
msgctxt "Comment"
msgid "The mimetype of the file that is to be printed is not supported"
msgstr "O tipo MIME do ficheiro para imprimir non é compatíbel."

#: core/smb4k.notifyrc:798
msgctxt "Name"
msgid "Bookmark exists"
msgstr "O marcador existe"

#: core/smb4k.notifyrc:836
msgctxt "Comment"
msgid "The bookmark exists"
msgstr "O marcador xa existe."

#: core/smb4k.notifyrc:879
msgctxt "Name"
msgid "Bookmark label in use"
msgstr "A etiqueta de marcador xa existe"

#: core/smb4k.notifyrc:917
msgctxt "Comment"
msgid "The label for the bookmark already exists"
msgstr "A etiqueta para o marcador xa existe."

#: core/smb4k.notifyrc:960
msgctxt "Name"
msgid "Mounting failed"
msgstr "A montaxe fallou"

#: core/smb4k.notifyrc:999
msgctxt "Comment"
msgid "Mounting a share failed"
msgstr "A montaxe dunha compartición fallou."

#: core/smb4k.notifyrc:1042
msgctxt "Name"
msgid "Unmounting failed"
msgstr "A desmontaxe fallou"

