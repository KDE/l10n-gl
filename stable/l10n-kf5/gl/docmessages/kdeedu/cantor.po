#. Tag: term
#: index.docbook:305
#, fuzzy, no-c-format
#| msgid "Typesetting using LaTeX"
msgid "Typesetting using &latex;"
msgstr "Composición mediante LaTeX"

#. Tag: para
#: index.docbook:307
#, fuzzy, no-c-format
#| msgid ""
#| "This setting changes the way results are presented to you. If enabled, it "
