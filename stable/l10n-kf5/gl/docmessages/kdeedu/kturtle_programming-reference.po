#~ "(*), e dividir (/). Aquí vai un exemplo no que se utilizan estas "
#~ "operacións:<screen>\n"
#~ "$a = 20 - 5\n"
#~ "$b = 15 * 2\n"
#~ "$c = 30 / 30\n"
#~ "$d = 1 + 1\n"
#~ "escrebe \"a: \" + $a + \", b: \" + $b + \", c: \" + $c + \" e d: \" + $d\n"
