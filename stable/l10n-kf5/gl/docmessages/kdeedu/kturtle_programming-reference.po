#~ "$a = 20 - 5\n"
#~ "$b = 15 * 2\n"
#~ "$c = 30 / 30\n"
#~ "$d = 1 + 1\n"
#~ "print \"a: \"+$a+\", b: \"+$b+\", c: \"+$c+\", d: \"+$d \n"
