msgstr "Existen dúas zonas na xanela principal:"

#. Tag: para
#: index.docbook:134
#, no-c-format
msgid "<quote>Playground</quote> area."
msgstr "A área da <quote>zona de xogo</quote>."

#. Tag: para
#: index.docbook:136
#, no-c-format
msgid ""
"<quote>Objects</quote> area, where you select objects to place on your "
"playground."
msgstr ""
"A área dos <quote>obxectos</quote>, na que se escollen os obxectos que se "
"queren colocar na zona de xogo."

