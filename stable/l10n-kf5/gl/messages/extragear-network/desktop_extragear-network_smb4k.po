msgctxt "Comment"
msgid "The credentials could not be read from the wallet"
msgstr "Non foi posíbel ler as credenciais da carteira."

#: core/smb4k.notifyrc:593
msgctxt "Name"
msgid "Mimetype not supported"
msgstr "O tipo MIME é incompatíbel"

#: core/smb4k.notifyrc:619
msgctxt "Comment"
msgid "The mimetype of the file that is to be printed is not supported"
msgstr "O tipo MIME do ficheiro para imprimir non é compatíbel."

#: core/smb4k.notifyrc:649
msgctxt "Name"
msgid "Bookmark exists"
msgstr "O marcador existe"

#: core/smb4k.notifyrc:675
msgctxt "Comment"
