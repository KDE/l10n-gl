msgstr "A sincronización dunha das comparticións cunha copia local fallou."

#: core/smb4k.notifyrc:1437
msgctxt "Name"
msgid "Searching failed"
msgstr "A busca fallou"

#: core/smb4k.notifyrc:1463
msgctxt "Comment"
msgid "Searching the network neighborhood failed"
msgstr "A busca na veciñanza de rede fallou."

#: core/smb4k.notifyrc:1494
msgctxt "Name"
msgid "Command not found"
