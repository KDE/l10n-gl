msgid "Retrieving the list of hosts belonging to a domain failed"
msgstr "Non foi posíbel obter a lista de servidores dun dominio."

#: core/smb4k.notifyrc:1011
msgctxt "Name"
msgid "Retrieving shares failed"
msgstr "Non foi posíbel obter as comparticións"

#: core/smb4k.notifyrc:1036
msgctxt "Comment"
msgid "Retrieving the list of shares provided by a host failed"
msgstr ""
"Non foi posíbel obter a lista de comparticións que fornece un servidor."

#: core/smb4k.notifyrc:1065
msgctxt "Name"
msgid "Retrieving preview failed"
msgstr "Non foi posíbel obter a vista previa"

#: core/smb4k.notifyrc:1089
msgctxt "Comment"
msgid "Retrieving the preview of a share failed"
msgstr "Non foi posíbel obter a vista previa dunha compartición."

#: core/smb4k.notifyrc:1118
msgctxt "Name"
msgid "Mounting failed"
msgstr "Non foi posíbel montar"

#: core/smb4k.notifyrc:1144
msgctxt "Comment"
msgid "Mounting a share failed"
msgstr "Non foi posíbel montar unha compartición."

#: core/smb4k.notifyrc:1174
msgctxt "Name"
msgid "Unmounting failed"
msgstr "Non foi posíbel desmontar"

#: core/smb4k.notifyrc:1201
msgctxt "Comment"
msgid "Unmounting a share failed"
msgstr "Non foi posíbel desmontar unha compartición."

#: core/smb4k.notifyrc:1231
msgctxt "Name"
msgid "Unmounting not allowed"
msgstr "Non ten permiso para desmontar"

#: core/smb4k.notifyrc:1256
msgctxt "Comment"
msgid "The unmounting of a certain share is not allowed"
msgstr "Non ten permiso para desmontar unha das comparticións."

#: core/smb4k.notifyrc:1286
msgctxt "Name"
msgid "Printing failed"
msgstr "Non foi posíbel imprimir"

#: core/smb4k.notifyrc:1312
msgctxt "Comment"
msgid "Printing on a network printer failed"
msgstr "Non foi posíbel imprimir usando unha das impresoras da rede."

#: core/smb4k.notifyrc:1341
msgctxt "Name"
msgid "Synchronization failed"
msgstr "Non foi posíbel sincronizar"

#: core/smb4k.notifyrc:1366
msgctxt "Comment"
msgid "The synchronization of a share and a local copy failed"
msgstr "Non foi posíbel sincronizar unha das comparticións cunha copia local."

#: core/smb4k.notifyrc:1395
msgctxt "Name"
msgid "Searching failed"
msgstr "Non foi posíbel buscar"

#: core/smb4k.notifyrc:1420
msgctxt "Comment"
msgid "Searching the network neighborhood failed"
msgstr "Non foi posíbel buscar na veciñanza de rede."

#: core/smb4k.notifyrc:1450
msgctxt "Name"
msgid "Command not found"
msgstr "Non se atopou unha orde"

#: core/smb4k.notifyrc:1475
msgctxt "Comment"
msgid "A required command could not be found"
msgstr "Non se atopou unha orde necesaria."

#: core/smb4k.notifyrc:1504
msgctxt "Name"
msgid "Cannot bookmark printer"
msgstr "Non é posíbel marcar unha impresora"

#: core/smb4k.notifyrc:1528
msgctxt "Comment"
msgid "A printer cannot be bookmarked"
msgstr "Non é posíbel engadir unha impresora aos marcadores."

#: core/smb4k.notifyrc:1557
msgctxt "Name"
msgid "File not found"
msgstr "Non se atopou un ficheiro"

#: core/smb4k.notifyrc:1584
msgctxt "Comment"
msgid "A file could not be found"
msgstr "Non foi posíbel atopar un ficheiro."

#: core/smb4k.notifyrc:1613
msgctxt "Name"
msgid "Opening file failed"
msgstr "Non foi posíbel abrir un ficheiro"

#: core/smb4k.notifyrc:1638
msgctxt "Comment"
msgid "A file could not be opened"
msgstr "Non foi posíbel abrir un ficheiro."

#: core/smb4k.notifyrc:1667
msgctxt "Name"
msgid "Reading file failed"
msgstr "Non foi posíbel ler un ficheiro"

#: core/smb4k.notifyrc:1691
msgctxt "Comment"
msgid "A file could not be read"
msgstr "Non foi posíbel ler un ficheiro."

#: core/smb4k.notifyrc:1720
msgctxt "Name"
msgid "mkdir failed"
msgstr "A execución de mkdir fallou"

#: core/smb4k.notifyrc:1744
msgctxt "Comment"
msgid "A directory could not be created"
msgstr "Non foi posíbel crear un directorio."

#: core/smb4k.notifyrc:1773
msgctxt "Name"
msgid "Process error"
msgstr "Erro no proceso"

#: core/smb4k.notifyrc:1801
msgctxt "Comment"
msgid "A process error occurred"
msgstr "Produciuse un erro no proceso."

#: core/smb4k.notifyrc:1830
msgctxt "Name"
msgid "Action failed"
msgstr "Unha acción fallou"

#: core/smb4k.notifyrc:1855
msgctxt "Comment"
msgid "A KAuth action failed"
msgstr "Unha acción de KAuth fallou."

#: core/smb4k.notifyrc:1884
msgctxt "Name"
msgid "Invalid URL"
msgstr "O URL é incorrecto"

#: core/smb4k.notifyrc:1911
msgctxt "Comment"
msgid "An invalid URL was passed"
msgstr "Forneceuse un URL incorrecto."

#: core/smb4k.notifyrc:1940
msgctxt "Name"
msgid "Broadcast areas empty"
msgstr "Ningunha zona de difusión"

#: core/smb4k.notifyrc:1964
msgctxt "Comment"
msgid "The entry of the broadcast areas is empty"
msgstr "A entrada de zonas de difusión está baleira."

