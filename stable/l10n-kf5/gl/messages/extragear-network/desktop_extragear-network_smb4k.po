msgid "The unmounting of a certain share is not allowed"
msgstr "Non ten permiso para desmontar unha das comparticións."

#: core/smb4k.notifyrc:1324
msgctxt "Name"
msgid "Printing failed"
msgstr "A impresión fallou"

#: core/smb4k.notifyrc:1351
msgctxt "Comment"
msgid "Printing on a network printer failed"
msgstr "A impresión usando unha das impresoras da rede fallou."

#: core/smb4k.notifyrc:1381
msgctxt "Name"
msgid "Synchronization failed"
msgstr "A sincronización fallou"

#: core/smb4k.notifyrc:1407
msgctxt "Comment"
