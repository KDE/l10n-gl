#: core/smb4k.notifyrc:68
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: core/smb4k.notifyrc:100
msgctxt "Comment"
msgid "The user is notified about an action"
msgstr "O usuario recibe unha notificación sobre unha acción."

#: core/smb4k.notifyrc:130
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#: core/smb4k.notifyrc:162
msgctxt "Comment"
