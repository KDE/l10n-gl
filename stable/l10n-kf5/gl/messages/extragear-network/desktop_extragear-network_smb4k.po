#: core/smb4k.notifyrc:3 smb4k/org.kde.smb4k.desktop:3
msgctxt "Name"
msgid "Smb4K"
msgstr "Smb4K"

#: core/smb4k.notifyrc:36 smb4k/org.kde.smb4k.desktop:65
msgctxt "Comment"
msgid "Advanced Network Neighborhood Browser"
msgstr "Navegador avanzado da veciñanza de rede"

#: core/smb4k.notifyrc:68
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: core/smb4k.notifyrc:100
msgctxt "Comment"
msgid "The user is notified about an action"
msgstr "O usuario recibe unha notificación dunha acción."

#: core/smb4k.notifyrc:130
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#: core/smb4k.notifyrc:162
msgctxt "Comment"
msgid "A warning is shown to the user"
msgstr "O usuario recibe un aviso."

#: core/smb4k.notifyrc:193
msgctxt "Name"
msgid "Error"
msgstr "Erro"

#: core/smb4k.notifyrc:225
msgctxt "Comment"
msgid "An error message is shown to the user"
msgstr "O usuario recibe unha mensaxe de erro."

#: core/smb4k.notifyrc:255
msgctxt "Name"
msgid "Share mounted"
msgstr "Montouse unha compartición"

#: core/smb4k.notifyrc:280
msgctxt "Comment"
