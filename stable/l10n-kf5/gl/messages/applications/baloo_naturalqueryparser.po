#: naturalfilequeryparser.cpp:49
#, kde-format
msgctxt "Numeric rating of a resource"
msgid "rated as $1;rated $1;score is $1;score|scored $1;having $1 stars|star"
msgstr ""
"con $1 estrela|estrelas;que teña $1 estrela|estrelas;puntuado con $1 estrela|"
"estrelas;cualificado con $1 estrela|estrelas;valorado con $1 estrela|estrelas"

#: naturalfilequeryparser.cpp:50
#, kde-format
msgid "Rating (0 to 10)"
msgstr "Cualificación (de 0 a 10)"

#: naturalfilequeryparser.cpp:53
#, kde-format
msgctxt "Comment of a resource"
msgid ""
"described as $1;description|comment is $1;described|description|comment $1"
msgstr "descrito como $1;con $1 de descrición|comentario"

#: naturalfilequeryparser.cpp:54
#, kde-format
msgid "Comment or description"
msgstr "Comentario ou descrición"

#: naturalfilequeryparser.cpp:59
#, kde-format
msgctxt "Author of a document"
msgid "written|created|composed by $1;author is $1;by $1"
msgstr ""
"escrito|creado|composto por $1;obra|traballo de $1;o autor é $1;a autora é "
"$1;de $1"

#: naturalfilequeryparser.cpp:60
#, kde-format
msgid "Author"
msgstr "Autor"

#: naturalfilequeryparser.cpp:63
#, kde-format
msgctxt "Size of a file"
msgid "size is $1;size $1;being $1 large;$1 large"
msgstr "o tamaño é $1;de tamaño $1;$1 de tamaño"

#: naturalfilequeryparser.cpp:64
#, kde-format
msgid "Size"
msgstr "Tamaño"

#: naturalfilequeryparser.cpp:67
#, kde-format
msgctxt "Name of a file or contact"
msgid "name is $1;name $1;named $1"
msgstr ""
"nomeada|nomeado|chamada|chamado $1;coñecida|coñecido como $1;con $1 de nome;"
"con nome $1"

#: naturalfilequeryparser.cpp:68
#, kde-format
msgid "Name"
msgstr "Nome"

#: naturalfilequeryparser.cpp:71
#, kde-format
msgctxt "Date of creation"
msgid ""
"created|dated at|on|in|of $1;created|dated $1;creation date|time|datetime is "
"$1"
msgstr ""
"creado|iniciado|xerado a|en|no|o $1;con data de|do $1;con data $1;con data|"
"hora de creación|xeración $1;con data e hora de creación|xeración $1;con "
"hora e data de creación|xeración $1"

#: naturalfilequeryparser.cpp:72
#, kde-format
msgid "Date of creation"
msgstr "Data de creación"

#: naturalfilequeryparser.cpp:75
#, kde-format
msgctxt "Date of last modification"
msgid ""
"modified|edited at|on $1;modified|edited $1;modification|edition date|time|"
"datetime is $1"
msgstr ""
"cambiado|editado|modificado|mudado a|en|no|o $1;cambiado|editado|modificado|"
"mudado por última vez a|en|no|o $1;cambiado|editado|modificado|mudado por "
"vez última a|en|no|o $1;con data|hora de cambio|edición|modificación|mudanza "
"$1;con data e hora de cambio|edición|modificación|mudanza $1;con hora e data "
"de cambio|edición|modificación|mudanza $1;con data|hora de último cambio $1;"
"con data e hora de último cambio $1;con hora e data de último cambio $1;con "
"data|hora de última edición|modificación|mudanza $1;con data e hora de "
"última edición|modificación|mudanza $1;con hora e data de última edición|"
"modificación|mudanza $1"

#: naturalfilequeryparser.cpp:76
#, kde-format
msgid "Date of last modification"
msgstr "Data da última modificación"

#: naturalfilequeryparser.cpp:81
#, kde-format
msgctxt "A document is associated with a tag"
msgid "tagged as $1;has tag $1;tag is $1;# $1"
msgstr ""
"etiquetado como $1;etiquetado con $1;etiquetado $1;coa etiqueta $1;# $1"

#: naturalfilequeryparser.cpp:82
#, kde-format
msgid "Tag name"
msgstr "Nome da etiqueta"

#: naturalfilequeryparser.cpp:86
#, kde-format
msgctxt ""
"$1 is a property name (non-translatable unfortunately) and $2 is the value "
"against which the property is matched. Note that the equal/greater/smaller "
"sign has already been folded in $2"
msgid "$1 is $2;$1 $2"
msgstr "$1 é $2;a $1 é $2;o $1 é $2;$1 $2"

#: naturalfilequeryparser.cpp:87
#, kde-format
msgid "File property"
msgstr "Propiedade do ficheiro"

#: naturalqueryparser.cpp:82
#, kde-format
msgctxt ""
"Characters that are kept in the query for further processing but are "
"considered word boundaries"
msgid ".,;:!?()[]{}<>=#+-"
msgstr ".,;:!?()[]{}<>=#+-"

#: naturalqueryparser.cpp:197
#, kde-format
msgctxt "Adding an offset to a period of time ($1=period, $2=offset)"
msgid "in $2 $1"
msgstr "dentro de $2 $1;en $2 $1;$2 $1 máis tarde"

#: naturalqueryparser.cpp:200
#, kde-format
msgctxt "Removing an offset from a period of time ($1=period, $2=offset)"
msgid "$2 $1 ago"
msgstr "hai $2 $1;$2 $1 antes"

#: naturalqueryparser.cpp:204
#, kde-format
msgctxt "In one day"
msgid "tomorrow"
msgstr "mañá"

#: naturalqueryparser.cpp:205
#, kde-format
msgid "Tomorrow"
msgstr "Mañá"

#: naturalqueryparser.cpp:208
#, kde-format
msgctxt "One day ago"
msgid "yesterday"
msgstr "onte"

#: naturalqueryparser.cpp:209
#, kde-format
msgid "Yesterday"
msgstr "Onte"

#: naturalqueryparser.cpp:212
#, kde-format
msgctxt "The current day"
msgid "today"
msgstr "hoxe"

#: naturalqueryparser.cpp:213
#, kde-format
msgid "Today"
msgstr "Hoxe"

#: naturalqueryparser.cpp:217
#, kde-format
msgctxt "First period (first day, month, etc)"
msgid "first $1"
msgstr "a primeira $1;o primeiro $1"

#: naturalqueryparser.cpp:218
#, kde-format
msgid "First week, month, day, ..."
msgstr "Primeira semana, mes, día, etc."

#: naturalqueryparser.cpp:221
#, kde-format
msgctxt "Last period (last day, month, etc)"
msgid "last $1 of"
msgstr "a última $1 de;o último $1 de"

#: naturalqueryparser.cpp:222
#, kde-format
msgid "Last week, month, day, ..."
msgstr "Última semana, mes, día, etc."

#: naturalqueryparser.cpp:225
#, kde-format
msgctxt ""
"Setting the value of a period, as in 'third week' ($1=period, $2=value)"
msgid "$2 $1"
msgstr "$2 $1"

#: naturalqueryparser.cpp:229
#, kde-format
msgctxt "Adding 1 to a period of time"
msgid "next $1"
msgstr "a seguinte $1;a $1 seguinte;o seguinte $1;o $1 seguinte"

#: naturalqueryparser.cpp:230
#, kde-format
msgid "Next week, month, day, ..."
msgstr "Seguinte semana, mes, día, etc."

#: naturalqueryparser.cpp:233
#, kde-format
msgctxt "Removing 1 to a period of time"
msgid "last $1"
msgstr "a anterior $1;a $1 anterior;o anterior $1;o $1 anterior"

#: naturalqueryparser.cpp:234
#, kde-format
msgid "Previous week, month, day, ..."
msgstr "Anterior semana, mes, día, etc."

#: naturalqueryparser.cpp:239
#, kde-format
msgctxt "An hour ($5) and an optional minute ($6), PM"
msgid "at $5 :|\\. $6 pm;at $5 h pm;at $5 pm;$5 : $6 pm;$5 h pm;$5 pm"
msgstr ""
"ás $5 : $6 pm;ás $5 : $6 da tarde|noite;ás $5 pm;ás $5 da tarde|noite;ás $5 "
"horas pm;ás $5 horas da tarde|noite;$5 : $6 pm;$5 : $6 da tarde|noite;$5 pm;"
"$5 da tarde|noite;$5 horas pm;$5 horas da tarde|noite"

#: naturalqueryparser.cpp:240
#, kde-format
msgid "A time after midday"
msgstr "Unha hora a partir do mediodía."

#: naturalqueryparser.cpp:243
#, kde-format
msgctxt "An hour ($5) and an optional minute ($6), AM"
msgid ""
"at $5 :|\\. $6 am;at $5 \\. $6;at $5 h am;at $5 am;at $5;$5 :|\\. $6 am;$5 : "
"$6 : $7;$5 : $6;$5 h am;$5 h;$5 am"
msgstr ""
"ás $5 : $6 am;ás $5 : $6 da madrugada|mañá;ás $5 am;ás $5 da madrugada|mañá;"
"ás $5 horas am;ás $5 horas da madrugada|mañá;$5 : $6 am;$5 : $6 da madrugada|"
"mañá;$5 am;$5 da madrugada|mañá;$5 horas am;$5 horas da madrugada|mañá"

#: naturalqueryparser.cpp:244
#, kde-format
msgid "A time"
msgstr "Unha hora."

#: naturalqueryparser.cpp:249
#, kde-format
msgctxt ""
"A year ($1), month ($2), day ($3), day of week ($4), hour ($5), minute ($6), "
"second ($7), in every combination supported by your language"
msgid ""
"$3 of $2 $1;$3 st|nd|rd|th $2 $1;$3 st|nd|rd|th of $2 $1;$3 of $2;$3 st|nd|"
"rd|th $2;$3 st|nd|rd|th of $2;$2 $3 st|nd|rd|th;$2 $3;$2 $1;$1 - $2 - $3;$1 "
"- $2;$3 / $2 / $1;$3 / $2;in $2 $1; in $1;, $1"
msgstr ""
"$3 de $2 de|do $1;a|en|no|o $3 de $2 de|do $1;$3 / $2 / $1;a|en|no|o $3 / "
"$2 / $1;$1-$2-$3;a|en|no|o $1-$2-$3;$3 de $2;a|en|no|o $3 de $2;$2 de|do $1;"
"en $2 de|do $1;en|no $1"

#: naturalqueryparser.cpp:260
#, kde-format
msgctxt "Decimal values with an integer ($1) and decimal ($2) part"
msgid "$1 \\. $2"
msgstr "$1 , $2"

#: naturalqueryparser.cpp:261
#, kde-format
msgid "A decimal value"
msgstr "Un valor decimal."

#: naturalqueryparser.cpp:267
#, kde-format
msgctxt "Equality"
msgid "contains|containing $1"
msgstr "contén $1;que contén $1"

#: naturalqueryparser.cpp:268
#, kde-format
msgid "Containing"
msgstr "Que contén."

#: naturalqueryparser.cpp:271
#, kde-format
msgctxt "Strictly greater"
msgid "greater|bigger|more than $1;at least $1;> $1"
msgstr ""
"maior|máis|meirande|mor ca|de|que $1;superior a $1;por enriba|riba de $1;"
"máis alta|alto|grande ca|de|que $1;> $1"

#: naturalqueryparser.cpp:272
#, kde-format
msgid "Greater than"
msgstr "Maior que."

#: naturalqueryparser.cpp:274
#, kde-format
msgctxt "After in time"
msgid "after|since $1"
msgstr ""
"despois da|das|de|do $1;desde a|as|o $1;desde $1;a partir da|das|de|do $1"

#: naturalqueryparser.cpp:275
#, kde-format
msgid "After"
msgstr "Despois."

#: naturalqueryparser.cpp:278
#, kde-format
msgctxt "Strictly smaller"
msgid "smaller|less|lesser than $1;at most $1;< $1"
msgstr ""
"menor|menos ca|de|que $1;inferior a $1;por baixo|debaixo|embaixo de $1;máis "
"baixa|baixo|pequeno ca|de|que $1;< $1"

#: naturalqueryparser.cpp:279
#, kde-format
msgid "Smaller than"
msgstr "Menor que."

#: naturalqueryparser.cpp:281
#, kde-format
msgctxt "Before in time"
msgid "before|until $1"
msgstr "antes da|das|de|do $1;ata a|as|o $1;ata $1;"

#: naturalqueryparser.cpp:282
#, kde-format
msgid "Before"
msgstr "Antes."

#: naturalqueryparser.cpp:285
#, kde-format
msgctxt "Equality"
msgid "equal|equals|= $1;equal to $1"
msgstr "equal|equals|= $1;equal to $1 é igual a $1;= $1;igual a $1;é $1"

#: naturalqueryparser.cpp:286
#, kde-format
msgid "Equal to"
msgstr "Igual a"

