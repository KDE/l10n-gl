#: updater/UpdaterWidget.cpp:72
#, kde-format
msgctxt "@label"
msgid ""
"<em>Some packages were not marked for update.</em><p/>The update of these "
"packages need some others to be installed or removed.<p/>Do you want to "
"update those too?"
msgstr ""
"<em>Algúns paquetes non estaban marcados para actualizar.</em> <p/> Para "
"actualizalos é necesario eliminar ou instalar outros.<p/>Quere actualizar "
"tamén esoutros?"

