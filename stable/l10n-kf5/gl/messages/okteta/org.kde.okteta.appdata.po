#. (itstool) path: component/name
#: org.kde.okteta.appdata.xml:6
msgid "Okteta"
msgstr "Okteta"

#. (itstool) path: component/summary
#: org.kde.okteta.appdata.xml:7
msgid "Hex editor"
msgstr "Editor de bytes"

#. (itstool) path: description/p
#: org.kde.okteta.appdata.xml:9
msgid "Okteta is a simple editor for the raw data of files."
msgstr "Okteta é un editor sinxelo para os datos en bruto de ficheiros."

#. (itstool) path: description/p
#: org.kde.okteta.appdata.xml:10
msgid "Features:"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:12
msgid ""
"Values and characters shown either in two columns (the traditional display "
"in hex editors) or in rows with the value on top of the character"
msgstr ""
"Os valores e caracteres poden mostrarse tanto en dúas columnas (a vista "
"tradicional de editores de bytes) como en filas cos valores sobre os "
"caracteres."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:13
msgid "Editing and navigating similar to a text editor"
msgstr ""
"Permite editar e examinar de maneira similar a un editor de texto simple."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:14
msgid "Customizable data views, with loadable and storable profiles"
msgstr ""
"As vistas de datos poden personalizarse, e poden cargarse e almacenarse "
"perfís."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:15
msgid "Tools dockable on all sides or floating"
msgstr ""
"As ferramentas poden acoplarse por toda a interface ou quedar flotando sobre "
"ela."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:16
msgid "Numerical encodings: Hexadecimal, Decimal, Octal, Binary"
msgstr ""
"Pode mostrar os valores numéricos en notacións hexadecimal, decimal, octal e "
"binaria."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:17
msgid "Character encodings: All 8-bit encodings as supplied by Qt, EBCDIC"
msgstr ""
"Pode mostrar os caracteres en todas as codificacións baseadas en 8 bits que "
"fornece Qt, así como en EBCDIC."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:18
msgid "Fast data rendering on screen"
msgstr "Os datos móstranse rapidamente na pantalla."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:19
msgid "Multiple open files"
msgstr "Poden abrirse varios ficheiros de maneira simultánea."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:20
msgid "Undo/redo support"
msgstr "Permite desfacer e refacer operacións."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:21
msgid ""
"Structures tool for analyzing and editing based on user-creatable structure "
"definitions"
msgstr ""
"Ferramenta de estruturas para analizar e editar baseándose en definicións de "
"estruturas creadas polo usuario."

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:22
msgid "And more..."
msgstr "E máis…"
