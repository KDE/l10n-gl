#: src/kdesvnd/kdesvnd.desktop:3
msgctxt "Name"
msgid "kdesvnd subversion module"
msgstr "Módulo de Subversion kdesvnd"

#: src/kdesvnd/kdesvnd.desktop:37
msgctxt "Comment"
msgid "Gives various Subversion actions to file managers and other software"
msgstr ""
"Fornece varias accións de Subversion aos xestores de ficheiros e outros "
"programas."

#: src/kdesvnd/kdesvn_subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion (kdesvn)"
msgstr "Subversion (kdesvn)"

#: src/kdesvnd/kdesvn_subversion.desktop:41
msgctxt "Name"
msgid "Subversion log (last 100)"
msgstr "Rexistro de Subversion (últimos 100)"

#: src/kdesvnd/kdesvn_subversion.desktop:76
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:43
msgctxt "Comment"
msgid "Displays the Subversion log"
msgstr "Amosa o rexistro de Subversion."

#: src/kdesvnd/kdesvn_subversion.desktop:111
msgctxt "Name"
msgid "Detailed Subversion info"
msgstr "Información detallada de Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:148
msgctxt "Name"
msgid "Add to Repository"
msgstr "Engadir ao repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:187
msgctxt "Name"
msgid "Check for unversioned items"
msgstr "Comprobar se hai elementos alleos"

#: src/kdesvnd/kdesvn_subversion.desktop:223
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Eliminar do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:260
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Anular os cambios locais"

#: src/kdesvnd/kdesvn_subversion.desktop:295
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Retira os cambios feitos a nivel local. Atención, isto non pode desfacerse."

#: src/kdesvnd/kdesvn_subversion.desktop:330
msgctxt "Name"
msgid "Rename..."
msgstr "Renomear…"

#: src/kdesvnd/kdesvn_subversion.desktop:366
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Renomea un ficheiro tanto localmente como no repositorio. Use isto en vez de "
"engadir e eliminar o ficheiro para renomear."

#: src/kdesvnd/kdesvn_subversion.desktop:401
msgctxt "Name"
msgid "Import Repository"
msgstr "Importar un repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:436
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr ""
"Pon o cartafol nun repositorio existente para pólo baixo control de versións."

#: src/kdesvnd/kdesvn_subversion.desktop:471
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:78
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Obter do repositorio…"

#: src/kdesvnd/kdesvn_subversion.desktop:506
#: src/kdesvnd/kdesvn_subversion.desktop:1032
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:113
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:321
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Obtén todos os ficheiros dun repositorio existente para este cartafol."

#: src/kdesvnd/kdesvn_subversion.desktop:541
msgctxt "Name"
msgid "Switch..."
msgstr "Cambiar…"

#: src/kdesvnd/kdesvn_subversion.desktop:575
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Cambiar a copia de traballo indicada a outra rama."

#: src/kdesvnd/kdesvn_subversion.desktop:611
msgctxt "Name"
msgid "Merge..."
msgstr "Fusionar…"

#: src/kdesvnd/kdesvn_subversion.desktop:646
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Fusiona os cambios entre esta galla e outra"

#: src/kdesvnd/kdesvn_subversion.desktop:682
msgctxt "Name"
msgid "Blame..."
msgstr "Autorías…"

#: src/kdesvnd/kdesvn_subversion.desktop:716
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Consulta quen escribiu unha liña dada no ficheiro e en que versión"

#: src/kdesvnd/kdesvn_subversion.desktop:752
msgctxt "Name"
msgid "Create Patch..."
msgstr "Crear un parche…"

#: src/kdesvnd/kdesvn_subversion.desktop:789
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:148
msgctxt "Name"
msgid "Export..."
msgstr "Exportar…"

#: src/kdesvnd/kdesvn_subversion.desktop:825
#: src/kdesvnd/kdesvn_subversion.desktop:1101
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:184
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:390
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "Obtén unha copia sen control de versións dunha árbore do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:860
msgctxt "Name"
msgid "Diff (local)"
msgstr "Diferenzas (local)"

#: src/kdesvnd/kdesvn_subversion.desktop:895
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Mostra os cambios locais desde a última actualización"

#: src/kdesvnd/kdesvn_subversion.desktop:930
msgctxt "Name"
msgid "KDESvn Update"
msgstr "Actualizar con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:965
msgctxt "Name"
msgid "KDESvn Commit"
msgstr "Remitir con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:999
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:288
msgctxt "Name"
msgid "Checkout from a repository..."
msgstr "Obter dun repositorio…"

#: src/kdesvnd/kdesvn_subversion.desktop:1067
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:356
msgctxt "Name"
msgid "Export from a Subversion repository..."
msgstr "Exportar dun repositorio de Subversion…"

#: src/kdesvnd/kdesvn_subversion.desktop:1136
msgctxt "Name"
msgid "Display revision tree"
msgstr "Amosar a árbore de revisións"

#: src/kdesvnd/kdesvn_subversion.desktop:1170
msgctxt "Comment"
msgid "Show complete revision tree"
msgstr "Amosar a árbore de revisións completa."

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:9
msgctxt "Name"
msgid "kdesvn log (last 100)"
msgstr "Rexistro de kdesvn (últimos 100)"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:219
msgctxt "Name"
msgid "Update (Kdesvn)"
msgstr "Actualizar con Kdesvn"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:254
msgctxt "Name"
msgid "Commit (Kdesvn)"
msgstr "Remitir con Kdesvn"

#: src/kdesvn.notifyrc:3
msgctxt "Comment"
msgid "Kdesvn notification"
msgstr "Notificación de Kdesvn"

#: src/kdesvn.notifyrc:38
msgctxt "Name"
msgid "Kdesvn KIO Notification"
msgstr "Notificación de KIO de Kdesvn"

#: src/kdesvn.notifyrc:74
msgctxt "Name"
msgid "Kdesvn task notification"
msgstr "Notificación de tarefa de Kdesvn"

#: src/kdesvnpart.desktop:2
msgctxt "Name"
msgid "kdesvnpart"
msgstr "kdesvnpart"

#: src/kdesvnpart.desktop:37
msgctxt "GenericName"
msgid "SVN Client"
msgstr "Cliente de Subversion"

#: src/kdesvnpart.desktop:76 src/org.kde.kdesvn.desktop:73
msgctxt "Comment"
msgid "A Subversion client by KDE"
msgstr "Un cliente de Subversion fornecido por KDE."

