#: src/kdesvnd/kdesvnd.desktop:3
msgctxt "Name"
msgid "kdesvnd subversion module"
msgstr "Módulo de Subversion kdesvnd"

#: src/kdesvnd/kdesvnd.desktop:38
msgctxt "Comment"
msgid "Gives various Subversion actions to file managers and other software"
msgstr ""
"Fornece varias accións de Subversion aos xestores de ficheiros e outros "
"programas."

#: src/kdesvnd/kdesvn_subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion (kdesvn)"
msgstr "Subversion (kdesvn)"

#: src/kdesvnd/kdesvn_subversion.desktop:42
msgctxt "Name"
msgid "Subversion log (last 100)"
msgstr "Rexistro de Subversion (últimos 100)"

#: src/kdesvnd/kdesvn_subversion.desktop:78
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:44
msgctxt "Comment"
msgid "Displays the Subversion log"
msgstr "Amosa o rexistro de Subversion."

#: src/kdesvnd/kdesvn_subversion.desktop:114
msgctxt "Name"
msgid "Detailed Subversion info"
msgstr "Información detallada de Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:152
msgctxt "Name"
msgid "Add to Repository"
msgstr "Engadir ao repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:192
msgctxt "Name"
msgid "Check for unversioned items"
msgstr "Comprobar se hai elementos alleos"

#: src/kdesvnd/kdesvn_subversion.desktop:229
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Eliminar do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:267
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Anular os cambios locais"

#: src/kdesvnd/kdesvn_subversion.desktop:303
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Retira os cambios feitos a nivel local. Atención, isto non pode desfacerse."

#: src/kdesvnd/kdesvn_subversion.desktop:339
msgctxt "Name"
msgid "Rename..."
msgstr "Renomear…"

#: src/kdesvnd/kdesvn_subversion.desktop:376
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Renomea un ficheiro tanto localmente como no repositorio. Use isto en vez de "
"engadir e eliminar o ficheiro para renomear."

#: src/kdesvnd/kdesvn_subversion.desktop:412
msgctxt "Name"
msgid "Import Repository"
msgstr "Importar un repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:448
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr ""
"Pon o cartafol nun repositorio existente para pólo baixo control de versións."

#: src/kdesvnd/kdesvn_subversion.desktop:484
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:80
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Obter do repositorio…"

#: src/kdesvnd/kdesvn_subversion.desktop:520
#: src/kdesvnd/kdesvn_subversion.desktop:1061
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:116
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:330
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Obtén todos os ficheiros dun repositorio existente para este cartafol."

#: src/kdesvnd/kdesvn_subversion.desktop:556
msgctxt "Name"
msgid "Switch..."
msgstr "Cambiar…"

#: src/kdesvnd/kdesvn_subversion.desktop:591
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Cambiar a copia de traballo indicada a outra rama."

#: src/kdesvnd/kdesvn_subversion.desktop:628
msgctxt "Name"
msgid "Merge..."
msgstr "Fusionar…"

#: src/kdesvnd/kdesvn_subversion.desktop:664
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Fusiona os cambios entre esta galla e outra"

#: src/kdesvnd/kdesvn_subversion.desktop:701
msgctxt "Name"
msgid "Blame..."
msgstr "Autorías…"

#: src/kdesvnd/kdesvn_subversion.desktop:736
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Consulta quen escribiu unha liña dada no ficheiro e en que versión"

#: src/kdesvnd/kdesvn_subversion.desktop:773
msgctxt "Name"
msgid "Create Patch..."
msgstr "Crear un parche…"

#: src/kdesvnd/kdesvn_subversion.desktop:811
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:152
msgctxt "Name"
msgid "Export..."
msgstr "Exportar…"

#: src/kdesvnd/kdesvn_subversion.desktop:848
#: src/kdesvnd/kdesvn_subversion.desktop:1132
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:189
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:401
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "Obtén unha copia sen control de versións dunha árbore do repositorio"

#: src/kdesvnd/kdesvn_subversion.desktop:884
msgctxt "Name"
msgid "Diff (local)"
msgstr "Diferenzas (local)"

#: src/kdesvnd/kdesvn_subversion.desktop:920
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Mostra os cambios locais desde a última actualización"

#: src/kdesvnd/kdesvn_subversion.desktop:956
msgctxt "Name"
msgid "KDESvn Update"
msgstr "Actualizar con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:992
msgctxt "Name"
msgid "KDESvn Commit"
msgstr "Remitir con KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:1027
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:296
msgctxt "Name"
msgid "Checkout from a repository..."
msgstr "Obter dun repositorio…"

#: src/kdesvnd/kdesvn_subversion.desktop:1097
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:366
msgctxt "Name"
msgid "Export from a Subversion repository..."
msgstr "Exportar dun repositorio de Subversion…"

#: src/kdesvnd/kdesvn_subversion.desktop:1168
msgctxt "Name"
msgid "Display revision tree"
msgstr "Amosar a árbore de revisións"

#: src/kdesvnd/kdesvn_subversion.desktop:1203
msgctxt "Comment"
msgid "Show complete revision tree"
msgstr "Amosar a árbore de revisións completa."

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:9
msgctxt "Name"
msgid "kdesvn log (last 100)"
msgstr "Rexistro de kdesvn (últimos 100)"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:225
msgctxt "Name"
msgid "Update (Kdesvn)"
msgstr "Actualizar con Kdesvn"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:261
msgctxt "Name"
msgid "Commit (Kdesvn)"
msgstr "Remitir con Kdesvn"

#: src/kdesvn.notifyrc:3
msgctxt "Comment"
msgid "Kdesvn notification"
msgstr "Notificación de Kdesvn"

#: src/kdesvn.notifyrc:39
msgctxt "Name"
msgid "Kdesvn KIO Notification"
msgstr "Notificación de KIO de Kdesvn"

#: src/kdesvn.notifyrc:76
msgctxt "Name"
msgid "Kdesvn task notification"
msgstr "Notificación de tarefa de Kdesvn"

#: src/kdesvnpart.desktop:2
msgctxt "Name"
msgid "kdesvnpart"
msgstr "kdesvnpart"

#: src/kdesvnpart.desktop:38
msgctxt "GenericName"
msgid "SVN Client"
msgstr "Cliente de Subversion"

#: src/kdesvnpart.desktop:78 src/org.kde.kdesvn.desktop:75
msgctxt "Comment"
msgid "A Subversion client by KDE"
msgstr "Un cliente de Subversion de KDE."

