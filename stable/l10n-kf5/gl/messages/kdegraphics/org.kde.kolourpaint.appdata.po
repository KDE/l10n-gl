#. (itstool) path: component/name
#: org.kde.kolourpaint.appdata.xml:6
msgid "KolourPaint"
msgstr "KolourPaint"

#. (itstool) path: component/summary
#: org.kde.kolourpaint.appdata.xml:7
msgid "Paint Program"
msgstr "Programa para pintar"

#. (itstool) path: description/p
#: org.kde.kolourpaint.appdata.xml:9
msgid ""
"KolourPaint is a simple painting program to quickly create raster images. It "
"is useful as a touch-up tool and simple image editing tasks."
msgstr ""
"KolourPaint é un programa para pintar sinxelo que permite crear imaxes de "
"mapa de bits rapidamente. É útil como ferramenta de retoque e para realizar "
"tarefas sinxelas de edición de imaxes."

#. (itstool) path: description/p
#: org.kde.kolourpaint.appdata.xml:13
msgid "Features:"
msgstr "Funcionalidades:"

#. (itstool) path: ul/li
#: org.kde.kolourpaint.appdata.xml:15
msgid ""
"Support for drawing various shapes - lines, rectangles, rounded rectangles, "
"ovals and polygons"
msgstr ""
"Permite debuxar varias formas: liñas, rectángulos, rectángulos arredondados, "
"óvalos e polígonos."

#. (itstool) path: ul/li
#: org.kde.kolourpaint.appdata.xml:16
msgid "Curves, lines and text"
msgstr "Curvas, liñas e texto."

#. (itstool) path: ul/li
#: org.kde.kolourpaint.appdata.xml:17
msgid "Colour picker"
msgstr "Selector de cor"

#. (itstool) path: ul/li
#: org.kde.kolourpaint.appdata.xml:18
msgid "Selections"
msgstr "Seleccións"

#. (itstool) path: ul/li
#: org.kde.kolourpaint.appdata.xml:19
