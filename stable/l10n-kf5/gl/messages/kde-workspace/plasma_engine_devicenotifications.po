#: ksolidnotify.cpp:116
#, fuzzy, kde-format
#| msgid "Could not mount this device."
msgid "Could not mount the following device: %1"
msgstr "Non foi posíbel montar o dispositivo."

#: ksolidnotify.cpp:164
#, kde-format
msgid ""
"Could not safely remove the following device: %1\n"
"One or more files on this device are open within an application"
msgstr ""
"Non foi posíbel retirar con seguranza o seguinte dispositivo: %1\n"
"Hai aberto polo menos un ficheiros deste dispositivo nalgún programa."

#: ksolidnotify.cpp:166
#, kde-format
msgid ""
"Could not safely remove the following device: %1\n"
"One or more files on this device are opened in application \"%3\"\n"
"Please close it and try again"
msgid_plural ""
"Could not safely remove the following device: %1\n"
"One or more files on this device are opened in following applications: %3\n"
"Please close it and try again"
msgstr[0] ""
"Non foi posíbel retirar con seguranza o seguinte dispositivo: %1\n"
"Hai aberto polo menos un ficheiros deste dispositivo no programa «%3».\n"
"Peche dito programa e volva intentalo."
msgstr[1] ""
"Non foi posíbel retirar con seguranza o seguinte dispositivo: %1\n"
"Hai aberto polo menos un ficheiros deste dispositivo nos seguintes "
"programas: %3.\n"
"Peche ditos programas e volva intentalo."

#: ksolidnotify.cpp:168 ksolidnotify.cpp:211
msgctxt "separator in list of apps blocking device unmount"
msgid ", "
msgstr ", "

#: ksolidnotify.cpp:177
#, kde-format
msgctxt ""
"The term \"remove\" here means \"physically disconnect the device from the "
"computer\", whereas \"safely\" means \"without risk of data loss\""
msgid "The following device can now be safely removed: %1"
msgstr "O seguinte dispositivo pode retirarse con seguranza: %1"

