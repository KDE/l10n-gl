#: powerdevil.notifyrc:49
msgctxt "Comment"
msgid "Power Management System"
msgstr "Sistema de xestión da enerxía"

#: powerdevil.notifyrc:98
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#: powerdevil.notifyrc:144
msgctxt "Comment"
msgid "Used for warning notifications"
msgstr "Emprégase para as notificacións de aviso"

#: powerdevil.notifyrc:192
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: powerdevil.notifyrc:239
msgctxt "Comment"
msgid "Used for standard notifications"
msgstr "Emprégase para as notificacións estándar"

#: powerdevil.notifyrc:287
msgctxt "Name"
msgid "Critical notification"
msgstr "Notificación crítica"

#: powerdevil.notifyrc:333
msgctxt "Comment"
msgid "Notifies a critical event"
msgstr "Notifica un evento crítico"

#: powerdevil.notifyrc:381
msgctxt "Name"
msgid "Battery Low"
msgstr "Batería baixa"

#: powerdevil.notifyrc:427
msgctxt "Comment"
msgid "Your battery has reached low level"
msgstr "A batería acadou o nivel de carga baixa"

#: powerdevil.notifyrc:479
msgctxt "Name"
msgid "Battery Critical"
msgstr "Batería no nivel crítico"

#: powerdevil.notifyrc:525
msgctxt "Comment"
msgid ""
"Your battery has reached critical level. This notification triggers a "
"countdown before doing the configured action, hence it is strongly advised "
"to leave that on."
msgstr ""
"A batería acadou o nivel crítico. Esta notificación inicia unha conta-atrás "
"previa a realizar a acción configurada, polo que se recomenda que a deixe "
"seguir."

#: powerdevil.notifyrc:578
msgctxt "Name"
msgid "Charge Complete"
msgstr "Carga completa"

#: powerdevil.notifyrc:624
msgctxt "Comment"
msgid "The battery is fully charged"
msgstr "A batería ten a carga completa"

#: powerdevil.notifyrc:676
msgctxt "Name"
msgid "Peripheral Battery Low"
msgstr "Batería de periférico baixa"

#: powerdevil.notifyrc:717
msgctxt "Comment"
msgid "The battery in a connected device, such as mouse or keyboard, is low"
msgstr ""
"A batería dun dispositivo conectado, como pode ser un rato ou un teclado, "
"está baixa."

#: powerdevil.notifyrc:764
msgctxt "Name"
msgid "AC adaptor plugged in"
msgstr "Enchufouse a alimentación externa"

#: powerdevil.notifyrc:810
msgctxt "Comment"
msgid "The power adaptor has been plugged in"
msgstr "Enchufouse o transformador de corrente"

#: powerdevil.notifyrc:862
msgctxt "Name"
msgid "AC adaptor unplugged"
msgstr "Desenchufouse a alimentación externa"

#: powerdevil.notifyrc:908
msgctxt "Comment"
msgid "The power adaptor has been unplugged"
msgstr "Desenchufouse a fonte de alimentación"

