#: PowerDevilRunner.cpp:77
#, kde-format
msgid ""
"Lists system suspend (e.g. sleep, hibernate) options and allows them to be "
"activated"
msgstr ""
"Lista as opcións de suspensión do sistema (por ex. durmir, hibernar) e "
"permítelle activalas"

