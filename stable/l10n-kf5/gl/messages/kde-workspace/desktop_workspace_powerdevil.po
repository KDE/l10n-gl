#: powerdevil.notifyrc:2
msgctxt "Name"
msgid "KDE Power Management System"
msgstr "Sistema de xestión da enerxía de KDE"

#: powerdevil.notifyrc:40
msgctxt "Comment"
msgid "Power Management System"
msgstr "Sistema de xestión da enerxía"

#: powerdevil.notifyrc:79
msgctxt "Name"
msgid "Warning"
msgstr "Aviso"

#: powerdevil.notifyrc:114
msgctxt "Comment"
msgid "Used for warning notifications"
msgstr "Emprégase para as notificacións de aviso."

#: powerdevil.notifyrc:151
msgctxt "Name"
msgid "Notification"
msgstr "Notificación"

#: powerdevil.notifyrc:190
msgctxt "Comment"
msgid "Used for standard notifications"
msgstr "Emprégase para as notificacións estándar."

#: powerdevil.notifyrc:230
msgctxt "Name"
msgid "Critical notification"
msgstr "Notificación crítica"

#: powerdevil.notifyrc:268
msgctxt "Comment"
msgid "Notifies a critical event"
msgstr "Notifica un suceso crítico."

#: powerdevil.notifyrc:308
msgctxt "Name"
msgid "Battery Low"
msgstr "Batería baixa"

#: powerdevil.notifyrc:344
msgctxt "Comment"
msgid "Your battery has reached low level"
msgstr "A batería acadou o nivel de carga baixo."

#: powerdevil.notifyrc:388
msgctxt "Name"
msgid "Battery Critical"
msgstr "Batería no nivel crítico"

#: powerdevil.notifyrc:424
msgctxt "Comment"
msgid ""
"Your battery has reached critical level. This notification triggers a "
"countdown before doing the configured action, hence it is strongly advised "
"to leave that on."
msgstr ""
"A batería acadou o nivel crítico. Esta notificación inicia unha conta-atrás "
"previa a realizar a acción configurada, polo que se recomenda que a deixe "
"seguir."

#: powerdevil.notifyrc:468
msgctxt "Name"
msgid "Charge Complete"
msgstr "Carga completa"

#: powerdevil.notifyrc:504
msgctxt "Comment"
msgid "The battery is fully charged"
msgstr "A batería ten a carga completa."

#: powerdevil.notifyrc:546
msgctxt "Name"
msgid "AC adaptor plugged in"
msgstr "Enchufouse a alimentación externa"

#: powerdevil.notifyrc:584
msgctxt "Comment"
msgid "The power adaptor has been plugged in"
msgstr "Enchufouse o transformador de corrente."

#: powerdevil.notifyrc:628
msgctxt "Name"
msgid "AC adaptor unplugged"
msgstr "Desenchufouse a alimentación externa"

#: powerdevil.notifyrc:666
msgctxt "Comment"
msgid "The power adaptor has been unplugged"
msgstr "Desenchufouse a fonte de alimentación."

#: powerdevil.notifyrc:710
msgctxt "Name"
msgid "Internal Error"
msgstr "Erro interno"

#: powerdevil.notifyrc:746
msgctxt "Comment"
msgid "The KDE Power Management System has triggered an internal error"
msgstr "O sistema de xestión da enerxía de KDE disparou un erro interno."

#: powerdevil.notifyrc:789
msgctxt "Name"
msgid "Suspension inhibited"
msgstr "Evitouse a suspensión"

#: powerdevil.notifyrc:827
msgctxt "Comment"
msgid "The suspension has been inhibited because an application requested it"
msgstr "Evitouse a suspensión porque así o pediu un programa."

#: powerdevil.notifyrc:871
msgctxt "Name"
msgid "Broken battery notification"
msgstr "Notificación de batería estragada"

#: powerdevil.notifyrc:908
msgctxt "Comment"
msgid ""
"KDE Power Management System has detected some troubles with one of your "
"batteries"
msgstr ""
"O sistema de xestión da enerxía de KDE detectou algúns problemas cunha das "
"baterías."
