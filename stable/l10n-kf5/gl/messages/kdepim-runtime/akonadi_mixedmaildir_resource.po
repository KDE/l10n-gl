#: mixedmaildirstore.cpp:1950
#, kde-format
msgctxt "@info:status"
msgid "Cannot move emails from folder %1"
msgstr "Non se poden mover os correos do cartafol %1."

#: mixedmaildirstore.cpp:1909 mixedmaildirstore.cpp:1937
#: mixedmaildirstore.cpp:1982 mixedmaildirstore.cpp:2006
#: mixedmaildirstore.cpp:2013 mixedmaildirstore.cpp:2092
#: mixedmaildirstore.cpp:2116
#, kde-format
msgctxt "@info:status"
