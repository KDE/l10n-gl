#: configdialog.cpp:40
#, kde-format
msgid "Select a MailDir folder"
msgstr "Seleccionar un cartafol MailDir"

#: configdialog.cpp:47
#, kde-format
msgid "Archive Folder"
msgstr "Arquivar o cartafol"

#: configdialog.cpp:93
#, kde-format
msgid "The selected path is empty."
msgstr "A ruta seleccionada está baleira."

#: configdialog.cpp:106
#, kde-format
msgid "The selected path contains valid Maildir folders."
msgstr "A ruta seleccionada contén cartafoles de correo válidos."

#: configdialog.cpp:113
#, kde-format
msgid "The selected path is a valid Maildir."
msgstr "A ruta seleccionada é un directorio de correo válido."

#: configdialog.cpp:119
#, kde-format
msgid "The selected path does not exist yet, a new Maildir will be created."
msgstr ""
"A ruta seleccionada aínda non existe, crearase un novo directorio de correo."

#: configdialog.cpp:123
#, kde-format
msgid "The selected path does not exist."
msgstr "A ruta seleccionada non existe."

#: libmaildir/maildir.cpp:256 libmaildir/maildir.cpp:261
#, kde-format
msgid "Error opening %1; this folder is missing."
msgstr "Produciuse un erro ao abrir %1; non existe ese cartafol."

#: libmaildir/maildir.cpp:266
#, kde-format
msgid ""
"Error opening %1; either this is not a valid maildir folder, or you do not "
"have sufficient access permissions."
msgstr ""
"Produciuse un erro ao abrir %1; ou non é un cartafol maildir válido ou non "
"permisos de acceso de abondo."

#: libmaildir/maildir.cpp:493 libmaildir/maildir.cpp:514
#: libmaildir/maildir.cpp:532 libmaildir/maildir.cpp:552
#: libmaildir/maildir.cpp:571 libmaildir/maildir.cpp:595
#: libmaildir/maildir.cpp:670 libmaildir/maildir.cpp:820
#, kde-format
msgid "Cannot locate mail file %1."
msgstr "Non foi posíbel atopar o ficheiro de correo %1."

#: libmaildir/maildir.cpp:499 libmaildir/maildir.cpp:520
#, kde-format
msgid "Cannot open mail file %1."
msgstr "Non é posíbel abrir o ficheiro de correo %1."

#: libmaildir/maildir.cpp:603 libmaildir/maildir.cpp:630
#, kde-format
msgid "Cannot write to mail file %1."
msgstr "Non é posíbel escribir no ficheiro de correo %1."

#: libmaildir/maildir.cpp:644
#, kde-format
msgid "Failed to create mail file %1. The error was: %2"
msgstr "Produciuse un erro ao crear o ficheiro de correo %1. O erro foi: %2"

#: libmaildir/maildir.cpp:738
#, kde-format
msgid "Failed to update the file name %1 to %2 on the disk. The error was: %3."
msgstr ""
"Produciuse un erro ao actualizar no disco o nome do ficheiro %1 para %2. O "
"erro foi: %3."

#: maildirresource.cpp:142 maildirresource.cpp:285 maildirresource.cpp:323
#: maildirresource.cpp:417 maildirresource.cpp:457 maildirresource.cpp:575
#: maildirresource.cpp:606 maildirresource.cpp:649 maildirresource.cpp:682
#, kde-format
msgid "Unusable configuration."
msgstr "Non é posíbel utilizar esta configuración."

#: maildirresource.cpp:207
#, kde-format
msgid "Unable to fetch item: The maildir folder \"%1\" is not valid."
msgstr ""
"Non foi posíbel obter o elemento: O cartafol de maildir «%1» non é correcto."

#: maildirresource.cpp:296
#, kde-format
msgid "Error: Unsupported type."
msgstr "Erro: Non se recoñece este tipo."

#: maildirresource.cpp:361
#, kde-format
msgid "Failed to change the flags for the mail. %1"
msgstr "Produciuse un erro ao cambiar as marcas do correo. %1"

#: maildirresource.cpp:396
#, kde-format
msgid "Maildir resource got a non-mail content."
msgstr "O recurso Maildir obtivo contido que non era correo."

#: maildirresource.cpp:423
#, kde-format
msgid "Source folder is invalid: '%1'."
msgstr "O cartafol de orixe non é válido: «%1»."

#: maildirresource.cpp:429
#, kde-format
msgid "Destination folder is invalid: '%1'."
msgstr "O cartafol de destino non é válido: «%1»."

#: maildirresource.cpp:445
#, kde-format
msgid "Could not move message '%1' from '%2' to '%3'. The error was %4."
msgstr "Non foi posíbel mover a mensaxe «%1» de «%2» para «%3». O erro foi %4."

#: maildirresource.cpp:467
#, kde-format
msgid "Failed to delete message: %1"
msgstr "Produciuse un erro ao eliminar a mensaxe: %1"

#: maildirresource.cpp:554
#, kde-format
msgid "Maildir '%1' for collection '%2' is invalid."
msgstr "O Maildir «%1» da colección «%2» non é válido."

#: maildirresource.cpp:634
#, kde-format
msgid "Unable to rename maildir folder '%1'."
msgstr "Non foi posíbel cambiar o nome da caixa de correo «%1»."

#: maildirresource.cpp:655
#, kde-format
msgid "Cannot move root maildir folder '%1'."
msgstr "Non é posíbel mover o cartafol de correo maildir raíz «%1»."

#: maildirresource.cpp:670
#, kde-format
msgid "Unable to move maildir folder '%1' from '%2' to '%3'."
msgstr ""
"Non foi posíbel mover o cartafol de correo maildir «%1» de «%2» para «%3»."

#: maildirresource.cpp:688
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr ""
"Non é posíbel eliminar o cartafol de correo maildir de nivel superior «%1»."

#: maildirresource.cpp:697
#, kde-format
msgid "Failed to delete sub-folder '%1'."
msgstr "Non foi posíbel eliminar o subcartafol «%1»."

#: maildirresource.cpp:711
#, kde-format
msgid "Unable to create maildir '%1'."
msgstr "Non foi posíbel crear a caixa de correo maildir «%1»."

#: maildirresource.cpp:721
#, kde-format
msgid "No usable storage location configured."
msgstr "Non se configurou ningunha localización de almacenamento utilizábel."

#. i18n: ectx: label, entry (Path), group (General)
#: maildirresource.kcfg:10
#, kde-format
msgid "Path to maildir"
msgstr "Ruta á caixa de correo maildir"

#. i18n: ectx: label, entry (TopLevelIsContainer), group (General)
#: maildirresource.kcfg:14
#, kde-format
msgid ""
"Path points to a folder containing Maildirs instead of to a maildir itself."
msgstr ""
"A ruta leva a un cartafol que contén os cartafoles de correo, non "
"directamente a un cartafol de correo."

#. i18n: ectx: label, entry (ReadOnly), group (General)
#: maildirresource.kcfg:18
#, kde-format
msgid "Do not change the actual backend data."
msgstr "Non cambiar os datos reais da infraestrutura."

#. i18n: ectx: property (windowTitle), widget (QWidget, ConfigDialog)
#: settings.ui:15
#, kde-format
msgid "Mail Directory Settings"
msgstr "Configuración do directorio de correo"

#. i18n: ectx: attribute (title), widget (QWidget, tab)
#: settings.ui:37
#, kde-format
msgid "Maildir"
msgstr "Directorio do correo"

#. i18n: ectx: property (text), widget (QLabel, label)
#: settings.ui:43
#, kde-format
msgid "Select the folder containing the maildir information:"
msgstr ""
"Seleccione o cartafol que contén a información sobre a caixa de correo:"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#: settings.ui:53
#, kde-format
msgid "Open in read-only mode"
msgstr "Abrir en modo de só lectura"

#~ msgid "Folder Archive"
#~ msgstr "Arquivo de cartafoles"
