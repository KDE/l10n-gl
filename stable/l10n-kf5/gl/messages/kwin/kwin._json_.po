#: src/backends/x11/windowed/x11.json
msgctxt "Description"
msgid "Render to a nested window on X11 windowing system."
msgstr "Renderizar unha xanela aniñada no sistema de xanelas X11."

#: src/effects/backgroundcontrast/metadata.json
msgctxt "Description"
msgid "Improve contrast and readability behind semi-transparent windows"
msgstr ""
"Mellora o contraste e a lexibilidade tras das xanelas semitransparentes."

#: src/effects/blendchanges/metadata.json
msgctxt "Description"
msgid "Animates system style changes"
msgstr "Anima os cambios de estilo do sistema."

#: src/effects/blur/metadata.json
msgctxt "Description"
msgid "Blurs the background behind semi-transparent windows"
msgstr "Desenfoca o fondo tras das xanelas semitransparentes."

#: src/effects/colorpicker/metadata.json
msgctxt "Description"
msgid "Supports picking a color"
msgstr "Permite seleccionar unha cor."

#: src/effects/desktopgrid/metadata.json
msgctxt "Description"
msgid "Zoom out so all desktops are displayed side-by-side in a grid"
msgstr ""
"Reduce de maneira que os escritorios son mostrados lado por lado en grade."

#: src/effects/dialogparent/package/metadata.json
msgctxt "Description"
msgid "Darkens the parent window of the currently active dialog"
msgstr "Escurece a xanela pai do diálogo activo."

#: src/effects/diminactive/metadata.json
msgctxt "Description"
msgid "Darken inactive windows"
msgstr "Escurece as xanelas inactivas."

#: src/effects/dimscreen/package/metadata.json
msgctxt "Description"
msgid "Darkens the entire screen when requesting root privileges"
msgstr "Escurece toda a pantalla cando se piden os privilexios de root."

#: src/effects/eyeonscreen/package/metadata.json
msgctxt "Description"
msgid "Suck windows into the desktop"
msgstr "Chupar as xanelas ao escritorio."

#: src/effects/fadedesktop/package/metadata.json
msgctxt "Description"
msgid "Fade between virtual desktops when switching between them"
msgstr "Usa un efecto de esvaemento ao cambiar de escritorio."

#: src/effects/fade/package/metadata.json
msgctxt "Description"
msgid "Make windows smoothly fade in and out when they are shown or hidden"
msgstr "Esvae/Fai opacas as xanelas con suavidade ao mostralas ou agochadas."

#: src/effects/fadingpopups/package/metadata.json
msgctxt "Description"
msgid "Make popups smoothly fade in and out when they are shown or hidden"
msgstr ""
"Esvae e fai opacas as xanelas emerxentes con suavidade ao mostralas ou "
"agochadas."

#: src/effects/fallapart/metadata.json
msgctxt "Description"
msgid "Closed windows fall into pieces"
msgstr "As xanelas pechadas rachan en anacos."

#: src/effects/frozenapp/package/metadata.json
msgctxt "Description"
msgid "Desaturate windows of unresponsive (frozen) applications"
msgstr ""
"Reducir a saturación das xanelas de aplicacións que non responden "
"(conxeladas)."

#: src/effects/fullscreen/package/metadata.json
msgctxt "Description"
msgid "Animation for a window going to and leaving full screen mode"
msgstr ""
"Animación para unha xanela que entra ou sae do modo a pantalla completa."

#: src/effects/glide/metadata.json
msgctxt "Description"
msgid "Glide windows as they appear or disappear"
msgstr "Desprazar as xanelas cando aparecen ou desaparecen."

#: src/effects/highlightwindow/metadata.json
msgctxt "Description"
msgid "Highlight the appropriate window when hovering over taskbar entries"
msgstr "Realza a xanela axeitada ao pasar o rato sobre a barra de tarefas."

#: src/effects/invert/metadata.json
msgctxt "Description"
msgid "Inverts the color of the desktop and windows"
msgstr "Inverte a cor do escritorio e das xanelas."

#: src/effects/kscreen/metadata.json
msgctxt "Description"
msgid "Helper Effect for KScreen"
msgstr "Efecto auxiliar para KScreen."

#: src/effects/login/package/metadata.json
msgctxt "Description"
msgid "Smoothly fade to the desktop when logging in"
msgstr "Suaviza a entrada no escritorio cun efecto de esvaecemento."

#: src/effects/logout/package/metadata.json
msgctxt "Description"
msgid "Smoothly fade to the logout screen"
msgstr "Suaviza a aparición da pantalla de saída."

#: src/effects/magiclamp/metadata.json
msgctxt "Description"
msgid "Simulate a magic lamp when minimizing windows"
msgstr "Simula unha lámpada máxica ao minimizar as xanelas."

#: src/effects/magnifier/metadata.json
msgctxt "Description"
msgid "Magnify the section of the screen that is near the mouse cursor"
msgstr "Amplía a parte da pantalla que está preto do rato."

#: src/effects/maximize/package/metadata.json
msgctxt "Description"
msgid "Animation for a window going to maximize/restore from maximize"
msgstr "Animación das xanelas que se maximizan ou restauran maximizadas."

#: src/effects/morphingpopups/package/metadata.json
msgctxt "Description"
msgid ""
"Cross fade animation when Tooltips or Notifications change their geometry"
msgstr ""
"Usar unha animación de esvaemento cando a xeometría das mensaxes emerxentes "
"de axuda ou notificación cambia."

#: src/effects/mouseclick/metadata.json
msgctxt "Description"
msgid ""
"Creates an animation whenever a mouse button is clicked. This is useful for "
"screenrecordings/presentations"
msgstr ""
"Crea unha animación cando se preme o botón do rato. Isto é útil nas "
"presentacións e nas gravacións da pantalla."

#: src/effects/mousemark/metadata.json
msgctxt "Description"
msgid "Allows you to draw lines on the desktop"
msgstr "Permítelle debuxar riscos no escritorio."

#: src/effects/overview/metadata.json
msgctxt "Description"
msgid "Allows you to overview virtual desktops and windows"
msgstr ""
"Permítelle obter unha vista xeral dos escritorios virtuais e das xanelas."

#: src/effects/scale/package/metadata.json
msgctxt "Description"
msgid "Make windows smoothly scale in and out when they are shown or hidden"
msgstr ""
"Facer que as xanelas crezan ou decrezan suavemente cando se mostran ou "
"agochan."

#: src/effects/screenedge/metadata.json
msgctxt "Description"
msgid "Highlights a screen edge when approaching"
msgstr "Realza unha beira da pantalla cando se aproxima."

#: src/effects/screenshot/metadata.json
msgctxt "Description"
msgid "Helper effect for screenshot tools"
msgstr "Efecto auxiliar para ferramentas de captura de pantalla."

#: src/effects/screentransform/metadata.json
msgctxt "Description"
msgid "Animates display transformations"
msgstr "Anima as transformacións da pantalla."

#: src/effects/sessionquit/package/metadata.json
msgctxt "Description"
msgid "Keep the desktop background alive during logout until the end"
msgstr "Manter vivo o fondo de escritorio durante a saída ata o final."

#: src/effects/sheet/metadata.json
msgctxt "Description"
msgid ""
"Make modal dialogs smoothly fly in and out when they are shown or hidden"
msgstr ""
"Fai entrar e saír voando ás xanelas modais cando se mostran ou agochan."

#: src/effects/showfps/metadata.json
msgctxt "Description"
msgid "Display KWin's performance in the corner of the screen"
msgstr "Amosa o rendemento de KWin nun canto da pantalla."

#: src/effects/showpaint/metadata.json
msgctxt "Description"
msgid "Highlight areas of the desktop that have been recently updated"
msgstr "Realza áreas do escritorio que se actualizaron recentemente."

#: src/effects/slideback/metadata.json
msgctxt "Description"
msgid "Slide back windows when another window is raised"
msgstr "Despraza cara atrás as xanelas cando outra se eleva."

#: src/effects/slide/metadata.json
msgctxt "Description"
msgid "Slide desktops when switching virtual desktops"
msgstr "Esvarar os escritorios ao cambiar de escritorio virtual."

#: src/effects/slidingpopups/metadata.json
msgctxt "Description"
msgid "Sliding animation for Plasma popups"
msgstr "Animación esvaradía para as mensaxes emerxentes de Plasma."

#: src/effects/snaphelper/metadata.json
msgctxt "Description"
msgid "Help you locate the center of the screen when moving a window"
msgstr "Axúdao a atopar o centro da pantalla cando move xanelas."

#: src/effects/squash/package/metadata.json
msgctxt "Description"
msgid "Squash windows when they are minimized"
msgstr "Xuntar as xanelas cando estean minimizadas."

#: src/effects/startupfeedback/metadata.json
msgctxt "Description"
msgid "Helper effect for startup feedback"
msgstr "Efecto auxiliar para notificar o lanzamento de programas."

#: src/effects/thumbnailaside/metadata.json
msgctxt "Description"
msgid "Display window thumbnails on the edge of the screen"
msgstr "Amosa miniaturas das xanelas na beira da pantalla."

#: src/effects/tileseditor/metadata.json
msgctxt "Description"
msgid "Editor for the tiling areas"
msgstr "Editor das zonas de teselas."

#: src/effects/touchpoints/metadata.json
msgctxt "Description"
msgid "Visualize touch points"
msgstr "Visualizar os puntos de toque."

#: src/effects/trackmouse/metadata.json
msgctxt "Description"
msgid "Display a mouse cursor locating effect when activated"
msgstr "Mostra un efecto de atopar o cursor do rato cando está activada."

#: src/effects/translucency/package/metadata.json
msgctxt "Description"
msgid "Make windows translucent under different conditions"
msgstr "Fai translúcidas as xanelas en distintos casos."

#: src/effects/windowaperture/package/metadata.json
msgctxt "Description"
msgid "Move windows into screen corners"
msgstr "Mover as xanelas ás esquinas de pantalla."

#: src/effects/windowview/metadata.json
msgctxt "Description"
msgid "Zoom out until all opened windows can be displayed side-by-side"
msgstr "Reduce ata que poida mostrar lado por lado todas as xanelas."

#: src/effects/wobblywindows/metadata.json
msgctxt "Description"
msgid "Deform windows while they are moving"
msgstr "Deforma as xanelas cando se moven."

#: src/effects/zoom/metadata.json
msgctxt "Description"
msgid "Magnify the entire desktop"
msgstr "Amplía todo o escritorio."

#: src/kcms/compositing/kwincompositing.json
msgctxt "Description"
msgid "Compositor Settings for Desktop Effects"
msgstr "Configuración do compositor para os efectos de escritorio."

#: src/kcms/decoration/kcm_kwindecoration.json
msgctxt "Description"
msgid "Configure window titlebars and borders"
msgstr "Configurar as barras de título e os bordos das xanelas."

#: src/kcms/desktop/kcm_kwin_virtualdesktops.json
msgctxt "Description"
msgid "Configure navigation, number and layout of virtual desktops"
msgstr ""
"Configurar a navegación, cantidade e disposición dos escritorios virtuais."

#: src/kcms/effects/kcm_kwin_effects.json
msgctxt "Description"
msgid "Configure compositor settings for desktop effects"
msgstr "Configurar o compositor para os efectos de escritorio."

#: src/kcms/options/kcm_kwinoptions.json
msgctxt "Description"
msgid "Configure window actions and behavior"
msgstr "Configurar o comportamento e as accións das xanelas."

#: src/kcms/rules/kcm_kwinrules.json
msgctxt "Description"
msgid "Individual Window Behavior"
msgstr "Comportamento individual das xanelas."

#: src/kcms/screenedges/kcm_kwinscreenedges.json
msgctxt "Description"
msgid "Configure active screen corners and edges"
msgstr "Configurar os bordos e esquinas activos da pantalla."

#: src/kcms/screenedges/kcm_kwintouchscreen.json
msgctxt "Description"
msgid "Configure touch screen swipe gestures"
msgstr "Configurar os acenos de pantalla táctil."

#: src/kcms/scripts/kcm_kwin_scripts.json
msgctxt "Description"
msgid "Manage KWin scripts"
msgstr "Xestiona os guións de KWin."

#: src/kcms/tabbox/kcm_kwintabbox.json
msgctxt "Description"
msgid "Navigation Through Windows"
msgstr "Navegación polas xanelas."

#: src/kcms/virtualkeyboard/kcm_virtualkeyboard.json
msgctxt "Description"
msgid "Select which virtual keyboard to use"
msgstr "Seleccionar o teclado virtual para usar."

#: src/kcms/xwayland/kcm_kwinxwayland.json
msgctxt "Description"
msgid "Select which keys will be globally available to legacy X11 apps"
msgstr ""
"Seleccionar que teclas estarán dispoñíbeis globalmente para aplicacións "
"antigas de X11."

#: src/plugins/kdecorations/aurorae/themes/plastik/package/metadata.json
msgctxt "Description"
msgid "The classic theme known from KDE 3"
msgstr "O tema clásico de KDE 3."

#: src/scripts/desktopchangeosd/metadata.json
msgctxt "Description"
msgid "An on screen display indicating the desktop change"
msgstr "Un visor na pantalla que indica o cambio de escritorio."

#: src/scripts/minimizeall/metadata.json
msgctxt "Description"
msgid "Adds a shortcut to minimize and restore all windows"
msgstr "Engade un atallo para minimizar e restaurar todas as xanelas."

#: src/scripts/synchronizeskipswitcher/metadata.json
msgctxt "Description"
msgid ""
"Hides all windows marked as Skip Taskbar to be also excluded from window "
"switchers (e.g. Alt+Tab)"
msgstr ""
"Agocha todas as xanelas que deban ser ignoradas pola barra de tarefas tamén "
"dos alternadores de xanelas (p.ex. Alt+Tab)."

#: src/scripts/videowall/metadata.json
msgctxt "Description"
msgid ""
"Spans fullscreen video player over all attached screens to create a Video "
"Wall"
msgstr ""
"Estende un reprodutor de vídeo a pantalla completa por todas as pantallas "
"anexas para crear unha parede de vídeo."

