#: kstars/kstars.notifyrc:42
msgctxt "Comment"
msgid "Autofocus operation completed successfully"
msgstr "Completouse o enfoque automático."

#: kstars/kstars.notifyrc:62
msgctxt "Name"
msgid "Autofocus Failure"
msgstr "Erro de enfoque automático"

