msgid "Kleopatra"
msgstr "Kleopatra"

#. (itstool) path: component/summary
#: org.kde.kleopatra.appdata.xml:11
msgid "Certificate manager and cryptography app"
msgstr "Xestor de certificados e aplicación de criptografía."

#. (itstool) path: description/p
#: org.kde.kleopatra.appdata.xml:13
msgid ""
"Kleopatra is a certificate manager and a universal crypto GUI. It supports "
"managing OpenPGP and S/MIME certificates and encrypts files and text."
msgstr ""
"Kleopatra é un xestor de certificados e unha interface gráfica universal de "
"criptografía. Permite xestionar certificados OpenPGP e S/MIME e cifra "
"ficheiros e texto."

