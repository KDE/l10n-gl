#: imageeffect_despeckle.cpp:57 imageeffect_despeckle.cpp:62
#: imageeffect_despeckle.cpp:241
msgid "Noise Reduction"
msgstr "Reduzón de Ruído"

#: imageeffect_despeckle.cpp:64
#, fuzzy
msgid "A despeckle image filter plugin for digiKam."
msgstr "Un plugin de digiKam para reducir o ruído da imaxe."

#: imageeffect_despeckle.cpp:70
msgid "Author and maintainer"
msgstr "Autoria e mantimento"

#: imageeffect_despeckle.cpp:73
msgid "Despeckle algorithm author from Gimp"
msgstr ""

#: imageeffect_despeckle.cpp:83
msgid "Radius:"
msgstr "Rádio:"

#: imageeffect_despeckle.cpp:88
msgid ""
"<p>A radius of 0 has no effect, 1 and above determine the blur matrix radius "
"that determines how much to blur the image."
msgstr ""
"<p>Un rádio igual a 0 anula o efeito, mentres que valores iguais ou superiores "
"a 1 determinan o rádio da matriz do borrón que determina canto é que se "
"difundirá a imaxe."

#: imageeffect_despeckle.cpp:97
msgid "Black level:"
msgstr "Nível de negro:"

#: imageeffect_despeckle.cpp:102
msgid ""
"<p>This value controls the black levels used by the adaptive filter to adjust "
"the filter radius."
msgstr ""
"<p>Este valor controla os níveis de negro utilizados polo filtro adaptativo "
"para axustar o rádio do filtro."

#: imageeffect_despeckle.cpp:111
msgid "White level:"
msgstr "Nível de branco:"

#: imageeffect_despeckle.cpp:116
msgid ""
"<p>This value controls the white levels used by the adaptive filter to adjust "
"the filter radius."
msgstr ""
"<p>Este valor controla os níveis de branco utilizados polo filtro adaptativo "
"para axustar o rádio do filtro."

#: imageeffect_despeckle.cpp:125
msgid "Adaptive"
msgstr "Adaptativo"

#: imageeffect_despeckle.cpp:126
msgid "<p>This option use an adaptive median filter type."
msgstr "<p>Esta opzón utiliza un filtro de tipo adaptativo mediante mediana."

#: imageeffect_despeckle.cpp:128
msgid "Recursive"
msgstr "Recursivo"

#: imageeffect_despeckle.cpp:129
msgid "<p>This option use a recursive median filter type."
msgstr "<p>Esta opzón utiliza un filtro de tipo recursivo por mediana."

#: imageplugin_despeckle.cpp:43
msgid "Noise Reduction..."
msgstr "Reduzón de Ruído..."

