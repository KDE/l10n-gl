msgstr "Algoritmo das pingas de chúvia"

#: imageeffect_raindrop.cpp:74
msgid "Developer"
msgstr "Desenvolvente"

#: imageeffect_raindrop.cpp:79
msgid ""
"<p>This is the preview of the Raindrop effect."
"<p>Note: if you have previously selected an area in the editor, this will be "
"unaffected by the filter. You can use this method to disable the Raindrops "
"effect on a human face, for example."
msgstr ""
"<p>Esta é a antevisión do efeito de pingas de chuvia."
"<p>Nota: Se tiña escollida unha área no editor, esta non será afectada polo "
"filtro. Pode usar este método para desabilitar o efeito nunha cara humana, por "
"exemplo."

#: imageeffect_raindrop.cpp:89
msgid "Drop size:"
msgstr "Tamaño da pinga:"

#: imageeffect_raindrop.cpp:94
msgid "<p>Set here the raindrops' size."
msgstr "<p>Defina aqui o tamaño da gota de chúvia."

#: imageeffect_raindrop.cpp:101
msgid "Number:"
msgstr "Número:"

#: imageeffect_raindrop.cpp:106
msgid "<p>This value controls the maximum number of raindrops."
msgstr "<p>Este valor controla o número máximo de pingas de chúvia."

#: imageeffect_raindrop.cpp:113
msgid "Fish eyes:"
msgstr "Ollo de peixe:"

#: imageeffect_raindrop.cpp:118
msgid "<p>This value is the fish-eye-effect optical distortion coefficient."
msgstr "<p>Este valor é o coeficiente de distorción óptica do efeito de ollo de peixe."

#: imageeffect_raindrop.cpp:219
msgid "RainDrop"
msgstr "Pinga de Chúvia"

#: imageplugin_raindrop.cpp:42
msgid "Raindrops..."
msgstr "Pingas de chúvia..."

#: imageplugin_raindrop.cpp:62
msgid "Add Raindrops to Photograph"
msgstr "Adicionar Pingas de Chúvia á Fotografia"

