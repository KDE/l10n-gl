#: imageeffect_sheartool.cpp:58 imageeffect_sheartool.cpp:69
#: imageeffect_sheartool.cpp:264
msgid "Shear Tool"
msgstr "Ferramenta de Inclinazón"

#: imageeffect_sheartool.cpp:71
msgid "A digiKam image plugin to shear an image."
msgstr "Un plugin de digiKam para inclinar imaxes."

#: imageeffect_sheartool.cpp:77
msgid "Author and maintainer"
msgstr "Autoria e mantimento"

#: imageeffect_sheartool.cpp:82
msgid ""
"<p>This is the shearing image operation preview. If you move the mouse "
"cursor on this preview, a vertical and horizontal dashed line will be drawn "
"to guide you in adjusting the shearing correction. Release the left mouse "
"button to freeze the dashed line's position."
msgstr ""
"<p>Esta é a antevisión da operazón de inclinazón da imaxe. Se move o cursor "
"do rato nesta antevisión debuxará-se unha liña discontínua vertical e "
"horizontal para guiá-lo no axuste da operazón de inclinazón. Prema no botón "
"direito do rato para fixar a posizón das liñas discontínuas."

#: imageeffect_sheartool.cpp:94
msgid "New width:"
