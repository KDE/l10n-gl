msgstr "<p>A ángulo de inclinazón horizontal principal, en graus."

#: imageeffect_sheartool.cpp:118
#, fuzzy
msgid "Vertical angle:"
msgstr "Ángulo vertical principal:"

#: imageeffect_sheartool.cpp:123
#, fuzzy
msgid "<p>The vertical shearing angle, in degrees."
msgstr "<p>A ángulo de inclinazón vertical principal, en graus."

#: imageeffect_sheartool.cpp:127
msgid "Anti-Aliasing"
msgstr "Anti-Aliasing"

#: imageeffect_sheartool.cpp:128
msgid ""
"<p>Enable this option to process anti-aliasing filter to the sheared image. "
"To smooth the target image, it will be blurred a little."
msgstr ""
"<p>Active esta opzón para procesar un filtro de anti-aliasing (suavizazón) "
"para suavizar a imaxe inclinada. Cando a suavice, a imaxe quedará "
"lixeiramente difuminada."

#: imageeffect_sheartool.cpp:256 imageeffect_sheartool.cpp:257
msgid " px"
msgstr " píxels"

#: imageplugin_sheartool.cpp:42
msgid "Shear..."
msgstr "Inclinar..."

