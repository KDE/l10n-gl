#: qeditor_view.cpp:684
msgid "Reloa&d"
msgstr "Re&cargar"

#: qeditor_view.cpp:687
msgid "<b>Reload</b><p>Reloads the current document from disk."
msgstr "<b>Recargar</b><p>Recarga o documento actual desde disco."

#: qeditor_view.cpp:690
msgid "Reverts the most recent editing actions."
msgstr "Anula as accións de edición máis recentes."

#: qeditor_view.cpp:692
msgid "Reverts the most recent undo operation."
msgstr "Anula a acción desfeita máis recente."

#: qeditor_view.cpp:695
msgid "Cuts the selected text and moves it to the clipboard."
msgstr "Corta o texto escollido e móveo ao porta-retallos."

#: qeditor_view.cpp:697
msgid "Copies the selected text to the clipboard."
msgstr "Copia o texto escollido ao porta-retallos."

#: qeditor_view.cpp:700
msgid "Pastes previously copied or cut clipboard contents."
msgstr "Pega o contido do porta-retallos previamente cortado ou copiado."

#: qeditor_view.cpp:702
msgid "Selects the entire text of the current document."
msgstr "Selecciona todo o texto do documento actual."

#: qeditor_view.cpp:705
msgid ""
"Opens a dialog and lets you choose a line that you want the cursor to move "
"to."
msgstr ""
"Abre un diálogo e permitelle escoller unha liña para a cal desexa que o cursor "
"salte."

#: qeditor_view.cpp:707
msgid "Looks up the first occurrence of a piece of text or regular expression."
msgstr "Procura a primeira ocorrencia dun pedazo de texto ou unha expresión regular."

#: qeditor_view.cpp:709
msgid ""
"Looks up a piece of text or regular expression and replace the result with "
"some given text."
msgstr ""
"Procura un pedazo de texto ou unha expresión regular e substitúe o resultado "
"por outro texto indicado."

#: qeditor_view.cpp:711
msgid "&Indent"
msgstr "&Endentar"

#: qeditor_view.cpp:715
msgid "<b>Indent</b><p>Indents a selected block of text."
msgstr "<b>Endentar</b><p>Endenta un bloque de texto seleccionado."

#: qeditor_view.cpp:717
msgid "Collapse All Blocks"
msgstr "Pechar tódolos bloques"

#: qeditor_view.cpp:720
msgid "Collapse all blocks"
msgstr "Pechar tódolos bloques"

#: qeditor_view.cpp:721
msgid "<b>Collapse all blocks</b><p>Collapses all blocks in the current document."
msgstr ""
"<b>Pechar todos os bloques</b>"
"<p>Pecha tódolos bloques no documento actual."

#: qeditor_view.cpp:723
msgid "Expand All Blocks"
msgstr "Expandir tódolos bloques"

#: qeditor_view.cpp:726
msgid "Expand all blocks"
msgstr "Expandir tódolos bloques"

#: qeditor_view.cpp:727
msgid "<b>Expand all blocks</b><p>Expands all blocks in the current document."
msgstr ""
"<b>Expandir todos os bloques</b>"
"<p>Abre tódolos bloques no documento actual."

#: qeditor_view.cpp:729
msgid "Start Macro"
msgstr "Iniciar macro"

#: qeditor_view.cpp:732
msgid "Start macro"
msgstr "Iniciar macro"

#: qeditor_view.cpp:733
msgid "<b>Start macro</b><p>Starts recording a macro based on the editor input."
msgstr ""
"<b>Iniciar macro</b>"
"<p>Inicia a gravación dunha macro, baseada na entrada do editor."

#: qeditor_view.cpp:735
msgid "Stop Macro"
msgstr "Parar macro"

#: qeditor_view.cpp:738
msgid "Stop macro"
msgstr "Parar macro"

#: qeditor_view.cpp:739
msgid "<b>Stop macro</b><p>Stops recording a macro."
msgstr "<b>Parar macro</b><p>Para a gravación dunha macro."

#: qeditor_view.cpp:741
msgid "Execute Macro"
msgstr "Executar macro"

#: qeditor_view.cpp:744
msgid "Execute macro"
msgstr "Executar macro"

#: qeditor_view.cpp:745
msgid "<b>Execute macro</b><p>Executes previously recorded macro."
msgstr "<b>Executar macro</b><p>Executa unha macro previamente gravada."

#: qeditor_view.cpp:747
msgid "&Configure Editor..."
msgstr "&Configurar editor..."

#: qeditor_view.cpp:750
msgid "Configure editor"
msgstr "Configurar editor"

#: qeditor_view.cpp:751
msgid "<b>Configure editor</b><p>Opens an editor configuration dialog."
msgstr "<b>Configurar editor</b><p>Abre un diálogo de configuración do editor."

