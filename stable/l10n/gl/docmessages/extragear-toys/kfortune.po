#. Tag: para
#: index.docbook:32
#, no-c-format
msgid ""
"This manual describes &kfortune;, a graphical &kde; frontend for the &fortune; "
"program."
msgstr "Este manual descrebe &kfortune;, unha interface gráfica de &kde; para o programa &fortune;."

#. Tag: keyword
#: index.docbook:37
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

#. Tag: keyword
#: index.docbook:38
#, no-c-format
