#. Tag: title
#: index.docbook:267
#, no-c-format
msgid "Using &kgeography;"
msgstr "Uso de &kgeography;"

#. Tag: para
#: index.docbook:269
#, no-c-format
msgid ""
"&kgeography; displays informations about some countries and tests you about "
"those informations."
msgstr ""
"&kgeography; mostra información acerca dalgúns países e faille probas "
"acerca desa información."

#. Tag: screeninfo
