msgstr ""
"Adiviñar a división a partir da súa bandeira: móstrase unha bandeira e debe adiviñar a "
"provincia á que pertence."

#. Tag: screeninfo
#: index.docbook:239
#, no-c-format
msgid "<screeninfo>the flag question</screeninfo>"
msgstr "<screeninfo>a pergunta da bandeira</screeninfo>"

#. Tag: phrase
