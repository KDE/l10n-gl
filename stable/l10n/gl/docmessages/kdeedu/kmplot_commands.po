#: commands.docbook:51
#, no-c-format
msgid "Saves the document."
msgstr "Guarda o documento."

#. Tag: menuchoice
#: commands.docbook:56
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr "<guimenu>Ficheiro</guimenu> <guimenuitem>Guardar Como...</guimenuitem>"

#. Tag: action
#: commands.docbook:59
#, no-c-format
msgid "Saves the document under another name."
msgstr "Guarda o documento con outro nome."

#. Tag: menuchoice
#: commands.docbook:65
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> "
"</shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Imprimir...</guimenuitem>"

#. Tag: action
#: commands.docbook:74
#, no-c-format
msgid "Sends the plot to a printer or file."
msgstr "Envía a gráfica para unha impresora ou ficheiro."

#. Tag: menuchoice
#: commands.docbook:80
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export...</guimenuitem>"
msgstr "<guimenu>Ficheiro</guimenu> <guimenuitem>Exportar...</guimenuitem>"

#. Tag: para
#: commands.docbook:83
#, no-c-format
msgid ""
"<action>Export values to a textfile. </action>Every value in the parameter list "
"will be written to one line in the file."
msgstr ""
"<action>Exporta os valores para un ficheiro de texto.</action> "
"Todo valor na lista de parámetros será escrito nun no ficheiro."

#. Tag: menuchoice
#: commands.docbook:90
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>Q</keycap> </keycombo>"
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
