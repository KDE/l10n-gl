#. Tag: title
#: commands.docbook:2
#, no-c-format
msgid "Command Reference"
msgstr "Referencia dos Comandos"

#. Tag: title
#: commands.docbook:5
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr "O Menú <guimenu>Ficheiro</guimenu>"

#. Tag: menuchoice
#: commands.docbook:11
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> "
"</shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Novo</guimenuitem>"

#. Tag: action
#: commands.docbook:20
#, no-c-format
msgid ""
"Starts a new Plot by clearing the coordinate system and resetting the function "
"parser."
msgstr ""
"Inicia unha Representación nova limpando o sistema de coordenadas e reiniciando "
"o procesador de funcións."

#. Tag: menuchoice
#: commands.docbook:27
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo>"
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo>"
"</shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Abrir...</guimenuitem>"

#. Tag: action
#: commands.docbook:31
#, no-c-format
msgid "Opens an existing document."
msgstr "Abre un documento existente."

#. Tag: menuchoice
#: commands.docbook:36
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Open Recent</guimenuitem>"
msgstr "<guimenu>Ficheiro</guimenu> <guimenuitem>Abrir Recente</guimenuitem>"

#. Tag: para
#: commands.docbook:40
#, no-c-format
msgid ""
"<action>Displays a list of recently opened files.</action> "
"Selecting one from this list plots the functions in the file."
msgstr ""
"<action>Mostra unha lista de ficheiro abertos recentemente.</action> "
"Se escolle un desta lista representará as funcións no ficheiro."

#. Tag: menuchoice
#: commands.docbook:46
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo>"
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo>"
"</shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Guardar</guimenuitem>"

#. Tag: action
#: commands.docbook:51
#, no-c-format
msgid "Saves the document."
msgstr "Guarda o documento."

#. Tag: menuchoice
#: commands.docbook:56
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr "<guimenu>Ficheiro</guimenu> <guimenuitem>Guardar Como...</guimenuitem>"

#. Tag: action
#: commands.docbook:59
#, no-c-format
msgid "Saves the document under another name."
msgstr "Guarda o documento con outro nome."

#. Tag: menuchoice
#: commands.docbook:65
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> "
"</shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Imprimir...</guimenuitem>"

#. Tag: action
#: commands.docbook:74
#, no-c-format
msgid "Sends the plot to a printer or file."
msgstr "Envía a gráfica para unha impresora ou ficheiro."

#. Tag: menuchoice
#: commands.docbook:80
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export...</guimenuitem>"
msgstr "<guimenu>Ficheiro</guimenu> <guimenuitem>Exportar...</guimenuitem>"

#. Tag: para
#: commands.docbook:83
#, no-c-format
msgid ""
"<action>Export values to a textfile. </action>Every value in the parameter list "
"will be written to one line in the file."
msgstr ""
"<action>Exporta os valores para un ficheiro de texto.</action> Todo valor na lista de "
"parámetros será escrito nun no ficheiro."

#. Tag: menuchoice
#: commands.docbook:90
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>Q</keycap> </keycombo>"
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>Q</keycap> </keycombo>"
"</shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Saír</guimenuitem>"

#. Tag: para
#: commands.docbook:96
#, no-c-format
msgid "<action>Exits</action> &kmplot;."
msgstr "<action>Sai</action> de &kmplot;."

#. Tag: title
#: commands.docbook:102
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr "O Menú <guimenu>Editar</guimenu>"

#. Tag: menuchoice
#: commands.docbook:106
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Undo</guimenuitem>"
msgstr "<guimenu>Editar</guimenu><guimenuitem>Desfacer</guimenuitem>"

#. Tag: para
#: commands.docbook:108
#, no-c-format
msgid "Undo the last command."
msgstr "Desfai o último comando."

#. Tag: menuchoice
#: commands.docbook:112
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Redo</guimenuitem>"
msgstr "<guimenu>Editar</guimenu><guimenuitem>Refacer</guimenuitem>"

#. Tag: para
#: commands.docbook:114
#, no-c-format
msgid "Redo the last command that was undone."
msgstr "Volta a facer o último comando que foi desfeito."

#. Tag: menuchoice
#: commands.docbook:119
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Coordinate System...</guimenuitem>"
msgstr "<guimenu>Editar</guimenu><guimenuitem>Sistema de Coordenadas...</guimenuitem>"

#. Tag: para
#: commands.docbook:121
#, no-c-format
msgid ""
"Displays the <guilabel>Coordinate System</guilabel> dialog box. See <xref "
"linkend=\"coords-config\"/>."
msgstr ""
"Mostra o diálogo do <guilabel>Sistema de Coordenadas</guilabel>. Consulte "
"<xref linkend=\"coords-config\"/>."

#. Tag: menuchoice
#: commands.docbook:127
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Constants...</guimenuitem>"
msgstr "<guimenu>Editar</guimenu><guimenuitem>Constantes...</guimenuitem>"

#. Tag: para
#: commands.docbook:129
#, no-c-format
msgid ""
"Displays the <guilabel>Constants</guilabel> dialog box. See <xref "
"linkend=\"constants-config\"/>."
msgstr ""
"Mostra o diálogo das <guilabel>Constantes</guilabel>. Consulte <xref "
"linkend=\"constants-config\"/>."

#. Tag: title
#: commands.docbook:137
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr "O Menú <guimenu>Ver</guimenu>"

#. Tag: para
#: commands.docbook:138
#, no-c-format
msgid "The first three items in the menu are related to zooming."
msgstr "Os tres primeiros itens deste menú están relacionados coa ampliación."

#. Tag: menuchoice
#: commands.docbook:143
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>1</keycap></keycombo> "
"</shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom In</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>1</keycap></keycombo> "
"</shortcut> <guimenu>Ver</guimenu> <guimenuitem>Ampliar</guimenuitem>"

#. Tag: para
#: commands.docbook:152
#, no-c-format
msgid ""
"This tool can be operator in two different manners. To zoom in on a point on "
"the graph, click on it. To zoom in on a specific section of the graph, hold and "
"drag the mouse to form a rectangle, which will be the new axes ranges when the "
"mouse button is released."
msgstr ""
"Esta ferramenta pode ser usada de duas maneiras diferentes. Para ampliar "
"sobre un ponto da representación, prema sobre el. Para ampliar unha sección "
"específica da gráfica, manteña premido e arraste o rato para formar un rectángulo, "
"que será o novo rango dos eixos cando o botón do rato sexa soltado."

#. Tag: menuchoice
#: commands.docbook:158
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>2</keycap></keycombo> "
"</shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom Out</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>2</keycap></keycombo> "
"</shortcut> <guimenu>Ver</guimenu> <guimenuitem>Reducir</guimenuitem>"

#. Tag: para
#: commands.docbook:167
#, no-c-format
msgid ""
"The tool can also be used in two different manners. To zoom out and center on a "
"point, click on that point. To fit the existing view into a rectangle, hold and "
"drag the mouse to form that rectangle."
msgstr ""
"Esta ferramente tamén pode ser usada de dous xeitos distintos. Para reducir e "
"centrar nun ponto, prema en tal ponto. Para axustar a vista existente nun rectángulo, "
"calque e arraste o rato para formar tal rectángulo."

#. Tag: menuchoice
#: commands.docbook:172
#, no-c-format
msgid ""
"<guimenu>Zoom</guimenu> <guimenuitem>Fit Widget to Trigonometric "
"Functions</guimenuitem>"
msgstr "<guimenu>Ampliación</guimenu> <guimenuitem>Axustar a Gráfica a Funcións Trigonométricas</guimenuitem>"

#. Tag: para
#: commands.docbook:177
#, no-c-format
msgid ""
"The scale will be adapted to trigonometric functions. This works both for "
"radians and degrees."
msgstr ""
"A escala será adaptada para funcións trigonométricas. Isto funciona tanto en graus "
"como en radiáns."

#. Tag: menuchoice
#: commands.docbook:181
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Sliders</guimenuitem>"
msgstr "<guimenu>Configuración</guimenu> <guimenuitem>Mostrar Barras Deslizantes</guimenuitem>"

#. Tag: para
#: commands.docbook:185
#, no-c-format
msgid "<action>Toggles</action> the visibility of the slider dialog."
msgstr "<action>Comuta</action> a visibilidade do diálogo de desprazamento."

#. Tag: menuchoice
#: commands.docbook:190
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Coordinate System I</guimenuitem>"
msgstr "<guimenu>Editar</guimenu><guimenuitem>Sistema de Coordenadas I</guimenuitem>"

#. Tag: para
#: commands.docbook:192
#, no-c-format
msgid "Show both positive and negative x- and y-values on the grid."
msgstr "Mostra tanto valores positivos como negativos de x e y na grella."

#. Tag: menuchoice
#: commands.docbook:198
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Coordinate System II</guimenuitem>"
msgstr "<guimenu>Editar</guimenu><guimenuitem>Sistema de Coordenadas II</guimenuitem>"

#. Tag: para
#: commands.docbook:200
#, no-c-format
msgid "Show positive and negative y-values, but positive x-values only"
msgstr "Mostra valores tanto positivos como negativos no eixo y, pero só positivos no x"

#. Tag: menuchoice
#: commands.docbook:206
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Coordinate System III</guimenuitem>"
msgstr "<guimenu>Editar</guimenu><guimenuitem>Sistema de Coordenadas III</guimenuitem>"

#. Tag: para
#: commands.docbook:208
#, no-c-format
msgid "Show only positive x- and y-values."
msgstr "Mostrar só valores positivos de x e y."

#. Tag: title
#: commands.docbook:216
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr "O Menú <guimenu>Ferramentas</guimenu>"

#. Tag: para
#: commands.docbook:218
#, no-c-format
msgid "This menu contains some tools for the functions that can be useful:"
msgstr "Este menú contén algunhas ferramentas para as funcións que poden ser úteis:"

#. Tag: menuchoice
#: commands.docbook:223
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Get y-Value...</guimenuitem>"
msgstr "<guimenu>Ferramentas</guimenu> <guimenuitem>Obter valor y...</guimenuitem>"

#. Tag: para
#: commands.docbook:227
#, no-c-format
msgid ""
"Let the user get the y-value from a specific x-value. Type a value or "
"expression in the text box under \"X:\". In the list below all the available "
"functions are shown. Press Enter to calculate the function's y-value. The "
"result will be shown in the y-value box."
msgstr ""
"Permítelle ao usuario obter o valor y para un valor x específico. Escreba o valor ou "
"expresión no campo de nome \"X:\". Na lista en baixo móstranse todas as funcións "
"disponíbeis. Prema Intro para calcular o valor y da función. O resultado será mostrado "
"no campo do valor y."

#. Tag: menuchoice
#: commands.docbook:232
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Search for Minimum Value...</guimenuitem>"
msgstr "<guimenu>Ferramentas</guimenu> <guimenuitem>Procurar o Mínimo...</guimenuitem>"

#. Tag: para
#: commands.docbook:236
#, no-c-format
msgid "Find the minimum value of the graph in a specified range."
msgstr "Procura o valor mínimo da representación nun rango especificado."

#. Tag: menuchoice
#: commands.docbook:241
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Search for Maximum Value...</guimenuitem>"
msgstr "<guimenu>Ferramentas</guimenu> <guimenuitem>Procurar o Máximo...</guimenuitem>"

#. Tag: para
#: commands.docbook:245
#, no-c-format
msgid "Find the maximum value of the graph in a specified range."
msgstr "Procura o valor máximo da representación no rango especificado."

#. Tag: menuchoice
#: commands.docbook:250
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Calculate Integral</guimenuitem>"
msgstr "<guimenu>Ferramentas</guimenu> <guimenuitem>Calcular Integral</guimenuitem>"

#. Tag: para
#: commands.docbook:254
#, no-c-format
msgid ""
"Select a graph and the x-values in the new dialog that appears. Calulates the "
"integral and draws the area between the graph and the x-axis in the range of "
"the selected x-values in the color of the graph."
msgstr ""
"Escolla unha gráfica e os valores x no diálogo que irá aparecer. Calcularase a integral "
"e debuxarase a área entre a gráfica e o eixo x no rango de valores indicados coa cor "
"da gráfica."

#. Tag: title
#: commands.docbook:264
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "O Menú <guimenu>Configuración</guimenu>"

#. Tag: menuchoice
#: commands.docbook:268
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Statusbar</guimenuitem>"
msgstr "<guimenu>Configuración</guimenu> <guimenuitem>Comutar Barra de Estado</guimenuitem>"

#. Tag: para
#: commands.docbook:272
#, no-c-format
msgid ""
"<action>Toggle on and off the display of the status bar at the bottom of the "
"&kmplot; main window.</action> The default is on."
msgstr ""
"<action>Mostra ou acocha a barra de estado ao fondo da xanela principal de "
"&kmplot;.</action> Por defeito mostra-a."

#. Tag: menuchoice
#: commands.docbook:283
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenu>Settings</guimenu> <guimenuitem>Full Screen Mode</guimenuitem>"
msgstr ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenu>Configuración</guimenu> <guimenuitem>Modo a Pantalla Completa</guimenuitem>"

#. Tag: para
#: commands.docbook:290
#, no-c-format
msgid "With this action you toggle the full screen mode."
msgstr "Con esta acción comuta o modo a pantalla completa."

#. Tag: menuchoice
#: commands.docbook:295
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr "<guimenu>Configuración</guimenu> <guimenuitem>Configurar Atallos de Teclado...</guimenuitem>"

#. Tag: para
#: commands.docbook:299
#, no-c-format
msgid "<action>Personalize the keybindings</action> for &kmplot;."
msgstr "<action>Personaliza os atallos de teclado</action> de &kmplot;."

#. Tag: menuchoice
#: commands.docbook:304
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr "<guimenu>Configuración</guimenu> <guimenuitem>Configurar Barras de Ferramentas...</guimenuitem>"

#. Tag: para
#: commands.docbook:308
#, no-c-format
msgid "<action>Personalize the toolbars</action> for &kmplot;."
msgstr "<action>Personaliza as barras de ferramentas</action> de &kmplot;."

#. Tag: menuchoice
#: commands.docbook:313
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure &kmplot;...</guimenuitem>"
msgstr "<guimenu>Configuración</guimenu> <guimenuitem>Configurar &kmplot;...</guimenuitem>"

#. Tag: para
#: commands.docbook:317
#, no-c-format
msgid ""
"<action>Customize</action> &kmplot;. The options available to you are described "
"in <xref linkend=\"configuration\"/>."
msgstr ""
"<action>Personaliza</action> &kmplot;. As opcións que están ao seu dispor son "
"descritas en <xref linkend=\"configuration\"/>."

#. Tag: menuchoice
#: commands.docbook:323
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Toolbar</guimenuitem>"
msgstr "<guimenu>Configuración</guimenu> <guimenuitem>Comutar Barra de Ferramentas</guimenuitem>"

#. Tag: para
#: commands.docbook:327
#, no-c-format
msgid ""
"<action>Toggle on and off the display of the toolbar.</action> "
"The default is on."
msgstr ""
"<action>Mostra ou acocha a barra de ferramentas.</action> "
"Por omisión mostra-a."

#. Tag: title
#: commands.docbook:337
#, no-c-format
msgid "The <guimenu>Help</guimenu> Menu"
msgstr "O Menú <guimenu>Axuda</guimenu>"

#. Tag: para
#: commands.docbook:339
#, no-c-format
msgid ""
"&kmplot; has a standard &kde; <guimenu>Help</guimenu> "
"as described below, with one addition:"
msgstr ""
"&kmplot; ten unha <guimenu>Axuda</guimenu> estándar de &kde; "
"como se descrebe en baixo, mais un engadido:"

#. Tag: menuchoice
#: commands.docbook:344
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>Predefined Math Functions...</guimenuitem>"
msgstr "<guimenu>Axuda</guimenu> <guimenuitem>Función Matemáticas Predefinidas...</guimenuitem>"

#. Tag: para
#: commands.docbook:348
#, no-c-format
msgid ""
"Opens a window with a list of the predefined function names and constants that "
"&kmplot; knows."
msgstr "Abre unha xanela cunha lista de nomes de funcións e constantes predefinidas que &kmplot; coñece."

#. Tag: para
#: commands.docbook:354
#, no-c-format
msgid "The standard &kde; <guimenu>Help</guimenu> entries are:"
msgstr "As entradas de <guimenu>Axuda</guimenu> estándar de &kde; son:"

#. Tag: sect1
#: commands.docbook:354
#, no-c-format
msgid "&help.menu.documentation;"
msgstr "&help.menu.documentation;"

