"session</replaceable></group> <group><option>--all-sessions</option></group> "
"<group><option>--list-sessions</option></group> <group><option>"
"--no-user-time</option></group> <group> <arg><replaceable>"
"application</replaceable></arg> <group> <arg><replaceable>object</replaceable>"
"</arg> <group> <arg choice=\"opt\"><replaceable>function</replaceable></arg> "
"<group><arg choice=\"opt\" rep=\"repeat\"><replaceable>arguments</replaceable>"
"</arg></group> </group> </group> </group>"
