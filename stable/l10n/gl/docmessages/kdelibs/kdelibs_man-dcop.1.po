"sesión</replaceable></group> <group><option>--all-sessions</option></group> "
"<group><option>--list-sessions</option></group> <group><option>"
"--no-user-time</option></group> <group> <arg><replaceable>programa</replaceable>"
"</arg> <group> <arg><replaceable>obxecto</replaceable></arg> <group> "
"<arg choice=\"opt\"><replaceable>función</replaceable></arg> <group>"
"<arg choice=\"opt\" rep=\"repeat\"><replaceable>argumentos</replaceable></arg>"
