#: man-dcop.1.docbook:123
#, no-c-format
msgid "Environment"
msgstr "Contorno"

#. Tag: envar
#: man-dcop.1.docbook:127
#, no-c-format
msgid "DCOPSERVER"
msgstr "DCOPSERVER"

