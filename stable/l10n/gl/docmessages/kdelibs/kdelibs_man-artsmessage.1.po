#. Tag: refpurpose
#: man-artsmessage.1.docbook:22
#, no-c-format
msgid "Utility to display &arts; error messages"
msgstr "Ferramenta para mostrar as mensaxes de erro de &arts;"

#. Tag: cmdsynopsis
#: man-artsmessage.1.docbook:26
#, no-c-format
msgid ""
"<command>artsmessage</command> <group><option>&kde; generic options</option>"
"</group> <group><option>&Qt; generic options</option></group> "
"<group choice=\"opt\"> <option>-e, --error</option><option>"
"-w, --warning</option><option>-i,--info</option> </group> <arg><replaceable>"
"message</replaceable></arg>"
msgstr ""
"<command>artsmessage</command> "
"<group><option>opcións xenéricas de &kde;</option></group> "
"<group><option>opcións xenéricas de &Qt;</option></group> "
"<group choice=\"opt\"> <option>-e, --error</option>"
"<option>-w, --warning</option>"
"<option>-i,--info</option> </group> "
"<arg><replaceable>mensaxe</replaceable></arg>"

#. Tag: title
#: man-artsmessage.1.docbook:39
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-artsmessage.1.docbook:40
#, no-c-format
msgid "<command>artsmessage</command> is a utility to display &arts; error messages."
msgstr ""
"<command>artsmessage</command> é unha ferramenta para mostrar as mensaxes de "
"erro de &arts;."

#. Tag: title
#: man-artsmessage.1.docbook:43
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: para
#: man-artsmessage.1.docbook:45
#, no-c-format
msgid ""
"<command>artsmessage</command> accepts the standard &Qt; and &kde; command-line "
"options."
msgstr ""
"<command>artsmessage</command> aceita as opcións estándar para liña de comandos "
"de &Qt; e &kde;."

#. Tag: title
#: man-artsmessage.1.docbook:52
#, no-c-format
msgid "Application Options"
msgstr "Opcións da Aplicación"

#. Tag: term
#: man-artsmessage.1.docbook:56
#, no-c-format
msgid "<option>-e</option>, <option>--error</option>"
msgstr "<option>-e</option>, <option>--error</option>"

#. Tag: para
#: man-artsmessage.1.docbook:59
#, no-c-format
msgid "Display error message (default)."
msgstr "Mostra unha mensaxe de erro (por omisión)."

#. Tag: term
#: man-artsmessage.1.docbook:63
#, no-c-format
msgid "<option>-i</option>, <option>--info</option>"
msgstr "<option>-i</option>, <option>--info</option>"

#. Tag: para
#: man-artsmessage.1.docbook:66
#, no-c-format
msgid "Display informational message."
msgstr "Mostra unha mensaxe de información."

#. Tag: term
#: man-artsmessage.1.docbook:70
#, no-c-format
msgid "<option>-w</option>, <option>--warning</option>"
msgstr "<option>-w</option>, <option>--warning</option>"

#. Tag: para
#: man-artsmessage.1.docbook:73
#, no-c-format
msgid "Display warning message."
msgstr "Mostra unha mensaxe de advertencia."

