#. Tag: title
#: man-kbuildsycoca.8.docbook:55
#, no-c-format
msgid "<title>Description</title>"
msgstr "<title>Descrición</title>"

#. Tag: para
#: man-kbuildsycoca.8.docbook:57
#, no-c-format
msgid ""
"<command>kbuildsyscoca</command>, as part of the &kde; command line tools "
"ensures the proper operation of &kde; by reading in all the <literal "
"role=\"extension\">.desktop</literal>, <literal role=\"extension\">"
".directory</literal>, <literal role=\"extension\">.kimgio</literal> "
"and <literal role=\"extension\">.protocol</literal> files to constructs a "
"binary database."
msgstr ""
"<command>kbuildsyscoca</command>, como parte das ferramentas de &kde; para a "
"liña de comandos asegura o correcto funcionamento de &kde; lendo todos os "
"ficheiros <literal role=\"extension\">.desktop</literal>"
", <literal role=\"extension\">.directory</literal>, <literal role=\"extension\">"
".kimgio</literal> e <literal role=\"extension\">.protocol</literal> "
"para construir unha base de dados binaria."

#. Tag: para
#: man-kbuildsycoca.8.docbook:67
#, no-c-format
msgid ""
"&kde; itself accesses this databse during operation to provide configurational "
"information a program needs to run."
msgstr ""
"&kde; acede a esta base de dados para fornecer a información da configuración "
"que os programas precisan para o seu funcionamento."

#. Tag: para
#: man-kbuildsycoca.8.docbook:72
#, no-c-format
msgid ""
"This tool is part of ksyscoca, which stands for &kde; System Configuration "
"Cache"
msgstr ""
"Esta ferramenta é parte de ksyscoca, que significa &kde; System Configuration "
"Cache"

