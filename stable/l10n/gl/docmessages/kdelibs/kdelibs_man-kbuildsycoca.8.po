#. Tag: cmdsynopsis
#: man-kbuildsycoca.8.docbook:36
#, no-c-format
msgid ""
"<command>kbuildsycoca</command> <group> <arg choice=\"opt\">--nosignal</arg> "
"<arg choice=\"opt\">--incremental</arg> <arg choice=\"opt\">--help</arg> "
"<arg choice=\"opt\">--help-qt</arg> <arg choice=\"opt\">--help-kde</arg> "
"<arg choice=\"opt\">--help-all</arg> <arg choice=\"opt\">--author</arg> "
"<arg choice=\"opt\">-v, --version</arg> <arg choice=\"opt\">--license</arg> "
"</group>"
