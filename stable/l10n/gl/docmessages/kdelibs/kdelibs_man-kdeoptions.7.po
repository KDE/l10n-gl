#. Tag: refname
#: man-kdeoptions.7.docbook:20
#, no-c-format
msgid "KDE options"
msgstr "Opción de KDE"

#. Tag: refpurpose
#: man-kdeoptions.7.docbook:21
#, no-c-format
msgid ""
"Common commandline options for all applications based on the KDE libraries"
msgstr ""
"Opción comúns para a liña de comandos disponíbeis en todos os programas "
"baseados nas bibliotecas de KDE"

#. Tag: cmdsynopsis
#: man-kdeoptions.7.docbook:25
#, no-c-format
msgid ""
"<command><replaceable>KDE application</replaceable></command> "
"<arg choice=\"opt\">KDE Generic Options</arg>"
msgstr ""
"<command><replaceable>Programa de KDE</replaceable></command> "
"<arg choice=\"opt\">Opcións Xerais de KDE</arg>"

#. Tag: title
#: man-kdeoptions.7.docbook:33
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: para
#: man-kdeoptions.7.docbook:35 man-kdeoptions.7.docbook:38
#, no-c-format
msgid "The following options apply to all &kde; applications:"
msgstr ""
"As seguintes opcións son de aplicación para todos os programas de &kde;:"

#. Tag: term
#: man-kdeoptions.7.docbook:41
#, no-c-format
msgid "<option>--caption</option> <parameter>caption</parameter>"
msgstr "<option>--caption</option> <parameter>título</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:42
#, no-c-format
msgid "Use <parameter>caption</parameter> as name in the titlebar."
msgstr "Usa <parameter>título</parameter> como o nome na barra de título."

#. Tag: term
#: man-kdeoptions.7.docbook:46
#, no-c-format
msgid "<option>--icon</option> <parameter>icon</parameter>"
msgstr "<option>--icon</option> <parameter>ícone</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:47
#, no-c-format
msgid "Use <parameter>icon</parameter> as the application icon."
msgstr "Usa <parameter>ícone</parameter> como o ícone do programa."

#. Tag: term
#: man-kdeoptions.7.docbook:50
#, no-c-format
msgid "<option>--miniicon</option> <parameter>icon</parameter>"
msgstr "<option>--miniicon</option> <parameter>ícone</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:51
#, no-c-format
msgid "Use <parameter>icon</parameter> as the icon in the titlebar"
msgstr "Usa <parameter>ícone</parameter> como o ícone da barra de título"

#. Tag: term
#: man-kdeoptions.7.docbook:54
#, no-c-format
msgid "<option>--dcopserver</option> <parameter>server</parameter>"
msgstr "<option>--dcopserver</option> <parameter>servidor</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:55
#, no-c-format
msgid ""
"Use the <acronym>DCOP</acronym> Server specified by <parameter>"
"server</parameter>."
msgstr ""
"Usa o Servidor <acronym>DCOP</acronym> indicado en <parameter>"
"servidor</parameter>."

#. Tag: option
#: man-kdeoptions.7.docbook:58
#, no-c-format
msgid "--nocrashhandler"
msgstr "--nocrashhandler"

#. Tag: para
#: man-kdeoptions.7.docbook:59
#, no-c-format
msgid "Disable the crash handler, to get core dumps."
msgstr "Desactiva o xestor de estoupidos, para obter core dumps."

#. Tag: option
#: man-kdeoptions.7.docbook:62
#, no-c-format
msgid "--waitforwm"
msgstr "--waitforwm"

#. Tag: para
#: man-kdeoptions.7.docbook:63
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager."
msgstr "Espera un xestor de fiestras compatíbel con WM_NET."

#. Tag: term
#: man-kdeoptions.7.docbook:66
#, no-c-format
msgid "<option>--style</option> <parameter>style</parameter>"
msgstr "<option>--style</option> <parameter>estilo</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:67
#, no-c-format
msgid "Sets the appliction &GUI; style."
msgstr "Dálle ese estilo de &GUI; ao programa."

#. Tag: term
#: man-kdeoptions.7.docbook:70
#, no-c-format
msgid "<option>--geometry</option> <parameter>geometry</parameter>"
msgstr "<option>--geometry</option> <parameter>xeometría</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:71
#, no-c-format
msgid "Sets the client geometry of the main widget."
msgstr "Estabelece a xeometría do elemento ou fiestra principal do cliente."

