  <refmeta>
    <refentrytitle
><command
>artsmessage</command
></refentrytitle>
    <manvolnum
>1</manvolnum>
  </refmeta>

  <refnamediv>
    <refname
><command
>artsmessage</command
></refname>
    <refpurpose
>Ferramenta para mostrar as mensaxes de erro de &arts;</refpurpose>
  </refnamediv>

  <refsynopsisdiv>
    <cmdsynopsis
><command
>artsmessage</command
> <group
><option
>opcións xenéricas de &kde;</option
></group
> <group
><option
>opcións xenéricas de &Qt;</option
></group
> <group choice="opt"
> <option
>-e, --error</option
><option
>-w, --warning</option
><option
>-i,--info</option
> </group
> <arg
><replaceable
>mensaxe</replaceable
></arg
> </cmdsynopsis>
  </refsynopsisdiv>

  <refsect1>
    <title
>Descrición</title>
    <para
><command
>artsmessage</command
> é unha ferramenta para mostrar as mensaxes de erro de &arts;.</para>
  </refsect1>
  <refsect1>
    <title
>Opcións</title>

    <para
><command
>artsmessage</command
> aceita as opcións estándar para liña de comandos de &Qt; e &kde;.</para>


  </refsect1>

  <refsect1>
    <title
>Opcións da Aplicación</title>

    <variablelist>
      <varlistentry>
        <term
><option
>-e</option
>, <option
>--error</option
> </term>
        <listitem>
          <para
>Mostra unha mensaxe de erro (por omisión).</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term
><option
>-i</option
>, <option
>--info</option
> </term>
        <listitem>
          <para
>Mostra unha mensaxe de información.</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term
><option
>-w</option
>, <option
>--warning</option
> </term>
        <listitem>
          <para
>Mostra unha mensaxe de advertencia.</para>
        </listitem>
      </varlistentry>
    </variablelist>
  </refsect1>
