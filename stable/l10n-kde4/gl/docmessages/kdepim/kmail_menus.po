"<guisubmenu>Reply Special</guisubmenu> <guimenuitem>Reply to Mailing-List..."
"</guimenuitem>"
msgstr ""
"<shortcut><keycap>L</keycap></shortcut> <guimenu>Mensaxe</guimenu> "
"<guimenuitem>Respostar a Lista de Correo...</guimenuitem>"

#. Tag: para
