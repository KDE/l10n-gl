#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Attach File...</guimenuitem>"
msgstr ""
"<guimenu>Xuntar</guimenu> <guimenuitem>Engadir Ficheiro...</guimenuitem>"

