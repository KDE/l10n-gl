msgstr "Grava o anexo seleccionado na xanela de anexos nun ficheiro."

#. Tag: menuchoice
#: menus.docbook:2045
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attachment Properties</guimenuitem>"
msgstr ""
"<guimenu>Xuntar</guimenu> <guimenuitem>Propiedades do Anexo</guimenuitem>"

