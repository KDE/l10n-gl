#. Tag: date
#: man-amor.6.docbook:10
#, no-c-format
msgid "March 7, 2003"
msgstr "7 de marzo de 2003"

#. Tag: manvolnum
#: man-amor.6.docbook:15
#, no-c-format
msgid "<manvolnum>6</manvolnum>"
msgstr "<manvolnum>6</manvolnum>"

#. Tag: refpurpose
#: man-amor.6.docbook:20
#, no-c-format
msgid "A &kde; creature for your desktop"
msgstr "Criatura de KDE para o escritorio."

#. Tag: cmdsynopsis
#: man-amor.6.docbook:24
#, no-c-format
msgid ""
"<command>amor</command> <group><option>KDE Generic Options</option></group> "
"<group><option>Qt Generic Options</option></group>"
msgstr ""
"<command>amor</command> <group><option>opcións xenéricas de KDE</option></"
"group> <group><option>opcións xenéricas de Qt</option></group>"

#. Tag: title
#: man-amor.6.docbook:32
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-amor.6.docbook:34
#, no-c-format
msgid ""
"<acronym>AMOR</acronym> stands for <quote>Amusing Misuse Of Resources</"
"quote>. It provides several different characters who prance around your X "
"screen doing tricks and giving you tips."
msgstr ""
"<acronym>AMOR</acronym> son as siglas en inglés de «uso incorrecto pero "
"entretido dos recursos». Fornece varias personaxes distintas que se pasean "
"pola pantalla facendo trucos e dándolle consellos."

#. Tag: para
#: man-amor.6.docbook:38
#, no-c-format
msgid "&amor; is part of the &kde; toys package."
msgstr "&amor; forma parte do paquete de xoguetes de &kde;."

#. Tag: title
#: man-amor.6.docbook:43
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: para
#: man-amor.6.docbook:45
#, no-c-format
msgid ""
"&amor; is configured graphically, and does not have any commandline options "
"other than the standard &kde; and &Qt; options."
msgstr ""
"&amor; pode configurarse de maneira gráfica, e non fornece ningunha opción "
"da liña de ordes aparte das opcións estándar de &kde; e &Qt;."

#. Tag: title
#: man-amor.6.docbook:52
#, no-c-format
msgid "See Also"
msgstr "Véxase tamén"

#. Tag: para
#: man-amor.6.docbook:54
#, no-c-format
msgid ""
"Within &kde; you can enter <userinput>help:/amor</userinput> in &konqueror; "
"to see the comprehensive user manual."
msgstr ""
"Pode escribir <userinput>help:/amor</userinput> en &konqueror; para acceder "
"ao manual de usuario."

#. Tag: title
#: man-amor.6.docbook:61
#, no-c-format
msgid "Bugs"
msgstr "Erros"

#. Tag: para
#: man-amor.6.docbook:63
#, no-c-format
msgid "&amor; currently only works with the &kwin; window manager."
msgstr "Actualmente &amor; funciona unicamente co xestor de xanelas &kwin;."

#. Tag: title
#: man-amor.6.docbook:67
#, no-c-format
msgid "Authors"
msgstr "Autores"

#. Tag: para
#: man-amor.6.docbook:68
#, no-c-format
msgid ""
"&amor; was written by <personname><firstname>Martin</firstname><othername>R."
"</othername><surname>Jones</surname></personname> <email>mjones@kde.org</"
"email>. This manual page was prepared by <personname><firstname>Ben</"
"firstname><surname>Burton</surname></personname> <email>bab@debian.org</"
"email> for the Debian GNU/Linux system (but may be used by others)."
msgstr ""
"&amor; é obra de <personname><firstname>Martin</firstname><othername>R.</"
"othername><surname>Jones</surname></personname> <email>mjones@kde.org</"
"email>. Esta páxina do manual preparouna <personname><firstname>Ben</"
"firstname><surname>Burton</surname></personname> <email>bab@debian.org</"
"email> para o sistema Debian GNU/Linux, se ben pode accederse noutros "
"sistemas."
