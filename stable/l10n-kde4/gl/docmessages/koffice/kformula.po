"<guimenu>Element</guimenu> <guisubmenu>Matrix</guisubmenu> "
"<guimenuitem>Insert Column</guimenuitem>"
msgstr ""
"<guimenu>Elemento</guimenu> <guisubmenu>Matriz</guisubmenu> "
"<guimenuitem>Inserir Coluna</guimenuitem>"

