"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo> </"
"shortcut> <guimenu>Element</guimenu> <guisubmenu>Add</guisubmenu> "
"<guimenuitem>Add Lower Index</guimenuitem>"
