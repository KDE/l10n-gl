#: index.docbook:637
#, no-c-format
msgid ""
"Inserts a column in an existing matrix. The column is inserted where the "
"cursor is at."
msgstr ""
"Insere unha coluna nunha matriz que xa existe. A coluna será inserida na "
"posición do cursor."

