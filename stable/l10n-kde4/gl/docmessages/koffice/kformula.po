#: index.docbook:698
#, no-c-format
msgid "Allows insertion of various delimiters &ie; (, {, and [."
msgstr "Permite inserir varios delimitadores &ie; (, {, e [."

#. Tag: menuchoice
#: index.docbook:703
#, no-c-format
msgid "<guimenu>Element</guimenu> <guimenuitem>Right Delimiter</guimenuitem>"
msgstr ""
"<guimenu>Elemento</guimenu> <guimenuitem>Delimitador Direito</guimenuitem>"

