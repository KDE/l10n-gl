#: index.docbook:677
#, no-c-format
msgid ""
"<guimenu>Element</guimenu> <guisubmenu>Matrix</guisubmenu> "
"<guimenuitem>Remove Row</guimenuitem>"
msgstr ""
"<guimenu>Elemento</guimenu> <guisubmenu>Matriz</guisubmenu> "
"<guimenuitem>Elimnar Fila</guimenuitem>"

