#: index.docbook:668
#, no-c-format
msgid ""
"<guimenu>Element</guimenu> <guisubmenu>Matrix</guisubmenu> "
"<guimenuitem>Append Row</guimenuitem>"
msgstr ""
"<guimenu>Elemento</guimenu> <guisubmenu>Matriz</guisubmenu> "
"<guimenuitem>Engadir Fila</guimenuitem>"

