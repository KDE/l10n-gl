#: index.docbook:595
#, no-c-format
msgid ""
"<guimenu>Element</guimenu> <guisubmenu>Add</guisubmenu> <guimenuitem>Add "
"Thin Space</guimenuitem>"
msgstr ""
"<guimenu>Elemento</guimenu> <guisubmenu>Engadir</guisubmenu> "
"<guimenuitem>Engadir Espazo Curto</guimenuitem>"

