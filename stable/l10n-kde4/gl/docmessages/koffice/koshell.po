"guimenuitem>"

#. Tag: action
#: index.docbook:328
#, no-c-format
msgid "View the current document as it will be printed."
msgstr "Visiona o documento actual como quedará ao ser impreso."

#. Tag: menuchoice
#: index.docbook:333
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Document Information</guimenuitem>"
msgstr ""
"<guimenu>Ficheiro</guimenu> <guimenuitem>Información do Documento</"
"guimenuitem>"

#. Tag: action
#: index.docbook:337
#, no-c-format
msgid "View or enter information about the current document and author."
msgstr "Ve ou introduce información acerca do documento actual e do seu autor."

#. Tag: menuchoice
#: index.docbook:343
