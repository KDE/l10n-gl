msgstr "<guimenu>Ficheiro</guimenu> <guimenuitem>Guardar Todo</guimenuitem>"

#. Tag: para
#: index.docbook:308
#, no-c-format
msgid "Saves all open documents in &koffice; Workspace."
msgstr "Guarda todos os documentos aberto na área de traballo de &koffice;."

