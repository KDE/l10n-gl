#. Tag: title
#: index.docbook:175
#, no-c-format
msgid "Installation"
msgstr "Instalación"

#. Tag: para
#: index.docbook:177
#, no-c-format
msgid ""
"&kspread; is part of &kde;'s &koffice; package and uses various &koffice; "
"libraries. &koffice; itself is part of &kde; and depends on the general "
"&kde; libraries."
msgstr ""
"&kspread; forma parte do paquete &koffice; de &kde; e usa varias das "
"bibliotecas de &koffice;. &koffice; en si é parte de &kde; e depende das "
"bibliotecas xerais de &kde;."

#. Tag: para
#: index.docbook:180
#, no-c-format
msgid ""
"For instructions on acquiring and installing &kde;, &koffice; and &kspread; "
"please visit <ulink url=\"http://www.kde.org\">http://www.kde.org</ulink> "
"and <ulink url=\"http://www.koffice.org\">http://www.koffice.org</ulink>."
msgstr ""
"Para obter instrucións acerca da obtención e instalación de &kde;, &koffice; "
"e &kspread; visite <ulink url=\"http://www.kde.org\">http://www.kde.org</"
"ulink> e <ulink url=\"http://www.koffice.org\">http://www.koffice.org</"
"ulink>."

