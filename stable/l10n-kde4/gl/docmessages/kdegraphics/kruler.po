"guisubmenu> <guimenuitem>Leste</guimenuitem>"

#. Tag: para
#: index.docbook:145
#, no-c-format
msgid ""
"Turns &kruler; so the ruler is vertical, and the measurements are on the "
"right (East) of the ruler"
msgstr ""
"Xira o &kruler; para que a regra sexa vertical e as medidas están na dereita "
"(Leste) da regra)"

#. Tag: menuchoice
#: index.docbook:151
#, no-c-format
msgid ""
"<shortcut> <keycap>S</keycap> </shortcut> <guisubmenu>Orientation</"
"guisubmenu> <guimenuitem>South</guimenuitem>"
