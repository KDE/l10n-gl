msgid "Orientation"
msgstr "Orientación"

#. Tag: para
#: index.docbook:115
#, no-c-format
msgid ""
"This submenu contains entries that allow you to change the orientation of "
"&kruler;"
msgstr ""
"Este submenú contén entradas que permiten mudar a orientación do &kruler;"

#. Tag: menuchoice
#: index.docbook:121
#, no-c-format
msgid ""
"<shortcut> <keycap>N</keycap> </shortcut> <guisubmenu>Orientation</"
