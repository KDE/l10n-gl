#. Tag: title
#: man-kross.1.docbook:34
#, no-c-format
msgid "Synopsis"
msgstr "Resumo"

#. Tag: cmdsynopsis
#: man-kross.1.docbook:36
#, no-c-format
msgid ""
"<command>kross</command> <arg choice=\"opt\">--help</arg> <arg choice=\"opt"
"\">Generic-options</arg> <arg choice=\"opt\">Qt-options</arg> <arg choice="
"\"opt\">KDE-options</arg> <arg choice=\"opt\">file ...</arg>"
msgstr ""
"<command>kross</command> <arg choice=\"opt\">--help</arg> <arg choice=\"opt"
"\">Opcións xenéricas</arg> <arg choice=\"opt\">Opcións de Qt</arg> <arg "
"choice=\"opt\">Opcións de KDE</arg> <arg choice=\"opt\">ficheiro …</arg>"

#. Tag: title
#: man-kross.1.docbook:48
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-kross.1.docbook:50
#, no-c-format
msgid ""
"<command>kross</command> executes kross scripts written in &kde; Javascript, "
"Python, Ruby, Java and Falcon."
msgstr ""
"<command>kross</command> executa scripts de kross escritos en &kde; "
"Javascript, Python, Ruby, Java e Falcon."

