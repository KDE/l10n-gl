msgstr "--help-all"

#. Tag: para
#: man-kross.1.docbook:76
#, no-c-format
msgid "Show all options."
msgstr "Mostra todas as opcións."

#. Tag: option
#: man-kross.1.docbook:81
#, no-c-format
msgid "--help-kde"
msgstr "--help-kde"

#. Tag: para
#: man-kross.1.docbook:83
