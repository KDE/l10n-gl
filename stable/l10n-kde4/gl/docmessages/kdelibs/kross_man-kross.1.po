msgstr "Mostra información da versión"

#. Tag: title
#: man-kross.1.docbook:115
#, no-c-format
msgid "Application Options"
msgstr "Opcións do aplicativo"

#. Tag: term
#: man-kross.1.docbook:119
#, no-c-format
msgid "<option>file</option>..."
msgstr "<option>ficheiro</option>…"

#. Tag: para
#: man-kross.1.docbook:121
#, no-c-format
msgid "The files with the scripts to run."
msgstr "Os ficheiros cos scripts que se van executar."

#. Tag: title
#: man-kross.1.docbook:131
#, no-c-format
msgid "Usage"
msgstr "Utilización"

#. Tag: para
#: man-kross.1.docbook:132
#, no-c-format
msgid ""
"<command>kross</command> <parameter>file</parameter> runs the script in "
"<parameter>file</parameter> after loading the interpreter plugin for the "
"script language (detected by filename suffix)."
msgstr ""
"<command>kross</command> <parameter>ficheiro</parameter> executa o script "
"contido no <parameter>ficheiro</parameter>despois de cargar o complemento co "
"intérprete da linguaxe do script (detéctase pola extensión no nome do "
"ficheiro)."

#. Tag: para
#: man-kross.1.docbook:136
#, no-c-format
msgid ""
"To interpret other languages than &kde; Javascript, "
"<replaceable>kdebindings</replaceable> must be installed."
msgstr ""
"Para interpretar outras linguaxes que non sexan &kde; Javascript, debe ter "
"instalados os <replaceable>kdebindings</replaceable>."

