msgid "Authors"
msgstr "Autores"

#. Tag: para
#: man-kdeoptions.7.docbook:78
#, no-c-format
msgid "Man page written by &Lauri.Watts; &Lauri.Watts.mail;"
msgstr "Páxina de manual escrita por &Lauri.Watts; &Lauri.Watts.mail;"

