#. Tag: refpurpose
#: man-kdeoptions.7.docbook:21
#, no-c-format
msgid ""
"Common commandline options for all applications based on the KDE libraries"
msgstr ""
"Opción comúns para a liña de comandos disponíbeis en todos os aplicativos "
"baseados nas bibliotecas de KDE"

#. Tag: cmdsynopsis
#: man-kdeoptions.7.docbook:25
#, no-c-format
msgid ""
"<command><replaceable>KDE application</replaceable></command> <arg choice="
"\"opt\">KDE Generic Options</arg>"
msgstr ""
"<command><replaceable>Aplicativo de KDE</replaceable></command> <arg choice="
"\"opt\">Opcións xerais de KDE</arg>"

#. Tag: title
#: man-kdeoptions.7.docbook:33
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: para
#: man-kdeoptions.7.docbook:35
#, no-c-format
msgid "The following options apply to all &kde; applications:"
msgstr ""
"As seguintes opcións son de aplicación para todos os aplicativos de &kde;:"

#. Tag: term
#: man-kdeoptions.7.docbook:38
#, no-c-format
msgid "<option>--caption</option> <parameter>caption</parameter>"
msgstr "<option>--caption</option> <parameter>título</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:39
#, no-c-format
msgid "Use <parameter>caption</parameter> as name in the titlebar."
msgstr "Usa <parameter>título</parameter> como o nome na barra de título."

#. Tag: term
#: man-kdeoptions.7.docbook:43
#, no-c-format
msgid "<option>--icon</option> <parameter>icon</parameter>"
msgstr "<option>--icon</option> <parameter>ícone</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:44
#, no-c-format
msgid "Use <parameter>icon</parameter> as the application icon."
msgstr "Usa <parameter>ícone</parameter> como o ícone do aplicativo."

#. Tag: term
#: man-kdeoptions.7.docbook:47
#, no-c-format
msgid "<option>--config</option> <parameter>filename</parameter>"
msgstr "<option>--config</option> <parameter>ficheiro</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:48
#, no-c-format
msgid "Use the alternative configuration <parameter>filename</parameter>"
msgstr "Usa un ficheiro de configuración <parameter>alternativo</parameter>"

#. Tag: option
#: man-kdeoptions.7.docbook:51
#, no-c-format
msgid "--nocrashhandler"
msgstr "--nocrashhandler"

#. Tag: para
#: man-kdeoptions.7.docbook:52
#, no-c-format
msgid "Disable the crash handler, to get core dumps."
msgstr "Deshabilita o xestor de peches inesperados, para obter emborcados."

#. Tag: option
#: man-kdeoptions.7.docbook:55
#, no-c-format
msgid "--waitforwm"
msgstr "--waitforwm"

#. Tag: para
#: man-kdeoptions.7.docbook:56
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager."
msgstr "Espera un xestor de xanelas compatíbel con WM_NET."

#. Tag: term
#: man-kdeoptions.7.docbook:59
#, no-c-format
msgid "<option>--style</option> <parameter>style</parameter>"
msgstr "<option>--style</option> <parameter>estilo</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:60
#, fuzzy, no-c-format
#| msgid "Sets the appliction &GUI; style."
msgid "Sets the application &GUI; style."
msgstr "Dálle ese estilo de &GUI; ao aplicativo."

#. Tag: term
#: man-kdeoptions.7.docbook:63
#, no-c-format
msgid "<option>--geometry</option> <parameter>geometry</parameter>"
msgstr "<option>--geometry</option> <parameter>xeometría</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:64
#, no-c-format
msgid "Sets the client geometry of the main widget."
msgstr "Estabelece a xeometría do elemento ou xanela principal do cliente."

#. Tag: title
#: man-kdeoptions.7.docbook:71
#, no-c-format
msgid "See Also"
msgstr "Consulte tamén"

