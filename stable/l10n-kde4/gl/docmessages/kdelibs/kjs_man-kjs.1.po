#: man-kjs.1.docbook:188
#, no-c-format
msgid "Bugs"
msgstr "Erros"

#. Tag: para
#: man-kjs.1.docbook:189
#, no-c-format
msgid ""
"There are probably tons of bugs. Use <ulink url=\"http://bugs.kde.org\">bugs."
"kde.org</ulink> to report them."
msgstr ""
"Probabelmente haxa moitísimos erros. Use <ulink url=\"http://bugs.kde.org"
"\">bugs.kde.org</ulink> para informar deles."
