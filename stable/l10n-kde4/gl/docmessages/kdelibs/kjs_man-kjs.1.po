#. Tag: title
#: man-kjs.1.docbook:35
#, no-c-format
msgid "Synopsis"
msgstr "Resumo"

#. Tag: cmdsynopsis
#: man-kjs.1.docbook:37
#, no-c-format
msgid ""
"<command>kjs</command> <group> <arg choice=\"opt\">--help</arg> <arg choice="
"\"opt\">-help</arg> <arg choice=\"opt\">-h</arg> </group> <group> <arg "
"choice=\"opt\">-e<replaceable> statement</replaceable></arg> </group> "
"<group> <arg choice=\"plain\"><replaceable>script</replaceable></arg> </"
"group>"
msgstr ""
"<command>kjs</command> <group> <arg choice=\"opt\">--help</arg> <arg choice="
"\"opt\">-help</arg> <arg choice=\"opt\">-h</arg> </group> <group> <arg "
"choice=\"opt\">-e<replaceable> sentenza</replaceable></arg> </group> <group> "
"<arg choice=\"plain\"><replaceable>script</replaceable></arg> </group>"

#. Tag: title
#: man-kjs.1.docbook:60
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-kjs.1.docbook:62
#, no-c-format
msgid "<command>kjs</command> is KDE ECMAScript/JavaScript engine."
msgstr "<command>kjs</command> é o motor de ECMAScript/JavaScript para KDE."

#. Tag: title
#: man-kjs.1.docbook:141
#, no-c-format
msgid "Application Options"
msgstr "Opcións do aplicativo"

#. Tag: term
#: man-kjs.1.docbook:145
#, no-c-format
msgid "<option>--help</option>,<option>-help</option>,<option>-h</option>"
msgstr "<option>--help</option>,<option>-help</option>,<option>-h</option>"

#. Tag: para
#: man-kjs.1.docbook:147
#, no-c-format
msgid "Show <command>kjscmd</command> usage."
msgstr "Mostra o uso de <command>kjscmd</command>."

#. Tag: term
#: man-kjs.1.docbook:154
#, no-c-format
msgid "<option>-e</option><parameter> statement</parameter>"
msgstr "<option>-e</option><parameter> sentenza</parameter>"

#. Tag: para
#: man-kjs.1.docbook:156
#, no-c-format
msgid "Executes the statement and exits. For example:"
msgstr "Executa a sentenza e sae. Por exemplo:"

#. Tag: screen
#: man-kjs.1.docbook:157
#, no-c-format
msgid "<command>kjs</command> -e \"print('hello world')\""
msgstr "<command>kjs</command> -e \"print('Ola mundo')\""

#. Tag: parameter
#: man-kjs.1.docbook:162
#, no-c-format
msgid "script"
msgstr "script"

#. Tag: para
#: man-kjs.1.docbook:164
#, no-c-format
msgid "Executes the statements included in file <parameter>script</parameter>."
msgstr ""
"Executa as sentenzas incluídas no ficheiro <parameter>script</parameter>."

#. Tag: title
#: man-kjs.1.docbook:173
#, no-c-format
msgid "Usage"
msgstr "Utilización"

#. Tag: para
#: man-kjs.1.docbook:174
#, no-c-format
msgid ""
"<command>kjs</command> <parameter>file</parameter>, as many other "
"interpreters, when called without parameters uses a line editor to enter "
"statements, showing the prompt <literallayout>JS></literallayout> To exit "
"the line editor type <command>quit()</command> or press <command>Ctrl+D</"
"command>."
msgstr ""
"<command>kjs</command> <parameter>ficheiro</parameter>, como moitos outros "
"intérpretes, cando se executa sen parámetros uses un editor de liñas para "
"inserir as sentenzas, neste caso co indicador do sistema  "
"<literallayout>JS></literallayout>. Para saír do editor escriba "
"<command>quit()</command> ou prema <command>Ctrl+D</command>."

