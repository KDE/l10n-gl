#. Tag: title
#: man-makekdewidgets.1.docbook:9
#, no-c-format
msgid "Programming Tool"
msgstr "Ferramenta de programación"

#. Tag: author
#: man-makekdewidgets.1.docbook:11
#, no-c-format
msgid ""
"<firstname>Ian</firstname> <othername>Reinhart</othername> <surname>Geiser</"
"surname>"
msgstr ""
"<firstname>Ian</firstname> <othername>Reinhart</othername> <surname>Geiser</"
"surname>"

#. Tag: email
#: man-makekdewidgets.1.docbook:17
#, no-c-format
msgid "geiseri@kde.org"
msgstr "geiseri@kde.org"

#. Tag: date
#: man-makekdewidgets.1.docbook:22
#, no-c-format
msgid "2006-06-01"
msgstr "2006-06-01"

#. Tag: productname
#: man-makekdewidgets.1.docbook:23
#, no-c-format
msgid "K Desktop Environment"
msgstr "O ambiente de escritorio K"

#. Tag: manvolnum
#: man-makekdewidgets.1.docbook:30
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr "<manvolnum>1</manvolnum>"

#. Tag: refname
#: man-makekdewidgets.1.docbook:34
#, no-c-format
msgid "<refname>makekdewidgets</refname>"
msgstr "<refname>makekdewidgets</refname>"

#. Tag: refpurpose
#: man-makekdewidgets.1.docbook:35
#, no-c-format
msgid "Builds &Qt; widget plugins from an ini style description file."
msgstr ""
"Contrúe extensións de trebello de &Qt; a partir dun ficheiro de descrición "
"ao estilo ini."

#. Tag: cmdsynopsis
#: man-makekdewidgets.1.docbook:41
#, no-c-format
msgid ""
"<command>makekdewidgets</command> <arg>&Qt;-options</arg> <arg>&kde;-"
"options</arg> <arg choice=\"plain\"><replaceable>file</replaceable></arg>"
msgstr ""
"<command>makekdewidgets</command> <arg>Opcións de &Qt;</arg> <arg>Opcións de "
"&kde;</arg> <arg choice=\"plain\"><replaceable>ficheiro</replaceable></arg>"

#. Tag: title
#: man-makekdewidgets.1.docbook:50
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-makekdewidgets.1.docbook:51
#, no-c-format
msgid ""
"<command>makekdewidgets</command> builds &Qt; widget plugins from an ini "
"style description file."
msgstr ""
"<command>makekdewidgets</command> constrúe extensións de trebello de &Qt; a "
"partir dun ficheiro de descrición con estilo ini."

#. Tag: title
#: man-makekdewidgets.1.docbook:57
#, no-c-format
msgid "Options"
msgstr "Opcións"

#. Tag: emphasis
#: man-makekdewidgets.1.docbook:61
#, no-c-format
msgid "Arguments:"
msgstr "Argumentos:"

#. Tag: replaceable
#: man-makekdewidgets.1.docbook:64
#, no-c-format
msgid "file"
msgstr "ficheiro"

#. Tag: para
#: man-makekdewidgets.1.docbook:67
#, no-c-format
msgid "Input file"
msgstr "Ficheiro de entrada"

#. Tag: emphasis
#: man-makekdewidgets.1.docbook:75
#, no-c-format
msgid "Options:"
msgstr "Opcións:"

#. Tag: option
#: man-makekdewidgets.1.docbook:78
#, no-c-format
msgid "-o &lt;file&gt;"
msgstr "-o &lt;ficheiro&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:81
#, no-c-format
msgid "Output file"
msgstr "Ficheiro de saída"

#. Tag: option
#: man-makekdewidgets.1.docbook:86
#, no-c-format
msgid "-n &lt;plugin name&gt;"
msgstr "-n &lt;nome da extensión&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:89
#, no-c-format
msgid "Name of the plugin class to generate [WidgetsPlugin]"
msgstr "O nome da clase da extensión a xerar [WidgetsPlugin]"

#. Tag: option
#: man-makekdewidgets.1.docbook:94
#, no-c-format
msgid "-g &lt;group&gt;"
msgstr "-g &lt;grupo&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:97
#, no-c-format
msgid "Default widget group name to display in designer [Custom]"
msgstr ""
"O nome do grupo predeterminado do trebello a mostrar no designer [Custom]"

#. Tag: option
#: man-makekdewidgets.1.docbook:102
#, no-c-format
msgid "-p &lt;pixmap dir&gt;"
msgstr "-p &lt;dir mapa de píxeles&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:105
#, no-c-format
msgid "Embed pixmaps from a source directory"
msgstr "Inclúe mapas de píxeles dun directorio fonte"

#. Tag: emphasis
#: man-makekdewidgets.1.docbook:113
#, no-c-format
msgid "Generic options:"
msgstr "Opcións xenéricas:"

#. Tag: option
#: man-makekdewidgets.1.docbook:117
#, no-c-format
msgid "--help"
msgstr "--help"

#. Tag: para
#: man-makekdewidgets.1.docbook:120
#, no-c-format
msgid "Show help about options"
msgstr "Mostrar axuda acerca das opcións"

#. Tag: option
#: man-makekdewidgets.1.docbook:126
#, no-c-format
msgid "--help-qt"
msgstr "--help-qt"

#. Tag: para
#: man-makekdewidgets.1.docbook:129
#, no-c-format
msgid "Show &Qt; specific options"
msgstr "Mostra as opcións específicas de &Qt;"

#. Tag: option
#: man-makekdewidgets.1.docbook:135
#, no-c-format
msgid "--help-kde"
msgstr "--help-kde"

#. Tag: para
#: man-makekdewidgets.1.docbook:138
#, no-c-format
msgid "Show &kde; specific options"
msgstr "Mostra as opcións específicas de &kde;"

#. Tag: option
#: man-makekdewidgets.1.docbook:144
#, no-c-format
msgid "--help-all"
msgstr "--help-all"

#. Tag: para
#: man-makekdewidgets.1.docbook:147
#, no-c-format
msgid "Show all options"
msgstr "Mostra todas as opcións"

#. Tag: option
#: man-makekdewidgets.1.docbook:153
#, no-c-format
msgid "--author"
msgstr "--author"

#. Tag: para
#: man-makekdewidgets.1.docbook:156
#, no-c-format
msgid "Show author information"
msgstr "Mostra información do autor"

#. Tag: option
#: man-makekdewidgets.1.docbook:162
#, no-c-format
msgid "-v, --version"
msgstr "-v, --version"

#. Tag: para
#: man-makekdewidgets.1.docbook:165
#, no-c-format
msgid "Show version information"
msgstr "Mostra información da versión"

#. Tag: option
#: man-makekdewidgets.1.docbook:171
#, no-c-format
msgid "--license"
msgstr "--license"

#. Tag: para
#: man-makekdewidgets.1.docbook:174
#, no-c-format
msgid "Show license information"
msgstr "Mostra información da licenza"

#. Tag: emphasis
#: man-makekdewidgets.1.docbook:182
#, no-c-format
msgid "&kde; Options:"
msgstr "Opcións de &kde;:"

#. Tag: option
#: man-makekdewidgets.1.docbook:186
#, no-c-format
msgid "--caption &lt;caption&gt;"
msgstr "--caption &lt;título&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:189
#, no-c-format
msgid "Use 'caption' as name in the titlebar"
msgstr "Usa \"título\" como o nome na barra do título"

#. Tag: option
#: man-makekdewidgets.1.docbook:195
#, no-c-format
msgid "--icon &lt;icon&gt;"
msgstr "--icon &lt;ícone&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:198 man-makekdewidgets.1.docbook:207
#, no-c-format
msgid "Use 'icon' as the application icon"
msgstr "Usa \"ícone\" como o ícone do programa"

#. Tag: option
#: man-makekdewidgets.1.docbook:204
#, no-c-format
msgid "--miniicon &lt;icon&gt;"
msgstr "--miniicon &lt;ícone&gt;"

#. Tag: option
#: man-makekdewidgets.1.docbook:213
#, no-c-format
msgid "--config &lt;filename&gt;"
msgstr "--config &lt;nomeFicheiro&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:216
#, no-c-format
msgid "Use alternative configuration file"
msgstr "Usa un ficheiro de configuración alternativo"

#. Tag: option
#: man-makekdewidgets.1.docbook:222
#, no-c-format
msgid "--dcopserver &lt;server&gt;"
msgstr "--dcopserver &lt;servidor&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:225
#, no-c-format
msgid "Use the &DCOP; server specified by 'server'"
msgstr "Usa o servidor &DCOP; especificado por \"servidor\""

#. Tag: option
#: man-makekdewidgets.1.docbook:231
#, no-c-format
msgid "--nocrashhandler"
msgstr "--nocrashhandler"

#. Tag: para
#: man-makekdewidgets.1.docbook:234
#, no-c-format
msgid "Disable crash handler to get core dumps"
msgstr ""
"Deshabilita o xestor de peches inesperados para opter emborcados de memoria"

#. Tag: option
#: man-makekdewidgets.1.docbook:240
#, no-c-format
msgid "--waitforwm"
msgstr "--waitforwm"

#. Tag: para
#: man-makekdewidgets.1.docbook:243
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager"
msgstr "Agarda por un xestor de xanelas compatíbel con WM_NET"

#. Tag: option
#: man-makekdewidgets.1.docbook:249
#, no-c-format
msgid "--style &lt;style&gt;"
msgstr "--style &lt;estilo&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:252
#, no-c-format
msgid "Sets the application &GUI; style"
msgstr "Estabelece o estilo da &GUI; do programa"

#. Tag: option
#: man-makekdewidgets.1.docbook:258
#, no-c-format
msgid "--geometry &lt;geometry&gt;"
msgstr "--geometry &lt;xeometría&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:261
#, no-c-format
msgid ""
"Sets the client geometry of the main widget - see man X for the argument "
"format"
msgstr ""
"Estabelece da xeometría do trebello principal - consulte man X para saber "
"máis acerca do formato do argumento"

#. Tag: emphasis
#: man-makekdewidgets.1.docbook:269
#, no-c-format
msgid "&Qt; options:"
msgstr "Opcións de &Qt;:"

#. Tag: option
#: man-makekdewidgets.1.docbook:273
#, no-c-format
msgid "--display &lt;displayname&gt;"
msgstr "--display &lt;nomePantalla&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:276
#, no-c-format
msgid "Use the X-server display 'displayname'"
msgstr "Usa o display \"nomePantalla\" do servidor X"

#. Tag: option
#: man-makekdewidgets.1.docbook:282
#, no-c-format
msgid "--session &lt;sessionId&gt;"
msgstr "--session &lt;idSesion&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:285
#, no-c-format
msgid "Restore the application for the given 'sessionId'"
msgstr "Restaura o programa co \"idSesión\" indicado"

#. Tag: option
#: man-makekdewidgets.1.docbook:291
#, no-c-format
msgid "--cmap"
msgstr "--cmap"

#. Tag: para
#: man-makekdewidgets.1.docbook:294
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display"
msgstr ""
"Fai que o programa instale un mapa de cores privado nunha pantalla de 8-bit"

#. Tag: option
#: man-makekdewidgets.1.docbook:300
#, no-c-format
msgid "--ncols &lt;count&gt;"
msgstr "--ncols &lt;cantidade&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:303
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on an 8-bit display, "
"if the application is using the QApplication::ManyColor color specification"
msgstr ""
"Limita o número de cores reservadas no cubo de cores nunha pantalla de 8-"
"bit, se o programa está a usar a especificación de cor "
"QApplication::ManyColor"

#. Tag: option
#: man-makekdewidgets.1.docbook:309
#, no-c-format
msgid "--nograb"
msgstr "--nograb"

#. Tag: para
#: man-makekdewidgets.1.docbook:312
#, no-c-format
msgid "Tells &Qt; to never grab the mouse or the keyboard"
msgstr "Indicalle a &Qt; que nunca capture nen o rato nen o teclado"

#. Tag: option
#: man-makekdewidgets.1.docbook:318
#, no-c-format
msgid "--sync"
msgstr "--sync"

#. Tag: para
#: man-makekdewidgets.1.docbook:321
#, no-c-format
msgid "Switches to synchronous mode for debugging"
msgstr "Troca para o modo síncrono para depuración"

#. Tag: option
#: man-makekdewidgets.1.docbook:327
#, no-c-format
msgid "--fn, --font &lt;fontname&gt;"
msgstr "--fn, --font &lt;tipoLetra&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:330
#, no-c-format
msgid "Defines the application font"
msgstr "Define o tipo de letra do programa"

#. Tag: option
#: man-makekdewidgets.1.docbook:336
#, no-c-format
msgid "--bg, --background &lt;color&gt;"
msgstr "--bg, --background &lt;cor&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:339
#, no-c-format
msgid ""
"Sets the default background color and an application palette (light and dark "
"shades are calculated)"
msgstr ""
"Estabelece a cor de fondo predeterminada e a paleta do programa (as sombras "
"claras e escuras son calculadas)"

#. Tag: option
#: man-makekdewidgets.1.docbook:345
#, no-c-format
msgid "--fg, --foreground &lt;color&gt;"
msgstr "--fg, --foreground &lt;cor&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:348
#, no-c-format
msgid "Sets the default foreground color"
msgstr "Estabelece a cor de primeiro plano predeterminada"

#. Tag: option
#: man-makekdewidgets.1.docbook:354
#, no-c-format
msgid "--btn, --button &lt;color&gt;"
msgstr "--btn, --button &lt;cor&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:357
#, no-c-format
msgid "Sets the default button color"
msgstr "Estabelece a cor predeterminada dos botóns"

#. Tag: option
#: man-makekdewidgets.1.docbook:363
#, no-c-format
msgid "--name &lt;name&gt;"
msgstr "--name &lt;nome&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:366
#, no-c-format
msgid "Sets the application name"
msgstr "Estabelece o nome do programa"

#. Tag: option
#: man-makekdewidgets.1.docbook:372
#, no-c-format
msgid "--title &lt;title&gt;"
msgstr "--title &lt;título&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:375
#, no-c-format
msgid "Sets the application title (caption)"
msgstr "Estabelece o título do programa"

#. Tag: option
#: man-makekdewidgets.1.docbook:381
#, no-c-format
msgid "--visual TrueColor"
msgstr "--visual TrueColor"

#. Tag: para
#: man-makekdewidgets.1.docbook:384
#, no-c-format
msgid "Forces the application to use a TrueColor visual on an 8-bit display"
msgstr "Obriga ao programa a empregar TrueColor nunha pantalla de 8-bit"

#. Tag: option
#: man-makekdewidgets.1.docbook:390
#, no-c-format
msgid "--inputstyle &lt;inputstyle&gt;"
msgstr "--inputstyle &lt;estiloEntrada&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:393
#, no-c-format
msgid ""
"Sets XIM (X Input Method) input style. Possible values are onthespot, "
"overthespot, offthespot, and root"
msgstr ""
"Axusta o estilo de entrada de XIM (X Input Method). Os valores posíbeis son "
"\"onthespot\", \"overthespot\", \"offthespot\", e \"root\""

#. Tag: option
#: man-makekdewidgets.1.docbook:399
#, no-c-format
msgid "--im &lt;XIM server&gt;"
msgstr "--im &lt;servidor XIM&gt;"

#. Tag: para
#: man-makekdewidgets.1.docbook:402
#, no-c-format
msgid "Sets XIM server"
msgstr "Indica o servidor XIM"

#. Tag: option
#: man-makekdewidgets.1.docbook:408
#, no-c-format
msgid "--noxim"
msgstr "--noxim"

#. Tag: para
#: man-makekdewidgets.1.docbook:411
#, no-c-format
msgid "Disable XIM"
msgstr "Deshabilita o XIM"

#. Tag: option
#: man-makekdewidgets.1.docbook:417
#, no-c-format
msgid "--reverse"
msgstr "--reverse"

#. Tag: para
#: man-makekdewidgets.1.docbook:420
#, no-c-format
msgid "Mirrors the whole layout of widgets"
msgstr "Reflicte a disposición dos trebellos por enteiro"

#. Tag: title
#: man-makekdewidgets.1.docbook:429
#, no-c-format
msgid "See Also"
msgstr "Consulte tamén"

#. Tag: option
#: man-makekdewidgets.1.docbook:433
#, no-c-format
msgid "http://developer.kde.org"
msgstr "http://developer.kde.org"

#. Tag: para
#: man-makekdewidgets.1.docbook:436
#, no-c-format
msgid "&kde; Developer's Corner website"
msgstr "O sitio web dos desenvolventes de &kde;"

#. Tag: title
#: man-makekdewidgets.1.docbook:443
#, no-c-format
msgid "Bugs"
msgstr "Erros"

#. Tag: para
#: man-makekdewidgets.1.docbook:444
#, no-c-format
msgid ""
"Please use <ulink url=\"http://bugs.kde.org\">bugs.kde.org</ulink> to report "
"bugs, do not mail the authors directly."
msgstr ""
"Por favor, empregue <ulink url=\"http://bugs.kde.org\">http://bugs.kde.org</"
"ulink> para informar de erros, non envíe directamente correos aos autores."

#~ msgid "<command>makekdewidgets</command>"
#~ msgstr "<command>makekdewidgets</command>"

