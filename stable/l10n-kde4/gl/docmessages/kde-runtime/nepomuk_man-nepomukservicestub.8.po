msgstr "Envoltura de &kde; para os complementos de servizo do Nepomuk."

#. Tag: title
#: man-nepomukservicestub.8.docbook:34
#, no-c-format
msgid "Synopsis"
msgstr "Resumo"

#. Tag: cmdsynopsis
#: man-nepomukservicestub.8.docbook:36
#, no-c-format
msgid ""
"<command>nepomukservicestub</command> <arg choice=\"opt\">--help</arg> <arg "
"choice=\"opt\">Generic options</arg> <arg choice=\"opt\">&Qt;-options</arg> "
"<arg choice=\"opt\">&kde;-options</arg> <arg choice=\"req\">servicename</arg>"
msgstr ""
"<command>nepomukservicestub</command> <arg choice=\"opt\">--help</arg> <arg "
"choice=\"opt\">Opcións xenéricas</arg> <arg choice=\"opt\">Opcións de &Qt;</"
"arg> <arg choice=\"opt\">Opcións de &kde;</arg> <arg "
"choice=\"req\">nomeDoServizo</arg>"

#. Tag: title
#: man-nepomukservicestub.8.docbook:48
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#: man-nepomukservicestub.8.docbook:50
#, no-c-format
msgid ""
"<command>nepomukservicestub</command> runs a Nepomuk service plugin in its "
"own process."
msgstr ""
"<command>nepomukservicestub</command> executa un complemento de servizo do "
"Nepomuk no seu propio proceso."

#. Tag: para
#: man-nepomukservicestub.8.docbook:53
#, no-c-format
msgid ""
"It is used by <command>nepomukserver</command> to run all configured Nepomuk "
"services."
msgstr ""
"Utilízao o <command>nepomukserver</command> para executar todos os servizos "
"configurados no Nepomuk."

