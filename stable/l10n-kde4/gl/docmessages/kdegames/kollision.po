"<guimenu>Configuración</guimenu> <guimenuitem>Reproducir os sons</"
"guimenuitem>"

#. Tag: para
#: index.docbook:138
#, no-c-format
msgid ""
"<action>Toggle whether sound effects should be played.</action> The default "
"is off."
msgstr ""
"<action>Indica se deben reproducirse os efectos de son.</action> Por omisión "
"está desactivado."

#. Tag: menuchoice
#: index.docbook:145
#, no-c-format
