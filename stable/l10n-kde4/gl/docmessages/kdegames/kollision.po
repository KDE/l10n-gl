msgstr ""
"<guimenu>Configuración</guimenu><guimenuitem>Mostrar a barra de estado</"
"guimenuitem>"

#. Tag: para
#: index.docbook:147
#, no-c-format
msgid "Toggle the display of the status bar at the bottom of the main window."
msgstr ""
"Conmuta a visibilidade da barra de estado no fondo da xanela principal."

#. Tag: menuchoice
#: index.docbook:151
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guisubmenu>Difficulty</guisubmenu>"
msgstr "<guimenu>Configuración</guimenu> <guisubmenu>Dificultade</guisubmenu>"

#. Tag: para
#: index.docbook:153
#, no-c-format
msgid ""
"Allows you to select a difficulty <guilabel>Easy</guilabel>, "
"<guilabel>Medium</guilabel>, <guilabel>Hard</guilabel> for the game."
msgstr ""
"Permite escoller unha dificultade para a partida: <guilabel>Fácil</"
"guilabel>, <guilabel>Media</guilabel>, <guilabel>Difícil</guilabel>."

#. Tag: menuchoice
#: index.docbook:158
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""
"<guimenu>Configuración</guimenu> <guimenuitem>Configurar os atallos de "
"teclado...</guimenuitem>"

#. Tag: para
#: index.docbook:160
#, no-c-format
msgid ""
"<action>Displays a standard &kde; shortcut configuration dialog</action> to "
"change the keyboard shortcuts for &kappname;."
msgstr ""
"<action>Mostra un diálogo normal de configuración de atallos do &kde;</"
"action> para os <link linkend=\"default-keybindings\">atallos de teclado</"
"link> do &kappname;."

