#, no-c-format
msgid "Toggle a name label for the selected object"
msgstr "Conmutar unha lenda do obxecto seleccionado"

#. Tag: keycap
#: commands.docbook:975
#, no-c-format
msgid "<keycap>O</keycap>"
msgstr "<keycap>O</keycap>"

#. Tag: para
#: commands.docbook:976
#, no-c-format
msgid "Add the selected object to the observing list"
msgstr "Engadir o obxecto seleccionado á lista de observación"

#. Tag: keycap
#: commands.docbook:980
#, no-c-format
msgid "<keycap>P</keycap>"
msgstr "<keycap>P</keycap>"

#. Tag: para
#: commands.docbook:981
#, no-c-format
msgid "Open the selected object's popup menu"
msgstr "Abrir o menú emerxente do obxecto seleccionado"

