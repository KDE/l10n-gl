msgstr ""
"Estes son os símbolos matemáticos: +, -, *, /, ( e ). Aprenda máis acerca "
"deles <link linkend=\"math\">aquí</link>."

#. Tag: entry
#: glossary.docbook:79
#, no-c-format
msgid "questions characters"
msgstr "perguntas"

#. Tag: entry
#: glossary.docbook:80
#, no-c-format
