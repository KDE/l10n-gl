#. Tag: title
#: commands.docbook:2
#, no-c-format
msgid "Command Reference"
msgstr "Referencia dos Comandos"

#. Tag: title
#: commands.docbook:5
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr "O Menú <guimenu>Ficheiro</guimenu>"

#. Tag: menuchoice
#: commands.docbook:11
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Novo</guimenuitem>"

#. Tag: action
#: commands.docbook:20
#, no-c-format
msgid ""
"Starts a new Plot by clearing the coordinate system and resetting the "
"function parser."
msgstr ""
"Inicia unha Representación nova limpando o sistema de coordenadas e "
"reiniciando o procesador de funcións."

#. Tag: menuchoice
#: commands.docbook:27
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo></"
"shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Abrir...</guimenuitem>"

#. Tag: action
#: commands.docbook:31
#, no-c-format
msgid "Opens an existing document."
msgstr "Abre un documento existente."

#. Tag: menuchoice
#: commands.docbook:36
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open Recent</guisubmenu>"
msgstr ""

#. Tag: para
#: commands.docbook:40
#, no-c-format
msgid ""
"<action>Displays a list of recently opened files.</action> Selecting one "
"from this list plots the functions in the file."
msgstr ""
"<action>Mostra unha lista de ficheiro abertos recentemente.</action> Se "
"escolle un desta lista representará as funcións no ficheiro."

#. Tag: menuchoice
#: commands.docbook:46
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo></"
"shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Guardar</guimenuitem>"

#. Tag: action
#: commands.docbook:51
#, no-c-format
msgid "Saves the document."
msgstr "Guarda o documento."

#. Tag: menuchoice
#: commands.docbook:56
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr "<guimenu>Ficheiro</guimenu> <guimenuitem>Guardar Como...</guimenuitem>"

#. Tag: action
#: commands.docbook:59
#, no-c-format
msgid "Saves the document under another name."
msgstr "Guarda o documento con outro nome."

#. Tag: menuchoice
#: commands.docbook:65
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Imprimir...</guimenuitem>"

#. Tag: action
#: commands.docbook:74
#, no-c-format
msgid "Sends the plot to a printer or file."
msgstr "Envía a gráfica para unha impresora ou ficheiro."

#. Tag: menuchoice
#: commands.docbook:80
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export...</guimenuitem>"
msgstr "<guimenu>Ficheiro</guimenu> <guimenuitem>Exportar...</guimenuitem>"

#. Tag: para
#: commands.docbook:83
#, no-c-format
msgid "<action>Exports</action> the plotted graphs to an image file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:88
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>Q</keycap> </keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>Q</keycap> </keycombo></"
"shortcut> <guimenu>Ficheiro</guimenu> <guimenuitem>Saír</guimenuitem>"

#. Tag: para
#: commands.docbook:94
#, no-c-format
msgid "<action>Exits</action> &kmplot;."
msgstr "<action>Sai</action> de &kmplot;."

#. Tag: title
#: commands.docbook:100
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr "O Menú <guimenu>Editar</guimenu>"

#. Tag: menuchoice
#: commands.docbook:104
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:110
#, no-c-format
msgid "Undo the last command."
msgstr "Desfai o último comando."

#. Tag: menuchoice
#: commands.docbook:114
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu><guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:120
#, no-c-format
msgid "Redo the last command that was undone."
msgstr "Volta a facer o último comando que foi desfeito."

#. Tag: menuchoice
#: commands.docbook:125
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Constants...</guimenuitem>"
msgstr "<guimenu>Editar</guimenu><guimenuitem>Constantes...</guimenuitem>"

#. Tag: para
#: commands.docbook:127
#, no-c-format
msgid ""
"Displays the <guilabel>Constants</guilabel> dialog box. See <xref linkend="
"\"constants-config\"/>."
msgstr ""
"Mostra o diálogo das <guilabel>Constantes</guilabel>. Consulte <xref linkend="
"\"constants-config\"/>."

#. Tag: title
#: commands.docbook:135
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr "O Menú <guimenu>Ver</guimenu>"

#. Tag: para
#: commands.docbook:136
#, no-c-format
msgid "The first three items in the menu are related to zooming."
msgstr "Os tres primeiros itens deste menú están relacionados coa ampliación."

#. Tag: menuchoice
#: commands.docbook:141
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>1</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom In</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>1</keycap></keycombo> </"
"shortcut> <guimenu>Ver</guimenu> <guimenuitem>Ampliar</guimenuitem>"

#. Tag: para
#: commands.docbook:150
#, no-c-format
msgid ""
"This tool can be operator in two different manners. To zoom in on a point on "
"the graph, click on it. To zoom in on a specific section of the graph, hold "
"and drag the mouse to form a rectangle, which will be the new axes ranges "
"when the mouse button is released."
msgstr ""
"Esta ferramenta pode ser usada de duas maneiras diferentes. Para ampliar "
"sobre un ponto da representación, prema sobre el. Para ampliar unha sección "
"específica da gráfica, manteña premido e arraste o rato para formar un "
"rectángulo, que será o novo rango dos eixos cando o botón do rato sexa "
"soltado."

#. Tag: menuchoice
#: commands.docbook:156
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>2</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom Out</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>2</keycap></keycombo> </"
"shortcut> <guimenu>Ver</guimenu> <guimenuitem>Reducir</guimenuitem>"

#. Tag: para
#: commands.docbook:165
#, no-c-format
msgid ""
"The tool can also be used in two different manners. To zoom out and center "
"on a point, click on that point. To fit the existing view into a rectangle, "
"hold and drag the mouse to form that rectangle."
msgstr ""
"Esta ferramente tamén pode ser usada de dous xeitos distintos. Para reducir "
"e centrar nun ponto, prema en tal ponto. Para axustar a vista existente nun "
"rectángulo, calque e arraste o rato para formar tal rectángulo."

#. Tag: menuchoice
#: commands.docbook:170
#, no-c-format
msgid ""
"<guimenu>View</guimenu> <guimenuitem>Fit Widget to Trigonometric Functions</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:175
#, no-c-format
msgid ""
"The scale will be adapted to trigonometric functions. This works both for "
"radians and degrees."
msgstr ""
"A escala será adaptada para funcións trigonométricas. Isto funciona tanto en "
"graus como en radiáns."

#. Tag: menuchoice
#: commands.docbook:179
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Reset View</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:181
#, no-c-format
msgid "Resets the view."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:187
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Coordinate System...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:189
#, no-c-format
msgid ""
"Displays the <guilabel>Coordinate System</guilabel> dialog box. See <xref "
"linkend=\"coords-config\"/>."
msgstr ""
"Mostra o diálogo do <guilabel>Sistema de Coordenadas</guilabel>. Consulte "
"<xref linkend=\"coords-config\"/>."

#. Tag: menuchoice
#: commands.docbook:195
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Show Sliders</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:199
#, no-c-format
msgid "<action>Toggles</action> the visibility of the slider dialog."
msgstr "<action>Comuta</action> a visibilidade do diálogo de desprazamento."

#. Tag: title
#: commands.docbook:207
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr "O Menú <guimenu>Ferramentas</guimenu>"

#. Tag: para
#: commands.docbook:209
#, no-c-format
msgid "This menu contains some tools for the functions that can be useful:"
msgstr ""
"Este menú contén algunhas ferramentas para as funcións que poden ser úteis:"

#. Tag: menuchoice
#: commands.docbook:214
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Calculator</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:218
#, no-c-format
msgid "Opens the <guilabel>Calculator</guilabel> dialog."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:223
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Plot Area...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:227
#, fuzzy, no-c-format
#| msgid ""
#| "Select a graph and the x-values in the new dialog that appears. Calulates "
#| "the integral and draws the area between the graph and the x-axis in the "
#| "range of the selected x-values in the color of the graph."
msgid ""
"Select a graph and the x-values in the new dialog that appears. Calculates "
"the integral and draws the area between the graph and the x-axis in the "
"range of the selected x-values in the color of the graph."
msgstr ""
"Escolla unha gráfica e os valores x no diálogo que irá aparecer. Calcularase "
"a integral e debuxarase a área entre a gráfica e o eixo x no rango de "
"valores indicados coa cor da gráfica."

#. Tag: menuchoice
#: commands.docbook:234
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Find Minimum...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:238
#, no-c-format
msgid "Find the minimum value of the graph in a specified range."
msgstr "Procura o valor mínimo da representación nun rango especificado."

#. Tag: menuchoice
#: commands.docbook:243
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Find Maximum...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:247
#, no-c-format
msgid "Find the maximum value of the graph in a specified range."
msgstr "Procura o valor máximo da representación no rango especificado."

#. Tag: title
#: commands.docbook:255
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "O Menú <guimenu>Configuración</guimenu>"

#. Tag: menuchoice
#: commands.docbook:259
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

