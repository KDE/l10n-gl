#: backgrounds/chinese_landscape.desktop:2
msgctxt "Name"
msgid "Chinese Landscape"
msgstr "Paisaxe chinesa"

#: backgrounds/chinese_landscape.desktop:56
msgctxt "Description"
msgid "Chinese landscape with mountains and a waterfall"
msgstr "Paisaxe chinesa con montañas e unha cascada."

#: backgrounds/color_plain.desktop:2
msgctxt "Name"
msgid "Plain Color"
msgstr "Cor da xanela"

#: backgrounds/color_plain.desktop:55
msgctxt "Description"
msgid "Use the default window background color."
msgstr "Empregar a cor de fondo predeterminada da xanela."

#: backgrounds/default.desktop:2
msgctxt "Name"
msgid "Egyptian"
msgstr "Exipcio"

#: backgrounds/default.desktop:49
msgctxt "Description"
msgid "A Egyptian style background"
msgstr "Un fondo de estilo exipcio."

#: backgrounds/default_old.desktop:2 tilesets/default.desktop:2
msgctxt "Name"
msgid "Default"
msgstr "Predeterminado"

#: backgrounds/default_old.desktop:62
msgctxt "Description"
msgid "A green background with light geometric patterns"
msgstr "Un fondo verde con patróns xeométricos suaves."

#: backgrounds/summerfield.desktop:2
msgctxt "Name"
msgid "Summer Field"
msgstr "Campo no verán"

#: backgrounds/summerfield.desktop:50
msgctxt "Description"
msgid "The Summertime Greens"
msgstr "O verde do verán."

#: backgrounds/wood_light.desktop:2
msgctxt "Name"
msgid "Light Wood"
msgstr "Madeira clara"

#: backgrounds/wood_light.desktop:55
msgctxt "Description"
msgid "Resembles the surface of a wood table"
msgstr "Un fondo que se asemella á superficie dunha mesa de madeira."

#: tilesets/alphabet.desktop:2
msgctxt "Name"
msgid "Alphabet"
msgstr "Alfabeto"

#: tilesets/alphabet.desktop:57
msgctxt "Description"
msgid "A colorful tileset designed for kids of all ages."
msgstr "Un conxunto colorido de pezas deseñado para nenos de todas as idades."

#: tilesets/bamboo.desktop:2
msgctxt "Name"
msgid "Bamboo"
msgstr "Bambú"

#: tilesets/bamboo.desktop:44
msgctxt "Description"
msgid "Japanese tileset with brightly-colored kanji on a soft woodgrain"
msgstr ""
"Xogo de pezas nipón con rechamantes caracteres kanji en vetas da madeira "
"lisas"

#: tilesets/classic.desktop:2
msgctxt "Name"
msgid "Classic"
msgstr "Clásico"

#: tilesets/classic.desktop:60
msgctxt "Description"
msgid "Chinese tileset, inspired by the classic version shipped with KDE 3"
msgstr ""
"Pezas chinesas, inspiradas na versión clásica distribuída coa versión 3 de "
"KDE."

#: tilesets/default.desktop:62
msgctxt "Description"
msgid "Art inspired by real Japanese Mahjongg tiles"
msgstr "Imaxes inspiradas en auténticas pezas xaponesas de Mah Jongg."

#: tilesets/egypt.desktop:2
msgctxt "Name"
msgid "Ancient Egyptians"
msgstr "Antigos exipcios"

#: tilesets/jade.desktop:2
msgctxt "Name"
msgid "Imperial Jade"
msgstr "Xade imperial"

#: tilesets/traditional.desktop:2
msgctxt "Name"
msgid "Traditional"
msgstr "Tradicionais"

#: tilesets/traditional.desktop:56
