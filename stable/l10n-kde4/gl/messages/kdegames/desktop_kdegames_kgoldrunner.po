#: src/KGoldrunner.desktop:4
msgctxt "Name"
msgid "KGoldrunner"
msgstr "KGoldrunner"

#: src/KGoldrunner.desktop:70
msgctxt "GenericName"
msgid "Hunt Gold, Dodge Enemies and Solve Puzzles"
msgstr "Colle moedas, escapa dos inimigos e resolve quebracabezas"

#: src/KGoldrunner.desktop:116
msgctxt "Comment"
msgid "A game of action and puzzle-solving"
msgstr "Un xogo de acción e resolución de quebracabezas"

#: themes/black-on-white.desktop:2
msgctxt "Name"
msgid "Black on White"
msgstr "Branco e negro"

#: themes/black-on-white.desktop:55
msgctxt "Description"
msgid "A monochrome, black on white theme for KGoldrunner"
msgstr "Un tema visual monocromático en branco e negro para KGoldrunner"

#: themes/default.desktop:2
msgctxt "Name"
msgid "KGoldRunner Default"
msgstr "Predeterminado de KGoldrunner"

#: themes/default.desktop:55
msgctxt "Description"
msgid "A light and clean theme for KDE4"
msgstr "Un tema lixeiro e simple para KDE 4"

#: themes/egypt.desktop:2
msgctxt "Name"
msgid "The Treasure of Egypt"
msgstr "O tesouro do Exipto"

#: themes/egypt.desktop:53
msgctxt "Description"
msgid "Help Matt Goldrunner escape the traps of ancient Egypt."
msgstr "Axuda a Matt Goldrunner a escapar das trampas do antigo Exipto."

#: themes/kgr_geek.desktop:2
msgctxt "Name"
msgid "Geek City"
msgstr "Cidade cibernética"

#: themes/kgr_geek.desktop:51
msgctxt "Description"
msgid "The hero is trapped inside a computer."
msgstr "O heroe está atrapado nun computador."

#: themes/nostalgia-blues.desktop:2
msgctxt "Name"
msgid "Nostalgia Blues"
msgstr "Blues da nostalxia"

#: themes/nostalgia-blues.desktop:50
msgctxt "Description"
msgid ""
"A theme for KGoldrunner that brings back that 8-bit look... now in blue!"
msgstr ""
"Un tema visual para KGoldrunner que nos lembra a aquel aspecto dos 8 bits... "
"agora en azul!"

#: themes/nostalgia.desktop:2
msgctxt "Name"
msgid "Nostalgia"
msgstr "Nostalxia"

# «escalable» aparece no DiGalego
#: themes/nostalgia.desktop:54
msgctxt "Description"
msgid "A scalable theme for KGoldrunner that brings back that 8-bit look..."
msgstr ""
"Un tema visual vectorial para KGoldrunner que nos lembra ao aquel aspecto "
"dos 8-bits..."
