#: kapman.desktop:4
msgctxt "Name"
msgid "Kapman"
msgstr "Kapman"

# Non teño noticia de que o Pac-Man fose traducido ao galego, polo que haberá que deixarlle o nome en inglés.
#: kapman.desktop:56
msgctxt "GenericName"
msgid "Pac-Man Clone"
msgstr "Clon do Pac-Man"

#: kapman.desktop:102
msgctxt "Comment"
msgid "Eat pills escaping ghosts"
msgstr "Come pílulas mentres escapas das pantasmas"

#: themes/invisible.desktop:2
msgctxt "Name"
msgid "Invisible"
msgstr "Invisíbel"

#: themes/invisible.desktop:52
msgctxt "Description"
msgid ""
"Getting bored with Kapman? More than 100,000 points over level 20? Next "
"step: the invisible maze!"
msgstr ""
"Abúrreste con Kapman? Superaches os 100.000 puntos por riba do nivel 20? "
"Pois agora ao labirinto invisíbel!"

#: themes/matches.desktop:2
msgctxt "Name"
msgid "Matches"
msgstr "Mistos"

#: themes/matches.desktop:52
msgctxt "Description"
msgid "A matches drawn maze"
msgstr "Un labirinto debuxado con mistos"

#: themes/mountain.desktop:2
msgctxt "Name"
msgid "Mountain Adventure"
msgstr "Aventura na montaña"

#: themes/mountain.desktop:48
msgctxt "Description"
msgid "Default"
msgstr "Predeterminado"

#: themes/mummies_crypt.desktop:2
msgctxt "Name"
msgid "Mummies Crypt"
msgstr "A cripta das momias"

#: themes/mummies_crypt.desktop:47
msgctxt "Description"
msgid "Avoid the mummies at all costs!"
msgstr "Evita as momias a toda costa!"

#: themes/retro.desktop:2
msgctxt "Name"
msgid "Retro"
msgstr "Retro"

#: themes/retro.desktop:52
