#: Jabber/jabberaccount.cpp:916
msgid "Mechanism too weak."
msgstr "O mecanismo é demasiado feble."

#: Jabber/jabberaccount.cpp:919
msgid "Wrong credentials supplied. (check your user ID and password)"
msgstr ""
"As credenciais fornecidas eran incorrectas (comprobe a identidade do usuario "
"e mailo contrasinal)"

#: Jabber/jabberaccount.cpp:922
msgid "Temporary failure, please try again later."
msgstr "Fallo temporal, ténteo de novo máis tarde."

#: Jabber/jabberaccount.cpp:929
#, kde-format
msgid "There was an error authenticating with the server: %1"
msgstr "Aconteceu un erro ao autenticarse no servidor: %1"

#: Jabber/jabberaccount.cpp:936
msgid "Transport Layer Security (TLS) problem."
msgstr "Houbo un problema coa TSL."

#: Jabber/jabberaccount.cpp:939
msgid "Simple Authentication and Security Layer (SASL) problem."
msgstr "Houbo un problema coa SASL."

#: Jabber/jabberaccount.cpp:946
#, kde-format
msgid "There was an error in the security layer: %1"
msgstr "Aconteceu un erro na capa de seguridade: %1"

#: Jabber/jabberaccount.cpp:953
msgid "No permission to bind the resource."
msgstr "Non hai permiso para vincular o recurso."

#: Jabber/jabberaccount.cpp:956
msgid "The resource is already in use."
msgstr "O recurso xa está en uso."

#: Jabber/jabberaccount.cpp:963
#, kde-format
msgid "Could not bind a resource: %1"
msgstr "Non foi posíbel vincular un recurso: %1"

#: Jabber/jabberaccount.cpp:981 Jabber/jabberaccount.cpp:985
#, kde-format
msgid "Connection problem with Jabber server %1"
