"Bloquearíase a operación do socket. Non debería ver este erro, por favor "
"utilice «Informar dun erro» no menú de Axuda."

#: Jabber/jabberaccount.cpp:820
msgid "Connection refused."
msgstr "Rexeitouse a conexión."

#: Jabber/jabberaccount.cpp:823
msgid "Connection timed out."
msgstr "A conexión esgotou o tempo límite."

#: Jabber/jabberaccount.cpp:826
msgid "Connection attempt already in progress."
msgstr "Xa hai un intento de conexión en progreso."

#: Jabber/jabberaccount.cpp:829
msgid "Network failure."
msgstr "Fallo da rede."

#: Jabber/jabberaccount.cpp:832
msgid "Operation is not supported."
msgstr "A operación non está soportada."

#: Jabber/jabberaccount.cpp:835
msgid "Socket timed out."
msgstr "O socket esgotou o tempo límite."

#: Jabber/jabberaccount.cpp:843
#, kde-format
msgid "There was a connection error: %1"
msgstr "Aconteceu un erro de conexión: %1"

#: Jabber/jabberaccount.cpp:851
msgid "Unknown host."
msgstr "Servidor descoñecido."

#: Jabber/jabberaccount.cpp:855
msgid "Could not connect to a required remote resource."
msgstr "Non se puido conectar a un recurso remoto necesario."

#: Jabber/jabberaccount.cpp:858
msgid ""
"It appears we have been redirected to another server; I do not know how to "
"handle this."
msgstr ""
"Semella que se produciu un desvío a outro servidor, algo que este software "
"non soporta."

#: Jabber/jabberaccount.cpp:861
msgid "Unsupported protocol version."
msgstr "Versión do protocolo non soportada."

#: Jabber/jabberaccount.cpp:864 Jabber/jabberaccount.cpp:881
#: Jabber/jabberaccount.cpp:925 Jabber/jabberaccount.cpp:942
#: Jabber/jabberaccount.cpp:959 Jabber/jabberaccount.cpp:967
msgid "Unknown error."
msgstr "Erro descoñecido."

#: Jabber/jabberaccount.cpp:868
#, kde-format
msgid "There was a negotiation error: %1"
msgstr "Aconteceu un erro de negociación: %1"

