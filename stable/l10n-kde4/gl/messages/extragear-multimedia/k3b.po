msgstr "Formatar e borrar"

#: misc/k3bmediaformattingdialog.cpp:48
#, kde-format
msgid "CD-RW"
msgstr "CD-RW"

#: misc/k3bmediaformattingdialog.cpp:48
#, kde-format
msgid "DVD±RW"
