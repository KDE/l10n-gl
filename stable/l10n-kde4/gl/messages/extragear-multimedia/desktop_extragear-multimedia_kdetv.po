#: clients/applet/kdetvapplet.desktop:4
msgctxt "Name"
msgid "kdetv Applet"
msgstr "Applet kdetv"

#: clients/applet/kdetvapplet.desktop:37
msgctxt "Comment"
msgid "A television for your panel."
msgstr "Un televisor para o panel."

#: clients/kdetv/kdetv.desktop:6
msgctxt "Name"
msgid "kdetv"
msgstr "kdetv"

#: clients/kdetv/kdetv.desktop:10
msgctxt "GenericName"
msgid "TV Viewer"
msgstr "Visor de TV"

#: clients/kpart/kdetvpart.desktop:3
msgctxt "Name"
msgid "kdetv Part"
msgstr "Componente kdetv"

#: clients/panelextension/kdetvpanelextension.desktop:4
msgctxt "Name"
msgid "kdetv Panelextension"
msgstr "Extensión de panel kdetv"

#: clients/panelextension/kdetvpanelextension.desktop:33
msgctxt "Comment"
msgid "A Kicker extension that displays a TV."
msgstr "Unha extensión para Kicker que mostra un televisor."

#: clients/screensaver/kdetvscreensaver.desktop:9
msgctxt "Name"
msgid "kdetv Screen Saver"
msgstr "Protector de pantalla kdetv"

#: clients/screensaver/kdetvscreensaver.desktop:42
msgctxt "Comment"
msgid "A screen saver that displays a TV"
msgstr "Un protector de pantalla que mostra un televisor"

#: clients/screensaver/kdetvscreensaver.desktop:77
msgctxt "Name"
msgid "Setup..."
msgstr "Configurar..."

#: clients/screensaver/kdetvscreensaver.desktop:122
msgctxt "Name"
msgid "Display in specified window"
msgstr "Mostra na fiestra especificada"

#: clients/screensaver/kdetvscreensaver.desktop:162
msgctxt "Name"
msgid "Display in root window"
msgstr "Mostra na fiestra raíz"

#: plugins/channel/csv/kdetv_csvchannels.desktop:9
msgctxt "Name"
msgid "CSV Channel File Plugin"
msgstr "Extensión de ficheiro CSV de canles"

#: plugins/channel/csv/kdetv_csvchannels.desktop:41
msgctxt "Comment"
msgid ""
"This stores your channel files in CSV (comma separated variables) format."
msgstr "Isto almacena os seus ficheiros de canles no formato CSV."

#: plugins/channel/kwintv/kdetv_kwintvchannels.desktop:9
msgctxt "Name"
msgid "KWinTV Legacy Channel File Plugin"
msgstr "Extensión de ficheiro de canais de KWinTV"

#: plugins/channel/kwintv/kdetv_kwintvchannels.desktop:35
msgctxt "Comment"
msgid ""
"This allows you to use your legacy KWinTV format channel files in Kdetv."
msgstr "Isto permítelle usar o antigo formato de ficheiro de KWinTV en Kdetv."

#: plugins/channel/xawtv/kdetv_xawtvchannels.desktop:9
msgctxt "Name"
msgid "xawtv Channel File Plugin"
msgstr "Extensión de ficheiro de canle de xawtv"

#: plugins/channel/xawtv/kdetv_xawtvchannels.desktop:38
msgctxt "Comment"
msgid "This loads your xawtv format channel files in kdetv."
msgstr "Isto carga en kdetv os seus ficheiros de canles no formato de xawtv."

#: plugins/channel/xml/kdetv_xmlchannels.desktop:9
msgctxt "Name"
msgid "XML Channel File Plugin"
msgstr "Extensión de ficheiro XML de canle"

#: plugins/channel/xml/kdetv_xmlchannels.desktop:39
msgctxt "Comment"
msgid ""
"This stores your channel files in XML format.  This is the standard file "
"format for kdetv."
msgstr ""
"Isto garda os ficheiros de canles no formato XML. É o formato padrón de "
"kdetv."

#: plugins/channel/zapping/kdetv_zappingchannels.desktop:9
msgctxt "Name"
msgid "Zapping Channel File Plugin"
msgstr "Extensiónde ficheiro de canle en formato Zapping"

#: plugins/channel/zapping/kdetv_zappingchannels.desktop:34
msgctxt "Comment"
msgid ""
"This loads/stores your channel files in XML format zapping (zapping.sf.net) "
"uses."
msgstr ""
"Isto carga/garda os seus ficheiros de canle no formato XML de zapping "
"(zapping.sf.net)."

#: plugins/filter/bilinear/kdetv_bilinear.desktop:10
msgctxt "Name"
msgid "Bilinear Deinterlacing"
msgstr "Desentrelazado bilinear"

#: plugins/filter/bilinear/kdetv_bilinear.desktop:33
#: plugins/filter/linearblend/kdetv_linearblend.desktop:30
msgctxt "Comment"
msgid "Low CPU usage, modest quality"
msgstr "Baixo uso de CPU, calidade reducida"

#: plugins/filter/chromakill/kdetv_chromakill.desktop:10
msgctxt "Name"
msgid "Chroma Kill"
msgstr "Matar as cores"

#: plugins/filter/chromakill/kdetv_chromakill.desktop:28
msgctxt "Comment"
msgid "Converts video to black and white"
msgstr "Converte a imaxe en branco e negro"

#: plugins/filter/colourinversion/kdetv_colourinversion.desktop:10
msgctxt "Name"
msgid "Color Inversion"
msgstr "Inversión de cores"

#: plugins/filter/colourinversion/kdetv_colourinversion.desktop:41
msgctxt "Comment"
msgid "Inverts video colors"
msgstr "Inverte as cores da imaxe"

#: plugins/filter/greedy/kdetv_greedy.desktop:10
msgctxt "Name"
msgid "Greedy (Low Motion) Deinterlacing"
msgstr "Desentrelazado voraz (pouco movimento)"

#: plugins/filter/greedy/kdetv_greedy.desktop:31
#: plugins/filter/greedy2frame/kdetv_greedy2frame.desktop:31
msgctxt "Comment"
msgid "Higher CPU usage, good quality (adapted from DScaler www.dscaler.org)"
msgstr ""
"Maior consumo de CPU, boa calidade (adaptado de DScaler www.dscaler.org)"

#: plugins/filter/greedy2frame/kdetv_greedy2frame.desktop:10
msgctxt "Name"
msgid "Greedy2Frame Deinterlacing"
msgstr "Desentrelazado greedy2frame"

#: plugins/filter/greedyh/kdetv_greedyh.desktop:10
msgctxt "Name"
msgid "Greedy (High Motion) Deinterlacing"
msgstr "Desentrelazado voraz (moito movimento)"

#: plugins/filter/greedyh/kdetv_greedyh.desktop:32
msgctxt "Comment"
msgid "High CPU usage, great quality (adapted from DScaler www.dscaler.org)"
msgstr "Maior uso da CPU, boa calidade (adaptado de DScaler www.dscaler.org)"

#: plugins/filter/linearblend/kdetv_linearblend.desktop:10
msgctxt "Name"
msgid "Linear Blend Deinterlacing"
msgstr "Desentrelazado por mistura linear"

#: plugins/filter/mirror/kdetv_mirror.desktop:10
msgctxt "Name"
msgid "Mirror"
msgstr "Espello"

#: plugins/filter/mirror/kdetv_mirror.desktop:43
msgctxt "Comment"
msgid "Mirrors video image"
msgstr "Reflicte a imaxe do vídeo"

#: plugins/filter/none/kdetv_none.desktop:10
msgctxt "Name"
msgid "No Deinterlacing"
msgstr "Sen desentrelazar"

#: plugins/filter/overscan/kdetv_overscan.desktop:10
msgctxt "Name"
msgid "Overscan"
msgstr "Contorno adicional"

#: plugins/filter/overscan/kdetv_overscan.desktop:32
msgctxt "Comment"
msgid "Cuts away noise from image borders"
msgstr "Elimina ruído dos bordes da imaxe"

#: plugins/filter/sharpness/kdetv_sharpness.desktop:10
msgctxt "Name"
msgid "Sharpness"
msgstr "Nitidez"

#: plugins/filter/sharpness/kdetv_sharpness.desktop:41
msgctxt "Comment"
msgid "Increases sharpness of video image"
msgstr "Fai máis nítida a imaxe"

#: plugins/filter/tomsmocomp/kdetv_tomsmocomp.desktop:10
msgctxt "Name"
msgid "TomsMoComp Deinterlacing"
msgstr "Desentrelazado TomsMoComp"

#: plugins/filter/tomsmocomp/kdetv_tomsmocomp.desktop:31
msgctxt "Comment"
msgid ""
"Very high CPU usage, great quality (adapted from DScaler www.dscaler.org)"
msgstr ""
"Moi alto consumo da CPU, excelente calidade (adaptado de DScaler www.dscaler."
"org)"

#: plugins/misc/channelsuite/kdetv_channelsuite.desktop:9
msgctxt "Name"
msgid "Channelsuite Plugin"
msgstr "Extensión de channelsuite"

#: plugins/misc/channelsuite/kdetv_channelsuite.desktop:36
msgctxt "Comment"
msgid "Channelsuite management"
msgstr "Xestión de channelsuite"

#: plugins/misc/simon/kdetv_simon.desktop:9
msgctxt "Name"
msgid "Closed Captioning Plugin"
msgstr "Extensión de subtítulos ocultábeis"

#: plugins/misc/simon/kdetv_simon.desktop:34
msgctxt "Comment"
msgid "Simon says: \"This provides closed captioning support.\""
msgstr "Isto dá soporte para a decodificación de subtítulos ocultábeis"

#: plugins/misc/telex/kdetv_telex.desktop:9
msgctxt "Name"
msgid "Teletext Plugin"
msgstr "Extensión de teletexto"

#: plugins/misc/telex/kdetv_telex.desktop:38
msgctxt "Comment"
msgid "Shows Telext pages"
msgstr "Mostra as páxinas do teletexto"

#: plugins/mixer/alsa/kdetv_alsa.desktop:10
msgctxt "Name"
msgid "ALSA Mixer Plugin"
msgstr "Extensión cun misturador de ALSA"

#: plugins/mixer/alsa/kdetv_alsa.desktop:40
msgctxt "Comment"
msgid "This provides support for ALSA mixer devices."
msgstr "Isto dá soporte para dispositivos de mistura de ALSA."

#: plugins/mixer/oss/kdetv_oss.desktop:10
msgctxt "Name"
msgid "OSS Mixer Plugin"
msgstr "Extensión cun misturador de OSS"

#: plugins/mixer/oss/kdetv_oss.desktop:40
msgctxt "Comment"
msgid "This provides support for OSS audio mixer devices."
msgstr "Isto dá soporte para dispositivos de mistura de OSS."

#: plugins/osd/elegant/kdetv_elegant.desktop:9
msgctxt "Name"
msgid "Elegant On-Screen Display Plugin"
msgstr "Extensión para un OSD elegante"

#: plugins/osd/elegant/kdetv_elegant.desktop:34
msgctxt "Comment"
msgid "This provides an elegant on-screen display."
msgstr "Isto fornece un OSD elegante."

#: plugins/osd/haze/kdetv_haze.desktop:9
msgctxt "Name"
msgid "Haze On-Screen Display Plugin"
msgstr "Extensión para un OSD difuso"

#: plugins/osd/haze/kdetv_haze.desktop:33
msgctxt "Comment"
msgid "This provides a simple on-screen display."
msgstr "Isto fornece un OSD simples."

#: plugins/vbi/libzvbidecoder/kdetv_libzvbidecoder.desktop:10
msgctxt "Name"
msgid "libZVBI VBI Decoder Plugin"
msgstr "Extensión de decodificación VBI con libZVBI"

#: plugins/vbi/libzvbidecoder/kdetv_libzvbidecoder.desktop:36
msgctxt "Comment"
msgid "libZVBI VBI decoding backend."
msgstr "Infraestrutura de decodificación VBI con libZVBI."

#: plugins/video/v4l/kdetv_v4l.desktop:9
msgctxt "Name"
msgid "Video4Linux Plugin"
msgstr "Extensión para Video4Linux"

#: plugins/video/v4l/kdetv_v4l.desktop:41
msgctxt "Comment"
msgid "This enables you to view video streams from a Video4Linux device."
msgstr ""
"Isto permítelle ver retransmisións de vídeo procedentes dun dispositivo "
"Video4Linux."

#: plugins/video/v4l2/kdetv_v4l2.desktop:9
msgctxt "Name"
msgid "Video4Linux2 Plugin"
msgstr "Extensión Video4Linux2"

#: plugins/video/v4l2/kdetv_v4l2.desktop:42
msgctxt "Comment"
msgid "This enables you to view video streams from a Video4Linux2 device."
msgstr ""
"Isto permítelle ver retransmisións de vídeo procedentes dun dispositivo "
"Video4Linux2."

#: plugins/video/xv/kdetv_xv.desktop:9
msgctxt "Name"
msgid "XVideo Plugin"
msgstr "Extensión XVideo"

#: plugins/video/xv/kdetv_xv.desktop:43
msgctxt "Comment"
msgid ""
"This enables you to view video streams from the XVideo subsystem of an X11 "
"server.  It requires Xv support for your tuner."
msgstr ""
"Isto permítelle ver retransmisións de vídeo procedentes do subsistema XVideo "
"dun servidor X11. Precisa de soporte de Xv para o seu sintonizador."
