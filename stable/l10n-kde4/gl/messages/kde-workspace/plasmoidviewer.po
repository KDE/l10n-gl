#: main.cpp:50
msgid "Run Plasma widgets in their own window"
msgstr "Executa widgets de Plasma nunha xanela de seu"

#: main.cpp:101
msgid "No description available"
msgstr "Non se dispón de descrición"

#: main.cpp:118
msgid "Plasma Widget Viewer"
msgstr "Visor de widgets de Plasma"

#: main.cpp:120
msgid "2007-2008, Frerich Raabe"
msgstr "2007-2008, Frerich Raabe"

#: main.cpp:122
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:123
msgid "Original author"
msgstr "Autor orixinal"

#: main.cpp:130
msgid "Name of the containment plugin"
msgstr "O nome do complemento contedor"

#: main.cpp:132
msgctxt "Do not translate horizontal, vertical, mediacenter nor planar"
msgid "The formfactor to use (horizontal, vertical, mediacenter or planar)"
msgstr ""
"As proporcións que se han empregar (horizontal, vertical, mediacenter ou "
"planar)"

#: main.cpp:134
msgid "Displays a list of known applets"
msgstr "Mostra unha lista de applets coñecidas"

#: main.cpp:136
msgid "Displays a list of known wallpapers"
msgstr "Mostra unha lista de fondos de escritorio coñecidos"

#: main.cpp:138
msgid "Displays a list of known containments"
msgstr "Mostra unha lista de contedores coñecidos"

#: main.cpp:140
msgid "Displays a list of known themes"
msgstr "Mostra unha lista de temas coñecidos"

#: main.cpp:141
msgid "Disables save and restore of the config between runs"
msgstr "Desactiva o gardado e restauración da configuración entre execucións"

#: main.cpp:143
msgctxt ""
"Do not translate floating, desktop, fullscreen, top, bottom, left nor right"
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right)"
msgstr ""
"A restrición de posición coa que iniciar o contedor (floating, desktop, "
"fullscreen, top, bottom, left, right)"

#: main.cpp:145
msgid "The size in kB to set the pixmap cache to"
msgstr "O tamaño en kB da caché do mapa de píxeles"

#: main.cpp:147
msgid ""
"Takes a screenshot of the widget and saves it the working directory as "
"<pluginname>.png"
msgstr ""
"Fai unha captura de pantalla do widget e gárdaa no cartafol de traballo como "
"<pluginname>.png"

#: main.cpp:149
msgid ""
"Takes a screenshot of each widget and saves it the working directory as "
"<pluginname>.png"
msgstr ""
"Fai unha captura de pantalla de cada widget e gárdaa no cartafol de traballo "
"como <pluginname>.png"

#: main.cpp:151
msgid "Desktop SVG theme to use"
msgstr "O tema SVG de escritorio para empregar"

#: main.cpp:153
msgid ""
"Name of the wallpaper plugin. Requires a containment plugin to be specified."
msgstr ""
"O nome do complemento de fondo de escritorio. Require que se especifique un "
"complemento contedor."

#: main.cpp:154
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""
"O nome da applet a ver, pode referirse ao nome do complemento ou ser unha "
"ruta (absoluta ou relativa) a un paquete. Se non se indica farase un intento "
"de cargar un paquete desde o directorio actual."

#: main.cpp:157
msgid "Optional arguments of the applet to add"
msgstr "Argumentos opcionais da applet a engadir"

#: main.cpp:158
msgid "List zeroconf announced remote widgets"
msgstr "Listar os widgets remotos anunciados en zeroconf"
