#: devicewrapper.cpp:143 devicewrapper.cpp:159
msgid "Eject medium"
msgstr "Expulsar o medio"

#: devicewrapper.cpp:147
msgid "Mount the device"
msgstr "Montar o dispositivo"

#: devicewrapper.cpp:149
msgid "Unmount the device"
msgstr "Desmontar o dispositivo"

#: devicewrapper.cpp:153
msgctxt ""
"Unlock the encrypted container; will ask for a password; partitions inside "
"will appear as they had been plugged in"
msgid "Unlock the container"
msgstr "Desatrancar o contedor"

#: devicewrapper.cpp:155
msgctxt ""
"Close the encrypted container; partitions inside will disappear as they had "
"been unplugged"
msgid "Lock the container"
msgstr "Trancar o contedor"

#: solidrunner.cpp:48
msgid "Finds devices whose name match :q:"
msgstr "Busca dispositivos que teñan un nome que case con :q:"

#: solidrunner.cpp:50 solidrunner.cpp:139
msgctxt "Note this is a KRunner keyword"
msgid "device"
msgstr "dispositivo"

#: solidrunner.cpp:51
msgid "Lists all devices and allows them to be mounted, unmounted or ejected."
msgstr ""
"Lista todos os dispositivos e permite montalos, desmontalos ou expulsalos."

#: solidrunner.cpp:52 solidrunner.cpp:145
msgctxt "Note this is a KRunner keyword"
msgid "mount"
msgstr "montar"

#: solidrunner.cpp:53
msgid "Lists all devices which can be mounted, and allows them to be mounted."
msgstr ""
"Lista todos os dispositivos que se podan montar, e permite desmontalos."

#: solidrunner.cpp:54 solidrunner.cpp:158
msgctxt "Note this is a KRunner keyword"
msgid "unlock"
msgstr "desbloquear"

#: solidrunner.cpp:55
msgid ""
"Lists all encrypted devices which can be unlocked, and allows them to be "
"unlocked."
msgstr ""
"Lista todos os dispositivos que se podan desbloquear e permite desbloquealos."

#: solidrunner.cpp:56 solidrunner.cpp:149
msgctxt "Note this is a KRunner keyword"
msgid "unmount"
msgstr "desmontar"

#: solidrunner.cpp:57
msgid ""
"Lists all devices which can be unmounted, and allows them to be unmounted."
msgstr ""
"Lista todos os dispositivos que se podan desmontar e permite desmontalos."

#: solidrunner.cpp:58 solidrunner.cpp:163
msgctxt "Note this is a KRunner keyword"
msgid "lock"
msgstr "bloquear"

#: solidrunner.cpp:59
msgid ""
"Lists all encrypted devices which can be locked, and allows them to be "
"locked."
msgstr ""
"Lista todos os dispositivos cifrados que se podan bloquear, e permite "
"bloquealos."

#: solidrunner.cpp:61 solidrunner.cpp:153
msgctxt "Note this is a KRunner keyword"
msgid "eject"
msgstr "expulsar"

#: solidrunner.cpp:62
msgid "Lists all devices which can be ejected, and allows them to be ejected."
msgstr "Lista todos os dispositivos que se podan expulsar e permite facelo."
