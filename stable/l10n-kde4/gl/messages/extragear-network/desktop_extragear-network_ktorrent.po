#: ktorrent/ktorrent.desktop:2
#: plasma/dataengine/plasma-dataengine-ktorrent.desktop:2
msgctxt "Name"
msgid "KTorrent"
msgstr "KTorrent"

#: ktorrent/ktorrent.desktop:8
msgctxt "GenericName"
msgid "BitTorrent Client"
msgstr "Cliente de BitTorrent"

#: ktorrent/ktorrent.desktop:55
msgctxt "Comment"
msgid "A BitTorrent program for KDE"
msgstr "Un programa de bittorrent para KDE"

#: ktorrent/ktorrent.notifyrc:3
msgctxt "Comment"
msgid "KTorrent"
msgstr "KTorrent"

#: ktorrent/ktorrent.notifyrc:11
msgctxt "Name"
msgid "Torrent stopped by error"
msgstr "Un torrente foi detido por mor dun erro"

#: ktorrent/ktorrent.notifyrc:49
msgctxt "Name"
msgid "Torrent has finished downloading"
msgstr "Rematou a obtención dun torrente"

#: ktorrent/ktorrent.notifyrc:87
msgctxt "Name"
msgid "Maximum share ratio reached"
msgstr "Acadouse a taxa máxima de compartición"

#: ktorrent/ktorrent.notifyrc:124
msgctxt "Name"
msgid "Maximum seed time reached"
msgstr "Acadouse prazo máximo de compartición"

#: ktorrent/ktorrent.notifyrc:161
msgctxt "Name"
msgid "Disk space is running low"
msgstr "Está a ficar sen espazo no disco"

#: ktorrent/ktorrent.notifyrc:199
msgctxt "Name"
msgid "Corrupted data has been found"
msgstr "Acháronse datos corrompidos"

#: ktorrent/ktorrent.notifyrc:235
msgctxt "Name"
msgid "Torrent cannot be enqueued"
msgstr "Non é posíbel pór o torrente na fila"

#: ktorrent/ktorrent.notifyrc:272
msgctxt "Name"
msgid "Torrent cannot be started"
msgstr "Non é posíbel iniciar o torrente"

#: ktorrent/ktorrent.notifyrc:309
msgctxt "Name"
msgid "Torrent cannot be loaded silently"
msgstr "Non é posíbel cargar silandeiramente o torrente"

#: ktorrent/ktorrentplugin.desktop:4
msgctxt "Name"
msgid "KTorrent Plugin"
msgstr "Extensión de KTorrent"

#: plasma/applet/plasma-applet-ktorrent.desktop:3
msgctxt "Name"
msgid "KTorrent Plasma Applet"
msgstr "Applet de KTorrent para Plasma"

#: plasma/dataengine/plasma-dataengine-ktorrent.desktop:8
msgctxt "Comment"
msgid "KTorrent data engine, for getting information from ktorrent"
msgstr "Motor de datos de KTorrent, para obter información acerca de ktorrent"

#: plugins/bitfinder/ktbitfinderplugin.desktop:2
msgctxt "Name"
msgid "BitFinderPlugin"
msgstr "BitFinderPlugin"

#: plugins/bitfinder/ktbitfinderplugin.desktop:25
msgctxt "Comment"
msgid "Plugin to automatically downloads torrents from various sources"
msgstr "Unha extensión para obter automaticamente torrentes de varias fontes"

#: plugins/bwscheduler/ktbwschedulerplugin.desktop:2
msgctxt "Name"
msgid "BandwidthSchedulerPlugin"
msgstr "Extensión de planificación do ancho de banda"

#: plugins/bwscheduler/ktbwschedulerplugin.desktop:29
msgctxt "Comment"
msgid "Plugin to schedule upload and download limits over a period of a week"
msgstr ""
"Extensión para planificar os límites de envío e obtención nun período semanal"

#: plugins/downloadorder/ktdownloadorderplugin.desktop:2
msgctxt "Name"
msgid "DownloadOrderPlugin"
msgstr "DownloadOrderPlugin"

#: plugins/downloadorder/ktdownloadorderplugin.desktop:26
msgctxt "Comment"
msgid ""
"Plugin to specify the download order of a multifile torrent for KTorrent"
msgstr ""
"Unha extensión para KTorrent que especifica a orden na que se obterá un "
"torrente con varios ficheiros"

#: plugins/infowidget/ktinfowidgetplugin.desktop:2
msgctxt "Name"
msgid "InfoWidgetPlugin"
msgstr "Extensión de widget de información"

#: plugins/infowidget/ktinfowidgetplugin.desktop:29
msgctxt "Comment"
msgid ""
"Plugin which displays general information about a torrent in several tabs"
msgstr ""
"Extensión que mostra información xeral acerca dun torrente en varias páxinas"

#: plugins/ipfilter/ktipfilterplugin.desktop:2
msgctxt "Name"
msgid "IPFilterPlugin"
msgstr "Extensión de filtrado de IP"

#: plugins/ipfilter/ktipfilterplugin.desktop:31
msgctxt "Comment"
msgid "IP filter plugin for KTorrent"
msgstr "Extensión de KTorrent para filtrar IP"

#: plugins/logviewer/ktlogviewerplugin.desktop:2
msgctxt "Name"
msgid "LogViewerPlugin"
msgstr "Extensión de visionado do rexistro"

#: plugins/logviewer/ktlogviewerplugin.desktop:31
msgctxt "Comment"
msgid "Plugin which displays the logging output generated by KTorrent"
msgstr "Extensión que mostra a saída de rexisto xerada por KTorrent"

#: plugins/mediaplayer/ktmediaplayerplugin.desktop:2
msgctxt "Name"
msgid "MediaPlayerPlugin"
msgstr "MediaPlayerPlugin"

#: plugins/mediaplayer/ktmediaplayerplugin.desktop:29
msgctxt "Comment"
msgid "Phonon based media player plugin for KTorrent"
msgstr "Extensión de reproducción multimedia baseada en Phonon para KTorrent"

#: plugins/scanfolder/ktscanfolderplugin.desktop:2
msgctxt "Name"
msgid "ScanFolderPlugin"
msgstr "Extensión de exame de cartafoles"

#: plugins/scanfolder/ktscanfolderplugin.desktop:31
msgctxt "Comment"
msgid ""
"Plugin to scan directories for torrent files, when files are found, they are "
"loaded"
msgstr ""
"Extensión para examinar cartafoles á procura de torrentes, cando se atopan "
"ficheiros, son cargados"

#: plugins/scripting/ktscriptingplugin.desktop:2
msgctxt "Name"
msgid "ScriptingPlugin"
msgstr "ScriptingPlugin"

#: plugins/scripting/ktscriptingplugin.desktop:25
msgctxt "Comment"
msgid "Kross scripting plugin for KTorrent"
msgstr "Extensión de script con Kross para KTorrent"

#: plugins/scripting/scripts/auto_resume/auto_resume.desktop:2
msgctxt "Name"
msgid "Automatic Resume"
msgstr "Continuar automaticamente"

#: plugins/scripting/scripts/auto_resume/auto_resume.desktop:33
msgctxt "Comment"
msgid ""
"Script to automatically resume after some time, when the paused state is "
"enabled"
msgstr ""
"Un script para continuar automaticamente despois dalgúnt tempo, cando se "
"activa o estado de pausa"

#: plugins/scripting/scripts/email_notifications/email_notifications.desktop:2
msgctxt "Name"
msgid "E-Mail Notifications"
msgstr "Notificacións por correo electrónico"

#: plugins/scripting/scripts/email_notifications/email_notifications.desktop:34
msgctxt "Comment"
msgid "Script to notify you of events via e-mail"
msgstr "Un script para notificarlle os eventos mediante correo electrónico"

#: plugins/scripting/scripts/tracker_groups/tracker_groups.desktop:2
msgctxt "Name"
msgid "Tracker Grouping"
msgstr "Agrupamento do localizador"

#: plugins/scripting/scripts/tracker_groups/tracker_groups.desktop:33
msgctxt "Comment"
msgid "Script to create automatic groups based upon tracker URL's"
msgstr ""
"Un script para criar grupos automáticos baseándose nos URL do localizador"

#: plugins/search/ktsearchplugin.desktop:2
msgctxt "Name"
msgid "SearchPlugin"
msgstr "Extensión de procuras"

#: plugins/search/ktsearchplugin.desktop:32
msgctxt "Comment"
msgid "Search plugin for KTorrent"
msgstr "Extensión de procura para KTorrent"

#: plugins/stats/ktstatsplugin.desktop:3
msgctxt "Name"
msgid "StatsPlugin"
msgstr "Extensión de estatísticas"

#: plugins/stats/ktstatsplugin.desktop:31
msgctxt "Comment"
msgid "Plugin which shows statistics about torrents in several graphs"
msgstr ""
"Extensión que mostra estatísticas acerca de torrentes en varios gráficos"

#: plugins/syndication/ktsyndicationplugin.desktop:2
msgctxt "Name"
msgid "SyndicationPlugin"
msgstr "SyndicationPlugin"

#: plugins/syndication/ktsyndicationplugin.desktop:23
msgctxt "Comment"
msgid "Syndication plugin for KTorrent, supporting RSS and Atom feeds"
msgstr ""
"Extensión de sindicación para KTorrent, con soporte para fontes RSS e Atom"

#: plugins/upnp/ktupnpplugin.desktop:2
msgctxt "Name"
msgid "UPnPPlugin"
msgstr "Extensión de UPnPP"

#: plugins/upnp/ktupnpplugin.desktop:30
msgctxt "Comment"
msgid "Plugin to forward ports using UPnP"
msgstr "Extensión para reencamiñar portos mediante UPnP"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:2
msgctxt "Name"
msgid "WebInterface"
msgstr "Inteface Web"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:29
msgctxt "Comment"
msgid "Plugin to control KTorrent via a webinterface"
msgstr "Extensión para controlas KTorrent mediante unha interface web"

#: plugins/zeroconf/ktzeroconfplugin.desktop:2
msgctxt "Name"
msgid "ZeroConfPlugin"
msgstr "Extensión de ZeroConf"

#: plugins/zeroconf/ktzeroconfplugin.desktop:28
msgctxt "Comment"
msgid ""
"Plugin to discover peers on the local network using the zeroconf protocol"
msgstr ""
"Extensión para descobrir parceiros na rede local usando o protocolo zeroconf"
