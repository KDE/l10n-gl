#: ktelepathy.notifyrc:53
msgctxt "Name"
msgid "Group"
msgstr "Grupo"

#: ktelepathy.notifyrc:79
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "O grupo no que reside o contacto"

#: ktelepathy.notifyrc:104
msgctxt "Name"
msgid "Contact"
msgstr "Contacto"

#: ktelepathy.notifyrc:130
msgctxt "Comment"
