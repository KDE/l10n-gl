#: ktelepathy.notifyrc:63
msgctxt "Name"
msgid "Group"
msgstr "Grupo"

#: ktelepathy.notifyrc:94
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "O grupo no que reside o contacto"

#: ktelepathy.notifyrc:124
msgctxt "Name"
msgid "Contact"
