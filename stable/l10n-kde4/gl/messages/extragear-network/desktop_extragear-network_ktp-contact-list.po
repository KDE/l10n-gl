msgid "A contact has sent you a buzz/nudge."
msgstr "Un contacto envioulle unha chamada/aviso."

#: ktelepathy.notifyrc:579
msgctxt "Name"
msgid "Message Dropped"
msgstr "Mensaxe retirada"

