msgctxt "Comment"
msgid "An incoming message in the active chat window has been received"
msgstr "Recibiuse unha mensaxe entrante na xanela de conversa activa"

#: data/ktelepathy.notifyrc:554
msgctxt "Name"
msgid "Outgoing Message"
msgstr "Mensaxe saínte"

#: data/ktelepathy.notifyrc:587
msgctxt "Comment"
msgid "An outgoing message has been sent"
msgstr "Enviouse unha mensaxe saínte"

#: data/ktelepathy.notifyrc:625
msgctxt "Name"
msgid "Highlight"
msgstr "Realzar"

#: data/ktelepathy.notifyrc:659
msgctxt "Comment"
msgid "A highlighted message has been received"
msgstr "Recibiuse unha mensaxe realzada"

#: data/ktelepathy.notifyrc:696
msgctxt "Name"
msgid "Buzz/Nudge"
msgstr "Chamada/aviso"

#: data/ktelepathy.notifyrc:728
msgctxt "Comment"
msgid "A contact has sent you a buzz/nudge"
msgstr "Un contacto envioulle unha chamada/aviso"

#: data/ktelepathy.notifyrc:764
msgctxt "Name"
msgid "Message Dropped"
msgstr "Mensaxe retirada"

#: data/ktelepathy.notifyrc:797
msgctxt "Comment"
msgid "A message was filtered by the Privacy Plugin"
msgstr "Unha mensaxe foi filtrada polo engadido de intimidade"

#: data/ktelepathy.notifyrc:833
msgctxt "Name"
msgid "Service Message"
msgstr "Mensaxe do servizo"

#: data/ktelepathy.notifyrc:866
msgctxt "Comment"
msgid "A service message has been received (e.g. authorization request)"
msgstr ""
"Recibiuse unha mensaxe do servizo (p. ex. unha solicitude de autorización)"

#: data/ktelepathy.notifyrc:905
msgctxt "Name"
msgid "New incoming chat"
msgstr "Nova conversa entrante"

#: data/ktelepathy.notifyrc:937
msgctxt "Comment"
msgid "A new instant message has been received"
msgstr "Recibiuse unha nova mensaxe instantánea"

#: data/ktelepathy.notifyrc:973
msgctxt "Name"
msgid "Incoming file transfer"
msgstr "Transferencia de ficheiros entrante"

#: data/ktelepathy.notifyrc:1005
