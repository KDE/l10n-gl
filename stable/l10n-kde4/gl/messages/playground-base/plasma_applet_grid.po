#: grid.cpp:379
msgid "Note: The number of columns takes precedence."
msgstr "Nota: O número de colunas ten preferencia."

#: grid.cpp:381
msgid "Note: The number of rows takes precedence."
msgstr "Nota: O número de colunas ten preferencia."

#. i18n: tag string
#. i18n: file gridConfig.ui line 19
#. i18n: tag string
#. i18n: file gridConfig.ui line 22
#: rc.cpp:3 rc.cpp:6
msgid "Configure Grid"
msgstr "Configurar a grella"

#. i18n: tag string
#. i18n: file gridConfig.ui line 62
#: rc.cpp:9
msgid ""
"Here you can set the number of columns to be used. Note that in vertical "
"panels, this means the maximum number of rows, so your grid will never be "
"higher than that. It will expand horizontally instead, i.e. add more columns."
msgstr ""
"Aquí pode indicar o número de colunas a empregar. Lembre que nos paineis "
"verticais, isto é o número máximo de colunas, polo que a grella nunca será "
"maior que isto. No cando expandirase en horizontal, i.e. engade máis colunas."

#. i18n: tag string
#. i18n: file gridConfig.ui line 65
#: rc.cpp:12
msgid "Number of rows"
msgstr "Número de filas"

#. i18n: tag string
#. i18n: file gridConfig.ui line 78
#: rc.cpp:15
msgid ""
"Here you can set the number of columns to be used. Note that in vertical "
"panels, this means the maximum number of columns, so your grid will never be "
"wider than that. It will expand vertically instead, i.e. add more rows."
msgstr ""
"Aquí pode indicar o número de colunas a empregar. Lembre que nos paineis "
"verticais, isto é o número máximo de colunas, polo que a grella nunca será "
"mais ancha que isto. No cando expandirase en vertical, i.e. engade máis "
"filas."

#. i18n: tag string
#. i18n: file gridConfig.ui line 81
#: rc.cpp:18
msgid "Number of columns"
msgstr "Número de colunas"

#. i18n: tag string
#. i18n: file gridConfig.ui line 96
#: rc.cpp:21
msgid "Note about row/columns precedence"
msgstr "Nota acerca da precedencia das filas/colunas"
