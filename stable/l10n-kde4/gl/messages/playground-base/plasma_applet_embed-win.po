#: embed-win.cpp:88
msgid "Embed new application"
msgstr "Incluír un programa novo"

#: embed-win.cpp:89
msgid "Release embedded application"
msgstr "Liberar o programa incluído"

#: embed-win.cpp:156
msgid ""
"Click with the left mouse button on the window you want to embed.\n"
"Click anywhere with the right mouse button to cancel."
msgstr ""
"Prema co botón primario do rato na fiestra que queira embeber.\n"
"Prema en calquera lugar do botón secundario para cancelar."

#: embed-win.cpp:243
#, fuzzy
#| msgid "Sorry, can't embed this window."
msgid "Cannot embed this window."
msgstr "Non é posíbel incorporar esta fiestra."

#: embed-win.cpp:248
msgid "Embedding client..."
msgstr "A incluír o cliente..."

#: embed-win.cpp:260
msgid "Error while embedding client"
msgstr "Aconteceu un erro ao incluír o cliente"

#: embed-win.cpp:273
msgid "Client is embedded. If you see this text please report a bug."
msgstr ""
"O cliente está incluído. Se é quen de ver este texto, por favor informe dun "
"erro."

#: embed-win.cpp:285
msgid "Application have been closed"
msgstr "O programa foi pechado"

#: embed-win.cpp:288
msgid "Application have been detached"
msgstr "O programa foi separado"
