#: emailcollectionconfig.cpp:96
msgctxt "@title:window"
msgid "Select Address Book Folder"
msgstr "Escolla o cartafol do caderno de enderezos"

#: emailcollectionconfig.cpp:175
msgctxt "@title:window"
msgid "Manage Email Sources"
msgstr "Xestión de fontes de correo electrónico"

#: emailcollectionconfig.cpp:184
#, kde-format
msgctxt "@info"
msgid ""
"<title>Please select the folder for storing newly created emails.</"
"title><note>If the folder list below is empty, you might have to add an "
"email source through <interface>%1</interface> <br>or change which folders "
"you are subscribed to through <interface>%2</interface></note>"
msgstr ""
"<title>Escolla o cartafol onde gardar os correos electrónicos que críe.</"
"title> <note>Se a lista de cartafoles en baixo está vacía, poida que teña "
"que engadir unha fonte de correos mediante <interface>%1</interface><br> ou "
"mudar os cartafoles aos que está subscrito mediante <interface>%2</"
"interface></note>"

#: kremail.cpp:78
msgid "New"
msgstr "Novo"

#: kremail.cpp:85
msgid "Save"
msgstr "Gardar"

#: kremail.cpp:134 kremail.cpp:154
msgid "No scanner found."
msgstr "Non se achou ningún escáner"

#: kremail.cpp:150
#, kde-format
msgid "Opening the selected scanner (%1) failed. Retrying...."
msgstr "Fallou a abertura do escáner que escolleu (%1). A tentar de novo..."

#: kremail.cpp:164
#, kde-format
msgid "Opening the selected scanner (%1) failed again. Scanning failed."
msgstr ""
"Volveu fallar a abertura do escáner que escolleu (%1)! Fallou a análise."

#: kremail.cpp:313
msgid "Email item created successfully"
msgstr "Creouse con éxito o elemento de correo"

#: kremail.cpp:317
