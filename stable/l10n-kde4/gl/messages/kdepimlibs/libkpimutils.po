#: email.cpp:531
msgid ""
"The email address you entered is not valid because it contains more than one "
"@. You will not create valid messages if you do not change your address."
msgstr ""
"O endereo de correo electrónico que escrebeu non é válido porque contén máis "
"dunha @. Non criará mensaxes válidas se non muda o enderezo."

#: email.cpp:536
msgid ""
"The email address you entered is not valid because it does not contain a @."
"You will not create valid messages if you do not change your address."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque non contén "
"nengunha @. Non criará mensaxes válidas se non muda o enderezo."

#: email.cpp:541
msgid "You have to enter something in the email address field."
msgstr "Debe escreber algo no campo do enderezo de correo."

#: email.cpp:543
msgid ""
"The email address you entered is not valid because it does not contain a "
"local part."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque non contén "
"unha parte local."

#: email.cpp:546
msgid ""
"The email address you entered is not valid because it does not contain a "
"domain part."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque non contén "
"unha parte de dominio."

#: email.cpp:549
msgid ""
"The email address you entered is not valid because it contains unclosed "
"comments/brackets."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque contén "
"comentarios/corchetes non pechados."

#: email.cpp:552
msgid "The email address you entered is valid."
msgstr "O enderezo de correo electrónico que escrebeu é válido."

#: email.cpp:554
msgid ""
"The email address you entered is not valid because it contains an unclosed "
"anglebracket."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque contén un "
"\"&lt;\" non pechado."

#: email.cpp:557
msgid ""
"The email address you entered is not valid because it contains an unopened "
"anglebracket."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque contén un "
"\"&gt;\" non aberto."

#: email.cpp:560
msgid ""
"The email address you have entered is not valid because it contains an "
"unexpected comma."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque contén "
"unha vírgula inesperada."

#: email.cpp:563
msgid ""
"The email address you entered is not valid because it ended unexpectedly, "
"this probably means you have used an escaping type character like an \\  as "
"the last character in your email address."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque termina de "
"xeito inesperado, isto probabelmente significa que usou un caracter de "
"escape como un \\ como último caracter no seu enderezo de correo."

#: email.cpp:568
msgid ""
"The email address you entered is not valid because it contains quoted text "
"which does not end."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque contén "
"texto entre aspas que non terminan."

#: email.cpp:571 email.cpp:635
msgid ""
"The email address you entered is not valid because it does not seem to "
"contain an actual email address, i.e. something of the form joe@example.org."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque non parece "
"conter un enderezo de correo real, é dicer, algo do estilo marce@trasno.net."

#: email.cpp:575
msgid ""
"The email address you entered is not valid because it contains an illegal "
"character."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque contén un "
"caracter non permitido."

#: email.cpp:578
msgid ""
"The email address you have entered is not valid because it contains an "
"invalid displayname."
msgstr ""
"O enderezo de correo electrónico que escrebeu non é válido porque contén un "
"nome público non válido"

#: email.cpp:581
msgid "Unknown problem with email address"
msgstr "Erro descoñecido no enderezo de correo"

#: kfileio.cpp:45
msgid "File I/O Error"
msgstr "Erro de E/S no ficheiro"

#: kfileio.cpp:65
#, kde-format
msgid ""
"The specified file does not exist:\n"
"%1"
msgstr ""
"O ficheiro indicado non existe:\n"
"%1"

#: kfileio.cpp:71
#, kde-format
msgid ""
"This is a folder and not a file:\n"
"%1"
msgstr ""
"Isto é un cartafol, non un ficheiro:\n"
"%1"

#: kfileio.cpp:77
#, kde-format
msgid ""
"You do not have read permissions to the file:\n"
"%1"
msgstr ""
"Non ter permiso de leitura do ficheiro:\n"
"%1"

#: kfileio.cpp:89
#, kde-format
msgid ""
"Could not read file:\n"
"%1"
msgstr ""
"Non foi posíbel ler o ficheiro:\n"
"%1"

#: kfileio.cpp:92
#, kde-format
msgid ""
"Could not open file:\n"
"%1"
msgstr ""
"Non foi posíbel abrir o ficheiro:\n"
"%1"

#: kfileio.cpp:95
#, kde-format
msgid ""
"Error while reading file:\n"
"%1"
msgstr ""
"Aconteceu un erro ao ler o ficheiro:\n"
"%1"

#: kfileio.cpp:113
#, kde-format
msgid "Could only read %1 bytes of %2."
msgstr "Só foi posíbel ler %1 bytes de %2."

#: kfileio.cpp:136
#, kde-format
msgid ""
"File %1 exists.\n"
"Do you want to replace it?"
msgstr ""
"O ficheiro %1 xa existe.\n"
"Desexa substituílo?"

#: kfileio.cpp:138 kfileio.cpp:159
msgid "Save to File"
msgstr "Gardar no ficheiro"

#: kfileio.cpp:139
msgid "&Replace"
msgstr "&Substituír"

#: kfileio.cpp:158
#, kde-format
msgid ""
"Failed to make a backup copy of %1.\n"
"Continue anyway?"
msgstr ""
"Fallou a salvaguarda de %1.\n"
"Continuar aínda así?"

#: kfileio.cpp:172 kfileio.cpp:188
#, kde-format
msgid ""
"Could not write to file:\n"
"%1"
msgstr ""
"Non foi posíbel escreber no ficheiro:\n"
"%1"

#: kfileio.cpp:175
#, kde-format
msgid ""
"Could not open file for writing:\n"
"%1"
msgstr ""
"Non foi posíbel abrir o ficheiro para escreber nel:\n"
"%1"

#: kfileio.cpp:178
#, kde-format
msgid ""
"Error while writing file:\n"
"%1"
msgstr ""
"Aconteceu un erro ao escreber no ficheiro:\n"
"%1"

#: kfileio.cpp:192
#, kde-format
msgid "Could only write %1 bytes of %2."
msgstr "Só foi posíbel escreber %1 bytes de %2."

#: kfileio.cpp:217
#, kde-format
msgid "%1 does not exist"
msgstr "%1 non existe"

#: kfileio.cpp:228
#, kde-format
msgid "%1 is not accessible and that is unchangeable."
msgstr "%1 non é acesíbel e iso é imutábel."

#: kfileio.cpp:249
#, kde-format
msgid "%1 is not readable and that is unchangeable."
msgstr "%1 non é lexíbel e iso é imutábel."

#: kfileio.cpp:265
#, kde-format
msgid "%1 is not writable and that is unchangeable."
msgstr "%1 non é escrebíbel e iso é imutábel."

#: kfileio.cpp:279
#, kde-format
msgid "Folder %1 is inaccessible."
msgstr "O cartafol %1 é inacesíbel."

#: kfileio.cpp:310
msgid ""
"Some files or folders do not have the necessary permissions, please correct "
"them manually."
msgstr ""
"Algúns dos ficheiros ou cartafoles non teñen os permisos precisos, corríxaos "
"manualmente."

#: kfileio.cpp:313
msgid "Permissions Check"
msgstr "Verificación dos permisos"

#~ msgid "Emoticon theme"
#~ msgstr "Tema e emoticones"

#~ msgid "This allows you to change the emoticon theme that should be used."
#~ msgstr "Isto permítelle mudar o tema de emoticones que ha ser usado."
