#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kabc/kabc_manager.desktop:3
msgctxt "Name"
msgid "Contacts"
msgstr "Contactos"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kabc/plugins/dir/dir.desktop:2
msgctxt "Name"
msgid "Directory"
msgstr "Cartafol"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kabc/plugins/dir/dir.desktop:41
msgctxt "Comment"
msgid ""
"Provides access to contacts, each stored in a single file, in a given "
"directory. Supports standard VCard file and other formats depending on "
"availability of plugins"
msgstr ""
"Dá aceso aos contactos, cada un gardado nun ficheiro nun cartafol dado. "
"Admite ficheiros vCard estándar e outros formatos, en función da "
"dispoñibilidade de extensións."

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kabc/plugins/file/file.desktop:2
msgctxt "Name"
msgid "File"
msgstr "Ficheiro"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kabc/plugins/file/file.desktop:40
msgctxt "Comment"
msgid ""
"Provides access to contacts stored in a single local file. Supports standard "
"VCard files and other formats depending on available plugins"
msgstr ""
"Dá aceso a contactos gardados nun único ficheiro local. Admite ficheiros "
"vCard estándar e outros formatos en función das extensións dispoñíbeis"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kabc/plugins/ldapkio/ldapkio.desktop:2
msgctxt "Name"
msgid "LDAP"
msgstr "LDAP"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kabc/plugins/ldapkio/ldapkio.desktop:6
msgctxt "Comment"
msgid "Provides access to contacts stored on a LDAP directory server"
msgstr "Dá aceso a contactos gardados nun servidor de directorio LDAP"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kabc/plugins/net/net.desktop:2
msgctxt "Name"
msgid "Network"
msgstr "Rede"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kabc/plugins/net/net.desktop:41
msgctxt "Comment"
msgid ""
"Provides access to contacts in remote files using KDE's network framework "
"KIO. Supports standard VCard files and other formats depending on available "
"plugins"
msgstr ""
"Dá aceso a contactos gardados en ficheiros remotos mediante a infraestrutura "
"de rede KIO, de KDE. Admite ficheiros vCard estándar e outros formatos en "
"función das extensións dispoñíbeis"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kcal/kcal_manager.desktop:3
msgctxt "Name"
msgid "Calendar"
msgstr "Axenda"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kcal/local.desktop:2
msgctxt "Name"
msgid "Calendar in Local File"
msgstr "Axenda nun ficheiro local"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kcal/local.desktop:40
msgctxt "Comment"
msgid "Provides access to a calendar stored in a single local file"
msgstr "Dá aceso a un calendario gardado nun único ficheiro local"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kcal/localdir.desktop:2
msgctxt "Name"
msgid "Calendar in Local Directory"
msgstr "Axenda nun cartafol local"

#: /home/cvs/prod/branches/KDE/4.2/kdepimlibs/kcal/localdir.desktop:40
msgctxt "Comment"
msgid ""
"Provides access to calendar items, each stored in a single file, in a given "
"directory"
msgstr ""
"Dá aceso aos obxectos do calendario, cada un gardado nun ficheiro nun "
"cartafol dado"

