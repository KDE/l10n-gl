#: configpage.cpp:345
msgid "There is no standard resource. Please select one."
msgstr "Non hai un recurso estándar. Escolla un."

#: configpage.cpp:362
msgid "Please select type of the new resource:"
msgstr "Escolla o tipo do novo recurso:"

#: configpage.cpp:374
#, kde-format
msgid "Unable to create resource of type '%1'."
msgstr "Non foi posíbel criar un recurso do tipo \"%1\"."

#: configpage.cpp:427
msgid ""
"You cannot remove your standard resource. Please select a new standard "
"resource first."
msgstr ""
"Non pode eliminar o seu recurso estándar. Escolla anter outro recurso como o "
"seu estándar."

#: configpage.cpp:465 configpage.cpp:486
msgid "You cannot use a read-only resource as standard."
msgstr "Non pode usar un recurso só para leitura como estándar."

#: configpage.cpp:491
msgid "You cannot use an inactive resource as standard."
msgstr "Non pode usar un recurso inactivo como estándar."

#: configpage.cpp:575
msgid ""
"You cannot deactivate the standard resource. Choose another standard "
"resource first."
msgstr ""
"Non pode desactivar o recurso estándar. Escolla antes outro recurso como o "
"estándar."

#: configpage.cpp:604
msgid ""
"There is no valid standard resource. Please select one which is neither read-"
"only nor inactive."
msgstr ""
"Non hai un recurso estándar válido. Escolla un que non sexa nen só para "
"leitura nen inactivo."

