#: katesessionapplet.cpp:154
msgid "Start Kate (no arguments)"
msgstr "Iniciar Kate (sen argumentos)"

#: katesessionapplet.cpp:160
msgid "New Kate Session"
msgstr "Nova sesión de Kate"

#: katesessionapplet.cpp:166
msgid "New Anonymous Session"
msgstr "Nova sesión anónima"

#: katesessionapplet.cpp:210
msgid "Session Name"
msgstr "Nome da sesión"

#: katesessionapplet.cpp:211
msgid "Please enter a name for the new session"
msgstr "Indique o nome para a nova sesión"

#: katesessionapplet.cpp:218
msgid ""
"An unnamed session will not be saved automatically. Do you want to create "
"such a session?"
msgstr ""
"As sesións sen nome non son gardadas automaticamente. Desexa criar unha "
"sesión anónima?"

#: katesessionapplet.cpp:220
msgid "Create anonymous session?"
msgstr "Criar unha sesión anónima?"

#: katesessionapplet.cpp:227
#, kde-format
msgid "You already have a session named %1. Do you want to open that session?"
msgstr "Xa ten unha sesión chamada %1. Desexa abrir esa sesión?"

#: katesessionapplet.cpp:228
msgid "Session exists"
msgstr "A sesión xa existe"
