#: libkgapi/accessmanager_p.cpp:82
msgid "No valid reply received"
msgstr "Non se recibiu unha resposta correcta"

#: libkgapi/accessmanager_p.cpp:112
msgid "Bad request."
msgstr "A petición é mala."

#: libkgapi/accessmanager_p.cpp:170 libkgapi/accessmanager_p.cpp:171
#, kde-format
msgid ""
"Requested resource is forbidden.\n"
"\n"
"Google replied '%1'"
msgstr ""
"O recurso solicitado está prohibido.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:179 libkgapi/accessmanager_p.cpp:180
#, kde-format
msgid ""
"Requested resource does not exist.\n"
"\n"
"Google replied '%1'"
msgstr ""
"O recurso solicitado non existe\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:188 libkgapi/accessmanager_p.cpp:189
#, kde-format
msgid ""
"Conflict. Remote resource is newer than local.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Conflito. O recurso remoto é máis recente que o local.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:197 libkgapi/accessmanager_p.cpp:198
#, kde-format
msgid ""
"Requested resource does not exist anymore.\n"
"\n"
"Google replied '%1'"
msgstr ""
"O recurso solicitado non existe máis.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:206 libkgapi/accessmanager_p.cpp:207
#, kde-format
msgid ""
"Internal server error. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Produciuse un erro interno do servidor. Ténteo máis tarde.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:215 libkgapi/accessmanager_p.cpp:216
#, kde-format
msgid ""
"User quota exceeded. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Excedeuse a cota de usuario. Ténteo de novo máis tarde.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:224
#, kde-format
msgid ""
"Unknown error.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Produciuse un erro descoñecido.\n"
"\n"
"Google respondeu «%1»"

#: libkgapi/accessmanager_p.cpp:255 libkgapi/accessmanager_p.cpp:256
msgid "Unknown reply content type."
msgstr "Descoñécese o tipo de contido daa resposta."

#: libkgapi/accessmanager_p.cpp:331
#, kde-format
msgid "Invalid request, service %1 is not registered."
msgstr "A solicitude non é válida; o servizo %1 non está rexistrado."

#: libkgapi/auth_p.cpp:178
msgid "Authentication cancelled"
msgstr "Cancelouse a autenticación"

#: libkgapi/auth_p.cpp:230
msgid "Failed to parse newly fetched tokens"
msgstr "Non foi posíbel analizar os elementos obtidos recentemente"

#: libkgapi/common.h:100
msgid "An unknown error has occurred."
msgstr "Produciuse un erro descoñecido."

#: libkgapi/common.h:126
#, kde-format
msgid "Unknown account '%1'"
msgstr "Descoñécese a conta «%1»"

#: libkgapi/common.h:139
#, kde-format
