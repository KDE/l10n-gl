#: custommakemanager.cpp:46
msgid "Custom Makefile Manager"
msgstr "Xestor de makefiles personalizados"

#: custommakemanager.cpp:46
msgid "Support for managing custom makefile projects"
msgstr "Soporta a xestión de proxectos con makefiles personalizados"

#: custommakemanager.cpp:78
msgid "Build &Target"
msgstr "Construir o &obxectivo"

#: custommakemanager.cpp:86
msgid "Build target"
msgstr "Construir o obxectivo"

#: custommakemanager.cpp:87
msgid ""
"<b>Build target</b><p>Runs <b>make targetname</b> from the project directory "
"(targetname is the name of the target selected).</p><p>Environment variables "
"and make arguments can be specified in the project settings dialog, <b>Build "
"Options</b> tab.</p>"
msgstr ""
"<b>Construir o obxectivo</b><p>Executa <b>make nomeObxectivo</b> no cartafol "
"do proxecto (nomeObxectivo é o nome do obxectivo escollido).</p><p>Pode "
"indicar variábeis de entorno e argumentos para make na páxina <b>Opcións de "
"construción</b> do diálogo de configuración do proxecto.</p>"

#: custommakemanager.cpp:315
msgid "Build this project"
msgstr "Construir este proxecto"

#: custommakemanager.cpp:322
msgid "Build this target"
msgstr "Construir este obxectivo"

#: custommakemanager.cpp:333
msgid "Build this directory"
msgstr "Construir este cartafol"

