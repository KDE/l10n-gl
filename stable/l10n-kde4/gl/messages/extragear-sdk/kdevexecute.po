#. i18n: file: nativeappconfig.ui:161
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: rc.cpp:42 rc.cpp:131
msgid "Dependencies"
msgstr "Dependencias"

#. i18n: file: nativeappconfig.ui:167
#. i18n: ectx: property (text), widget (QLabel, label_8)
#: rc.cpp:45 rc.cpp:134
msgid "Action:"
msgstr "Acción:"

#. i18n: file: nativeappconfig.ui:177
#. i18n: ectx: property (toolTip), widget (KComboBox, dependencyAction)
#: rc.cpp:48 rc.cpp:137
msgid ""
"Specifies the action to take for the dependencies before starting the "
"executable."
msgstr ""
"Especifica a acción que se ha de tomar coas dependencias antes de iniciar o "
"executábel."

#. i18n: file: nativeappconfig.ui:180
#. i18n: ectx: property (whatsThis), widget (KComboBox, dependencyAction)
#: rc.cpp:51 rc.cpp:140
msgid ""
"The selected action will be run before the executable is started.  This "
"allows there to be parts of a project, upon which the executable does not "
"directly depend, to be built and/or installed before running the application."
msgstr ""
"A acción seleccionada execútase antes de que se inicie o executábel. Isto "
"permite que haxa partes dun proxecto, dos cales non depende directamente o "
"executábel, que se constrúan ou instalen antes de executar o programa."

#. i18n: file: nativeappconfig.ui:187
#. i18n: ectx: property (text), item, widget (KComboBox, dependencyAction)
#: rc.cpp:54 rc.cpp:143
msgid "Do Nothing"
msgstr "Non facer nada"

#. i18n: file: nativeappconfig.ui:192
#. i18n: ectx: property (text), item, widget (KComboBox, dependencyAction)
#: rc.cpp:57 rc.cpp:146
msgid "Build"
msgstr "Construír"

#. i18n: file: nativeappconfig.ui:197
#. i18n: ectx: property (text), item, widget (KComboBox, dependencyAction)
#: rc.cpp:60 rc.cpp:149
msgid "Build and Install"
msgstr "Construír e instalar"

#. i18n: file: nativeappconfig.ui:205
#. i18n: ectx: property (text), widget (QLabel, label_7)
#: rc.cpp:63 rc.cpp:152
msgid "Targets:"
msgstr "Destinos:"

#. i18n: file: nativeappconfig.ui:218
#. i18n: ectx: property (toolTip), widget (ProjectItemLineEdit, targetDependency)
#. i18n: file: nativeappconfig.ui:221
#. i18n: ectx: property (clickMessage), widget (ProjectItemLineEdit, targetDependency)
#. i18n: file: nativeappconfig.ui:218
#. i18n: ectx: property (toolTip), widget (ProjectItemLineEdit, targetDependency)
#. i18n: file: nativeappconfig.ui:221
#. i18n: ectx: property (clickMessage), widget (ProjectItemLineEdit, targetDependency)
#: rc.cpp:66 rc.cpp:69 rc.cpp:155 rc.cpp:158
msgid "Enter a dependency to add to the list"
msgstr "Introduza unha dependencia para engadila á lista"

#. i18n: file: nativeappconfig.ui:241
#. i18n: ectx: property (toolTip), widget (QPushButton, addDependency)
#: rc.cpp:72 rc.cpp:161
msgid "Adds the listed target to the dependency list."
msgstr "Engade o destino listado á lista de dependencias."

#. i18n: file: nativeappconfig.ui:254
#. i18n: ectx: property (toolTip), widget (KListWidget, dependencies)
#: rc.cpp:75 rc.cpp:164
msgid "List of indirect dependent targets."
msgstr "Lista de destinos dependentes indirectos."

#. i18n: file: nativeappconfig.ui:257
#. i18n: ectx: property (whatsThis), widget (KListWidget, dependencies)
#: rc.cpp:78 rc.cpp:167
msgid ""
"This list should contain targets that the application does not directly "
"depend on, but for which an action needs to be taken before running the "
"application."
msgstr ""
"Esta lista debería conter os destinos dos que a o programa non depende "
"directamente, pero cos que hai que realizar unha acción antes de executar o "
"programa."

#. i18n: file: nativeappconfig.ui:273
#. i18n: ectx: property (toolTip), widget (QPushButton, removeDependency)
#: rc.cpp:81 rc.cpp:170
msgid "Removes the selected dependencies from the list."
msgstr "Elimina da lista as dependencias escollidas."

#. i18n: file: nativeappconfig.ui:286
#. i18n: ectx: property (toolTip), widget (QPushButton, moveDepUp)
#: rc.cpp:84 rc.cpp:173
msgid "Move a dependency up in the list."
msgstr "Sobe unha dependencia na lista."

#. i18n: file: nativeappconfig.ui:299
#. i18n: ectx: property (toolTip), widget (QPushButton, moveDepDown)
#: rc.cpp:87 rc.cpp:176
msgid "Moves the selected dependency down in the list."
msgstr "Baixa unha dependencia na lista."

