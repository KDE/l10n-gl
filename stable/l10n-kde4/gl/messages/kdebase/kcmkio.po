msgstr "&Aceitar todas as cookies"

#. i18n: tag string
#. i18n: file kcookiespoliciesdlg.ui line 104
#: rc.cpp:211
msgid "Re&ject all cookies"
msgstr "Re&xeitar todas as cookies"

#. i18n: tag string
