#: standard_actions_module.cpp:134
msgid "Standard Actions successfully saved"
msgstr "As accións estándar gardáronse con éxito"

#: standard_actions_module.cpp:136
msgid ""
"The changes have been saved. Please note that:<ul><li>Applications need to "
"be restarted to see the changes.</li>    <li>This change could introduce "
"shortcut conflicts in some applications.</li></ul>"
msgstr ""
"As modificacións foron gardadas. Lembre que:<ul><li>Os programas deben ser "
"reiniciados para ver as modificacións.</li> <li>Esta modificación pode "
"introducir conflitos de atallos nalgúns programas.</li></ul>"
