#: main.cpp:60
msgid "solidshell"
msgstr "solidshell"

#: main.cpp:62
msgid ""
"KDE tool for querying and controlling your hardware from the command line"
msgstr ""
"Ferramenta de KDE para pesquisar e controlar o hardware desde a liña de "
"comandos"

#: main.cpp:281
msgid "Syntax Error: Not enough arguments"
msgstr "Erro de sintaxe: Non hai suficientes argumentos"

#: main.cpp:287
msgid "Syntax Error: Too many arguments"
msgstr "Erro de sintaxe: Hai demasiados argumentos"

#: main.cpp:299
msgid "Show available commands by domains"
msgstr "Mostrar os comandos disponíbeis segundo os dominios"

#: main.cpp:301
msgid "Domain (see --commands)"
msgstr "Dominio (consulte --commands)"

#: main.cpp:303
msgid "Command (see --commands)"
msgstr "Comando (consulte --commands)"

#: main.cpp:305
msgid "Arguments for command"
msgstr "Argumentos para o comando"

#: main.cpp:317
msgid "Syntax:"
msgstr "Sintaxe:"

#: main.cpp:320
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # Lista o hárdware disponíbel no sistema.\n"
"             # - De especificarse a opción \"nonportableinfo\", as\n"
"             # propriedades do dispositivos son listadas (coidado, neste "
"caso\n"
"             # os nomes das propriedades dependen da infraestrutura),\n"
"             # - De especificarse a opción \"detalles\", as interfaces do\n"
"             # dispositivo e as propriedades correspondentes serán listadas\n"
"             # dun xeito independente da plataforma,\n"
"             # - Caso contrario só se listan as UDIs do dispositivo.\n"

#: main.cpp:330
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # Mostra todas as interfaces e propriedades do dispositivo\n"
"             # correspondentes a \"udi\" dun xeito neutro á platforma.\n"

#: main.cpp:334
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # Mostra todas as propriedades do dispositivo que corresponda "
"con \"udi\"\n"
"             # (coidado, neste caso os nomes da propriedades dependen da "
"infraestrutura).\n"

#: main.cpp:338
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # Lista a UDI dos dispositivos que correspondan con \"predicado"
"\".\n"
"             # - De especificarse \"parentUdi\", a procura restrínxese á\n"
"             # póla do dispositivo correspondente,\n"
"             # - Caso contrario a procura faise en todos os dispositivos.\n"

#: main.cpp:344
msgid ""
"             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr ""
"             # Se é aplicábel, monta o dispositivo que corresponde a \"udi"
"\".\n"

#: main.cpp:347
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr ""
"             # Se é aplicábel, desmonta o dispositivo correspondente a \"udi"
"\".\n"

#: main.cpp:350
msgid ""
"             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr ""
"             # Se é aplicábel, expulsa o dispositivo que corresponde a \"udi"
"\".\n"

#: main.cpp:357
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # method supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # supported power management schemes by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policy\n"
msgstr ""
"             # Lista un conxunto particular de información referente á "
"xestión da enerxía.\n"
"             # - De especificar a opción \"suspend\", dá a lista de métodos "
"de suspensión\n"
"             # soportados polo sistema\n"
"             # - De especificar a opción \"scheme\", dá a lista de\n"
"             # esquemas de xestión de enerxía soportados por este sistema\n"
"             # - De especificar a opción \"cpufreq\", dá a lista de "
"políticas\n"
"             # soportadas de frecuencia da CPU\n"

#: main.cpp:366
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # Estabelece as opcións de xestión de enerxía do sistema.\n"
"             # - De especificar a opción \"scheme\", o esquema de xestión\n"
"             # da enerxía corresponde a \"valor\"\n"
"             # - De especificar a opción \"cpufreq\", a política de "
"frecuencia da CPU\n"
"             # corresponderá a \"valor\"\n"

#: main.cpp:373
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # Suspende o ordenador empregando o \"método\" dado.\n"

#: main.cpp:378
msgid "             # List the network devices present.\n"
msgstr "             # Lista as interfaces de rede presentes.\n"

#: main.cpp:381
msgid ""
"             # List the networks known to the device specified by 'uni'.\n"
msgstr ""
"             # Lista as redes que coñece o dispositivo indicado por \"uni"
"\".\n"

#: main.cpp:384
msgid ""
"             # Query whether networking features are active or not.\n"
"             # - If the 'status' option is given, return whether\n"
"             # networking is enabled for the system\n"
"             # - If the 'wireless' option is is given, return whether\n"
"             # wireless is enabled for the system\n"
"             # - If the 'interface' option is given, print the\n"
"             # properties of the network interface that 'uni' refers to.\n"
"             # - If the 'network' option is given, print the\n"
"             # properties of the network on 'device-uni' that 'network-uni' "
"refers to.\n"
msgstr ""
"             # Pesquisa se as funcións de rede están activas ou non.\n"
"             # - Se especifica a opción \"status\", devolve se está\n"
"             # habilitada a rede no sistema\n"
"             # - Se especifica a opción \"wireless\", devolve se está\n"
"             # habilitada a rede wireless no sistema\n"
"             # - Se especifica a opción \"interface\", imprime as\n"
"             # propriedades da interfade de rede á que se refere \"uni\".\n"
"             # - Se especifica a opción \"network\", imprime as\n"
"             # propriedades da rede en \"device-uni\" á que se refere "
"\"network-uni\".\n"

#: main.cpp:395 main.cpp:398
msgid "             # Enable or disable networking on this system.\n"
msgstr "             # Habilita ou deshabilita a rede neste sistema.\n"

#: main.cpp:401
msgid ""
"             # Activate the network 'network-uni' on 'device-uni'.\n"
"             # Optionally, use WEP128, open-system encryption with hex key "
"'key'. (Hardcoded)\n"
"             # Where 'authentication' is one of:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgstr ""
"             # Activa a rede \"rede-uni\" en \"dispositivo-uni\".\n"
"             # Optionalmente, emprega WEP128, a cifraxe de sistema aberto "
"coa chave hexadecimal \"chave\". (No código)\n"
"             # Onde \"autenticación\" é unha de:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"\"chave\" [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes contrasinal\n"
"             # wpaeap NON IMPLEMENTADA EN SOLIDSHELL\n"

#: main.cpp:411
msgid "             # List bluetooth adapters/interfaces\n"
msgstr "             # Lista os adaptadores/interfaces bluetooth\n"

#: main.cpp:414
msgid "             # List bluetooth default adapter/interface\n"
msgstr "             # Lista o adaptador/interface bluetooth predeterminada\n"

#: main.cpp:417
msgid ""
"             # Query information about the bluetooth adapter/interface with "
"'ubi'\n"
msgstr ""
"             # Pesquisa information acerca do adaptador/interface bluetooth "
"con \"ubi\"\n"

#: main.cpp:420
msgid ""
"             # Set the bluetooth adapter name.\n"
"             # Set the bluetooth adapter mode. Where 'value' is one of:\n"
"             # off|connectable|discoverable\n"
msgstr ""
"             # Estabelece o nome do adaptador bluetooth.\n"
"             # Estabelelce o modo do adaptador bluetooth. \"Valor\" é un "
"de:\n"
"             # off|connectable|discoverable\n"

#: main.cpp:425
msgid "             # Scan for bluetooth remote devices.\n"
msgstr "             # Procura dispositivos bluetooth remotos.\n"

#: main.cpp:428
msgid "             # List configured input devices.\n"
msgstr "             # Lista os dispositivos de entrada configurados.\n"

#: main.cpp:431
msgid ""
"             # Setup bluetooth input device.\n"
"             # Remove configuration of remote input device.\n"
"             # Connect or disconnect bluetooth input device.\n"
msgstr ""
"             # Configura o dispostivo de entrada bluetooth.\n"
"             # Eliminar a configuración do dispositivo remoto de entrada.\n"
"             # Conecta ou desconecta o dispositivo de entrada bluetooth.\n"

#: main.cpp:436
msgid ""
"             # Create bonding (pairing) with bluetooth remote device.\n"
"             # Remove bonding of bluetooth remote device.\n"
"             # Check for bonding of bluetooth remote device.\n"
msgstr ""
"             # Cria unha asociación (emparella) co dispositivo bluetooth "
"remoto.\n"
"             # Elimina a asociación do dispositivo bluetooth remoto.\n"
"             # Comproba a asociación do dispositivo bluetooth remoto.\n"

