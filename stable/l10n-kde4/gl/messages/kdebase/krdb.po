msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance -> Colors in the Control Center and disable the checkbox\n"
"# \"Apply colors to non-KDE4 applications\"\n"
"#\n"
"#\n"
msgstr ""
"# creado por KDE, %1\n"
"#\n"
"# Se non quere que KDE ignoer a súa configuración de GTK, escolla\n"
"# Aparencia -> Cores no Centro de control e desmarque a opción\n"
"# \"Aplicar as cores a programas que non sexan de KDE4\"\n"
"#\n"
"#\n"
