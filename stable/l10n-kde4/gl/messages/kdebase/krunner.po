#: lock/lockdlg.cc:114
msgid "Unl&ock"
msgstr "&Desatrancar"

#: lock/lockdlg.cc:116
msgid "Sw&itch User..."
msgstr "&Mudar de usuario..."

#: lock/lockdlg.cc:184
msgid "<b>Unlocking failed</b>"
