msgstr "Borra a tarefa seleccionada"

#: timetrackerwidget.cpp:314
msgid "This will delete the selected task(s) and all subtasks."
msgstr "Isto borrará a(s) tarefa(s) seleccionada(s) e as súas subtarefas."

