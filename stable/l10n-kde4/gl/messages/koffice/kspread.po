"ODDLPRICE( Settlement; Maturity; Last; Rate; AnnualYield; Redemption; "
"Frequency [; Basis = 0 ] )"
msgstr ""
"ODDLPRICE(Asento; vencemento; Último; Taxa; Rendibilidade Anual; Exsención; "
"Frecuencia [; Base = 0 ] )"

#. i18n: file: functions/financial.xml:933
