msgstr "TTEST(x; y; tipo; modo)"

#. i18n: file: functions/statistical.xml:1486
#: xml_doc.cpp:4247
msgid "The VAR() function calculates the estimates variance based on a sample."
msgstr " A función VAR() estima a varianza con base nunha mostra."

#. i18n: file: functions/statistical.xml:1487
#: xml_doc.cpp:4249
msgid "VAR(value;value;...)"
msgstr " VAR(valor;valor;...)"

#. i18n: file: functions/statistical.xml:1488
