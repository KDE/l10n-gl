#: xml_doc.cpp:1657
msgid "INTRATE(\"2/28/2001\"; \"8/31/2001\"; 1000000; 2000000; 1) returns 1.98"
msgstr ""
" INTRATE(\"28/2/2001\"; \"31/8/2001\"; 1000000; 2000000;1) devolve 1,98"

