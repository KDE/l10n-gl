#. i18n: file: sweeperdialog.ui:37
#. i18n: ectx: property (text), widget (QTreeWidget, privacyListView)
#: rc.cpp:3 rc.cpp:90
msgid "Privacy Settings"
msgstr "Opcións de intimidade"

#. i18n: file: kprivacysettings.ui:35
#. i18n: ectx: property (text), widget (QLabel, textLabel1)
#: rc.cpp:6
msgid "Network privacy level:"
msgstr "Nível de intimidade na rede:"

#. i18n: file: kprivacysettings.ui:57
#. i18n: ectx: property (text), item, widget (QComboBox, _privacyLevel)
#: rc.cpp:9
msgid "Low"
msgstr "Baixo"

#. i18n: file: kprivacysettings.ui:62
#. i18n: ectx: property (text), item, widget (QComboBox, _privacyLevel)
#: rc.cpp:12
msgid "Medium"
msgstr "Medio"

#. i18n: file: kprivacysettings.ui:67
#. i18n: ectx: property (text), item, widget (QComboBox, _privacyLevel)
#: rc.cpp:15
msgid "High"
msgstr "Alto"

#. i18n: file: kprivacysettings.ui:72
#. i18n: ectx: property (text), item, widget (QComboBox, _privacyLevel)
#: rc.cpp:18
msgid "Custom"
msgstr "Personalizado"

#. i18n: file: kprivacysettings.ui:80
#. i18n: ectx: property (title), widget (Q3ButtonGroup, buttonGroup1_2)
#: rc.cpp:21
msgid "Financial Information"
msgstr "Información financeira"

#. i18n: file: kprivacysettings.ui:89
#. i18n: ectx: property (text), widget (QLabel, textLabel2)
#: rc.cpp:24
msgid ""
"Warn me when I visit a site that uses my financial or purchase information:"
msgstr ""
"Avisar cando visite un sitio que empregue a miña información financeira:"

#. i18n: file: kprivacysettings.ui:99
#. i18n: ectx: property (text), widget (QCheckBox, _warnFinancialMarketeer)
#. i18n: file: kprivacysettings.ui:135
#. i18n: ectx: property (text), widget (QCheckBox, _warnHealthMarketeer)
#: rc.cpp:27 rc.cpp:39
msgid "For marketing or advertising purposes"
msgstr "Para propósitos de publicidade e comercio"

#. i18n: file: kprivacysettings.ui:106
#. i18n: ectx: property (text), widget (QCheckBox, _warnFinancialSpammer)
#. i18n: file: kprivacysettings.ui:142
#. i18n: ectx: property (text), widget (QCheckBox, _warnHealthSpammer)
#. i18n: file: kprivacysettings.ui:178
#. i18n: ectx: property (text), widget (QCheckBox, _warnDemographicsSpammer)
#: rc.cpp:30 rc.cpp:42 rc.cpp:54
msgid "To share with other companies"
msgstr "Para partillar con outras compañías"

#. i18n: file: kprivacysettings.ui:116
#. i18n: ectx: property (title), widget (Q3ButtonGroup, buttonGroup1)
#: rc.cpp:33
msgid "Health Information"
msgstr "Información de saúde"

#. i18n: file: kprivacysettings.ui:125
#. i18n: ectx: property (text), widget (QLabel, textLabel2_2)
#: rc.cpp:36
msgid ""
"Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Avisar cando visite un sitio que empregue a miña información médica/saúde: "

#. i18n: file: kprivacysettings.ui:152
#. i18n: ectx: property (title), widget (Q3ButtonGroup, buttonGroup1_2_2)
#: rc.cpp:45
msgid "Demographics"
msgstr "Demográfica"

#. i18n: file: kprivacysettings.ui:161
#. i18n: ectx: property (text), widget (QLabel, textLabel2_3)
#: rc.cpp:48
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr ""
"Avisar cando visite un sitio que empregue a miña información non persoal:"

#. i18n: file: kprivacysettings.ui:171
#. i18n: ectx: property (text), widget (QCheckBox, _warnDemographicsBigBrother)
#: rc.cpp:51
msgid "To determine my interests, habits or general behavior"
msgstr "Para determinar os meus intereses, hábitos ou comportamento xeral"

#. i18n: file: kprivacysettings.ui:188
#. i18n: ectx: property (text), widget (QCheckBox, _warnSpammers)
#: rc.cpp:57
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Avisar cando visite un sitio que compartille a miña información persoal con "
"outras compañías"

#. i18n: file: kprivacysettings.ui:195
#. i18n: ectx: property (text), widget (QCheckBox, _warnShady)
#: rc.cpp:60
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr ""
"Avisar cando visite un sitio que non me permita coñecer a información que "
"posúen sobre min"

#. i18n: file: kprivacysettings.ui:202
#. i18n: ectx: property (title), widget (Q3ButtonGroup, buttonGroup4)
#: rc.cpp:63
msgid "Personal Information"
msgstr "Información persoal"

#. i18n: file: kprivacysettings.ui:211
#. i18n: ectx: property (text), widget (QLabel, textLabel2_2_2)
#: rc.cpp:66
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Avisarr cando visite un sitio que podería contactarme para información sobre "
"outros produtos ou servizos:"

#. i18n: file: kprivacysettings.ui:221
#. i18n: ectx: property (text), widget (QLabel, textLabel2_2_2_2)
#: rc.cpp:69
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr ""
"Avisar cando visite un sitio que podería usar a miña información persoal "
"para:"

#. i18n: file: kprivacysettings.ui:231
#. i18n: ectx: property (text), widget (QCheckBox, _warnPersonalHabits)
#: rc.cpp:72
msgid "Determine my habits, interests or general behavior"
msgstr "Determinar os meus hábitos, intereses ou comportamento xeral"

#. i18n: file: kprivacysettings.ui:243
#. i18n: ectx: property (text), widget (QCheckBox, _warnPersonalTelephone)
#: rc.cpp:75
msgid "Via telephone"
msgstr "Por teléfono"

#. i18n: file: kprivacysettings.ui:250
#. i18n: ectx: property (text), widget (QCheckBox, _warnPersonalMail)
#: rc.cpp:78
msgid "Via mail"
msgstr "Por carta"

#. i18n: file: kprivacysettings.ui:264
#. i18n: ectx: property (text), widget (QCheckBox, _warnPersonalEmail)
#: rc.cpp:81
msgid "Via email"
msgstr "Por correo electrónico"

#. i18n: file: kprivacysettings.ui:271
#. i18n: ectx: property (text), widget (QCheckBox, _warnPersonalBigBrother)
#: rc.cpp:84
msgid "And do not allow me to remove my contact information"
msgstr "E que non me permita borrar a miña información de contacto"

#. i18n: file: sweeperdialog.ui:27
#. i18n: ectx: property (whatsThis), widget (QTreeWidget, privacyListView)
#: rc.cpp:87
msgid ""
"Check all cleanup actions you would like to perform. These will be executed "
"by pressing the button below"
msgstr ""
"Decida a accións de limpeza que quere levar a cabo. Estas executaranse "
"premendo o botón de embaixo"

#. i18n: file: sweeperdialog.ui:42
#. i18n: ectx: property (text), widget (QTreeWidget, privacyListView)
#: rc.cpp:93
msgid "Description"
msgstr "Descrición"

#. i18n: file: sweeperdialog.ui:58
#. i18n: ectx: property (text), widget (KPushButton, selectAllButton)
#: rc.cpp:96
msgid "Select &All"
msgstr "Escoller &todo"

#. i18n: file: sweeperdialog.ui:65
#. i18n: ectx: property (text), widget (KPushButton, selectNoneButton)
#: rc.cpp:99
msgid "Select &None"
msgstr "Non escoller &nengún"

#. i18n: file: sweeperdialog.ui:88
#. i18n: ectx: property (whatsThis), widget (KPushButton, cleanupButton)
#: rc.cpp:102
msgid "Immediately performs the cleanup actions selected above"
msgstr "Realiza imediatamente as accións de limpeza escollidas enriba"

#. i18n: file: sweeperdialog.ui:91
#. i18n: ectx: property (text), widget (KPushButton, cleanupButton)
#: rc.cpp:105
msgid "&Clean Up"
msgstr "&Limpar"

#: rc.cpp:106
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Xabi García, mvillarino"

#: rc.cpp:107
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "xabigf@gmx.net, mvillarino@users.sourceforge.net"

#: sweeper.cpp:50
msgctxt "General system content"
msgid "General"
msgstr "Xeral"

#: sweeper.cpp:52
msgctxt "Web browsing content"
msgid "Web Browsing"
msgstr "Navegación web"

#: sweeper.cpp:121
msgid ""
"You are deleting data that is potentially valuable to you. Are you sure?"
msgstr ""
"Está a borrar dados que son potencialmente valiosos para vostede. Está "
"seguro?"

#: sweeper.cpp:126
msgid "Starting cleanup..."
msgstr "Comezando a limpeza..."

#: sweeper.cpp:132
#, kde-format
msgid "Clearing %1..."
msgstr "Limpando %1..."

#: sweeper.cpp:137
#, kde-format
msgid "Clearing of %1 failed: %2"
msgstr "Fallou a limpeza de %1: %2"

#: sweeper.cpp:143
msgid "Clean up finished."
msgstr "Rematou a limpeza."

#: privacyfunctions.h:36
msgid "Cookies"
msgstr "Cookies"

#: privacyfunctions.h:37
msgid "Clears all stored cookies set by websites"
msgstr "Limpa todas as cookies gardadas por sitios web"

#: privacyfunctions.h:47
msgid "Cookie Policies"
msgstr "Políticas da cookie"

#: privacyfunctions.h:48
msgid "Clears the cookie policies for all visited websites"
msgstr "Limpa as políticas de cookie para todas as páxinas visitadas"

#: privacyfunctions.h:57
msgid "Saved Clipboard Contents"
msgstr "Contidos do portarretallos gardados"

#: privacyfunctions.h:58
msgid "Clears the clipboard contents stored by Klipper"
msgstr "Limpa os contidos do portarretallos gardados por Klipper"

#: privacyfunctions.h:68
msgid "Clears all cached thumbnails"
msgstr "Limpa todas as miniaturas na caché"

#: privacyfunctions.h:77
msgid "Run Command History"
msgstr "Historial de comandos executados"

#: privacyfunctions.h:78
msgid ""
"Clears the history of commands run through the Run Command tool on the "
"desktop"
msgstr ""
"Limpa o histórico de comandos executados mediante a ferramenta Executar "
"Comando do escritorio"

#: privacyfunctions.h:87
msgid "Form Completion Entries"
msgstr "Entradas de completación de formularios"

#: privacyfunctions.h:88
msgid "Clears values which were entered into forms on websites"
msgstr "Limpa os valores que foron introducidos en formularios de sitios web"

#: privacyfunctions.h:97
msgid "Web History"
msgstr "Historial web"

#: privacyfunctions.h:98
msgid "Clears the history of visited websites"
msgstr "Limpa o histórico de sitios web visitados"

#: privacyfunctions.h:107
msgid "Web Cache"
msgstr "Caché web"

#: privacyfunctions.h:108
msgid "Clears the temporary cache of websites visited"
msgstr "Limpa a caché temporal de sitios web visitados"

#: privacyfunctions.h:117
msgid "Recent Documents"
msgstr "Documentos recentes"

#: privacyfunctions.h:118
msgid ""
"Clears the list of recently used documents from the KDE applications menu"
msgstr ""
"Limpa a lista de documentos usados recentemente do menú de programas de KDDE"

#: privacyfunctions.h:127
msgid "Favorite Icons"
msgstr "Ícones de páxina"

#: privacyfunctions.h:128
msgid "Clears the FavIcons cached from visited websites"
msgstr "Limpa a caché de ícones de páxina dos sítios web visitados"

#: privacyfunctions.h:137
msgid "Recent Applications"
msgstr "Programas recentes"

#: privacyfunctions.h:138
msgid "Clears the list of recently used applications from KDE menu"
msgstr "Limpa a lista de programas empregados recentemente do menú de KDE"
