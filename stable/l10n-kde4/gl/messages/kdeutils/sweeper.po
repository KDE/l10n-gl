#: main.cpp:28
msgid "Sweeper"
msgstr "Barrendeiro"

#: main.cpp:29
msgid "Helps clean unwanted traces the user leaves on the system."
msgstr "Axuda a eliminar as pegadas que o usuario deixa no sistema."

#: main.cpp:30
msgid "(c) 2003-2005, Ralf Hoelzer"
msgstr "(c) 2003-2005, Ralf Hoelzer"

