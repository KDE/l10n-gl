#: karambaapp.cpp:196
msgid ""
"<qt>Hiding the system tray icon will keep SuperKaramba running in "
"background. To show it again use the theme menu.</qt>"
msgstr ""
"<qt>Se oculta o ícone da bandexa do sistema, SuperKaramba permanecerá "
"funcionando en segundo plano. Para mostrar de novo o ícone, utilice o menú "
"do tema.</qt>"

