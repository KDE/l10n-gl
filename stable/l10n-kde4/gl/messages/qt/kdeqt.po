msgstr "exactamente un"

#: xmlpatterns/type/qcardinality.cpp:61
msgid "one or more"
msgstr "un ou máis"

#: xmlpatterns/type/qcardinality.cpp:63
msgid "zero or more"
msgstr "cero ou máis"

#: xmlpatterns/utils/qoutputvalidator.cpp:86
