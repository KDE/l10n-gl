msgstr ""
"A URI dun espazo de nomes no nome dun atributo calculado non pode ser %1."

#: xmlpatterns/expr/qattributenamevalidator.cpp:75
#, qt-format
msgid ""
"The name for a computed attribute cannot have the namespace URI %1 with the "
