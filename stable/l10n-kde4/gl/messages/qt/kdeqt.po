msgstr "Converter de %1 a %2 pode causar perda de precisión."

#: xmlpatterns/type/qtypechecker.cpp:156
msgid "The focus is undefined."
msgstr "O foco non está definido."

#: xmlpatterns/type/qcardinality.cpp:55
