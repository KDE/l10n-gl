#: mediaobject.cpp:89
msgid ""
"Cannot start playback. \n"
"\n"
"Check your Gstreamer installation and make sure you \n"
"have libgstreamer-plugins-base installed."
msgstr ""
"Non é posíbel reproducir.\n"
"\n"
"Comprobe a instalación de Gstreamer e verifique \n"
"que ten instalado libgstreamer-plugins-base."

#: mediaobject.cpp:202
#, qt-format
msgid ""
"A required codec is missing. You need to install the following codec(s) to "
"play this content: %0"
msgstr ""

#: mediaobject.cpp:882 mediaobject.cpp:891 mediaobject.cpp:906
#: mediaobject.cpp:911 mediaobject.cpp:916 mediaobject.cpp:935
#: mediaobject.cpp:1257 mediaobject.cpp:1281
msgid "Could not open media source."
msgstr "Non foi posíbel abrir a orixe dos medios."

#: mediaobject.cpp:896
msgid "Invalid source type."
msgstr "Tipo de orixe non válido."

#: mediaobject.cpp:1255
msgid "Could not locate media source."
msgstr "Non foi posíbel localizar a orixe do medio."

#: mediaobject.cpp:1265
msgid "Could not open audio device. The device is already in use."
msgstr ""
"Non foi posíbel abrir o dispositivo de audio. O dispositivo xa está en uso."

#: mediaobject.cpp:1278
msgid "Could not decode media source."
msgstr "Non foi posíbel decodificar a fonte do medio."

#: backend.cpp:171
msgid ""
"Warning: You do not seem to have the package gstreamer0.10-plugins-good "
"installed.\n"
"          Some video features have been disabled."
msgstr ""
"Aviso: Non semella ter instalado o paquete gstreamer0.10-plugins-good.\n"
"           Algunhas funcionalidades de vídeo foron deshabilitadas."

#: backend.cpp:176
msgid ""
"Warning: You do not seem to have the base GStreamer plugins installed.\n"
"          All audio and video support has been disabled"
msgstr ""
"Aviso: Non semella ter instaladas as extensións de GStreamer.\n"
"           Deshabilitouse todo o soporte de imaxe e son"
