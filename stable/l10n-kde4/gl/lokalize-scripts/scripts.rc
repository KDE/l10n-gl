<KrossScripting>
  <collection comment="Utilidades" name="tools" text="Utilidades">
    <script comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" enabled="false" interpreter="python" name="widget-text-capture" icon="text-x-python" text="Captura do texto de widgets"/>
    <script enabled="false" interpreter="python" name="Apertium MT" icon="text-x-python" text="Translate source text via Apertium"/>
    <script comment="Open source file" enabled="false" interpreter="python" name="opensrc" icon="text-x-python" text="Open source file">
      <property name="autorun">true</property>
    </script>
    <script enabled="false" interpreter="python" name="Mark as rejected" icon="text-x-python" text="Adds a predefined comment intended to be a rejection mark"/>
  </collection>
</KrossScripting>
