<KrossScripting>
  <collection name="tools" comment="Utilidades" text="Utilidades">
    <script enabled="false" name="widget-text-capture" comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" icon="text-x-python" text="Captura do texto de widgets" interpreter="python"/>
    <script enabled="false" name="Apertium MT" icon="text-x-python" text="Translate source text via Apertium" interpreter="python"/>
    <script enabled="false" name="opensrc" comment="Open source file" icon="text-x-python" text="Open source file" interpreter="python">
      <property name="autorun">true</property>
    </script>
    <script enabled="false" name="Mark as rejected" icon="text-x-python" text="Adds a predefined comment intended to be a rejection mark" interpreter="python"/>
  </collection>
</KrossScripting>
