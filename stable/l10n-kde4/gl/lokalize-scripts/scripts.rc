<KrossScripting>
  <collection comment="Utilidades" text="Utilidades" name="tools">
    <script comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" interpreter="python" icon="text-x-python" text="Captura do texto de widgets" name="widget-text-capture" enabled="false"/>
    <script interpreter="python" icon="text-x-python" text="Translate source text via Apertium" name="Apertium MT" enabled="false"/>
    <script comment="Open source file" interpreter="python" icon="text-x-python" text="Open source file" name="opensrc" enabled="false">
      <property name="autorun">true</property>
    </script>
    <script interpreter="python" icon="text-x-python" text="Adds a predefined comment intended to be a rejection mark" name="Mark as rejected" enabled="false"/>
  </collection>
</KrossScripting>
