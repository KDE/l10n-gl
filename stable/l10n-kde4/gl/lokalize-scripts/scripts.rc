<KrossScripting>
  <collection comment="Utilidades" text="Utilidades" name="tools">
    <script comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" text="Captura do texto de widgets" interpreter="python" icon="text-x-python" enabled="false" name="widget-text-capture"/>
    <script text="Translate source text via Apertium" interpreter="python" icon="text-x-python" enabled="false" name="Apertium MT"/>
    <script comment="Open source file" text="Open source file" interpreter="python" icon="text-x-python" enabled="false" name="opensrc">
      <property name="autorun">true</property>
    </script>
    <script text="Adds a predefined comment intended to be a rejection mark" interpreter="python" icon="text-x-python" enabled="false" name="Mark as rejected"/>
  </collection>
</KrossScripting>
