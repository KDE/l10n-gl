<KrossScripting>
  <collection name="tools" comment="Utilidades" text="Utilidades">
    <script name="widget-text-capture" comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" enabled="false" text="Captura do texto de widgets" icon="text-x-python" interpreter="python"/>
    <script name="Apertium MT" enabled="false" text="Translate source text via Apertium" icon="text-x-python" interpreter="python"/>
    <script name="opensrc" comment="Open source file" enabled="false" text="Open source file" icon="text-x-python" interpreter="python">
      <property name="autorun">true</property>
    </script>
    <script name="Mark as rejected" enabled="false" text="Adds a predefined comment intended to be a rejection mark" icon="text-x-python" interpreter="python"/>
  </collection>
</KrossScripting>
