<KrossScripting>
  <collection name="tools" text="Utilidades" comment="Utilidades">
    <script name="widget-text-capture" icon="text-x-python" text="Captura do texto de widgets" interpreter="python" comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" enabled="false"/>
    <script name="Apertium MT" icon="text-x-python" text="Translate source text via Apertium" interpreter="python" enabled="false"/>
    <script name="opensrc" icon="text-x-python" text="Open source file" interpreter="python" comment="Open source file" enabled="false">
      <property name="autorun">true</property>
    </script>
    <script name="Mark as rejected" icon="text-x-python" text="Adds a predefined comment intended to be a rejection mark" interpreter="python" enabled="false"/>
  </collection>
</KrossScripting>
