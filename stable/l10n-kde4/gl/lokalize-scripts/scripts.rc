<KrossScripting>
  <collection text="Utilidades" comment="Utilidades" name="tools">
    <script text="Captura do texto de widgets" comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" interpreter="python" enabled="false" name="widget-text-capture" icon="text-x-python"/>
    <script text="Translate source text via Apertium" interpreter="python" enabled="false" name="Apertium MT" icon="text-x-python"/>
    <script text="Open source file" comment="Open source file" interpreter="python" enabled="false" name="opensrc" icon="text-x-python">
      <property name="autorun">true</property>
    </script>
    <script text="Adds a predefined comment intended to be a rejection mark" interpreter="python" enabled="false" name="Mark as rejected" icon="text-x-python"/>
  </collection>
</KrossScripting>
