<KrossScripting>
  <collection text="Utilidades" name="tools" comment="Utilidades">
    <script text="Captura do texto de widgets" enabled="false" name="widget-text-capture" comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" icon="text-x-python" interpreter="python"/>
    <script text="Translate source text via Apertium" enabled="false" name="Apertium MT" icon="text-x-python" interpreter="python"/>
    <script text="Open source file" enabled="false" name="opensrc" comment="Open source file" icon="text-x-python" interpreter="python">
      <property name="autorun">true</property>
    </script>
    <script text="Adds a predefined comment intended to be a rejection mark" enabled="false" name="Mark as rejected" icon="text-x-python" interpreter="python"/>
  </collection>
</KrossScripting>
