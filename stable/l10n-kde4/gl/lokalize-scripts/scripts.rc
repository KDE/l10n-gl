<KrossScripting>
  <collection name="tools" comment="Utilidades" text="Utilidades">
    <script name="widget-text-capture" comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" interpreter="python" text="Captura do texto de widgets" icon="text-x-python" enabled="false"/>
    <script name="Apertium MT" interpreter="python" text="Translate source text via Apertium" icon="text-x-python" enabled="false"/>
    <script name="opensrc" comment="Open source file" interpreter="python" text="Open source file" icon="text-x-python" enabled="false">
      <property name="autorun">true</property>
    </script>
    <script name="Mark as rejected" interpreter="python" text="Adds a predefined comment intended to be a rejection mark" icon="text-x-python" enabled="false"/>
  </collection>
</KrossScripting>
