<KrossScripting>
  <collection comment="Utilidades" name="tools" text="Utilidades">
    <script comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" name="widget-text-capture" enabled="false" interpreter="python" text="Captura do texto de widgets" icon="text-x-python"/>
    <script name="Apertium MT" enabled="false" interpreter="python" text="Translate source text via Apertium" icon="text-x-python"/>
    <script comment="Open source file" name="opensrc" enabled="false" interpreter="python" text="Open source file" icon="text-x-python">
      <property name="autorun">true</property>
    </script>
    <script name="Mark as rejected" enabled="false" interpreter="python" text="Adds a predefined comment intended to be a rejection mark" icon="text-x-python"/>
  </collection>
</KrossScripting>
