<KrossScripting>
  <collection comment="Utilidades" name="tools" text="Utilidades">
    <script comment="Prema co botón central do rato nun widget de calquera programa de KDE para iniciar a procura na TM en todas as fiestras de Lokalize que teña abertas" enabled="false" icon="text-x-python" name="widget-text-capture" text="Captura do texto de widgets" interpreter="python"/>
    <script enabled="false" icon="text-x-python" name="Apertium MT" text="Translate source text via Apertium" interpreter="python"/>
    <script comment="Open source file" enabled="false" icon="text-x-python" name="opensrc" text="Open source file" interpreter="python">
      <property name="autorun">true</property>
    </script>
    <script enabled="false" icon="text-x-python" name="Mark as rejected" text="Adds a predefined comment intended to be a rejection mark" interpreter="python"/>
  </collection>
</KrossScripting>
