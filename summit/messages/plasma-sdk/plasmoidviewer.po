#. +> trunk6 stable6 stable5
#: main.cpp:37
#, kde-format
msgid "Plasmoidviewer"
msgstr "Visor de trebellos"

#. +> trunk6 stable6 stable5
#: main.cpp:44
#, kde-format
msgid "Run Plasma widgets in their own window"
msgstr "Executa trebellos de Plasma nunha xanela de seu"

#. +> trunk6 stable6 stable5
#: main.cpp:47
#, kde-format
msgid "The name of the containment plugin"
msgstr "O nome do complemento contedor."

#. +> trunk6 stable6 stable5
#: main.cpp:51
#, kde-format
msgid "The name of the applet plugin"
msgstr "O nome do complemento do miniaplicativo."

#. +> trunk6 stable6 stable5
#: main.cpp:53
#, kde-format
msgid "The formfactor to use (horizontal, vertical, mediacenter, planar or application)"
msgstr "O factor de forma para usar (horizontal, vertical, de centro de medios, planar ou de aplicación)."

# skip-rule: PT-2012-dual_border(2)
#. +> trunk6 stable6 stable5
#: main.cpp:58
#, kde-format
msgid "The location constraint to start the Containment with (floating, desktop, fullscreen, topedge, bottomedge, leftedge, rightedge)"
msgstr "A restrición de posición coa que iniciar o contedor (flotante, de escritorio, a pantalla completa, bordo superior, bordo inferior, bordo esquerdo, ou bordo dereito)."

#. +> trunk6 stable6 stable5
#: main.cpp:63
#, kde-format
msgid "Set the x position of the plasmoidviewer on the Plasma desktop"
msgstr "Definir a posición horizontal (X) do visor de trebellos no escritorio Plasma."

#. +> trunk6 stable6 stable5
#: main.cpp:66
#, kde-format
msgid "Set the y position of the plasmoidviewer on the Plasma desktop"
msgstr "Definir a posición vertical (Y) do visor de trebellos no escritorio Plasma."

#. +> trunk6 stable6 stable5
#: main.cpp:69
#, kde-format
msgid "Set the window size of the plasmoidview"
msgstr "Definir o tamaño da xanela do visor de trebellos."

#. +> trunk6 stable6 stable5
#: main.cpp:72
#, kde-format
msgid "The size in kB to set the pixmap cache to"
msgstr "O tamaño en kB para asignarlle á caché do mapa de píxeles."

#. +> trunk6 stable6 stable5
#: main.cpp:75
#, kde-format
msgid "The name of the theme which the shell will use"
msgstr "O nome do tema que usar na shell."

#. +> trunk6 stable6 stable5
#: main.cpp:78
#, kde-format
msgid "Data that should be passed to the applet as 'externalData' event"
msgstr "Data que debería pasarse ao miniaplicativo como o evento «externalData»."

#. +> trunk6 stable6 stable5
#: view.cpp:123
#, kde-format, no-c-format
msgid "Applet %1 does not exist."
msgstr "O miniaplicativo %1 non existe."

#. +> trunk6 stable6 stable5
#: view.cpp:140
#, kde-format, no-c-format
msgid "Containment %1 does not exist."
msgstr "O contedor %1 non existe."

#. +> trunk6 stable6 stable5
#: view.cpp:313
#, kde-format
msgctxt "@title:window"
msgid "Save Screenshot"
msgstr "Gardar unha captura de pantalla"
