#. +> trunk6 stable6
#: module.cpp:65
#, kde-format
msgctxt "@title"
msgid "Memory Shortage Avoided"
msgstr "Evitouse exceder a memoria"

#. +> trunk6 stable6
#: module.cpp:68
#, kde-kuit-format
msgctxt "@info"
msgid "<command>%1</command> has been terminated by the Linux kernel because the system is low on memory. Consider closing unused applications or browser tabs."
msgstr "O núcleo de Linux puxo fin a <command>%1</command> porque o sistema ten pouca memoria. Considere pechar aplicacións e lapelas do navegador que non estea a usar."

#. +> trunk6 stable6
#: module.cpp:74
#, kde-kuit-format
msgctxt "@info"
msgid "The background service <command>%1</command> has been terminated by the Linux kernel because the system is low on memory. Consider closing unused applications or browser tabs."
msgstr "O núcleo de Linux puxo fin ao servizo en segundo plano <command>%1</command> porque o sistema ten pouca memoria. Considere pechar aplicacións e lapelas do navegador que non estea a usar."

#. +> trunk6 stable6
#: module.cpp:82
#, kde-format
msgctxt "@action"
msgid "Restart Application"
msgstr "Reiniciar a aplicación"
