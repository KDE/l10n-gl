#. +> trunk5
#: man-kjs5.1.docbook:61
#, no-c-format
msgid "Description"
msgstr "Descrición"

#. Tag: para
#. +> trunk5
#: man-kjs5.1.docbook:63
#, no-c-format
msgid "<command>kjs</command> is KDE ECMAScript/JavaScript engine."
msgstr "<command>kjs</command> é o motor de ECMAScript/JavaScript para KDE."

#. Tag: title
#. +> trunk5
#: man-kjs5.1.docbook:68
#, no-c-format
msgid "Application Options"
msgstr "Opcións da aplicación"

#. Tag: term
#. +> trunk5
#: man-kjs5.1.docbook:72
#, no-c-format
msgid "<option>--help</option>,<option>-help</option>,<option>-h</option>"
msgstr "<option>--help</option>,<option>-help</option>,<option>-h</option>"

#. Tag: para
#. +> trunk5
#: man-kjs5.1.docbook:74
#, no-c-format
#| msgid "Show <command>kjscmd</command> usage."
msgid "Show <command>kjs5</command> usage."
msgstr "Amosar información de uso de <command>kjs5</command>."

#. Tag: term
#. +> trunk5
#: man-kjs5.1.docbook:81
#, no-c-format
#| msgid "<option>--help</option>,<option>-help</option>,<option>-h</option>"
msgid "<option>--version</option>,<option>-version</option>,<option>-v</option>"
msgstr "<option>--version</option>,<option>-version</option>,<option>-v</option>"

#. Tag: para
#. +> trunk5
#: man-kjs5.1.docbook:83
#, no-c-format
#| msgid "Show <command>kjscmd</command> usage."
msgid "Show <command>kjs5</command> version."
msgstr "Amosar a versión de <command>kjs5</command>."

#. Tag: term
#. +> trunk5
#: man-kjs5.1.docbook:90
#, no-c-format
msgid "<option>-e</option><parameter> statement</parameter>"
msgstr "<option>-e</option><parameter> sentenza</parameter>"

#. Tag: para
#. +> trunk5
#: man-kjs5.1.docbook:92
#, no-c-format
msgid "Executes the statement and exits. For example:"
msgstr "Executa a sentenza e sae. Por exemplo:"

#. Tag: screen
#. +> trunk5
#: man-kjs5.1.docbook:93
#, no-c-format
#| msgid "<command>kjs</command> -e \"print('hello world')\""
msgid "<command>kjs5</command> -e \"print('hello world')\""
msgstr "<command>kjs5</command> -e \"print('Ola, mundo!')\""

#. Tag: parameter
#. +> trunk5
#: man-kjs5.1.docbook:98
#, no-c-format
msgid "script"
msgstr "guión"

#. Tag: para
#. +> trunk5
#: man-kjs5.1.docbook:100
#, no-c-format
msgid "Executes the statements included in file <parameter>script</parameter>."
msgstr "Executa as sentenzas incluídas no ficheiro <parameter>script</parameter>."

#. Tag: title
#. +> trunk5
#: man-kjs5.1.docbook:109
#, no-c-format
msgid "Usage"
msgstr "Uso"

#. Tag: para
#. +> trunk5
#: man-kjs5.1.docbook:110
#, no-c-format
#| msgid "<command>kjs</command> <parameter>file</parameter>, as many other interpreters, when called without parameters uses a line editor to enter statements, showing the prompt <literallayout>JS></literallayout> To exit the line editor type <command>quit()</command> or press <command>Ctrl+D</command>."
msgid "<command>kjs5</command> <parameter>file</parameter>, as many other interpreters, when called without parameters uses a line editor to enter statements, showing the prompt <literallayout>JS></literallayout> To exit the line editor type <command>quit()</command> or press <command>Ctrl+D</command>."
msgstr "<command>kjs5</command> <parameter>ficheiro</parameter>, como moitos outros intérpretes, cando se executa sen parámetros uses un editor de liñas para inserir as sentenzas, neste caso co indicador do sistema  <literallayout>JS></literallayout>. Para saír do editor escriba <command>quit()</command> ou prema <command>Ctrl+D</command>."

#. Tag: title
#. +> trunk5
#: man-kjs5.1.docbook:119
#, no-c-format
msgid "See Also"
msgstr "Consulte tamén"

