#. Tag: cmdsynopsis
#. +> trunk5
#: man-kjs5.1.docbook:38
#, no-c-format
#| msgid "<command>kjs</command> <group> <arg choice=\"opt\">--help</arg> <arg choice=\"opt\">-help</arg> <arg choice=\"opt\">-h</arg> </group> <group> <arg choice=\"opt\">-e<replaceable> statement</replaceable></arg> </group> <group> <arg choice=\"plain\"><replaceable>script</replaceable></arg> </group>"
msgid "<command>kjs5</command> <group> <arg choice=\"opt\">--help</arg> <arg choice=\"opt\">-help</arg> <arg choice=\"opt\">-h</arg> </group> <group> <arg choice=\"opt\">--version</arg> <arg choice=\"opt\">-version</arg> <arg choice=\"opt\">-v</arg> </group> <group> <arg choice=\"opt\">-e<replaceable> statement</replaceable></arg> </group> <group> <arg choice=\"plain\"><replaceable>script</replaceable></arg> </group>"
msgstr "<command>kjs5</command> <group> <arg choice=\"opt\">--help</arg> <arg choice=\"opt\">-help</arg> <arg choice=\"opt\">-h</arg> </group> <group> <arg choice=\"opt\">--version</arg> <arg choice=\"opt\">-version</arg> <arg choice=\"opt\">-v</arg> </group> <group> <arg choice=\"opt\">-e<replaceable> sentenza</replaceable></arg> </group> <group> <arg choice=\"plain\"><replaceable>guión</replaceable></arg> </group>"

