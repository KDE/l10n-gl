#. Tag: title
#. +> trunk5
#: man-kjs5.1.docbook:124
#, no-c-format
msgid "Bugs"
msgstr "Fallos"

#. Tag: para
#. +> trunk5
#: man-kjs5.1.docbook:125
#, no-c-format
#| msgid "There are probably tons of bugs. Use <ulink url=\"http://bugs.kde.org\">bugs.kde.org</ulink> to report them."
msgid "Please use <ulink url=\"http://bugs.kde.org\">KDE's bugtracker</ulink> to report bugs."
msgstr "Use o <ulink url=\"http://bugs.kde.org\">sistema de seguimento de incidencias de KDE</ulink> para informar de fallos."
