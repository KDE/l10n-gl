#. Tag: guimenuitem
#. +> trunk6 stable6
#: index.docbook:115
#, no-c-format
msgid "Scale"
msgstr "Escala"

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:119
#, no-c-format
msgid "This option lets you set the ruler scale to <guilabel>Right to Left</guilabel> (<keycap>D</keycap>), <guilabel>Center Origin</guilabel> (<keycap>C</keycap>), <guilabel>Offset</guilabel> (<keycap>O</keycap>) and <guilabel>Percentage</guilabel>."
msgstr "Esta opción permite configurar a escala da regra como <guilabel>Dereita a esquerda</guilabel> (<keycap>D</keycap>), <guilabel>Centrar na orixe</guilabel> (<keycap>C</keycap>), <guilabel>Desprazamento</guilabel> (<keycap>O</keycap>) e <guilabel>Porcentaxe</guilabel>."

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:122
#, no-c-format
msgid "Changing the offset via the mousewheel is also possible when holding the &LMB;."
msgstr ""

#. Tag: guimenuitem
#. +> trunk6 stable6
#: index.docbook:129
#, no-c-format
msgid "Opacity"
msgstr "Opacidade"

#. Tag: para
#. +> trunk6 stable6
#: index.docbook:133
#, no-c-format
