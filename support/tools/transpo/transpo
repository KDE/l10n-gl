# Purpose: Print formatted --help output
# Usage: PrintHelp("-shortoption", "--longoption", "description");
sub PrintHelp ($$$) {
	printf "%-4s %-15s %s\n", "$_[0]", "$_[1]", "$_[2]";
}

# Purpose: Print the transpo version number
# Usage: Version();
sub Version () {
	print "\ntranspo version $Version\n";
}

# Purpose: Print our help
# Usage: Help();
sub Help (){
	my $Command = basename($0);
	Version;
	print "\n";
	print "Usage: $Command file1 file2 ...\n";
	print "  or : $Command [Options] file1 file2 ...\n\n";
	PrintHelp("-h", "--help", "Display this help screen");
	PrintHelp("-n", "--nn2nb", "Use Nynorsk to Bokmaal dictionary (transpo-nn2nb.dict)");
	PrintHelp("-a", "--da2nb", "Use Danish to Norwegian Bokmaal dictionary (transpo-da2nb.dict)");
	PrintHelp("-d", "--dict X", "Use the dictionary file X");
	PrintHelp("-b", "--backup", "Write a backup to file.orig (overwrites file.orig if it already exists");
	PrintHelp("-r", "--removebr", "Don't actually replace anything, just remove linebreaks from msgstr");
	PrintHelp("-v", "--verbose", "Use verbose mode");
	print "\nBy default transpo will try, in this order:\ntranspo.dict -> transpo-nn2nb.dict -> transpo-da2nb.dict\n\n"
}

