# Display help and exit if we got no commandline options
Help() and exit 0 unless @ARGV;

# Parse commandline arguments
GetOptions (
	'version' => sub { Version(); print "CVS Revision: $RCSRev\n"; exit 0; },
	'b|backup' => \$WriteBackup,
	'help|h' => sub { &Help; exit 0 },
	'nn2nb|n' => sub { $BaseDictionary = "transpo-nn2nb.dict"; },
	'da2nb|a' => sub { $BaseDictionary = "transpo-da2nb.dict"; },
	'dict|d=s' => \$BaseDictionary,
	'verbose|v' => \$Verbose,
	'r|removebr' => \$RemoveBROnly,
	'debug|D' => \$DebugMode
) or die "See --help for more information\n";

die "I need to know which file to run on\n" unless @ARGV;

unless ($RemoveBROnly) {
	# Detect the location of the dictionary
	DetectDictionary();
}

# Okay, if we got this far then start replacing stuff :)
StartReplacement();
