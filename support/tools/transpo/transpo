# Purpose: Start replacing files
# Usage: StartReplacement();
sub StartReplacement () {
	my @dict;
	my $filename;
	unless ($RemoveBROnly) {
		vprint("Reading dictionary $Dictionary");
		@dict = readdict($Dictionary); 	# Read the dictionary file.
	}
	foreach $filename(@ARGV) { 		# For each file to be processed
		replaceFile($filename,\@dict) 	# replace strings.
	}
}

# Purpose: Detect the dictionary file we want to use (sets $Dictionary or dies)
# Usage: DetectDictionary();
sub DetectDictionary () {
	# Get the directory containing transpo
	my $basedir = Cwd::realpath($0);
	$basedir = dirname($basedir);
	# An array of dictionaries.
	my @Dicts;
	# If $BaseDictionary is set, use that dictionary.
	if ($BaseDictionary) {
		@Dicts = ("$BaseDictionary", "$ENV{HOME}/$BaseDictionary", "$basedir/$BaseDictionary");
	} else {
		# If it isn't set, try all known ones.
		my @DictionaryFiles = ("transpo.dict", "transpo-nn2nb.dict", "transpo-da2nb.dict");
		foreach (@DictionaryFiles) {
			push(@Dicts, "$_");
			push(@Dicts, "$ENV{HOME}/$_");
			push(@Dicts, "$basedir/$_");
		}
	}
	# Detect the dictionary
	foreach (@Dicts) {
		if ( -e $_ ) {
			$Dictionary = $_;
			last;
		}
	}
	# Die if the dictionary couldn't be found.
	unless ($BaseDictionary) {
		die "\nUnable to detect any dictionary! Use --dict to select one.\n" unless $Dictionary;
	} else {
		die "\nUnable to find the dictionary file \"$BaseDictionary\"\n" unless $Dictionary;
	}
}

